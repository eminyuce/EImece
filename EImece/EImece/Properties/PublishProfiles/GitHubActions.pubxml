<?xml version="1.0" encoding="utf-8"?>
<!--
  CI/CD FileSystem publish profile for GitHub Actions (windows-latest + MSBuild).
  Publishes a clean IIS-ready output under the repository artifacts/publish folder.
  DeleteExistingFiles is false so local publish never wipes media/uploads.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <!-- Keep false: true would wipe media/images and other persistent content. -->
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <!-- Relative to EImece/EImece/ → repository root artifacts/publish -->
    <PublishUrl>..\..\artifacts\publish\</PublishUrl>
    <_TargetId>Folder</_TargetId>
    <!-- Do not package user-generated media into the publish output. -->
    <ExcludeFilesFromDeployment>
      media\images\**;
      media\logs\**\*.log;
      media\logs\**\*.json;
      media\logs\**\.healthcheck;
      **\ConnectionStrings.config;
      **\*.user;
      **\*.suo
    </ExcludeFilesFromDeployment>
  </PropertyGroup>
</Project>
