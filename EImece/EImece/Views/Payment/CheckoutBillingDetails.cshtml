@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Entities;
@using EImece.Web.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession

@{
    ViewBag.Title = Resources.Resource.CheckoutBillingDetails;
    var products = Model.ShoppingCartItems;
    var customer = Model.Customer ?? new EImece.Domain.Models.DTOs.CustomerDto();
}
<!-- Page Title-->
<div class="page-title-wrapper" role="region" aria-label="Page title">
    <div class="container">
        <div class="alert alert-secondary" role="alert">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="mt-n1 mr-1"><i data-feather="home"></i></li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index","Home")">@Resource.HomePage</a>
                    </li>
                    <li class="breadcrumb-item active">
                        @Resource.OrderDetails
                    </li>
                </ol>
            </nav>
        </div>
        <h1 class="page-title">@Resource.OrderDetails</h1><span class="d-block mt-2 text-muted"></span>
    </div>
</div>
<!-- Page Content-->
<div class="container pb-5 mb-sm-4 mt-n2 mt-md-n3">
    <!-- Steps (wizard)-->
    @Html.Partial("_PaymentSteps", "CheckoutBillingDetails", new ViewDataDictionary(ViewData){
       {"AnyProducts",products.IsNotEmpty()}
         })

    <div class="row pt-4 mt-2">
        <!-- Content-->
        <div class="col-xl-9 col-md-8">
            @using (Html.BeginForm("CheckoutBillingDetails", "Payment", FormMethod.Post, new { enctype = "multipart/form-data", @class = "js-checkout-form" }))
            {
                <div class="d-sm-flex justify-content-between bg-secondary px-4 py-3 mb-4">
                    <div class="media">
                        <div class="media-body align-self-center">
                            <h6 class="mb-1">@customer.FullName</h6>
                            <div class="font-size-sm"><span class="text-warning">@customer.Email</span></div>
                            @Html.ValidationMessageFor(model => customer.Email, "", new { @class = "text-danger d-block" })
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="font-size-lg">
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @Html.HiddenFor(model => customer.Id)
                @Html.HiddenFor(model => customer.CreatedDate)
                @Html.HiddenFor(model => customer.UpdatedDate)
                @* Email is an editable checkout field so customers can correct a rejected address. *@
                <input type="hidden" name="customer.IsSameAsShippingAddress" value="true" />
                <div class="row">
                    @Html.AntiForgeryToken()

                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Name) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.Name, new { htmlAttributes = new { @class = "form-control", autocomplete = "given-name" } })
                            @Html.ValidationMessageFor(model => customer.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Surname) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.Surname, new { htmlAttributes = new { @class = "form-control", autocomplete = "family-name" } })
                            @Html.ValidationMessageFor(model => customer.Surname, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Email) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.Email, new { htmlAttributes = new { @class = "form-control", type = "email", autocomplete = "email" } })
                            @Html.ValidationMessageFor(model => customer.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.IdentityNumber) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.IdentityNumber, new { htmlAttributes = new { @class = "form-control", inputmode = "numeric", maxlength = "11" } })
                            <span class="badge badge-pill badge-info mr-2 mb-2">@Resource.WhyNeedIdentityNumber</span>
                            @Html.ValidationMessageFor(model => customer.IdentityNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.GsmNumber) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.GsmNumber, new { htmlAttributes = new { @class = "form-control", type = "tel", autocomplete = "tel" } })
                            <span class="badge badge-pill badge-info mr-2 mb-2">@Resource.WhyNeedGsmNumber</span>
                            @Html.ValidationMessageFor(model => customer.GsmNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="hidden" id="SelectedCity" value="@customer.City" />
                            @Html.LabelFor(model => customer.City) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.DropDownListFor(model => customer.City, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Cities" })
                            @Html.ValidationMessageFor(model => customer.City, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="hidden" id="SelectedTown" value="@customer.Town" />
                            @Html.LabelFor(model => customer.Town) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.DropDownListFor(model => customer.Town, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Towns" })
                            @Html.ValidationMessageFor(model => customer.Town, "", new { @class = "text-danger" })
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="hidden" id="SelectedDistrict" value="@customer.District" />
                            @Html.LabelFor(model => customer.District) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.DropDownListFor(model => customer.District, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Districts" })
                            @Html.ValidationMessageFor(model => customer.District, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Street) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.Street, new { htmlAttributes = new { @class = "form-control", autocomplete = "street-address" } })
                            @Html.ValidationMessageFor(model => customer.Street, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">

                        <div class="form-group">
                            @Html.LabelFor(model => customer.ZipCode)
                            @Html.EditorFor(model => customer.ZipCode, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => customer.ZipCode, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Country) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.DropDownListFor(model => customer.Country, EImece.Web.Helpers.WebGeneralHelper.GetStaticCountries(), new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => customer.Country, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Company)
                            @Html.EditorFor(model => customer.Company, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => customer.Company, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <div>@Html.LabelFor(model => customer.Description, htmlAttributes: new { @class = "control-label" }) </div>
                            @Html.TextAreaFor(model => customer.Description, new { @class = "form-control", placeholder = "", rows = "3" })
                            @Html.ValidationMessageFor(model => customer.Description, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <p class="text-muted small mb-0">@Resource.IsSameAsShippingAddress</p>
                <!-- Navigation-->
                <div class="d-flex pt-4 mt-3">
                    <div class="w-50 pr-3">
                        <a class="btn btn-outline-secondary btn-block" href="@Url.Action("shoppingcart")">
                            <i class="mr-1" data-feather="chevron-left"></i>
                            <span class="d-none d-sm-inline">@Resource.MyBasket</span><span class="d-inline d-sm-none">@Resource.Back</span>
                        </a>
                    </div>
                    <div class="w-50 pl-2">
                        <button type="submit" id="ReviewYourOrder" class="btn btn-primary btn-block js-checkout-submit">
                            @Resource.OrderFinalReview
                            <i class="ml-1" data-feather="chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
        @Html.Partial("_OrderSummary", Model)
    </div>
</div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                GetIller();
                var $firstError = $(".js-checkout-form .input-validation-error").first();
                if ($firstError.length) {
                    $("html, body").animate({ scrollTop: $firstError.offset().top - 120 }, 250);
                    $firstError.trigger("focus");
                }
            });
        </script>
}