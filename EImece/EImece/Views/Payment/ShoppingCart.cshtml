@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Entities;
@using EImece.Web.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession

@{
    ViewBag.Title = Resources.Resource.MyBasket;
    var products = Model.ShoppingCartItems;
    string continueShoppingLink = Url.Action("Index", "Home");

}

<!-- Page Title-->
<div class="page-title-wrapper" role="region" aria-label="Page title">
    <div class="container">
        <div class="alert alert-secondary" role="alert">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="mt-n1 mr-1"><i data-feather="home"></i></li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index","Home")">@Resource.HomePage</a>
                    </li>
                    <li class="breadcrumb-item active">
                        @Resource.MyBasket
                    </li>
                </ol>
            </nav>
        </div>
        <h1 class="page-title">@Resource.MyBasket</h1>
    </div>
</div>
<!-- Page Content-->
<div class="container pb-5 mb-sm-4 mt-n2 mt-md-n3">
    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-warning" role="alert">@TempData["StatusMessage"]</div>
    }
    @Html.Partial("_PaymentSteps", "ShoppingCart", new ViewDataDictionary(ViewData){
       {"AnyProducts",products.IsNotEmpty()}
         })
    <div class="row pt-4 mt-2">
        <!-- Content-->
        <div class="col-md-12">
            <div class="row">

                <div class="col-xl-9 col-md-8">
                    <div id="cart-feedback" class="alert d-none" role="status" aria-live="polite"></div>
                    @if (products.IsNotEmpty())
                    {
                        <div class="crizal-cart-items mb-4">
                            <h2 class="h6 d-flex flex-wrap justify-content-between align-items-center px-4 py-3 bg-secondary mb-0">
                                <span>@Resource.Products</span>
                                <a class="font-size-sm" href="@continueShoppingLink">
                                    <i data-feather="chevron-left" style="width: 1rem; height: 1rem;"></i>@Resource.ContinueShopping
                                </a>
                            </h2>

                            @for (int i = 0; i < products.Count; i++)
                            {
                                @CreateShoppingCartItem(products[i], i)
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary text-center py-5">
                            <p class="mb-3">@Resource.NoProductFoundInShoppingBasket</p>
                            <a class="btn btn-primary" href="@continueShoppingLink">@Resource.ContinueShopping</a>
                        </div>
                    }
                </div>

                <input type="hidden" id="OrderGuid" value="@Model.OrderGuid" />
           
                <!-- Sidebar-->
                @Html.Partial("_OrderSummary", Model, new ViewDataDictionary(ViewData){
       {"IsAdditionalComment",true},
               {"AnyProducts",products.IsNotEmpty()}
         })
            </div>
        </div>
    </div>
</div>

@helper CreateShoppingCartItem(ShoppingCartItem item, int i)
{
    var product = item.Product;
    var totalPricePerItem = product.Price * item.Quantity;
    var imageUrl = !string.IsNullOrEmpty(product.CroppedImageUrl) ? product.CroppedImageUrl : AppConfig.GetDefaultImage(200, 0);
<div data-shopping-item-row="@item.ShoppingCartItemId" class="crizal-cart-item">
    <input type="hidden" name=@String.Format("productId[{0}]", i) value="@product.Id">
    <input type="hidden" data-shopping-item-price="@item.ShoppingCartItemId" value="@product.Price" />
    <a class="crizal-cart-item__thumb" href="@product.DetailPageUrl">
        <img src="@imageUrl" alt="@product.Name" width="88" height="88" loading="lazy" decoding="async" />
    </a>
    <div class="crizal-cart-item__info">
        <h3 class="crizal-cart-item__name">
            <a href="@product.DetailPageUrl">@product.Name</a>
        </h3>
        <div class="crizal-cart-item__meta">
            <span>@Resource.UnitPrice: <strong>@product.Price.CurrencySign()</strong></span>
            @if (!string.IsNullOrEmpty(product.BrandName))
            {
                <span>@product.BrandName</span>
            }
            @if (product.ProductSpecItems.IsNotEmpty())
            {
                foreach (var productSpecs in product.ProductSpecItems)
                {
                    <span>@productSpecs.SpecsName: @productSpecs.SpecsValue</span>
                }
            }
        </div>
    </div>
    <div class="crizal-cart-item__qty">
        <label class="crizal-cart-item__qty-label" for="quantity-@item.ShoppingCartItemId">@Resource.Quantity</label>
        <div class="cart-qty" role="group" aria-label="@Resource.Quantity">
            <button type="button" class="cart-qty__btn" data-cart-qty-minus="@item.ShoppingCartItemId" aria-label="-">−</button>
            <input min="1" max="999" class="cart-qty__input" name=@String.Format("quantity[{0}]", i)
                   data-shopping-quantity-id="@item.ShoppingCartItemId"
                   type="number" inputmode="numeric" id="quantity-@item.ShoppingCartItemId" value="@item.Quantity">
            <button type="button" class="cart-qty__btn" data-cart-qty-plus="@item.ShoppingCartItemId" aria-label="+">+</button>
        </div>
    </div>
    <div class="crizal-cart-item__total">
        <span class="crizal-cart-item__total-label">@Resource.Total</span>
        <strong class="crizal-cart-item__total-price" data-shopping-item-total-price="@item.ShoppingCartItemId">@totalPricePerItem.CurrencySign()</strong>
        <button type="button" class="crizal-cart-item__remove" data-shopping-item-remove="@item.ShoppingCartItemId" data-confirm-label="@Resource.Remove">
            <i class="fas fa-trash-alt" aria-hidden="true"></i>
            <span>@Resource.Remove</span>
        </button>
    </div>
</div>
}