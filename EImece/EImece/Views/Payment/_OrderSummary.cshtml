@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession

@{
    bool IsAdditionalComment = ViewData["IsAdditionalComment"].ToBool(false);
    bool anyProducts = ViewData["AnyProducts"].ToBool(false);
}
<!-- Sidebar-->
<div class="col-xl-3 col-md-4 pt-4 mt-3 pt-md-0 mt-md-0">
    @if (Model.BasketMinTotalPriceForCargoInt > 0)
    {
        <span class="badge badge-pill badge-danger mr-2 mb-2">
            @Model.BasketMinTotalPriceForCargoInt.CurrencySign() @Resource.CargoFreeText
        </span>
    }

    <h2 class="h6 px-4 py-3 bg-secondary text-center">@Resource.OrderSummary</h2>
    @if (TempData["CouponMessage"] != null)
    {
        var t = (TempData["CouponMessageType"] as string) ?? "info";
        <div class="alert alert-@t py-2">@TempData["CouponMessage"]</div>
    }
    <div class="font-size-sm border-bottom pt-2 pb-3">
        <div class="d-flex justify-content-between mb-2"><span>@Resource.MyBasket:</span><span id="TotalPrice">@Model.TotalPrice.CurrencySign()</span></div>
        @if (Model.Coupon != null)
        {
            <div class="d-flex justify-content-between mb-2"><span>@Resource.CouponCode:</span><span id="CouponName">@Model.CouponName (@Model.CouponCode)</span></div>
            var _disc = Model.CouponValidatedDiscount > 0 ? Model.CouponValidatedDiscount : Model.CalculateCouponDiscount(Model.TotalPrice + (Model.CargoPrice != null ? Model.CargoPrice.SettingValue.ToDecimal() : 0));
            if (_disc > 0)
            {
                <div class="d-flex justify-content-between mb-2 text-success"><span>Coupon Discount:</span><span>-@_disc.CurrencySign()</span></div>
            }
            if (Model.CouponShippingDiscount > 0)
            {
                <div class="d-flex justify-content-between mb-2 text-success"><span>Shipping Discount:</span><span>-@Model.CouponShippingDiscount.CurrencySign()</span></div>
            }
            else if (Model.Coupon.IsFreeShipping)
            {
                <div class="d-flex justify-content-between mb-2 text-success"><span>Free Shipping</span><span>0</span></div>
            }
            using (Html.BeginForm("RemoveCoupon", "Payment", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button class="btn btn-sm btn-outline-danger btn-block mt-2" type="submit">Remove Coupon</button>
            }
        }
        <div id="CargoFreeTextInfo" class="d-flex justify-content-between mb-2">
            @if (Model.BasketMinTotalPriceForCargoInt > 0)
            {
                if (Model.TotalPrice > Model.BasketMinTotalPriceForCargoInt)
                {
                    <span class="badge badge-pill badge-danger mr-2 mb-2">
                        @Resource.CargoFreeTextInfo
                    </span>
                }
                else
                {
                    <span>@Resource.CargoPrice:</span><span>@Model.CargoPriceValue.CurrencySign()</span>
                }

            }
            else if (Model.CargoPriceValue > 0)
            {
                <span>@Resource.CargoPrice:</span><span>@Model.CargoPriceValue.CurrencySign()</span>
            }
            else
            {
                <span class="badge badge-pill badge-danger mr-2 mb-2">
                    @Resource.CargoFreeTextInfo
                </span>
            }
        </div>
    </div>

    <div class="h3 font-weight-semibold text-center py-3"><span>@Resource.Total:  </span><span id="TotalPriceWithCargoPrice">@Model.TotalPriceWithCargoPrice.CurrencySign()</span></div>
    @if (IsAdditionalComment && anyProducts)
    {
        using (Html.BeginForm("ApplyCoupon", "Payment", FormMethod.Post, new { @class = "needs-validation", @novalidate = "" }))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <input class="form-control" type="text" id="cart-promocode" name="couponCode" value="@Model.CouponCode" placeholder="@Resource.CouponCode" required="">
                <div class="invalid-feedback">@Resource.ValidPromoCode</div>
            </div>
            <button class="btn btn-outline-primary btn-block" type="submit">@Resource.ApplyCoupon</button>
        }
        <hr>
        <h3 class="h6 pt-4 font-weight-semibold"><span class="badge badge-success mr-2">@Resource.Note</span>@Resource.AdditionalComments</h3>
        <textarea class="form-control mb-3"
                  data-shopping-order-guid="@Model.OrderGuid"
                  id="orderComments" rows="5">@Model.OrderComments</textarea>
        <a class="btn btn-primary btn-block" href="@Url.Action("CheckoutBillingDetails","Payment")" id="ProceedToCheckout">
            <i class="mr-2" data-feather="credit-card"></i>@Resource.ContinueWithMembership
        </a>
        <a class="btn btn-secondary btn-block" id="ContinueShoppingWithoutAccount" href="@Url.Action("ShoppingWithoutAccount", "Payment")">
            <i class="mr-2" data-feather="credit-card"></i>  @Resource.ContinueWithoutMembership   
        </a>
    }
</div>