@model EImece.Domain.Models.FrontModels.SimiliarStoryTagsViewModel
@using EImece.Domain.GenericRepository;
@using EImece.Domain.Models.DTOs.Storefront;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Helpers
@using EImece.Domain
@using Resources

@{
    PaginatedList<StorefrontStoryCardDto> storyTags = Model.StoryTags;
    var tag = Model.Tag;
    ViewBag.Title = tag != null ? tag.GetSeoTitle() : "";
    var companyName = Model.CompanyName != null ? Model.CompanyName.SettingValue : "";
    ViewBag.Description = (companyName + " - " + String.Join(",", storyTags.Select(r => r.Name))).ToStr(150);
}

<div class="page-title-wrapper" role="region" aria-label="Page title">
    <div class="container">
        <div class="alert alert-secondary" role="alert">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="mt-n1 mr-1"><i data-feather="home"></i></li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index","Home")">@Resource.HomePage</a>
                    </li>
                    <li class="breadcrumb-item">
                        @tag.Name
                    </li>
                </ol>
            </nav>
        </div>
        <h1 class="page-title">@tag.Name</h1>
        <span class="d-block mt-2 text-muted"></span>
        <hr class="mt-4">
        <div class="d-flex flex-wrap justify-content-center justify-content-sm-between pb-1">
            <div class="d-flex flex-wrap">
                <span class="d-block mt-2">
                    @Html.Raw(String.Format(Resource.TagResultTotalCountText, HttpUtility.HtmlEncode(tag.Name), storyTags.TotalCount))
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container potrfolio-container">

    <div class="clearfix"></div>

    <!-- Stories grid -->
    <div class="row">
        @foreach (var item in storyTags)
        {
            if (item == null) { continue; }
            <div class="col-sm-6 col-lg-3 mb-4 d-flex">
                @Html.DisplayFor(modelItem => item, "TagStory", new { Width = 400, Height = 260 })
            </div>
        }
    </div>

    @if (storyTags != null && storyTags.TotalPageCount > 1)
    {
        <div class="d-flex justify-content-center py-4 pb-5">
            @Html.BootstrapPager(
                storyTags.PageIndex,
                index => Url.Action("Tag", "Stories", new { page = index, id = tag.GetSeoUrl() }),
                storyTags.TotalCount,
                storyTags.PageSize,
                numberOfLinks: 5)
        </div>
    }

</div>
