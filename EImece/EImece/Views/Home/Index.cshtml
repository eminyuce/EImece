@using EImece.Domain.Entities;
@using EImece.Domain.Models.DTOs.Storefront;
@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain;
@using EImece.Domain.Helpers
@using Resources;
@model MainPageViewModel
@{

    var mainPageImages = Model.MainPageImages;
    var mainPageProducts = Model.MainPageProducts;
    var mainPageProductCategories = Model.MainPageProductCategories.Where(r => r.ParentId != 0).OrderBy(r => r.Position).Take(12).ToList();
    var rootMainPageProductCategories = Model.MainPageProductCategories.Where(r => r.ParentId == 0).ToList();
    var randomRootMainPageProductCategory = rootMainPageProductCategories.OrderBy(x => Guid.NewGuid()).FirstOrDefault();
    var bannerLink = randomRootMainPageProductCategory == null ? "" : randomRootMainPageProductCategory.DetailPageUrl;
    var campaignProducts = Model.CampaignProducts;
    var latestProducts = Model.LatestProducts;
    var latestStories = Model.LatestStories;
    Subscriber subscriber = new Subscriber();
    var isUserAuthenticated = User.Identity.IsAuthenticated && AppConfig.IsEditLinkEnable;

    // Preload first hero image for LCP discovery
    var firstHero = mainPageImages != null && mainPageImages.Count > 0 ? mainPageImages[0] : null;
    var firstHeroUrl = firstHero != null ? firstHero.GetCroppedImageUrl(459, 344) : null;
}

@section HeadExtra {
    @if (!string.IsNullOrEmpty(firstHeroUrl))
    {
        <link rel="preload" as="image" href="@firstHeroUrl" fetchpriority="high" />
    }
}

<!-- DTO Verification Fields -->
<input type="hidden" id="dto-verification-products" data-source="dto" data-type="StorefrontProductCardDto" value="@(mainPageProducts != null ? mainPageProducts.Count : 0)" />
<input type="hidden" id="dto-verification-banners" data-source="dto" data-type="StorefrontBannerDto" value="@(mainPageImages != null ? mainPageImages.Count : 0)" />
<input type="hidden" id="dto-verification-categories" data-source="dto" data-type="StorefrontCategoryDto" value="@(mainPageProductCategories != null ? mainPageProductCategories.Count : 0)" />
<input type="hidden" id="dto-verification-stories" data-source="dto" data-type="StorefrontStoryCardDto" value="@(latestStories != null ? latestStories.Count : 0)" />
<input type="hidden" id="dto-verification-page" data-source="dto" data-page="Home/Index" />

<h1 class="sr-only">@ViewBag.Title</h1>

<!-- Hero slider + Promo list-->
<section class="container px-1" aria-label="@Resource.PopularProducts">
    <div class="mt-4">
        <div class="row">
            <!-- Categories-->
            <div class="col-lg-4 d-none d-lg-block">
                <div class="border px-4 py-2">
                    <ul class="list-unstyled mb-0">
                        @for (int i = 0; i < rootMainPageProductCategories.Count; i++)
                        {
                            @CreateMainPageCategory(rootMainPageProductCategories[i], Model.MainPageProductCategories, rootMainPageProductCategories.Count - 1 - i == 0)
                        }
                    </ul>
                </div>
            </div>
            <div class="col-lg-8">
                <!-- Hero slider: fixed min-height (no autoHeight) to avoid CLS -->
                <div class="bg-secondary bg-size-cover mb-grid-gutter home-hero-carousel" style="background-image: url(/Content/img/hero-main-bg.jpg);">
                    <div class="owl-carousel trigger-carousel"
                         data-owl-carousel="{ &quot;nav&quot;: true, &quot;dots&quot;: false, &quot;loop&quot;: true, &quot;autoHeight&quot;: false, &quot;autoplay&quot;: true, &quot;autoplayTimeout&quot;: 5500 }">
                        @for (int i = 0; i < mainPageImages.Count; i++)
                        {
                            @CreateMainPageImage(mainPageImages[i], i == 0)
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@CreateProductCategorySection(@Resource.PopularProducts, mainPageProductCategories)

<!-- Subscription form section -->
<section class="container px-1 py-4" aria-label="@Resource.StayInformed">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="bg-white border p-4 rounded shadow-sm">
                @Html.Raw(Resource.MainPageProductSubscriptionHtml)
                <label class="sr-only" for="SubscribeEmailText">@Resource.PleaseEnterYourEmail</label>
                <input type="email" name="email" id="SubscribeEmailText" class="form-control mb-3" placeholder="@Resource.PleaseEnterYourEmail" autocomplete="email" />
                <button type="button" id="SubscribeEmailBtn" class="btn btn-primary btn-block">@Resource.Subscribe*</button>
                <div class="success-message text-center mt-3" id="SubscribeEmailTextSuccessMessage" style="display: none;">@Html.Raw(@Resource.MainPageProductSubscriptionThanks)</div>
            </div>
        </div>
    </div>
</section>


@helper CreatePromoBanner(String bannerLink)
{

    <!-- Promo banner-->
    <section class="container py-1 my-1 px-1">
        <div class="bg-faded-info position-relative py-4">
            <div class="row align-items-center">
                <div class="col-md-5">
                    <span class="badge badge-pill badge-warning ml-5">@Resource.LimitedStock !</span>
                    <div class="pt-4 pl-4 pl-sm-5">
                        @Html.Raw(string.Format(Resource.PromoBannerText, HttpUtility.HtmlAttributeEncode(bannerLink)))
                    </div>
                </div>
                <div class="col-md-7"><img class="mx-auto" src="~/media/images/offer.jpg" width="561" height="421" alt="Promo banner" loading="lazy" decoding="async"></div>
            </div>
        </div>
    </section>

}
<!-- Product widgets-->
<section class="container px-1 pt-1 pb-1 mb-md-1">
    <div class="row">
        @CreateProductWidget(Resource.ShowcaseProducts, mainPageProducts.Take(AppConfig.HomePageMainProductCountRandomLimit).ToList())
        @CreateProductWidget(Resource.CampaignProducts, campaignProducts.Take(AppConfig.HomePageMainProductCountRandomLimit).ToList())
        @CreateProductWidget(Resource.NewProducts, latestProducts.Take(AppConfig.HomePageMainProductCountRandomLimit).ToList())
    </div>
</section>
<br />
@if (latestStories.IsNotEmpty())
{
    <section class="container px-1 pt-1 pb-1 mb-md-1">
        <div class="row">
            @CreateStoryWidget(Resource.Stories, latestStories.OrderBy(t => Guid.NewGuid()).Take(AppConfig.HomePageMainProductCountRandomLimit).ToList())
        </div>
    </section>
}


@helper  CreateMainPageImage(StorefrontBannerDto mainPageImage, bool isLcp)
{
    var imageId = mainPageImage.MainImageId.HasValue ? mainPageImage.MainImageId.Value : 0;
    var imgLink = mainPageImage.GetCroppedImageUrl(459, 344);
    var imgSrcSet = mainPageImage.GetResponsiveImageSrcSet(459, 344);
    var loadingAttr = isLcp ? "eager" : "lazy";
    var fetchPriorityAttr = isLcp ? "high" : "auto";
    <div class="row align-items-center py-5">
        <div class="col-md-5">
            <div class="pl-3 pr-3 pl-md-5 pr-md-0 pt-4 pt-lg-5 pb-5 text-center text-md-left">
                <h2 class="h3 mb-1">@mainPageImage.Name</h2>
                <a class="btn btn-primary" href="@mainPageImage.Url">
                    @mainPageImage.Name
                    <i class="ml-1" data-feather="arrow-right" aria-hidden="true"></i>
                </a>
            </div>
        </div>
        <div class="col-md-7">
            <img class="d-block mx-auto hero-slide-img"
                 src="@imgLink"
                 srcset="@imgSrcSet"
                 sizes="(max-width: 767px) 92vw, 459px"
                 width="459"
                 height="344"
                 alt="@mainPageImage.Name"
                 loading="@loadingAttr"
                 fetchpriority="@fetchPriorityAttr"
                 decoding="async" />
        </div>
    </div>
}

@helper  CreateProductCategorySection(String title, List<StorefrontCategoryDto> mainPageProductCategories)
{if (mainPageProductCategories.IsNotEmpty())
    {
        var featuredItem = mainPageProductCategories.First();<!-- Featured products grid-->
        <section class="container px-1 pt-2" aria-label="@title">
            <h2 class="h3 mb-3">@title</h2>
            <div class="row no-gutters">
                @for (int i = 0; i < mainPageProductCategories.Count; i++)
                {
                    var p = mainPageProductCategories[i];
                    @Html.DisplayFor(model => p, "FeaturedProductCategoryItem", new { Width = 305, Height = 305 })}
            </div>
        </section>}
}


@helper  CreateStoryWidget(String title, List<StorefrontStoryCardDto> latestStories)
{
        <div class="col-12 mb-2 py-3">
            <div class="widget widget-featured-entries home-stories-widget">
                <h2 class="widget-title font-size-lg h3">@title</h2>

                @for (int i = 0; i < latestStories.Count; i++)
                {
                    var p = latestStories[i];
                    @Html.DisplayFor(model => p, "MainPageStoryShort", new { Width = 220, Height = 150 })
                }
            </div>
        </div>
}


@helper  CreateProductWidget(String title, List<StorefrontProductCardDto> products)
{if (products.IsNotEmpty())
    {
        <div class="col-md-4 col-sm-6 mb-2 py-3">
            <div class="widget widget-featured-entries">
                <h2 class="widget-title font-size-lg h3">@title</h2>

                @for (int i = 0; i < products.Count; i++)
                {
                    var p = products[i];
                    @Html.DisplayFor(model => p, "MainPageProductShort", new { Width = 80, Height = 80 })}
            </div>
        </div>}
}

@helper CreateMainPageCategory(StorefrontCategoryDto productCategory, List<StorefrontCategoryDto> productCategories, bool isLast)
{var children = productCategories.Where(r => r.ParentId == productCategory.Id).ToList();
    var productImgLink = productCategory.GetCroppedImageUrl(null, 300, 0);
    var productCategoryLink = productCategory.DetailPageUrl;
    var popoverContent = productCategory.MainImageId.HasValue
        ? HttpUtility.HtmlEncode(string.Format("<img src='{0}' class='d-block mt-n1' alt='{1}'><div class='text-center font-size-sm font-weight-semibold mt-n0 pb-0'>{1}</div>", productImgLink, productCategory.Name))
        : "";

    <li @string.Format("{0}", isLast ? "" : "class=border-bottom")>
        <a class="d-flex align-items-center nav-link-inline pb-3 pt-3"
           href="@productCategoryLink"
           data-toggle="popover" data-placement="right" data-trigger="hover"
           data-html="true" data-content="@Html.Raw(popoverContent)">
            <i class="text-primary opacity-60 mr-2 mt-1" data-feather="arrow-right" style="width: 1.25rem; height: 1.25rem;" aria-hidden="true"></i>
            <span>
                <b>@productCategory.Name</b>
                <i class="ml-1" data-feather="chevron-right" style="width: 1rem; height: 1rem;" aria-hidden="true"></i>
            </span>
        </a>
    </li>
}
