@model EImece.Domain.Entities.Story
@using System.Linq
@using EImece.Domain.Entities
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Helpers
@using Resources
@{
    var story = Model;
    var tags = (story.StoryTags ?? Enumerable.Empty<StoryTag>())
        .Where(r1 => r1.Tag != null)
        .Select(r1 => r1.Tag)
        .Distinct()
        .ToList();
    int Width = ViewData["Width"].ToInt(480);
    int Height = ViewData["Height"].ToInt(320);
    var imageId = story.MainImageId.HasValue ? story.MainImageId.Value : 0;
    var storyImageTag = imageId > 0
        ? story.GetCroppedImageTag(imageId, Width, Height, lazy: true, fetchPriority: null, sizes: "(max-width: 767px) 100vw, 360px")
        : story.GetCroppedImageTag(Width, Height);
}

<article class="card story-list-card mb-4 shadow-sm border-0 overflow-hidden">
    <div class="row no-gutters align-items-stretch">
        <div class="col-md-4 position-relative">
            <a href="@story.DetailPageUrl" class="story-list-thumb" aria-label="@story.Name">
                @Html.Raw(storyImageTag)
            </a>
            <div class="story-list-date text-center bg-dark text-white rounded px-2 py-1">
                <div class="h5 mb-0">@story.CreatedDate.Day</div>
                <small class="text-uppercase">@story.CreatedDate.ToString("MMM")</small>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card-body d-flex flex-column h-100">
                <h2 class="card-title h5 mb-2">
                    <a href="@story.DetailPageUrl" class="text-dark">@story.Name</a>
                </h2>

                @if (tags.Any())
                {
                    <p class="mb-2">
                        @foreach (var tag in tags)
                        {
                            <a href="@(tag.DetailPageRelativeUrlForStories ?? "#")"
                               class="badge badge-secondary mr-1 mb-1">@tag.Name</a>
                        }
                    </p>
                }

                <p class="card-text text-muted mb-3 flex-grow-1">@story.GetSeoDescription(300)</p>

                <a href="@story.DetailPageUrl" class="btn btn-outline-secondary btn-sm align-self-start">@Resource.ReadMore</a>
            </div>
        </div>
    </div>
</article>
