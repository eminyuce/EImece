@model GridMvc.Pagination.GridPager
@{
    if (Model == null)
    {
        return;
    }

    var pageCount = Model.PageCount;
    var current = Model.CurrentPage < 1 ? 1 : Model.CurrentPage;
    var pageSize = Model.PageSize < 1 ? 1 : Model.PageSize;
    var itemsCount = Model.ItemsCount;
    var rangeStart = itemsCount == 0 ? 0 : ((current - 1) * pageSize) + 1;
    var rangeEnd = itemsCount == 0 ? 0 : Math.Min(current * pageSize, itemsCount);
    var showPages = pageCount > 1;
    var summaryText = itemsCount > 0
        ? string.Format("{0}-{1} / {2} kayıt · Sayfa {3} / {4}", rangeStart, rangeEnd, itemsCount, current, Math.Max(pageCount, 1))
        : "Kayıt yok";
}
<nav class="site-pagination eg-pager" aria-label="Sayfalama">
    <div class="eg-pager-summary">
        <span class="eg-pager-total">@summaryText</span>
    </div>

    @if (showPages)
    {
        <ul class="pagination eg-pager-pages-list">
            @if (current > 1)
            {
                <li>
                    <a href="@Model.GetLinkForPage(1)" class="eg-pager-btn" title="İlk sayfa" aria-label="İlk sayfa"><span aria-hidden="true">&laquo;</span></a>
                </li>
                <li>
                    <a href="@Model.GetLinkForPage(current - 1)" class="eg-pager-btn" title="Önceki" aria-label="Önceki sayfa"><span aria-hidden="true">&lsaquo;</span></a>
                </li>
            }
            else
            {
                <li class="disabled"><span class="eg-pager-btn" aria-hidden="true">&laquo;</span></li>
                <li class="disabled"><span class="eg-pager-btn" aria-hidden="true">&lsaquo;</span></li>
            }

            @if (Model.StartDisplayedPage > 1)
            {
                <li><a href="@Model.GetLinkForPage(1)" class="eg-pager-btn">1</a></li>
            }
            @if (Model.StartDisplayedPage > 2)
            {
                <li class="disabled"><span class="eg-pager-btn eg-pager-ellipsis">…</span></li>
            }

            @for (var i = Model.StartDisplayedPage; i <= Model.EndDisplayedPage; i++)
            {
                var pageNum = i;
                if (pageNum == current)
                {
                    <li class="active"><span class="eg-pager-btn is-active" aria-current="page">@pageNum</span></li>
                }
                else
                {
                    <li><a href="@Model.GetLinkForPage(pageNum)" class="eg-pager-btn">@pageNum</a></li>
                }
            }

            @if (Model.EndDisplayedPage < pageCount - 1)
            {
                <li class="disabled"><span class="eg-pager-btn eg-pager-ellipsis">…</span></li>
            }
            @if (Model.EndDisplayedPage < pageCount)
            {
                <li><a href="@Model.GetLinkForPage(pageCount)" class="eg-pager-btn">@pageCount</a></li>
            }

            @if (current < pageCount)
            {
                <li>
                    <a href="@Model.GetLinkForPage(current + 1)" class="eg-pager-btn" title="Sonraki" aria-label="Sonraki sayfa"><span aria-hidden="true">&rsaquo;</span></a>
                </li>
                <li>
                    <a href="@Model.GetLinkForPage(pageCount)" class="eg-pager-btn" title="Son sayfa" aria-label="Son sayfa"><span aria-hidden="true">&raquo;</span></a>
                </li>
            }
            else
            {
                <li class="disabled"><span class="eg-pager-btn" aria-hidden="true">&rsaquo;</span></li>
                <li class="disabled"><span class="eg-pager-btn" aria-hidden="true">&raquo;</span></li>
            }
        </ul>
    }
</nav>
