@using EImece.Domain.Entities;
@model List<BaseEntity>
@using EImece.Domain.Helpers;
@using Resources;

@{
    var contents = Model ?? new List<BaseEntity>();
    var GridResultRecordNumber = Resource.GridResultRecordNumber;
    var count = contents.Count();
}

<output class="panel-heading grid-record-count" aria-live="polite">
    <div class="grid-record-count-inner">
        <span class="grid-record-count-badge">@count</span>
        <span class="grid-record-count-label">@GridResultRecordNumber</span>
    </div>
</output>
