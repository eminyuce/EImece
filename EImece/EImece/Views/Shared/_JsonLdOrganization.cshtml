@using EImece.Domain;
@using EImece.Domain.Models.FrontModels;
@using Newtonsoft.Json;
@model JsonLdOrganizationModel

@{
    string companyName = !string.IsNullOrWhiteSpace(Model.CompanyName) ? Model.CompanyName : "EImece";

    string domain = !string.IsNullOrWhiteSpace(AppConfig.Domain) ? AppConfig.Domain : "localhost:81";
    string baseUrl = string.Format("{0}://{1}", AppConfig.HttpProtocol, domain);
    string logoUrl = !string.IsNullOrWhiteSpace(Model.LogoSetting) ? string.Format("{0}{1}", baseUrl, Model.LogoSetting) : string.Format("{0}/images/logo.jpg", baseUrl);
    string phone = Model.Phone;
    string email = Model.Email;

    var orgSchema = new Dictionary<string, object>
    {
        { "@context", "https://schema.org" },
        { "@type", "Organization" },
        { "name", companyName },
        { "url", baseUrl },
        { "logo", logoUrl }
    };

    if (!string.IsNullOrWhiteSpace(phone) || !string.IsNullOrWhiteSpace(email))
    {
        var contactPoint = new Dictionary<string, object>
        {
            { "@type", "ContactPoint" },
            { "contactType", "customer service" },
            { "areaServed", "TR" }
        };
        if (!string.IsNullOrWhiteSpace(phone)) { contactPoint["telephone"] = phone; }
        if (!string.IsNullOrWhiteSpace(email)) { contactPoint["email"] = email; }
        orgSchema["contactPoint"] = contactPoint;
    }

    string jsonLd = JsonConvert.SerializeObject(orgSchema, Formatting.Indented);
}

<script type="application/ld+json">
@Html.Raw(jsonLd)
</script>
