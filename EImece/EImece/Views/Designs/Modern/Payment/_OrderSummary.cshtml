@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Entities;
@using EImece.Web.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession

@{
    bool IsAdditionalComment = ViewData["IsAdditionalComment"].ToBool(false);
    bool anyProducts = ViewData["AnyProducts"].ToBool(false);
}
<!-- Sidebar-->
<div class="col-xl-3 col-md-4 pt-4 mt-3 pt-md-0 mt-md-0">
    @if (Model.BasketMinTotalPriceForCargoInt > 0)
    {
        <div class="alert alert-success text-center px-2 py-2 mb-2 free-cargo-banner" role="alert"><strong>
            @Model.BasketMinTotalPriceForCargoInt.CurrencySign() @Resource.CargoFreeText</strong></div>
    }

    <h2 class="h6 px-4 py-3 bg-secondary text-center">@Resource.OrderSummary</h2>
    <div class="font-size-sm border-bottom pt-2 pb-3">
        <div class="d-flex justify-content-between mb-2"><span>@Resource.MyBasket:</span><span id="TotalPrice">@Model.TotalPrice.CurrencySign()</span></div>
        @if (Model.Coupon != null)
        {
            <div class="d-flex justify-content-between mb-2"><span>@Resource.CouponCode:</span><span id="CouponName">@Model.CouponName</span></div>
        }
        <div id="CargoFreeTextInfo" class="d-flex justify-content-between mb-2">
            @if (Model.BasketMinTotalPriceForCargoInt > 0)
            {
                if (Model.TotalPrice > Model.BasketMinTotalPriceForCargoInt)
                {
                    <div class="alert alert-success text-center px-2 py-2 mb-2 free-cargo-banner" role="alert"><strong>
                        @Resource.CargoFreeTextInfo</strong></div>
                }
                else
                {
                    <span>@Resource.CargoPrice:</span><span>@Model.CargoPriceValue.CurrencySign()</span>
                }

            }
            else if (Model.CargoPriceValue > 0)
            {
                <span>@Resource.CargoPrice:</span><span>@Model.CargoPriceValue.CurrencySign()</span>
            }
            else
            {
                <div class="alert alert-success text-center px-2 py-2 mb-2 free-cargo-banner" role="alert"><strong>
                    @Resource.CargoFreeTextInfo</strong></div>
            }
        </div>
    </div>

    <div class="h3 font-weight-semibold text-center py-3"><span>@Resource.Total:  </span><span id="TotalPriceWithCargoPrice">@Model.TotalPriceWithCargoPrice.CurrencySign()</span></div>
    @if (IsAdditionalComment && anyProducts)
    {
        using (Html.BeginForm("ApplyCoupon", "Payment", FormMethod.Post, new { @class = "needs-validation", @novalidate = "" }))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <input class="form-control" type="text" id="cart-promocode" name="couponCode" value="@Model.CouponCode" placeholder="@Resource.CouponCode" required="">
                <div class="invalid-feedback">@Resource.ValidPromoCode</div>
            </div>
            <button class="btn btn-outline-primary w-100" type="submit">@Resource.ApplyCoupon</button>
        }
        <a class="btn btn-primary w-100" id="ContinueShoppingWithoutAccount" href="@Url.Action("ShoppingWithoutAccount", "Payment")">
            <i class="mr-2" data-feather="credit-card"></i>@Resource.GoToPayment
        </a>
        <a class="btn btn-outline-secondary w-100 mt-2" href="@Url.Action("CheckoutBillingDetails","Payment")" id="ProceedToCheckout">
            <i class="mr-2" data-feather="user"></i>@Resource.ContinueWithMembership
        </a>
        <hr>
        <h3 class="h6 pt-2 font-weight-semibold"><span class="badge badge-success mr-2">@Resource.Note</span>@Resource.AdditionalComments</h3>
        <textarea class="form-control mb-0"
                  data-shopping-order-guid="@Model.OrderGuid"
                  id="orderComments" rows="2">@Model.OrderComments</textarea>
    }
</div>