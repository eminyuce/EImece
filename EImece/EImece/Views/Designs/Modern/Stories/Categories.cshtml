@model EImece.Domain.Models.FrontModels.StoryCategoryViewModel
@using System.Web.Hosting
@using EImece.Domain.Entities;
@using EImece.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@{
    var category = Model.StoryCategory;
    var stories = Model.StorefrontStories;
    ViewBag.Title = category.GetSeoTitle();
    ViewBag.Description = category.GetSeoDescription();

    category.PageTheme = String.IsNullOrEmpty(category.PageTheme) ? "T1" : category.PageTheme;
    var themeName = "PageTheme_" + category.PageTheme;
    
    string activeDesign = new EImece.Infrastructure.Designs.ConfigDesignProvider().GetActiveDesign();
    string selectedPagePath = string.IsNullOrEmpty(activeDesign) 
        ? "~/Views/Shared/StoriesPageThemes/" + themeName + ".cshtml"
        : "~/Views/Designs/" + activeDesign + "/Shared/StoriesPageThemes/" + themeName + ".cshtml";

    var themePhysicalPath = HostingEnvironment.MapPath(selectedPagePath);
    if (string.IsNullOrEmpty(themePhysicalPath) || !System.IO.File.Exists(themePhysicalPath))
    {
        selectedPagePath = string.IsNullOrEmpty(activeDesign)
            ? "~/Views/Shared/StoriesPageThemes/PageTheme_T1.cshtml"
            : "~/Views/Designs/" + activeDesign + "/Shared/StoriesPageThemes/PageTheme_T1.cshtml";
            
        if (!System.IO.File.Exists(HostingEnvironment.MapPath(selectedPagePath)))
        {
            selectedPagePath = "~/Views/Shared/StoriesPageThemes/PageTheme_T1.cshtml";
        }
    }
}
@Html.Partial(selectedPagePath, Model)