@model EImece.Domain.Models.DTOs.Storefront.CustomerSummaryDto
@using Resources;
@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.Extensions;
@{
    var actionName = ViewContext.RouteData.GetRequiredString("action");
    var isIndex = string.Equals(actionName, "Index", StringComparison.OrdinalIgnoreCase);
    var isChangePassword = string.Equals(actionName, "ChangePassword", StringComparison.OrdinalIgnoreCase);
    var isOrders = string.Equals(actionName, "CustomerOrders", StringComparison.OrdinalIgnoreCase) ||
                   string.Equals(actionName, "CustomerOrderDetail", StringComparison.OrdinalIgnoreCase);
    var isSendMessage = string.Equals(actionName, "SendMessageToSeller", StringComparison.OrdinalIgnoreCase);
    var isFaq = string.Equals(actionName, "Faq", StringComparison.OrdinalIgnoreCase);
    var email = Model != null ? Model.Email : "";
    var fullName = Model != null && !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName : email;
}

<div class="customer-shell">
    <div class="customer-chrome">
        <div class="customer-chrome__info">
            <span class="customer-chrome__eyebrow">@Resource.CustomerAccount</span>
            <h1 class="customer-chrome__name">@fullName</h1>
            <div class="customer-chrome__email">
                <i class="fas fa-envelope mr-1" aria-hidden="true"></i>
                <span>@email</span>
            </div>
    </div>

    <div class="customer-summary">
        <div class="customer-summary__item">
            <span class="customer-summary__label"><i class="far fa-calendar-alt mr-1" aria-hidden="true"></i> @Resource.CreatedDate</span>
            <span class="customer-summary__value">@(Model != null && Model.CreatedDate != DateTime.MinValue ? Model.CreatedDate.ToString("dd MMMM yyyy") : "-")</span>
        </div>
        <div class="customer-summary__item">
            <span class="customer-summary__label"><i class="fas fa-shopping-bag mr-1" aria-hidden="true"></i> Toplam Sipariş</span>
            <span class="customer-summary__value">@(Model != null ? Model.TotalOrderCount : 0)</span>
        </div>
        <div class="customer-summary__item">
            <span class="customer-summary__label"><i class="fas fa-wallet mr-1" aria-hidden="true"></i> Toplam Harcama</span>
            <span class="customer-summary__value">@((Model != null ? Model.TotalPaid : 0).CurrencySign())</span>
        </div>
    </div>

    <!-- Desktop Navigation Tabs -->
    <nav class="customer-tabs d-none d-md-block" aria-label="Hesap sekmeleri">
        <ul class="customer-tabs__list">
            <li class="customer-tabs__item">
                <a class="customer-tabs__link @(isIndex ? "is-active" : "")" href="@Url.Action("Index", "Home", new { area = "customers" })">
                    <i class="fas fa-user-circle" aria-hidden="true"></i>
                    <span>@Resource.MyAccount</span>
                </a>
            </li>
            <li class="customer-tabs__item">
                <a class="customer-tabs__link @(isChangePassword ? "is-active" : "")" href="@Url.Action("ChangePassword", "Home", new { area = "customers" })">
                    <i class="fas fa-key" aria-hidden="true"></i>
                    <span>@Resource.ChangePassword</span>
                </a>
            </li>
            <li class="customer-tabs__item">
                <a class="customer-tabs__link @(isOrders ? "is-active" : "")" href="@Url.Action("CustomerOrders", "Home", new { area = "customers" })">
                    <i class="fas fa-shopping-bag" aria-hidden="true"></i>
                    <span>@Resource.MyOrder</span>
                    <span class="customer-tabs__count">@(Model != null ? Model.TotalOrderCount : 0)</span>
                </a>
            </li>
            <li class="customer-tabs__item">
                <a class="customer-tabs__link @(isSendMessage ? "is-active" : "")" href="@Url.Action("SendMessageToSeller", "Home", new { area = "customers" })">
                    <i class="fas fa-comment-dots" aria-hidden="true"></i>
                    <span>@Resource.SendMessageToSeller</span>
                </a>
            </li>
            <li class="customer-tabs__item">
                <a class="customer-tabs__link @(isFaq ? "is-active" : "")" href="@Url.Action("Faq", "Home", new { area = "customers" })">
                    <i class="fas fa-question-circle" aria-hidden="true"></i>
                    <span>@Resource.Faq</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Mobile Segment Control -->
    <nav class="customer-segment d-md-none" aria-label="Hesap mobil menü">
        <div class="customer-segment__track">
            <a class="customer-segment__item @(isIndex ? "is-active" : "")" href="@Url.Action("Index", "Home", new { area = "customers" })">
                <i class="fas fa-user-circle" aria-hidden="true"></i>
                <span>@Resource.MyAccount</span>
            </a>
            <a class="customer-segment__item @(isChangePassword ? "is-active" : "")" href="@Url.Action("ChangePassword", "Home", new { area = "customers" })">
                <i class="fas fa-key" aria-hidden="true"></i>
                <span>@Resource.ChangePassword</span>
            </a>
            <a class="customer-segment__item @(isOrders ? "is-active" : "")" href="@Url.Action("CustomerOrders", "Home", new { area = "customers" })">
                <i class="fas fa-shopping-bag" aria-hidden="true"></i>
                <span>@Resource.MyOrder</span>
                @if ((Model?.TotalOrderCount ?? 0) > 0)
                {
                    <span class="customer-segment__badge">@(Model.TotalOrderCount)</span>
                }
            </a>
            <a class="customer-segment__item @(isSendMessage ? "is-active" : "")" href="@Url.Action("SendMessageToSeller", "Home", new { area = "customers" })">
                <i class="fas fa-comment-dots" aria-hidden="true"></i>
                <span>@Resource.SendMessageToSeller</span>
            </a>
            <a class="customer-segment__item @(isFaq ? "is-active" : "")" href="@Url.Action("Faq", "Home", new { area = "customers" })">
                <i class="fas fa-question-circle" aria-hidden="true"></i>
                <span>@Resource.Faq</span>
            </a>
        </div>
    </nav>
</div>
