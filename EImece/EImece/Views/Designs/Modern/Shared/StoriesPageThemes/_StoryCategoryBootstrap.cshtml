@model EImece.Domain.Models.FrontModels.StoryCategoryViewModel
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain
@using Resources
@using System.Linq
@{
    var category = Model.StoryCategory;
    var stories = Model.Stories;
}

<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <div class="alert alert-secondary" role="alert">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="mt-n1 mr-1"><i data-feather="home"></i></li>
                    @if (Model.MainPageMenu != null && Model.MainPageMenu.IsActive)
                    {
                        <li class="breadcrumb-item">
                            @Html.ActionLink(Model.MainPageMenu.Name, "Index", "Home")
                        </li>
                    }
                    else
                    {
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Home")">@Resource.HomePage</a>
                        </li>
                    }
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Stories")">@Resource.StoryCategories</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">@category.Name</li>
                </ol>
            </nav>
        </div>
        <h1 class="page-title">@category.Name</h1>
        @if (!string.IsNullOrWhiteSpace(category.Description))
        {
            <span class="d-block mt-2 text-muted story-category-lead">@Html.Raw(category.Description)</span>
        }
        <hr class="mt-4 mb-0">
    </div>
</section>

<div class="container my-4 mb-5">
    <div class="row">
        <div class="col-lg-8">
            @if (stories != null && stories.Count > 0)
            {
                foreach (var story in stories)
                {
                    @Html.DisplayFor(modelItem => story, "Story", new { Width = 480, Height = 320 })
                }
            }
            else
            {
                <output class="alert alert-secondary">@Resource.NOSearchResult</output>
            }
        </div>

        <aside class="col-lg-4">
            @if (Model.StoryCategories != null && Model.StoryCategories.Count > 1)
            {
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-body">
                        <h2 class="h5 card-title">@Resource.StoryCategories</h2>
                        <ul class="list-unstyled mb-0 story-category-side-list">
                            @foreach (var cstory in Model.StoryCategories)
                            {
                                var isCurrent = cstory.Id == category.Id;
                                <li class="mb-2">
                                    @if (isCurrent)
                                    {
                                        <span class="font-weight-bold text-dark">@cstory.Name</span>
                                    }
                                    else
                                    {
                                        @Html.ActionLink(cstory.Name, "categories", new { id = cstory.GetSeoUrl() }, new { @class = "text-dark" })
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            @if (Model.Tags != null && Model.Tags.Count > 0)
            {
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-body">
                        <h2 class="h5 card-title">@Resource.Tags</h2>
                        <div class="story-category-tags">
                            @foreach (var t in Model.Tags.OrderByDescending(x => x.ItemCount).ThenBy(x => x.Name))
                            {
                                <a href="@Url.Action("Tag", "Stories", new { id = t.GetSeoUrl() })"
                                   class="badge badge-secondary mr-1 mb-1">@t.Name (@t.ItemCount)</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </aside>
    </div>
</div>
