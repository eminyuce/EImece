@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain;
@using Resources;
@using System.Threading;
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Helpers;
@using EImece.Infrastructure.Designs;

@{
    var countryCode = Thread.CurrentThread.CurrentUICulture.ToString();
    var productPriceEnabled = ViewBag.IsProductPriceEnable == null || (bool)ViewBag.IsProductPriceEnable;
    var companyName = Html.Action("GetCompanyName", "Home");
    var htmlLang = Html.Action("GetHtmlLangCode", "Home");
}

<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    @Html.ActiveDesignDebugInfo()
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <meta property="og:locale" content='tr_TR' />
    <meta property="og:type" content='Website' />
    <meta property="og:site_name" content='@companyName' />
    <meta property="og:image" content="@string.Format("https://{0}/images/logo.jpg",AppConfig.Domain)" />
    <meta property="og:image:width" content="100" />
    <meta property="og:image:height" content="100" />
    <meta property="og:title" content="@ViewBag.Title" />
    <meta property="og:url" content="@string.Format("https://{0}",AppConfig.Domain)" />

    @{
        var pageMetaDesc = (string)ViewBag.Description;
        if (string.IsNullOrWhiteSpace(pageMetaDesc))
        {
            pageMetaDesc = (string)ViewBag.Title;
        }
        if (string.IsNullOrWhiteSpace(pageMetaDesc))
        {
            pageMetaDesc = companyName?.ToString() ?? AppConfig.Domain;
        }
    }
    <meta name="description" content="@pageMetaDesc">
    <meta property="og:description" content="@pageMetaDesc">

    @if (!string.IsNullOrEmpty(ViewBag.Keywords))
    {
        <meta name="keywords" content="@((string)ViewBag.Keywords)">
    }
    @{
        String seoId = (String)ViewBag.SeoId;

    }
    @Html.Raw(SeoUrlHelper.GetCanonicalTag(this.ViewContext, seoId))
    @Html.Raw(SeoUrlHelper.GetCanonicalTag(this.ViewContext, seoId, "amp"))

    @if (!SeoSettings.AllowIndexing || AppConfig.IsSiteUnderConstruction || AppConfig.IsSiteUnderDevelopment)
    {
        <meta name="robots" content="noindex, nofollow, noarchive" />
        <meta name="googlebot" content="noindex, nofollow, noarchive" />
    }
    else
    {
        <meta name="Robots" content="index,follow" />
    }

    @Html.Action("JsonLdOrganization", "Home")

    <!-- Favicon and Touch Icons-->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/manifest.json">
    <link rel="mask-icon" color="#111" href="~/Content/safari-pinned-tab.svg">
    <meta name="msapplication-TileColor" content="#111">
    <meta name="theme-color" content="#ffffff">

    <!-- LCP discovery: preload logo; homepage can add hero preload in HeadExtra -->
    <link rel="preload" as="image" href="/images/logo.jpg" fetchpriority="high" />

    @Styles.Render("~/Content/siteBootstrapCss")
    <link rel="stylesheet" href="@Url.Content("~/Content/designs/modern/css/theme.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/designs/modern/css/components.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/designs/modern/css/responsive.css")" />

    @RenderSection("HeadExtra", required: false)
</head>
<body lang="@htmlLang" data-design="modern">
    <input name="currentLang" type="hidden" value="@countryCode.ToString()" />

    <!-- Skip link for keyboard / AT users -->
    <a class="visually-hidden visually-hidden-focusable" href="#main-content">Skip to main content</a>

    <!-- Navbar Multilevel-->
    <!-- First line: Topbar-->
    <div class="navbar bg-dark py-2 px-0">
        <div class="container px-3">

            @Html.Action("WebSiteAddressInfo", "Home", new { isMobilePage = false })
            <!-- links collapsed (mobile)-->
            <div class="dropdown d-inline-block d-lg-none">
                <a class="dropdown-toggle text-light  py-1" href="#" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">@Resource.UsefulLinks</a>
                <div class="dropdown-menu">
                    <a class="dropdown-item" href="@Url.Action(Constants.AboutUs,"info", new { lang= countryCode })">@Resource.AboutUs</a>
                    <a class="dropdown-item" href="@Url.Action(Constants.DeliveryInfo,"info", new { lang= countryCode })">@Resource.DeliveryInfo</a>
                    @if (productPriceEnabled)
                    {
                        <a class="dropdown-item" href="@Url.Action("CargoTracking","Payment")">@Resource.TrackYourCargo</a>
                    }
                    <div class="dropdown-divider">
                    </div>
                    @Html.Action("WebSiteAddressInfo", "Home", new { isMobilePage = true })
                </div>
            </div>
            <div class="d-flex">
                <!-- topbar menu-->
                <ul class="list-inline mb-0 d-none d-lg-block">
                    <li class="list-inline-item me-2">
                        @Html.Action("Languages", "Home")
                    </li>
                    <li class="list-inline-item me-2">
                        <a class="text-light  py-1 ps-0 pe-2 border-right border-light"
                           href="@Url.Action(Constants.AboutUs,"info", new { lang= countryCode })">@Resource.AboutUs</a>
                    </li>
                    <li class="list-inline-item me-2">
                        <a class="text-light  py-1 ps-0 pe-2"
                           href="@Url.Action(Constants.DeliveryInfo,"info", new { lang= countryCode })">@Resource.DeliveryInfo</a>
                    </li>
                    @if (productPriceEnabled)
                    {
                        <li class="list-inline-item me-2">
                            <a class="text-light  py-1 ps-0 pe-2"
                               href="@Url.Action("CargoTracking","Payment")">@Resource.TrackYourCargo</a>
                        </li>
                    }
                </ul>

                @Html.Action("SocialMediaLinks", "Home")
            </div>
        </div>
    </div>
    <!-- Second line-->
    <header class="navbar navbar-expand-lg navbar-light bg-light px-0">
        <div class="container flex-sm-nowrap px-3">
            <!-- navbar brand-->
            <a class="navbar-brand mr-0 mr-sm-4" style="min-width: 100px;" href="@Url.Action("Index","Home")">
                <img src="/images/logo.jpg" width="200" height="60" style="max-width: 200px; height: auto;"
                     alt="@companyName" decoding="async" fetchpriority="high" />
            </a>

            <!-- navbar buttons-->
            <div class="navbar-btns d-flex position-relative order-sm-3">
                <button type="button" class="navbar-toggler navbar-btn collapsed bg-0 border-left-0 my-3"
                     data-bs-toggle="collapse" data-bs-target="#menu" aria-controls="menu" aria-expanded="false" aria-label="Menu">
                    <i class="mx-auto mb-2" data-feather="menu" aria-hidden="true"></i>
                    <span>Menu</span>
                </button>
                @if (productPriceEnabled)
                {
                    if (Request.IsAuthenticated)
                    {
                        <a class="navbar-btn bg-0 my-3" href="@Url.Action("index","home",new { @area="customers" })" data-bs-toggle="offcanvas">
                            <i class="mx-auto mb-1" data-feather="user" aria-hidden="true"></i>@Resource.MyAccount
                        </a>
                    }
                    else
                    {
                        <a class="navbar-btn bg-0 my-3" href="@Url.Action("login","account")" data-bs-toggle="offcanvas">
                            <i class="mx-auto mb-1" data-feather="log-in" aria-hidden="true"></i>@Resource.SignInOrUp
                        </a>
                    }

                    @Html.Raw(Html.Action("ShoppingCartLink", "Payment"))
                }
            </div>

            @Html.Partial("_SearchProductForm")
        </div>
    </header>

    @Html.Raw(Html.Action("Navigation", "Home", new { lang = countryCode }))

    <main id="main-content" role="main">
        @RenderBody()
    </main>

    @Html.Action("Footer", "Home", new { lang = countryCode })

    @Html.Raw(Html.Action("GoogleAnalyticsTrackingScript", "Home"))
    @Html.Raw(Html.Action("WhatsAppCommunicationScript", "Home"))
    <a class="scroll-to-top-btn" href="#main-content" aria-label="Scroll to top">
        <span class="scroll-to-top-btn-icon" aria-hidden="true">^</span>
    </a>

    @Scripts.Render("~/bundles/siteJquery")
    @Scripts.Render("~/bundles/siteJqueryMigrate")
    @Scripts.Render("~/bundles/siteBootstrap")
    @Scripts.Render("~/bundles/eimeceScripts")
    @RenderSection("scripts", required: false)
</body>
</html>
