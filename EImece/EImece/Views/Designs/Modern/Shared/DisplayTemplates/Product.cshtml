@model object
@using EImece.Domain.Models.DTOs.Storefront;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@{
    var dto = Model as StorefrontProductCardDto;
    var product = Model as Product;
    var id = dto != null ? dto.Id : (product != null ? product.Id : 0);
    var name = dto != null ? dto.Name : (product != null ? product.Name : string.Empty);
    var categoryName = dto != null ? dto.ProductCategoryName : (product != null && product.ProductCategory != null ? product.ProductCategory.Name : string.Empty);
    var detailUrl = dto != null ? dto.DetailPageRelativeUrl : (product != null ? product.DetailPageRelativeUrl : string.Empty);

    int Width = ViewData["Width"].ToInt(0);
    int Height = ViewData["Height"].ToInt(0);
    var productImageTag = dto != null ? dto.GetCroppedImageTag(Width, Height) : (product != null ? product.GetCroppedImageTag(Width, Height) : string.Empty);
}

<div class="one-third column portfolio-item media post-@id portfolio type-portfolio status-publish has-post-thumbnail hentry" id="post-@id" style="position: absolute; left: 320px; top: 0px;">
    <figure>
        <div class="portfolio-holder">
            <a title="@name" href="@detailUrl">
                @Html.Raw(productImageTag)
                <div class="hover-icon"></div>
            </a>
        </div>
        <a href="@detailUrl">
            <section class="item-description">
                <span>@name</span>
                <h5>@categoryName</h5>
            </section>
        </a>
    </figure>
</div>