@model EImece.Domain.Entities.Story
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Helpers
@using EImece.Domain
@using Resources
@{
    var story = Model;
    int Width = ViewData["Width"].ToInt(278);
    int Height = ViewData["Height"].ToInt(200);
    var imageId = story.MainImageId.HasValue ? story.MainImageId.Value : 0;
    var imageTag = story.GetCroppedImageTag(imageId, Width, Height, lazy: true, sizes: "(max-width: 767px) 90vw, (max-width: 991px) 45vw, 300px");
    var category = story.StoryCategory;
}

<article class="card story-short-card h-100 border-0 shadow-sm">
    <a href="@story.DetailPageUrl" class="story-short-thumb" aria-label="@story.Name">
        @Html.Raw(imageTag)
    </a>
    <div class="card-body d-flex flex-column">
        <h3 class="card-title h6 mb-2">
            <a href="@story.DetailPageUrl" class="text-dark">@story.Name</a>
        </h3>

        @if (category != null)
        {
            <p class="mb-1 text-muted small">
                <strong>@Resource.StoryCategory:</strong>
                <a href="@category.DetailPageRelativeUrl" class="text-dark">@category.Name</a>
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(story.AuthorName))
        {
            <p class="mb-1 text-muted small">
                <strong>@Resource.AuthorName:</strong> @story.AuthorName
            </p>
        }

        <p class="mb-2 text-muted small">
            <time datetime="@story.UpdatedDate.ToString("yyyy-MM-dd")">@story.UpdatedDate.ToShortDateString()</time>
            @if (story.IsFeaturedStory)
            {
                <span class="badge badge-success ml-1">Featured</span>
            }
        </p>

        @if (!string.IsNullOrWhiteSpace(story.ShortDescription))
        {
            <p class="card-text small text-muted mb-3 flex-grow-1">@Html.Raw(story.ShortDescription)</p>
        }
        else
        {
            <div class="flex-grow-1"></div>
        }

        <a href="@story.DetailPageUrl" class="btn btn-sm btn-outline-secondary align-self-start">@Resource.ReadMore</a>
    </div>
</article>
