@model System.Web.Mvc.HandleErrorInfo
@using Resources;
@using EImece.Domain.Helpers
@using EImece.Domain
@using System.Web

@{
    ViewBag.Title = "Error";
    var exception = Model != null ? Model.Exception : null;
    var errorCode = 0;
    if (exception is HttpException)
    {
        errorCode = ((HttpException)exception).GetHttpCode();
    }

    var body = string.Empty;
    body += string.Format("Page: {0} \n", Request.Url.AbsoluteUri);
    if (Request.UrlReferrer != null)
    {
        body += string.Format("Referal: {0} \n", Request.UrlReferrer.AbsoluteUri);
    }
    if (exception != null)
    {
        body += string.Format("Error: {0} \n", exception.Message);
    }
    body += string.Format("Time: {0} \n", DateTime.Now.ToLongTimeString());
    if (User.Identity.IsAuthenticated)
    {
        body += string.Format("User: {0} \n", User.Identity.Name);
    }
    body = GeneralHelper.EncodeForEmailLink(body);
    var subject = errorCode;
    var link = String.Format("mailto:yuce@marinelink.com?subject={0}&body={1}", subject, body);
}

<img src="~/Content/compass.png" alt="404" style="float:right;" />
@if (errorCode == 404)
{
    <h1 class="error">Sorry, the page your requested not found.</h1>
}
else
{
    <h1 class="error">@Resource.SorrySomethingWentWrong</h1>
}

@if (exception != null)
{
    <p class="well featured">
        @exception.Message
    </p>
}

@if (HttpContext.Current.IsDebuggingEnabled && exception != null && Model != null)
{
    <div class="panel panel-danger" style="margin-top: 20px; text-align: left;">
        <div class="panel-heading"><strong>@Resource.DetailedError</strong></div>
        <div class="panel-body">
            <p><strong>Controller:</strong> @Model.ControllerName &nbsp; <strong>Action:</strong> @Model.ActionName</p>
            <p><strong>Type:</strong> @exception.GetType().FullName</p>
            <pre style="white-space: pre-wrap; max-height: 480px; overflow: auto;">@exception.ToString()</pre>
        </div>
    </div>
}

<p>
    <span>
        To inform us of this error click
        <a class="button button-flat-primary" id="hlInform" href="@link">here</a>
    </span>
</p>
