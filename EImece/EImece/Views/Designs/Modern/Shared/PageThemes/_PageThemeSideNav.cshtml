@model EImece.Domain.Models.FrontModels.MenuPageViewModel
@using Resources;
@using EImece.Domain.Helpers.Extensions
@using System.Collections.Generic
@using System.Linq
@{
    var currentId = Model != null && Model.Menu != null ? Model.Menu.Id : 0;
    var items = Model != null && Model.SideMenus != null
        ? Model.SideMenus.Where(m => m != null).ToList()
        : new List<EImece.Domain.Models.DTOs.Storefront.StorefrontMenuDto>();
}
<nav class="pt-sidenav" aria-label="Sayfa menüsü">
    <div class="pt-sidenav__title">@Resource.SkipToMainContent</div>
    @if (items.Count > 0)
    {
        <ul class="pt-sidenav__list">
            @foreach (var item in items)
            {
                var href = item.DetailPageLink;
                var active = item.Id == currentId ? "is-active" : "";
                <li>
                    <a class="@active" href="@href">@item.Name</a>
                </li>
            }
        </ul>
    }
</nav>
