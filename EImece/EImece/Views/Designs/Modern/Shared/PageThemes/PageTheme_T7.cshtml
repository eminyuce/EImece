@model EImece.Domain.Models.FrontModels.MenuPageViewModel
@using EImece.Domain.Helpers.Extensions
@using Resources
@using System.Linq
@using System.Web.Mvc
@{
    var menu = Model.Menu;
    ViewBag.Title = menu.GetSeoTitle();
    ViewBag.Description = menu.GetSeoDescription();
    ViewBag.Keywords = menu.GetSeoKeywords();
    var files = menu.MenuFiles ?? Enumerable.Empty<EImece.Domain.Models.DTOs.Storefront.StorefrontMenuFileDto>();
    var galleryVd = new ViewDataDictionary { { "ColClass", "col-6 col-md-3" }, { "MinCount", 12 }, { "Width", 400 }, { "Height", 400 } };
}
<div class="page-title-wrapper" role="region" aria-label="Page title">
    <div class="container">
        <div class="alert alert-secondary" role="alert">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="mt-n1 mr-1"><i data-feather="home"></i></li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index","Home")">@Resource.HomePage</a>
                    </li>
                    <li class="breadcrumb-item active">@menu.Name</li>
                </ol>
            </nav>
        </div>
        <h1 class="page-title">@menu.Name</h1>
        <hr class="mt-4">
    </div>
</div>
<div class="container pt-page pt-t7">
    @Html.Partial("~/Views/Shared/PageThemes/_PageThemeGallery.cshtml", files, galleryVd)
</div>
