@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Models.DTOs.Storefront;
@model CustomerOrdersViewModel

@{
    ViewBag.Title = Resource.MyOrder;
    var myOrders = Model.Orders ?? new List<OrderListItemDto>();
    var paginatedOrders = new PaginatedModelList<OrderListItemDto>(myOrders, Model.Page, Model.RecordPerPage, myOrders.Count);
}

<div class="container customer-page pt-lg-3 pb-5 mb-sm-3">
    @Html.Partial("_CustomerSummaryDetails", Model.Customer)

    @if (myOrders.Count == 0)
    {
        <div class="common-block crizal-orders-empty text-center py-5 px-3">
            <div class="crizal-orders-empty__icon" aria-hidden="true">
                <i class="fas fa-shopping-bag"></i>
            </div>
            <h2 class="crizal-orders-empty__title">Henüz siparişiniz bulunmuyor</h2>
            <p class="crizal-orders-empty__text">Verdiğiniz siparişlerin durumunu ve kargo takiplerini bu sayfadan kolayca takip edebilirsiniz.</p>
            <a href="@Url.Action("Index", "Home", new { area = "" })" class="butn-style8">
                <i class="fas fa-shopping-cart" aria-hidden="true"></i>
                @Resource.ContinueShopping
            </a>
        </div>
    }
    else
    {
        <div class="common-block crizal-orders">
            <header class="line-title crizal-orders__head">
                <h2 class="h6 mb-0">@Resource.MyOrder</h2>
                <span class="crizal-orders__count">@myOrders.Count</span>
            </header>
            <p class="crizal-orders__lead">Tüm siparişlerinizi, kargo takip durumunu ve fatura özetlerinizi görüntüleyin.</p>

            <ul class="crizal-orders__list">
                @foreach (var o in paginatedOrders)
                {
                    var detailUrl = Url.Action("CustomerOrderDetail", "Home", new { id = o.Id, area = "customers" });
                    var hasTracking = !string.IsNullOrEmpty(o.ShipmentTrackingNumber);
                    var trackingHref = hasTracking
                        ? string.Format("{0}/{1}", Constants.ShipmentTrackingCompanyLink, HttpUtility.HtmlEncode(o.ShipmentTrackingNumber.ToStr()))
                        : Url.Action("CargoTracking", "Payment", new { id = o.OrderNumber, area = "" });
                    <li class="crizal-order-ticket">
                        <div class="crizal-order-ticket__main">
                            <div class="crizal-order-ticket__id">
                                <span class="crizal-order-ticket__label">@Resource.OrderNumber</span>
                                <a class="crizal-order-ticket__number" href="@detailUrl">@o.OrderNumber</a>
                            </div>
                            <div class="crizal-order-ticket__meta">
                                <div>
                                    <span class="crizal-order-ticket__label">@Resource.DatePurchased</span>
                                    <span class="crizal-order-ticket__value">@o.CreatedDate.ToString("dd MMMM yyyy, HH:mm")</span>
                                </div>
                                <div>
                                    <span class="crizal-order-ticket__label">@Resource.OrderStatus</span>
                                    @Html.Partial("_OrderStatusBadge", (object)o.OrderStatus)
                                </div>
                                <div>
                                    <span class="crizal-order-ticket__label">@Resource.Total</span>
                                    <span class="crizal-order-ticket__total">@o.PaidPriceDecimal.CurrencySign()</span>
                                </div>
                            </div>
                            <div class="crizal-order-ticket__ship">
                                @if (hasTracking)
                                {
                                    <a class="crizal-order-ticket__track" href="@trackingHref" target="_blank" rel="noopener noreferrer">
                                        <i class="fas fa-truck" aria-hidden="true"></i>
                                        @(string.IsNullOrWhiteSpace(o.ShipmentCompanyName) ? Resource.TrackYourCargo : o.ShipmentCompanyName)
                                        <span>@o.ShipmentTrackingNumber</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="crizal-order-ticket__ship-empty">
                                        <i class="fas fa-box" aria-hidden="true"></i>
                                        @Resource.NoShipmentDoneYetForYourOrder
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="crizal-order-ticket__actions">
                            <a href="@detailUrl" class="butn-style8 small">@Resource.OrderSummary</a>
                            @if (hasTracking)
                            {
                                <a href="@trackingHref" class="butn-style8 outline small" target="_blank" rel="noopener noreferrer">@Resource.TrackYourCargo</a>
                            }
                        </div>
                    </li>
                }
            </ul>

            @if (paginatedOrders.TotalPageCount > 1)
            {
                <div class="crizal-orders__pager">
                    @Html.Partial("_PaginatedOrderList", paginatedOrders)
                </div>
            }
        </div>
    }
</div>
