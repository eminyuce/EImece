@using EImece.Domain.Entities;
@using EImece.Domain.Helpers;
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Helpers.Extensions;
@using Resources;
@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Models.DTOs;
@using EImece.Domain.Models.DTOs.Storefront;
@model SendMessageToSellerViewModel

@{
    ViewBag.Title = Resource.Faq;
}

<div class="container customer-page pt-lg-3 pb-5 mb-sm-3">
    @Html.Partial("_CustomerSummaryDetails", Model.Customer)

    <div class="customer-panel">
        <section class="customer-panel__section customer-panel__section--last">
            <header class="customer-panel__section-head">
                <h2 class="customer-panel__section-title">@Resource.FrequentlyAskedQuestions</h2>
                <p class="customer-panel__section-lead">SipariÅŸ, teslimat ve hesap iÅŸlemleri hakkÄ±nda sÄ±k sorulan sorular.</p>
            </header>

            @if (!string.IsNullOrWhiteSpace(Resource.QuestionAboutItemForCustomer))
            {
                <div class="customer-faq-intro">
                    @Html.Raw(Resource.QuestionAboutItemForCustomer)
                </div>
            }

            @if (Model.Faqs.IsNotEmpty())
            {
                <div class="customer-faq accordion" id="faqAccordion">
                    @{ int index = 1; }
                    @foreach (FaqSummaryDto faq in Model.Faqs)
                    {
                        <div class="customer-faq__item card">
                            <div class="customer-faq__header card-header" id="heading-@faq.Id">
                                <h3 class="customer-faq__question mb-0">
                                    <button class="customer-faq__toggle btn btn-link collapsed"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse-@faq.Id"
                                            aria-expanded="false"
                                            aria-controls="collapse-@faq.Id">
                                        <span class="customer-faq__index" aria-hidden="true">@index</span>
                                        <span class="customer-faq__text">@faq.Question</span>
                                        <i class="fas fa-chevron-down customer-faq__chevron" aria-hidden="true"></i>
                                    </button>
                                </h3>
                            </div>
                            <div id="collapse-@faq.Id" class="collapse" aria-labelledby="heading-@faq.Id" data-parent="#faqAccordion">
                                <div class="customer-faq__body card-body">
                                    @Html.Raw(faq.Answer)
                                </div>
                            </div>
                        </div>
                        index++;
                    }
                </div>
            }
            else
            {
                <output class="customer-orders-empty text-center py-5 px-3 d-block">
                    <div class="customer-orders-empty__icon" aria-hidden="true">
                        <i class="fas fa-question"></i>
                    </div>
                    <h3 class="customer-orders-empty__title h5 mb-2">HenÃ¼z SSS eklenmemiÅŸ</h3>
                    <p class="customer-orders-empty__text text-muted mb-0">SorularÄ±nÄ±z iÃ§in satÄ±cÄ±ya mesaj gÃ¶nderebilirsiniz.</p>
                </output>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#faqAccordion').on('show.bs.collapse', function (e) {
                $(e.target).closest('.customer-faq__item').addClass('is-open');
            });
            $('#faqAccordion').on('hide.bs.collapse', function (e) {
                $(e.target).closest('.customer-faq__item').removeClass('is-open');
            });
        });
    </script>
}

