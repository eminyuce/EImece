@model EImece.Domain.Entities.Customer
@using Resources;
@using EImece.Domain;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers;
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Helpers.Extensions;
@{
    ViewBag.Title = Resource.MyAccount;
    List<Order> orders = Model.Orders;
    if (orders.IsEmpty())
    {
        orders = new List<Order>();
    }

    var billingIncomplete = string.IsNullOrWhiteSpace(Model.Name)
        || string.IsNullOrWhiteSpace(Model.Surname)
        || string.IsNullOrWhiteSpace(Model.GsmNumber)
        || string.IsNullOrWhiteSpace(Model.City)
        || string.IsNullOrWhiteSpace(Model.Town)
        || string.IsNullOrWhiteSpace(Model.Street);
}

<div class="container customer-page pt-lg-3 pb-5 mb-sm-3">
    <div class="toast-container toast-bottom-center">
        <div class="toast mb-3" id="profile-toast" data-delay="5000" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-success text-white">
                <i class="fas fa-check-circle mr-2" aria-hidden="true"></i>
                <span class="font-weight-semibold mr-auto">Updated!</span>
                <button class="close text-white ml-2 mb-1" type="button" data-dismiss="toast" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="toast-body">@Resource.YourProfileUpdatedSuccessfully</div>
        </div>
    </div>

    @Html.Partial("_CustomerDetails", Model)

    @if (billingIncomplete)
    {
        <div class="customer-banner customer-banner--warn" role="status">
            <div class="customer-banner__icon" aria-hidden="true"><i class="fas fa-exclamation-circle"></i></div>
            <div class="customer-banner__body">
                <strong>@Resource.CustomerBillingDetailsNotFilledOut</strong>
                <p class="mb-0">Teslimat ve fatura için aşağıdaki bilgileri tamamlayın.</p>
            </div>
        </div>
    }

    @using (Html.BeginForm("Index", "Home", null, FormMethod.Post, new { @class = "customer-panel" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-success" })
        @Html.HiddenFor(model => model.Email)
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.IsActive)
        @Html.HiddenFor(model => model.CreatedDate)
        @Html.HiddenFor(model => model.UpdatedDate)
        @Html.HiddenFor(model => model.Lang)
        @Html.HiddenFor(model => model.Ip)
        @Html.HiddenFor(model => model.UserId)

        <section class="customer-panel__section">
            <header class="customer-panel__section-head">
                <h2 class="customer-panel__section-title">Kişisel bilgiler</h2>
                <p class="customer-panel__section-lead">Sipariş ve fatura için kullanılan ad soyad bilgileriniz.</p>
            </header>
            <div class="customer-panel__grid">
                <div class="form-group">
                    @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label", @for = "account-fn" })
                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", @id = "account-fn", autocomplete = "given-name" } })
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.Surname, htmlAttributes: new { @class = "control-label", @for = "account-ln" })
                    @Html.EditorFor(model => model.Surname, new { htmlAttributes = new { @class = "form-control", @id = "account-ln", autocomplete = "family-name" } })
                    @Html.ValidationMessageFor(model => model.Surname, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.IdentityNumber, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.IdentityNumber, new { htmlAttributes = new { @class = "form-control", @autocomplete = "off" } })
                    <small class="form-text text-muted customer-help-text">@Resource.WhyNeedIdentityNumber</small>
                    @Html.ValidationMessageFor(model => model.IdentityNumber, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <span class="control-label d-block">@Html.DisplayNameFor(model => model.Gender)</span>
                    <div class="customer-gender" role="radiogroup" aria-label="@Html.DisplayNameFor(model => model.Gender)">
                        <label class="customer-gender__option">
                            @Html.RadioButtonFor(model => model.Gender, ((int)GenderType.Woman).ToString(), new { @class = "customer-gender__input" })
                            <span>Kadın</span>
                        </label>
                        <label class="customer-gender__option">
                            @Html.RadioButtonFor(model => model.Gender, ((int)GenderType.Man).ToString(), new { @class = "customer-gender__input" })
                            <span>Erkek</span>
                        </label>
                    </div>
                    @Html.ValidationMessageFor(model => model.Gender, "", new { @class = "text-danger" })
                </div>
            </div>
        </section>

        <section class="customer-panel__section">
            <header class="customer-panel__section-head">
                <h2 class="customer-panel__section-title">İletişim</h2>
                <p class="customer-panel__section-lead">Sipariş durumu ve kargo bildirimleri için.</p>
            </header>
            <div class="customer-panel__grid">
                <div class="form-group">
                    @Html.LabelFor(model => model.GsmNumber, htmlAttributes: new { @class = "control-label", @for = "account-phone" })
                    @Html.EditorFor(model => model.GsmNumber, new { htmlAttributes = new { @class = "form-control", @id = "account-phone", placeholder = "+90 5XX XXX XX XX", autocomplete = "tel" } })
                    <small class="form-text text-muted customer-help-text">@Resource.WhyNeedGsmNumber</small>
                    @Html.ValidationMessageFor(model => model.GsmNumber, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <label class="control-label" for="account-email-ro">E-posta</label>
                    <input id="account-email-ro" class="form-control" type="email" value="@Model.Email" readonly disabled />
                </div>
            </div>
        </section>

        <section class="customer-panel__section">
            <header class="customer-panel__section-head">
                <h2 class="customer-panel__section-title">Teslimat adresi</h2>
                <p class="customer-panel__section-lead">Siparişlerinizin gönderileceği adres.</p>
            </header>
            <div class="customer-panel__grid">
                <div class="form-group">
                    <input type="hidden" id="SelectedCity" value="@Model.City" />
                    @Html.LabelFor(model => model.City, htmlAttributes: new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.City, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Cities" })
                    @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <input type="hidden" id="SelectedTown" value="@Model.Town" />
                    @Html.LabelFor(model => model.Town, htmlAttributes: new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.Town, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Towns" })
                    @Html.ValidationMessageFor(model => model.Town, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    <input type="hidden" id="SelectedDistrict" value="@Model.District" />
                    @Html.LabelFor(model => model.District, htmlAttributes: new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.District, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Districts" })
                    @Html.ValidationMessageFor(model => model.District, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.Street, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.Street, new { htmlAttributes = new { @class = "form-control", autocomplete = "street-address" } })
                    @Html.ValidationMessageFor(model => model.Street, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.ZipCode, htmlAttributes: new { @class = "control-label" })
                    @Html.EditorFor(model => model.ZipCode, new { htmlAttributes = new { @class = "form-control", autocomplete = "postal-code" } })
                    @Html.ValidationMessageFor(model => model.ZipCode, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => model.Country, htmlAttributes: new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.Country, GeneralHelper.GetStaticCountries(), new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Country, "", new { @class = "text-danger" })
                </div>
            </div>
            <details class="customer-address-help mt-2">
                <summary class="customer-address-help__summary">Adres yazımı için kısa ipucu</summary>
                <div class="customer-address-help__body">
                    @Html.Raw(String.Format(Resource.CustomerOpenAddressDescription, @Resource.CustomerOpenAddress))
                </div>
            </details>
        </section>

        <section class="customer-panel__section customer-panel__section--last">
            <header class="customer-panel__section-head">
                <h2 class="customer-panel__section-title">Notlar &amp; izinler</h2>
            </header>
            <div class="form-group mb-3">
                @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "3", placeholder = "Teslimat notu veya ek bilgi (isteğe bağlı)" })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>
            <div class="customer-profile-actions">
                <div class="custom-control custom-checkbox customer-consent">
                    @Html.CheckBoxFor(model => model.IsPermissionGranted, new { @class = "custom-control-input", id = "IsPermissionGranted" })
                    <label class="custom-control-label" for="IsPermissionGranted">@Resource.IsPermissionGrantedDescription</label>
                </div>
                <button class="btn customer-btn-primary customer-profile-actions__submit" type="submit" data-toggle="toast" data-target="#profile-toast">
                    @Resource.Update
                </button>
            </div>
        </section>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
    <script>
        $(function () {
            if (typeof GetIller === 'function' && $('#Cities').length) {
                GetIller();
            }
        });
    </script>
}
