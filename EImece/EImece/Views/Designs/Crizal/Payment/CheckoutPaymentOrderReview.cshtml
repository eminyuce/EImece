@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Models.DTOs;
@using EImece.Domain.Entities;
@using EImece.Web.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession

@{
    ViewBag.Title = Resources.Resource.CheckoutPaymentOrderReview;
    var products = Model.ShoppingCartItems;
    var customer = Model.Customer ?? new CustomerDto();
}
<!-- Page Title-->
<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@Resource.OrderFinalReview</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@Resource.OrderFinalReview</h1>
    </div>
</section>
<!-- Page Content-->
<div class="container pb-5 mb-sm-4 mt-n2 mt-md-n3">
    @Html.Partial("_PaymentSteps", "CheckoutPaymentOrderReview", new ViewDataDictionary(ViewData){
       {"AnyProducts",products.IsNotEmpty()}
         })
    <div class="row pt-4 mt-2">
        <div class="col-xl-9 col-md-8">
            <div class="common-block crizal-cart-items mb-4">
                <div class="line-title">
                    <h2 class="h6 mb-0">@Resource.ReviewYourOrder</h2>
                </div>
                @if (products.IsNotEmpty())
                {
                    for (int i = 0; i < products.Count; i++)
                    {
                        @CreateCheckoutCartItem(products[i], i)
                    }
                }
            </div>

            <div class="common-block mb-4">
                <div class="line-title d-flex flex-wrap justify-content-between align-items-center">
                    <h2 class="h6 mb-0">@Resource.OrderDetails</h2>
                    <a class="font-size-sm crizal-cart-continue" href="@Url.Action("checkoutbillingdetails")">
                        <i class="fas fa-pen mr-1" aria-hidden="true"></i>@Resource.Edit
                    </a>
                </div>
                <ul class="list-unstyled mb-3 font-size-sm">
                    <li class="mb-1"><span class="text-muted">@Resource.Client:&nbsp;</span><strong>@customer.FullName</strong></li>
                    <li class="mb-1"><span class="text-muted">@Resource.Email:&nbsp;</span>@customer.Email</li>
                    <li class="mb-1"><span class="text-muted">@Resource.PhoneNumber:&nbsp;</span>@customer.GsmNumber</li>
                    @if (!string.IsNullOrEmpty(customer.IdentityNumber))
                    {
                        <li class="mb-1"><span class="text-muted">@Resource.IdentityNumber:&nbsp;</span>@customer.IdentityNumber</li>
                    }
                </ul>
                <h3 class="h6 mb-2">@Resource.ShippingAddress</h3>
                @Html.Partial("ShoppingCartTemplates/_AddressReview", Model)
            </div>

            <div class="common-block mb-0">
                <div class="line-title">
                    <h2 class="h6 mb-0">@Resource.Payment</h2>
                </div>
                <p class="mb-2 font-size-sm">@Html.Raw(Resource.PaymentIyzicoHtml)</p>
                <p class="mb-0 text-muted font-size-sm">@Resource.IyzicoPaymentTitle</p>
            </div>

            <div class="d-flex crizal-checkout-nav pt-4">
                <div class="w-50 pr-3">
                    <a class="butn-style8 outline btn-block" href="@Url.Action("checkoutbillingdetails")">
                        <i class="fas fa-chevron-left mr-1" aria-hidden="true"></i>@Resource.Back
                    </a>
                </div>
                <div class="w-50 pl-2">
                    <a class="butn-style8 btn-block" href="@Url.Action("PlaceOrder")" id="GoToPayment">
                        @Resource.GoToPayment
                        <i class="fas fa-chevron-right ml-1" aria-hidden="true"></i>
                    </a>
                    <p class="font-size-sm text-muted mt-2 mb-0 text-center">@Html.Raw(Resource.PaymentIyzicoHtml)</p>
                </div>
            </div>
        </div>
        @Html.Partial("_OrderSummary", Model)
    </div>
</div>

@helper CreateCheckoutCartItem(ShoppingCartItem item, int i)
{
    var product = item.Product;
    var totalPricePerItem = product.Price * item.Quantity;
    var imageUrl = !string.IsNullOrEmpty(product.CroppedImageUrl) ? product.CroppedImageUrl : AppConfig.GetDefaultImage(200, 0);
    <div class="crizal-cart-item is-readonly">
        <a class="crizal-cart-item__thumb" href="@product.DetailPageUrl">
            <img src="@imageUrl" alt="@product.Name" width="88" height="88" loading="lazy" decoding="async" />
        </a>
        <div class="crizal-cart-item__info">
            <h3 class="crizal-cart-item__name">
                <a href="@product.DetailPageUrl">@product.Name</a>
            </h3>
            <div class="crizal-cart-item__meta">
                <span>@Resource.UnitPrice: <strong>@product.Price.CurrencySign()</strong></span>
                @if (!string.IsNullOrEmpty(product.BrandName))
                {
                    <span>@product.BrandName</span>
                }
                @if (product.ProductSpecItems.IsNotEmpty())
                {
                    foreach (var productSpecs in product.ProductSpecItems)
                    {
                        <span>@productSpecs.SpecsName: @productSpecs.SpecsValue</span>
                    }
                }
            </div>
        </div>
        <div class="crizal-cart-item__qty">
            <span class="crizal-cart-item__qty-label">@Resource.Quantity</span>
            <span class="crizal-cart-item__qty-value">@item.Quantity</span>
        </div>
        <div class="crizal-cart-item__total">
            <span class="crizal-cart-item__total-label">@Resource.Total</span>
            <strong class="crizal-cart-item__total-price">@totalPricePerItem.CurrencySign()</strong>
        </div>
    </div>
}
