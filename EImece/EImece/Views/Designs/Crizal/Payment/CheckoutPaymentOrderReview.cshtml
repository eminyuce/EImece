@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Entities;
@using EImece.Web.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession

@{
    ViewBag.Title = Resources.Resource.CheckoutPaymentOrderReview;
    var products = Model.ShoppingCartItems;
    var customer = Model.Customer;
}
<!-- Page Title-->
<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@Resource.OrderFinalReview</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@Resource.OrderFinalReview</h1><span class="d-block mt-2 text-muted"></span>
    </div>
</section>
<!-- Page Content-->
<div class="container pb-5 mb-sm-4 mt-n2 mt-md-n3">
    <!-- Steps (wizard)-->
    @Html.Partial("_PaymentSteps", "CheckoutPaymentOrderReview", new ViewDataDictionary(ViewData){
       {"AnyProducts",products.IsNotEmpty()}
         })
    <div class="row pt-4 mt-2">
        <!-- Content-->
        <div class="col-xl-9 col-md-8">
            <h2 class="h6 px-4 py-3 bg-secondary mb-4">@Resource.ReviewYourOrder</h2>
            @if (products.IsNotEmpty())
            {
                for (int i = 0; i < products.Count; i++)
                {
            @CreateShoppingCartItem(products[i], i)
                }
            }

            <!-- Client details-->
            <div class="bg-secondary px-4 pt-4 pb-3 text-white">
                <div class="row">
                    <div class="col-sm-12">
                        <ul class="list-unstyled mb-0 font-size-sm">
                            <li class="mb-1"><span class="text-white-50">@Resource.Client:&nbsp;</span><strong>@customer.FullName</strong></li>
                            <li class="mb-1"><span class="text-white-50">@Resource.Email:&nbsp;</span>@customer.Email</li>
                            <li class="mb-1"><span class="text-white-50">@Resource.PhoneNumber:&nbsp;</span>@customer.GsmNumber</li>
                            <li class="mb-1"><span class="text-white-50">@Resource.IdentityNumber:&nbsp;</span>@customer.IdentityNumber</li>
                            <hr class="border-light" />
                            <li><span class="text-white-50"><strong>@Resource.ShippingAddress:&nbsp;</strong></span>@Html.Partial("ShoppingCartTemplates/_AddressReview", Model)</li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- Navigation-->
            <div class="d-flex pt-4">
                <div class="w-50 pr-3">
                    <a class="butn-style8 outline btn-block" href="@Url.Action("checkoutbillingdetails")">
                        <i class="fas fa-chevron-left mr-1" aria-hidden="true"></i>@Resource.Back
                    </a>
                </div>
                <div class="w-50 pl-2">
                    <a class="butn-style8 btn-block" href="@Url.Action("PlaceOrder")">
                        <span>@Resource.Payment</span>
                        <i class="fas fa-chevron-right ml-1" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
        @Html.Partial("_OrderSummary", Model)
    </div>
</div>

@helper CreateShoppingCartItem(ShoppingCartItem item, int i)
{
    var product = item.Product;
    var totalPricePerItem = product.Price * item.Quantity;

    <!-- Item-->
<div class="d-sm-flex justify-content-between my-4 pb-4 border-bottom">
    <input type="hidden" name=@String.Format("productId[{0}]", i) value="@product.Id">
    <input type="hidden" data-shopping-item-price="@item.ShoppingCartItemId" value="@product.Price" />
    <div class="media d-block d-sm-flex text-center text-sm-start">
        @if (!String.IsNullOrEmpty(product.CroppedImageUrl))
            {
        <a class="cart-item-thumb mx-auto mr-sm-4 flex-shrink-0" href="@product.DetailPageUrl">
            <img src="@product.CroppedImageUrl" alt="@product.Name" width="80" height="80" loading="lazy" decoding="async">
        </a>
            }
        <div class="media-body pt-3 text-sm-start">
            <h3 class="h5 font-weight-semibold border-0 pb-1 mb-1">
                <a href="@product.DetailPageUrl">@product.Name</a>
            </h3>
            <div class="font-size-sm mb-1"><span class="text-muted mr-2">@Resource.UnitPrice:</span><strong>@product.Price.CurrencySign()</strong></div>
            <div class="font-size-sm mb-1"><span class="text-muted mr-2">@Resource.ProductCategory:</span>@product.CategoryName</div>
            @if (product.ProductSpecItems.IsNotEmpty())
            {
                foreach (var productSpecs in product.ProductSpecItems)
                {
            <div class="font-size-sm mb-1"><span class="text-muted mr-2">@productSpecs.SpecsName :</span>@productSpecs.SpecsValue </div>
                }
            }
        </div>
    </div>
    <div class="pt-2 pl-sm-3 mx-auto mx-sm-0 text-center text-sm-start cart-item-totals" style="max-width: 10rem;">
        <div class="font-size-sm mb-3"><span class="text-muted mr-2">@Resource.Quantity:</span><span class="font-weight-semibold">@item.Quantity</span></div>
        <div class="font-size-sm mb-3"><span class="text-muted mr-2">@Resource.Total:</span><span class="font-weight-semibold">@item.TotalPrice.CurrencySign()</span></div>
    </div>
</div>

}