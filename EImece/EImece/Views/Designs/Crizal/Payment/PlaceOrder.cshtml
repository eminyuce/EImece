@using EImece.Domain.Models.Payment;
@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Entities;
@using EImece.Web.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession
@{
    ViewBag.Title = Resources.Resource.PlaceOrder;
    var products = Model.ShoppingCartItems;
    PaymentInitializeResult checkoutFormInitialize = ViewBag.CheckoutFormInitialize;
    var paymentFormReady = checkoutFormInitialize != null && !string.IsNullOrEmpty(checkoutFormInitialize.CheckoutFormContent);
}
<!-- Page Title-->
<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@Resource.Payment</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@Resource.PlaceOrder</h1>
    </div>
</section>
<!-- Page Content-->
<div class="container pb-5 mb-sm-4 mt-n2 mt-md-n3">
    @Html.Partial("_PaymentSteps", "PlaceOrder", new ViewDataDictionary(ViewData){
      {"AnyProducts",products.IsNotEmpty()}
        })
    <div class="crizal-payment-trust common-block d-flex align-items-center justify-content-center mb-4">
        <img src="~/Content/img/logo-footer-mastervisa.png" alt="iyzico" class="crizal-payment-trust__logo" width="120" height="22">
        <span class="crizal-payment-trust__text">@Html.Raw(Resource.PaymentIyzicoHtml)</span>
    </div>
    <div class="row pt-2">
        <div class="col-xl-9 col-md-8">
            <div class="common-block crizal-payment-box mb-4">
                <div class="line-title">
                    <h2 class="h6 mb-0">@Resource.IyzicoPaymentTitle</h2>
                </div>
                <div id="iyzipay-checkout-form" class="responsive"></div>
                @if (paymentFormReady)
                {
                    @Html.Raw(checkoutFormInitialize.CheckoutFormContent)
                }
                else if (checkoutFormInitialize != null && !string.IsNullOrEmpty(checkoutFormInitialize.PaymentPageUrl))
                {
                    <iframe src="@checkoutFormInitialize.PaymentPageUrl" title="@Resource.Payment" class="w-100" style="min-height: 520px; border: 0;"></iframe>
                }
                else
                {
                    var iyzicoError = checkoutFormInitialize != null ? checkoutFormInitialize.ErrorMessage : null;
                    var isEmailError = !string.IsNullOrWhiteSpace(iyzicoError)
                                       && (iyzicoError.IndexOf("email", StringComparison.OrdinalIgnoreCase) >= 0
                                           || string.Equals(iyzicoError, Resource.IyzicoEmailNotValidMessage, StringComparison.Ordinal));
                    <div class="alert alert-warning mb-3" role="alert">
                        @if (isEmailError)
                        {
                            <p class="mb-0">@Resource.IyzicoEmailNotValidMessage</p>
                        }
                        else
                        {
                            @Resource.PaymentFormCouldNotBeInitializedSettings
                        }
                    </div>
                    <div class="d-flex flex-wrap crizal-checkout-nav">
                        @if (isEmailError)
                        {
                            <a class="butn-style8" href="@Url.Action("CheckoutBillingDetails")">
                                <i class="fas fa-pen mr-1" aria-hidden="true"></i>@Resource.Edit
                            </a>
                        }
                        <a class="butn-style8 outline" href="@Url.Action("CheckoutPaymentOrderReview")">
                            <i class="fas fa-chevron-left mr-1" aria-hidden="true"></i>@Resource.Back
                        </a>
                    </div>
                }
            </div>
            @Html.Partial("_OrderSummaryBeforePayment", Model, new ViewDataDictionary(ViewData){
                {"HideProducts", true}
            })
            <div class="d-flex crizal-checkout-nav pt-2 pb-3">
                <div class="w-50 pr-3">
                    <a class="butn-style8 outline btn-block" href="@Url.Action("CheckoutPaymentOrderReview")">
                        <i class="fas fa-chevron-left mr-1" aria-hidden="true"></i>@Resource.Back
                    </a>
                </div>
            </div>
        </div>
        @Html.Partial("_OrderSummary", Model)
    </div>
</div>
