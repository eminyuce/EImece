@using EImece.Domain.Models.Payment;
@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession
@{

    ViewBag.Title = Resources.Resource.PlaceOrder;
    var products = Model.ShoppingCartItems;
    var customer = Model.Customer;
    PaymentInitializeResult checkoutFormInitialize = ViewBag.CheckoutFormInitialize;
}
@*
    İyzico Ödeme Ekranı

*@
<!--  Html.DisplayFor(model => checkoutFormInitialize) -->
<!-- Page Title-->
<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@Resource.Payment</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@Resource.IyzicoPaymentTitle</h1><span class="d-block mt-2 text-muted"></span>
    </div>
</section>
<!-- Page Content-->
<div class="container pb-5 mb-sm-4 mt-n2 mt-md-n3">
    @Html.Partial("_PaymentSteps", "PlaceOrder", new ViewDataDictionary(ViewData){
      {"AnyProducts",products.IsNotEmpty()}
        })
    <div class="col-12 mb-4">
        <div class="crizal-payment-trust common-block d-flex align-items-center justify-content-center">
            <img src="~/Content/img/logo-footer-mastervisa.png" alt="iyzico" class="crizal-payment-trust__logo" width="120" height="22">
            <span class="crizal-payment-trust__text">@Html.Raw(@Resource.PaymentIyzicoHtml)</span>
        </div>
    </div>
    <!-- Steps (wizard)-->
    <div class="row pt-4 mt-2">
        <div class="col-md-8">
            @Html.Partial("_OrderSummaryBeforePayment", Model)
        </div>
        <div class="col-md-4">
            <div id="iyzipay-checkout-form" class="responsive"></div>
            @if (checkoutFormInitialize != null && !string.IsNullOrEmpty(checkoutFormInitialize.CheckoutFormContent))
            {
                @Html.Raw(checkoutFormInitialize.CheckoutFormContent)
            }
            else
            {
                <div class="alert alert-warning mb-0" role="alert">
                    @(string.IsNullOrEmpty(checkoutFormInitialize != null ? checkoutFormInitialize.ErrorMessage : null)
                        ? "Ödeme formu şu anda başlatılamadı. Lütfen daha sonra tekrar deneyin veya destek ile iletişime geçin."
                        : checkoutFormInitialize.ErrorMessage)
                </div>
            }
        </div>
    </div>
</div>
