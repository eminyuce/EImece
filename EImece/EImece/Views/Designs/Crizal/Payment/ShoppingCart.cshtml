@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession

@{
    ViewBag.Title = Resources.Resource.MyBasket;
    var products = Model.ShoppingCartItems;
    string continueShoppingLink = String.IsNullOrEmpty(Model.UrlReferrer) ? Url.Action("category", "ProductCategories") : Model.UrlReferrer;

}

<!-- Page Title-->
<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@Resource.MyBasket</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@Resource.MyBasket</h1><span class="d-block mt-2 text-muted"></span>
    </div>
</section>
<!-- Page Content-->
<div class="container pb-5 mb-sm-4 mt-n2 mt-md-n3">
    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-warning" role="alert">@TempData["StatusMessage"]</div>
    }
    @Html.Partial("_PaymentSteps", "ShoppingCart", new ViewDataDictionary(ViewData){
       {"AnyProducts",products.IsNotEmpty()}
         })
    <div class="row pt-4 mt-2">
        <!-- Content-->
        <div class="col-md-12">
            <div class="row">

                <div class="@(products.IsNotEmpty() ? "col-xl-9 col-md-8" : "col-12")">
                    @if (products.IsNotEmpty())
                    {
                        <h2 class="h6 d-flex flex-wrap justify-content-between align-items-center px-4 py-3 bg-secondary">
                            <span>@Resource.Products</span>
                            <a class="font-size-sm" href="@continueShoppingLink">
                                <i data-feather="chevron-left" style="width: 1rem; height: 1rem;"></i>@Resource.ContinueShopping
                            </a>

                        </h2>

                        for (int i = 0; i < products.Count; i++)
                        {
                            @CreateShoppingCartItem(products[i], i)
                        }
                    }
                    else
                    {
                        @Html.Partial("_EmptyState", new EmptyStateViewModel(
                            Resource.MyBasket,
                            String.Format(Resource.NoProductFoundInShoppingBasket, HttpUtility.HtmlAttributeEncode(Url.Action("Index", "Home"))),
                            Url.Action("Index", "Home"),
                            Resource.ContinueShopping,
                            "fa fa-shopping-cart"
                        ))
                    }
                </div>

                <input type="hidden" id="OrderGuid" value="@Model.OrderGuid" />

                @* DESIGN-008: _OrderSummary returns early when AnyProducts is false *@
                @Html.Partial("_OrderSummary", Model, new ViewDataDictionary(ViewData){
       {"IsAdditionalComment",true},
               {"AnyProducts",products.IsNotEmpty()}
         })
            </div>
        </div>
    </div>
</div>

@helper CreateShoppingCartItem(ShoppingCartItem item, int i)
{
    var product = item.Product;
    var totalPricePerItem = product.Price * item.Quantity;
    <!-- Item-->
<div data-shopping-item-row="@item.ShoppingCartItemId" class="d-sm-flex justify-content-between my-4 pb-4 border-bottom">
    <input type="hidden" name=@String.Format("productId[{0}]", i) value="@product.Id">
    <input type="hidden" data-shopping-item-price="@item.ShoppingCartItemId" value="@product.Price" />
    <div class="media d-block d-sm-flex text-center text-sm-start">
        @if (!String.IsNullOrEmpty(product.CroppedImageUrl))
            {
        <a class="cart-item-thumb mx-auto mr-sm-4" href="@product.DetailPageUrl">
            <img class="rsImg" src="@product.CroppedImageUrl" alt="@product.Name" width="80" height="80" loading="lazy" decoding="async" />
        </a>
            }
            else
            {
        <a class="cart-item-thumb mx-auto mr-sm-4" href="@product.DetailPageUrl">
            <img class="rsImg" src="@AppConfig.GetDefaultImage(200, 0)" alt="@product.Name" width="80" height="80" loading="lazy" decoding="async" />
        </a>
            }

    <div class="media-body pt-3 text-sm-start">
        <h3 class="h5 font-weight-semibold border-0 pb-1 mb-1">
            <a href="@product.DetailPageUrl">@product.Name</a>
        </h3>
        <span class="font-size-lg text-primary pt-2 pb-1 d-inline-block" data-shopping-item-total-price="@item.ShoppingCartItemId"> @totalPricePerItem.CurrencySign()</span>
        <div class="font-size-sm mb-1"><span class="text-muted mr-2">@Resource.UnitPrice :</span>@product.Price.CurrencySign()</div>
        <div class="font-size-sm mb-1"><span class="text-muted mr-2">@Resource.ProductCategory :</span>@product.CategoryName</div>
        <div class="font-size-sm mb-1"><span class="text-muted mr-2">@Resource.ProductCode:</span>@product.ProductCode</div>
        @if (!string.IsNullOrEmpty(product.BrandName))
        {
            <div class="font-size-sm mb-1"><span class="text-muted mr-2">@Resource.ProductBrand:</span>@product.BrandName</div>
        }


        @if (product.ProductSpecItems.IsNotEmpty())
        {
            foreach (var productSpecs in product.ProductSpecItems)
            {
                <div class="font-size-sm mb-1"><span class="text-muted mr-2">@productSpecs.SpecsName :</span>@productSpecs.SpecsValue </div>
            }
        }
    </div>
    </div>
    <div class="pt-2 pt-sm-0 pl-sm-3 mx-auto mx-sm-0 text-center text-sm-start cart-item-actions" style="max-width: 10rem;">

        <div class="form-group mb-2 text-sm-start">
            <label class="font-size-sm text-muted" for="quantity-@item.ShoppingCartItemId">@Resource.Quantity</label>
            <input min="1" class="form-control form-control-sm" name=@String.Format("quantity[{0}]", i)
                   data-shopping-quantity-id="@item.ShoppingCartItemId"
                   type="number" id="quantity-@item.ShoppingCartItemId" value="@item.Quantity">
        </div>
        <button data-shopping-button-price="@item.ShoppingCartItemId" class="butn-style8 outline small btn-block mb-2" type="button"><i class="fas fa-sync-alt mr-1" aria-hidden="true"></i>@Resource.Update</button>
        <button data-shopping-item-remove="@item.ShoppingCartItemId" class="butn-style8 secondary small btn-block mb-2" type="button"><i class="fas fa-trash-alt mr-1" aria-hidden="true"></i>@Resource.Remove</button>
    </div>
</div>
}
@section Scripts{

    <script>

        $(document).ready(function () {

            $('input[data-shopping-quantity-id]').each(function () {
                $(this).off("change");
                $(this).on("change", function (e) {
                    e.preventDefault();
                    var caller = e.target;
                    var min = parseInt($(caller).attr('min'));
                    if ($(this).val() < min) {
                        $(this).val(min);
                    }
                });
            });

            $('#ProceedToCheckout').click(function (event) {
                event.preventDefault();
                var txtArea = $("#orderComments");
                var postData = JSON.stringify({
                    orderComments: txtArea.val(),
                    orderGuid: txtArea.attr("data-shopping-order-guid")
                });
                console.log(postData);
                var hrefUrl = $(this).attr('href');
                ajaxMethodCall(postData, "/Payment/sendOrderComments", function (data) {
                    window.location.href = hrefUrl;
                });
            });

        });
    </script>
}