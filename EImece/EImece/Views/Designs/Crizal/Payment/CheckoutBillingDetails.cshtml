@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Models.DTOs;
@using EImece.Domain.Entities;
@using EImece.Web.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession

@{
    ViewBag.Title = Resources.Resource.CheckoutBillingDetails;
    var products = Model.ShoppingCartItems;
    var customer = Model.Customer ?? new CustomerDto();
}
<!-- Page Title-->
<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@Resource.OrderDetails</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@Resource.OrderDetails</h1>
    </div>
</section>
<!-- Page Content-->
<div class="container pb-5 mb-sm-4 mt-n2 mt-md-n3">
    @Html.Partial("_PaymentSteps", "CheckoutBillingDetails", new ViewDataDictionary(ViewData){
       {"AnyProducts",products.IsNotEmpty()}
         })

    <div class="row pt-4 mt-2">
        <div class="col-xl-9 col-md-8">
            @using (Html.BeginForm("CheckoutBillingDetails", "Payment", FormMethod.Post, new { enctype = "multipart/form-data", @class = "common-block crizal-checkout-form js-checkout-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => customer.Id)
                @Html.HiddenFor(model => customer.CreatedDate)
                @Html.HiddenFor(model => customer.UpdatedDate)
                @Html.HiddenFor(model => customer.Email)
                <input type="hidden" name="customer.IsSameAsShippingAddress" value="true" />

                <div class="line-title mb-3">
                    <h2 class="h5 mb-0">@Resource.OrderDetails</h2>
                </div>

                if (!string.IsNullOrWhiteSpace(customer.FullName) || !string.IsNullOrWhiteSpace(customer.Email))
                {
                    <div class="crizal-checkout-account mb-3">
                        <div class="font-weight-bold">@customer.FullName</div>
                        @if (!string.IsNullOrWhiteSpace(customer.Email))
                        {
                            <div class="text-muted font-size-sm">@customer.Email</div>
                        }
                    </div>
                }

                if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                    </div>
                }

                <h3 class="h6 crizal-checkout-section">@Resource.PersonalInfo</h3>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Name) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.Name, new { htmlAttributes = new { @class = "form-control", autocomplete = "given-name", required = "required" } })
                            @Html.ValidationMessageFor(model => customer.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Surname) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.Surname, new { htmlAttributes = new { @class = "form-control", autocomplete = "family-name", required = "required" } })
                            @Html.ValidationMessageFor(model => customer.Surname, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Email)
                            <input type="email" class="form-control" value="@customer.Email" readonly="readonly" autocomplete="email" aria-readonly="true" />
                            @Html.ValidationMessageFor(model => customer.Email, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.GsmNumber) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.GsmNumber, new { htmlAttributes = new { @class = "form-control", type = "tel", inputmode = "tel", autocomplete = "tel", required = "required" } })
                            <small class="form-text-help">@Resource.WhyNeedGsmNumber</small>
                            @Html.ValidationMessageFor(model => customer.GsmNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.IdentityNumber) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.IdentityNumber, new { htmlAttributes = new { @class = "form-control", inputmode = "numeric", maxlength = "11", autocomplete = "off", required = "required" } })
                            <small class="form-text-help">@Resource.WhyNeedIdentityNumber</small>
                            @Html.ValidationMessageFor(model => customer.IdentityNumber, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Company)
                            @Html.EditorFor(model => customer.Company, new { htmlAttributes = new { @class = "form-control", autocomplete = "organization" } })
                            @Html.ValidationMessageFor(model => customer.Company, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <h3 class="h6 crizal-checkout-section">@Resource.DeliveryAddress</h3>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="hidden" id="SelectedCity" value="@customer.City" />
                            @Html.LabelFor(model => customer.City) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.DropDownListFor(model => customer.City, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Cities", autocomplete = "address-level1", required = "required" })
                            @Html.ValidationMessageFor(model => customer.City, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="hidden" id="SelectedTown" value="@customer.Town" />
                            @Html.LabelFor(model => customer.Town) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.DropDownListFor(model => customer.Town, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Towns", autocomplete = "address-level2", required = "required" })
                            @Html.ValidationMessageFor(model => customer.Town, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="hidden" id="SelectedDistrict" value="@customer.District" />
                            @Html.LabelFor(model => customer.District) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.DropDownListFor(model => customer.District, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Districts", required = "required" })
                            @Html.ValidationMessageFor(model => customer.District, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Street) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.EditorFor(model => customer.Street, new { htmlAttributes = new { @class = "form-control", autocomplete = "street-address", required = "required" } })
                            @Html.ValidationMessageFor(model => customer.Street, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.ZipCode)
                            @Html.EditorFor(model => customer.ZipCode, new { htmlAttributes = new { @class = "form-control", inputmode = "numeric", autocomplete = "postal-code" } })
                            @Html.ValidationMessageFor(model => customer.ZipCode, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(model => customer.Country) <span class="text-danger" aria-hidden="true">*</span>
                            @Html.DropDownListFor(model => customer.Country, EImece.Web.Helpers.WebGeneralHelper.GetStaticCountries(), new { @class = "form-control", autocomplete = "country-name", required = "required" })
                            @Html.ValidationMessageFor(model => customer.Country, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(model => customer.Description, htmlAttributes: new { @class = "col-form-label" })
                    @Html.TextAreaFor(model => customer.Description, new { @class = "form-control", rows = "2", autocomplete = "off" })
                    @Html.ValidationMessageFor(model => customer.Description, "", new { @class = "text-danger" })
                </div>

                <p class="crizal-checkout-note mb-0">@Resource.IsSameAsShippingAddress</p>

                <div class="d-flex crizal-checkout-nav pt-4 mt-3">
                    <div class="w-50 pr-3">
                        <a class="butn-style8 outline btn-block" href="@Url.Action("shoppingcart")">
                            <i class="fas fa-chevron-left mr-1" aria-hidden="true"></i>
                            <span class="d-none d-sm-inline">@Resource.MyBasket</span><span class="d-inline d-sm-none">@Resource.Back</span>
                        </a>
                    </div>
                    <div class="w-50 pl-2">
                        <button type="submit" id="ReviewYourOrder" class="butn-style8 btn-block js-checkout-submit">
                            @Resource.OrderFinalReview
                            <i class="fas fa-chevron-right ml-1" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
            }
        </div>
        @Html.Partial("_OrderSummary", Model)
    </div>
</div>

    @section Scripts {
        <script>
            $(document).ready(function () {
                GetIller();
            });
        </script>
}
