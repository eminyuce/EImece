@using EImece.Domain;
@using EImece.Domain.Models.DTOs;
@using EImece.Domain.Helpers;
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Helpers.Extensions;
@using Resources;
@using EImece.Domain.Models.FrontModels;
@model EImece.Domain.Models.DTOs.Storefront.StorefrontOrderConfirmationDto
@{
    ViewBag.Title = Resources.Resource.ThanksForYourOrder;
    var item = Model;
    string urlActionLink = Url.Action("index", "home");
    string ordersLink = Url.Action("CustomerOrders", "Home", new { area = "Customers" });
    string trackingLink = Url.Action("CargoTracking", "Payment", new { id = item.OrderNumber });
    var customer = item.Customer;
    var shipping = item.ShippingAddress;
    var billing = item.BillingAddress;
    var orderStatusText = EImece.Domain.Helpers.EnumHelper.GetEnumDescription((EImeceOrderStatus)item.OrderStatus);
    var hasInstallment = !string.IsNullOrEmpty(item.Installment) && !item.Installment.Equals("1");
    var sameAddress = shipping != null && billing != null && billing.EqualsAddress(shipping);
    var deliveryFrom = item.CreatedDate.AddDays(3);
    var deliveryTo = item.CreatedDate.AddDays(14);
    var cardTypeText = (item.CardType ?? string.Empty).Replace("_", " ");
}

<section class="page-title-wrapper crizal-order-confirm-head" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@Resource.Thanks</span>
                </li>
            </ol>
        </nav>
        <h1 class="visually-hidden">@Resource.ThankYouForYourOrder</h1>
    </div>
</section>

<div class="container pb-5 mb-sm-4 crizal-order-confirm">
    @Html.Partial("_PaymentSteps", "ThankYouForYourOrder", new ViewDataDictionary(ViewData){
       {"AnyProducts", false}
    })

    <section class="crizal-order-confirm__hero" aria-labelledby="order-confirm-heading">
        <div class="crizal-order-confirm__icon" aria-hidden="true">
            <i class="fas fa-check"></i>
        </div>
        <div class="crizal-order-confirm__hero-copy">
            <p class="crizal-order-confirm__kicker">@Resource.Thanks</p>
            <h2 id="order-confirm-heading" class="crizal-order-confirm__title">@Resource.ThankYouForYourOrder</h2>
            <p class="crizal-order-confirm__lead">@string.Format(Resource.OrderSuccessfullyCompleted, item.OrderNumber)</p>
            @if (customer != null && !string.IsNullOrEmpty(customer.Email))
            {
                <p class="crizal-order-confirm__email">
                    <i class="fas fa-envelope" aria-hidden="true"></i>
                    @customer.Email
                </p>
            }
        </div>
        <div class="crizal-order-confirm__order-no">
            <span class="crizal-order-confirm__order-label">@Resource.OrderNumber</span>
            <a class="crizal-order-confirm__order-value" href="@trackingLink">@item.OrderNumber</a>
            <a class="crizal-order-confirm__track" href="@trackingLink">
                <i class="fas fa-truck" aria-hidden="true"></i>
                @Resource.TrackYourCargo
            </a>
        </div>
    </section>

    <ul class="crizal-order-confirm__meta">
        <li>
            <span class="crizal-order-confirm__meta-label">@Resource.OrderDate</span>
            <span class="crizal-order-confirm__meta-value">@item.CreatedDate.ToString("dd MMMM yyyy, HH:mm")</span>
        </li>
        <li>
            <span class="crizal-order-confirm__meta-label">@Resource.OrderStatus</span>
            <span class="crizal-order-confirm__status">@orderStatusText</span>
        </li>
        <li>
            <span class="crizal-order-confirm__meta-label">@Resource.EstimatedDelivery</span>
            <span class="crizal-order-confirm__meta-value">@deliveryFrom.ToString("dd MMMM") – @deliveryTo.ToString("dd MMMM yyyy")</span>
        </li>
    </ul>

    <div class="row crizal-order-confirm__grid">
        <div class="col-lg-8">
            <div class="common-block crizal-order-confirm__panel mb-4">
                <div class="line-title">
                    <h2 class="h6 mb-0">@Resource.OrderItems</h2>
                </div>
                <ul class="crizal-order-confirm__items">
                    @foreach (var product in item.OrderProducts)
                    {
                        <li class="crizal-order-confirm__item">
                            <div class="crizal-order-confirm__thumb" aria-hidden="true">
                                @if (!string.IsNullOrEmpty(product.ProductImageUrl))
                                {
                                    <img src="@product.ProductImageUrl" alt="" />
                                }
                                else
                                {
                                    <i class="fas fa-box"></i>
                                }
                            </div>
                            <div class="crizal-order-confirm__item-body">
                                <p class="crizal-order-confirm__item-name">@product.ProductName</p>
                                @if (!string.IsNullOrEmpty(product.ProductCode))
                                {
                                    <p class="crizal-order-confirm__item-code">@product.ProductCode</p>
                                }
                                <p class="crizal-order-confirm__item-qty">@Resource.Quantity: @product.Quantity × @product.ProductSalePrice.CurrencySign()</p>
                            </div>
                            <div class="crizal-order-confirm__item-total">@product.TotalPrice.CurrencySign()</div>
                        </li>
                    }
                </ul>
            </div>
        </div>
        <div class="col-lg-4 crizal-order-confirm__sidebar">
            <div class="common-block crizal-order-confirm__panel mb-4">
                <div class="line-title">
                    <h2 class="h6 mb-0">@Resource.PaymentDetails</h2>
                </div>
                <dl class="crizal-order-confirm__totals">
                    @if (!string.IsNullOrEmpty(item.Price))
                    {
                        <div>
                            <dt>@Resource.Subtotal</dt>
                            <dd>@item.Price.ToDecimal().CurrencySign()</dd>
                        </div>
                    }
                    @if (item.CargoPrice > 0)
                    {
                        <div>
                            <dt>@Resource.ShippingCost</dt>
                            <dd>@item.CargoPrice.CurrencySign()</dd>
                        </div>
                    }
                    else
                    {
                        <div>
                            <dt>@Resource.ShippingCost</dt>
                            <dd>@Resource.FreeShipping</dd>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(item.Coupon))
                    {
                        <div>
                            <dt>@Resource.CouponDiscount (@item.Coupon)</dt>
                            <dd class="crizal-order-confirm__discount">-@item.CouponDiscount.ToDecimal().CurrencySign()</dd>
                        </div>
                    }
                    @if (hasInstallment)
                    {
                        <div>
                            <dt>@Resource.InstallmentCount</dt>
                            <dd>@item.InstallmentDescription</dd>
                        </div>
                    }
                    <div class="crizal-order-confirm__grand">
                        <dt>@Resource.TotalPaid</dt>
                        <dd>@item.PaidPriceDecimal.CurrencySign()</dd>
                    </div>
                </dl>
                @if (!string.IsNullOrEmpty(item.LastFourDigits))
                {
                    <p class="crizal-order-confirm__card">
                        <i class="fas fa-credit-card" aria-hidden="true"></i>
                        @item.CardFamily @cardTypeText — @Resource.EndingIn @item.LastFourDigits
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="row crizal-order-confirm__addresses">
        <div class="col-md-4">
            <div class="common-block crizal-order-confirm__panel mb-4">
                <div class="line-title">
                    <h2 class="h6 mb-0">@Resource.CustomerDetails</h2>
                </div>
                @if (customer != null)
                {
                    <p class="crizal-order-confirm__person mb-0">
                        <strong>@customer.FullName</strong><br />
                        @customer.Email<br />
                        @customer.GsmNumber
                    </p>
                }
            </div>
        </div>
        <div class="col-md-4">
            <div class="common-block crizal-order-confirm__panel mb-4">
                <div class="line-title">
                    <h2 class="h6 mb-0">@Resource.ShippingAddress</h2>
                </div>
                @if (shipping != null)
                {
                    <p class="crizal-order-confirm__person @(string.IsNullOrEmpty(item.ShipmentCompanyName) ? "mb-0" : "")">
                        @shipping.Name<br />
                        @shipping.Description<br />
                        @shipping.City, @shipping.Country @shipping.ZipCode
                    </p>
                }
                @if (!string.IsNullOrEmpty(item.ShipmentCompanyName))
                {
                    <p class="crizal-order-confirm__ship mb-0">
                        <strong>@Resource.ShipmentCompany:</strong> @item.ShipmentCompanyName<br />
                        <strong>@Resource.TrackingNumber:</strong> @item.ShipmentTrackingNumber
                    </p>
                }
            </div>
        </div>
        <div class="col-md-4">
            <div class="common-block crizal-order-confirm__panel mb-4">
                <div class="line-title">
                    <h2 class="h6 mb-0">@Resource.BillingAddress</h2>
                </div>
                @if (sameAddress)
                {
                    <p class="crizal-order-confirm__person mb-0">@Resource.IsSameAsShippingAddress</p>
                }
                else if (billing != null)
                {
                    <p class="crizal-order-confirm__person mb-0">
                        @billing.Name<br />
                        @billing.Description<br />
                        @billing.City, @billing.Country @billing.ZipCode
                    </p>
                }
            </div>
        </div>
    </div>

    <div class="crizal-order-confirm__actions crizal-checkout-nav">
        <a href="@urlActionLink" class="butn-style8">@Resource.ContinueShopping</a>
        @if (Request.IsAuthenticated)
        {
            <a href="@ordersLink" class="butn-style8 outline">@Resource.MyOrder</a>
        }
        <a href="@trackingLink" class="butn-style8 outline">@Resource.TrackYourCargo</a>
    </div>
</div>
