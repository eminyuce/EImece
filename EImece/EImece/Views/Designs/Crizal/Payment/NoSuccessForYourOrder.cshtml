@using EImece.Domain;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers;
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Helpers.Extensions;
@using Resources;
@using EImece.Domain.Models.FrontModels;

@{
    ViewBag.Title = Resources.Resource.Payment;
}

<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@Resource.Payment</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@Resource.Payment</h1>
    </div>
</section>

<div class="container pb-5 mb-sm-4">
    @Html.Partial("_PaymentSteps", "PlaceOrder", new ViewDataDictionary(ViewData){
       {"AnyProducts", true}
    })

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="common-block crizal-order-result text-center">
                <div class="crizal-order-result__icon crizal-order-result__icon--fail" aria-hidden="true">
                    <i class="fas fa-times"></i>
                </div>
                @Html.Raw(Resource.FailedOrderInfoMessage)
                <div class="d-flex flex-wrap justify-content-center crizal-checkout-nav mt-4" style="gap: 0.75rem;">
                    <a href="@Url.Action("PlaceOrder", "Payment")" class="butn-style8">@Resource.GoToPayment</a>
                    <a href="@Url.Action("ShoppingCart", "Payment")" class="butn-style8 outline">@Resource.MyBasket</a>
                    <a href="@Url.Action("Index", "Home")" class="butn-style8 outline">@Resource.ContinueShopping</a>
                </div>
            </div>
        </div>
    </div>
</div>
