@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Entities;
@using EImece.Web.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@model  ShoppingCartSession

@{
    bool IsAdditionalComment = ViewData["IsAdditionalComment"].ToBool(false);
    bool modelHasProducts = Model != null && Model.ShoppingCartItems.IsNotEmpty();
    // Prefer explicit ViewData from ShoppingCart; otherwise infer from the session model
    // so checkout pages that omit AnyProducts still render the summary.
    bool anyProducts = ViewData["AnyProducts"] != null
        ? ViewData["AnyProducts"].ToBool(false)
        : modelHasProducts;
    // DESIGN-008: do not show order summary / free-shipping badge on an empty cart
    if (!anyProducts)
    {
        return;
    }
}
<!-- Sidebar-->
<div class="col-xl-3 col-md-4 pt-4 mt-3 pt-md-0 mt-md-0">
    <div class="crizal-cart-total common-block">
        <div class="line-title">
            <h2 class="h6 mb-0">@Resource.OrderSummary</h2>
        </div>

        @{
            var qualifiesForFreeCargo = Model.CargoPriceValue <= 0
                || (Model.BasketMinTotalPriceForCargoInt > 0 && Model.TotalPrice > Model.BasketMinTotalPriceForCargoInt);
        }
        @if (Model.BasketMinTotalPriceForCargoInt > 0 && !qualifiesForFreeCargo)
        {
            <div class="alert alert-success text-center px-2 py-2 mb-3 free-cargo-banner" role="alert">
                <i class="fas fa-truck mr-1" aria-hidden="true"></i>
                <strong>@Model.BasketMinTotalPriceForCargoInt.CurrencySign() @Resource.CargoFreeText</strong>
            </div>
        }

        @if (TempData["CouponMessage"] != null)
        {
            var couponAlert = (TempData["CouponMessageType"] as string) ?? "info";
            <div class="alert alert-@couponAlert py-2">@TempData["CouponMessage"]</div>
        }

        <table class="cart-sub-total table table-borderless mb-0">
            <tbody>
                <tr>
                    <th scope="row">@Resource.MyBasket</th>
                    <td class="text-end" id="TotalPrice"><strong>@Model.TotalPrice.CurrencySign()</strong></td>
                </tr>
                @if (Model.Coupon != null)
                {
                    var couponDiscount = Model.CouponValidatedDiscount > 0
                        ? Model.CouponValidatedDiscount
                        : Model.CalculateCouponDiscount(Model.TotalPrice + Model.CargoPriceValue);
                    <tr>
                        <th scope="row">@Resource.CouponCode</th>
                        <td class="text-end" id="CouponName">@Model.CouponName</td>
                    </tr>
                    if (couponDiscount > 0)
                    {
                        <tr>
                            <th scope="row">@Resource.CouponDiscount</th>
                            <td class="text-end text-success">-@couponDiscount.CurrencySign()</td>
                        </tr>
                    }
                    if (Model.CouponShippingDiscount > 0)
                    {
                        <tr>
                            <th scope="row">@Resource.ShippingDiscount</th>
                            <td class="text-end text-success">-@Model.CouponShippingDiscount.CurrencySign()</td>
                        </tr>
                    }
                }
                <tr id="CargoFreeTextInfo" data-cargo-label="@Resource.CargoPrice" data-cargo-free="@Resource.CargoFreeTextInfo">
                    @if (qualifiesForFreeCargo)
                    {
                        <td colspan="2" class="p-0 pt-2">
                            <div class="alert alert-success text-center px-2 py-2 mb-0 free-cargo-banner" role="alert">
                                <i class="fas fa-check-circle mr-1" aria-hidden="true"></i>
                                <strong>@Resource.CargoFreeTextInfo</strong>
                            </div>
                        </td>
                    }
                    else
                    {
                        <th scope="row">@Resource.CargoPrice</th>
                        <td class="text-end">@Model.CargoPriceValue.CurrencySign()</td>
                    }
                </tr>
                <tr class="crizal-cart-total__grand">
                    <th scope="row"><span class="h5 font-weight-semibold">@Resource.Total</span></th>
                    <td class="text-end"><span class="h5 font-weight-semibold text-primary" id="TotalPriceWithCargoPrice">@Model.TotalPriceWithCargoPrice.CurrencySign()</span></td>
                </tr>
            </tbody>
        </table>

        @if (IsAdditionalComment && anyProducts)
        {
            <a class="butn-style8 btn-block mb-2" id="ProceedToCheckout" href="@Url.Action("CheckoutBillingDetails","Payment")">
                <i class="fas fa-arrow-right mr-2" aria-hidden="true"></i>@Resource.ProceedToCheckout
            </a>
            if (!Request.IsAuthenticated)
            {
                <a class="butn-style8 outline btn-block mb-3" id="ContinueShoppingWithoutAccount" href="@Url.Action("ShoppingWithoutAccount", "Payment")">
                    <i class="fas fa-user mr-2" aria-hidden="true"></i>@Resource.ContinueWithoutMembership
                </a>
            }
            if (Model.Coupon != null)
            {
                using (Html.BeginForm("RemoveCoupon", "Payment", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-danger btn-block mb-3" type="submit">
                        <i class="fas fa-times mr-1" aria-hidden="true"></i>@Resource.RemoveCoupon
                    </button>
                }
            }
            if (Model.Coupon == null)
            {
                using (Html.BeginForm("ApplyCoupon", "Payment", FormMethod.Post, new { @class = "needs-validation", @novalidate = "" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="visually-hidden" for="cart-promocode">@Resource.CouponCode</label>
                        <div class="input-group">
                            <input class="form-control" type="text" id="cart-promocode" name="couponCode" value="@Model.CouponCode" placeholder="@Resource.CouponCode" required="">
                            <button class="btn btn-outline-primary" type="submit"><i class="fas fa-tag mr-1" aria-hidden="true"></i>@Resource.ApplyCoupon</button>
                            <div class="invalid-feedback w-100">@Resource.ValidPromoCode</div>
                        </div>
                    </div>
                }
            }
            <hr class="my-3">
            <h3 class="h6 font-weight-semibold mb-2"><span class="badge bg-success mr-2 align-middle">@Resource.Note</span>@Resource.AdditionalComments</h3>
            <label class="visually-hidden" for="orderComments">@Resource.AdditionalComments</label>
            <textarea class="form-control mb-0"
                      data-shopping-order-guid="@Model.OrderGuid"
                      id="orderComments" rows="2"
                      placeholder="@Resource.AdditionalComments">@Model.OrderComments</textarea>
        }
    </div>
</div>
