@model EImece.Domain.Models.FrontModels.BuyWithNoAccountCreation
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Models.Enums;

@{
    ShoppingCartSession shoppingCartSession = (ShoppingCartSession)ViewBag.ShoppingCartSession;
    var customer = Model.Customer;
}

<!-- Page Title-->
<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@Resource.ContinueShoppingWithoutAccount</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@Resource.ContinueShoppingWithoutAccount</h1>
    </div>
</section>
<!-- Page Content-->
<div class="container pb-5 mb-sm-4 mt-n2 mt-md-n3">
    <div class="alert alert-info d-flex align-items-start mb-4" role="alert">
        <i class="fas fa-info-circle fa-lg mr-3 mt-1" aria-hidden="true"></i>
        <div>
            <strong class="d-block">@Resource.CustomerBillingDetailsNotFilledOut</strong>
            <span>@Resource.ContinueShoppingWithoutAccount</span>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-10 col-lg-11 col-md-12 mx-auto">
            @using (Html.BeginForm("ShoppingWithoutAccount", "Payment", FormMethod.Post, new { enctype = "multipart/form-data", @class = "needs-validation", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()

                <!-- Personal Information -->
                <div class="card shadow-sm border-0 mb-4">
                    <h2 class="h6 px-4 py-3 bg-secondary mb-0">
                        <i class="fas fa-user mr-2" aria-hidden="true"></i>@Resource.PersonalInfo
                    </h2>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-semibold" for="customer_Name"><i class="fas fa-user text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.Name)</label>
                                @Html.EditorFor(model => customer.Name, new { htmlAttributes = new { @class = "form-control", autocomplete = "given-name", id = "customer_Name" } })
                                @Html.ValidationMessageFor(model => customer.Name, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-semibold" for="customer_Surname"><i class="fas fa-user text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.Surname)</label>
                                @Html.EditorFor(model => customer.Surname, new { htmlAttributes = new { @class = "form-control", autocomplete = "family-name", id = "customer_Surname" } })
                                @Html.ValidationMessageFor(model => customer.Surname, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-semibold" for="customer_Email"><i class="fas fa-envelope text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.Email)</label>
                                @Html.EditorFor(model => customer.Email, new { htmlAttributes = new { @class = "form-control", type = "email", autocomplete = "email", id = "customer_Email" } })
                                @Html.ValidationMessageFor(model => customer.Email, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-semibold" for="customer_GsmNumber"><i class="fas fa-phone text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.GsmNumber)</label>
                                @Html.EditorFor(model => customer.GsmNumber, new { htmlAttributes = new { @class = "form-control", autocomplete = "tel", placeholder = "+90 5XX XXX XX XX", id = "customer_GsmNumber" } })
                                <small class="form-text text-muted">@Resource.WhyNeedGsmNumber</small>
                                @Html.ValidationMessageFor(model => customer.GsmNumber, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-semibold" for="customer_IdentityNumber"><i class="fas fa-id-card text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.IdentityNumber)</label>
                                @Html.EditorFor(model => customer.IdentityNumber, new { htmlAttributes = new { @class = "form-control", inputmode = "numeric", id = "customer_IdentityNumber" } })
                                <small class="form-text text-muted">@Resource.WhyNeedIdentityNumber</small>
                                @Html.ValidationMessageFor(model => customer.IdentityNumber, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <span class="font-weight-semibold d-block mb-2"><i class="fas fa-venus-mars text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.Gender)</span>
                                <div class="form-check form-check-inline mr-4">
                                    @Html.RadioButtonFor(model => customer.Gender, ((int)GenderType.Woman).ToString(), new { @class = "form-check-input", id = "customer_Gender_Woman" })
                                    <label class="form-check-label" for="customer_Gender_Woman">@Resource.WomanGender</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    @Html.RadioButtonFor(model => customer.Gender, ((int)GenderType.Man).ToString(), new { @class = "form-check-input", id = "customer_Gender_Man" })
                                    <label class="form-check-label" for="customer_Gender_Man">@Resource.ManGender</label>
                                </div>
                                @Html.ValidationMessageFor(model => customer.Gender, "", new { @class = "text-danger small d-block" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Delivery Address -->
                <div class="card shadow-sm border-0 mb-4">
                    <h2 class="h6 px-4 py-3 bg-secondary mb-0">
                        <i class="fas fa-map-marker-alt mr-2" aria-hidden="true"></i>@Resource.DeliveryAddress
                    </h2>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-semibold" for="customer_Country"><i class="fas fa-globe text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.Country)</label>
                                @Html.DropDownListFor(model => customer.Country, GeneralHelper.GetStaticCountries(), new { @class = "form-control", id = "customer_Country" })
                                @Html.ValidationMessageFor(model => customer.Country, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-semibold" for="customer_City"><i class="fas fa-city text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.City)</label>
                                <input type="hidden" id="SelectedCity" value="@customer.City" />
                                @Html.DropDownListFor(model => customer.City, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "customer_City" })
                                @Html.ValidationMessageFor(model => customer.City, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4 mb-3">
                                <label class="font-weight-semibold" for="customer_Town"><i class="fas fa-map text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.Town)</label>
                                <input type="hidden" id="SelectedTown" value="@customer.Town" />
                                @Html.DropDownListFor(model => customer.Town, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "customer_Town" })
                                @Html.ValidationMessageFor(model => customer.Town, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="font-weight-semibold" for="customer_District"><i class="fas fa-map-marker text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.District)</label>
                                <input type="hidden" id="SelectedDistrict" value="@customer.District" />
                                @Html.DropDownListFor(model => customer.District, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "customer_District" })
                                @Html.ValidationMessageFor(model => customer.District, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="font-weight-semibold" for="customer_ZipCode"><i class="fas fa-map-pin text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.ZipCode)</label>
                                @Html.EditorFor(model => customer.ZipCode, new { htmlAttributes = new { @class = "form-control", autocomplete = "postal-code", inputmode = "numeric", id = "customer_ZipCode" } })
                                @Html.ValidationMessageFor(model => customer.ZipCode, "", new { @class = "text-danger small" })
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="font-weight-semibold" for="customer_Street"><i class="fas fa-road text-muted mr-1" aria-hidden="true"></i> @Html.DisplayNameFor(model => customer.Street)</label>
                            @Html.EditorFor(model => customer.Street, new { htmlAttributes = new { @class = "form-control", autocomplete = "street-address", id = "customer_Street" } })
                            @Html.ValidationMessageFor(model => customer.Street, "", new { @class = "text-danger small" })
                        </div>
                        <div class="mb-2">
                            <label class="font-weight-semibold" for="customer_Description"><i class="fas fa-comment-dots text-muted mr-1" aria-hidden="true"></i> @Resource.PleaseEnterYourAddress</label>
                            @Html.TextAreaFor(model => customer.Description, new { @class = "form-control", rows = "3", id = "customer_Description" })
                            @Html.ValidationMessageFor(model => customer.Description, "", new { @class = "text-danger small" })
                        </div>
                        <div class="alert alert-light border mb-0 py-2 font-size-sm" role="alert">
                            <i class="fas fa-info-circle text-muted mr-1" aria-hidden="true"></i>
                            @Html.Raw(String.Format(Resource.CustomerOpenAddressDescription, @Resource.CustomerOpenAddress))
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm mb-4">
                    <i class="fas fa-credit-card mr-2" aria-hidden="true"></i>@Resource.GoToPayment
                </button>
            }
        </div>
    </div>

    <!-- Order Review -->
    @Html.Partial("_OrderSummaryBeforePayment", shoppingCartSession)
</div>

@section Scripts {
    <script>
            $(document).ready(function () {

                GetIller();

            });
    </script>

}
