@helper RelatedProductItem(Product product)
{
    var relatedProductImgTag = product.GetCroppedImageUrl(product.MainImageId, 300, 300);
    var shortDesc = GeneralHelper.GetDescriptionWithBody(product.ShortDescription, 100);
    var relatedProductPriceEnabled = Model.IsProductPriceEnable.SettingValue.ToBool(true);

    <div class="product-card">
        <div class="product-thumb box-shadow-0">
            @if (product.IsOnSale)
            {
                <div class="label-offer bg-red">@Resource.Sale</div>
            }
            <a class="product-thumb-link" href="@product.DetailPageRelativeUrl" aria-label="@product.Name">
                <img src="@relatedProductImgTag" width="300" height="300" alt="@product.Name" loading="lazy" decoding="async">
            </a>
        </div>
        <div class="product-card-body box-shadow-0">
            <a class="product-meta small d-block mb-1" href="@product.ProductCategory.DetailPageUrl">@product.ProductCategory.Name</a>
            <h3 class="product-card-title h6 mb-2"><a href="@product.DetailPageRelativeUrl">@product.Name</a></h3>
            @if (relatedProductPriceEnabled && product.PriceWithDiscount > 0)
            {
                <p class="price text-center m-0">
                    @if (product.Price > product.PriceWithDiscount)
                    {
                        <span class="text-muted small mr-1"><s>@product.Price.CurrencySign()</s></span>
                    }
                    <span class="text-primary">@product.PriceWithDiscount.CurrencySign()</span>
                </p>
            }
            @if (relatedProductPriceEnabled && product.IsBuyableState)
            {
                <button class="butn-style8 small mt-3 btn-block" data-add-product-cart="@product.ModifiedId" type="button" data-toggle="toast" data-target="#cart-toast">
                    <span>@Resource.AddToCart</span>
                </button>
            }
        </div>
    </div>
}

@if (productReviewEnable)
{
    @Html.EditorFor(model => model.ProductComment, "ProductComment", new { ProductId = product.Id })
}

@helper createReviewItem(ProductComment productComment)
{
    var rating = productComment.Rating > 5 ? 5 : (productComment.Rating < 0 ? 0 : productComment.Rating);
    <article class="crizal-product-review">
        <header>
            <div>
                <strong>@productComment.Name</strong>
                <time datetime="@productComment.CreatedDate.ToString("yyyy-MM-dd")">@productComment.CreatedDate.ToString("dd MMM yyyy")</time>
            </div>
            <span class="crizal-stars crizal-stars--sm" aria-label="@rating stars" role="img">
                @for (int i = 1; i <= 5; i++)
                {
                    <span class="crizal-stars__star@(i <= rating ? " is-on" : "")" aria-hidden="true">★</span>
                }
            </span>
        </header>
        <p>@productComment.Review</p>
    </article>
}

