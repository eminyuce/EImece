@model EImece.Domain.Models.FrontModels.StoryDetailViewModel
@using EImece.Domain.Entities;
@using EImece.Domain.Models.DTOs.Storefront;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@{
    var storyDetail = Model.StorefrontStory;
    ViewBag.Title = GeneralHelper.GetDescriptionWithBody(storyDetail.Name, 70);
    ViewBag.Description = storyDetail.GetSeoDescription(160);
    ViewBag.Keywords = storyDetail.MetaKeywords;
    var storyFiles = (storyDetail.StoryFiles ?? new System.Collections.Generic.List<StorefrontProductFileDto>())
        .Where(f => f != null && f.IsActive)
        .OrderBy(f => f.Position)
        .ToList();
    var lightboxId = "storyGalleryLightbox";
    var lightboxCarouselId = lightboxId + "Carousel";
    var storyTags = (storyDetail.StoryTags ?? new System.Collections.Generic.List<StorefrontTagDto>())
        .Where(r => r != null)
        .ToList();
    var relatedStories = (Model.StorefrontRelatedStories ?? new System.Collections.Generic.List<StorefrontStoryCardDto>()).OrderBy(x => Guid.NewGuid()).Take(3).ToList();
    var relatedProducts = (Model.RelatedProducts ?? new System.Collections.Generic.List<StorefrontProductCardDto>()).OrderByStorefrontDefault().Take(4).ToList();
    var cloudTags = Model.Tags != null ? Model.Tags.OrderByDescending(t => t.ItemCount).ThenBy(t => t.Name).Take(16).ToList() : new System.Collections.Generic.List<Tag>();
    var tagCounts = (Model.Tags ?? new System.Collections.Generic.List<Tag>())
        .GroupBy(t => t.Id)
        .ToDictionary(g => g.Key, g => g.First().ItemCount);
    var heroImageId = storyDetail.MainImageId.HasValue ? storyDetail.MainImageId.Value : 0;
    var heroUrl = heroImageId > 0 ? storyDetail.GetCroppedImageUrl(heroImageId, 1200, 675) : null;
}

<section class="crizal-story-detail">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item">
                    <a href="@Url.Action("Index", "Stories")" class="crizal-breadcrumb__link">@Resource.Stories</a>
                </li>
                @if (!string.IsNullOrEmpty(storyDetail.StoryCategoryName))
                {
                    <li class="crizal-breadcrumb__item breadcrumb-item">
                        <a href="@storyDetail.StoryCategoryDetailPageUrl" class="crizal-breadcrumb__link">@storyDetail.StoryCategoryName</a>
                    </li>
                }
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current" title="@storyDetail.Name">@storyDetail.Name</span>
                </li>
            </ol>
        </nav>

        <div class="row g-4 g-xl-5">
            <aside class="col-lg-3 order-lg-1">
                <div class="crizal-story-sidebar">
                    @if (Model.StoryCategories.IsNotEmpty())
                    {
                        <div class="crizal-story-widget">
                            <h2 class="crizal-story-widget__title">@Resource.StoryCategory</h2>
                            <ul class="crizal-story-widget__list">
                                @foreach (var allStoryCategory in Model.StoryCategories)
                                {
                                    var isCurrent = storyDetail.StoryCategoryId > 0 && allStoryCategory.Id == storyDetail.StoryCategoryId;
                                    var storyCategoryCount = allStoryCategory.Stories != null ? allStoryCategory.Stories.Count : 0;
                                    <li>
                                        @if (isCurrent)
                                        {
                                            <span class="is-current">@allStoryCategory.Name <em>(@storyCategoryCount)</em></span>
                                        }
                                        else
                                        {
                                            <a href="@allStoryCategory.DetailPageRelativeUrl">
                                                @allStoryCategory.Name <em>(@storyCategoryCount)</em>
                                            </a>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.StorefrontFeaturedStories.IsNotEmpty())
                    {
                        <div class="crizal-story-widget">
                            <h2 class="crizal-story-widget__title">@Resource.IsFeaturedStory</h2>
                            <div class="crizal-story-featured">
                                @foreach (var featuredStory in Model.StorefrontFeaturedStories.Take(4))
                                {
                                    var imgTag = featuredStory.GetCroppedImageUrl(featuredStory.MainImageId, 72, 72);
                                    <a class="crizal-story-featured__item" href="@featuredStory.DetailPageUrl">
                                        @if (!string.IsNullOrEmpty(imgTag))
                                        {
                                            <img src="@imgTag" width="72" height="72" alt="" loading="lazy" decoding="async" />
                                        }
                                        <span>
                                            <strong>@featuredStory.Name</strong>
                                        </span>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    @if (cloudTags.Count > 0)
                    {
                        <div class="crizal-story-widget">
                            <h2 class="crizal-story-widget__title">@Resource.Tags</h2>
                            <div class="crizal-tags">
                                @foreach (var tag in cloudTags)
                                {
                                    <a class="crizal-tag" href="@tag.DetailPageRelativeUrlForStories">
                                        <span class="crizal-tag__name">@tag.Name</span>
                                        <span class="crizal-tag__count">@tag.ItemCount</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                    else if (storyTags.IsNotEmpty())
                    {
                        <div class="crizal-story-widget">
                            <h2 class="crizal-story-widget__title">@Resource.Tags</h2>
                            <div class="crizal-tags">
                                @foreach (var tag in storyTags)
                                {
                                    <a class="crizal-tag" href="@tag.StoryTagDetailPageUrl">
                                        <span class="crizal-tag__name">@tag.Name</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </aside>

            <article class="col-lg-9 order-lg-2">
                <header class="crizal-story-detail__header">
                    <h1 class="crizal-story-detail__title">@storyDetail.Name</h1>
                    <div class="crizal-story-detail__meta">
                        @if (!string.IsNullOrEmpty(storyDetail.StoryCategoryName))
                        {
                            <a href="@storyDetail.StoryCategoryDetailPageUrl">@storyDetail.StoryCategoryName</a>
                        }
                        <time datetime="@storyDetail.CreatedDate.ToString("yyyy-MM-dd")">@storyDetail.CreatedDate.ToString("dd MMM yyyy")</time>
                    </div>
                </header>

                @{
                    var galleryFiles = storyFiles;
                    if (!string.IsNullOrEmpty(heroUrl))
                    {
                        var heroLarge = storyDetail.GetCroppedImageUrl(heroImageId, 0, 0);
                        if (string.IsNullOrEmpty(heroLarge))
                        {
                            heroLarge = heroUrl;
                        }
                        <figure class="crizal-story-detail__hero">
                            <a href="@heroLarge" class="pt-hero__zoom" data-pt-lightbox-single>
                                <img src="@heroUrl"
                                     alt="@storyDetail.Name"
                                     width="1200"
                                     height="675"
                                     loading="eager"
                                     fetchpriority="high"
                                     decoding="async" />
                            </a>
                        </figure>
                    }
                    else if (storyFiles.IsNotEmpty())
                    {
                        var first = storyFiles[0];
                        var firstUrl = first.GetCroppedImageUrl(first.FileStorageId, 1200, 675);
                        var firstLarge = first.GetCroppedImageUrl(first.FileStorageId, 0, 0);
                        if (string.IsNullOrEmpty(firstLarge))
                        {
                            firstLarge = firstUrl;
                        }
                        <figure class="crizal-story-detail__hero">
                            <a href="@firstLarge" class="pt-hero__zoom" data-pt-lightbox-single>
                                <img src="@firstUrl" alt="@first.Title" width="1200" height="675" loading="eager" fetchpriority="high" decoding="async" />
                            </a>
                        </figure>
                        galleryFiles = storyFiles.Skip(1).ToList();
                    }
                }

                <div class="crizal-story-detail__content post-content">
                    @Html.Raw(storyDetail.Description)
                </div>

                @if (galleryFiles.IsNotEmpty())
                {
                    <div class="row pt-gallery crizal-story-detail__gallery" data-pt-lightbox="@lightboxId">
                        @for (int i = 0; i < galleryFiles.Count; i++)
                        {
                            var file = galleryFiles[i];
                            var thumbSrc = file.GetCroppedImageUrl(file.FileStorageId, 300, 300);
                            var largeSrc = file.GetCroppedImageUrl(file.FileStorageId, 0, 0);
                            if (string.IsNullOrEmpty(largeSrc))
                            {
                                largeSrc = file.GetCroppedImageUrl(file.FileStorageId, 800, 600);
                            }
                            var alt = !string.IsNullOrEmpty(file.Title) ? file.Title : storyDetail.Name;
                            <div class="col-6 col-md-3">
                                <a href="@largeSrc" class="pt-gallery__item" data-pt-slide="@i">
                                    <img src="@thumbSrc" class="img-thumbnail rounded" alt="@alt" loading="lazy" decoding="async" />
                                </a>
                            </div>
                        }
                    </div>
                    <div class="modal fade pt-lightbox" id="@lightboxId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-xl">
                            <div class="modal-content">
                                <button type="button" class="pt-lightbox__close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close">&times;</button>
                                <div class="modal-body p-0">
                                    <div id="@lightboxCarouselId" class="carousel slide" data-bs-interval="false" data-interval="false">
                                        <div class="carousel-inner">
                                            @for (int i = 0; i < galleryFiles.Count; i++)
                                            {
                                                var file = galleryFiles[i];
                                                var largeSrc = file.GetCroppedImageUrl(file.FileStorageId, 0, 0);
                                                if (string.IsNullOrEmpty(largeSrc))
                                                {
                                                    largeSrc = file.GetCroppedImageUrl(file.FileStorageId, 800, 600);
                                                }
                                                var alt = !string.IsNullOrEmpty(file.Title) ? file.Title : storyDetail.Name;
                                                <div class="carousel-item@(i == 0 ? " active" : "")">
                                                    <img src="@largeSrc" class="pt-lightbox__img" alt="@alt" />
                                                </div>
                                            }
                                        </div>
                                        @if (galleryFiles.Count > 1)
                                        {
                                            <button class="carousel-control-prev" type="button" data-bs-target="#@lightboxCarouselId" data-bs-slide="prev" data-target="#@lightboxCarouselId" data-slide="prev">
                                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                                <span class="pt-lightbox__nav-label">Önceki</span>
                                                <span class="visually-hidden sr-only">Önceki</span>
                                            </button>
                                            <button class="carousel-control-next" type="button" data-bs-target="#@lightboxCarouselId" data-bs-slide="next" data-target="#@lightboxCarouselId" data-slide="next">
                                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                                <span class="pt-lightbox__nav-label">Sonraki</span>
                                                <span class="visually-hidden sr-only">Sonraki</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @* Use a div — vendor `footer { background:#14212B }` styles the site chrome footer only. *@
                <div class="crizal-story-detail__footer">
                    @if (storyTags.IsNotEmpty())
                    {
                        <div class="crizal-tags">
                            @foreach (var t in storyTags)
                            {
                                <a class="crizal-tag" href="@t.StoryTagDetailPageUrl">
                                    <span class="crizal-tag__name">@t.Name</span>
                                </a>
                            }
                        </div>
                    }

                    @if (Model.SocialMediaLinks.IsNotEmpty())
                    {
                        @Html.Partial("_SocialMediaShareLinks", EImece.Domain.Models.FrontModels.ShareLinksViewModel.Create(Model.SocialMediaLinks, Resource.SharePost))
                    }
                </div>

                <nav class="crizal-story-nav@(Model.StorefrontPreviousStory == null && Model.StorefrontNextStory != null ? " crizal-story-nav--end" : (Model.StorefrontPreviousStory != null && Model.StorefrontNextStory == null ? " crizal-story-nav--start" : ""))" aria-label="@Resource.PostNavigation">
                    <div class="crizal-story-nav__row">
                        @if (Model.StorefrontPreviousStory != null)
                        {
                            <a class="crizal-story-nav__link crizal-story-nav__link--prev" href="@Model.StorefrontPreviousStory.DetailPageUrl">
                                <span class="crizal-story-nav__icon" aria-hidden="true"><i class="fas fa-arrow-left"></i></span>
                                <span class="crizal-story-nav__copy">
                                    <span class="crizal-story-nav__dir">@Resource.PrevPost</span>
                                    <strong class="crizal-story-nav__title">@Model.StorefrontPreviousStory.Name</strong>
                                </span>
                            </a>
                        }
                        else
                        {
                            <span class="crizal-story-nav__spacer" aria-hidden="true"></span>
                        }
                        @if (Model.StorefrontNextStory != null)
                        {
                            <a class="crizal-story-nav__link crizal-story-nav__link--next" href="@Model.StorefrontNextStory.DetailPageUrl">
                                <span class="crizal-story-nav__copy">
                                    <span class="crizal-story-nav__dir">@Resource.NextPost</span>
                                    <strong class="crizal-story-nav__title">@Model.StorefrontNextStory.Name</strong>
                                </span>
                                <span class="crizal-story-nav__icon" aria-hidden="true"><i class="fas fa-arrow-right"></i></span>
                            </a>
                        }
                        else
                        {
                            <span class="crizal-story-nav__spacer" aria-hidden="true"></span>
                        }
                    </div>
                    <a class="crizal-story-nav__all" href="@Url.Action("Index", "Stories")">
                        <i class="fas fa-th-large" aria-hidden="true"></i>
                        <span>@Resource.AllPosts</span>
                    </a>
                </nav>

                @if (relatedStories.IsNotEmpty())
                {
                    <section class="crizal-story-related">
                        <h2 class="crizal-story-related__title">@Resource.YouMayAlsoLike</h2>
                        <div class="row g-3">
                            @foreach (var relatedStory in relatedStories)
                            {
                                var imgTag = relatedStory.GetCroppedImageUrl(relatedStory.MainImageId, 400, 260);
                                <div class="col-md-4">
                                    <a class="crizal-story-related__card" href="@relatedStory.DetailPageUrl">
                                        @if (!string.IsNullOrEmpty(imgTag))
                                        {
                                            <img src="@imgTag" alt="@relatedStory.Name" loading="lazy" decoding="async" />
                                        }
                                        <span>
                                            <strong>@relatedStory.Name</strong>
                                        </span>
                                    </a>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (relatedProducts.Any())
                {
                    <section class="crizal-story-related">
                        <h2 class="crizal-story-related__title">@Resource.RelatedProductsForBlog</h2>
                        <div class="row g-3">
                            @foreach (var product in relatedProducts)
                            {
                                var imgTag = product.GetCroppedImageUrl(product.MainImageId, 400, 400);
                                <div class="col-6 col-md-3">
                                    <a class="crizal-story-related__card crizal-story-related__card--product" href="@product.DetailPageRelativeUrl">
                                        <img src="@imgTag" alt="@product.Name" loading="lazy" decoding="async" />
                                        <span><strong>@product.Name</strong></span>
                                    </a>
                                </div>
                            }
                        </div>
                    </section>
                }
            </article>
        </div>
    </div>
</section>
