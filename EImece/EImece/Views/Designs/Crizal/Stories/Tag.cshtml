@model EImece.Domain.Models.FrontModels.SimiliarStoryTagsViewModel
@using EImece.Domain.GenericRepository;
@using EImece.Domain.Models.DTOs.Storefront;
@using EImece.Web.Helpers.HtmlHelpers;
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Helpers
@using EImece.Domain
@using Resources

@{
    PaginatedList<StorefrontStoryCardDto> storyTags = Model.StoryTags;
    var tag = Model.Tag;
    ViewBag.Title = tag != null ? tag.GetSeoTitle() : "";
    var companyName = Model.CompanyName != null ? Model.CompanyName.SettingValue : "";
    ViewBag.Description = (companyName + " - " + String.Join(",", storyTags.Select(r => r.Name))).ToStr(150);
}

<section class="crizal-story-page">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item">
                    <a href="@Url.Action("Index", "Stories")" class="crizal-breadcrumb__link">@Resource.Stories</a>
                </li>
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@tag.Name</span>
                </li>
            </ol>
        </nav>

        <header class="crizal-story-page__header">
            <h1 class="crizal-story-page__title">@tag.Name</h1>
            <p class="crizal-story-page__lead">
                @Html.Raw(String.Format(Resource.TagResultTotalCountText, HttpUtility.HtmlEncode(tag.Name), storyTags.TotalCount))
            </p>
        </header>

        <div class="row g-4">
            @foreach (var item in storyTags)
            {
                if (item == null) { continue; }
                <div class="col-sm-6 col-lg-4">
                    @Html.DisplayFor(modelItem => item, "TagStory", new { Width = 400, Height = 260 })
                </div>
            }
        </div>

        @if (storyTags != null && storyTags.TotalPageCount > 1)
        {
            <div class="d-flex justify-content-center pt-4">
                @Html.BootstrapPager(
                    storyTags.PageIndex,
                    index => Url.Action("Tag", "Stories", new { page = index, id = tag.GetSeoUrl() }),
                    storyTags.TotalCount,
                    storyTags.PageSize,
                    numberOfLinks: 5)
            </div>
        }
    </div>
</section>
