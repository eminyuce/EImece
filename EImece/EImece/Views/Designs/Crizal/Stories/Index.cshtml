@model StoryIndexViewModel
@using EImece.Web.Helpers.HtmlHelpers
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Models.FrontModels
@using EImece.Domain.Models.DTOs.Storefront
@using Resources

@{
    ViewBag.Title = Resource.StoryCategories;
    var stories = Model.StorefrontStories;
    var storyCategories = Model.StoryCategories;
}

<div class="container mt-4 mb-5">
    <nav class="crizal-breadcrumb" aria-label="breadcrumb">
        <ol class="crizal-breadcrumb__list breadcrumb">
            @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
            <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                <span class="crizal-breadcrumb__current">@Resource.Stories</span>
            </li>
        </ol>
    </nav>
    @if (storyCategories != null && storyCategories.Count > 0)
    {
        <h2 class="h3 mb-3">@Resource.StoryCategories</h2>
        <div class="row">
            @foreach (var item in storyCategories)
            {
                var imgUrl = item.GetCroppedImageUrl(item.MainImageId, 64, 64);
                <div class="col-6 col-md-4 col-lg-3 mb-3">
                    <a href="@item.DetailPageRelativeUrl" class="card story-category-card h-100 text-decoration-none border shadow-sm">
                        <div class="card-body d-flex align-items-center p-3">
                            @if (!string.IsNullOrEmpty(imgUrl))
                            {
                                <img src="@imgUrl"
                                     class="story-category-thumb rounded mr-3"
                                     width="48"
                                     height="48"
                                     alt=""
                                     loading="lazy"
                                     decoding="async" />
                            }
                            <span class="h6 mb-0 text-dark">@item.Name</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

    <div class="row mt-2">
        @if (stories != null)
        {
            foreach (var item in stories)
            {
                <div class="col-sm-6 col-lg-4 mb-4 d-flex">
                    @Html.DisplayFor(modelItem => item, "StoryShort", new { Width = 400, Height = 240 })
                </div>
            }
        }
    </div>

    @if (stories != null && stories.TotalPageCount > 1)
    {
        <div class="d-flex justify-content-center pt-2 pb-4">
            @Html.BootstrapPager(
                stories.PageIndex,
                index => Url.Action("Index", "Stories", new { page = index }),
                stories.TotalCount,
                stories.PageSize,
                numberOfLinks: 5)
        </div>
    }
</div>
