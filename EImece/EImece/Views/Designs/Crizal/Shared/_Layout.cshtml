@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain;
@using Resources;
@using System.Threading;
@using EImece.Domain.Models.Enums;
@using EImece.Infrastructure.Designs;

@{
    var countryCode = Thread.CurrentThread.CurrentUICulture.ToString();
    var productPriceEnabled = ViewBag.IsProductPriceEnable == null || (bool)ViewBag.IsProductPriceEnable;
    var companyName = Html.Action("GetCompanyName", "Home");
    var htmlLang = Html.Action("GetHtmlLangCode", "Home");
}

<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    @Html.ActiveDesignDebugInfo()
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <meta property="og:locale" content='tr_TR' />
    <meta property="og:type" content='Website' />
    <meta property="og:site_name" content='@companyName' />
    <meta property="og:image" content="@string.Format("https://{0}/images/logo.jpg",AppConfig.Domain)" />
    <meta property="og:image:width" content="100" />
    <meta property="og:image:height" content="100" />
    <meta property="og:title" content="@ViewBag.Title" />
    <meta property="og:url" content="@string.Format("https://{0}",AppConfig.Domain)" />

    @if (!string.IsNullOrEmpty(ViewBag.Description))
    {
        <meta name="description" content="@((string)ViewBag.Description)">
        <meta name="og:description" content="@((string)ViewBag.Description)">
    }

    @if (!string.IsNullOrEmpty(ViewBag.Keywords))
    {
        <meta name="keywords" content="@((string)ViewBag.Keywords)">
    }
    @{
        String seoId = (String)ViewBag.SeoId;
    }
    @Html.Raw(SeoUrlHelper.GetCanonicalTag(this.ViewContext, seoId))
    @Html.Raw(SeoUrlHelper.GetCanonicalTag(this.ViewContext, seoId, "amp"))

    @if (AppConfig.IsSiteUnderConstruction || AppConfig.IsSiteUnderDevelopment)
    {
        <meta name="robots" content="noindex">
        <meta name="googlebot" content="noindex">
    }
    else
    {
        <meta name="Robots" content="index,follow" />
    }

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/manifest.json">
    <link rel="mask-icon" color="#14212B" href="~/Content/safari-pinned-tab.svg">
    <meta name="msapplication-TileColor" content="#14212B">
    <meta name="theme-color" content="#09b850">

    <link rel="preload" as="image" href="/images/logo.jpg" fetchpriority="high" />

    @Styles.Render("~/Content/eimeceTheme")
    <link rel="stylesheet" href="@Url.Content("~/Content/designs/crizal/css/theme.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/designs/crizal/css/components.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/designs/crizal/css/responsive.css")" />

    @RenderSection("HeadExtra", required: false)
</head>
<body lang="@htmlLang" data-design="crizal">
    <input name="currentLang" type="hidden" value="@countryCode.ToString()" />

    <a class="sr-only sr-only-focusable" href="#main-content">Skip to main content</a>

    <div class="crizal-main-wrapper">
        <header class="crizal-header header-style3">
            <div class="crizal-top-bar">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            @Html.Action("WebSiteAddressInfo", "Home", new { isMobilePage = false })
                            <div class="dropdown d-inline-block d-lg-none">
                                <a class="dropdown-toggle text-white font-size-sm py-1" href="#" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">@Resource.UsefulLinks</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" href="@Url.Action(Constants.AboutUs,"info", new { lang= countryCode })">@Resource.AboutUs</a>
                                    <a class="dropdown-item" href="@Url.Action(Constants.DeliveryInfo,"info", new { lang= countryCode })">@Resource.DeliveryInfo</a>
                                    @if (productPriceEnabled)
                                    {
                                        <a class="dropdown-item" href="@Url.Action("CargoTracking","Payment")">@Resource.TrackYourCargo</a>
                                    }
                                    <div class="dropdown-divider"></div>
                                    @Html.Action("WebSiteAddressInfo", "Home", new { isMobilePage = true })
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 d-none d-md-block">
                            <div class="d-flex justify-content-end align-items-center">
                                <ul class="list-inline mb-0 mr-3">
                                    <li class="list-inline-item">@Html.Action("Languages", "Home")</li>
                                    <li class="list-inline-item">
                                        <a class="text-white font-size-sm" href="@Url.Action(Constants.AboutUs,"info", new { lang= countryCode })">@Resource.AboutUs</a>
                                    </li>
                                    @if (productPriceEnabled)
                                    {
                                        <li class="list-inline-item">
                                            <a class="text-white font-size-sm" href="@Url.Action("CargoTracking","Payment")">@Resource.TrackYourCargo</a>
                                        </li>
                                    }
                                </ul>
                                @Html.Action("SocialMediaLinks", "Home")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="crizal-navbar navbar navbar-expand-lg navbar-dark">
                <div class="container flex-wrap">
                    <a class="navbar-brand" href="@Url.Action("Index","Home")">
                        <img src="/images/logo.jpg" width="200" height="60" alt="@companyName" decoding="async" fetchpriority="high" />
                    </a>

                    <div class="crizal-attr-nav order-lg-3">
                        @if (productPriceEnabled)
                        {
                            if (Request.IsAuthenticated)
                            {
                                <a class="crizal-icon-btn" href="@Url.Action("index","home",new { @area="customers" })">
                                    <i data-feather="user" aria-hidden="true"></i>
                                    <span>@Resource.MyAccount</span>
                                </a>
                            }
                            else
                            {
                                <a class="crizal-icon-btn" href="@Url.Action("login","account")">
                                    <i data-feather="log-in" aria-hidden="true"></i>
                                    <span>@Resource.SignInOrUp</span>
                                </a>
                            }
                            @Html.Raw(Html.Action("ShoppingCartLink", "Payment"))
                        }
                        <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#crizalMenu" aria-controls="crizalMenu" aria-expanded="false" aria-label="Menu">
                            <i data-feather="menu" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="crizal-search-wrap order-lg-2 d-none d-sm-block">
                        @Html.Partial("_SearchProductForm")
                    </div>

                    @Html.Raw(Html.Action("Navigation", "Home", new { lang = countryCode }))
                </div>
            </div>
        </header>

        <main id="main-content" role="main">
            @RenderBody()
        </main>

        <div class="crizal-contact-strip">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h3>@companyName</h3>
                        <p class="mb-0 text-white-50">@Resource.StayInformed</p>
                    </div>
                    <div class="col-lg-4 text-lg-right">
                        <a class="butn-style8 secondary" href="@Url.Action(Constants.AboutUs,"info", new { lang= countryCode })">@Resource.AboutUs</a>
                    </div>
                </div>
            </div>
        </div>

        @Html.Action("Footer", "Home", new { lang = countryCode })
    </div>

    @Html.Raw(Html.Action("GoogleAnalyticsTrackingScript", "Home"))
    @Html.Raw(Html.Action("WhatsAppCommunicationScript", "Home"))
    <a class="scroll-to-top-btn crizal-scroll-top" href="#main-content" aria-label="Scroll to top">
        <i class="scroll-to-top-btn-icon" data-feather="chevron-up" aria-hidden="true"></i>
    </a>

    @Scripts.Render("~/bundles/mstore")
    @Scripts.Render("~/bundles/eimeceScripts")
    <script src="@Url.Content("~/Content/designs/crizal/js/theme.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
