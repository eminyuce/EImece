@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain;
@using Resources;
@using System.Threading;
@using EImece.Infrastructure.Designs;

@{
    var countryCode = Thread.CurrentThread.CurrentUICulture.ToString();
    var companyName = Html.Action("GetCompanyName", "Home");
    var htmlLang = Html.Action("GetHtmlLangCode", "Home");
}

<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    @Html.ActiveDesignDebugInfo()
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <meta property="og:locale" content='tr_TR' />
    <meta property="og:type" content='Website' />
    <meta property="og:site_name" content='@companyName' />
    <meta property="og:image" content="@string.Format("https://{0}/images/logo.jpg", AppConfig.Domain)" />
    <meta property="og:image:width" content="100" />
    <meta property="og:image:height" content="100" />
    <meta property="og:title" content="@ViewBag.Title" />
    <meta property="og:url" content="@string.Format("https://{0}", AppConfig.Domain)" />

    @{
        var pageMetaDesc = (string)ViewBag.Description;
        if (string.IsNullOrWhiteSpace(pageMetaDesc))
        {
            pageMetaDesc = (string)ViewBag.Title;
        }
        if (string.IsNullOrWhiteSpace(pageMetaDesc))
        {
            pageMetaDesc = companyName?.ToString() ?? AppConfig.Domain;
        }
    }
    <meta name="description" content="@pageMetaDesc">
    <meta property="og:description" content="@pageMetaDesc">

    @if (!string.IsNullOrEmpty(ViewBag.Keywords))
    {
        <meta name="keywords" content="@((string)ViewBag.Keywords)">
    }
    @{
        String seoId = (String)ViewBag.SeoId;
    }
    @Html.Raw(SeoUrlHelper.GetCanonicalTag(this.ViewContext, seoId))
    @Html.Raw(SeoUrlHelper.GetCanonicalTag(this.ViewContext, seoId, "amp"))

    @if (!SeoSettings.AllowIndexing || AppConfig.IsSiteUnderDevelopment)
    {
        <meta name="robots" content="noindex, nofollow, noarchive" />
        <meta name="googlebot" content="noindex, nofollow, noarchive" />
    }
    else
    {
        <meta name="Robots" content="index,follow" />
    }

    @Html.Action("JsonLdOrganization", "Home")

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/manifest.json">
    <link rel="mask-icon" color="#14212B" href="~/Content/safari-pinned-tab.svg">
    <meta name="msapplication-TileColor" content="#14212B">
    <meta name="theme-color" content="#067a36">

    <link rel="preload" as="image" href="/images/logo.jpg" fetchpriority="high" />

    @* Plugin CSS bundled under the plugins folder so relative font url() paths resolve *@
    @Styles.Render("~/Content/designs/crizal/vendor/css/plugins/crizal-plugins")
    @Styles.Render("~/bundles/designs/crizal/vendor/css")

    @RenderSection("HeadExtra", required: false)
</head>
<body lang="@htmlLang" data-design="crizal">
    <input name="currentLang" type="hidden" value="@countryCode.ToString()" />

    <a class="visually-hidden visually-hidden-focusable" href="#main-content">@Resource.SkipToMainContent</a>

    <div id="preloader"></div>

    <div class="main-wrapper">
        @Html.Partial("_Header")

        <main id="main-content" role="main">
            @RenderBody()
        </main>

        @if (ViewBag.HideMarketingCta != true)
        {
        <section class="crizal-cta-band contact-style01" aria-label="@companyName">
            <div class="container">
                <div class="crizal-cta-band__panel">
                    <div class="crizal-cta-band__copy">
                        <h2 class="crizal-cta-band__title">@companyName</h2>
                        <p class="crizal-cta-band__text">@Resource.StayInformed</p>
                    </div>
                    <div class="crizal-cta-band__actions">
                        <a href="@Url.Action(Constants.AboutUs, "info", new { lang = countryCode })" class="butn-style8 crizal-cta-band__btn"><span>@Resource.AboutUs</span></a>
                    </div>
                </div>
            </div>
        </section>
        }

        @Html.Action("Footer", "Home", new { lang = countryCode })
    </div>

    @Html.Raw(Html.Action("GoogleAnalyticsTrackingScript", "Home"))
    @Html.Raw(Html.Action("WhatsAppCommunicationScript", "Home"))

    <div class="scroll-top-percentage"><span id="scroll-value"></span></div>

    @Html.Partial("_Scripts")
    @RenderSection("scripts", required: false)
</body>
</html>
