@model EImece.Domain.Models.FrontModels.MenuPageViewModel
@using EImece.Domain.Helpers.Extensions
@using System.Linq
@using System.Web.Mvc
@{
    var menu = Model.Menu;
    ViewBag.Title = menu.GetSeoTitle();
    ViewBag.Description = menu.GetSeoDescription();
    ViewBag.Keywords = menu.GetSeoKeywords();
    var files = menu.MenuFiles ?? Enumerable.Empty<EImece.Domain.Models.DTOs.Storefront.StorefrontMenuFileDto>();
    var imgMenuUrl = menu.ImageState ? (menu.GetCroppedImageUrl(menu.MainImageId, 0, 0) ?? "") : "";
    var heroVd = new ViewDataDictionary { { "Alt", menu.Name }, { "Class", "pt-portrait" }, { "PlaceholderClass", "pt-ph pt-ph--portrait" } };
    var galleryVd = new ViewDataDictionary { { "ColClass", "col-6 col-md-3" }, { "MinCount", 4 } };
}
<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@menu.Name</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@menu.Name</h1>
        <hr class="mt-4">
    </div>
</section>
<div class="container pt-page pt-t3">
    <div class="row">
        <div class="col-md-8">
            <div class="pt-body-text">
                @Html.Raw(menu.Description)
            </div>
            @Html.Partial("~/Views/Shared/PageThemes/_PageThemeGallery.cshtml", files, galleryVd)
        </div>
        <div class="col-md-4 mb-3">
            @Html.Partial("~/Views/Shared/PageThemes/_PageThemeHero.cshtml", (object)imgMenuUrl, heroVd)
        </div>
    </div>
</div>
