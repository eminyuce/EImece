@model EImece.Domain.Models.FrontModels.MenuPageViewModel
@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Entities
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain;
@using Resources;
@using EImece.Domain.Helpers;
@{

    var menu = Model.Menu;
    var files = Model.Menu.MenuFiles.ToList().OrderBy(r => r.FileStorage != null ? r.FileStorage.Position : 0).ToList();

    ViewBag.Title = menu.GetSeoTitle();
    ViewBag.Description = menu.GetSeoDescription();
    ViewBag.Keywords = menu.GetSeoKeywords();
    var isUserAuthenticated = User.Identity.IsAuthenticated && AppConfig.IsEditLinkEnable;
    var menuTags = menu.MenuFiles.SelectMany(r => r.FileStorage.FileStorageTags.Select(t => t.Tag)).Distinct();

    int Width = ViewData["Width"].ToInt(300);
    int Height = ViewData["Height"].ToInt(214);
    var imgMenuUrl = menu.ImageState ? menu.GetCroppedImageUrl(menu.MainImageId, 0, 500) : "";
}

<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@menu.Name</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@menu.Name</h1><span class="d-block mt-2 text-muted"></span>
        <hr class="mt-4">
    </div>
</section>

<div class="container">
    @if (!string.IsNullOrEmpty(imgMenuUrl))
    {
        <!-- Row-->
    <div class="row">
        <div class="col-md-12">
            <div class="text-center">
                <img src="@imgMenuUrl" class="img-thumbnail rounded" alt="Rounded">
            </div>
        </div>
    </div>
    }

    <!-- Row-->
    <div class="row">
        <div class="col-md-12">
            @Html.Raw(menu.Description)
        </div>
    </div>
    <!-- Row-->
    <div class="row">
        @if (files.IsNotEmpty())
        {
            <!-- Row-->
            for (int i = 0; i < files.Count; i++)
            {
                var f = files[i].FileStorage;
        <div class="col-md-4">
            @Html.DisplayFor(modelItem => f, "FileStorageThumbnails", new { Width = 300, Height = 300 })
        </div>
            }
        }
    </div>
</div>