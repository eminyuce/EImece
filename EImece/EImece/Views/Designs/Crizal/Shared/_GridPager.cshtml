@model GridMvc.Pagination.GridPager
@if (Model == null || Model.PageCount <= 1)
{
    return;
}
<nav class="site-pagination" aria-label="Pagination Navigation">
    <ul class="pagination justify-content-center flex-wrap mb-0">
        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Model.GetLinkForPage(Model.CurrentPage - 1)" aria-label="Previous">
                    <span aria-hidden="true">&lsaquo;</span>
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link" aria-hidden="true">&lsaquo;</span>
            </li>
        }

        @if (Model.StartDisplayedPage > 1)
        {
            <li class="page-item">
                <a class="page-link" href="@Model.GetLinkForPage(1)">1</a>
            </li>
            if (Model.StartDisplayedPage > 2)
            {
                <li class="page-item disabled d-none d-sm-block">
                    <span class="page-link">…</span>
                </li>
            }
        }
        @for (int i = Model.StartDisplayedPage; i <= Model.EndDisplayedPage; i++)
        {
            if (i == Model.CurrentPage)
            {
                <li class="page-item active" aria-current="page">
                    <span class="page-link">@i <span class="sr-only">(current)</span></span>
                </li>
            }
            else
            {
                <li class="page-item">
                    <a class="page-link" href="@Model.GetLinkForPage(i)">@i</a>
                </li>
            }
        }
        @if (Model.EndDisplayedPage < Model.PageCount)
        {
            if (Model.EndDisplayedPage < Model.PageCount - 1)
            {
                <li class="page-item disabled d-none d-sm-block">
                    <span class="page-link">…</span>
                </li>
            }
            <li class="page-item">
                <a class="page-link" href="@Model.GetLinkForPage(Model.PageCount)">@Model.PageCount</a>
            </li>
        }
        @if (Model.CurrentPage < Model.PageCount)
        {
            <li class="page-item">
                <a class="page-link" href="@Model.GetLinkForPage(Model.CurrentPage + 1)" aria-label="Next">
                    <span aria-hidden="true">&rsaquo;</span>
                </a>
            </li>
        }
        else
        {
            <li class="page-item disabled">
                <span class="page-link" aria-hidden="true">&rsaquo;</span>
            </li>
        }
    </ul>
</nav>
