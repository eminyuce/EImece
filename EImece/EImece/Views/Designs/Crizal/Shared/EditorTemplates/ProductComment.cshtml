@model ProductComment
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers.HtmlHelpers;
@using Resources;

@{
    var reviewError = TempData["ReviewFormError"] as string ?? TempData["RecaptchaError"] as string;
    var requiredMsg = Resource.MandatoryField;
    var nameMsg = Resource.PleaseEnterYourName;
    var emailRequiredMsg = Resource.PleaseEnterYourEmail;
    var emailFormatMsg = Resource.NotValidEmailAddress;
    var captchaMsg = Resource.AnswerSecurityQuestion;
    var ratingValue = Model != null && Model.Rating >= 1 && Model.Rating <= 5 ? Model.Rating : 0;
}

<div class="modal fade crizal-review-modal"
     id="leaveReview"
     tabindex="-1"
     role="dialog"
     aria-labelledby="leaveReviewTitle"
     aria-hidden="true"
     aria-modal="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            @using (Html.BeginForm("Review", "Products", FormMethod.Post, new
            {
                @class = "crizal-review-modal__form needs-validation",
                role = "form",
                novalidate = "novalidate",
                data_msg_required = requiredMsg,
                data_msg_name = nameMsg,
                data_msg_email = emailRequiredMsg,
                data_msg_email_format = emailFormatMsg,
                data_msg_subject = requiredMsg,
                data_msg_review = requiredMsg,
                data_msg_rating = requiredMsg,
                data_msg_captcha = captchaMsg,
                data_msg_recaptcha = Resource.ContactUsCaptchaErrorMessage,
                data_open_on_error = string.IsNullOrEmpty(reviewError) ? "false" : "true"
            }))
            {
                <div class="modal-header">
                    <div class="crizal-review-modal__heading">
                        <span class="crizal-review-modal__icon" aria-hidden="true"><i class="fas fa-comment-dots"></i></span>
                        <h4 class="modal-title" id="leaveReviewTitle">@Resource.LeaveReview</h4>
                    </div>
                    <button class="crizal-review-modal__close" type="button" data-bs-dismiss="modal" data-dismiss="modal" aria-label="@Resource.Close">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="crizal-review-modal__alert alert alert-danger@(string.IsNullOrEmpty(reviewError) ? " d-none" : "")" role="alert" data-server-error="@(string.IsNullOrEmpty(reviewError) ? "false" : "true")">@reviewError</div>
                    @Html.ValidationSummary(true, "", new { @class = "crizal-review-modal__alert alert alert-danger" })
                    @Html.HiddenFor(model => model.ProductId)
                    @Html.HiddenFor(model => model.SeoUrl)

                    <div class="row">
                        <div class="col-sm-6">
                            <div class="crizal-review-field">
                                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "crizal-review-field__label" })
                                <span class="crizal-review-field__req" aria-hidden="true">*</span>
                                @Html.TextBoxFor(model => model.Name, new
                                {
                                    @class = "form-control",
                                    autocomplete = "name",
                                    maxlength = "500",
                                    placeholder = Resource.Name,
                                    required = "required",
                                    aria_required = "true",
                                    data_review_field = "name",
                                    data_val = "true",
                                    data_val_required = nameMsg,
                                    data_val_length = Resource.NamePropertyErrorMessage,
                                    data_val_length_max = "500"
                                })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "crizal-review-modal__error" })
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="crizal-review-field">
                                @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "crizal-review-field__label" })
                                <span class="crizal-review-field__req" aria-hidden="true">*</span>
                                @Html.TextBoxFor(model => model.Email, new
                                {
                                    @class = "form-control",
                                    @type = "email",
                                    autocomplete = "email",
                                    inputmode = "email",
                                    placeholder = Resource.Email,
                                    required = "required",
                                    aria_required = "true",
                                    data_review_field = "email",
                                    data_val = "true",
                                    data_val_required = emailRequiredMsg,
                                    data_val_email = emailFormatMsg
                                })
                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "crizal-review-modal__error" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="crizal-review-field">
                                @Html.LabelFor(model => model.Subject, htmlAttributes: new { @class = "crizal-review-field__label" })
                                <span class="crizal-review-field__req" aria-hidden="true">*</span>
                                @Html.TextBoxFor(model => model.Subject, new
                                {
                                    @class = "form-control",
                                    maxlength = "500",
                                    placeholder = Resource.ReviewSubject,
                                    required = "required",
                                    aria_required = "true",
                                    data_review_field = "subject",
                                    data_val = "true",
                                    data_val_required = requiredMsg
                                })
                                @Html.ValidationMessageFor(model => model.Subject, "", new { @class = "crizal-review-modal__error" })
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="crizal-review-field">
                                @Html.LabelFor(model => model.Rating, htmlAttributes: new { @class = "crizal-review-field__label" })
                                <span class="crizal-review-field__req" aria-hidden="true">*</span>
                                <input type="hidden"
                                       id="review-rating"
                                       name="@Html.NameFor(model => model.Rating)"
                                       value="@ratingValue"
                                       data-review-field="rating"
                                       data-val="true"
                                       data-val-required="@requiredMsg"
                                       data-val-range="@requiredMsg"
                                       data-val-range-min="1"
                                       data-val-range-max="5" />
                                <div class="crizal-review-stars" role="radiogroup" aria-label="@Resource.Rating" aria-required="true">
                                    @for (var star = 1; star <= 5; star++)
                                    {
                                        var isOn = star <= ratingValue;
                                        <button type="button"
                                                class="crizal-review-stars__btn@(isOn ? " is-on" : "")"
                                                data-rating="@star"
                                                aria-label="@star @Resource.Star"
                                                aria-pressed="@(isOn ? "true" : "false")">★</button>
                                    }
                                </div>
                                @Html.ValidationMessageFor(model => model.Rating, "", new { @class = "crizal-review-modal__error" })
                            </div>
                        </div>
                    </div>
                    <div class="crizal-review-field">
                        @Html.LabelFor(model => model.Review, htmlAttributes: new { @class = "crizal-review-field__label" })
                        <span class="crizal-review-field__req" aria-hidden="true">*</span>
                        @Html.TextAreaFor(model => model.Review, 3, 0, new)
                        {
                            @class = "form-control",
                            placeholder = Resource.Review,
                            required = "required",
                            aria_required = "true",
                            data_review_field = "review",
                            data_val = "true",
                            data_val_required = requiredMsg
                        })
                        @Html.ValidationMessageFor(model => model.Review, "", new { @class = "crizal-review-modal__error" })
                    </div>
                    <div class="crizal-review-captcha" data-review-field="captcha">
                        @Html.CaptchaWidget("ProductReview", "crizal-review-modal__error")
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="crizal-review-modal__cancel" type="button" data-bs-dismiss="modal" data-dismiss="modal">@Resource.Close</button>
                    <button class="butn-style8 crizal-review-modal__submit" type="submit">
                        <i class="fas fa-paper-plane" aria-hidden="true"></i>
                        <span>@Resource.SubmitReview</span>
                    </button>
                </div>
            }
        </div>
    </div>
</div>
