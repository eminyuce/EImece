@model object
@using EImece.Domain.Models.DTOs.Storefront;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@{
    var dto = Model as StorefrontProductCardDto;
    var product = Model as Product;
    var name = dto != null ? dto.Name : (product != null ? product.Name : string.Empty);
    var categoryName = dto != null ? dto.ProductCategoryName : (product != null && product.ProductCategory != null ? product.ProductCategory.Name : string.Empty);
    var categoryUrl = dto != null ? dto.ProductCategoryDetailPageUrl : (product != null && product.ProductCategory != null ? product.ProductCategory.DetailPageUrl : string.Empty);
    var mainImageId = dto != null ? dto.MainImageId : (product != null ? product.MainImageId : null);
    var detailUrl = dto != null ? dto.DetailPageAbsoluteUrl : (product != null ? product.DetailPageAbsoluteUrl : string.Empty);
    var price = dto != null ? dto.Price : (product != null ? product.Price : 0);
    var priceWithDiscount = dto != null ? dto.PriceWithDiscount : (product != null ? product.PriceWithDiscount : 0);
    var isOnSale = dto != null ? dto.IsOnSale : (product != null ? product.IsOnSale : false);
    var isBuyable = dto != null ? dto.IsBuyableState : (product != null ? product.IsBuyableState : false);
    var modifiedId = dto != null ? dto.ModifiedId : (product != null ? product.ModifiedId : string.Empty);

    int Width = ViewData["Width"].ToInt(0);
    int Height = ViewData["Height"].ToInt(0);
    var mainImageImgSrcUrl = dto != null ? dto.GetCroppedImageUrl(mainImageId, Width, Height) : (product != null ? product.GetCroppedImageUrl(mainImageId, Width, Height) : string.Empty);
    var srcset = mainImageId.HasValue
        ? (dto != null ? dto.GetResponsiveImageSrcSet(mainImageId.Value, Width, Height) : (product != null ? product.GetResponsiveImageSrcSet(mainImageId.Value, Width, Height) : string.Empty))
        : string.Empty;
    var productLink = detailUrl;
    var productPriceEnabled = ViewBag.IsProductPriceEnable == null || (bool)ViewBag.IsProductPriceEnable;
}

<div class="col-xl-3 col-lg-4 col-sm-6 mb-4">
    <div class="product-details product-card">
        <div class="product-img product-thumb">
            @if (isOnSale)
            {
                <div class="label-offer bg-red">@Resource.Sale</div>
            }
            <a class="product-thumb-link" href="@productLink" aria-label="@name">
                <img src="@mainImageImgSrcUrl"
                     srcset="@srcset"
                     sizes="(max-width: 575px) 45vw, (max-width: 991px) 33vw, 278px"
                     width="@(Width > 0 ? Width : 278)"
                     height="@(Height > 0 ? Height : 278)"
                     alt="@name"
                     loading="lazy"
                     decoding="async" />
            </a>
        </div>
        <div class="product-info product-card-body">
            <a class="product-meta small d-block mb-1" href="@categoryUrl">@categoryName</a>
            <h3 class="product-card-title h6 mb-2"><a href="@productLink">@name</a></h3>
            @if (productPriceEnabled && priceWithDiscount > 0)
            {
                <p class="price text-center m-0">
                    @if (price > priceWithDiscount)
                    {
                        <span class="text-muted small mr-1"><s>@price.CurrencySign()</s></span>
                    }
                    <span class="text-primary">@priceWithDiscount.CurrencySign()</span>
                </p>
            }
            @if (productPriceEnabled && isBuyable)
            {
                <button class="butn-style8 small mt-3 btn-block" data-add-product-cart="@modifiedId" type="button"
                        data-bs-toggle="toast" data-bs-target="#cart-toast">
                    <span>@Resource.AddToCart</span>
                </button>
            }
        </div>
    </div>
</div>
