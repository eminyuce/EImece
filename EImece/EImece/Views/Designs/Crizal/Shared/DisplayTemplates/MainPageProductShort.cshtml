@model EImece.Domain.Models.DTOs.Storefront.StorefrontProductCardDto
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@{
    var product = Model;
    int Width = ViewData["Width"].ToInt(80);
    int Height = ViewData["Height"].ToInt(80);
    var imageUrl = product.GetCroppedImageUrl(null, Width, Height);
    var productLink = product.DetailPageRelativeUrl;
    var productPriceEnabled = ViewBag.IsProductPriceEnable == null || (bool)ViewBag.IsProductPriceEnable;
    var rating = product.Rating > 5 ? 5 : (product.Rating < 0 ? 0 : product.Rating);
}

<a class="crizal-home-product-row" href="@productLink" aria-label="@product.Name">
    <span class="crizal-home-product-row__thumb">
        <img src="@imageUrl" width="@Width" height="@Height" alt="" loading="lazy" decoding="async" />
    </span>
    <span class="crizal-home-product-row__body">
        <span class="crizal-home-product-row__title">@product.Name</span>
        @if (rating > 0)
        {
            <span class="crizal-stars crizal-stars--sm" aria-hidden="true">
                @for (int i = 1; i <= 5; i++)
                {
                    <span class="crizal-stars__star@(i <= rating ? " is-on" : "")" aria-hidden="true">★</span>
                }
            </span>
        }
        @if (productPriceEnabled)
        {
            <span class="crizal-home-product-row__price">@product.PriceWithDiscount.CurrencySign()</span>
        }
    </span>
</a>
