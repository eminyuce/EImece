@model object
@using System.Linq
@using EImece.Domain.Models.DTOs.Storefront
@using EImece.Domain.Entities
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Helpers
@using Resources
@{
    var dto = Model as StorefrontStoryCardDto;
    var story = Model as Story;
    var name = dto != null ? dto.Name : (story != null ? story.Name : string.Empty);
    var mainImageId = dto != null ? dto.MainImageId : (story != null ? story.MainImageId : null);
    var detailUrl = dto != null ? dto.DetailPageUrl : (story != null ? story.DetailPageUrl : string.Empty);
    var createdDate = dto != null ? dto.CreatedDate : (story != null ? story.CreatedDate : DateTime.Now);
    var description = dto != null ? dto.GetSeoDescription(300) : (story != null ? story.GetSeoDescription(300) : string.Empty);

    int Width = ViewData["Width"].ToInt(480);
    int Height = ViewData["Height"].ToInt(320);
    var imageId = mainImageId.HasValue ? mainImageId.Value : 0;
    var storyImageTag = dto != null
        ? dto.GetCroppedImageTag(imageId, Width, Height, lazy: true, fetchPriority: null, sizes: "(max-width: 767px) 100vw, 360px")
        : (story != null ? story.GetCroppedImageTag(imageId, Width, Height, lazy: true, fetchPriority: null, sizes: "(max-width: 767px) 100vw, 360px") : string.Empty);
}

<article class="card story-list-card mb-4 shadow-sm border-0 overflow-hidden">
    <div class="row no-gutters align-items-stretch">
        <div class="col-md-4 position-relative">
            <a href="@detailUrl" class="story-list-thumb" aria-label="@name">
                @Html.Raw(storyImageTag)
            </a>
            <div class="story-list-date text-center bg-dark text-white rounded px-2 py-1">
                <div class="h5 mb-0">@createdDate.Day</div>
                <small class="text-uppercase">@createdDate.ToString("MMM")</small>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card-body d-flex flex-column h-100">
                <h2 class="card-title h5 mb-2">
                    <a href="@detailUrl" class="text-dark">@name</a>
                </h2>
                <p class="card-text text-muted mb-3 flex-grow-1">@description</p>
                <a href="@detailUrl" class="btn btn-outline-secondary btn-sm align-self-start">@Resource.ReadMore</a>
            </div>
        </div>
    </div>
</article>
