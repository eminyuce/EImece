@model EImece.Domain.Entities.ProductCategory
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@{
    var product = Model;
    var productLink = product.DetailPageUrl;
    int Width = ViewData["Width"].ToInt(0);
    int Height = ViewData["Height"].ToInt(0);
    var mainImageImgSrcUrl = product.GetCroppedImageUrl(product.MainImageId, Width, Height);
    var srcset = product.MainImageId.HasValue
        ? product.GetResponsiveImageSrcSet(product.MainImageId.Value, Width, Height)
        : string.Empty;
    var shortDesc = GeneralHelper.GetDescriptionWithBody(product.ShortDescription, 100);
}

<div class="col-6 col-md-4 col-xl-3 mt-4">
    <article class="crizal-card h-100">
        <div class="crizal-card-media">
            <a href="@productLink" aria-label="@product.Name">
                <img src="@mainImageImgSrcUrl"
                     srcset="@srcset"
                     sizes="(max-width: 575px) 45vw, (max-width: 991px) 33vw, 305px"
                     width="@(Width > 0 ? Width : 305)"
                     height="@(Height > 0 ? Height : 305)"
                     alt="@product.Name"
                     loading="lazy"
                     decoding="async" />
            </a>
        </div>
        <div class="crizal-card-body text-center">
            <h3 class="h5 mb-2"><a href="@productLink">@product.Name</a></h3>
            @if (!string.IsNullOrEmpty(shortDesc))
            {
                <p class="mb-0 small opacity9">@shortDesc</p>
            }
        </div>
    </article>
</div>
