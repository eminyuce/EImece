@using Resources;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain;
@using EImece.Domain.Helpers;

@{
    var searchPlaceholder = Resource.SearchProductTextBoxPlaceHolder;
    var search = Request.QueryString["search"].ToStr();
}

@using (Html.BeginForm("SearchProducts", "Products", FormMethod.Get, new { @class = "search-form", role = "search" }))
{
    <input type="submit" style="display:none;" id="searchSubmitButton" aria-hidden="true" tabindex="-1" />
    <div class="input-group">
        <span class="input-group-text cursor-pointer">
            <button class="search-form_submit fas fa-search text-white" type="button" onclick="onClickSearch(this)" aria-label="@Resource.Search"></button>
        </span>
        <input type="text"
               class="search-form_input form-control"
               id="site-search"
               name="search"
               value="@search"
               autocomplete="off"
               placeholder="@searchPlaceholder"
               aria-label="@searchPlaceholder" />
        <span class="input-group-text close-search mt-1"><i class="fas fa-times"></i></span>
    </div>
}

<input type="hidden" id="SearchRequiredErrorMessage" value="@Resource.SearchRequiredErrorMessage" />
<input type="hidden" id="SearchValidText" value="@Resource.SearchValidText" />

<script>
    function isEmpty(str) {
        return (!str || 0 === str.length);
    }
    function onClickSearch(e) {
        if (isEmpty($("#site-search").val()) || $("#site-search").val().length < 2) {
            return;
        }
        document.getElementById('searchSubmitButton').click();
    }
</script>
