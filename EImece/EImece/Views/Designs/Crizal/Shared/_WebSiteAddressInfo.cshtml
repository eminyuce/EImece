@model SettingLayoutViewModel
@using EImece.Domain.Models.FrontModels;
@{
    var webSiteCompanyPhoneAndLocation = Model.WebSiteCompanyPhoneAndLocation.SettingValue;
    var webSiteCompanyEmailAddress = Model.WebSiteCompanyEmailAddress.SettingValue;
    var isPhone = !String.IsNullOrEmpty(webSiteCompanyPhoneAndLocation);
    var isEnvelope = !String.IsNullOrEmpty(webSiteCompanyEmailAddress);
}
@if (Model.isMobilePage)
{
    <a class="dropdown-item" href="tel:@webSiteCompanyPhoneAndLocation">
        <i class="mr-1" data-feather="phone" style="width: 13px; height: 13px;"></i>@webSiteCompanyPhoneAndLocation
    </a>
    <a class="dropdown-item" href="mailto:@webSiteCompanyEmailAddress">
        <i class="mr-1" data-feather="mail" style="width: 13px; height: 13px;"></i>@webSiteCompanyEmailAddress
    </a>
}
else if (isPhone || isEnvelope)
{
    <ul class="crizal-top-bar-info d-none d-lg-flex">
        @if (isPhone)
        {
            <li>
                <i data-feather="phone" style="width: 13px; height: 13px;" aria-hidden="true"></i>
                <a href="@string.Format("tel:{0}",webSiteCompanyPhoneAndLocation)">@Html.Raw(webSiteCompanyPhoneAndLocation)</a>
            </li>
        }
        @if (isEnvelope)
        {
            <li>
                <i data-feather="mail" style="width: 13px; height: 13px;" aria-hidden="true"></i>
                <a href="mailto:@webSiteCompanyEmailAddress">@Html.Raw(webSiteCompanyEmailAddress)</a>
            </li>
        }
    </ul>
}
