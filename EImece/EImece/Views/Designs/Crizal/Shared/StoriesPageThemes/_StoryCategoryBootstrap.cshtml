@model EImece.Domain.Models.FrontModels.StoryCategoryViewModel
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain
@using Resources
@using System.Linq
@{
    var category = Model.StoryCategory;
    var stories = Model.Stories;
}

<section class="crizal-story-page">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item">
                    <a href="@Url.Action("Index", "Stories")" class="crizal-breadcrumb__link">@Resource.StoryCategories</a>
                </li>
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@category.Name</span>
                </li>
            </ol>
        </nav>

        <header class="crizal-story-page__header">
            <h1 class="crizal-story-page__title">@category.Name</h1>
            @if (!string.IsNullOrWhiteSpace(category.Description))
            {
                <div class="crizal-story-page__lead">@Html.Raw(category.Description)</div>
            }
        </header>

        <div class="row g-4">
            <div class="col-lg-8">
                @if (stories != null && stories.Count > 0)
                {
                    <div class="crizal-story-list">
                        @foreach (var story in stories)
                        {
                            @Html.DisplayFor(modelItem => story, "Story", new { Width = 480, Height = 320 })
                        }
                    </div>
                }
                else
                {
                    <div class="crizal-story-empty" role="status">@Resource.NOSearchResult</div>
                }
            </div>

            <aside class="col-lg-4">
                @if (Model.StoryCategories != null && Model.StoryCategories.Count > 0)
                {
                    <div class="crizal-story-widget">
                        <h2 class="crizal-story-widget__title">@Resource.StoryCategories</h2>
                        <ul class="crizal-story-widget__list">
                            @foreach (var cstory in Model.StoryCategories)
                            {
                                var isCurrent = cstory.Id == category.Id;
                                <li>
                                    @if (isCurrent)
                                    {
                                        <span class="is-current">@cstory.Name</span>
                                    }
                                    else
                                    {
                                        <a href="@cstory.DetailPageRelativeUrl">@cstory.Name</a>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (Model.Tags != null && Model.Tags.Count > 0)
                {
                    <div class="crizal-story-widget">
                        <h2 class="crizal-story-widget__title">@Resource.Tags</h2>
                        <div class="crizal-tags">
                            @foreach (var t in Model.Tags.OrderByDescending(x => x.ItemCount).ThenBy(x => x.Name))
                            {
                                <a class="crizal-tag" href="@Url.Action("Tag", "Stories", new { id = t.GetSeoUrl() })">
                                    <span class="crizal-tag__name">@t.Name</span>
                                    <span class="crizal-tag__count">@t.ItemCount</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </aside>
        </div>
    </div>
</section>
