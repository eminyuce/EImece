@model EImece.Domain.Models.FrontModels.StoryCategoryViewModel
@using EImece.Domain.Helpers.Extensions
@using Resources
@{
    var category = Model.StoryCategory;
    var stories = Model.StorefrontStories;
}

<section class="crizal-story-page crizal-story-page--t3">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                <li class="crizal-breadcrumb__item breadcrumb-item">
                    <a href="@Url.Action("Index", "Stories")" class="crizal-breadcrumb__link">@Resource.StoryCategories</a>
                </li>
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current">@category.Name</span>
                </li>
            </ol>
        </nav>

        <header class="crizal-story-page__header">
            <h1 class="crizal-story-page__title">@category.Name</h1>
            @if (!string.IsNullOrWhiteSpace(category.Description))
            {
                <div class="crizal-story-page__lead">@Html.Raw(category.Description)</div>
            }
        </header>

        <div class="row g-4">
            <!-- Main Content: 2-Column Grid -->
            <div class="col-lg-8">
                @if (stories != null && stories.Count > 0)
                {
                    <div class="row row-cols-1 row-cols-md-2 g-4 crizal-story-grid">
                        @foreach (var story in stories)
                        {
                            <div class="col">
                                @Html.DisplayFor(modelItem => story, "Story", new { Width = 400, Height = 260 })
                            </div>
                        }
                    </div>
                }
                else
                {
                    <output class="crizal-story-empty d-block">@Resource.NOSearchResult</output>
                }
            </div>

            <!-- Right Sidebar -->
            <div class="col-lg-4">
                @Html.Partial("~/Views/Designs/Crizal/Shared/StoriesPageThemes/_StoryCategorySidebar.cshtml", Model)
            </div>
        </div>
    </div>
</section>
