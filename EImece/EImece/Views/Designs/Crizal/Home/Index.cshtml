@using EImece.Domain.Entities;
@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain;
@using EImece.Domain.Helpers
@using Resources;
@model MainPageViewModel
@{
    var mainPageImages = Model.MainPageImages;
    var mainPageProducts = Model.MainPageProducts;
    var mainPageProductCategories = Model.MainPageProductCategories.Where(r => r.ParentId != 0).OrderBy(r => r.Position).Take(12).ToList();
    var rootMainPageProductCategories = Model.MainPageProductCategories.Where(r => r.ParentId == 0).ToList();
    var campaignProducts = Model.CampaignProducts;
    var latestProducts = Model.LatestProducts;
    var latestStories = Model.LatestStories;

    var firstHero = mainPageImages != null && mainPageImages.Count > 0 ? mainPageImages[0] : null;
    var firstHeroUrl = firstHero != null ? firstHero.GetCroppedImageUrl(firstHero.MainImageId, 1200, 600) : null;
}

@section HeadExtra {
    @if (!string.IsNullOrEmpty(firstHeroUrl))
    {
        <link rel="preload" as="image" href="@firstHeroUrl" fetchpriority="high" />
    }
}

<h1 class="sr-only">@ViewBag.Title</h1>

<!-- BANNER (home-business-02 slider-fade3) -->
<section class="p-0 mx-lg-1-9 mx-xxl-10" aria-label="@Resource.PopularProducts">
    <div class="container-fluid px-0 z-index-2 position-relative">
        <div class="slider-fade3 owl-carousel owl-theme w-100">
            @for (int i = 0; i < mainPageImages.Count; i++)
            {
                @CreateMainPageImage(mainPageImages[i], i == 0)
            }
        </div>
    </div>
</section>

@CreateProductCategorySection(@Resource.PopularProducts, mainPageProductCategories)

<!-- Subscription CTA -->
<section class="about-style5 pt-0" aria-label="@Resource.StayInformed">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="bg-light text-center p-1-6 p-sm-1-9 border-radius-10">
                    <div class="title-style16 mb-1-6">
                        <span>@Resource.StayInformed</span>
                        <h2 class="display-5 font-weight-800 mb-0 lh-1">@Resource.Subscribe*</h2>
                    </div>
                    @Html.Raw(Resource.MainPageProductSubscriptionHtml)
                    <label class="sr-only" for="SubscribeEmailText">@Resource.PleaseEnterYourEmail</label>
                    <div class="input-group mt-3">
                        <input type="email" name="email" id="SubscribeEmailText" class="form-control" placeholder="@Resource.PleaseEnterYourEmail" autocomplete="email" />
                        <button type="button" id="SubscribeEmailBtn" class="butn-style8 secondary"><span>@Resource.Subscribe*</span></button>
                    </div>
                    <div class="success-message text-center mt-3" id="SubscribeEmailTextSuccessMessage" style="display: none;">@Html.Raw(@Resource.MainPageProductSubscriptionThanks)</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Product widgets -->
<section class="pt-0">
    <div class="container">
        <div class="title-style16 mb-2-6 text-center">
            <span>@Resource.PopularProducts</span>
            <h2 class="display-4 font-weight-800 mb-0 lh-1">@Resource.ShowcaseProducts</h2>
        </div>
        <div class="row mt-n4 justify-content-center">
            @CreateProductWidget(Resource.ShowcaseProducts, mainPageProducts.OrderBy(t => Guid.NewGuid()).Take(AppConfig.HomePageMainProductCountRandomLimit).ToList(), 0)
            @CreateProductWidget(Resource.CampaignProducts, campaignProducts.OrderBy(t => Guid.NewGuid()).Take(AppConfig.HomePageMainProductCountRandomLimit).ToList(), 150)
            @CreateProductWidget(Resource.NewProducts, latestProducts.OrderBy(t => Guid.NewGuid()).Take(AppConfig.HomePageMainProductCountRandomLimit).ToList(), 300)
        </div>
    </div>
</section>

@if (latestStories.IsNotEmpty())
{
    <section>
        <div class="container">
            <div class="title-style16 mb-2-6 text-center">
                <span>@Resource.Stories</span>
                <h2 class="display-4 font-weight-800 mb-0 lh-1">@Resource.Stories</h2>
            </div>
            <div class="row">
                @CreateStoryWidget(latestStories.OrderBy(t => Guid.NewGuid()).Take(AppConfig.HomePageMainProductCountRandomLimit).ToList())
            </div>
        </div>
    </section>
}

@helper CreateMainPageImage(MainPageImage mainPageImage, bool isLcp)
{
    var imgLink = mainPageImage.GetCroppedImageUrl(mainPageImage.MainImageId, 1200, 600);
    var loadingAttr = isLcp ? "eager" : "lazy";
    var fetchPriorityAttr = isLcp ? "high" : "auto";
    <div class="item bg-img cover-background pt-6 pb-10 pt-sm-6 pb-sm-14 py-md-16 py-lg-20 py-xxl-23 border-radius-lg-10 secondary-overlay"
         data-overlay-dark="7"
         data-background="@imgLink">
        <div class="container pt-6 pt-md-0 my-xxl-2">
            <div class="row justify-content-end text-end align-items-center">
                <div class="col-md-10 col-lg-8 col-xl-7">
                    <h2 class="display-1 lh-1 font-weight-800 mb-3 text-white">@mainPageImage.Name</h2>
                    <p class="lead opacity7 text-white mb-4">@Resource.PopularProducts</p>
                    <a href="@mainPageImage.Link" class="butn-style8"><span>@mainPageImage.Name</span></a>
                </div>
            </div>
        </div>
        <img src="@imgLink" alt="@mainPageImage.Name" class="sr-only" loading="@loadingAttr" fetchpriority="@fetchPriorityAttr" width="1200" height="600" />
    </div>
}

@helper CreateProductCategorySection(String title, List<ProductCategory> mainPageProductCategories)
{
    if (mainPageProductCategories.IsNotEmpty())
    {
        <section class="about-style5">
            <div class="container">
                <div class="title-style16 mb-2-6 text-center">
                    <span>@title</span>
                    <h2 class="display-4 font-weight-800 mb-0 lh-1">@title</h2>
                </div>
                <div class="row g-0 mb-6 mb-xl-9 mt-n2-9">
                    @for (int i = 0; i < mainPageProductCategories.Count; i++)
                    {
                        var p = mainPageProductCategories[i];
                        @Html.DisplayFor(model => p, "FeaturedProductCategoryItem", new { Width = 400, Height = 400 })
                    }
                </div>
            </div>
        </section>
    }
}

@helper CreateStoryWidget(List<Story> latestStories)
{
    <div class="col-12">
        <div class="widget widget-featured-entries home-stories-widget">
            @for (int i = 0; i < latestStories.Count; i++)
            {
                var p = latestStories[i];
                @Html.DisplayFor(model => p, "MainPageStoryShort", new { Width = 220, Height = 150 })
            }
        </div>
    </div>
}

@helper CreateProductWidget(String title, List<Product> products, int delayMs)
{
    if (products.IsNotEmpty())
    {
        <div class="col-sm-6 col-xl-4 mt-4 wow fadeInUp" data-wow-delay="@(delayMs)ms">
            <div class="widget widget-featured-entries bg-light border-radius-10 p-1-6 h-100">
                <h3 class="h5 mb-3">@title</h3>
                @for (int i = 0; i < products.Count; i++)
                {
                    var p = products[i];
                    @Html.DisplayFor(model => p, "MainPageProductShort", new { Width = 80, Height = 80 })
                }
            </div>
        </div>
    }
}
