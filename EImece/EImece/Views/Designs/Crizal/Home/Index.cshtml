@using EImece.Domain.Entities;
@using EImece.Domain.Models.DTOs.Storefront;
@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain;
@using EImece.Domain.Helpers
@using Resources;
@model MainPageViewModel
@{
    var mainPageImages = Model.MainPageImages;
    var mainPageProducts = Model.MainPageProducts;
    var mainPageProductCategories = Model.MainPageProductCategories.Where(r => r.ParentId != 0).OrderBy(r => r.Position).Take(12).ToList();
    var campaignProducts = Model.CampaignProducts;
    var latestProducts = Model.LatestProducts;
    var latestStories = Model.LatestStories;
    var companyName = Html.Action("GetCompanyName", "Home");

    var firstHero = mainPageImages != null && mainPageImages.Count > 0 ? mainPageImages[0] : null;
    var firstHeroUrl = firstHero != null ? firstHero.GetCroppedImageUrl(1600, 900) : null;
}

@section HeadExtra {
    @if (!string.IsNullOrEmpty(firstHeroUrl))
    {
        <link rel="preload" as="image" href="@firstHeroUrl" fetchpriority="high" />
    }
}

<h1 class="visually-hidden">@ViewBag.Title</h1>

@if (mainPageImages.IsNotEmpty())
{
    <section class="crizal-home-hero" aria-label="@companyName">
        <div class="slider-fade3 owl-carousel owl-theme crizal-home-hero__slider">
            @for (int i = 0; i < mainPageImages.Count; i++)
            {
                @CreateMainPageImage(mainPageImages[i], i == 0, companyName.ToString())
            }
        </div>
    </section>
}

@CreateProductCategorySection(Resource.FeaturedProductCategories, mainPageProductCategories)

<section class="crizal-home-subscribe" aria-label="@Resource.StayInformed">
    <div class="container">
        <div class="crizal-home-subscribe__panel">
            <div class="crizal-home-subscribe__copy">
                <p class="crizal-home-subscribe__eyebrow">@companyName</p>
                <h2 class="crizal-home-subscribe__title">@Resource.StayInformed</h2>
                <div class="crizal-home-subscribe__text">@Html.Raw(Resource.MainPageProductSubscriptionHtml)</div>
            </div>
            <div class="crizal-home-subscribe__form">
                <label class="visually-hidden" for="SubscribeEmailText">@Resource.PleaseEnterYourEmail</label>
                <div class="crizal-home-subscribe__row">
                    <input type="email" name="email" id="SubscribeEmailText" class="form-control" placeholder="@Resource.PleaseEnterYourEmail" autocomplete="email" />
                    <button type="button" id="SubscribeEmailBtn" class="butn-style8"><span>@Resource.Subscribe</span></button>
                </div>
                <div class="success-message text-center mt-3" id="SubscribeEmailTextSuccessMessage" style="display: none;">@Html.Raw(@Resource.MainPageProductSubscriptionThanks)</div>
            </div>
        </div>
    </div>
</section>

<section class="crizal-home-products">
    <div class="container">
        <div class="crizal-home-heading">
            <p class="crizal-home-heading__eyebrow">@companyName</p>
            <h2 class="crizal-home-heading__title">@Resource.PopularProducts</h2>
        </div>
        <div class="row g-4 justify-content-center">
            @CreateProductWidget(Resource.ShowcaseProducts, mainPageProducts.Take(AppConfig.HomePageMainProductCountRandomLimit).ToList())
            @CreateProductWidget(Resource.CampaignProducts, campaignProducts.Take(AppConfig.HomePageMainProductCountRandomLimit).ToList())
            @CreateProductWidget(Resource.NewProducts, latestProducts.Take(AppConfig.HomePageMainProductCountRandomLimit).ToList())
        </div>
    </div>
</section>

@if (latestStories.IsNotEmpty())
{
    <section class="crizal-home-stories crizal-section-alt">
        <div class="container">
            <div class="crizal-home-heading">
                <p class="crizal-home-heading__eyebrow">@companyName</p>
                <h2 class="crizal-home-heading__title">@Resource.Stories</h2>
            </div>
            <div class="row g-4 justify-content-center">
                @CreateStoryWidget(latestStories.OrderByDescending(t => t.UpdatedDate).Take(Math.Max(3, AppConfig.HomePageMainProductCountRandomLimit)).ToList())
            </div>
        </div>
    </section>
}

@helper CreateMainPageImage(StorefrontBannerDto mainPageImage, bool isLcp, string brandName)
{
    var imgLink = mainPageImage.GetCroppedImageUrl(1600, 900);
    var hasImage = !string.IsNullOrWhiteSpace(imgLink);
    var staticMediaUrl = "";
    var lead = GeneralHelper.GetDescriptionWithBody(mainPageImage.Description, 110);
    var slideClass = hasImage ? "item crizal-home-hero__slide" : "item crizal-home-hero__slide crizal-home-hero__slide--placeholder";
    var bgStyle = hasImage ? ("background-image: url('" + imgLink.Replace("'", "%27") + "');") : null;
    <div class="@slideClass"
         @if (hasImage) { <text>data-background="@imgLink" data-hero-fallback="@staticMediaUrl" style="@bgStyle"</text> }>
        <div class="crizal-home-hero__veil" aria-hidden="true"></div>
        @* Do NOT put a visible/visually-hidden image inside owl-carousel: .owl-item img { display:block;width:100% }
           overrides .visually-hidden and dumps broken-image alt/filename text into the hero. *@
        <div class="container">
            <div class="crizal-home-hero__copy">
                <p class="crizal-home-hero__brand">@brandName</p>
                <h2 class="crizal-home-hero__title">@mainPageImage.Name</h2>
                @if (!string.IsNullOrWhiteSpace(lead))
                {
                    <p class="crizal-home-hero__lead">@lead</p>
                }
                <a href="@mainPageImage.Url" class="butn-style8 crizal-home-hero__btn"><span>@Resource.ContinueShopping</span></a>
            </div>
        </div>
    </div>
}

@helper CreateProductCategorySection(String title, List<StorefrontCategoryDto> mainPageProductCategories)
{
    if (mainPageProductCategories.IsNotEmpty())
    {
        <section class="crizal-home-categories">
            <div class="container">
                <div class="crizal-home-heading">
                    <h2 class="crizal-home-heading__title">@title</h2>
                </div>
                <div class="row g-4">
                    @for (int i = 0; i < mainPageProductCategories.Count; i++)
                    {
                        var p = mainPageProductCategories[i];
                        @Html.DisplayFor(model => p, "FeaturedProductCategoryItem", new { Width = 400, Height = 400 })
                    }
                </div>
            </div>
        </section>
    }
}

@helper CreateStoryWidget(List<StorefrontStoryCardDto> latestStories)
{
    var count = latestStories.Count;
    var colClass = count == 1 ? "col-sm-10 col-md-6 col-xl-4" : (count == 2 ? "col-md-6 col-xl-5" : "col-md-6 col-xl-4");
    foreach (var p in latestStories)
    {
        <div class="@colClass">
            @Html.DisplayFor(model => p, "MainPageStoryShort", new { Width = 420, Height = 280 })
        </div>
    }
}

@helper CreateProductWidget(String title, List<StorefrontProductCardDto> products)
{
    if (products.IsNotEmpty())
    {
        <div class="col-md-6 col-xl-4">
            <div class="crizal-home-product-panel">
                <h3 class="crizal-home-product-panel__title">@title</h3>
                <div class="crizal-home-product-panel__list">
                    @for (int i = 0; i < products.Count; i++)
                    {
                        var p = products[i];
                        @Html.DisplayFor(model => p, "MainPageProductShort", new { Width = 80, Height = 80 })
                    }
                </div>
            </div>
        </div>
    }
}
