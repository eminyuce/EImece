@model ProductCategoryViewModel
@using EImece.Domain.Entities
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain.Models.FrontModels;
@using EImece.Domain.Models.DTOs.Storefront;
@using Resources;
@using EImece.Domain;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain.Models;
@using EImece.Domain.Models.Enums;
@{

    ProductCategory category = Model.ProductCategory;
    var pagedDtos = Model.PagedProductDtos;
    var products = new PaginatedModelList<StorefrontProductCardDto>(pagedDtos, pagedDtos.PageIndex, pagedDtos.PageSize, pagedDtos.TotalCount);
    products.RouteId = Model.SeoId;
    products.Filter = Model.Filter;
    products.Sorting = (int)Model.Sorting;
    products.MinPrice = Model.MinPrice;
    products.MaxPrice = Model.MaxPrice;
    var ChildrenProductCategories = Model.ChildrenProductCategories.OrderBy(r => r.Position).ThenByDescending(r => r.UpdatedDate).ToList();

    ViewBag.Title = category.GetSeoTitle();
    ViewBag.Keywords = category.GetSeoKeywords();
    var seoDescription = GeneralHelper.GetDescriptionWithBody(category.Description, 150);
    if (string.IsNullOrWhiteSpace(seoDescription))
    {
        seoDescription = GeneralHelper.GetDescriptionWithBody(category.ShortDescription, 150);
    }
    if (string.IsNullOrWhiteSpace(seoDescription))
    {
        seoDescription = category.GetSeoDescription();
    }
    if (string.IsNullOrWhiteSpace(seoDescription))
    {
        seoDescription = category.Name;
    }
    ViewBag.Description = seoDescription;
    var isUserAuthenticated = User.Identity.IsAuthenticated && AppConfig.IsEditLinkEnable;
    var productPriceEnabled = Model.IsProductPriceEnabled;
    var productReviewEnabled = Model.IsProductReviewEnabled;
    var hasAnySoldProducts = Model.HasAnySoldProducts;

    var shortDescriptionPreviewLength = AppConfig.ProductShortDescriptionPreviewLength;
    var shortDescriptionPlain = GeneralHelper.StripHtml(category.ShortDescription).Trim();
    var shortDescriptionNeedsContinue = !string.IsNullOrEmpty(shortDescriptionPlain)
        && shortDescriptionPlain.Length > shortDescriptionPreviewLength;
    var shortDescriptionPreview = shortDescriptionPlain;
    if (shortDescriptionNeedsContinue)
    {
        var cut = shortDescriptionPreviewLength;
        var lastSpace = shortDescriptionPlain.LastIndexOf(' ', cut);
        if (lastSpace >= (int)(shortDescriptionPreviewLength * 0.7))
        {
            cut = lastSpace;
        }
        shortDescriptionPreview = shortDescriptionPlain.Substring(0, cut).Trim() + "…";
    }
}

<section class="page-title-wrapper" aria-label="Page title">
    <div class="container">
        <nav class="crizal-breadcrumb" aria-label="breadcrumb">
            <ol class="crizal-breadcrumb__list breadcrumb">
                @Html.Partial("~/Views/Designs/Crizal/Shared/_CrizalBreadcrumbHomeItem.cshtml")
                @if (category.Parent != null && category.Parent.Parent != null)
                {
                    <li class="crizal-breadcrumb__item breadcrumb-item">
                        <a href="@category.Parent.Parent.DetailPageUrl" class="crizal-breadcrumb__link">@category.Parent.Parent.Name</a>
                    </li>
                }
                @if (category.Parent != null)
                {
                    <li class="crizal-breadcrumb__item breadcrumb-item">
                        <a href="@category.Parent.DetailPageUrl" class="crizal-breadcrumb__link">@category.Parent.Name</a>
                    </li>
                }
                <li class="crizal-breadcrumb__item breadcrumb-item active" aria-current="page">
                    <span class="crizal-breadcrumb__current" title="@category.Name">@category.Name</span>
                </li>
            </ol>
        </nav>
        <h1 class="page-title">@category.Name</h1>
        @if (!string.IsNullOrEmpty(shortDescriptionPlain))
        {
            <div class="crizal-product-shortdesc">
                @if (shortDescriptionNeedsContinue)
                {
                    <div class="crizal-product-shortdesc__preview" id="categoryShortDescPreview">
                        <p>@shortDescriptionPreview</p>
                    </div>
                    <div class="collapse crizal-product-shortdesc__full" id="categoryShortDescFull">
                        <div class="crizal-product-shortdesc__body">@Html.Raw(!string.IsNullOrEmpty(category.Description) ? category.Description : category.ShortDescription)</div>
                    </div>
                    <button type="button"
                            class="crizal-product-shortdesc__toggle"
                            aria-expanded="false"
                            aria-controls="categoryShortDescFull"
                            data-continue-text="@Resource.ClickHereForMoreDetails"
                            data-less-text="@Resource.ShowLess">
                        <span class="crizal-product-shortdesc__toggle-label">@Resource.ClickHereForMoreDetails</span>
                        <i class="fas fa-chevron-down" aria-hidden="true"></i>
                    </button>
                }
                else
                {
                    <div class="crizal-product-shortdesc__body">@Html.Raw(category.ShortDescription)</div>
                }
            </div>
        }

        <hr class="mt-4">
    </div>
</section>

<div class="container pb-5 mb-4">
    <div class="row">
        <div class="col-lg-3">
            <!-- Shop sidebar-->
            <div class="offcanvas-sidebar">
                <div class="offcanvas-sidebar-toggle"><span class="toggle-knob"><i data-feather="chevrons-right"></i>@Resource.Filtrele</span></div>
                <div class="offcanvas-sidebar-body">
                    <div class="offcanvas-sidebar-body-inner">
                        <div class="crizal-sidebar-header d-lg-none">
                            <strong>@Resource.Filtrele</strong>
                            <button type="button" class="crizal-sidebar-close" aria-label="Close">&times;</button>
                        </div>

                        @Html.Partial("_ProductCategoryTreeHeadLine",
                       new Tuple<ProductCategory, List<ProductCategoryTreeModel>>(category, Model.ProductCategoryTree))
                        @if (Model.HasAnyFilters)
                        {
                            <div class="column mb-2 pb-1">
                                <button class="butn-style8 btn-block mb-2" id="FilterButton" type="button"><span>@Resource.Filter</span></button>
                            </div>
                            foreach (var filterType in Model.CategoryFilterTypes.OrderBy(r => r.Position))
                            {
                                @CreateFilterTypeList(filterType, Model);
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            <button type="button" class="butn-style8 small crizal-open-filters"><span>@Resource.Filtrele</span></button>
            <!-- Toolbar-->
            <div class="d-flex flex-wrap justify-content-center justify-content-sm-between pb-1">
                <div class="d-flex flex-wrap">
                    <div class="form-inline flex-nowrap mr-1 mr-sm-1 pb-1">
                        <div class="button-group tabs">
                            @if (Model.SelectedFilterTypes.IsNotEmpty())
                            {
                                foreach (var selectedFilterType in Model.SelectedFilterTypes)
                                {

                            <a href="@selectedFilterType.RemoveSelectedFilter(Model.SelectedFilterTypes,products)"
                               rel="nofollow" class="btn btn-pill btn-outline-dark btn-sm">
                                @string.Format("{0}: {1}", selectedFilterType.Parent.FilterTypeName.Text, selectedFilterType.name)
                                <span class="badge badge-pill badge-light">X</span>
                            </a>
                                }
                            <a href="@Url.Action("Category", "ProductCategories", new { filtreler = ""})"
                               rel="nofollow" class="btn btn-pill btn-outline-dark btn-sm">
                                @Resource.RemoveAllFilter
                            </a>

                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-center justify-content-sm-between pb-1">
                <div class="d-flex flex-wrap">
                    <div class="form-inline flex-nowrap mr-1 mr-sm-1 pb-1">
                        <label class="text-nowrap mr-2 d-none d-sm-block" for="sorting">@Resource.SortBy:</label>
                        <div class="button-group tabs">
                            @if (productPriceEnabled)
                            {
                                <a href="@category.ProductCategoryListPageUrl(SortingType.LowHighPrice,products)"
                                   rel="nofollow" class="@activeButtonClass(SortingType.LowHighPrice, products)">@Resource.LowHighPriceItems</a>
                                <a href="@category.ProductCategoryListPageUrl(SortingType.HighLowPrice,products)"
                                   rel="nofollow" class="@activeButtonClass(SortingType.HighLowPrice, products)">@Resource.HighLowPriceItems</a>
                            }
                            <a href="@category.ProductCategoryListPageUrl(SortingType.Newest,products)"
                               rel="nofollow" class="@activeButtonClass(SortingType.Newest, products)">@Resource.NewestItems</a>
                            @if (hasAnySoldProducts)
                            {
                                <a href="@category.ProductCategoryListPageUrl(SortingType.Popularity,products)"
                                   rel="nofollow" class="@activeButtonClass(SortingType.Popularity, products)">@Resource.PopularityItems</a>
                            }
                            @if (productReviewEnabled)
                            {
                                <a href="@category.ProductCategoryListPageUrl(SortingType.AverageRating,products)"
                                   rel="nofollow" class="@activeButtonClass(SortingType.AverageRating, products)">@Resource.MostReviewedItems</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-wrap justify-content-center justify-content-sm-between pb-1">
                <div class="d-flex flex-wrap">
                    <span class="d-block mt-2">@Html.Raw(string.Format(Resource.ProductFoundInfoForCategory, HttpUtility.HtmlEncode(category.Name), products.TotalCount))</span>
                </div>
            </div>
            <!-- Products grid-->
            <div class="row no-gutters">

                @if (products.IsNotEmpty())
                {
                    foreach (var p in products.GetPagingResult())
                    {

                @Html.DisplayFor(model => p, "FeaturedProductItem", new { Width = 300, Height = 300 })
                    }
                }
                else
                {
                <div class="alert alert-secondary alert-with-icon" role="alert">
                    <div class="alert-icon-box"><i class="alert-icon" data-feather="alert-triangle"></i></div>
                    @if (Model.SelectedFilterTypes.IsNotEmpty())
                        {
                    @Html.Raw(@Resource.NoProductsFoundForSelectedFilters)
                        }
                        else
                        {
                    @Html.Raw(@Resource.NoProductsFoundForCategory)
                        }
                </div>
                }
            </div>
            <div class="d-flex justify-content-center py-4 pb-5">
                @Html.Partial("_PaginatedModelList", products)
            </div>
        </div>
    </div>
</div>
@functions {

    public string activeButtonClass(SortingType selected, IPaginatedModelList products)
    {
        return String.Format("{0}", products.Sorting == (int)selected ? "btn btn-sm btn-pill btn-secondary mb-2 mr-1" : "btn btn-sm btn-pill btn-outline-secondary mb-2 mr-1");
    }
}

@helper CreateFilterTypeList(CategoryFilterType categoryFilter, ProductCategoryViewModel productCategoryViewModel)
{
    var selectedFilters = productCategoryViewModel.SelectedFilters;

    if (categoryFilter.FilterTypeName.FilterType == FilterType.Rating)
    {
        <div class="widget crizal-filter-widget mb-4">
            <h2 class="widget-title">@categoryFilter.FilterTypeName.Text</h2>
            <div class="crizal-rating-filters">
                @foreach (var filter in categoryFilter.CategoryFilters.OrderByDescending(f => f.rating))
                {
                    var filterId = string.Format("filter-{0}", filter.CategoryFilterId);
                    var rating = filter.rating > 0 ? filter.rating : 0;
                    if (rating > 5) { rating = 5; }
                    <div class="custom-control custom-checkbox crizal-rating-filter">
                        <input class="custom-control-input" type="checkbox" @(selectedFilters.Contains(filter.CategoryFilterId) ? "checked" : null) value="@filter.CategoryFilterId" name="filters" id="@filterId">
                        <label class="custom-control-label" for="@filterId">
                            <span class="crizal-stars" aria-hidden="true">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="crizal-stars__star@(i <= rating ? " is-on" : "")" aria-hidden="true">★</span>
                                }
                            </span>
                            <span class="crizal-rating-filter__caption">@rating+</span>
                            @if (filter.count > 0)
                            {
                                <span class="crizal-filter-count">(@filter.count)</span>
                            }
                        </label>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="widget crizal-filter-widget mb-4">
            <h2 class="widget-title">@categoryFilter.FilterTypeName.Text</h2>
            <div class="crizal-filter-list">
                @foreach (var filter in categoryFilter.CategoryFilters)
                {
                    var filterId = string.Format("filter-{0}", filter.CategoryFilterId);
                    <div class="custom-control custom-checkbox">
                        <input class="custom-control-input" type="checkbox" @(selectedFilters.Contains(filter.CategoryFilterId) ? "checked" : null) value="@filter.CategoryFilterId" name="filters" id="@filterId">
                        <label class="custom-control-label" for="@filterId">
                            <span class="crizal-filter-name">@filter.name</span>
                            @if (filter.count > 0)
                            {
                                <span class="crizal-filter-count">(@filter.count)</span>
                            }
                        </label>
                    </div>
                }
            </div>
        </div>
        if (categoryFilter.FilterTypeName.FilterType == FilterType.Price)
        {
            <div class="widget crizal-filter-widget mb-4">
                <h2 class="widget-title">@Resource.FilterByPrice</h2>
                <div class="crizal-price-range">
                    <input class="form-control" type="text" inputmode="numeric" id="minPriceOrginal" placeholder="Min TL" value="@Model.MinPrice" title="Lütfen bir tam sayı giriniz" aria-label="Min TL">
                    <span class="crizal-price-range__sep" aria-hidden="true">&ndash;</span>
                    <input class="form-control" type="text" inputmode="numeric" id="maxPriceOrginal" placeholder="Max TL" value="@Model.MaxPrice" title="Lütfen bir tam sayı giriniz" aria-label="Max TL">
                </div>
            </div>
        }
    }
}
<input type="hidden" id="noUrlFilter" value="@Url.Action("Category", "ProductCategories",new { id=Model.SeoId })" />
<input type="hidden" id="urlFilter" value="@Url.Action("Category", "ProductCategories", new { id=Model.SeoId, filtreler = "js-filtreler" })" />
<input type="hidden" id="urlFilterMinMaxPage" value="@Url.Action("Category", "ProductCategories", new { id=Model.SeoId,filtreler = "js-filtreler", minPrice = "js-min", maxPrice = "js-max" })" />
<input type="hidden" id="urlMinMaxPage" value="@Url.Action("Category", "ProductCategories", new { id=Model.SeoId, minPrice = "js-min", maxPrice = "js-max" })" />
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>

        $(document).ready(function () {

            function GetSelectedCheckBoxValuesArray() {
                var stringArray = new Array();
                var i = 0;
                $("input[name=filters]").each(function () {
                    var m = $(this).is(':checked');
                    if (m) {
                        stringArray[i++] = $(this).attr("value");
                    }
                });
                return stringArray;
            }
            $("#FilterButton").click(function () {

                var minPriceOrginal = $("#minPriceOrginal").val();
                var maxPriceOrginal = $("#maxPriceOrginal").val();
                var hasPrice = (!isEmpty(minPriceOrginal) && parseInt(minPriceOrginal) > 0) || (!isEmpty(maxPriceOrginal) && parseInt(maxPriceOrginal) > 0);
                var strArrayFilter = GetSelectedCheckBoxValuesArray();

                var link = "";
                if (hasPrice && strArrayFilter.length === 0) {
                    link = $("#urlMinMaxPage").val()
                        .replace("js-min", minPriceOrginal)
                        .replace("js-max", maxPriceOrginal);
                } else if (hasPrice && strArrayFilter.length > 0) {
                    link = $("#urlFilterMinMaxPage").val().replace("js-filtreler", encodeURIComponent(strArrayFilter.join("-")))
                        .replace("js-min", minPriceOrginal)
                        .replace("js-max", maxPriceOrginal);
                }
                else if (!hasPrice && strArrayFilter.length === 0) {
                    link = $("#noUrlFilter").val();
                } else if (!hasPrice && strArrayFilter.length > 0) {
                    link = $("#urlFilter").val().replace("js-filtreler", encodeURIComponent(strArrayFilter.join("-")));;
                } else {
                    console.log("-------error");
                }
                console.log(hasPrice);
                console.log(strArrayFilter);
                console.log(strArrayFilter.length);
                console.log(link);
                window.location = link;
            });

        });
    </script>
}