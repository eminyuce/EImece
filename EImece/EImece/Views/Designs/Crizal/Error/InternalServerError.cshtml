@model  EImece.Domain.Models.HelperModels.ErrorModel
@using Resources;
@using EImece.Domain;
@{
    ViewBag.Title = Resource.UnexpectedErrorText;
    ViewBag.Description = Resource.InternalServererrorText;
    var detail = ViewBag.ExceptionDetail as Exception;
}
<div class="error-card">
    <div class="error-code">500</div>
    <h1 class="error-title">@ViewBag.Title</h1>
    <p class="error-desc">@ViewBag.Description</p>
    <a class="error-btn" href="/">@Resource.ContinueShopping</a>

    @if (HttpContext.Current.IsDebuggingEnabled && detail != null)
    {
        <div class="error-details-box">
            <p><strong>Type:</strong> @detail.GetType().FullName</p>
            <p><strong>Message:</strong> @detail.Message</p>
            <pre style="white-space: pre-wrap; margin: 0; color: inherit;">@detail.ToString()</pre>
        </div>
    }
</div>
