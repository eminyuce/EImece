@model EImece.Models.RegisterViewModel
@using Resources;
@using System.Linq;
@{
    var companyName = Html.Action("GetCompanyName", "Home");
    ViewBag.Title = Resource.CustomerRegister + " | " + companyName;
}

<section class="crizal-customer-login crizal-customer-register" aria-labelledby="customer-register-title">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="crizal-customer-login__panel">
                    <aside class="crizal-customer-login__intro" aria-hidden="false">
                        <p class="crizal-customer-login__eyebrow">@companyName</p>
                        <h1 id="customer-register-title" class="crizal-customer-login__title">@Resource.CustomerRegister</h1>
                        <p class="crizal-customer-login__lead">@Resource.RegistrationInfoText</p>
                        <ul class="crizal-customer-login__benefits">
                            <li><i class="fas fa-receipt" aria-hidden="true"></i><span>@Resource.MyOrder</span></li>
                            <li><i class="fas fa-map-marker-alt" aria-hidden="true"></i><span>@Resource.ShippingAddress</span></li>
                            <li><i class="fas fa-shopping-bag" aria-hidden="true"></i><span>@Resource.MyBasket</span></li>
                        </ul>
                    </aside>

                    <div class="crizal-customer-login__form-wrap">
                        <div class="crizal-customer-login__form-header">
                            <div class="crizal-customer-login__badge">
                                <i class="fas fa-user-plus" aria-hidden="true"></i>
                                <span>@Resource.CustomerAccount</span>
                            </div>
                            <h2 class="crizal-customer-login__form-title">@Resource.CustomerRegister</h2>
                            <p class="crizal-customer-login__form-help">
                                <i class="fas fa-info-circle" aria-hidden="true"></i>
                                <span>@Resource.PasswordInfoMessage</span>
                            </p>
                        </div>

                        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "crizal-customer-login__form form-horizontal", role = "form", autocomplete = "on" }))
                        {
                            @Html.Hidden("returnUrl", (string)ViewBag.ReturnUrl)
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger crizal-customer-login__errors" })

                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.FirstName, new { @class = "crizal-customer-login__label" })
                                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", autocomplete = "given-name" })
                                        @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.LastName, new { @class = "crizal-customer-login__label" })
                                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", autocomplete = "family-name" })
                                        @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.Email, new { @class = "crizal-customer-login__label" })
                                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", autocomplete = "email" })
                                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.PhoneNumber, new { @class = "crizal-customer-login__label" })
                                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", autocomplete = "tel", placeholder = "+90 5XX XXX XX XX" })
                                        <small class="text-muted d-block mt-1">@Resource.WhyNeedGsmNumber</small>
                                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.IdentityNumber, new { @class = "crizal-customer-login__label" })
                                        @Html.TextBoxFor(m => m.IdentityNumber, new { @class = "form-control", inputmode = "numeric", maxlength = "11", autocomplete = "off" })
                                        <small class="text-muted d-block mt-1">@Resource.WhyNeedIdentityNumber</small>
                                        @Html.ValidationMessageFor(m => m.IdentityNumber, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <input type="hidden" id="SelectedCity" value="@Model.City" />
                                        @Html.LabelFor(m => m.City, new { @class = "crizal-customer-login__label" })
                                        @Html.DropDownListFor(m => m.City, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Cities" })
                                        @Html.ValidationMessageFor(m => m.City, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <input type="hidden" id="SelectedTown" value="@Model.Town" />
                                        @Html.LabelFor(m => m.Town, new { @class = "crizal-customer-login__label" })
                                        @Html.DropDownListFor(m => m.Town, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Towns" })
                                        @Html.ValidationMessageFor(m => m.Town, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <input type="hidden" id="SelectedDistrict" value="@Model.District" />
                                        @Html.LabelFor(m => m.District, new { @class = "crizal-customer-login__label" })
                                        @Html.DropDownListFor(m => m.District, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Districts" })
                                        @Html.ValidationMessageFor(m => m.District, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.Street, new { @class = "crizal-customer-login__label" })
                                        @Html.TextBoxFor(m => m.Street, new { @class = "form-control", autocomplete = "street-address" })
                                        @Html.ValidationMessageFor(m => m.Street, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.ZipCode, new { @class = "crizal-customer-login__label" })
                                        @Html.TextBoxFor(m => m.ZipCode, new { @class = "form-control", autocomplete = "postal-code" })
                                        @Html.ValidationMessageFor(m => m.ZipCode, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.Country, new { @class = "crizal-customer-login__label" })
                                        @Html.DropDownListFor(m => m.Country, EImece.Web.Helpers.WebGeneralHelper.GetStaticCountries(), new { @class = "form-control", autocomplete = "country-name" })
                                        @Html.ValidationMessageFor(m => m.Country, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.Password, new { @class = "crizal-customer-login__label" })
                                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password" })
                                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "crizal-customer-login__label" })
                                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
                                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                </div>
                                <div class="col-sm-12">
                                    <div class="form-group crizal-customer-login__captcha">
                                        @Html.CaptchaWidget("CustomerRegister", "text-danger small d-block mt-1")
                                    </div>
                                </div>
                            </div>

                            <div class="custom-control custom-checkbox mb-3">
                                @Html.CheckBoxFor(m => m.IsPermissionGranted, new { @class = "custom-control-input" })
                                @Html.LabelFor(m => m.IsPermissionGranted, new { @class = "custom-control-label" })
                            </div>

                            <button type="submit" class="butn-style8 crizal-customer-login__submit">
                                <i class="fas fa-user-plus" aria-hidden="true"></i>
                                <span>@Resource.CustomerRegister</span>
                            </button>
                        }

                        <div class="crizal-customer-login__register">
                            <p class="crizal-customer-login__register-prompt">@Resource.AlreadyMembered</p>
                            @Html.ActionLink(Resource.Login, "Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, new { @class = "butn-style8 outline crizal-customer-login__register-btn" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")
}
