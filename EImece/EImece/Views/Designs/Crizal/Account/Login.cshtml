@using EImece.Models
@model LoginViewModel
@using Resources;
@{
    ViewBag.Title = "Log in";
}

<div class="container pb-5 mb-sm-4">
    <div class="row pt-5 justify-content-center">
        <div class="col-md-6 pt-sm-3">
            <div class="card crizal-auth-card">
                <div class="card-body text-center">
                    <h2 class="h4 mb-1">@Resource.CustomerLoginPage</h2>
                    <p class="text-muted mb-3">@Resource.SignInOrUp</p>
                    <div class="d-sm-flex align-items-center justify-content-center py-2">
                        @Html.ActionLink(Resource.CustomerRegister, "Register", "Account", null, new { @class = "butn-style8 small secondary" })
                    </div>
                    <hr>

                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "login text-left", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-secondary text-danger" })

                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "alert alert-default text-danger" })
                        <div class="input-group form-group">
                            <div class="input-group-prepend"><span class="input-group-text" id="signin-email-icon"><i data-feather="mail"></i></span></div>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @placeholder = @Resource.Email, @aria_label = "Email", @aria_describedby = "signin-email-icon" })
                        </div>

                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "alert alert-default text-danger" })
                        <div class="input-group form-group">
                            <div class="input-group-prepend"><span class="input-group-text" id="signin-password-icon"><i data-feather="lock"></i></span></div>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = @Resource.Password, @aria_label = "Password", @aria_describedby = "signin-password-icon" })
                        </div>

                        <div class="d-flex flex-wrap justify-content-between">
                            <div class="custom-control custom-checkbox">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "custom-control-input" })
                                @Html.LabelFor(model => model.RememberMe, new { @class = "custom-control-label" })
                            </div>
                            @Html.ActionLink(@Resource.LostYourPassword, "ForgotPassword", null, new { @class = "btn btn-sm btn-link" })
                        </div>

                        @Html.CaptchaWidget("CustomerLogin", "alert alert-default text-danger")

                        <hr class="mt-4">
                        <div class="text-right pt-2">
                            <input type="submit" value="@Resource.Login" class="butn-style8 btn-block" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
