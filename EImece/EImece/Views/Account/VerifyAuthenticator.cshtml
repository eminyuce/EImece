@using EImece.Models
@using Resources
@model VerifyAuthenticatorViewModel

@{
    ViewBag.Title = "İki Faktörlü Doğrulama";
    Layout = null;
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture;
}

<!DOCTYPE html>
<html lang="@currentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>@ViewBag.Title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@500;600&display=swap" rel="stylesheet">
    @Styles.Render("~/Content/adminBootstrapCss")
    <link rel="stylesheet" href="~/Content/admin-vendor/fontawesome/css/all.min.css?v=7.3.1">
    <style>
        :root {
            --ink: #15202b;
            --ink-soft: #3d4f5f;
            --muted: #6b7c8a;
            --line: #d7e0e7;
            --surface: #ffffff;
            --panel: #0f3d4c;
            --accent: #0e7490;
            --accent-hover: #0b5f75;
            --shadow: 0 18px 50px rgba(15, 61, 76, 0.18);
            --radius: 18px;
            --font: "IBM Plex Sans", "Segoe UI", sans-serif;
            --display: "IBM Plex Serif", Georgia, serif;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: var(--font);
            color: var(--ink);
            background:
                radial-gradient(1200px 600px at 10% 0%, rgba(14, 116, 144, 0.12), transparent 55%),
                radial-gradient(900px 500px at 90% 100%, rgba(15, 61, 76, 0.10), transparent 50%),
                linear-gradient(160deg, #eef5f7 0%, #f7fafb 45%, #e8f1f4 100%);
            display: flex;
            align-items: center;
        }

        .admin-2fa {
            width: 100%;
            padding: 1.5rem;
        }

        .admin-2fa__card {
            max-width: 440px;
            margin: 0 auto;
            background: var(--surface);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .admin-2fa__header {
            background: linear-gradient(160deg, var(--panel) 0%, #155e75 100%);
            color: #fff;
            padding: 1.5rem 1.6rem 1.35rem;
            text-align: center;
        }

        .admin-2fa__title {
            font-family: var(--display);
            font-size: 1.35rem;
            font-weight: 600;
            margin: 0;
        }

        .admin-2fa__body {
            padding: 1.75rem 1.6rem 1.6rem;
        }

        .admin-2fa__lead {
            text-align: center;
            color: var(--muted);
            margin-bottom: 1.25rem;
            font-size: 0.95rem;
        }

        .admin-2fa .form-control {
            height: 46px;
            border-radius: 10px;
            border: 1px solid var(--line);
            font-size: 1.5rem;
            letter-spacing: 4px;
            text-align: center;
        }

        .admin-2fa .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(14, 116, 144, 0.15);
        }

        .admin-2fa .form-check {
            display: flex;
            align-items: center;
            padding-left: 0;
            margin-bottom: 1.1rem;
        }

        .admin-2fa .form-check-input {
            position: static;
            margin: 0 0.5rem 0 0;
        }

        .admin-2fa .form-check-label {
            margin: 0;
            font-weight: 500;
            color: var(--ink-soft);
            font-size: 0.9rem;
        }

        .admin-2fa__submit {
            width: 100%;
            height: 48px;
            border: 0;
            border-radius: 12px;
            background: var(--accent);
            color: #fff;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .admin-2fa__submit:hover,
        .admin-2fa__submit:focus {
            background: var(--accent-hover);
            color: #fff;
        }

        .admin-2fa__back {
            text-align: center;
            margin-top: 1rem;
        }

        .admin-2fa__back a {
            color: var(--accent);
            text-decoration: none;
            font-size: 0.9rem;
        }

        .admin-2fa__back a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="admin-2fa">
        <div class="admin-2fa__card">
            <div class="admin-2fa__header">
                <h1 class="admin-2fa__title">@ViewBag.Title</h1>
            </div>
            <div class="admin-2fa__body">
                <p class="admin-2fa__lead">
                    Authenticator uygulamanızdaki 6 haneli kodu girin.
                </p>

                @using (Html.BeginForm("VerifyAuthenticator", "Account", FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Token)
                    @Html.HiddenFor(m => m.ReturnUrl)
                    @Html.HiddenFor(m => m.RememberMe)

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })

                    <div class="mb-3">
                        @Html.TextBoxFor(m => m.Code, new
                        {
                            @class = "form-control",
                            placeholder = "123456",
                            maxlength = "6",
                            autocomplete = "one-time-code",
                            autofocus = "autofocus",
                            required = "required",
                            inputmode = "numeric",
                            pattern = "[0-9]{6}"
                        })
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-check mb-3">
                        @Html.CheckBoxFor(m => m.RememberBrowser, new { @class = "form-check-input", id = "rememberBrowser" })
                        <label class="form-check-label" for="rememberBrowser">@Resource.RememberThisBrowser</label>
                    </div>

                    <button type="submit" class="btn admin-2fa__submit">
                        <i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i> Doğrula ve Giriş Yap
                    </button>
                }

                <div class="admin-2fa__back">
                    <a href="@Url.Action("AdminLogin", "Account")">Giriş sayfasına dön</a>
                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/adminJquery")
    @Scripts.Render("~/bundles/adminBootstrap")
</body>
</html>
