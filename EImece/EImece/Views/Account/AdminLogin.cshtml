@using EImece.Models
@model LoginViewModel
@using Resources;
@using EImece.Domain;
@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.HtmlHelpers;
@using EImece.Domain.Models.Enums;

@{
    ViewBag.Title = Resource.AdminPanelLoginPage;
    Layout = null;
    var remoteIp = EImece.Domain.Helpers.GeneralHelper.GetRemoteIP(Request.ServerVariables);
    var currentCulture = System.Threading.Thread.CurrentThread.CurrentCulture;
    var loginStamp = DateTime.Now.ToString("dddd, dd MMMM yyyy HH:mm", currentCulture);
    string securityStepText;
    switch (CaptchaSettings.Provider)
    {
        case CaptchaProviderType.Recaptcha:
            securityStepText = AdminResource.AdminLoginRecaptchaGuideText;
            break;
        case CaptchaProviderType.None:
            securityStepText = AdminResource.AdminLoginNoCaptchaGuideText;
            break;
        default:
            securityStepText = AdminResource.AdminLoginMathCaptchaGuideText;
            break;
    }
}

<!DOCTYPE html>
<html lang="@currentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="robots" content="noindex,nofollow">
    <title>@ViewBag.Title</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/Content/admin-vendor/fontawesome/css/all.min.css?v=7.3.1">

    <style>
        :root {
            --ink: #15202b;
            --ink-soft: #3d4f5f;
            --muted: #6b7c8a;
            --line: #d7e0e7;
            --surface: #ffffff;
            --panel: #0f3d4c;
            --panel-mid: #155e75;
            --accent: #0e7490;
            --accent-hover: #0b5f75;
            --warn-bg: #fff7ed;
            --warn-border: #fdba74;
            --warn-text: #9a3412;
            --ok: #0f766e;
            --danger-bg: #fef2f2;
            --danger-border: #fecaca;
            --shadow: 0 18px 50px rgba(15, 61, 76, 0.18);
            --radius: 18px;
            --font: "IBM Plex Sans", "Segoe UI", sans-serif;
            --display: "IBM Plex Serif", Georgia, serif;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: var(--font);
            color: var(--ink);
            background:
                radial-gradient(1200px 600px at 10% 0%, rgba(14, 116, 144, 0.12), transparent 55%),
                radial-gradient(900px 500px at 90% 100%, rgba(15, 61, 76, 0.10), transparent 50%),
                linear-gradient(160deg, #eef5f7 0%, #f7fafb 45%, #e8f1f4 100%);
        }

        .admin-login {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .admin-login__shell {
            width: 100%;
            max-width: 980px;
            display: grid;
            grid-template-columns: 1.05fr 1fr;
            background: var(--surface);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
            border: 1px solid rgba(21, 32, 43, 0.06);
            animation: rise-in 0.45s ease-out both;
        }

        @@keyframes rise-in {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .admin-login__guide {
            position: relative;
            padding: 2.4rem 2.2rem;
            color: #f4fafc;
            background:
                linear-gradient(165deg, rgba(255,255,255,0.08), transparent 40%),
                linear-gradient(145deg, var(--panel) 0%, var(--panel-mid) 100%);
            overflow: hidden;
        }

        .admin-login__guide::before {
            content: "";
            position: absolute;
            inset: auto -40% -35% auto;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
            pointer-events: none;
        }

        .admin-login__badge {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            font-size: 0.78rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: rgba(244, 250, 252, 0.9);
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 999px;
            padding: 0.35rem 0.75rem;
            margin-bottom: 1.25rem;
        }

        .admin-login__brand {
            font-family: var(--display);
            font-size: 1.85rem;
            font-weight: 600;
            line-height: 1.25;
            margin: 0 0 0.65rem;
            position: relative;
        }

        .admin-login__lead {
            margin: 0 0 1.75rem;
            color: rgba(244, 250, 252, 0.82);
            font-size: 0.98rem;
            line-height: 1.55;
            max-width: 28ch;
            position: relative;
        }

        .admin-login__steps {
            list-style: none;
            margin: 0;
            padding: 0;
            position: relative;
            display: grid;
            gap: 0.9rem;
        }

        .admin-login__steps li {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 0.85rem;
            align-items: start;
            animation: step-in 0.5s ease-out both;
        }

        .admin-login__steps li:nth-child(1) { animation-delay: 0.08s; }
        .admin-login__steps li:nth-child(2) { animation-delay: 0.16s; }
        .admin-login__steps li:nth-child(3) { animation-delay: 0.24s; }
        .admin-login__steps li:nth-child(4) { animation-delay: 0.32s; }

        @@keyframes step-in {
            from { opacity: 0; transform: translateX(-8px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .admin-login__step-num {
            width: 1.85rem;
            height: 1.85rem;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.82rem;
            font-weight: 700;
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.22);
            flex-shrink: 0;
        }

        .admin-login__step-title {
            display: block;
            font-weight: 600;
            font-size: 0.95rem;
            margin-bottom: 0.15rem;
        }

        .admin-login__step-text {
            display: block;
            font-size: 0.86rem;
            line-height: 1.45;
            color: rgba(244, 250, 252, 0.78);
        }

        .admin-login__guide-note {
            margin-top: 1.75rem;
            padding-top: 1.25rem;
            border-top: 1px solid rgba(255, 255, 255, 0.16);
            font-size: 0.82rem;
            line-height: 1.5;
            color: rgba(244, 250, 252, 0.72);
            position: relative;
        }

        .admin-login__panel {
            padding: 2.4rem 2.2rem;
            display: flex;
            flex-direction: column;
        }

        .admin-login__panel-title {
            font-family: var(--display);
            font-size: 1.45rem;
            font-weight: 600;
            margin: 0 0 0.35rem;
            color: var(--ink);
        }

        .admin-login__panel-sub {
            margin: 0 0 1.35rem;
            color: var(--muted);
            font-size: 0.92rem;
            line-height: 1.5;
        }

        .admin-login__alert {
            border: 1px solid var(--warn-border);
            background: var(--warn-bg);
            color: var(--warn-text);
            border-radius: 12px;
            padding: 0.8rem 0.95rem;
            font-size: 0.86rem;
            line-height: 1.45;
            margin-bottom: 1.25rem;
            display: flex;
            gap: 0.65rem;
            align-items: flex-start;
        }

        .admin-login__alert i {
            margin-top: 0.15rem;
            flex-shrink: 0;
        }

        .admin-login__form .form-group {
            margin-bottom: 1rem;
        }

        .admin-login__form label {
            display: block;
            font-size: 0.84rem;
            font-weight: 600;
            color: var(--ink-soft);
            margin-bottom: 0.35rem;
        }

        .admin-login__form .form-control {
            height: 46px;
            border-radius: 10px;
            border: 1px solid var(--line);
            padding: 0.55rem 0.9rem;
            font-size: 0.95rem;
            transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .admin-login__form .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(14, 116, 144, 0.15);
        }

        .admin-login__input-wrap {
            position: relative;
        }

        .admin-login__input-wrap .form-control {
            padding-left: 2.55rem;
        }

        .admin-login__input-wrap--password .form-control {
            padding-right: 2.75rem;
        }

        .admin-login__input-icon {
            position: absolute;
            left: 0.95rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            pointer-events: none;
            font-size: 0.9rem;
        }

        .admin-login__toggle-password {
            position: absolute;
            right: 0.35rem;
            top: 50%;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            color: var(--muted);
            width: 2.4rem;
            height: 2.4rem;
            border-radius: 8px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .admin-login__toggle-password:hover,
        .admin-login__toggle-password:focus {
            color: var(--accent);
            outline: none;
            background: rgba(14, 116, 144, 0.08);
        }

        .admin-login__form .form-check {
            display: flex;
            align-items: center;
            padding-left: 0;
            margin-bottom: 1.1rem;
        }

        .admin-login__form .form-check-input {
            position: static;
            margin: 0 0.5rem 0 0;
        }

        .admin-login__form .form-check-label {
            margin: 0;
            font-weight: 500;
            color: var(--ink-soft);
            font-size: 0.9rem;
        }

        .admin-login__captcha-block {
            background: #f4f8fa;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 0.9rem 1rem;
            margin-bottom: 1.15rem;
        }

        .admin-login__form .captcha-container,
        .admin-login__form .recaptcha-container {
            background: transparent;
            border: 0;
            border-radius: 0;
            padding: 0;
            margin-bottom: 0 !important;
        }

        .admin-login__form .captcha-container label {
            margin-bottom: 0.5rem;
        }

        .admin-login__form .captcha-img {
            border-radius: 8px;
            border: 1px solid var(--line);
            background: #fff;
        }

        .admin-login__captcha-note {
            display: flex;
            align-items: flex-start;
            gap: 0.4rem;
            margin: 0.65rem 0 0;
            padding-top: 0.65rem;
            border-top: 1px dashed var(--line);
            font-size: 0.82rem;
            line-height: 1.45;
            color: var(--muted);
        }

        .admin-login__captcha-note i {
            margin-top: 0.15rem;
            color: var(--accent);
            flex-shrink: 0;
        }

        .admin-login__submit {
            width: 100%;
            border: 0;
            border-radius: 11px;
            background: var(--accent);
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            padding: 0.85rem 1rem;
            transition: background 0.15s ease, transform 0.15s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

        .admin-login__submit:hover,
        .admin-login__submit:focus {
            background: var(--accent-hover);
            color: #fff;
            outline: none;
            transform: translateY(-1px);
        }

        .admin-login__meta {
            margin-top: auto;
            padding-top: 1.35rem;
            display: grid;
            gap: 0.45rem;
            font-size: 0.8rem;
            color: var(--muted);
        }

        .admin-login__meta span {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
        }

        .admin-login__meta i {
            width: 1rem;
            text-align: center;
            color: var(--accent);
        }

        .admin-login__back {
            margin-top: 1rem;
            text-align: center;
        }

        .admin-login__back a {
            color: var(--accent);
            font-size: 0.88rem;
            font-weight: 500;
            text-decoration: none;
        }

        .admin-login__back a:hover {
            text-decoration: underline;
        }

        .alert-danger {
            border-radius: 12px;
            border-color: var(--danger-border);
            background: var(--danger-bg);
            font-size: 0.9rem;
        }

        .invalid-feedback,
        .field-validation-error,
        .validation-summary-errors {
            font-size: 0.82rem;
        }

        @@media (max-width: 900px) {
            .admin-login__shell {
                grid-template-columns: 1fr;
                max-width: 480px;
            }

            .admin-login__guide {
                padding: 1.75rem 1.5rem 1.4rem;
            }

            .admin-login__lead {
                max-width: none;
                margin-bottom: 1.2rem;
            }

            .admin-login__steps {
                grid-template-columns: 1fr 1fr;
                gap: 0.75rem;
            }

            .admin-login__steps li {
                grid-template-columns: 1fr;
                gap: 0.45rem;
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 12px;
                padding: 0.75rem;
            }

            .admin-login__guide-note {
                margin-top: 1.1rem;
                padding-top: 1rem;
            }

            .admin-login__panel {
                padding: 1.6rem 1.4rem 1.5rem;
            }
        }

        @@media (max-width: 520px) {
            .admin-login {
                padding: 0.75rem;
            }

            .admin-login__steps {
                grid-template-columns: 1fr;
            }

            .admin-login__brand {
                font-size: 1.55rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .admin-login__shell,
            .admin-login__steps li,
            .admin-login__submit {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="admin-login">
        <div class="admin-login__shell">
            <aside class="admin-login__guide" aria-labelledby="admin-login-brand">
                <div class="admin-login__badge">
                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                    @AdminResource.SecureAdminLogin
                </div>
                <h1 class="admin-login__brand" id="admin-login-brand">@Resource.AdminPanelLoginPage</h1>
                <p class="admin-login__lead">
                    @AdminResource.AdminLoginLead
                </p>

                <ol class="admin-login__steps">
                    <li>
                        <span class="admin-login__step-num" aria-hidden="true">1</span>
                        <div>
                            <span class="admin-login__step-title">@AdminResource.AdminCredentialsStepTitle</span>
                            <span class="admin-login__step-text">@AdminResource.AdminCredentialsStepDesc</span>
                        </div>
                    </li>
                    <li>
                        <span class="admin-login__step-num" aria-hidden="true">2</span>
                        <div>
                            <span class="admin-login__step-title">@AdminResource.SecurityVerificationStepTitle</span>
                            <span class="admin-login__step-text">@securityStepText</span>
                        </div>
                    </li>
                    <li>
                        <span class="admin-login__step-num" aria-hidden="true">3</span>
                        <div>
                            <span class="admin-login__step-title">@AdminResource.TwoFactorStepTitle</span>
                            <span class="admin-login__step-text">@AdminResource.TwoFactorStepDesc</span>
                        </div>
                    </li>
                    <li>
                        <span class="admin-login__step-num" aria-hidden="true">4</span>
                        <div>
                            <span class="admin-login__step-title">@AdminResource.AdminPanelStepTitle</span>
                            <span class="admin-login__step-text">@AdminResource.AdminPanelStepDesc</span>
                        </div>
                    </li>
                </ol>

                <p class="admin-login__guide-note">
                    <i class="fa-solid fa-lock mr-1" aria-hidden="true"></i>
                    @AdminResource.AdminLoginEncryptedNote
                </p>
            </aside>

            <section class="admin-login__panel" aria-labelledby="admin-login-form-title">
                <h2 class="admin-login__panel-title" id="admin-login-form-title">@AdminResource.SignInHeading</h2>
                <p class="admin-login__panel-sub">@AdminResource.AdminSignInSub</p>

                <div class="admin-login__alert" role="note">
                    <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                    <div>@AdminResource.JustOpenForAdmin @AdminResource.CustomerLoginHint</div>
                </div>

                @using (Html.BeginForm("AdminLogin", "Account", FormMethod.Post, new { @class = "needs-validation admin-login__form", novalidate = "novalidate", autocomplete = "on" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })

                    <div class="form-group">
                        <label for="Email">@Resource.Email</label>
                        <div class="admin-login__input-wrap">
                            <i class="fa-solid fa-envelope admin-login__input-icon" aria-hidden="true"></i>
                            @Html.TextBoxFor(m => m.Email, new
                            {
                                @class = "form-control",
                                placeholder = "admin@example.com",
                                required = "required",
                                autocomplete = "username",
                                inputmode = "email"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "invalid-feedback d-block" })
                    </div>

                    <div class="form-group">
                        <label for="Password">@Resource.Password</label>
                        <div class="admin-login__input-wrap admin-login__input-wrap--password">
                            <i class="fa-solid fa-lock admin-login__input-icon" aria-hidden="true"></i>
                            @Html.PasswordFor(m => m.Password, new
                            {
                                @class = "form-control",
                                placeholder = "••••••••",
                                required = "required",
                                autocomplete = "current-password"
                            })
                            <button type="button" class="admin-login__toggle-password" id="togglePassword" aria-label="@AdminResource.ShowPassword" title="@AdminResource.ShowPassword" data-show-title="@AdminResource.ShowPassword" data-hide-title="@AdminResource.HidePassword">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "invalid-feedback d-block" })
                    </div>

                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "rememberMe" })
                        <label class="form-check-label" for="rememberMe">@Resource.RememberMe</label>
                    </div>

                    if (CaptchaSettings.Provider != CaptchaProviderType.None)
                    {
                        <div class="admin-login__captcha-block">
                            @Html.CaptchaWidget("AdminLogin", "invalid-feedback d-block text-danger", AdminResource.EnterAnswerHere)
                            <p class="admin-login__captcha-note">
                                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
                                <span>@securityStepText</span>
                            </p>
                        </div>
                    }

                    <button type="submit" class="admin-login__submit btn">
                        <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
                        @Resource.Login
                    </button>
                }

                <div class="admin-login__meta">
                    <span>
                        <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                        @String.Format(AdminResource.EnterDateForAdmin, loginStamp)
                    </span>
                    <span>
                        <i class="fa-solid fa-network-wired" aria-hidden="true"></i>
                        @String.Format(AdminResource.IPAddressForAdmin, remoteIp)
                    </span>
                </div>

                <div class="admin-login__back">
                    <a href="@Url.Action("Index", "Home", new { area = "" })">
                        <i class="fa-solid fa-arrow-left mr-1" aria-hidden="true"></i>
                        @AdminResource.BackToSite
                    </a>
                </div>
            </section>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.min.js"></script>
    <script>
        (function () {
            'use strict';

            var email = document.getElementById('Email');
            if (email) {
                email.focus();
            }

            var toggle = document.getElementById('togglePassword');
            var password = document.getElementById('Password');
            if (toggle && password) {
                var showTitle = toggle.getAttribute('data-show-title') || 'Show password';
                var hideTitle = toggle.getAttribute('data-hide-title') || 'Hide password';
                toggle.addEventListener('click', function () {
                    var show = password.getAttribute('type') === 'password';
                    password.setAttribute('type', show ? 'text' : 'password');
                    var icon = toggle.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('fa-eye', !show);
                        icon.classList.toggle('fa-eye-slash', show);
                    }
                    toggle.setAttribute('aria-label', show ? hideTitle : showTitle);
                    toggle.setAttribute('title', show ? hideTitle : showTitle);
                });
            }

            window.addEventListener('load', function () {
                var forms = document.getElementsByClassName('needs-validation');
                Array.prototype.forEach.call(forms, function (form) {
                    form.addEventListener('submit', function (event) {
                        if (form.checkValidity() === false) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
            });
        })();
    </script>
</body>
</html>
