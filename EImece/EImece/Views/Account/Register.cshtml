@model EImece.Models.RegisterViewModel
@using Resources;
@using System.Linq;
@{
    ViewBag.Title = "Register";
}
<div class="container pb-5 mb-sm-4">
    <div class="row pt-5">
        <div class="col-md-2 pt-sm-3">
        </div>
        <div class="col-md-8 pt-5 pt-sm-3">
            <h2 class="h4 mb-1">@Resource.CustomerRegister</h2>
            <hr />
            <p class="text-muted mb-4">@Resource.RegistrationInfoText</p>
            @{
                var errorClass = ViewData.ModelState.IsValid ? "alert alert-success" : "alert alert-danger";
            }
            @Html.ValidationSummary(true, "", new { @class = errorClass })
            <p class="text-danger  mb-4">  @Resource.PasswordInfoMessage</p>
            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
            {
                @Html.Hidden("returnUrl", (string)ViewBag.ReturnUrl)

                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.ActionLink(Resource.AlreadyMembered, "Login", "Account", null, new { @class = "btn btn-pill  btn-sm btn-outline-info mb-2 mr-1" })
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.FirstName)
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.LastName, new { @class = "col-form-label" })
                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Email, new { @class = "col-form-label" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.PhoneNumber, new { @class = "col-form-label" })
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", autocomplete = "tel", placeholder = "+90 5XX XXX XX XX" })
                            <small class="form-text text-muted">@Resource.WhyNeedGsmNumber</small>
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.IdentityNumber, new { @class = "col-form-label" })
                            @Html.TextBoxFor(m => m.IdentityNumber, new { @class = "form-control", inputmode = "numeric", maxlength = "11", autocomplete = "off" })
                            <small class="form-text text-muted">@Resource.WhyNeedIdentityNumber</small>
                            @Html.ValidationMessageFor(m => m.IdentityNumber, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="hidden" id="SelectedCity" value="@Model.City" />
                            @Html.LabelFor(m => m.City, new { @class = "col-form-label" })
                            @Html.DropDownListFor(m => m.City, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Cities" })
                            @Html.ValidationMessageFor(m => m.City, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="hidden" id="SelectedTown" value="@Model.Town" />
                            @Html.LabelFor(m => m.Town, new { @class = "col-form-label" })
                            @Html.DropDownListFor(m => m.Town, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Towns" })
                            @Html.ValidationMessageFor(m => m.Town, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            <input type="hidden" id="SelectedDistrict" value="@Model.District" />
                            @Html.LabelFor(m => m.District, new { @class = "col-form-label" })
                            @Html.DropDownListFor(m => m.District, new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"), new { @class = "form-control", id = "Districts" })
                            @Html.ValidationMessageFor(m => m.District, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Street, new { @class = "col-form-label" })
                            @Html.TextBoxFor(m => m.Street, new { @class = "form-control", autocomplete = "street-address" })
                            @Html.ValidationMessageFor(m => m.Street, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.ZipCode, new { @class = "col-form-label" })
                            @Html.TextBoxFor(m => m.ZipCode, new { @class = "form-control", autocomplete = "postal-code" })
                            @Html.ValidationMessageFor(m => m.ZipCode, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Country, new { @class = "col-form-label" })
                            @Html.DropDownListFor(m => m.Country, EImece.Web.Helpers.WebGeneralHelper.GetStaticCountries(), new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Country, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Password, new { @class = "col-form-label" })
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="form-group">
                            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-form-label" })
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "alert alert-default text-danger" })
                        </div>
                    </div>

                    <div class="col-sm-12">
                        <div class="form-group">
                            @Html.CaptchaWidget("CustomerRegister", "alert alert-default text-danger")
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between">
                        <div class="custom-control custom-checkbox">
                            @Html.CheckBoxFor(m => m.IsPermissionGranted, new { @class = "custom-control-input" })
                            @Html.LabelFor(m => m.IsPermissionGranted, new { @class = "custom-control-label" })
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <input type="submit" value="@Resource.CustomerRegister" class="btn btn-block btn-outline-warning" />
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/jqueryui")

}