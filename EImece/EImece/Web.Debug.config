<?xml version="1.0"?>

  <!--
    For more information on using Web.config transformation visit http://go.microsoft.com/fwlink/?LinkId=301874
    Do not bake SQL passwords into transforms. See docs/SECURE_CONNECTION_STRINGS.md.
  -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Prefer EIMECE_DB_CONNECTION_STRING or a gitignored ConnectionStrings.config over transforms.

    <connectionStrings>
      <add name="EImeceDbConnection"
        connectionString="Data Source=localhost;Initial Catalog=EImece;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;"
        xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
    </connectionStrings>
  -->
  <appSettings>
    <add key="AdminLoginEnabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <compilation debug="true" xdt:Transform="SetAttributes" />
    <customErrors mode="Off" xdt:Transform="SetAttributes" />
  </system.web>
</configuration>