<?xml version="1.0" encoding="utf-8"?>
<!-- Keep this folder in the publish output; deny all HTTP access to log files. -->
<configuration>
  <system.web>
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <authorization>
      <deny users="*" />
    </authorization>
  </system.web>
  <system.webServer>
    <handlers>
      <clear />
      <add name="BlockLogs" path="*" verb="*" type="System.Web.HttpNotFoundHandler" resourceType="Unspecified" requireAccess="None" />
    </handlers>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
