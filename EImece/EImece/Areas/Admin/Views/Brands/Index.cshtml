@model List<Brand>
@using EImece.Domain.Entities
@using Griddly.Mvc
@using EImece.Domain.Helpers
@using Resources

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var controllerName = "brands";
}
@Html.AdminBreadcrumb(AdminResource.Brands)
<h2 class="admin-page-title">@AdminResource.Brands</h2>
<hr class="adminLine" />

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
        {"controllerName",controllerName}
        ,{"StateTypes","State,ImageState,MainPage"}
        ,{"orderingButton",true}
        ,{"selectAll",true}
        ,{"deleteAll",true}
        ,{"SetStateOnOrOff",true},{"IsExcelButtonEnabled",true}})

@Html.Partial("Grid/_GridChrome")
<div class="js-griddly-async" data-url="@Url.Action("IndexGrid", new { search = Request.QueryString["search"] })"></div>
