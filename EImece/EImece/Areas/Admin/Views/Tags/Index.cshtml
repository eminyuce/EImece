@model List<EImece.Domain.Entities.Tag>
@using Griddly.Mvc
@using Resources

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var controllerName = "Tags";
}

<h2>@AdminResource.Tag</h2>
<hr class="adminLine" />

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
    {"controllerName",controllerName},
    {"StateTypes","State"},
    {"orderingButton",true},
    {"selectAll",true},
    {"deleteAll",true},
    {"SetStateOnOrOff",true},
    {"IsExcelButtonEnabled",true}
})

@Html.Griddly("IndexGrid", new { search = Request.QueryString["search"] })
