@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using Griddly.Mvc
@using Resources

@{
    Layout = null;
    var gridName = "MenusGrid";
    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    var controllerName = "Menus";
    var menuTreeNodeList = (List<Menu>)ViewBag.MenuLeaves;

    var settings = new GriddlySettings<Menu>()
    {
        ClassName = "eg-grid eg-grid-shell",
        TableClassName = "table table-hover table-striped eg-grid-table",
        PageSize = pageSizeNumber,
        AllowedFilterModes = FilterMode.None,
        RowClass = item => item.IsActive ? string.Empty : "GridIsActive",
        DefaultSort = new[] { new SortField() { Field = "UpdatedDate", Direction = SortDirection.Descending } }
    };

    settings.HtmlAttributes["data-gridname"] = gridName;

    settings.BeforeTemplate = @<text>
        <output class="panel-heading grid-record-count" style="display:block" aria-live="polite">
            <div class="grid-record-count-inner">
                <span class="grid-record-count-badge griddly-recordtotal"></span>
                <span class="grid-record-count-label">@AdminResource.GridResultRecordNumber</span>
            </div>
            <div class="eg-grid-scroll-controls" title="Tabloyu Sağa/Sola Kaydır">
                <button type="button" class="btn btn-xs eg-scroll-nav-btn eg-scroll-nav-left" title="Sola Kaydır" aria-label="Sola Kaydır">
                    <i class="glyphicon glyphicon-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-xs eg-scroll-nav-btn eg-scroll-nav-right" title="Sağa Kaydır" aria-label="Sağa Kaydır">
                    <i class="glyphicon glyphicon-chevron-right"></i>
                </button>
            </div>
        </output>
    </text>;

    settings
        .Column(caption: "", template: @<text><span class="eg-row-index">@item.Id</span></text>, className: "eg-sticky-left eg-sticky-left-1 eg-col-index", width: "44px")
        .Column(caption: "", template: @<text><input gridkey-id="@item.Id" class="gridCheckboxes" name="checkboxGrid" type="checkbox" /></text>, className: "gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check", width: "44px")
        .Column(caption: AdminResource.Images, template: @<text>@Html.Partial("Grid/_GridImageCell", item)</text>, className: "eg-col-image", width: "80px")
        .Column(x => x.Name, caption: AdminResource.Name, template: @<text>@Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) { { "Name", item.Name }, { "ItemId", item.Id.ToString() }, { "LinkUrl", item.DetailPageLink } })</text>, className: "eg-col-name", width: "240px")
        .Column(x => x.ParentId, caption: AdminResource.ProductCategoryParentId, template: @<text>@(item.ParentId == 0 ? Resource.RootCategory : "")</text>, className: "smallGridColumn", width: "130px")
        .Column(x => x.Position, caption: AdminResource.Position, template: @<text><input gridkey-id="@item.Id" value="@item.Position" class="GridOrderingTextbox input-xs" name="gridOrdering" type="type" /></text>, className: "smallGridColumn", width: "80px")
        .Column(x => x.IsActive, caption: AdminResource.IsActive, template: @<text>@Html.Partial("Grid/_GridStatusToggles", null, new ViewDataDictionary(ViewData) { { "ItemId", item.Id }, { "IsActive", item.IsActive }, { "ShowState", true }, { "ShowImageState", false } })</text>, className: "smallGridColumn eg-col-status", width: "120px")
        .Column(x => x.UpdatedDate, caption: AdminResource.UpdatedDate, template: @<text>@(item.UpdatedDate.ToShortDateString())</text>, className: "gridDateClass", width: "130px")
        .Column(caption: "İşlemler", template: @<text>@MenuActionsCell(item, menuTreeNodeList, controllerName)</text>, className: "eg-sticky-right eg-col-actions", width: "60px");
}

@helper MenuActionsCell(Menu d, List<Menu> menuTreeNodeList, string controllerName)
{
    var isLeaf = menuTreeNodeList != null && menuTreeNodeList.Any(r => r.Id == d.Id);
    @Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
        { "ItemId", d.Id },
        { "ItemName", d.Name },
        { "controllerName", controllerName },
        { "ShowMedia", true },
        { "ShowEdit", true },
        { "ShowDelete", isLeaf }
    })
    if (UserRoleHelper.IsDeletedEnableRoles() && !isLeaf)
    {
        <span class="text-muted" title="@AdminResource.MenuCannotDeleteHasChildren" style="font-size:11px;white-space:nowrap;">
            <i class="fa fa-ban" aria-hidden="true"></i> @AdminResource.MenuCannotDeleteHasChildren
        </span>
    }
}

@Html.Griddly(settings)
