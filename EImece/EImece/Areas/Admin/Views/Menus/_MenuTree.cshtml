@using Resources
﻿@using System.Web;
@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Models.FrontModels;
@model List<MenuTreeModel>
@{
    var treeNodes = Model ?? new List<MenuTreeModel>();
    String urlPattern = ViewData["UrlPattern"].ToStr();
    String urlQuery = ViewData["UrlQuery"].ToStr();
    var selectedCategoryId = ViewData["SelectedCategoryId"].ToInt();
    var currentItemId = ViewData["CurrentItemId"].ToInt();
    var showAllLink = ViewData["ShowAllLink"].ToBool(true);
    var treeTitle = ViewData["TreeTitle"].ToStr("Menüler");
    var showPickHint = ViewData["ShowPickHint"].ToBool(false);
    string querySuffix = string.IsNullOrEmpty(urlQuery) ? "" : "?" + urlQuery;

    var viewData = new ViewDataDictionary
    {
        { "UrlPattern", urlPattern },
        { "UrlQuery", urlQuery },
        { "SelectedCategoryId", selectedCategoryId },
        { "CurrentItemId", currentItemId },
        { "IsExcelButtonEnabled", true }
    };

    string allHref = string.IsNullOrEmpty(urlPattern)
        ? "#"
        : string.Format("{0}{1}{2}", urlPattern, 0, querySuffix);
    var mobileCollapsedClass = selectedCategoryId > 0 ? "" : "is-mobile-collapsed";
    var treeToggleExpanded = selectedCategoryId > 0 ? "true" : "false";
    var treePanelId = "eg-tree-panel-" + Guid.NewGuid().ToString("N").Substring(0, 8);
}
<div class="eg-category-tree @mobileCollapsedClass" data-eg-category-tree="1" data-selected-id="@selectedCategoryId">
    <div class="eg-category-tree-head">
        <button type="button"
                class="eg-category-tree-toggle"
                aria-expanded="@treeToggleExpanded"
                aria-controls="@treePanelId"
                title="Menü listesini aç/kapat">
            <span class="eg-category-tree-title">
                <i class="fa-solid fa-rectangle-list" aria-hidden="true"></i>
                <span>@treeTitle</span>
            </span>
            <i class="fa-solid fa-chevron-down eg-category-tree-chevron" aria-hidden="true"></i>
        </button>
    </div>
    <div class="eg-category-tree-panel" id="@treePanelId">
        <div class="eg-category-tree-tools">
            <div class="eg-category-tree-search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search"
                       class="eg-tree-search"
                       placeholder="@AdminResource.Search"
                       aria-label="@AdminResource.Search"
                       autocomplete="off"
                       spellcheck="false" />
            </div>
            @if (showAllLink && !string.IsNullOrEmpty(urlPattern))
            {
                <a class="eg-category-all @(selectedCategoryId <= 0 ? "is-active" : "")" href="@allHref" title="Tüm menüler">@AdminResource.All</a>
            }
        </div>
        @if (showPickHint)
        {
            <p class="eg-category-tree-pick-hint">Seçmek için bir menüye tıklayın</p>
        }
        <p class="eg-tree-search-empty" role="status">Eşleşen kayıt yok</p>

        <ul class="treeProducts eg-tree" id="responsive">
        @foreach (MenuTreeModel p in treeNodes)
        {
            var hasChildren = p.Childrens != null && p.Childrens.Any();
            var isActive = selectedCategoryId > 0 && p.Id == selectedCategoryId;
            var isCurrent = currentItemId > 0 && p.Id == currentItemId;
            var count = CountDescendants(p);
            var name = p.Name;
            var nodeId = p.Id;
            <li class="eg-tree-node @(hasChildren ? "has-children is-open" : "is-leaf") @(isActive ? "is-active" : "") @(isCurrent ? "is-current" : "")" data-category-id="@nodeId">
                <div class="eg-tree-row">
                    @if (hasChildren)
                    {
                        <button type="button" class="eg-tree-toggle" aria-expanded="true" aria-label="Alt menüleri aç/kapat" title="Alt menüleri aç/kapat">
                            <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                        </button>
                    }
                    else
                    {
                        <span class="eg-tree-toggle eg-tree-toggle-spacer" aria-hidden="true"></span>
                    }

                    @if (String.IsNullOrEmpty(urlPattern))
                    {
                        <button type="button" class="eg-tree-link @(isActive ? "is-active" : "")"
                           @(isCurrent ? "disabled=\"disabled\" title=\"Bu kayıt üst olarak seçilemez\"" : null)
                           onclick="menuTreeClick(event,@nodeId,'@HttpUtility.JavaScriptStringEncode(name)')">
                            <span class="eg-tree-name">@name</span>
                            @if (isCurrent)
                            {
                                <span class="eg-tree-current-badge">bu kayıt</span>
                            }
                            else
                            {
                                <span class="visually-hidden">seç</span>
                            }
                            @if (count > 0)
                            {
                                <span class="eg-tree-count">@count</span>
                            }
                        </button>
                    }
                    else
                    {
                        <a class="eg-tree-link @(isActive ? "is-active" : "")"
                           href="@String.Format("{0}{1}{2}", urlPattern, nodeId, querySuffix)">
                            <span class="eg-tree-name">@name</span>
                            @if (count > 0)
                            {
                                <span class="eg-tree-count">@count</span>
                            }
                        </a>
                    }
                </div>

                @if (hasChildren)
                {
                    @Html.Partial("_MenuTreeChildren", p.Childrens, viewData)
                }
            </li>
        }
        </ul>
    </div>
</div>

@functions {
    private static int CountDescendants(MenuTreeModel node)
    {
        if (node == null || node.Childrens == null || !node.Childrens.Any())
        {
            return 0;
        }
        var count = node.Childrens.Count;
        foreach (var child in node.Childrens)
        {
            count += CountDescendants(child);
        }
        return count;
    }
}
