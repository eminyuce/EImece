@model EImece.Domain.Entities.Menu
@using EImece.Domain.Entities;
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Models.FrontModels;
@using Resources;
@{
    ViewBag.Title = "SaveOrEdit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var parentMenu = (Menu)ViewBag.ParentMenu;
    var ExistingMainImageText = AdminResource.ExistingMainImageText;
    var saveButtonText = AdminResource.SaveButtonText;
    var menuLinks = (List<SelectListItem>)ViewBag.MenuLinks;
    var PleaseSelectYourMenuCategoryFromTree = AdminResource.PleaseSelectYourMenuCategoryFromTree;
    var saveButtonAndCloseText = AdminResource.SaveButtonAndCloseText;
    List<MenuTreeModel> MenuTree = ViewBag.MenuTree;
    var controllerName = "Menus";
}

<h2>@AdminResource.Menu</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "menusHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada site <strong>menü / sayfa</strong> öğesi oluşturur veya düzenlersiniz.</li>
    <li>Soldaki ağaçtan <strong>üst menüyü</strong> seçin. Ana seviye için üst menü seçmeyin (veya kök bırakın).</li>
    <li><strong>Menü linki</strong> (yeni kayıtta): Hazır sayfa seçeneklerinden birini seçebilirsiniz.</li>
    <li><strong>Özel link</strong>: Harici veya özel bir URL yazmak için Link alanını kullanın; gerekirse “Link aktif” işaretleyin.</li>
    <li><strong>Sayfa teması</strong>: İçerik sayfasının görünümünü belirler (varsa).</li>
    <li><strong>Ana sayfa / Yayında</strong>: Menünün sitede görünmesini ve ana sayfada öne çıkmasını kontrol eder.</li>
</ul>
<p style="margin-top: 12px; margin-bottom: 0;"><strong>Örnek:</strong> Üst menü “Kurumsal” seç → İsim “Hakkımızda” → Menü linki “Hakkımızda” → Kaydet.</p>
@Html.Partial("_AdminHelpAccordionEnd")

<div class="row">

    <div class="col-md-3 eg-products-tree-col">
        @if (MenuTree != null)
        {
            @Html.Partial("_MenuTree", MenuTree, new ViewDataDictionary(ViewData){
                        {"UrlPattern",""}
                      ,{"SelectedCategoryId", Model != null ? Model.ParentId : 0}
                      ,{"CurrentItemId", Model != null ? Model.Id : 0}
                      ,{"ShowAllLink", false}
                      ,{"ShowPickHint", true}
                      ,{"TreeTitle", "Menüler"}
                      ,{"IsExcelButtonEnabled",true}})
        }
    </div>
    <div class="col-md-9 eg-products-main-col">
        <input id="errorMessageForSameSelection" type="hidden" value="@AdminResource.MenuSameSelectionErrorMessage" />
        @using (Html.BeginForm("SaveOrEdit", "Menus", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">

            @Html.AdminValidationSummary()
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.AddUserId)
            @Html.HiddenFor(model => model.CreatedDate)
            @Html.HiddenFor(model => model.UpdatedDate)

            @Html.HiddenFor(model => model.Lang)

            <div class="card admin-edit-form">
                @Html.Partial("_AdminEditFormToolbar")
                <div class="card-body">
                    <div class="tab-content">
                        <div id="admin-edit-tab-fields" class="tab-pane fade show active" role="tabpanel">
<div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.ParentId, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.HiddenFor(model => model.ParentId)
                                    @Html.Partial("_AdminTreePicker", null, new ViewDataDictionary(ViewData) {
                                        { "Mode", "parent" },
                                        { "NameId", "ParentName" },
                                        { "HiddenId", "ParentId" },
                                        { "SelectedId", Model.ParentId },
                                        { "SelectedName", parentMenu != null ? parentMenu.Name : "" },
                                        { "ShowRootButton", true },
                                        { "RootText", "Ana menü" },
                                        { "Hint", "Soldaki ağaçtan bir menüye tıklayın; bu kayıt onun altına yerleşir." }
                                    })
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.Name, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.MetaKeywords, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.TextAreaFor(model => model.MetaKeywords, 2, 20, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.MetaKeywords, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.Position, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Position, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Position, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                <div class="col-md-3">
                                </div>
                                <div class="col-md-3">
                                    @Html.AdminLabelFor(model => model.IsActive)
                                    @Html.EditorFor(model => model.IsActive)
                                    @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-3">
                                    @Html.AdminLabelFor(model => model.MainPage)
                                    @Html.EditorFor(model => model.MainPage)
                                    @Html.ValidationMessageFor(model => model.MainPage, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            @if (Model.Id == 0)
                        {
                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.MenuLink, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(model => model.MenuLink, menuLinks, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.MenuLink, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        }
                        else
                        {
                            @Html.HiddenFor(model => model.MenuLink)
                        }

                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.MainImageId, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-3">
                                    <input type="file" name="postedImage" />
                                    @Html.ValidationMessageFor(model => model.MainImageId, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-3">
                                    @Html.AdminLabelFor(model => model.ImageState)
                                    @Html.EditorFor(model => model.ImageState)
                                    @Html.ValidationMessageFor(model => model.ImageState, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-3">
                                    @Html.Partial("pGridImageMainPage", (BaseContent)Model)


                                </div>
                            </div>
                            @Html.Partial("pSliderResizing", (BaseContent)Model)

                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.Link, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Link, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Link, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                <div class="col-md-3">
                                </div>
                                <div class="col-md-3">
                                    @Html.AdminLabelFor(model => model.LinkIsActive)
                                    @Html.EditorFor(model => model.LinkIsActive)
                                    @Html.ValidationMessageFor(model => model.LinkIsActive, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div id="pageThemeWrapper" style="@String.Format("{0}", (Model.Id>0 && Model.MenuLink.Equals("pages-index") ) ? "" : "display: none;")" class="form-group row mb-3 page-theme-form-group row mb-3">
                                <div class="col-md-12">
                                    <div class="page-theme-section">
                                        <div class="page-theme-section__head">
                                            @Html.AdminLabelFor(model => model.PageTheme, htmlAttributes: new { @class = "col-form-label page-theme-section__label" })
                                            <p class="page-theme-section__hint">Sayfa içeriğinin yerleşimini seçin. Karta tıklayarak uygulayın; büyüteç ile yerleşimi büyütün.</p>
                                        </div>
                                        @Html.Partial("pPageThemes", Model)
                                        @Html.ValidationMessageFor(model => model.PageTheme, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            @Html.Partial("_AdminEditNextStep")
                        </div>
                        <div id="admin-edit-tab-content" class="tab-pane fade" role="tabpanel">
                            @Html.Partial("_AdminEditBackToFields")
<div class="form-group row mb-3">
                                <div class="col-md-12">
                                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control eimece-rich-text-editor" })
                                </div>
                            

                    </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        }
    </div>
    @Html.Partial("_AdminEditBackToList")
    <div class="row">
        <div class="col-md-12">
            @GridToolsDeleteColumn(Model, controllerName)
        </div>
    </div>
</div>

@helper GridToolsDeleteColumn(Menu d, String controllerName)
{
if (!EImece.Domain.Helpers.UserRoleHelper.IsDeletedEnableRoles()) { return; }
    if (d.Id > 0)
    {
@Html.Partial("pDeleteModal", new ViewDataDictionary(ViewData) {
           { "ItemId", d.Id },
           {"controllerName",controllerName},
            {"gridDeleteText",string.Format("'{0}' menusu silmek istiyorum",d.Name)},
           { "ItemDescription", d.Name }
     });
    }

}
@Html.Partial("_AuditFields", Model)

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        function menuTreeClick(e, id, name) {
            if (e && e.preventDefault) { e.preventDefault(); }
            if (typeof adminTreePick === "function") {
                adminTreePick(id, name, $("#ParentId"), $("#errorMessageForSameSelection").val());
            }
        }

        $(document).ready(function () {
            setPreSelectedTreeNode($("#ParentId"));
            $("#MenuLink").change(menuChangeEvent);
            function menuChangeEvent() {
                var selectedValue = $("#MenuLink option:selected").val();
                if (selectedValue == 'pages-index') {
                    $("#pageThemeWrapper").show();
                } else {
                    $("#pageThemeWrapper").hide();
                }
            }

            var $picker = $("#SayfaDuzenleri");
            $picker.on("change", ".page-theme-card__input", function () {
                $picker.find(".page-theme-card").removeClass("is-selected");
                $(this).closest(".page-theme-card").addClass("is-selected");
            });

            var $lightbox = $("#pageThemeLightbox");
            var $lightboxImg = $lightbox.find("img");
            var $lightboxTitle = $("#pageThemeLightboxTitle");
            function closeThemeLightbox() {
                $lightbox.attr("hidden", "hidden");
                $lightboxImg.attr("src", "");
            }
            $picker.on("click", ".page-theme-card__zoom", function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $btn = $(this);
                $lightboxTitle.text($btn.data("title") || "");
                $lightboxImg.attr("src", $btn.data("preview"));
                $lightboxImg.attr("alt", ($btn.data("title") || "") + " önizleme");
                $lightbox.removeAttr("hidden");
            });
            $lightbox.on("click", ".page-theme-lightbox__backdrop, .page-theme-lightbox__close", closeThemeLightbox);
            $(document).on("keydown.pageThemeLightbox", function (e) {
                if (e.key === "Escape" && !$lightbox.is("[hidden]")) {
                    closeThemeLightbox();
                }
            });

        });
    </script>
}