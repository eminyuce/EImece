@using System.Web;
@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Models.FrontModels;

@model List<MenuTreeModel>
@{
    var menuNodes = Model ?? new List<MenuTreeModel>();
    String urlPattern = ViewData["UrlPattern"].ToStr();
    String urlQuery = ViewData["UrlQuery"].ToStr();
    var selectedCategoryId = ViewData["SelectedCategoryId"].ToInt();
    string querySuffix = string.IsNullOrEmpty(urlQuery) ? "" : "?" + urlQuery;
    var viewData = new ViewDataDictionary
    {
        { "UrlPattern", urlPattern },
        { "UrlQuery", urlQuery },
        { "SelectedCategoryId", selectedCategoryId },
        { "IsExcelButtonEnabled", true }
    };
}

<ul class="eg-tree-children">
    @foreach (var p in menuNodes)
    {
        var hasChildren = p.Childrens != null && p.Childrens.Any();
        var isActive = selectedCategoryId > 0 && p.Id == selectedCategoryId;
        var count = CountDescendants(p);
        var name = p.Name;
        var nodeId = p.Id;
        <li class="eg-tree-node @(hasChildren ? "has-children is-open" : "is-leaf") @(isActive ? "is-active" : "")" data-category-id="@nodeId">
            <div class="eg-tree-row">
                @if (hasChildren)
                {
                    <button type="button" class="eg-tree-toggle" aria-expanded="true" aria-label="Alt menüleri aç/kapat" title="Alt menüleri aç/kapat">
                        <i class="glyphicon glyphicon-chevron-down" aria-hidden="true"></i>
                    </button>
                }
                else
                {
                    <span class="eg-tree-toggle eg-tree-toggle-spacer" aria-hidden="true"></span>
                }

                @if (String.IsNullOrEmpty(urlPattern))
                {
                    <button type="button" class="eg-tree-link @(isActive ? "is-active" : "")"
                       onclick="menuTreeClick(event,@nodeId,'@HttpUtility.JavaScriptStringEncode(name)')">
                        <span class="eg-tree-name">@name</span>
                        <span class="sr-only">seç</span>
                        @if (count > 0)
                        {
                            <span class="eg-tree-count">@count</span>
                        }
                    </button>
                }
                else
                {
                    <a class="eg-tree-link @(isActive ? "is-active" : "")"
                       href="@String.Format("{0}{1}{2}", urlPattern, nodeId, querySuffix)">
                        <span class="eg-tree-name">@name</span>
                        @if (count > 0)
                        {
                            <span class="eg-tree-count">@count</span>
                        }
                    </a>
                }
            </div>

            @if (hasChildren)
            {
                @Html.Partial("_MenuTreeChildren", p.Childrens, viewData)
            }
        </li>
    }
</ul>

@functions {
    private static int CountDescendants(MenuTreeModel node)
    {
        if (node == null || node.Childrens == null || !node.Childrens.Any())
        {
            return 0;
        }
        var count = node.Childrens.Count;
        foreach (var child in node.Childrens)
        {
            count += CountDescendants(child);
        }
        return count;
    }
}
