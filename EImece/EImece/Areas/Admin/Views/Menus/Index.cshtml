@model List<Menu>
@using EImece.Domain.Helpers;
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain;
@using EImece.Domain.Entities;
@using Resources;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Models.FrontModels;
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : AppConfig.GridPageSizeNumber * (gridPage - 1);

    var controllerName = "Menus";
    var gridName = "MenusGrid";
    List<Menu> contents = Model;
    var baseList = contents.DownCasting<Menu>();

    var menuTreeNodeList = (List<Menu>)ViewBag.MenuLeaves;
    List<MenuTreeModel> MenuTree = ViewBag.MenuTree;
}

<h2 class="admin-page-title">@AdminResource.Menu</h2>
<hr class="adminLine" />
<div class="row eg-products-layout">
    <div class="col-md-3 eg-products-tree-col">
        @if (MenuTree != null)
        {
            @Html.Partial("_MenuTree", MenuTree, new ViewDataDictionary(ViewData){
                               {"UrlPattern","/admin/menus/saveoredit/"}
                             ,{"ShowAllLink", true}
                             ,{"TreeTitle", "Menüler"}
                             ,{"IsExcelButtonEnabled",true}})
        }

        <span id="treeClickContainer"></span>
    </div>
    <div class="col-md-9 eg-products-main-col">

        @Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
            {"controllerName",controllerName}
            ,{"StateTypes","State,ImageState"}
           ,{"orderingButton",true}
           ,{"selectAll",true}
           ,{"deleteAll",true}
            ,{"SetStateOnOrOff",true},{"IsExcelButtonEnabled",true}})

        <div class="eg-products-toolbar-gap">
            <a class="eg-admin-move-link eg-products-move-link" href="@Url.Action("MoveMenuCategory")">
                <i class="glyphicon glyphicon-transfer" aria-hidden="true"></i>
                <span>@AdminResource.MoveProductMenu</span>
            </a>
        </div>

        @Html.Partial("Grid/_GridChrome")

        <div class="panel panel-primary eg-grid-shell">

            @Html.Partial("pGridDropDown", baseList)
            @Html.Grid(contents).Named(gridName).Columns(columns =>
       {

           columns.Add()
.Encoded(false)
.Sanitized(false)
.Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
.RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

           columns.Add(o => o.Id, true);

           columns.Add()
                          .Encoded(false)
                          .Sanitized(false)
                           .Css("gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check")
                          .RenderValueAs(d => Html.Partial("pGridCheckbox", new ViewDataDictionary(ViewData){
            {"ItemId",d.Id}}));

           columns.Add()
              .Titled(AdminResource.Images)
              .Encoded(false)
              .Sanitized(false)
              .Css("eg-col-image")
              .RenderValueAs(o => Html.Partial("Grid/_GridImageCell", o));

           columns.Add(c => c.Name)
                            .Titled(AdminResource.Name)
                           .Filterable(true)
                            .Encoded(false)
                             .Sanitized(false)
                             .Css("eg-col-name")
                       .RenderValueAs(d => Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) {
                           { "Name", d.Name },
                           { "ItemId", d.Id.ToString() },
                           { "LinkUrl", d.DetailPageLink }
                       }));

           columns.Add(c => c.ParentId)
.Titled(AdminResource.ProductCategoryParentId)
.Encoded(false)
.Filterable(true)
.RenderValueAs(o => o.ParentId == 0 ? string.Format("{0}", Resource.RootCategory) : "");

           columns.Add(o => o.Position).Titled(AdminResource.Position)
              .Encoded(false).
                   Sanitized(false).
                   Css("smallGridColumn").
                   RenderValueAs(o => String.Format("<input   gridkey-id='{0}' value='{1}'   class='GridOrderingTextbox input-xs' name='gridOrdering' type='type'>", o.Id, o.Position));

           columns.Add(o => o.IsActive)
                      .Titled(AdminResource.IsActive)
                  .Sortable(true)
                  .Css("smallGridColumn eg-col-status")
                  .SortInitialDirection(GridSortDirection.Descending).Encoded(false).
                   Sanitized(false)
                  .RenderValueAs(o => Html.Partial("Grid/_GridStatusToggles", null, new ViewDataDictionary(ViewData) {
                      { "ItemId", o.Id },
                      { "IsActive", o.IsActive },
                      { "ShowState", true },
                      { "ShowImageState", false }
                  }));

           columns.Add(o => o.UpdatedDate)
                      .Titled(AdminResource.UpdatedDate)
                  .Sortable(true)
                  .Css("gridDateClass")
                  .RenderValueAs(o => o.UpdatedDate != null ? String.Format("{0}", o.UpdatedDate.ToShortDateString()) : null)
                  .SortInitialDirection(GridSortDirection.Descending);

           columns.Add()
           .Titled("İşlemler")
           .Encoded(false)
           .Sanitized(false)
           .Css("eg-sticky-right eg-col-actions")
           .RenderValueAs(d => MenuActionsCell(d, menuTreeNodeList, controllerName));

       }).SetRowCssClasses(item => item.IsActive ? string.Empty : "GridIsActive").WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
        </div>
    </div>
</div>

@helper MenuActionsCell(Menu d, List<Menu> menuTreeNodeList, string controllerName)
{
    var isLeaf = menuTreeNodeList != null && menuTreeNodeList.Any(r => r.Id == d.Id);
    @Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
        { "ItemId", d.Id },
        { "ItemName", d.Name },
        { "controllerName", controllerName },
        { "ShowMedia", true },
        { "ShowEdit", true },
        { "ShowDelete", isLeaf }
    })
    if (UserRoleHelper.IsDeletedEnableRoles() && !isLeaf)
    {
        <span class="text-muted" title="@AdminResource.MenuCannotDeleteHasChildren" style="font-size:11px;white-space:nowrap;">
            <i class="fa fa-ban" aria-hidden="true"></i> @AdminResource.MenuCannotDeleteHasChildren
        </span>
    }
}
