@using EImece.Models;
@using EImece.Domain;
@model SelectUserRolesViewModel
@using Resources;
@{
    ViewBag.Title = AdminResource.Roles;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var fullName = string.Format("{0} {1}", Model.FirstName, Model.LastName).Trim();
    if (string.IsNullOrEmpty(fullName))
    {
        fullName = Model.UserName;
    }

    var selectedCount = Model.Roles != null ? Model.Roles.Count(r => r.Selected) : 0;
}

<h2>@AdminResource.Users</h2>
<hr class="adminLine" />

<div class="user-roles-page">
    <div class="row">
        <div class="col-md-10 col-md-offset-1">
            <div class="panel panel-primary user-roles-panel">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="fa fa-shield" aria-hidden="true"></i>
                        @AdminResource.Roles
                    </h3>
                </div>
                <div class="panel-body">
                    <div class="user-roles-user">
                        <div class="user-roles-avatar" aria-hidden="true">
                            <i class="fa fa-user"></i>
                        </div>
                        <div class="user-roles-user-meta">
                            <div class="user-roles-user-name">@fullName</div>
                            <div class="user-roles-user-email">
                                <i class="fa fa-envelope-o" aria-hidden="true"></i>
                                @Model.UserName
                            </div>
                            <div class="user-roles-user-status">
                                <span class="label @(selectedCount > 0 ? "label-success" : "label-default")">
                                    @selectedCount yetki secili
                                </span>
                            </div>
                        </div>
                        <div class="user-roles-user-actions">
                            @Html.ActionLink(AdminResource.Edit, "Edit", "Users", new { id = Model.Id }, new { @class = "btn btn-default btn-sm" })
                            @Html.ActionLink(AdminResource.NewPassword, "GenerateNewPassword", "Users", new { id = Model.Id }, new { @class = "btn btn-info btn-sm" })
                        </div>
                    </div>

                    <div class="alert alert-info user-roles-alert" role="alert">
                        <i class="fa fa-info-circle" aria-hidden="true"></i>
                        <strong>@AdminResource.SelectRoleAssignments</strong>
                        Kartlara tiklayarak yetkileri acip kapatabilirsiniz. Degisiklikleri kaydetmeyi unutmayin.
                    </div>

                    @using (Html.BeginForm("UserRoles", "Users", FormMethod.Post, new { @class = "user-roles-form", id = "userRolesForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                        @Html.HiddenFor(model => model.Id)
                        @Html.HiddenFor(model => model.UserName)
                        @Html.HiddenFor(model => model.FirstName)
                        @Html.HiddenFor(model => model.LastName)

                        <div class="user-roles-list" role="group" aria-label="@AdminResource.Roles">
                            @Html.EditorFor(model => model.Roles)
                        </div>

                        <div class="user-roles-actions">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fa fa-check" aria-hidden="true"></i>
                                @AdminResource.SaveButtonText
                            </button>
                            @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-default btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    (function () {
        var form = document.getElementById("userRolesForm");
        if (!form) {
            return;
        }

        var statusLabel = document.querySelector(".user-roles-user-status .label");

        function refreshRoleCards() {
            var selectedCount = 0;
            var cards = form.querySelectorAll(".user-role-card");
            for (var i = 0; i < cards.length; i++) {
                var card = cards[i];
                var checkbox = card.querySelector(".user-role-checkbox");
                var selected = checkbox && checkbox.checked;
                if (selected) {
                    selectedCount++;
                    card.classList.add("is-selected");
                } else {
                    card.classList.remove("is-selected");
                }
            }

            if (statusLabel) {
                statusLabel.textContent = selectedCount + " yetki secili";
                statusLabel.className = "label " + (selectedCount > 0 ? "label-success" : "label-default");
            }
        }

        form.addEventListener("change", function (event) {
            if (event.target && event.target.classList.contains("user-role-checkbox")) {
                refreshRoleCards();
            }
        });

        refreshRoleCards();
    })();
</script>
