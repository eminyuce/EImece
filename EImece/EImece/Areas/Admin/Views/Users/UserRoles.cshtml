@using EImece.Models;
@using EImece.Domain;
@model SelectUserRolesViewModel
@using Resources;
@{
    ViewBag.Title = AdminResource.Roles;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var fullName = string.Format("{0} {1}", Model.FirstName, Model.LastName).Trim();
    if (string.IsNullOrEmpty(fullName))
    {
        fullName = Model.UserName;
    }

    var selectedCount = Model.Roles != null ? Model.Roles.Count(r => r.Selected) : 0;
}

<div class="row justify-content-center">
    <div class="col-lg-8 mx-auto">
        <h2 class="admin-page-title">@AdminResource.Roles</h2>
        <p class="text-muted mb-4">@AdminResource.UserRolesHelpLead</p>
        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title mb-0">
                    <i class="fa fa-shield me-1" aria-hidden="true"></i>
                    @AdminResource.Roles
                </h3>
            </div>
            @using (Html.BeginForm("UserRoles", "Users", FormMethod.Post, new { @class = "user-roles-form", id = "userRolesForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.UserName)
                @Html.HiddenFor(model => model.FirstName)
                @Html.HiddenFor(model => model.LastName)
                <div class="card-body">
                    <div class="user-roles-user">
                        <div class="user-roles-avatar" aria-hidden="true">
                            <i class="fa fa-user"></i>
                        </div>
                        <div class="user-roles-user-meta">
                            <div class="user-roles-user-name">@fullName</div>
                            <div class="user-roles-user-email">
                                <i class="fa fa-envelope-o" aria-hidden="true"></i>
                                @Model.UserName
                            </div>
                            <div class="user-roles-user-status mt-2">
                                <span class="badge @(selectedCount > 0 ? "text-bg-primary" : "text-bg-secondary")">
                                    @selectedCount @AdminResource.PermissionsSelected
                                </span>
                            </div>
                        </div>
                        <div class="user-roles-user-actions">
                            @Html.ActionLink(AdminResource.Edit, "Edit", "Users", new { id = Model.Id }, new { @class = "btn btn-outline-secondary btn-sm" })
                            @Html.ActionLink(AdminResource.NewPassword, "GenerateNewPassword", "Users", new { id = Model.Id }, new { @class = "btn btn-outline-primary btn-sm" })
                        </div>
                    </div>

                    <div class="alert alert-info" role="alert">
                        <i class="fa fa-info-circle me-1" aria-hidden="true"></i>
                        <strong>@AdminResource.SelectRoleAssignments</strong>
                        @AdminResource.TogglePermissionsByRoles
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="user-roles-list" role="group" aria-label="@AdminResource.Roles">
                        @Html.EditorFor(model => model.Roles)
                    </div>
                </div>
                <div class="card-footer bg-light d-flex flex-wrap gap-2 justify-content-end">
                    @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-secondary" })
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-check me-1" aria-hidden="true"></i>
                        @AdminResource.SaveButtonText
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">
    (function () {
        var form = document.getElementById("userRolesForm");
        if (!form) {
            return;
        }

        var statusLabel = document.querySelector(".user-roles-user-status .badge");

        function refreshRoleChecks() {
            var selectedCount = 0;
            var checks = form.querySelectorAll(".form-check-input[type='checkbox']");
            for (var i = 0; i < checks.length; i++) {
                if (checks[i].checked) {
                    selectedCount++;
                }
            }

            if (statusLabel) {
                statusLabel.textContent = selectedCount + " @AdminResource.PermissionsSelected";
                statusLabel.className = "badge " + (selectedCount > 0 ? "text-bg-primary" : "text-bg-secondary");
            }
        }

        form.addEventListener("change", function (event) {
            if (event.target && event.target.classList.contains("form-check-input")) {
                refreshRoleChecks();
            }
        });

        refreshRoleChecks();
    })();
</script>
