@model EImece.Models.EnableAuthenticatorViewModel
@using Resources;
@{
    ViewBag.Title = "@AdminResource.EnableAuthenticator";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7 mx-auto">
        <h2 class="admin-page-title">@ViewBag.Title</h2>
        <p class="text-muted mb-4">@AdminResource.EnableAuthenticatorLead</p>
        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title mb-0">
                    <i class="fa fa-qrcode me-1" aria-hidden="true"></i>
                    @AdminResource.SetupAuthenticatorApp
                </h3>
            </div>
            @using (Html.BeginForm("EnableAuthenticator", "Users", FormMethod.Post, new { @class = "enable-authenticator-form", role = "form", id = "enableAuthenticatorForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="card-body text-center">
                    @if (TempData["StatusMessage"] != null)
                    {
                        <div class="alert alert-warning text-start" role="alert">@TempData["StatusMessage"]</div>
                    }

                    <div class="alert alert-info text-start" role="alert">
                        <div class="fw-semibold mb-1">
                            <i class="fa fa-info-circle me-1" aria-hidden="true"></i>
                            Yardım
                        </div>
                        <ul class="mb-0 ps-3">
                            <li>@AdminResource.InstallAuthenticatorStep1</li>
                            <li>@AdminResource.InstallAuthenticatorStep2</li>
                            <li>@AdminResource.InstallAuthenticatorStep3</li>
                            <li>@AdminResource.InstallAuthenticatorStep4</li>
                        </ul>
                    </div>

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger text-start" })

                    <p class="mb-2">@AdminResource.ScanQrCodePrompt</p>
                    <p class="text-muted">
                        @AdminResource.DisplayNameInApp <strong>@Model.DisplayName</strong>
                    </p>

                    @if (!string.IsNullOrEmpty(Model.QrCodeImage))
                    {
                        <div class="d-inline-block p-3 bg-white border rounded mb-3">
                            <img src="data:image/png;base64,@Model.QrCodeImage" alt="QR Code" width="220" height="220" />
                        </div>
                    }

                    <p class="mb-4">
                        @AdminResource.EnterKeyManuallyPrompt<br />
                        <strong class="d-inline-block mt-1" style="font-size: 1.15rem; letter-spacing: 1px;">@Model.SharedKey</strong>
                    </p>

                    <hr class="my-4" />

                    <div class="mb-0">
                        <label for="Code" class="form-label fw-semibold">@AdminResource.VerificationCode6Digits</label>
                        @Html.TextBoxFor(m => m.Code, new
                        {
                            @class = "form-control form-control-lg text-center mx-auto",
                            maxlength = "6",
                            autocomplete = "one-time-code",
                            autofocus = "autofocus",
                            required = "required",
                            style = "max-width: 220px; letter-spacing: 4px; font-size: 1.4rem;"
                        })
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger d-block" })
                    </div>
                </div>
            }
            <div class="card-footer bg-light d-flex flex-wrap gap-2 justify-content-end">
                @using (Html.BeginForm("LogOff", "Dashboard", FormMethod.Post, new { @class = "d-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-secondary">
                        <i class="fa fa-sign-out me-1" aria-hidden="true"></i>
                        @AdminResource.Logout
                    </button>
                }
                <button type="submit" form="enableAuthenticatorForm" class="btn btn-primary">
                    <i class="fa fa-check me-1" aria-hidden="true"></i>
                    @AdminResource.Activate
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
