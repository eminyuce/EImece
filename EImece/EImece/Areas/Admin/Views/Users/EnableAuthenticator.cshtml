@model EImece.Models.EnableAuthenticatorViewModel
@using Resources
@{
    ViewBag.Title = "Authenticator etkinleştir";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>
<hr class="adminLine" />

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-warning">@TempData["StatusMessage"]</div>
}

@{ ViewData["HelpId"] = "enableAuthenticatorHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Google Authenticator veya Microsoft Authenticator uygulamasını telefonunuza yükleyin.</li>
    <li>Aşağıdaki QR kodu tarayın (veya manuel anahtarı girin).</li>
    <li>Uygulamadaki 6 haneli kodu girerek etkinleştirmeyi tamamlayın.</li>
    <li>Bundan sonra yönetici girişi şifreden sonra bu kodu isteyecektir.</li>
</ul>
@Html.Partial("_AdminHelpAccordionEnd")

<div class="row">
    <div class="col-md-8 col-md-offset-2">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">Authenticator uygulamasını kurun</h3>
            </div>
            <div class="panel-body text-center" style="padding: 30px;">
                <p>Google Authenticator veya Microsoft Authenticator ile aşağıdaki QR kodu tarayın:</p>
                <p class="text-muted">
                    Uygulamada görünecek ad: <strong>@Model.DisplayName</strong>
                </p>

                @if (!string.IsNullOrEmpty(Model.QrCodeImage))
                {
                    <img src="data:image/png;base64,@Model.QrCodeImage" alt="QR Code" style="width:220px;height:220px;" />
                }

                <p class="mt-3" style="margin-top: 20px;">
                    QR kodu tarayamıyorsanız manuel olarak bu anahtarı girin:<br />
                    <strong style="font-size: 1.2em; letter-spacing: 1px;">@Model.SharedKey</strong>
                </p>

                <hr />

                @using (Html.BeginForm("EnableAuthenticator", "Users", FormMethod.Post, new { @class = "form-horizontal", role = "form", area = "admin" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="form-group">
                        <label>Doğrulama kodu (6 haneli)</label>
                        @Html.TextBoxFor(m => m.Code, new
                        {
                            @class = "form-control",
                            maxlength = "6",
                            autocomplete = "one-time-code",
                            autofocus = "autofocus",
                            required = "required",
                            style = "max-width: 220px; margin: 0 auto; text-align: center; letter-spacing: 4px; font-size: 1.4rem;"
                        })
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group" style="margin-top: 20px;">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="glyphicon glyphicon-ok"></i> Etkinleştir
                        </button>
                    </div>
                }

                @using (Html.BeginForm("LogOff", "Dashboard", FormMethod.Post, new { area = "admin", style = "display:inline-block; margin-top: 10px;" }))
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-default btn-lg">
                        <i class="glyphicon glyphicon-log-out"></i> @AdminResource.Logout
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
