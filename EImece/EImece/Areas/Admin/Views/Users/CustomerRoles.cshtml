@using EImece.Models;
@model List<EditUserViewModel>
@using EImece.Domain.Helpers;
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain;
@using Resources;
@using EImece.Domain.Helpers.Extensions;
@{
    ViewBag.Title = AdminResource.Customers;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = Request.QueryString["GridPageSize"].ToInt();
    pageSizeNumber = pageSizeNumber == 0 ? AppConfig.GridPageSizeNumber : pageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : pageSizeNumber * (gridPage - 1);

    var controllerName = "Users";
    var gridName = "UsersGrid";
    var contents = Model ?? new List<EditUserViewModel>();
    var search = Request.QueryString["search"].ToStr();
}

<div class="users-admin-page customers-admin-page">
    <div class="users-admin-header">
        <div class="users-admin-header-main">
            <h2 class="admin-page-title">@AdminResource.Customers</h2>
            <p class="users-admin-lead">
                Sitede hesabı olan müşteri kullanıcılarını arayın, seçin ve toplu olarak silebilirsiniz.
            </p>
        </div>
        <div class="users-admin-header-actions">
            <a href="@Url.Action("Index", controllerName)" class="btn btn-default btn-sm">
                <i class="glyphicon glyphicon-arrow-left" aria-hidden="true"></i>
                @AdminResource.Users
            </a>
        </div>
    </div>
    <hr class="adminLine" />

    @Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
        {"controllerName", controllerName},
        {"selectAll", true},
        {"deleteAll", true},
        {"SetStateOnOrOff", false},
        {"orderingButton", false},
        {"IsNewRecordButtonEnabled", false},
        {"IsSearchFormEnabled", true},
        {"IsExcelButtonEnabled", false}
    })

    @Html.Partial("Grid/_GridChrome")

    <div class="panel panel-primary eg-grid-shell">
        @Html.Partial("pGridDropDown", contents)
        @Html.Grid(contents).Named(gridName).Columns(columns =>
        {
            columns.Add()
                .Titled("#")
                .Encoded(false)
                .Sanitized(false)
                .Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
                .RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

            columns.Add()
                .Encoded(false)
                .Sanitized(false)
                .Css("gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check")
                .RenderValueAs(d => Html.Partial("pGridCheckbox", new ViewDataDictionary(ViewData){
                    {"ItemId", d.Id}
                }));

            columns.Add(c => c.Email)
                .Titled(AdminResource.Email)
                .Filterable(true)
                .Encoded(false)
                .Sanitized(false)
                .Css("eg-col-name")
                .RenderValueAs(o => Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) {
                    { "Name", o.Email },
                    { "Subtitle", String.Format("{0} {1}", o.FirstName, o.LastName) }
                }));

            columns.Add(o => o.FirstName)
                .Encoded(false)
                .Titled(AdminResource.Name)
                .Filterable(true)
                .RenderValueAs(o => String.Format("{0} {1}", o.FirstName, o.LastName));

            columns.Add(o => o.DetailNote)
                .Titled(AdminResource.Note)
                .Encoded(false)
                .Sanitized(false)
                .Css("eg-col-note")
                .RenderValueAs(o => String.Format(
                    "<label class='sr-only' for='role-note-{0}'>Not</label><textarea id='role-note-{0}' readonly class='eg-grid-note'>{1}</textarea>",
                    o.Id,
                    System.Web.HttpUtility.HtmlEncode(o.DetailNote ?? string.Empty)));

            columns.Add()
                .Titled("İşlemler")
                .Encoded(false)
                .Sanitized(false)
                .Css("eg-sticky-right eg-col-actions")
                .RenderValueAs(d => Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
                    { "ItemId", d.Id },
                    { "ItemName", String.Format("{0} {1}", d.FirstName, d.LastName) },
                    { "controllerName", controllerName },
                    { "ShowMedia", false },
                    { "ShowEdit", true },
                    { "EditAction", "Edit" },
                    { "ShowDelete", true },
                    { "ForgotPasswordUrl", Url.Action("ForgotPassword", controllerName, new { id = d.Id }) },
                    { "NewPasswordUrl", Url.Action("GenerateNewPassword", controllerName, new { id = d.Id }) }
                }));
        }).WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
    </div>
</div>

<style>
    .customers-admin-page .users-admin-header {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px 16px;
        margin-bottom: 2px;
    }

    .customers-admin-page .users-admin-header-main {
        flex: 1 1 280px;
        min-width: 0;
    }

    .customers-admin-page .users-admin-header-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
        flex: 0 0 auto;
        position: relative;
        z-index: 2;
        margin: 2px 0 0;
    }

    .customers-admin-page .users-admin-lead {
        margin: 0;
        max-width: 64ch;
        color: #627d98;
        font-size: 13px;
        line-height: 1.45;
    }

    .customers-admin-page textarea.eg-grid-note {
        display: block;
        width: 399px;
        max-width: 100%;
        height: 146px;
        margin: 0;
        padding: 8px 10px;
        border: 1px solid #d7dee8;
        border-radius: 4px;
        background-color: transparent;
        color: #334155;
        font-size: 12px;
        line-height: 1.4;
        resize: vertical;
        white-space: pre-wrap;
    }
</style>
