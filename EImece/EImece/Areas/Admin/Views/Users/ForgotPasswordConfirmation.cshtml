@using Resources;
@{
    ViewBag.Title = AdminResource.ForgotPassword;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>@AdminResource.Users</h2>
<hr class="adminLine" />

<div class="forgot-password-page">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <div class="card border-success forgot-password-panel">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa fa-check-circle" aria-hidden="true"></i>
                        @Resource.ForgotPasswordConfirmation
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-success forgot-password-help" role="alert">
                        <div class="forgot-password-help-title">
                            <i class="fa fa-envelope" aria-hidden="true"></i>
                            <strong>E-posta gonderildi</strong>
                        </div>
                        <p class="forgot-password-confirmation-text">
                            @Resource.ForgotPasswordConfirmationText
                        </p>
                        <ul class="forgot-password-help-list">
                            <li>Gelen kutusu ve spam klasorunu kontrol edin.</li>
                            <li>Baglanti bir sure sonra gecersiz olabilir; gerekirse islemi tekrarlayin.</li>
                        </ul>
                    </div>

                    <div class="forgot-password-actions">
                        @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-primary btn-lg" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
