@using Resources;
@{
    ViewBag.Title = AdminResource.ForgotPassword;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="admin-centered-page forgot-password-page">
    <h2 class="admin-page-title">@AdminResource.ForgotPassword</h2>
    <div class="card shadow-sm border-success">
        <div class="card-header">
            <h3 class="card-title mb-0">
                <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>
                @Resource.ForgotPasswordConfirmation
            </h3>
        </div>
        <div class="card-body">
            <div class="alert alert-success mb-0" role="alert">
                <div class="fw-semibold mb-2">
                    <i class="fa-solid fa-envelope me-1" aria-hidden="true"></i>
                    E-posta gönderildi
                </div>
                <p class="mb-2">
                    @Resource.ForgotPasswordConfirmationText
                </p>
                <ul class="mb-0 ps-3">
                    <li>Gelen kutusu ve spam klasörünü kontrol edin.</li>
                    <li>Bağlantı bir süre sonra geçersiz olabilir; gerekirse işlemi tekrarlayın.</li>
                </ul>
            </div>
        </div>
        <div class="card-footer bg-light d-flex flex-wrap gap-2 justify-content-center">
            @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-primary" })
        </div>
    </div>
</div>
