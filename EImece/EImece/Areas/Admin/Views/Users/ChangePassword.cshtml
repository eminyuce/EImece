@model EImece.Models.ChangePasswordViewModel
@using Resources;
@{
    ViewBag.Title = AdminResource.ChangePassword;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var currenctUser = (EImece.Domain.Services.ApplicationUser)ViewBag.CurrentUser;
}

<h2>@AdminResource.ChangePassword</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "changePasswordHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada yönetici (admin) hesabınızın şifresini güvenli bir şekilde değiştirebilirsiniz.</li>
    <li>Şifrenizi değiştirirken güvenlik kriterlerine uymanız gerekmektedir. Yeni şifreniz:</li>
    <ul>
        <li>En az bir büyük harf içermelidir.</li>
        <li>En az bir küçük harf içermelidir.</li>
        <li>En az bir rakam içermelidir.</li>
        <li>En az bir özel karakter (Örn: !?&*) içermelidir.</li>
        <li>Yeterli uzunlukta olmalıdır.</li>
    </ul>
    <li>Şifre değişikliği yaptıktan sonra sisteme yeni şifrenizle giriş yapmanız gerekecektir.</li>
</ul>
@Html.Partial("_AdminHelpAccordionEnd")

<div class="panel panel-info" style="margin-bottom: 20px;">
    <div class="panel-heading">
        <h3 class="panel-title">İki Faktörlü Doğrulama (Authenticator)</h3>
    </div>
    <div class="panel-body">
        @if (ViewBag.AuthenticatorEnabled == true)
        {
            <p class="text-success" style="margin-bottom: 12px;">
                <i class="glyphicon glyphicon-ok-sign"></i> Authenticator 2FA etkin.
            </p>
            using (Html.BeginForm("DisableAuthenticator", "Users", FormMethod.Post, new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning"
                        onclick="return confirm('Authenticator 2FA kapatılsın mı?');">
                    <i class="glyphicon glyphicon-remove"></i> 2FA Kapat
                </button>
            }
        }
        else
        {
            <p style="margin-bottom: 12px;">
                Yönetici girişinde şifreden sonra telefonunuzdaki Authenticator kodu istenir.
            </p>
            <a href="@Url.Action("EnableAuthenticator", "Users", new { area = "admin" })" class="btn btn-primary">
                <i class="glyphicon glyphicon-qrcode"></i> Authenticator Etkinleştir
            </a>
        }
    </div>
</div>

@using (Html.BeginForm("ChangePassword", "Users", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
{
    @Html.AntiForgeryToken()
    
    <div class="row" style="margin-bottom: 20px;">
        <div class="col-md-9">
            @Html.ValidationSummary("", new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-success btn-block btn-lg">
                <i class="glyphicon glyphicon-lock"></i> @AdminResource.ChangePassword
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">Şifre Değiştirme Formu</h3>
                </div>
                <div class="panel-body" style="padding: 30px;">
                    <div class="form-group">
                        <label class="col-md-3 control-label" for="AdminUserName">@AdminResource.Email</label>
                        <div class="col-md-9">
                            <p class="form-control-static"><strong>@currenctUser.Email</strong></p>
                        </div>
                    </div>
                    
                    <hr />

                    <div class="form-group">
                        @Html.LabelFor(m => m.OldPassword, new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control", placeholder = "Mevcut Şifreniz" })
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.NewPassword, new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", placeholder = "Yeni Şifreniz" })
                            <span class="help-block text-danger" style="margin-top: 10px; font-weight: bold; font-size: 1.1em; color: #d9534f;">
                                <i class="glyphicon glyphicon-info-sign"></i> @AdminResource.PasswordInfoMessage
                            </span>
                        </div>
                    </div>
                    <div class="form-group">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-md-3 control-label" })
                        <div class="col-md-9">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Yeni Şifrenizi Tekrar Girin" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}