@model EImece.Models.ForgotPasswordViewModel
@using Resources;
@{
    ViewBag.Title = AdminResource.ForgotPassword;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var hasTargetUser = ViewBag.HasTargetUser as bool? ?? false;
    var firstName = ViewBag.FirstName as string;
    var lastName = ViewBag.LastName as string;
    var userId = ViewBag.UserId as string;
    var fullName = string.Format("{0} {1}", firstName, lastName).Trim();
    if (string.IsNullOrEmpty(fullName))
    {
        fullName = Model.Email;
    }

    var emailInputAttrs = new Dictionary<string, object>
    {
        { "class", "form-control input-lg" },
        { "placeholder", "ornek@email.com" },
        { "autocomplete", "email" },
        { "type", "email" },
        { "autofocus", "autofocus" }
    };

    if (hasTargetUser && !string.IsNullOrEmpty(Model.Email))
    {
        emailInputAttrs["readonly"] = "readonly";
    }
}

<h2>@AdminResource.Users</h2>
<hr class="adminLine" />

<div class="forgot-password-page">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <div class="panel panel-primary forgot-password-panel">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="fa fa-envelope" aria-hidden="true"></i>
                        @AdminResource.ForgotPassword
                    </h3>
                </div>
                <div class="panel-body">
                    @if (hasTargetUser)
                    {
                        <div class="forgot-password-user">
                            <div class="forgot-password-avatar" aria-hidden="true">
                                <i class="fa fa-user"></i>
                            </div>
                            <div class="forgot-password-user-meta">
                                <div class="forgot-password-user-name">@fullName</div>
                                <div class="forgot-password-user-email">
                                    <i class="fa fa-envelope-o" aria-hidden="true"></i>
                                    @Model.Email
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(userId))
                            {
                                <div class="forgot-password-user-actions">
                                    @Html.ActionLink(AdminResource.Edit, "Edit", "Users", new { id = userId }, new { @class = "btn btn-default btn-sm" })
                                    @Html.ActionLink(AdminResource.NewPassword, "GenerateNewPassword", "Users", new { id = userId }, new { @class = "btn btn-info btn-sm" })
                                </div>
                            }
                        </div>
                    }

                    <div class="alert alert-info forgot-password-help" role="alert">
                        <div class="forgot-password-help-title">
                            <i class="fa fa-info-circle" aria-hidden="true"></i>
                            <strong>Yardim</strong>
                        </div>
                        <ul class="forgot-password-help-list">
                            <li>@AdminResource.EnterYourEmailToRecover</li>
                            <li>Kullaniciya sifre sifirlama baglantisi e-posta ile gonderilir.</li>
                            <li>Baglantidaki adimlari tamamlayarak yeni sifre belirlenebilir.</li>
                            <li>
                                E-posta gelmezse spam / junk klasorunu kontrol edin.
                                Acil durumda yonetici olarak
                                <strong>@AdminResource.NewPassword</strong>
                                secenegi ile aninda yeni sifre olusturabilirsiniz.
                            </li>
                        </ul>
                    </div>

                    @using (Html.BeginForm("ForgotPassword", "Users", FormMethod.Post, new { @class = "forgot-password-form", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary("", new { @class = "alert alert-danger" })

                        <div class="form-group">
                            @Html.LabelFor(m => m.Email, new { @class = "control-label forgot-password-label" })
                            <div class="input-group input-group-lg">
                                <span class="input-group-addon">
                                    <i class="fa fa-envelope-o" aria-hidden="true"></i>
                                </span>
                                @Html.TextBoxFor(m => m.Email, emailInputAttrs)
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                            @if (hasTargetUser && !string.IsNullOrEmpty(Model.Email))
                            {
                                <p class="help-block">
                                    E-posta adresi secilen kullanicidan otomatik dolduruldu.
                                </p>
                            }
                        </div>

                        <div class="forgot-password-actions">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fa fa-paper-plane" aria-hidden="true"></i>
                                @AdminResource.SendEmailLink
                            </button>
                            @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-default btn-lg" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
