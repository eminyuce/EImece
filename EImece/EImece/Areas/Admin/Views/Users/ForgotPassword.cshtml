@model EImece.Models.ForgotPasswordViewModel
@using Resources;
@{
    ViewBag.Title = AdminResource.ForgotPassword;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var hasTargetUser = ViewBag.HasTargetUser as bool? ?? false;
    var firstName = ViewBag.FirstName as string;
    var lastName = ViewBag.LastName as string;
    var userId = ViewBag.UserId as string;
    var fullName = string.Format("{0} {1}", firstName, lastName).Trim();
    if (string.IsNullOrEmpty(fullName))
    {
        fullName = Model.Email;
    }

    var emailInputAttrs = new Dictionary<string, object>
    {
        { "class", "form-control" },
        { "placeholder", "ornek@email.com" },
        { "autocomplete", "email" },
        { "type", "email" },
        { "autofocus", "autofocus" }
    };

    if (hasTargetUser && !string.IsNullOrEmpty(Model.Email))
    {
        emailInputAttrs["readonly"] = "readonly";
    }
}

<div class="admin-centered-page forgot-password-page">
    <h2 class="admin-page-title">@AdminResource.ForgotPassword</h2>
    <p class="admin-centered-page-lead">@AdminResource.ForgotPasswordLead</p>
    <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title mb-0">
                    <i class="fa fa-envelope me-1" aria-hidden="true"></i>
                    @AdminResource.ForgotPassword
                </h3>
            </div>
            @using (Html.BeginForm("ForgotPassword", "Users", FormMethod.Post, new { @class = "forgot-password-form", role = "form" }))
            {
                @Html.AntiForgeryToken()
                <div class="card-body">
                    @if (hasTargetUser)
                    {
                        <div class="forgot-password-user">
                            <div class="forgot-password-avatar" aria-hidden="true">
                                <i class="fa fa-user"></i>
                            </div>
                            <div class="forgot-password-user-meta">
                                <div class="forgot-password-user-name">@fullName</div>
                                <div class="forgot-password-user-email">
                                    <i class="fa fa-envelope-o" aria-hidden="true"></i>
                                    @Model.Email
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(userId))
                            {
                                <div class="forgot-password-user-actions">
                                    @Html.ActionLink(AdminResource.Edit, "Edit", "Users", new { id = userId }, new { @class = "btn btn-outline-secondary btn-sm" })
                                    @Html.ActionLink(AdminResource.NewPassword, "GenerateNewPassword", "Users", new { id = userId }, new { @class = "btn btn-outline-primary btn-sm" })
                                </div>
                            }
                        </div>
                    }

                    <div class="alert alert-info" role="alert">
                        <div class="fw-semibold mb-1">
                            <i class="fa fa-info-circle me-1" aria-hidden="true"></i>
                            Yardım
                        </div>
                        <ul class="mb-0 ps-3">
                            <li>@AdminResource.EnterYourEmailToRecover</li>
                            <li>@AdminResource.CheckSpamFolderHint</li>
                            <li>
                                @AdminResource.EmergencyAdminOption
                                <strong>@AdminResource.NewPassword</strong>
                                @AdminResource.GeneratePasswordInstantlyOption
                            </li>
                        </ul>
                    </div>

                    @Html.ValidationSummary("", new { @class = "alert alert-danger" })

                    <div class="mb-0">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">
                                <i class="fa fa-envelope-o" aria-hidden="true"></i>
                            </span>
                            @Html.TextBoxFor(m => m.Email, emailInputAttrs)
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        @if (hasTargetUser && !string.IsNullOrEmpty(Model.Email))
                        {
                            <p class="form-text mb-0">
                                @AdminResource.EmailAutoPopulatedFromUser
                            </p>
                        }
                    </div>
                </div>
                <div class="card-footer bg-light d-flex flex-wrap gap-2 justify-content-end">
                    @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-secondary" })
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-paper-plane me-1" aria-hidden="true"></i>
                        @AdminResource.SendEmailLink
                    </button>
                </div>
            }
        </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
