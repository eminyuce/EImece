@model EImece.Models.EditUserViewModel
@using Resources;
@{
    ViewBag.Title = AdminResource.GenerateNewPasswordforUser;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var passwordGenerated = ViewBag.PasswordGenerated as bool? ?? false;
    var generationSucceeded = ViewBag.GenerationSucceeded as bool? ?? false;
    var newPassword = ViewBag.NewPassword as string;
    var fullName = string.Format("{0} {1}", Model.FirstName, Model.LastName).Trim();
    if (string.IsNullOrEmpty(fullName))
    {
        fullName = Model.Email;
    }
}

<h2>@AdminResource.Users</h2>
<hr class="adminLine" />

<div class="generate-password-page">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <div class="panel panel-primary generate-password-panel">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="fa fa-key" aria-hidden="true"></i>
                        @AdminResource.GenerateNewPasswordforUser
                    </h3>
                </div>
                <div class="panel-body">
                    <div class="generate-password-user">
                        <div class="generate-password-avatar" aria-hidden="true">
                            <i class="fa fa-user"></i>
                        </div>
                        <div class="generate-password-user-meta">
                            <div class="generate-password-user-name">@fullName</div>
                            <div class="generate-password-user-email">
                                <i class="fa fa-envelope-o" aria-hidden="true"></i>
                                @Model.Email
                            </div>
                        </div>
                    </div>

                    @if (!passwordGenerated)
                    {
                        <div class="alert alert-warning generate-password-alert" role="alert">
                            <strong><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> Dikkat:</strong>
                            Bu islem kullanicinin mevcut sifresini hemen gecersiz kilar.
                            Yeni sifreyi guvenli bir sekilde kullaniciya iletin.
                        </div>

                        using (Html.BeginForm("GenerateNewPasswordConfirm", "Users", FormMethod.Post, new { @class = "generate-password-form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.Id)
                            <div class="generate-password-actions">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="fa fa-refresh" aria-hidden="true"></i>
                                    @AdminResource.NewPassword Olustur
                                </button>
                                @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-default btn-lg" })
                            </div>
                        }
                    }
                    else if (generationSucceeded && !string.IsNullOrEmpty(newPassword))
                    {
                        <div class="alert alert-success generate-password-alert" role="alert">
                            <strong><i class="fa fa-check-circle" aria-hidden="true"></i> Basarili:</strong>
                            Yeni sifre olusturuldu. Bu sifreyi kopyalayip kullaniciya iletin.
                            Sayfayi kapattiktan sonra sifreyi tekrar goremezsiniz.
                        </div>

                        <div class="generate-password-result">
                            <label class="generate-password-label" for="generatedPassword">@AdminResource.NewPassword</label>
                            <div class="input-group input-group-lg generate-password-input-group">
                                <input type="text"
                                       id="generatedPassword"
                                       class="form-control generate-password-value"
                                       value="@newPassword"
                                       readonly="readonly"
                                       autocomplete="off"
                                       spellcheck="false" />
                                <span class="input-group-btn">
                                    <button type="button"
                                            class="btn btn-info"
                                            id="copyGeneratedPassword"
                                            data-copied-text="Kopyalandi"
                                            title="Sifreyi kopyala">
                                        <i class="fa fa-clipboard" aria-hidden="true"></i>
                                        <span class="copy-label">Kopyala</span>
                                    </button>
                                </span>
                            </div>
                            <p class="help-block generate-password-help" id="copyPasswordFeedback" aria-live="polite"></p>
                        </div>

                        <div class="generate-password-actions">
                            @Html.ActionLink(AdminResource.Edit, "Edit", "Users", new { id = Model.Id }, new { @class = "btn btn-primary" })
                            @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-default" })
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger generate-password-alert" role="alert">
                            <strong><i class="fa fa-times-circle" aria-hidden="true"></i> @AdminResource.Error:</strong>
                            Yeni sifre olusturulamadi. Lutfen tekrar deneyin.
                        </div>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="generate-password-actions">
                            @Html.ActionLink("Tekrar Dene", "GenerateNewPassword", "Users", new { id = Model.Id }, new { @class = "btn btn-warning" })
                            @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-default" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (passwordGenerated && generationSucceeded && !string.IsNullOrEmpty(newPassword))
{
    <script type="text/javascript">
        (function () {
            var button = document.getElementById("copyGeneratedPassword");
            var input = document.getElementById("generatedPassword");
            var feedback = document.getElementById("copyPasswordFeedback");
            if (!button || !input) {
                return;
            }

            var defaultLabel = button.querySelector(".copy-label");
            var copiedText = button.getAttribute("data-copied-text") || "Kopyalandi";

            function showFeedback(message, isError) {
                if (!feedback) {
                    return;
                }
                feedback.textContent = message;
                feedback.className = "help-block generate-password-help" + (isError ? " text-danger" : " text-success");
            }

            function markCopied() {
                button.classList.add("is-copied");
                if (defaultLabel) {
                    defaultLabel.textContent = copiedText;
                }
                showFeedback("Sifre panoya kopyalandi.", false);
                window.setTimeout(function () {
                    button.classList.remove("is-copied");
                    if (defaultLabel) {
                        defaultLabel.textContent = "Kopyala";
                    }
                }, 2000);
            }

            button.addEventListener("click", function () {
                var value = input.value || "";
                if (!value) {
                    return;
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(value).then(markCopied).catch(function () {
                        fallbackCopy(value);
                    });
                    return;
                }

                fallbackCopy(value);
            });

            function fallbackCopy(value) {
                input.focus();
                input.select();
                try {
                    var ok = document.execCommand("copy");
                    if (ok) {
                        markCopied();
                    } else {
                        showFeedback("Kopyalama basarisiz. Sifreyi elle secip kopyalayin.", true);
                    }
                } catch (e) {
                    showFeedback("Kopyalama basarisiz. Sifreyi elle secip kopyalayin.", true);
                }
            }

            input.addEventListener("focus", function () {
                input.select();
            });
        })();
    </script>
}
