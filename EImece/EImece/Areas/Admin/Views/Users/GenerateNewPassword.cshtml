@model EImece.Models.EditUserViewModel
@using Resources;
@{
    ViewBag.Title = AdminResource.GenerateNewPasswordforUser;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var passwordGenerated = ViewBag.PasswordGenerated as bool? ?? false;
    var generationSucceeded = ViewBag.GenerationSucceeded as bool? ?? false;
    var newPassword = ViewBag.NewPassword as string;
    var fullName = string.Format("{0} {1}", Model.FirstName, Model.LastName).Trim();
    if (string.IsNullOrEmpty(fullName))
    {
        fullName = Model.Email;
    }
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7 mx-auto">
        <h2 class="admin-page-title">@AdminResource.GenerateNewPasswordforUser</h2>
        <p class="text-muted mb-4">Bu işlem kullanıcının mevcut şifresini hemen geçersiz kılar. Yeni şifreyi güvenli bir şekilde kullanıcıya iletin.</p>
        <div class="card shadow-sm">
            <div class="card-header">
                <h3 class="card-title mb-0">
                    <i class="fa fa-key me-1" aria-hidden="true"></i>
                    @AdminResource.GenerateNewPasswordforUser
                </h3>
            </div>
            @if (!passwordGenerated)
            {
                using (Html.BeginForm("GenerateNewPasswordConfirm", "Users", FormMethod.Post, new { @class = "generate-password-form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)
                    <div class="card-body">
                        <div class="generate-password-user">
                            <div class="generate-password-avatar" aria-hidden="true">
                                <i class="fa fa-user"></i>
                            </div>
                            <div class="generate-password-user-meta">
                                <div class="generate-password-user-name">@fullName</div>
                                <div class="generate-password-user-email">
                                    <i class="fa fa-envelope-o" aria-hidden="true"></i>
                                    @Model.Email
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-warning mb-0" role="alert">
                            <strong><i class="fa fa-exclamation-triangle me-1" aria-hidden="true"></i> Dikkat:</strong>
                            Mevcut şifre hemen geçersiz olur. Oluşturulan şifreyi bu ekrandan kopyalayıp kullanıcıya iletin; sayfayı kapattıktan sonra tekrar göremezsiniz.
                        </div>
                    </div>
                    <div class="card-footer bg-light d-flex flex-wrap gap-2 justify-content-end">
                        @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-secondary" })
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-refresh me-1" aria-hidden="true"></i>
                            @AdminResource.NewPassword Oluştur
                        </button>
                    </div>
                }
            }
            else if (generationSucceeded && !string.IsNullOrEmpty(newPassword))
            {
                <div class="card-body">
                    <div class="generate-password-user">
                        <div class="generate-password-avatar" aria-hidden="true">
                            <i class="fa fa-user"></i>
                        </div>
                        <div class="generate-password-user-meta">
                            <div class="generate-password-user-name">@fullName</div>
                            <div class="generate-password-user-email">
                                <i class="fa fa-envelope-o" aria-hidden="true"></i>
                                @Model.Email
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-success" role="alert">
                        <strong><i class="fa fa-check-circle me-1" aria-hidden="true"></i> Başarılı:</strong>
                        Yeni şifre oluşturuldu. Bu şifreyi kopyalayıp kullanıcıya iletin. Sayfayı kapattıktan sonra şifreyi tekrar göremezsiniz.
                    </div>

                    <label class="form-label fw-semibold" for="generatedPassword">@AdminResource.NewPassword</label>
                    <div class="input-group input-group-lg">
                        <input type="text"
                               id="generatedPassword"
                               class="form-control generate-password-value"
                               value="@newPassword"
                               readonly="readonly"
                               autocomplete="off"
                               spellcheck="false" />
                        <button type="button"
                                class="btn btn-outline-primary"
                                id="copyGeneratedPassword"
                                data-copied-text="Kopyalandı"
                                title="Şifreyi kopyala">
                            <i class="fa fa-clipboard" aria-hidden="true"></i>
                            <span class="copy-label">Kopyala</span>
                        </button>
                    </div>
                    <p class="form-text mb-0" id="copyPasswordFeedback" aria-live="polite"></p>
                </div>
                <div class="card-footer bg-light d-flex flex-wrap gap-2 justify-content-end">
                    @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-secondary" })
                    @Html.ActionLink(AdminResource.Edit, "Edit", "Users", new { id = Model.Id }, new { @class = "btn btn-primary" })
                </div>
            }
            else
            {
                <div class="card-body">
                    <div class="alert alert-danger mb-0" role="alert">
                        <strong><i class="fa fa-times-circle me-1" aria-hidden="true"></i> @AdminResource.Error:</strong>
                        Yeni şifre oluşturulamadı. Lütfen tekrar deneyin.
                    </div>
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                </div>
                <div class="card-footer bg-light d-flex flex-wrap gap-2 justify-content-end">
                    @Html.ActionLink(AdminResource.BackToList, "Index", "Users", null, new { @class = "btn btn-secondary" })
                    @Html.ActionLink("Tekrar Dene", "GenerateNewPassword", "Users", new { id = Model.Id }, new { @class = "btn btn-primary" })
                </div>
            }
        </div>
    </div>
</div>

@if (passwordGenerated && generationSucceeded && !string.IsNullOrEmpty(newPassword))
{
    <script type="text/javascript">
        (function () {
            var button = document.getElementById("copyGeneratedPassword");
            var input = document.getElementById("generatedPassword");
            var feedback = document.getElementById("copyPasswordFeedback");
            if (!button || !input) {
                return;
            }

            var defaultLabel = button.querySelector(".copy-label");
            var copiedText = button.getAttribute("data-copied-text") || "Kopyalandı";

            function showFeedback(message, isError) {
                if (!feedback) {
                    return;
                }
                feedback.textContent = message;
                feedback.className = "form-text mb-0" + (isError ? " text-danger" : " text-success");
            }

            function markCopied() {
                button.classList.add("is-copied");
                if (defaultLabel) {
                    defaultLabel.textContent = copiedText;
                }
                showFeedback("Şifre panoya kopyalandı.", false);
                window.setTimeout(function () {
                    button.classList.remove("is-copied");
                    if (defaultLabel) {
                        defaultLabel.textContent = "Kopyala";
                    }
                }, 2000);
            }

            button.addEventListener("click", function () {
                var value = input.value || "";
                if (!value) {
                    return;
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(value).then(markCopied).catch(function () {
                        fallbackCopy(value);
                    });
                    return;
                }

                fallbackCopy(value);
            });

            function fallbackCopy(value) {
                input.focus();
                input.select();
                try {
                    var ok = document.execCommand("copy");
                    if (ok) {
                        markCopied();
                    } else {
                        showFeedback("Kopyalama başarısız. Şifreyi elle seçip kopyalayın.", true);
                    }
                } catch (e) {
                    showFeedback("Kopyalama başarısız. Şifreyi elle seçip kopyalayın.", true);
                }
            }

            input.addEventListener("focus", function () {
                input.select();
            });
        })();
    </script>
}
