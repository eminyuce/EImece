@using EImece.Models;
@model List<EditUserViewModel>
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@using EImece.Domain.Helpers.Extensions;
@using System.Collections.Generic
@{
    ViewBag.Title = AdminResource.Users;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var controllerName = "Users";

    var search = (ViewBag.Search as string) ?? Request.QueryString["search"].ToStr();
    var selectedRole = (ViewBag.Role as string) ?? Request.QueryString["role"].ToStr();
    var selectedTwoFactor = (ViewBag.TwoFactor as string) ?? Request.QueryString["twoFactor"].ToStr();
    var selectedLocked = (ViewBag.Locked as string) ?? Request.QueryString["locked"].ToStr();
    var availableRoles = (ViewBag.AvailableRoles as List<string>) ?? new List<string>();
    var twoFactorOn = UserAdminFilterHelper.IsOn(selectedTwoFactor);
    var twoFactorOff = UserAdminFilterHelper.IsOff(selectedTwoFactor);
    var lockedOn = UserAdminFilterHelper.IsOn(selectedLocked);

    Func<string, string> roleLabel = roleName =>
    {
        if (string.Equals(roleName, Constants.AdministratorRole, StringComparison.OrdinalIgnoreCase))
        {
            return AdminResource.Administrator;
        }
        if (string.Equals(roleName, Constants.EditorRole, StringComparison.OrdinalIgnoreCase))
        {
            return AdminResource.Editor;
        }
        if (string.Equals(roleName, Constants.CustomerRole, StringComparison.OrdinalIgnoreCase))
        {
            return AdminResource.Customer;
        }
        return roleName ?? string.Empty;
    };

    Func<string, string, string, string, string> filterUrl = (searchVal, roleVal, twoFactorVal, lockedVal) =>
        Url.Action("Index", controllerName, new
        {
            search = string.IsNullOrWhiteSpace(searchVal) ? null : searchVal,
            role = string.IsNullOrWhiteSpace(roleVal) ? null : roleVal,
            twoFactor = string.IsNullOrWhiteSpace(twoFactorVal) ? null : twoFactorVal,
            locked = string.IsNullOrWhiteSpace(lockedVal) ? null : lockedVal
        });

    var clearFiltersUrl = Url.Action("Index", controllerName);
    var hasActiveFilters = !string.IsNullOrWhiteSpace(search)
        || !string.IsNullOrWhiteSpace(selectedRole)
        || twoFactorOn
        || twoFactorOff
        || lockedOn;
}

@helper RoleBadge(string role)
{
    var css = "eg-state-badge is-muted";
    string label = role;
    if (string.Equals(role, Constants.AdministratorRole, StringComparison.OrdinalIgnoreCase))
    {
        css = "eg-state-badge eg-role-admin";
        label = AdminResource.Administrator;
    }
    else if (string.Equals(role, Constants.EditorRole, StringComparison.OrdinalIgnoreCase))
    {
        css = "eg-state-badge eg-role-editor";
        label = AdminResource.Editor;
    }
    else if (string.Equals(role, Constants.CustomerRole, StringComparison.OrdinalIgnoreCase))
    {
        label = AdminResource.Customer;
    }
    <span class="@css">@label</span>
}

<div class="users-admin-page">
    <div class="users-admin-header">
        <div class="users-admin-header-main">
            @Html.AdminBreadcrumb(AdminResource.Users)
            <h2 class="admin-page-title">@AdminResource.Users</h2>
            <p class="users-admin-lead">
                @AdminResource.AdminUsersIndexLead
            </p>
        </div>
        <div class="users-admin-header-actions">
            <a href="@Url.Action("CustomerRoles", controllerName)" class="btn btn-secondary btn-sm">
                <i class="fa fa-user" aria-hidden="true"></i>
                @AdminResource.CustomersWithAccounts
            </a>
            <a href="@Url.Action("Register", controllerName)" class="btn btn-primary btn-sm">
                <i class="fa fa-plus" aria-hidden="true"></i>
                @AdminResource.NewUserInsert
            </a>
        </div>
    </div>
    <hr class="adminLine" />

    <div class="users-admin-toolbar" id="usersAdminFilters">
        @using (Html.BeginForm("Index", controllerName, FormMethod.Get, new { @class = "eg-search-form users-admin-search", id = "usersAdminFilterForm", role = "search" }))
        {
            if (!string.IsNullOrWhiteSpace(selectedRole))
            {
                <input type="hidden" name="role" value="@selectedRole" />
            }
            if (!string.IsNullOrWhiteSpace(selectedTwoFactor))
            {
                <input type="hidden" name="twoFactor" value="@selectedTwoFactor" />
            }
            if (!string.IsNullOrWhiteSpace(selectedLocked))
            {
                <input type="hidden" name="locked" value="@selectedLocked" />
            }
            <div class="eg-search-field">
                <span class="eg-search-icon" aria-hidden="true">
                    <i class="fa fa-search"></i>
                </span>
                <label class="visually-hidden" for="usersSearch">@AdminResource.Search</label>
                <input type="search"
                       class="form-control"
                       id="usersSearch"
                       name="search"
                       value="@search"
                       placeholder="@AdminResource.SearchNameEmailPlaceholder"
                       autocomplete="off" />
                <div class="eg-search-actions">
                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <a class="btn btn-secondary eg-search-clear"
                           href="@filterUrl(null, selectedRole, selectedTwoFactor, selectedLocked)"
                           title="@AdminResource.ClearSearch">@AdminResource.Clear</a>
                    }
                    <button class="btn btn-primary" id="usersSearchButton" type="submit">
                        <i class="fa fa-search" aria-hidden="true"></i>
                        <span>@AdminResource.GridSearchButtonText</span>
                    </button>
                </div>
            </div>
        }

        <div class="users-admin-quick" aria-label="@AdminResource.FilterByNameEmailRole2Fa">
            <div class="users-admin-quick-row">
                <span class="users-admin-quick-label">@AdminResource.Roles</span>
                <a class="eg-quick-chip @(string.IsNullOrWhiteSpace(selectedRole) ? "is-active" : "")"
                   href="@filterUrl(search, null, selectedTwoFactor, selectedLocked)">@AdminResource.All</a>
                @foreach (var roleOption in availableRoles)
                {
                    var isRoleActive = string.Equals(selectedRole, roleOption, StringComparison.OrdinalIgnoreCase);
                    <a class="eg-quick-chip @(isRoleActive ? "is-active" : "")"
                       href="@filterUrl(search, isRoleActive ? null : roleOption, selectedTwoFactor, selectedLocked)">@roleLabel(roleOption)</a>
                }
            </div>
            <div class="users-admin-quick-row">
                <span class="users-admin-quick-label">@AdminResource.Authenticator2FA</span>
                <a class="eg-quick-chip @(!twoFactorOn && !twoFactorOff ? "is-active" : "")"
                   href="@filterUrl(search, selectedRole, null, selectedLocked)">@AdminResource.All</a>
                <a class="eg-quick-chip @(twoFactorOn ? "is-active" : "")"
                   href="@filterUrl(search, selectedRole, twoFactorOn ? null : "yes", selectedLocked)">@AdminResource.Active</a>
                <a class="eg-quick-chip @(twoFactorOff ? "is-active" : "")"
                   href="@filterUrl(search, selectedRole, twoFactorOff ? null : "no", selectedLocked)">@AdminResource.None</a>
            </div>
            <div class="users-admin-quick-row">
                <span class="users-admin-quick-label">@AdminResource.Status</span>
                <a class="eg-quick-chip @(lockedOn ? "is-active" : "")"
                   href="@filterUrl(search, selectedRole, selectedTwoFactor, lockedOn ? null : "yes")">
                    <i class="fa fa-lock" aria-hidden="true"></i>
                    @AdminResource.Locked
                </a>
            </div>
        </div>

        @if (hasActiveFilters)
        {
            <div class="users-admin-active" aria-live="polite">
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a class="users-admin-active-chip" href="@filterUrl(null, selectedRole, selectedTwoFactor, selectedLocked)" title="@AdminResource.ClearSearch">
                        <span>@AdminResource.Search: @search</span>
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(selectedRole))
                {
                    <a class="users-admin-active-chip" href="@filterUrl(search, null, selectedTwoFactor, selectedLocked)">
                        <span>@AdminResource.Roles: @roleLabel(selectedRole)</span>
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </a>
                }
                @if (twoFactorOn || twoFactorOff)
                {
                    <a class="users-admin-active-chip" href="@filterUrl(search, selectedRole, null, selectedLocked)">
                        <span>@AdminResource.Authenticator2FA: @(twoFactorOn ? AdminResource.Active : AdminResource.None)</span>
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </a>
                }
                @if (lockedOn)
                {
                    <a class="users-admin-active-chip" href="@filterUrl(search, selectedRole, selectedTwoFactor, null)">
                        <span>@AdminResource.Locked</span>
                        <i class="fa fa-times" aria-hidden="true"></i>
                    </a>
                }
                <a class="users-admin-filters-clear" href="@clearFiltersUrl">
                    <i class="fa fa-times" aria-hidden="true"></i> @AdminResource.Clear
                </a>
            </div>
        }
    </div>

    @Html.Partial("Grid/_GridChrome")

    <div class="js-griddly-async" data-url="@Url.Action("IndexGrid", new
    {
        search = string.IsNullOrWhiteSpace(search) ? null : search,
        role = string.IsNullOrWhiteSpace(selectedRole) ? null : selectedRole,
        twoFactor = string.IsNullOrWhiteSpace(selectedTwoFactor) ? null : selectedTwoFactor,
        locked = string.IsNullOrWhiteSpace(selectedLocked) ? null : selectedLocked
    })"></div>
</div>

<style>
    .users-admin-page .users-admin-header {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px 16px;
        margin-bottom: 2px;
    }

    .users-admin-page .users-admin-header-main {
        flex: 1 1 280px;
        min-width: 0;
    }

    .users-admin-page .users-admin-header-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
        flex: 0 0 auto;
        position: relative;
        z-index: 2;
        margin: 2px 0 0;
    }

    .users-admin-page .users-admin-header .admin-page-title {
        margin-bottom: 8px;
    }

    .users-admin-page .users-admin-lead {
        margin: 0;
        max-width: 64ch;
        color: #627d98;
        font-size: 13px;
        line-height: 1.45;
    }

    .users-admin-page .adminLine {
        margin-top: 10px;
        margin-bottom: 12px;
    }

    .users-admin-toolbar {
        margin-bottom: 14px;
        padding: 14px 16px 12px;
        background: #fff;
        border: 1px solid #d7dee8;
        border-radius: 12px;
        box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
    }

    .users-admin-page .eg-search-form {
        margin: 0 0 12px;
    }

    .users-admin-page .eg-search-field {
        display: flex;
        align-items: stretch;
        width: 100%;
        min-height: 42px;
        border: 1px solid #d7dee8;
        border-radius: 10px;
        background: #fff;
        overflow: hidden;
        transition: border-color 140ms ease, box-shadow 140ms ease;
    }

    .users-admin-page .eg-search-field:focus-within {
        border-color: #0b6e99;
        box-shadow: 0 0 0 3px rgba(11, 110, 153, 0.12);
    }

    .users-admin-page .eg-search-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        color: #627d98;
        background: #f8fafc;
        border-right: 1px solid #d7dee8;
        flex-shrink: 0;
    }

    .users-admin-page #usersSearch {
        flex: 1 1 auto;
        height: 40px;
        border: 0;
        border-radius: 0;
        box-shadow: none;
        background: transparent;
        padding-left: 12px;
        font-size: 14px;
    }

    .users-admin-page #usersSearch:focus {
        outline: none;
        box-shadow: none;
    }

    .users-admin-page .eg-search-actions {
        display: inline-flex;
        align-items: stretch;
        flex-shrink: 0;
    }

    .users-admin-page #usersSearchButton,
    .users-admin-page .eg-search-clear {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 40px;
        border: 0;
        border-left: 1px solid #d7dee8;
        border-radius: 0;
        padding: 0 14px;
        font-weight: 600;
    }

    .users-admin-page #usersSearchButton {
        background: #0b6e99;
        color: #fff;
    }

    .users-admin-page #usersSearchButton:hover,
    .users-admin-page #usersSearchButton:focus {
        background: #095a7d;
        color: #fff;
    }

    .users-admin-page .eg-search-clear {
        background: #fff;
        color: #627d98;
        text-decoration: none;
    }

    .users-admin-page .eg-search-clear:hover {
        background: #f8fafc;
        color: #b91c1c;
        text-decoration: none;
    }

    .users-admin-quick {
        display: grid;
        gap: 8px;
    }

    .users-admin-quick-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
    }

    .users-admin-quick-label {
        min-width: 52px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #627d98;
    }

    .users-admin-active {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px dashed #d7dee8;
    }

    .users-admin-active-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 999px;
        background: #e8f1fa;
        border: 1px solid #c5d9ee;
        color: #1e4e7a;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none !important;
    }

    .users-admin-active-chip:hover {
        background: #dbeafe;
        color: #b91c1c;
    }

    .users-admin-filters-clear {
        font-size: 12px;
        font-weight: 600;
        color: #627d98;
        text-decoration: none;
    }

    .users-admin-filters-clear:hover {
        color: #b91c1c;
        text-decoration: none;
    }

    .users-admin-page .eg-grid-chrome {
        margin-bottom: 8px;
    }

    .users-admin-page .eg-role-admin {
        background: #e8f1fa;
        color: #1e4e7a;
        border: 1px solid #c5d9ee;
    }

    .users-admin-page .eg-role-editor {
        background: #eef6ee;
        color: #276749;
        border: 1px solid #c6e0c8;
    }

    @@media (max-width: 767px) {
        .users-admin-page .users-admin-header-actions {
            width: 100%;
            margin-bottom: 4px;
        }

        .users-admin-page .users-admin-header-actions .btn {
            flex: 1 1 auto;
            text-align: center;
        }

        .users-admin-quick-label {
            width: 100%;
            min-width: 0;
        }

        .users-admin-page #usersSearchButton span {
            display: none;
        }
    }
</style>

@section Scripts {
    <script>
        $(function () {
            var $form = $('#usersAdminFilterForm');
            var $search = $('#usersSearch');
            var timer;
            if (!$form.length || !$search.length) {
                return;
            }

            $search.on('input', function () {
                clearTimeout(timer);
                timer = setTimeout(function () {
                    $form.trigger('submit');
                }, 400);
            });

            $form.on('submit', function () {
                clearTimeout(timer);
            });
        });
    </script>
}
