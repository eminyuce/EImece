@using EImece.Models;
@model List<EditUserViewModel>
@using EImece.Domain.Helpers;
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain;
@using Resources;
@using EImece.Domain.Helpers.Extensions;
@{
    var users = Model;

    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : AppConfig.GridPageSizeNumber * (gridPage - 1);

    var controllerName = "Users";
    var gridName = "UsersGrid";
    var contents = Model;
}

<h2>@AdminResource.Users</h2>
<hr class="adminLine" />
<p>
    @Html.ActionLink("Sitede Hesabı Olan Müşteriler", "CustomerRoles", controllerName, null, new { @class = "btn btn-info" })
</p>
<div class="panel panel-info">
    <div class="row">
        <span class="col-md-3">
            <p>
                @Html.ActionLink(AdminResource.NewUserInsert, "Register", controllerName, null, new { @class = "btn btn-primary btn-block" })
            </p>
        </span>
        <span class="col-md-9">
            @Html.Partial("pSearchForm")
        </span>
    </div>
</div>

@Html.Partial("Grid/_GridChrome")

<div class="panel panel-primary eg-grid-shell">
    @Html.Grid(contents).Named(gridName).Columns(columns =>
{
    columns.Add()
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
        .RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

    columns.Add(c => c.Email)
        .Titled(AdminResource.Email)
        .Filterable(true)
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-col-name")
        .RenderValueAs(o => Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) {
            { "Name", o.Email },
            { "Subtitle", String.Format("{0} {1}", o.FirstName, o.LastName) }
        }));

    columns.Add(o => o.Role)
        .Encoded(false)
        .Titled(AdminResource.Roles)
        .RenderValueAs(o => String.Format("{0}", o.Role));

    columns.Add(o => o.AuthenticatorEnabled)
        .Encoded(false)
        .Sanitized(false)
        .Titled("2FA")
        .Filterable(true)
        .RenderValueAs(o => o.AuthenticatorEnabled
            ? "<span class='eg-state-badge'>Aktif</span>"
            : "<span class='eg-state-badge is-muted'>Yok</span>");

    columns.Add()
        .Titled("İşlemler")
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-sticky-right eg-col-actions")
        .RenderValueAs(d => Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
            { "ItemId", d.Id },
            { "ItemName", String.Format("{0} {1}", d.FirstName, d.LastName) },
            { "controllerName", controllerName },
            { "ShowMedia", false },
            { "ShowEdit", true },
            { "EditAction", "Edit" },
            { "ShowDelete", true },
            { "ForgotPasswordUrl", Url.Action("ForgotPassword", controllerName, new { id = d.Id }) },
            { "NewPasswordUrl", Url.Action("GenerateNewPassword", controllerName, new { id = d.Id }) },
            { "RolesUrl", Url.Action("UserRoles", controllerName, new { id = d.Id }) }
        }));

}).WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
</div>
