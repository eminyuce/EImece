@using EImece.Domain
@using EImece.Domain.Helpers
@using Resources
@{
    ViewBag.Title = AdminResource.SystemHealth;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    bool isSiteUnderConstruction = ViewBag.IsSiteUnderConstruction != null && (bool)ViewBag.IsSiteUnderConstruction;
}

<div class="admin-health-page" style="padding: 20px 24px;">
    <!-- Breadcrumb & Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
        <div>
            @Html.AdminBreadcrumb(AdminResource.SystemHealth, AdminResource.System)
            <h1 style="font-size: 24px; font-weight: 700; color: #102a43; margin: 0; display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-heart-pulse text-danger" aria-hidden="true"></i> @AdminResource.SystemHealth
            </h1>
        </div>
        <div style="display: flex; align-items: center; gap: 10px;">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnToggleAllAccordions" title="Tüm Detayları Aç / Kapat">
                <i class="fa-solid fa-angles-down" id="toggleAllIcon"></i> <span id="toggleAllText">Tüm Detayları Aç</span>
            </button>
            <a href="/health" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" title="JSON (/health)">
                <i class="fa-solid fa-code"></i> JSON (/health)
            </a>
            <a href="@Url.Action("Index", "Metrics", new { area = "admin" })" class="btn btn-secondary btn-sm" title="@AdminResource.Metrics">
                <i class="fa-solid fa-chart-line"></i> @AdminResource.Metrics
            </a>
            <button type="button" class="btn btn-primary btn-sm" id="btnPageRefreshHealth" style="font-weight: 600;">
                <i class="fa-solid fa-arrows-rotate" id="pageRefreshIcon"></i> @AdminResource.RefreshNow
            </button>
        </div>
    </div>

    <!-- Maintenance Mode Notice -->
    @if (isSiteUnderConstruction)
    {
        <div class="alert alert-warning d-flex align-items-center" style="border-radius: 8px; border: 1px solid #f0b429; background: #fffbea; box-shadow: 0 2px 6px rgba(16,42,67,0.06); margin-bottom: 24px;">
            <i class="fa-solid fa-triangle-exclamation fa-2x" style="color: #f0b429; margin-right: 16px;" aria-hidden="true"></i>
            <div>
                <strong style="display: block; font-size: 15px; color: #822427;">@AdminResource.MaintenanceModeActive</strong>
                <span style="color: #627d98; font-size: 13px;">@AdminResource.MaintenanceModeSiteOffline</span>
                <a href="@Url.Action("SystemSettings", "AdminSettings", new { area = "admin" })" style="margin-left: 8px; font-size: 13px;">@AdminResource.GeneralAndStorefront</a>
            </div>
        </div>
    }

    <!-- Overall Summary Banner -->
    <div class="card" style="border-radius: 8px; border: 1px solid #d9e2ec; box-shadow: 0 2px 6px rgba(16,42,67,0.06); margin-bottom: 24px;">
        <div class="card-body" style="padding: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div id="pageOverallStatusIconContainer" style="width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #f0f4f8; font-size: 24px; transition: all 0.3s ease;">
                    <i class="fa-solid fa-circle-notch fa-spin text-muted" id="pageOverallStatusIcon"></i>
                </div>
                <div>
                    <div style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #829ab1;">@AdminResource.GeneralSystemStatus</div>
                    <div id="pageOverallStatusTitle" style="font-size: 20px; font-weight: 700; color: #102a43;">@AdminResource.Checking</div>
                </div>
            </div>
            <div style="display: flex; gap: 24px; align-items: center; flex-wrap: wrap;">
                <div>
                    <div style="font-size: 11px; color: #829ab1; text-transform: uppercase; font-weight: 600;">@AdminResource.ComponentCount</div>
                    <div id="pageTotalComponentsCount" style="font-size: 18px; font-weight: 700; color: #334e68;">-</div>
                </div>
                <div>
                    <div style="font-size: 11px; color: #829ab1; text-transform: uppercase; font-weight: 600;">Sağlıklı Bileşenler</div>
                    <div id="pageHealthyComponentsCount" style="font-size: 18px; font-weight: 700; color: #27ab83;">-</div>
                </div>
                <div>
                    <div style="font-size: 11px; color: #829ab1; text-transform: uppercase; font-weight: 600;">@AdminResource.LastChecked</div>
                    <div id="pageLastCheckedRelative" style="font-size: 14px; font-weight: 600; color: #334e68;">@AdminResource.NeverChecked</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Component Details Table & Accordion -->
    <div class="card" style="border-radius: 8px; border: 1px solid #d9e2ec; box-shadow: 0 2px 6px rgba(16,42,67,0.06);">
        <div class="card-header" style="background: #f8fafc; border-bottom: 1px solid #d9e2ec; padding: 14px 20px; font-weight: 700; font-size: 14px; color: #334e68; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <i class="fa-solid fa-server" aria-hidden="true" style="margin-right: 6px;"></i> @AdminResource.SystemComponentsAndHealthChecks
            </div>
            <span style="font-size: 12px; font-weight: normal; color: #627d98;">Detayları görmek için bileşen satırına veya butona tıklayın</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover" style="margin-bottom: 0;">
                <thead>
                    <tr style="background: #f0f4f8; color: #486581; font-size: 12px; text-transform: uppercase;">
                        <th style="padding: 12px 20px; width: 22%;">@AdminResource.Component</th>
                        <th style="padding: 12px 20px; width: 12%;">@AdminResource.Status</th>
                        <th style="padding: 12px 20px; width: 14%;">@AdminResource.ResponseTime</th>
                        <th style="padding: 12px 20px;">@AdminResource.DiagnosticDescription</th>
                        <th style="padding: 12px 20px; width: 10%; text-align: right;">Detay</th>
                    </tr>
                </thead>
                <tbody id="pageHealthComponentsTableBody" style="font-size: 13px;">
                    <tr>
                        <td colspan="5" class="text-center text-muted" style="padding: 24px;">
                            <i class="fa-solid fa-spinner fa-spin"></i> @AdminResource.QueryingHealthChecks
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .health-status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
        vertical-align: middle;
    }
    .health-status-dot--ok {
        background-color: #27ab83;
        box-shadow: 0 0 0 3px rgba(39, 171, 131, 0.25);
    }
    .health-status-dot--issue {
        background-color: #e12d39;
        box-shadow: 0 0 0 3px rgba(225, 45, 57, 0.25);
    }
    .health-status-dot--pending {
        background-color: #f0b429;
        box-shadow: 0 0 0 3px rgba(240, 180, 41, 0.25);
    }

    .health-component-row {
        cursor: pointer;
        transition: background-color 0.2s ease;
    }
    .health-component-row:hover {
        background-color: #f0f4f8 !important;
    }
    .health-component-row.is-expanded {
        background-color: #f8fafc;
        border-bottom: none;
    }

    .health-accordion-panel {
        background-color: #fafbfc;
        border-top: 1px dashed #d9e2ec;
        border-bottom: 1px solid #d9e2ec;
    }

    .health-detail-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 10px 14px;
        font-size: 12px;
    }
    .health-detail-card__label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        color: #829ab1;
        margin-bottom: 2px;
    }
    .health-detail-card__value {
        font-size: 13px;
        font-weight: 600;
        color: #102a43;
        word-break: break-all;
    }
</style>

@section scripts {
<script>
    (function ($) {
        if (!$) return;

        var lastCheckTimestamp = null;
        var healthEndpoint = '/health';
        var txtJustNow = '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.JustNow))';
        var txtSecondsAgo = '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.SecondsAgo))';
        var txtHealthy = '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.SystemHealthyAllUp))';
        var txtIssue = '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.SystemIssueDetected))';
        var txtNormal = '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.ComponentNormal))';
        var txtConnError = '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.ConnectionOrResponseError))';

        var allExpanded = false;

        function getComponentIcon(name) {
            var lower = (name || '').toLowerCase();
            if (lower.indexOf('sql') >= 0 || lower.indexOf('database') >= 0 || lower.indexOf('db') >= 0) {
                return '<i class="fa-solid fa-database text-primary" style="margin-right: 8px;"></i>';
            }
            if (lower.indexOf('file') >= 0 || lower.indexOf('storage') >= 0 || lower.indexOf('disk') >= 0) {
                return '<i class="fa-solid fa-hard-drive text-info" style="margin-right: 8px;"></i>';
            }
            if (lower.indexOf('background') >= 0 || lower.indexOf('quartz') >= 0 || lower.indexOf('job') >= 0 || lower.indexOf('scheduler') >= 0) {
                return '<i class="fa-solid fa-clock-rotate-left text-warning" style="margin-right: 8px;"></i>';
            }
            if (lower.indexOf('api') >= 0 || lower.indexOf('external') >= 0 || lower.indexOf('http') >= 0 || lower.indexOf('iyzico') >= 0) {
                return '<i class="fa-solid fa-cloud-arrow-up text-success" style="margin-right: 8px;"></i>';
            }
            return '<i class="fa-solid fa-cube text-secondary" style="margin-right: 8px;"></i>';
        }

        function updateRelativeTime() {
            if (!lastCheckTimestamp) return;
            var elapsedSec = Math.max(0, Math.round((new Date().getTime() - lastCheckTimestamp.getTime()) / 1000));
            var timeText = elapsedSec === 0 ? txtJustNow : elapsedSec + " " + txtSecondsAgo;
            $('#pageLastCheckedRelative').text(timeText);
        }

        function renderHealthState(data, isError) {
            lastCheckTimestamp = new Date();
            var isHealthy = !isError && data && (data.Status === "UP" || data.status === "UP");
            var iconContainer = $('#pageOverallStatusIconContainer');
            var statusIcon = $('#pageOverallStatusIcon');
            var statusTitle = $('#pageOverallStatusTitle');

            statusIcon.removeClass('fa-spin fa-circle-notch fa-check fa-triangle-exclamation text-muted text-success text-danger');

            if (isHealthy) {
                iconContainer.css('background', '#e3f9e5');
                statusIcon.addClass('fa-check').css('color', '#27ab83');
                statusTitle.text(txtHealthy).css('color', '#27ab83');
            } else {
                iconContainer.css('background', '#ffe3e3');
                statusIcon.addClass('fa-triangle-exclamation').css('color', '#e12d39');
                statusTitle.text(txtIssue).css('color', '#e12d39');
            }

            var tbody = $('#pageHealthComponentsTableBody');
            tbody.empty();

            var components = (data && (data.Components || data.components)) ? (data.Components || data.components) : null;
            if (components && Object.keys(components).length > 0) {
                var compKeys = Object.keys(components);
                var compCount = compKeys.length;
                var healthyCount = 0;

                $('#pageTotalComponentsCount').text(compCount);

                $.each(components, function (key, comp) {
                    var compUp = (comp.Status === "UP" || comp.status === "UP");
                    if (compUp) healthyCount++;

                    var compBadge = compUp
                        ? '<span class="label text-bg-success" style="font-size: 12px; padding: 4px 10px; border-radius: 10px;"><i class="fa-solid fa-check"></i> UP</span>'
                        : '<span class="label text-bg-danger" style="font-size: 12px; padding: 4px 10px; border-radius: 10px;"><i class="fa-solid fa-xmark"></i> DOWN</span>';
                    
                    var durationMs = (typeof comp.DurationMs === 'number') ? comp.DurationMs : ((typeof comp.durationMs === 'number') ? comp.durationMs : null);
                    var duration = (durationMs !== null) ? durationMs.toFixed(1) + ' ms' : '-';
                    var desc = comp.Description || comp.description || (comp.details ? comp.details.message : null) || (compUp ? txtNormal : txtConnError);
                    var errorMsg = comp.Error || comp.error || null;
                    var compData = comp.Data || comp.data || {};

                    var accordionId = 'acc_' + key.replace(/[^a-zA-Z0-9_]/g, '_');

                    // Main Component Row
                    var row = $('<tr class="health-component-row" data-target="#' + accordionId + '"></tr>');
                    row.append('<td style="padding: 14px 20px;"><strong>' + getComponentIcon(key) + $('<div>').text(key).html() + '</strong></td>');
                    row.append('<td style="padding: 14px 20px;">' + compBadge + '</td>');
                    row.append('<td style="padding: 14px 20px;"><span class="badge" style="background: #e2e8f0; color: #334e68; font-size: 12px;">' + duration + '</span></td>');
                    row.append('<td style="padding: 14px 20px;"><span style="color: ' + (compUp ? '#486581' : '#e12d39') + '; font-weight: 500;">' + $('<div>').text(desc).html() + '</span></td>');
                    row.append('<td style="padding: 14px 20px; text-align: right;"><button type="button" class="btn btn-sm btn-outline-secondary accordion-toggle-btn" style="padding: 2px 8px; font-size: 12px;" aria-expanded="false"><i class="fa-solid fa-chevron-down toggle-chevron" style="transition: transform 0.2s ease;"></i></button></td>');
                    tbody.append(row);

                    // Accordion Details Row
                    var detailsRow = $('<tr class="health-accordion-panel" id="' + accordionId + '" style="display: none;"><td colspan="5" style="padding: 16px 24px;"></td></tr>');
                    var detailsContainer = detailsRow.find('td');

                    var grid = $('<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px;"></div>');

                    // Standard breakdown cards
                    grid.append('<div class="health-detail-card"><div class="health-detail-card__label">Bileşen Adı</div><div class="health-detail-card__value">' + $('<div>').text(key).html() + '</div></div>');
                    grid.append('<div class="health-detail-card"><div class="health-detail-card__label">Durum</div><div class="health-detail-card__value" style="color: ' + (compUp ? '#27ab83' : '#e12d39') + ';">' + (compUp ? 'UP (Sağlıklı)' : 'DOWN (Hata / Ulaşılamıyor)') + '</div></div>');
                    grid.append('<div class="health-detail-card"><div class="health-detail-card__label">Yanıt Süresi</div><div class="health-detail-card__value">' + duration + '</div></div>');

                    // Custom data attributes breakdown
                    if (compData && typeof compData === 'object') {
                        $.each(compData, function (dKey, dVal) {
                            var formattedVal = (typeof dVal === 'object') ? JSON.stringify(dVal) : String(dVal);
                            grid.append('<div class="health-detail-card"><div class="health-detail-card__label">' + $('<div>').text(dKey).html() + '</div><div class="health-detail-card__value">' + $('<div>').text(formattedVal).html() + '</div></div>');
                        });
                    }

                    detailsContainer.append(grid);

                    // If error exists, display error callout
                    if (errorMsg) {
                        var errBox = $('<div class="alert alert-danger" style="margin-top: 12px; margin-bottom: 0; padding: 10px 14px; border-radius: 6px; font-size: 13px;"><i class="fa-solid fa-circle-exclamation" style="margin-right: 6px;"></i> <strong>Hata Detayı:</strong> ' + $('<div>').text(errorMsg).html() + '</div>');
                        detailsContainer.append(errBox);
                    }

                    tbody.append(detailsRow);
                });

                $('#pageHealthyComponentsCount').text(healthyCount + ' / ' + compCount);
            } else if (isError) {
                $('#pageTotalComponentsCount').text('0');
                $('#pageHealthyComponentsCount').text('0');
                tbody.append('<tr><td colspan="5" class="text-danger text-center" style="padding: 24px;"><i class="fa-solid fa-triangle-exclamation"></i> Sağlık kontrol servisine ulaşılamadı. Lütfen sunucu bağlantısını kontrol edin.</td></tr>');
            } else {
                $('#pageTotalComponentsCount').text('1');
                $('#pageHealthyComponentsCount').text('1');
                tbody.append('<tr><td style="padding: 14px 20px;"><strong>Genel Durum</strong></td><td><span class="label text-bg-success">UP</span></td><td>-</td><td>Uygulama çalışıyor.</td><td>-</td></tr>');
            }

            updateRelativeTime();
        }

        function checkHealth() {
            var icon = $('#pageRefreshIcon');
            icon.addClass('fa-spin');

            $.ajax({
                url: healthEndpoint,
                type: 'GET',
                dataType: 'json',
                cache: false,
                timeout: 10000
            }).done(function (data) {
                renderHealthState(data, false);
            }).fail(function (xhr) {
                var responseData = null;
                try {
                    if (xhr.responseText) responseData = JSON.parse(xhr.responseText);
                } catch (e) { }
                renderHealthState(responseData, true);
            }).always(function () {
                icon.removeClass('fa-spin');
            });
        }

        $(document).ready(function () {
            checkHealth();
            setInterval(checkHealth, 60000);
            setInterval(updateRelativeTime, 5000);

            $('#btnPageRefreshHealth').on('click', function (e) {
                e.preventDefault();
                checkHealth();
            });

            // Accordion click handler
            $(document).on('click', '.health-component-row', function (e) {
                var targetSelector = $(this).data('target');
                var panel = $(targetSelector);
                var chevron = $(this).find('.toggle-chevron');

                if (panel.is(':visible')) {
                    panel.slideUp(200);
                    $(this).removeClass('is-expanded');
                    chevron.css('transform', 'rotate(0deg)');
                } else {
                    panel.slideDown(200);
                    $(this).addClass('is-expanded');
                    chevron.css('transform', 'rotate(180deg)');
                }
            });

            // Expand All / Collapse All Toggle
            $('#btnToggleAllAccordions').on('click', function () {
                allExpanded = !allExpanded;
                if (allExpanded) {
                    $('.health-accordion-panel').slideDown(200);
                    $('.health-component-row').addClass('is-expanded');
                    $('.toggle-chevron').css('transform', 'rotate(180deg)');
                    $('#toggleAllIcon').removeClass('fa-angles-down').addClass('fa-angles-up');
                    $('#toggleAllText').text('Tüm Detayları Kapat');
                } else {
                    $('.health-accordion-panel').slideUp(200);
                    $('.health-component-row').removeClass('is-expanded');
                    $('.toggle-chevron').css('transform', 'rotate(0deg)');
                    $('#toggleAllIcon').removeClass('fa-angles-up').addClass('fa-angles-down');
                    $('#toggleAllText').text('Tüm Detayları Aç');
                }
            });
        });
    })(window.jQuery);
</script>
}
