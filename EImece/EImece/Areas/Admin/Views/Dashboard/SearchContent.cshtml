@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using Resources
@model List<BaseContent>
@{
    ViewBag.Title = AdminResource.SearchResults;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var searchKey = (string)ViewBag.SearchKey;
    var searchList = Model ?? new List<BaseContent>();
    var hasResults = searchList.Any();
}

<link href="~/Content/adminSearchResult.css?v=20260811c" rel="stylesheet" />

<div class="admin-search" lang="tr">
    <header class="admin-search__hero">
        <div class="admin-search__hero-text">
            <p class="admin-search__eyebrow">
                <a href="@Url.Action("Index", "Dashboard", new { area = "admin" })">@AdminResource.AdminHome</a>
                <span aria-hidden="true">/</span>
                @AdminResource.SearchResults
            </p>
            <h1 class="admin-search__title">@AdminResource.SearchResults</h1>
            @if (hasResults)
            {
                <p class="admin-search__lead">
                    <strong>@searchList.Count</strong>
                    @AdminResource.SearchResultsText
                    <mark class="admin-search__query">@searchKey</mark>
                </p>
            }
            else
            {
                <p class="admin-search__lead">
                    @AdminResource.NoSearchResultsText
                    <mark class="admin-search__query">@searchKey</mark>
                </p>
            }
        </div>
    </header>

    <form class="admin-search__form" action="@Url.Action("SearchContent", "Dashboard", new { area = "admin" })" method="get" role="search">
        <label class="sr-only" for="searchTxt">@AdminResource.AdminMainSeachPlaceHolder</label>
        <div class="admin-search__form-box">
            <span class="admin-search__form-icon" aria-hidden="true"><i class="fa fa-search"></i></span>
            <input type="text"
                   name="searchContent"
                   id="searchTxt"
                   value="@searchKey"
                   data-provide="typehead"
                   class="form-control"
                   placeholder="@AdminResource.AdminMainSeachPlaceHolder"
                   autocomplete="off" />
            <button type="submit" class="btn btn-primary">Ara</button>
            <a class="btn btn-default admin-search__clear"
               href="@Url.Action("Index", "Dashboard", new { area = "admin" })"
               title="@AdminResource.Clear">
                <i class="fa fa-times" aria-hidden="true"></i>
                @AdminResource.Clear
            </a>
        </div>
    </form>

    @if (hasResults)
    {
        <ul class="admin-search__list">
            @foreach (var baseContent in searchList)
            {
                @Html.DisplayFor(item => baseContent, "BaseContentSearchItem")
            }
        </ul>
    }
    else
    {
        <output class="admin-search__empty" style="display:block">
            <i class="fa fa-search" aria-hidden="true"></i>
            <p>Farklı bir anahtar kelime deneyin veya panele dönün.</p>
            <a class="btn btn-default" href="@Url.Action("Index", "Dashboard", new { area = "admin" })">@AdminResource.AdminHome</a>
        </output>
    }
</div>
<script>
document.addEventListener("error", function (e) {
    var t = e.target;
    if (t && t.classList && t.classList.contains("js-admin-search-img")) {
        t.style.display = "none";
        if (t.parentNode) {
            t.parentNode.classList.add("is-empty");
        }
    }
}, true);
</script>
