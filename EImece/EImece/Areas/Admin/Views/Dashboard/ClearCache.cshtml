@using Resources
@using System.Web
@{
    ViewBag.Title = AdminResource.Refresh;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var returnUrl = (ViewBag.ReturnUrl as string) ?? Url.Action("Index", "Dashboard", new { area = "admin" });
}

<output class="admin-refresh" aria-live="polite">
    <div class="admin-refresh__card">
        <div class="admin-refresh__orbit" aria-hidden="true">
            <span class="admin-refresh__planet"></span>
            <span class="admin-refresh__ring"></span>
            <span class="admin-refresh__ring admin-refresh__ring--delayed"></span>
        </div>
        <h1 class="admin-refresh__title">@AdminResource.Refresh</h1>
        <p class="admin-refresh__lead">Site önbelleği temizleniyor ve sayfalar yenileniyor…</p>
        <div class="admin-refresh__bar" aria-hidden="true">
            <span class="admin-refresh__bar-fill"></span>
        </div>
        <p class="admin-refresh__hint">Birazdan önceki sayfanıza yönlendirileceksiniz.</p>
        <a class="admin-refresh__skip" href="@returnUrl">Hemen devam et</a>
    </div>
</output>

<style>
    .admin-refresh {
        min-height: calc(100vh - 140px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background:
            radial-gradient(1200px 420px at 50% -10%, rgba(98, 176, 232, 0.18), transparent 60%),
            linear-gradient(180deg, #f5f7fa 0%, #eef2f7 100%);
    }

    .admin-refresh__card {
        width: min(420px, 100%);
        text-align: center;
        padding: 2.25rem 1.75rem 1.75rem;
        border: 1px solid #d9e2ec;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 18px 40px rgba(16, 42, 67, 0.08);
    }

    .admin-refresh__orbit {
        position: relative;
        width: 88px;
        height: 88px;
        margin: 0 auto 1.25rem;
    }

    .admin-refresh__planet {
        position: absolute;
        inset: 28px;
        border-radius: 50%;
        background: linear-gradient(145deg, #62b0e8, #2b6cb0);
        box-shadow: 0 0 0 6px rgba(98, 176, 232, 0.15);
        animation: admin-refresh-pulse 1.4s ease-in-out infinite;
    }

    .admin-refresh__ring {
        position: absolute;
        inset: 0;
        border-radius: 50%;
        border: 2px solid transparent;
        border-top-color: #2b6cb0;
        border-right-color: rgba(98, 176, 232, 0.55);
        animation: admin-refresh-spin 1.1s linear infinite;
    }

    .admin-refresh__ring--delayed {
        inset: 10px;
        border-top-color: #62b0e8;
        border-right-color: transparent;
        animation-duration: 1.6s;
        animation-direction: reverse;
    }

    .admin-refresh__title {
        margin: 0 0 0.4rem;
        font-size: 1.45rem;
        font-weight: 700;
        color: #102a43;
        font-family: "Source Sans 3", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    }

    .admin-refresh__lead {
        margin: 0 0 1.25rem;
        color: #486581;
        font-size: 0.98rem;
        line-height: 1.45;
    }

    .admin-refresh__bar {
        height: 6px;
        border-radius: 999px;
        background: #e4ebf3;
        overflow: hidden;
        margin-bottom: 0.85rem;
    }

    .admin-refresh__bar-fill {
        display: block;
        height: 100%;
        width: 0;
        border-radius: inherit;
        background: linear-gradient(90deg, #62b0e8, #2b6cb0);
        animation: admin-refresh-progress 2.2s ease-out forwards;
    }

    .admin-refresh__hint {
        margin: 0 0 1rem;
        color: #829ab1;
        font-size: 0.85rem;
    }

    .admin-refresh__skip {
        display: inline-block;
        color: #2b6cb0;
        font-weight: 600;
        text-decoration: none;
    }

    .admin-refresh__skip:hover,
    .admin-refresh__skip:focus {
        text-decoration: underline;
        color: #243b53;
    }

    @@keyframes admin-refresh-spin {
        to { transform: rotate(360deg); }
    }

    @@keyframes admin-refresh-pulse {
        0%, 100% { transform: scale(1); opacity: 1; }
        50% { transform: scale(0.92); opacity: 0.85; }
    }

    @@keyframes admin-refresh-progress {
        from { width: 0; }
        to { width: 100%; }
    }
</style>

<script>
    (function () {
        var returnUrl = '@Html.Raw(HttpUtility.JavaScriptStringEncode(returnUrl))';
        window.setTimeout(function () {
            window.location.href = returnUrl;
        }, 2300);
    })();
</script>
