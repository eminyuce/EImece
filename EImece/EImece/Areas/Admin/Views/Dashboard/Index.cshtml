@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@using System.Threading;
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Services.IServices;
@using Microsoft.AspNet.Identity;
@using System.Globalization;
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>@AdminResource.AdminPanelWelcome</h2>
<hr class="adminLine" />

@using (Html.BeginForm("SearchContent", "Dashboard", FormMethod.Get, new { @class = "admin-dashboard-search" }))
{
    <input type="text" name="searchContent"
           value="@Request.QueryString["searchContent"].ToStr()"
           id="searchTxt"
           data-provide="typehead"
           title="Aramaya başlamak için en az 2 karakter yazmalısınız"
           class="form-control"
           placeholder="@AdminResource.AdminMainSeachPlaceHolder"
           autocomplete="off">
    <button type="submit" class="btn btn-primary" title="@AdminResource.GridSearchButtonText">
        <span class="glyphicon glyphicon-search"></span>
        <span class="sr-only">@AdminResource.GridSearchButtonText</span>
    </button>
}

<div class="admin-dashboard-grid">
    <a class="admin-dashboard-tile" href="@Url.Action("Index","MainPageImages")">
        <i class="fa fa-picture-o" aria-hidden="true"></i>
        <span>@AdminResource.MainPageImages</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","Menus")">
        <i class="fa fa-bars" aria-hidden="true"></i>
        <span>@AdminResource.Menus</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","Products")">
        <i class="fa fa-cube" aria-hidden="true"></i>
        <span>@AdminResource.Products</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","ProductCategories")">
        <i class="fa fa-sitemap" aria-hidden="true"></i>
        <span>@AdminResource.ProductCategories</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","adminsettings")">
        <i class="fa fa-cogs" aria-hidden="true"></i>
        <span>@AdminResource.AdminSettings</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","customers")">
        <i class="fa fa-users" aria-hidden="true"></i>
        <span>@AdminResource.Customers</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","Orders")">
        <i class="fa fa-shopping-bag" aria-hidden="true"></i>
        <span>@AdminResource.Orders</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","brands")">
        <i class="fa fa-tags" aria-hidden="true"></i>
        <span>@AdminResource.Brands</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("SystemSettings","adminsettings")">
        <i class="fa fa-sliders" aria-hidden="true"></i>
        <span>@AdminResource.SystemSettings</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","MailTemplates")">
        <i class="fa fa-file-text-o" aria-hidden="true"></i>
        <span>@AdminResource.MailTemplates</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","Stories")">
        <i class="fa fa-newspaper-o" aria-hidden="true"></i>
        <span>@AdminResource.Stories</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","Report")">
        <i class="fa fa-bar-chart" aria-hidden="true"></i>
        <span>@AdminResource.Reports</span>
    </a>
    <a class="admin-dashboard-tile" href="@Url.Action("Index","Coupons")">
        <i class="fa fa-ticket" aria-hidden="true"></i>
        <span>@AdminResource.Coupons</span>
    </a>
    <a class="admin-dashboard-tile" href="https://merchant.iyzipay.com/auth/login" target="_blank" rel="noopener noreferrer">
        <i class="fa fa-credit-card" aria-hidden="true"></i>
        <span>iyzico</span>
    </a>
</div>
