@using EImece.Domain
@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using EImece.Domain.Services.IServices
@using Resources
@{
    ViewBag.Title = AdminResource.AdminHome;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    Setting isProductPriceEnable = ViewBag.IsProductPriceEnable;
    var productPriceEnabled = isProductPriceEnable == null || isProductPriceEnable.SettingValue.ToBool(true);
    var settingService = DependencyResolver.Current.GetService<ISettingService>();
    var companyName = settingService != null
        ? settingService.GetSettingByKey(Constants.CompanyName).ToStr()
        : (ViewBag.CompanyNameSetting as string ?? "");
    var searchValue = Request.QueryString["searchContent"].ToStr();
}

<div class="admin-home" lang="tr">
    <header class="admin-home__hero">
        <div class="admin-home__hero-text">
            <p class="admin-home__eyebrow">@(string.IsNullOrWhiteSpace(companyName) ? "Yönetim paneli" : companyName)</p>
            <h1 class="admin-home__title">@AdminResource.AdminPanelWelcome</h1>
            <p class="admin-home__lead">Katalog ve içerik işlemlerine buradan hızlıca geçin.</p>
        </div>
        <div class="admin-home__hero-aside">
            <a class="admin-home__guide-link" href="@Url.Action("OurSiteFeatures", "Dashboard", new { area = "admin" })">
                <i class="fa fa-book" aria-hidden="true"></i>
                @AdminResource.OurSiteFeatures
            </a>
        </div>
    </header>

    <form class="admin-home__search" action="@Url.Action("SearchContent", "Dashboard", new { area = "admin" })" method="get" role="search">
        <label class="visually-hidden" for="searchTxt">@AdminResource.AdminMainSeachPlaceHolder</label>
        <div class="admin-home__search-box">
            <span class="admin-home__search-icon" aria-hidden="true"><i class="fa fa-search"></i></span>
            <input type="text"
                   name="searchContent"
                   value="@searchValue"
                   id="searchTxt"
                   data-provide="typehead"
                   title="Aramaya başlamak için en az 2 karakter yazmalısınız"
                   class="form-control admin-home__search-input"
                   placeholder="@AdminResource.AdminMainSeachPlaceHolder"
                   autocomplete="off" />
            <button type="submit" class="btn btn-primary admin-home__search-btn" title="Ara" aria-label="Ara">
                <i class="fa fa-search admin-home__search-btn-icon" aria-hidden="true"></i>
                <span class="admin-home__search-btn-label">Ara</span>
            </button>
        </div>
    </form>

    @if (ViewBag.IyzicoCredentialsMissing == true)
    {
        <div class="alert alert-warning" role="alert">
            Iyzico ödeme anahtarları (IyzicoApiKey / IyzicoSecretKey) boş. Ödeme formu PlaceOrder sayfasında yüklenmez.
            Sandbox veya canlı anahtarları IIS web.config veya ortam değişkenlerine ekleyin.
        </div>
    }

    <section class="admin-home__section" aria-labelledby="admin-home-content">
        <h2 id="admin-home-content" class="admin-home__section-title">İçerik ve vitrin</h2>
        <div class="admin-home__grid">
            <a class="admin-home__tile" href="@Url.Action("Index", "MainPageImages", new { area = "admin" })">
                <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-picture-o"></i></span>
                <span class="admin-home__tile-body">
                    <span class="admin-home__tile-title">Ana sayfa görselleri</span>
                    <span class="admin-home__tile-desc">Kayan banner ve vitrin görselleri</span>
                </span>
                <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
            </a>
            <a class="admin-home__tile" href="@Url.Action("Index", "Menus", new { area = "admin" })">
                <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-bars"></i></span>
                <span class="admin-home__tile-body">
                    <span class="admin-home__tile-title">@AdminResource.Menus</span>
                    <span class="admin-home__tile-desc">Hakkımızda, iletişim ve diğer sayfalar</span>
                </span>
                <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
            </a>
        </div>
    </section>

    <section class="admin-home__section" aria-labelledby="admin-home-catalog">
        <h2 id="admin-home-catalog" class="admin-home__section-title">@AdminResource.Catalog</h2>
        <div class="admin-home__grid">
            <a class="admin-home__tile" href="@Url.Action("Index", "Products", new { area = "admin" })">
                <span class="admin-home__tile-icon admin-home__tile-icon--accent" aria-hidden="true"><i class="fa fa-cube"></i></span>
                <span class="admin-home__tile-body">
                    <span class="admin-home__tile-title">@AdminResource.Products</span>
                    <span class="admin-home__tile-desc">@(productPriceEnabled ? "Ürün ekle, düzenle ve fiyatlandır" : "Ürünleri listeleyin ve düzenleyin")</span>
                </span>
                <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
            </a>
            <a class="admin-home__tile" href="@Url.Action("Index", "ProductCategories", new { area = "admin" })">
                <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-sitemap"></i></span>
                <span class="admin-home__tile-body">
                    <span class="admin-home__tile-title">@AdminResource.ProductCategories</span>
                    <span class="admin-home__tile-desc">Kategori ağacı ve sıralama</span>
                </span>
                <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
            </a>
            <a class="admin-home__tile" href="@Url.Action("Index", "Brands", new { area = "admin" })">
                <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-tags"></i></span>
                <span class="admin-home__tile-body">
                    <span class="admin-home__tile-title">@AdminResource.Brands</span>
                    <span class="admin-home__tile-desc">Marka listesi ve görselleri</span>
                </span>
                <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
            </a>
        </div>
    </section>

    @if (productPriceEnabled)
    {
        <section class="admin-home__section" aria-labelledby="admin-home-sales">
            <h2 id="admin-home-sales" class="admin-home__section-title">@AdminResource.Sales</h2>
            <div class="admin-home__grid">
                <a class="admin-home__tile" href="@Url.Action("Index", "Orders", new { area = "admin" })">
                    <span class="admin-home__tile-icon admin-home__tile-icon--accent" aria-hidden="true"><i class="fa fa-shopping-bag"></i></span>
                    <span class="admin-home__tile-body">
                        <span class="admin-home__tile-title">@AdminResource.Orders</span>
                        <span class="admin-home__tile-desc">Sipariş durumu ve kargo takibi</span>
                    </span>
                    <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
                </a>
                <a class="admin-home__tile" href="@Url.Action("Index", "Customers", new { area = "admin" })">
                    <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-users"></i></span>
                    <span class="admin-home__tile-body">
                        <span class="admin-home__tile-title">@AdminResource.Customers</span>
                        <span class="admin-home__tile-desc">Üye ve müşteri kayıtları</span>
                    </span>
                    <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
                </a>
                <a class="admin-home__tile" href="@Url.Action("Index", "AdminSettings", new { area = "admin" })">
                    <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-truck"></i></span>
                    <span class="admin-home__tile-body">
                        <span class="admin-home__tile-title">Kargo ve mağaza</span>
                        <span class="admin-home__tile-desc">Kargo açıklaması ve mağaza bilgileri</span>
                    </span>
                    <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
                </a>
                <a class="admin-home__tile" href="https://merchant.iyzipay.com/auth/login" target="_blank" rel="noopener noreferrer">
                    <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-credit-card"></i></span>
                    <span class="admin-home__tile-body">
                        <span class="admin-home__tile-title">iyzico</span>
                        <span class="admin-home__tile-desc">Ödeme paneli (yeni sekme)</span>
                    </span>
                    <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
                </a>
            </div>
        </section>
    }

    <section class="admin-home__section" aria-labelledby="admin-home-system">
        <h2 id="admin-home-system" class="admin-home__section-title">Sistem</h2>
        <div class="admin-home__grid">
            <a class="admin-home__tile" href="@Url.Action("Index", "AdminSettings", new { area = "admin" })">
                <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-sliders"></i></span>
                <span class="admin-home__tile-body">
                    <span class="admin-home__tile-title">Yönetici ayarları</span>
                    <span class="admin-home__tile-desc">Şirket ve genel site bilgileri</span>
                </span>
                <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
            </a>
            <a class="admin-home__tile" href="@Url.Action("SystemSettings", "AdminSettings", new { area = "admin" })">
                <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-cogs"></i></span>
                <span class="admin-home__tile-body">
                    <span class="admin-home__tile-title">@AdminResource.SystemSettings</span>
                    <span class="admin-home__tile-desc">@(productPriceEnabled ? "Fiyat, SEO ve teknik ayarlar" : "Listeleme modu, SEO ve teknik ayarlar")</span>
                </span>
                <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
            </a>
            <a class="admin-home__tile" href="@Url.Action("Index", "MailTemplates", new { area = "admin" })">
                <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-envelope-o"></i></span>
                <span class="admin-home__tile-body">
                    <span class="admin-home__tile-title">@AdminResource.MailTemplates</span>
                    <span class="admin-home__tile-desc">E-posta şablonlarını düzenleyin</span>
                </span>
                <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
            </a>
            <a class="admin-home__tile" href="@Url.Action("Index", "Users", new { area = "admin" })">
                <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-user"></i></span>
                <span class="admin-home__tile-body">
                    <span class="admin-home__tile-title">@AdminResource.Users</span>
                    <span class="admin-home__tile-desc">Yönetici ve panel kullanıcıları</span>
                </span>
                <span class="admin-home__tile-chevron" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
            </a>
        </div>
    </section>

    <hr style="border:0;border-top:1px solid #d9e2ec;margin:2rem 0;" />

    <section class="admin-home__section" aria-labelledby="admin-home-cache">
        <h2 id="admin-home-cache" class="admin-home__section-title">Önbellek yönetimi</h2>
        <p class="admin-home__lead" style="margin-bottom:0.75rem;">
            Storefront önbelleğini hedefli olarak temizleyin. Mağaza tarafı bir sonraki istekte güncel veriyi veritabanından yeniden yükler.
        </p>
        <div class="admin-home__grid">
            @using (Html.BeginForm("InvalidateCache", "Dashboard", new { area = "admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="target" value="products" />
                <button type="submit" class="admin-home__tile" style="border:none;cursor:pointer;text-align:inherit;width:100%;">
                    <span class="admin-home__tile-icon admin-home__tile-icon--accent" aria-hidden="true"><i class="fa fa-refresh"></i></span>
                    <span class="admin-home__tile-body">
                        <span class="admin-home__tile-title">Ürün ve fiyat önbelleği</span>
                        <span class="admin-home__tile-desc">Ürün listeleri, detaylar, arama ve fiyatlar</span>
                    </span>
                </button>
            }
            @using (Html.BeginForm("InvalidateCache", "Dashboard", new { area = "admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="target" value="categories" />
                <button type="submit" class="admin-home__tile" style="border:none;cursor:pointer;text-align:inherit;width:100%;">
                    <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-sitemap"></i></span>
                    <span class="admin-home__tile-body">
                        <span class="admin-home__tile-title">Kategori önbelleği</span>
                        <span class="admin-home__tile-desc">Kategori ağacı ve kategori sayfaları</span>
                    </span>
                </button>
            }
            @using (Html.BeginForm("InvalidateCache", "Dashboard", new { area = "admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="target" value="settings" />
                <button type="submit" class="admin-home__tile" style="border:none;cursor:pointer;text-align:inherit;width:100%;">
                    <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-sliders"></i></span>
                    <span class="admin-home__tile-body">
                        <span class="admin-home__tile-title">Ayar önbelleği</span>
                        <span class="admin-home__tile-desc">Mağaza ayarları ve site yapılandırması</span>
                    </span>
                </button>
            }
            @using (Html.BeginForm("InvalidateCache", "Dashboard", new { area = "admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="target" value="content" />
                <button type="submit" class="admin-home__tile" style="border:none;cursor:pointer;text-align:inherit;width:100%;">
                    <span class="admin-home__tile-icon" aria-hidden="true"><i class="fa fa-file-text-o"></i></span>
                    <span class="admin-home__tile-body">
                        <span class="admin-home__tile-title">İçerik önbelleği</span>
                        <span class="admin-home__tile-desc">Menüler, hikayeler, bannerlar, SSS, etiketler</span>
                    </span>
                </button>
            }
        </div>
        @using (Html.BeginForm("InvalidateCache", "Dashboard", new { area = "admin" }, FormMethod.Post, new { style = "margin-top:1rem;" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="target" value="all" />
            <button type="submit" class="btn btn-danger">
                <i class="fa fa-bomb" aria-hidden="true"></i>
                Tüm storefront önbelleğini temizle
            </button>
            <span style="color:#829ab1;font-size:0.85rem;margin-left:0.5rem;">
                Tam temizleme + arka planda sayfa yeniden ısınma (warm-up).
            </span>
        }
    </section>
</div>
