@model EImece.Domain.Models.AdminModels.SettingModel
@using Resources;
@using EImece.Domain.Helpers;
@{
    ViewBag.Title = AdminResource.AdminGeneralSettings;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    EImece.Domain.Entities.Setting isProductPriceEnable = ViewBag.IsProductPriceEnable;
    var productPriceEnabled = isProductPriceEnable == null || isProductPriceEnable.SettingValue.ToBool(true);

    var activeTab = productPriceEnabled ? "cargo" : "company";
}

@Html.AdminBreadcrumb(AdminResource.AdminGeneralSettings)
<h2 class="admin-page-title">@AdminResource.AdminGeneralSettings</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "generalSettingsHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>@AdminResource.AdminGeneralSettingsHelpLead</li>
    <li><strong>@AdminResource.CompanyAndContactInfo:</strong> @AdminResource.CompanyInfoAndContactHelp</li>
    @if (productPriceEnabled)
    {
        <li><strong>@AdminResource.CargoSettings:</strong> @AdminResource.AdminGeneralSettingsCargoHelp</li>
    }
    <li><strong>@AdminResource.SeoSettings:</strong> @AdminResource.AdminGeneralSettingsSeoHelp</li>
    <li><strong>@AdminResource.FooterSettings:</strong> @AdminResource.AdminGeneralSettingsFooterHelp</li>
</ul>
<p style="margin-top: 12px; margin-bottom: 0;"><strong>@AdminResource.Important:</strong> @AdminResource.AdminGeneralSettingsSaveWarning</p>
@Html.Partial("_AdminHelpAccordionEnd")

@using (Html.BeginForm("Index", "AdminSettings"))
{
    @Html.AntiForgeryToken()

    <div class="row mb-3 admin-settings-save-row">
        <div class="col-md-9">
            @Html.AdminValidationSummary()
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-success w-100">
                <i class="fa-solid fa-floppy-disk"></i> @AdminResource.SaveButtonText
            </button>
        </div>
    </div>

    <div class="row">
        <!-- Vertical Tabs Menu -->
        <div class="col-md-3">
            <ul class="nav nav-pills flex-column admin-settings-pills" id="settingsTabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "company" ? "active" : "")" data-bs-toggle="pill" href="#tab-company" role="tab" aria-selected="@(activeTab == "company" ? "true" : "false")">
                        <i class="fa-regular fa-building me-2" aria-hidden="true"></i> @AdminResource.CompanyAndContactInfo
                    </a>
                </li>
                @if (productPriceEnabled)
                {
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "cargo" ? "active" : "")" data-bs-toggle="pill" href="#tab-cargo" role="tab" aria-selected="@(activeTab == "cargo" ? "true" : "false")">
                            <i class="fa-solid fa-paper-plane me-2" aria-hidden="true"></i> @AdminResource.CargoSettings
                        </a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link @(activeTab == "seo" ? "active" : "")" data-bs-toggle="pill" href="#tab-seo" role="tab" aria-selected="@(activeTab == "seo" ? "true" : "false")">
                        <i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i> @AdminResource.SeoSettings
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="pill" href="#tab-footer" role="tab" aria-selected="false">
                        <i class="fa-solid fa-rectangle-list me-2" aria-hidden="true"></i> @AdminResource.FooterSettings
                    </a>
                </li>
            </ul>
        </div>

        <!-- Vertical Tabs Content -->
        <div class="col-md-9">
            <div class="tab-content">

                <!-- Company & Contact Settings -->
                <div id="tab-company" class="tab-pane fade @(activeTab == "company" ? "show active" : "")" role="tabpanel">
                    <div class="card">
                        <div class="card-header"><h3 class="h6 mb-0">@AdminResource.CompanyAndContactInfo</h3></div>
                        <div class="card-body">
                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.CompanyName, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.CompanyName, new { htmlAttributes = new { @class = "form-control", placeholder = "EImece E-Ticaret A.S." } })
                                    @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.CompanyOfficialTitleBrandHelp</p>
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.WebSiteCompanyEmailAddress, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.WebSiteCompanyEmailAddress, new { htmlAttributes = new { @class = "form-control", type = "email", placeholder = "info@eimece.test" } })
                                    @Html.ValidationMessageFor(model => model.WebSiteCompanyEmailAddress, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.WebSiteCompanyEmailAddressRequired</p>
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.WebSiteCompanyPhoneAndLocation, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.WebSiteCompanyPhoneAndLocation, new { htmlAttributes = new { @class = "form-control", placeholder = "+90 216 555 01 23 | Kadikoy / Istanbul" } })
                                    @Html.ValidationMessageFor(model => model.WebSiteCompanyPhoneAndLocation, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.PhoneNumberAndCallCenter</p>
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.CompanyAddress, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.TextAreaFor(model => model.CompanyAddress, 2, 50, new { @class = "form-control", placeholder = "Caferaga Mah. Moda Cad. No:42 Kadikoy / Istanbul" })
                                    @Html.ValidationMessageFor(model => model.CompanyAddress, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.CompanyPhysicalAddressHelp</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (productPriceEnabled)
                {
                    <!-- Cargo Settings -->
                    <div id="tab-cargo" class="tab-pane fade @(activeTab == "cargo" ? "show active" : "")" role="tabpanel">
                        <div class="card">
                            <div class="card-header"><h3 class="h6 mb-0">@AdminResource.CargoSettings</h3></div>
                            <div class="card-body">
                                <div class="form-group row mb-3">
                                    @Html.AdminLabelFor(model => model.CargoCompany, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.EditorFor(model => model.CargoCompany, new { htmlAttributes = new { @class = "form-control" } })
                                    </div>
                                </div>
                                <div class="form-group row mb-3">
                                    @Html.AdminLabelFor(model => model.CargoPrice, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.EditorFor(model => model.CargoPrice, new { htmlAttributes = new { @class = "form-control" } })
                                    </div>
                                </div>
                                <div class="form-group row mb-3">
                                    @Html.AdminLabelFor(model => model.BasketMinTotalPriceForCargo, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.EditorFor(model => model.BasketMinTotalPriceForCargo, new { htmlAttributes = new { @class = "form-control" } })
                                    </div>
                                </div>
                                <div class="form-group row mb-3">
                                    @Html.AdminLabelFor(model => model.CargoDescription, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                    <div class="col-md-9">
                                        @Html.TextAreaFor(model => model.CargoDescription, 3, 50, new { @class = "form-control" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- SEO Settings -->
                <div id="tab-seo" class="tab-pane fade @(activeTab == "seo" ? "show active" : "")" role="tabpanel">
                    <div class="card">
                        <div class="card-header"><h3 class="h6 mb-0">@AdminResource.SeoSettings</h3></div>
                        <div class="card-body">
                            <div class="form-group row mb-3">
                                <label class="col-form-label col-md-3" for="SiteIndexMetaTitle">
                                    @Html.DisplayNameFor(model => model.SiteIndexMetaTitle)
                                    @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.SiteIndexMetaTitleTooltip } })
                                </label>
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.SiteIndexMetaTitle, new { htmlAttributes = new { @class = "form-control", placeholder = "Örn: Firma Adı - Slogan / Ana Hizmetler", title = AdminResource.SiteIndexMetaTitleTooltip } })
                                    @Html.ValidationMessageFor(model => model.SiteIndexMetaTitle, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.SiteIndexMetaTitleTooltip</p>
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                <label class="col-form-label col-md-3" for="SiteIndexMetaKeywords">
                                    @Html.DisplayNameFor(model => model.SiteIndexMetaKeywords)
                                    @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.SiteIndexMetaKeywordsTooltip } })
                                </label>
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.SiteIndexMetaKeywords, new { htmlAttributes = new { @class = "form-control", placeholder = "Örn: e-ticaret, led ampul, aydınlatma, toptan", title = AdminResource.SiteIndexMetaKeywordsTooltip } })
                                    @Html.ValidationMessageFor(model => model.SiteIndexMetaKeywords, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.SiteIndexMetaKeywordsTooltip</p>
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                <label class="col-form-label col-md-3" for="SiteIndexMetaDescription">
                                    @Html.DisplayNameFor(model => model.SiteIndexMetaDescription)
                                    @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.SiteIndexMetaDescriptionTooltip } })
                                </label>
                                <div class="col-md-9">
                                    @Html.TextAreaFor(model => model.SiteIndexMetaDescription, 3, 50, new { @class = "form-control", placeholder = "Sitenizi tanıtan kısa ve etkili bir açıklama girin...", title = AdminResource.SiteIndexMetaDescriptionTooltip })
                                    @Html.ValidationMessageFor(model => model.SiteIndexMetaDescription, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.SiteIndexMetaDescriptionTooltip</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Settings -->
                <div id="tab-footer" class="tab-pane fade" role="tabpanel">
                    <div class="card">
                        <div class="card-header"><h3 class="h6 mb-0">@AdminResource.FooterSettings</h3></div>
                        <div class="card-body">
                            <div class="form-group row mb-3">
                                <label class="col-form-label col-md-3" for="FooterDescription">
                                    @Html.DisplayNameFor(model => model.FooterDescription)
                                    @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.FooterDescriptionTooltip } })
                                </label>
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.FooterDescription, new { htmlAttributes = new { @class = "form-control", placeholder = "Örn: Firma — Seçili markalar, özenli teslimat.", title = AdminResource.FooterDescriptionTooltip } })
                                    @Html.ValidationMessageFor(model => model.FooterDescription, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.FooterDescriptionTooltip</p>
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                <label class="col-form-label col-md-3" for="FooterEmailListDescription">
                                    @Html.DisplayNameFor(model => model.FooterEmailListDescription)
                                    @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.FooterEmailListDescriptionTooltip } })
                                </label>
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.FooterEmailListDescription, new { htmlAttributes = new { @class = "form-control", placeholder = "Örn: Kampanya ve yeniliklerden haberdar olmak için abone olun.", title = AdminResource.FooterEmailListDescriptionTooltip } })
                                    @Html.ValidationMessageFor(model => model.FooterEmailListDescription, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.FooterEmailListDescriptionTooltip</p>
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                <label class="col-form-label col-md-3" for="FooterHtmlDescription">
                                    @Html.DisplayNameFor(model => model.FooterHtmlDescription)
                                    @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.FooterHtmlDescriptionTooltip } })
                                </label>
                                <div class="col-md-9">
                                    @Html.TextAreaFor(model => model.FooterHtmlDescription, 10, 50, new { @class = "form-control", placeholder = "<p>© Firma Adı. Tüm hakları saklıdır.</p>", title = AdminResource.FooterHtmlDescriptionTooltip })
                                    @Html.ValidationMessageFor(model => model.FooterHtmlDescription, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.FooterHtmlDescriptionTooltip</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

<script>
    (function () {
        function showPill(hash) {
            if (!hash || !window.bootstrap || !bootstrap.Tab) { return; }
            var el = document.querySelector("#settingsTabs a[href='" + hash + "']");
            if (el) { bootstrap.Tab.getOrCreateInstance(el).show(); }
        }
        document.addEventListener("DOMContentLoaded", function () {
            if (window.location.hash) { showPill(window.location.hash); }
            document.querySelectorAll("#settingsTabs a[data-bs-toggle='pill']").forEach(function (link) {
                link.addEventListener("shown.bs.tab", function () {
                    if (this.hash) { history.replaceState(null, "", this.hash); }
                });
            });
        });
    })();
</script>

@Html.Partial("_AdminInitTooltips")