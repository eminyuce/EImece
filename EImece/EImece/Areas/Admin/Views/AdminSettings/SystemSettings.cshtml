@model EImece.Domain.Models.AdminModels.SystemSettingModel
@using Resources;
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>@AdminResource.AdminSystemSettings</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "systemSettingsHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada sitenizin <strong>genel sistem ve yapılandırma ayarlarını</strong> yönetebilirsiniz.</li>
    <li><strong>Genel & SEO:</strong> Bakım modu, arama motoru indeksleme izni, aktif tema ve ürün görünürlük ayarları.</li>
    <li><strong>Firma & İletişim:</strong> Firma unvanı, adresi, iletişim e-postası ve kargo sepet limitleri.</li>
    <li><strong>Tasarım & PWA:</strong> PWA manifest renkleri, başlangıç URL'si ve tema tercihlerini yönetebilirsiniz.</li>
    <li><strong>Medya & Yükleme:</strong> Görsel sıkıştırma kalitesi, maksimum boyutlar ve WebP politikaları.</li>
    <li><strong>E-Ticaret & Ödeme:</strong> Ödeme sağlayıcı, taksit seçenekleri ve alıcı kimlik ayarları.</li>
    <li><strong>Güvenlik & Rate Limiting:</strong> Captcha sağlayıcı, reCAPTCHA anahtarı ve istek limitleri (Rate Limiting).</li>
    <li><strong>SMTP E-Posta:</strong> Giden e-posta sunucusu ayarları ve test e-postası gönderimi.</li>
    <li><strong>Sosyal Medya & Scriptler:</strong> Sosyal medya profilleri ve Google Analytics / harita scriptleri.</li>
    <li><strong>Sistem Araçları:</strong> Metrikler, sağlık kontrolleri ve JSON veri yedekleme.</li>
</ul>
<p style="margin-top: 12px; margin-bottom: 0;"><strong>Önemli:</strong> Yaptığınız değişikliklerin geçerli olması için kaydet butonuna tıklamayı unutmayın.</p>
@Html.Partial("_AdminHelpAccordionEnd")

@using (Html.BeginForm("SystemSettings", "AdminSettings"))
{
    @Html.AntiForgeryToken()

    <div class="row" style="margin-bottom: 20px;">
        <div class="col-md-9">
            @Html.AdminValidationSummary()
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-success w-100 btn-lg">
                <i class="fa fa-save"></i> @AdminResource.SaveButtonText
            </button>
        </div>
    </div>

    <div class="row">
        <!-- Vertical Tabs Menu -->
        <div class="col-md-3">
            <ul class="nav nav-pills flex-column" id="settingsTabs" style="border: 1px solid #ddd; border-radius: 4px; background-color: #f9f9f9; padding: 10px 0;">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="pill" href="#tab-general">
                        <i class="fa fa-cog" style="margin-right:8px;"></i> Genel & SEO
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="pill" href="#tab-company">
                        <i class="fa fa-briefcase" style="margin-right:8px;"></i> @AdminResource.CompanyAdminSettings
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="pill" href="#tab-design">
                        <i class="fa fa-paint-brush" style="margin-right:8px;"></i> Tasarım & PWA
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="pill" href="#tab-media">
                        <i class="fa fa-picture-o" style="margin-right:8px;"></i> Medya & Yükleme
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-payments" id="nav-tab-payments">
                        <span><i class="fa fa-credit-card" style="margin-right:8px;"></i> E-Ticaret &amp; Ödeme</span>
                        <span class="badge bg-secondary payment-disabled-badge" style="display:none; font-size:10px;">Kilitli</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="pill" href="#tab-security">
                        <i class="fa fa-shield" style="margin-right:8px;"></i> Güvenlik & Rate Limit
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="pill" href="#tab-smtp">
                        <i class="fa fa-envelope" style="margin-right:8px;"></i> @AdminResource.SmtpEmailSettings
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="pill" href="#tab-social">
                        <i class="fa fa-thumbs-up" style="margin-right:8px;"></i> @AdminResource.SocialMediaSetttings
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="pill" href="#tab-scripts">
                        <i class="fa fa-code" style="margin-right:8px;"></i> Scriptler & Dış Bağlantılar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="pill" href="#tab-tools">
                        <i class="fa fa-wrench" style="margin-right:8px;"></i> Sistem Araçları
                    </a>
                </li>
            </ul>
        </div>

        <!-- Vertical Tabs Content -->
        <div class="col-md-9">
            <div class="tab-content form-horizontal">
                
                <!-- 1. General & SEO Settings -->
                <div id="tab-general" class="tab-pane fade show active">
                    <div class="card mb-3">
                        <div class="card-header"><h3 class="card-title">Site Durumu & SEO</h3></div>
                        <div class="card-body">
                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.IsSiteUnderConstruction, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(model => model.IsSiteUnderConstruction, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="IsSiteUnderConstruction">Bakım modu aktif (Ziyaretçilere bakım sayfası gösterilir ve arama motorlarına noindex verilir)</label>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsSiteUnderConstruction, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.AllowSearchEngineIndexing, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(model => model.AllowSearchEngineIndexing, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="AllowSearchEngineIndexing">Arama motoru indekslemesine izin ver (Google/Bing robots.txt ve meta tag izni)</label>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AllowSearchEngineIndexing, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ActiveDesign, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ActiveDesign, new List<SelectListItem>
                                    {
                                        new SelectListItem { Text = "Crizal (Yeşil Kurumsal Tema)", Value = "Crizal" },
                                        new SelectListItem { Text = "Modern (Minimal Beyaz Tema)", Value = "Modern" }
                                    }, new { @class = "form-select" })
                                    @Html.ValidationMessageFor(model => model.ActiveDesign, "", new { @class = "text-danger" })
                                    <p class="form-text">Ön yüz vitrin teması.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header"><h3 class="card-title">Ürün & İçerik Tercihleri</h3></div>
                        <div class="card-body">
                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.IsProductPriceEnable, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(model => model.IsProductPriceEnable, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="IsProductPriceEnable">Ürün fiyatları ve sepete ekleme aktif</label>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsProductPriceEnable, "", new { @class = "text-danger" })
                                    <p class="form-text">Kapalı olduğunda site katalog/tanıtım modunda çalışır.</p>
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.IsProductReviewEnable, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="form-check">
                                        @Html.CheckBoxFor(model => model.IsProductReviewEnable, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="IsProductReviewEnable">Ürün yorumları ve puanlama aktif</label>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsProductReviewEnable, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.GridPageSizeNumber, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.GridPageSizeNumber, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1", max = "1000" } })
                                    @Html.ValidationMessageFor(model => model.GridPageSizeNumber, "", new { @class = "text-danger" })
                                    <p class="form-text">Yönetici paneli listelerinde sayfa başına gösterilecek satır sayısı (Varsayılan: 100).</p>
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ProductShortDescriptionPreviewLength, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ProductShortDescriptionPreviewLength, new { htmlAttributes = new { @class = "form-control", type = "number", min = "10", max = "5000" } })
                                    @Html.ValidationMessageFor(model => model.ProductShortDescriptionPreviewLength, "", new { @class = "text-danger" })
                                    <p class="form-text">Ürün detay sayfasında 'Devamını Gör...' butonundan önce gösterilecek karakter sayısı (Varsayılan: 180).</p>
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ProductPriceFilterSetting, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.Partial("_ProductPriceFilterEditor", Model.ProductPriceFilterSetting)
                                    @Html.ValidationMessageFor(model => model.ProductPriceFilterSetting, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.PaymentDetailHtml, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.TextAreaFor(model => model.PaymentDetailHtml, 10, 50, new { @class = "form-control", placeholder = "Ürün detay sayfası Ödeme sekmesinde gösterilecek HTML" })
                                    @Html.ValidationMessageFor(model => model.PaymentDetailHtml, "", new { @class = "text-danger" })
                                    <p class="form-text">Ürün detay sayfasındaki Ödeme Bilgisi sekmesinde gösterilir.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Company Settings -->
                <div id="tab-company" class="tab-pane fade">
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">@AdminResource.CompanyAdminSettings</h3></div>
                        <div class="card-body">
                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.CompanyName, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.CompanyName, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.CompanyName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.CompanyAddress, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.CompanyAddress, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.CompanyAddress, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.WebSiteCompanyPhoneAndLocation, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.WebSiteCompanyPhoneAndLocation, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.WebSiteCompanyPhoneAndLocation, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.WebSiteCompanyEmailAddress, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.WebSiteCompanyEmailAddress, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.WebSiteCompanyEmailAddress, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.BasketMinTotalPriceForCargo, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.BasketMinTotalPriceForCargo, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
                                    @Html.ValidationMessageFor(model => model.BasketMinTotalPriceForCargo, "", new { @class = "text-danger" })
                                    <p class="form-text">Ücretsiz kargo için minimum sepet tutarı.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Design & PWA Settings -->
                <div id="tab-design" class="tab-pane fade">
                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <h3 class="card-title mb-0">PWA &amp; Web App Manifest</h3>
                            <a href="@Url.Content("~/manifest.json")" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" id="btnPreviewManifest">
                                <i class="fa fa-external-link me-1"></i> manifest.json Görüntüle / Test Et
                            </a>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="small">
                                    <i class="fa fa-info-circle me-1"></i>
                                    PWA manifest yapılandırmanızı canlı olarak incelemek için:
                                    <a href="@Url.Content("~/manifest.json")" target="_blank" rel="noopener noreferrer" class="fw-bold text-decoration-underline ms-1">
                                        /manifest.json <i class="fa fa-external-link small"></i>
                                    </a>
                                </div>
                                <a href="@Url.Content("~/manifest.json")" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">
                                    Canlı Sonucu Gör
                                </a>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ThemeColor, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.ThemeColor, new { htmlAttributes = new { @class = "form-control", placeholder = "#1789F9" } })
                                        <span class="input-group-text p-1">
                                            <input type="color" class="form-control form-control-color border-0" style="width:36px;height:30px;padding:0;" onchange="$('#ThemeColor').val(this.value);" />
                                        </span>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.ThemeColor, "", new { @class = "text-danger" })
                                    <p class="form-text">Tarayıcı adres çubuğu ve PWA başlık rengi (Hex, örn: #067a36 veya #1789F9).</p>
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ManifestBackgroundColor, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.ManifestBackgroundColor, new { htmlAttributes = new { @class = "form-control", placeholder = "#ffffff" } })
                                        <span class="input-group-text p-1">
                                            <input type="color" class="form-control form-control-color border-0" style="width:36px;height:30px;padding:0;" onchange="$('#ManifestBackgroundColor').val(this.value);" />
                                        </span>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.ManifestBackgroundColor, "", new { @class = "text-danger" })
                                    <p class="form-text">PWA açılış ekranı (Splash Screen) arka plan rengi.</p>
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ManifestDisplay, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ManifestDisplay, new List<SelectListItem>
                                    {
                                        new SelectListItem { Text = "standalone (Bağımsız Uygulama Penceresi)", Value = "standalone" },
                                        new SelectListItem { Text = "fullscreen (Tam Ekran)", Value = "fullscreen" },
                                        new SelectListItem { Text = "minimal-ui (Minimal Tarayıcı Kontrolleri)", Value = "minimal-ui" },
                                        new SelectListItem { Text = "browser (Standart Tarayıcı)", Value = "browser" }
                                    }, new { @class = "form-select" })
                                    @Html.ValidationMessageFor(model => model.ManifestDisplay, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ManifestOrientation, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.DropDownListFor(model => model.ManifestOrientation, new List<SelectListItem>
                                    {
                                        new SelectListItem { Text = "portrait (Dikey)", Value = "portrait" },
                                        new SelectListItem { Text = "landscape (Yatay)", Value = "landscape" },
                                        new SelectListItem { Text = "any (Otomatik / Serbest)", Value = "any" }
                                    }, new { @class = "form-select" })
                                    @Html.ValidationMessageFor(model => model.ManifestOrientation, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ManifestStartUrl, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ManifestStartUrl, new { htmlAttributes = new { @class = "form-control", placeholder = "/" } })
                                    @Html.ValidationMessageFor(model => model.ManifestStartUrl, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ManifestFallbackName, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ManifestFallbackName, new { htmlAttributes = new { @class = "form-control", placeholder = "Web App" } })
                                    @Html.ValidationMessageFor(model => model.ManifestFallbackName, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ManifestShortNameMaxLength, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ManifestShortNameMaxLength, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1", max = "100" } })
                                    @Html.ValidationMessageFor(model => model.ManifestShortNameMaxLength, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- 4. Media & Image Upload Policies -->
                <div id="tab-media" class="tab-pane fade">
                    <div class="card mb-3">
                        <div class="card-header"><h3 class="card-title">Varsayılan Boyutlar</h3></div>
                        <div class="card-body">
                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.DefaultImageWidth, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.DefaultImageWidth, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                                    @Html.ValidationMessageFor(model => model.DefaultImageWidth, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.DefaultImageHeight, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.DefaultImageHeight, new { htmlAttributes = new { @class = "form-control", type = "number" } })
                                    @Html.ValidationMessageFor(model => model.DefaultImageHeight, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-3">
                        <div class="card-header"><h3 class="card-title">Görsel Yükleme ve Sıkıştırma Politikaları</h3></div>
                        <div class="card-body">
                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ImageUploadMaxWidth, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ImageUploadMaxWidth, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
                                    @Html.ValidationMessageFor(model => model.ImageUploadMaxWidth, "", new { @class = "text-danger" })
                                    <p class="form-text">Tam boyutlu görseller için maksimum genişlik (px). 0 = sınır yok.</p>
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ImageUploadMaxHeight, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ImageUploadMaxHeight, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } })
                                    @Html.ValidationMessageFor(model => model.ImageUploadMaxHeight, "", new { @class = "text-danger" })
                                    <p class="form-text">Tam boyutlu görseller için maksimum yükseklik (px). 0 = sınır yok.</p>
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ImageUploadJpegQuality, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.ImageUploadJpegQuality, new { htmlAttributes = new { @class = "form-control", type = "number", min = "40", max = "95" } })
                                    @Html.ValidationMessageFor(model => model.ImageUploadJpegQuality, "", new { @class = "text-danger" })
                                    <p class="form-text">JPEG sıkıştırma kalitesi (40–95). Varsayılan: 82.</p>
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.LabelFor(model => model.ImageUploadPreferWebP, htmlAttributes: new { @class = "col-form-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="form-check">
