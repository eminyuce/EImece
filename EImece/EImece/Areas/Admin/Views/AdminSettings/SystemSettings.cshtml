                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Küçük Resimler (Thumbnails)">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-table-cells-large text-primary me-2"></i>Küçük Resim (Thumbnail) Ayarları</h5>
                                <small class="text-muted">Katalog, sepet ve galeri önizleme küçük resimlerinin boyut ve kalite sınırları.</small>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-4 setting-item" data-setting-name="ImageUploadThumbMaxWidth" data-setting-label="Thumbnail Maksimum Genişlik" data-setting-desc="Küçük resimler için maksimum genişlik sınırı (px)" data-keywords="thumbnail küçük resim genişlik thumb max width">
                                        <label class="form-label fw-bold small" for="ImageUploadThumbMaxWidth">@Html.DisplayNameFor(model => model.ImageUploadThumbMaxWidth)</label>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.ImageUploadThumbMaxWidth, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", max = "5000", placeholder = "600" } })
                                            <span class="input-group-text">px</span>
                                        </div>
                                        <div class="form-text small">Küçük resim maksimum genişlik (px).</div>
                                        @Html.ValidationMessageFor(model => model.ImageUploadThumbMaxWidth, "", new { @class = "text-danger small" })
                                    </div>

                                    <div class="col-md-4 setting-item" data-setting-name="ImageUploadThumbMaxHeight" data-setting-label="Thumbnail Maksimum Yükseklik" data-setting-desc="Küçük resimler için maksimum yükseklik sınırı (px)" data-keywords="thumbnail küçük resim yükseklik thumb max height">
                                        <label class="form-label fw-bold small" for="ImageUploadThumbMaxHeight">@Html.DisplayNameFor(model => model.ImageUploadThumbMaxHeight)</label>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.ImageUploadThumbMaxHeight, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", max = "5000", placeholder = "600" } })
                                            <span class="input-group-text">px</span>
                                        </div>
                                        <div class="form-text small">Küçük resim maksimum yükseklik (px).</div>
                                        @Html.ValidationMessageFor(model => model.ImageUploadThumbMaxHeight, "", new { @class = "text-danger small" })
                                    </div>

                                    <div class="col-md-4 setting-item" data-setting-name="ImageUploadThumbJpegQuality" data-setting-label="Thumbnail JPEG Kalitesi" data-setting-desc="Küçük resimler için JPEG kalite faktörü (40–95)" data-keywords="thumbnail kalite jpeg quality küçük resim">
                                        <label class="form-label fw-bold small" for="ImageUploadThumbJpegQuality">@Html.DisplayNameFor(model => model.ImageUploadThumbJpegQuality)</label>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.ImageUploadThumbJpegQuality, new { htmlAttributes = new { @class = "form-control", type = "number", min = "40", max = "95", placeholder = "75" } })
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <div class="form-text small">Küçük resim JPEG kalitesi (40–95).</div>
                                        @Html.ValidationMessageFor(model => model.ImageUploadThumbJpegQuality, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 5. SALES & PAYMENTS TAB -->
                    <!-- ========================================================================= -->
                    <div id="tab-payments" class="tab-pane fade" role="tabpanel">
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Satış & Ödeme Sağlayıcı">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-credit-card text-primary me-2"></i>Ödeme Sağlayıcı &amp; E-Ticaret Parametreleri</h5>
                                    <small class="text-muted">Sanal POS, ödeme formu, taksitlendirme ve alıcı kimlik ayarları.</small>
                                </div>
                                <span class="badge bg-warning text-dark payment-disabled-badge d-none">
                                    <i class="fa-solid fa-lock me-1"></i> @AdminResource.PriceAndSales Aktif Olmalıdır
                                </span>
                            </div>
                            <div class="card-body">
                                <!-- Dependency Warning Alert -->
                                <div id="payment-disabled-alert" class="alert alert-warning d-flex align-items-center mb-4 p-3 rounded shadow-sm" style="display:none;">
                                    <i class="fa-solid fa-triangle-exclamation fa-2x me-3 text-warning"></i>
                                    <div>
                                        <strong class="d-block">Ödeme Ayarları Kilitli (@AdminResource.CatalogMode):</strong>
                                        Ödeme altyapısını ve parametrelerini yapılandırabilmek için <strong>Genel &amp; Vitrin</strong> sekmesindeki 
                                        <em>"Ürün fiyatları ve sepete ekleme aktif"</em> seçeneğinin açık olması gerekmektedir.
                                        <button type="button" class="btn btn-sm btn-outline-dark ms-2 mt-1" onclick="navigateToTab('#tab-general')">
                                            <i class="fa-solid fa-gear me-1"></i> Fiyatları Açmak İçin Git
                                        </button>
                                    </div>
                                </div>

                                <div id="payment-settings-fields">
                                    <div class="alert alert-info py-2 px-3 mb-4 rounded">
                                        <i class="fa-solid fa-shield me-1"></i> <strong>Güvenlik Standardı:</strong> İyzico API ve Secret anahtarları güvenlik nedeniyle veritabanında saklanmaz; <code>Web.config</code> veya ortam değişkenlerinde (<code>EIMECE_IYZICO_API_KEY</code>, <code>EIMECE_IYZICO_SECRET_KEY</code>) tanımlanır.
                                    </div>

                                    <div class="row g-3">
                                        <!-- Payment Provider -->
                                        <div class="col-md-6 setting-item" data-setting-name="PaymentProvider" data-setting-label="Ödeme Sağlayıcı" data-setting-desc="Aktif sanal POS ve ödeme altyapı sağlayıcısı" data-keywords="ödeme sağlayıcı iyzico pos sanal pos payment provider">
                                            <label class="form-label fw-bold small" for="PaymentProvider">@Html.DisplayNameFor(model => model.PaymentProvider)</label>
                                            @Html.DropDownListFor(model => model.PaymentProvider, new List<SelectListItem>
                                            {
                                                new SelectListItem { Text = "Iyzico (Checkout Form & 3D Secure)", Value = "Iyzico" }
                                            }, new { @class = "form-select payment-input" })
                                            <div class="form-text small">Kullanılacak sanal POS ve güvenli ödeme altyapısı.</div>
                                            @Html.ValidationMessageFor(model => model.PaymentProvider, "", new { @class = "text-danger small" })
                                        </div>

                                        <!-- Enabled Installments -->
                                        <div class="col-md-6 setting-item" data-setting-name="IyzicoEnabledInstallments" data-setting-label="İyzico @AdminResource.InstallmentOptionsTitle" data-setting-desc="customer sunulacak taksit seçenekleri (virgülle ayrılmış: 1,2,4,6,9)" data-keywords="taksit taksitler installment iyzico vade">
                                            <label class="form-label fw-bold small" for="IyzicoEnabledInstallments">@Html.DisplayNameFor(model => model.IyzicoEnabledInstallments)</label>
                                            @Html.EditorFor(model => model.IyzicoEnabledInstallments, new { htmlAttributes = new { @class = "form-control payment-input", placeholder = "1,2,4,6,9" } })
                                            <div class="form-text small">Ödeme ekranında izin verilen taksitler (Virgülle ayrılmış, örn: 1,2,4,6,9).</div>
                                            @Html.ValidationMessageFor(model => model.IyzicoEnabledInstallments, "", new { @class = "text-danger small" })
                                        </div>

                                        <!-- Buyer Identity Number -->
                                        <div class="col-md-6 setting-item" data-setting-name="BuyerIdentityNumber" data-setting-label="Varsayılan Alıcı TCKN" data-setting-desc="Kullanıcı TCKN belirtmediğinde kullanılan varsayılan kimlik numarası" data-keywords="tckn kimlik no buyer identity alıcı kimlik">
                                            <label class="form-label fw-bold small" for="BuyerIdentityNumber">@Html.DisplayNameFor(model => model.BuyerIdentityNumber)</label>
                                            @Html.EditorFor(model => model.BuyerIdentityNumber, new { htmlAttributes = new { @class = "form-control payment-input", placeholder = "10000000000" } })
                                            <div class="form-text small">@AdminResource.Customer TCKN girmediğinde fatura/ödeme entegrasyonuna iletilen yedek kimlik no.</div>
                                            @Html.ValidationMessageFor(model => model.BuyerIdentityNumber, "", new { @class = "text-danger small" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 6. SECURITY & RATE LIMITING TAB -->
                    <!-- ========================================================================= -->
                    <div id="tab-security" class="tab-pane fade" role="tabpanel">
                        <!-- Security Health Dashboard -->
                        <div class="card shadow-sm mb-4 border-0">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-shield text-danger me-2"></i>@AdminResource.SecurityStatusDashboard</h5>
                                <span class="badge @(securityScore >= 70 ? "bg-success" : (securityScore >= 35 ? "bg-warning text-dark" : "bg-danger")) px-3 py-2">
                                    @AdminResource.GeneralProtection: @(securityScore >= 70 ? AdminResource.Strong : (securityScore >= 35 ? AdminResource.MediumLevel : AdminResource.Critical))
                                </span>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="p-3 rounded border @(is2FaActive ? "bg-success-subtle border-success-subtle" : "bg-warning-subtle border-warning-subtle")">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="fa-solid @(is2FaActive ? "fa-circle-check text-success" : "fa-circle-exclamation text-warning") fs-5"></i>
                                                <strong class="small">@AdminResource.Administrator 2FA</strong>
                                            </div>
                                            <div class="small text-muted">@(is2FaActive ? "Tüm yöneticiler için TOTP zorunlu." : "administrators şifre ile giriş yapabilir.")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 rounded border @(isCaptchaActive ? "bg-success-subtle border-success-subtle" : "bg-warning-subtle border-warning-subtle")">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="fa-solid @(isCaptchaActive ? "fa-circle-check text-success" : "fa-circle-exclamation text-warning") fs-5"></i>
                                                <strong class="small">Spam / Captcha</strong>
                                            </div>
                                            <div class="small text-muted">@(isCaptchaActive ? string.Format("Aktif sağlayıcı: {0}", Model.CaptchaProvider) : "Form spam koruması kapalı.")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 rounded border @(isRateLimitActive ? "bg-success-subtle border-success-subtle" : "bg-danger-subtle border-danger-subtle")">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="fa-solid @(isRateLimitActive ? "fa-circle-check text-success" : "fa-circle-xmark text-danger") fs-5"></i>
                                                <strong class="small">Rate Limiting</strong>
                                            </div>
                                            <div class="small text-muted">@(isRateLimitActive ? "Brute-force ve DDoS koruması aktif." : "İstek sınırlama devre dışı.")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 1. Administrator 2FA -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="@AdminResource.Administrator 2FA Güvenliği">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-mobile-screen-button-screen-button text-primary me-2"></i>@AdminResource.Administrator İki Adımlı Doğrulama (TOTP 2FA)</h5>
                                <small class="text-muted">Google Authenticator, Microsoft Authenticator veya 1Password entegrasyonu.</small>
                            </div>
                            <div class="card-body">
                                <div class="setting-item p-3 rounded border bg-light" data-setting-name="RequireAdminAuthenticator" data-setting-label="@AdminResource.Administrator Authenticator 2FA" data-setting-desc="administratorsin panel girişinde Authenticator TOTP kodu girmesini zorunlu kılar" data-keywords="2fa totp iki adımlı doğrulama authenticator güvenlik şifre admin login">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="RequireAdminAuthenticator">
                                                <i class="fa-solid fa-key text-primary me-1"></i> İki Adımlı Doğrulama (2FA) @AdminResource.Enforce3DSecureVerification
                                            </label>
                                            <p class="text-muted small mb-0">
                                                Açık olduğunda tüm yöneticiler sisteme giriş yaparken mobil Authenticator uygulamasındaki 6 haneli kodu girmek zorundadır.
                                                Kapatıldığında yöneticiler yalnızca kullanıcı adı ve şifre ile giriş yapabilir.
                                            </p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.RequireAdminAuthenticator, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.RequireAdminAuthenticator, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                            </div>
                        </div>

                        <!-- 2. Bot & Spam Protection (Captcha) -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Spam & Captcha Koruması">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-robot text-primary me-2"></i>Bot &amp; Spam Koruması (Captcha)</h5>
                                <small class="text-muted">Kayıt, giriş ve iletişim formlarını bot saldırılarına karşı koruyun.</small>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6 setting-item" data-setting-name="CaptchaProvider" data-setting-label="Captcha Sağlayıcı" data-setting-desc="Formlarda kullanılacak bot doğrulama yöntemi: None, Legacy, Recaptcha" data-keywords="captcha recaptcha bot spam legacy koruma">
                                        <label class="form-label fw-bold small" for="CaptchaProvider">@Html.DisplayNameFor(model => model.CaptchaProvider)</label>
                                        @Html.DropDownListFor(model => model.CaptchaProvider, new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "None (Devre Dışı)", Value = "None" },
                                            new SelectListItem { Text = "Legacy (Dahili Matematiksel Görsel)", Value = "Legacy" },
                                            new SelectListItem { Text = "Recaptcha (Google reCAPTCHA v2)", Value = "Recaptcha" }
                                        }, new { @class = "form-select", id = "CaptchaProvider" })
                                        <div class="form-text small">Kullanılacak spam doğrulama mekanizması.</div>
                                        @Html.ValidationMessageFor(model => model.CaptchaProvider, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Recaptcha Site Key (Progressively disclosed) -->
                                    <div class="col-md-6 setting-item" id="recaptchaSiteKeyWrapper" data-setting-name="RecaptchaSiteKey" data-setting-label="Google reCAPTCHA Site Key" data-setting-desc="Google reCAPTCHA v2 genel istemci anahtarı" data-keywords="recaptcha site key google anahtar public key" style="@(string.Equals(Model.CaptchaProvider, "Recaptcha", StringComparison.OrdinalIgnoreCase) ? "" : "display:none;")">
                                        <label class="form-label fw-bold small" for="RecaptchaSiteKey">@Html.DisplayNameFor(model => model.RecaptchaSiteKey)</label>
                                        @Html.EditorFor(model => model.RecaptchaSiteKey, new { htmlAttributes = new { @class = "form-control", placeholder = "6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI" } })
                                        <div class="form-text small">Google reCAPTCHA v2 Genel Site Anahtarı (Secret Key <code>Web.config</code> dosyasında kalır).</div>
                                        @Html.ValidationMessageFor(model => model.RecaptchaSiteKey, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Request Protection (Rate Limiting) -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="İstek Sınırlandırma (Rate Limiting)">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-gauge text-primary me-2"></i>İstek Sınırlandırma (Rate Limiting)</h5>
                                <small class="text-muted">Brute-force şifre denemeleri, iletişim formu suistimali ve DDoS ataklarına karşı IP tabanlı kısıtlama.</small>
                            </div>
                            <div class="card-body">
                                <!-- Master Rate Limit Switch -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="RateLimit_Enabled" data-setting-label="Rate Limiting Anahtarı" data-setting-desc="Tüm istek sınırlama mekanizmasını açar veya kapatır" data-keywords="rate limit istek sınırlama brute force ddos">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="RateLimit_Enabled">
                                                <i class="fa-solid fa-shield text-danger me-1"></i> @AdminResource.EnableRateLimitingProtection
                                            </label>
                                            <p class="text-muted small mb-0">@AdminResource.EnableRateLimitingProtectionDesc</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.RateLimit_Enabled, new { @class = "form-check-input", role = "switch", id = "RateLimit_Enabled" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.RateLimit_Enabled, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <!-- Feature Limits Grid -->
                                <div id="rateLimitConfigContainer" style="@(Model.RateLimit_Enabled ? "" : "opacity: 0.5; pointer-events: none;")">
                                    <h6 class="fw-bold text-secondary mb-3"><i class="fa-solid fa-sliders me-1"></i> @AdminResource.EndpointSpecificRequestLimits</h6>
                                    <div class="row g-3">
                                        <!-- Login Limit -->
                                        <div class="col-md-6 col-xl-3 setting-item" data-setting-name="RateLimit_Login_Limit" data-setting-label="@AdminResource.LoginPageRequestLimit" data-setting-desc="@AdminResource.LoginPageRequestLimitDesc" data-keywords="login limit giriş brute force rate limit">
                                            <div class="card h-100 border bg-white shadow-none">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <i class="fa-solid fa-right-to-bracket text-primary fs-5"></i>
                                                        <strong class="small">@AdminResource.LoginAuthLabel</strong>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small mb-1" for="RateLimit_Login_Limit">@AdminResource.MaxRequestsLabel</label>
                                                        @Html.EditorFor(model => model.RateLimit_Login_Limit, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1000", placeholder = "5" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Login_Limit, "", new { @class = "text-danger small" })
                                                    </div>
                                                    <div>
                                                        <label class="form-label small mb-1" for="RateLimit_Login_WindowMinutes">@AdminResource.DurationMinutesLabel</label>
                                                        @Html.EditorFor(model => model.RateLimit_Login_WindowMinutes, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1440", placeholder = "1" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Login_WindowMinutes, "", new { @class = "text-danger small" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Contact Limit -->
                                        <div class="col-md-6 col-xl-3 setting-item" data-setting-name="RateLimit_Contact_Limit" data-setting-label="@AdminResource.ContactFormRequestLimit" data-setting-desc="@AdminResource.ContactFormRequestLimitDesc" data-keywords="iletişim contact form spam rate limit">
                                            <div class="card h-100 border bg-white shadow-none">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <i class="fa-solid fa-envelope text-info fs-5"></i>
                                                        <strong class="small">@AdminResource.ContactFormLabel</strong>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small mb-1" for="RateLimit_Contact_Limit">@AdminResource.MaxRequestsLabel</label>
                                                        @Html.EditorFor(model => model.RateLimit_Contact_Limit, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1000", placeholder = "3" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Contact_Limit, "", new { @class = "text-danger small" })
                                                    </div>
                                                    <div>
                                                        <label class="form-label small mb-1" for="RateLimit_Contact_WindowMinutes">@AdminResource.DurationMinutesLabel</label>
                                                        @Html.EditorFor(model => model.RateLimit_Contact_WindowMinutes, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1440", placeholder = "1" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Contact_WindowMinutes, "", new { @class = "text-danger small" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Checkout Limit -->
                                        <div class="col-md-6 col-xl-3 setting-item" data-setting-name="RateLimit_Checkout_Limit" data-setting-label="@AdminResource.CheckoutRequestLimit" data-setting-desc="@AdminResource.CheckoutRequestLimitDesc" data-keywords="checkout ödeme fraud rate limit">
                                            <div class="card h-100 border bg-white shadow-none">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <i class="fa-solid fa-cart-shopping text-success fs-5"></i>
                                                        <strong class="small">@AdminResource.CheckoutLabel</strong>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small mb-1" for="RateLimit_Checkout_Limit">@AdminResource.MaxRequestsLabel</label>
                                                        @Html.EditorFor(model => model.RateLimit_Checkout_Limit, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1000", placeholder = "5" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Checkout_Limit, "", new { @class = "text-danger small" })
                                                    </div>
                                                    <div>
                                                        <label class="form-label small mb-1" for="RateLimit_Checkout_WindowMinutes">@AdminResource.DurationMinutesLabel</label>
                                                        @Html.EditorFor(model => model.RateLimit_Checkout_WindowMinutes, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1440", placeholder = "5" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Checkout_WindowMinutes, "", new { @class = "text-danger small" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Search Limit -->
                                        <div class="col-md-6 col-xl-3 setting-item" data-setting-name="RateLimit_Search_Limit" data-setting-label="@AdminResource.SearchQueryRequestLimit" data-setting-desc="@AdminResource.SearchQueryRequestLimitDesc" data-keywords="arama search crawler scraper rate limit">
                                            <div class="card h-100 border bg-white shadow-none">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <i class="fa-solid fa-magnifying-glass text-warning fs-5"></i>
                                                        <strong class="small">Arama (Search)</strong>
                                                    </div>
