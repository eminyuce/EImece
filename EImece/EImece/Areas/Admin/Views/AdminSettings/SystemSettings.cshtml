                                        <i class="fa-solid fa-circle-info me-1 text-primary"></i>@AdminResource.ContentLanguagesHelp
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SupportedContentLanguages, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 1.5 ÜRÜN & FİYATLANDIRMA — NEW DEDICATED SECTION (entire page as /admin/adminsettings) -->
                    <!-- ========================================================================= -->
                    <div id="tab-products" class="tab-pane fade" role="tabpanel">
                        <!-- Section: Katalog Modu & Satış Davranışı -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Katalog & Satış Davranışı">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-bag-shopping text-primary me-2"></i>Katalog &amp; Satış Davranışı</h5>
                                <small class="text-muted">Mağaza vitrininde fiyat gösterimi, sepete ekleme ve satışa uygunluk — tüm ürün fiyat/katalog ayarları burada.</small>
                            </div>
                            <div class="card-body">
                                <!-- Product Prices & Catalog Mode -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="IsProductPriceEnable" data-setting-label="Ürün Fiyatları ve Sepet" data-setting-desc="Ürün fiyatlarını gösterir ve sepete ekleme/satın alma fonksiyonlarını aktif eder" data-keywords="fiyat katalog modu sepete ekleme sipariş product price">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="IsProductPriceEnable">
                                                <i class="fa-solid fa-tag text-primary me-1"></i> @AdminResource.ProductPricesAndAddToCart
                                            </label>
                                            <p class="text-muted small mb-0">@AdminResource.CatalogShowcaseModeDesc</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.IsProductPriceEnable, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsProductPriceEnable, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                                <!-- Suitable For Sale Product States -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light price-dependent-setting" data-setting-name="SuitableForSaleProductStates" data-setting-label="@AdminResource.SuitableForSaleProductStates" data-setting-desc="@AdminResource.SuitableForSaleProductStatesDesc" data-keywords="satışa uygun durumlar product state in sale buyable ön sipariş stokta pre-order">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block">
                                                <i class="fa-solid fa-cart-shopping text-success me-1"></i> @AdminResource.SuitableForSaleProductStates
                                                @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.SuitableForSaleProductStatesHelp } })
                                            </label>
                                            <p class="text-muted small mb-0">@AdminResource.SuitableForSaleProductStatesDesc</p>
                                        </div>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary" id="btnSelectDefaultSaleStates" title="Varsayılanları Seç (Stokta, Ön Sipariş, Sınırlı Stok)">
                                                <i class="fa-solid fa-arrow-rotate-left me-1"></i> Varsayılan
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary" id="btnSelectAllSaleStates" title="Tümünü Seç">
                                                <i class="fa-regular fa-square-check me-1"></i> Tümünü Seç
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary" id="btnClearAllSaleStates" title="Tümünü Temizle">
                                                <i class="fa-regular fa-square me-1"></i> Temizle
                                            </button>
                                        </div>
                                    </div>
                                    @Html.HiddenFor(model => model.SuitableForSaleProductStates, new { id = "SuitableForSaleProductStates" })
                                    @{
                                        var activeSaleStates = ProductStateHelper.ParseSuitableForSaleStates(Model.SuitableForSaleProductStates);
                                        var allSelectableStates = ProductStateHelper.GetAllSelectableStates();
                                    }
                                    <div class="row g-2 mt-1" id="saleProductStatesCheckboxGroup">
                                        @foreach (var pState in allSelectableStates)
                                        {
                                            var isChecked = activeSaleStates.Contains(pState);
                                            var stateName = pState.ToString();
                                            var stateDisplayName = ProductStateHelper.GetStateDisplayName(pState);
                                            var badgeClass = (pState == EImece.Domain.Models.Enums.ProductState.ProductInStock || pState == EImece.Domain.Models.Enums.ProductState.LimitedStock) ? "border-success" :
                                                             (pState == EImece.Domain.Models.Enums.ProductState.PreOrder || pState == EImece.Domain.Models.Enums.ProductState.Backorder) ? "border-info" :
                                                             (pState == EImece.Domain.Models.Enums.ProductState.ComingSoon || pState == EImece.Domain.Models.Enums.ProductState.AwaitingRestock) ? "border-warning" : "border-secondary";
                                            <div class="col-sm-6 col-lg-4">
                                                <div class="form-check p-2 bg-white rounded border @badgeClass h-100 d-flex align-items-center">
                                                    <input class="form-check-input ms-1 me-2 sale-state-chk" type="checkbox" id="chk_state_@stateName" value="@stateName" @(isChecked ? "checked=\"checked\"" : null) />
                                                    <label class="form-check-label small fw-semibold text-dark mb-0 cursor-pointer w-100" for="chk_state_@stateName">
                                                        @stateDisplayName
                                                        <span class="text-muted d-block font-monospace" style="font-size: 0.75rem;">(@stateName)</span>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SuitableForSaleProductStates, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                                <!-- Product Reviews -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="IsProductReviewEnable" data-setting-label="Ürün Yorumları" data-setting-desc="Kullanıcıların ürünlere yorum yapmasını ve puan vermesini sağlar" data-keywords="yorum puan review rating değerlendirme">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="IsProductReviewEnable">
                                                <i class="fa-regular fa-comments text-info me-1"></i> @AdminResource.ProductReviewsAndRatingsTitle
                                            </label>
                                            <p class="text-muted small mb-0">@AdminResource.ProductReviewsAndRatingsDesc</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.IsProductReviewEnable, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsProductReviewEnable, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                                <div class="alert alert-info py-2 px-3 mb-0 small">
                                    <i class="fa-solid fa-circle-info me-1"></i> <strong>İpucu:</strong> Fiyatlar kapalı iken mağaza <em>Katalog / Tanıtım Modu</em>nda çalışır, sepete ekleme ve ödeme adımları devre dışı kalır. <a href="#tab-payments" data-bs-toggle="pill" class="fw-bold">Satış &amp; Ödemeler</a> sekmesindeki ayarlar da kilitlenir.
                                </div>
                            </div>
                        </div>
                        <!-- Section: Liste & Önizleme -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Liste & Önizleme">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-list text-primary me-2"></i>Liste &amp; Önizleme Ayarları</h5>
                                <small class="text-muted">Ürün liste sayfaları ve kısa açıklama önizleme uzunluğu.</small>
                            </div>
