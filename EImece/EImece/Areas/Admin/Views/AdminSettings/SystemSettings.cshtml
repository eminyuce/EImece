@model EImece.Domain.Models.AdminModels.SystemSettingModel
@using EImece.Domain.Helpers
@using Resources;
@{
    ViewBag.Title = AdminResource.AdminSystemSettings;
    ViewBag.HelpSettingKey = "SystemSettings_help/info_section";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    // Pre-calculate status summaries for overview dashboard
    var isSiteLive = !Model.IsSiteUnderConstruction;
    var isSearchIndexing = Model.AllowSearchEngineIndexing;
    var is2FaActive = Model.RequireAdminAuthenticator;
    var isRateLimitActive = Model.RateLimit_Enabled;
    var isCaptchaActive = !string.Equals(Model.CaptchaProvider, "None", StringComparison.OrdinalIgnoreCase);
    var isSmtpConfigured = !string.IsNullOrWhiteSpace(Model.AdminEmailHost) && !string.IsNullOrWhiteSpace(Model.AdminEmail);
    var isWebPActive = Model.ImageUploadPreferWebP;
    var isPriceActive = Model.IsProductPriceEnable;

    var activeTheme = string.IsNullOrWhiteSpace(Model.ActiveDesign) ? "Crizal" : Model.ActiveDesign;
    var showThemeSelection = AppConfig.ShowThemeSelectionInAdmin;

    var availableDesigns = new List<string>();
    try
    {
        string designsDir = Server.MapPath("~/Views/Designs");
        if (System.IO.Directory.Exists(designsDir))
        {
            availableDesigns.AddRange(System.IO.Directory.GetDirectories(designsDir)
                .Select(System.IO.Path.GetFileName)
                .Where(d => !string.IsNullOrWhiteSpace(d)));
        }
    }
    catch { }

    if (!availableDesigns.Any(d => d.Equals("Crizal", StringComparison.OrdinalIgnoreCase)))
    {
        availableDesigns.Add("Crizal");
    }
    if (!availableDesigns.Any(d => d.Equals("Modern", StringComparison.OrdinalIgnoreCase)))
    {
        availableDesigns.Add("Modern");
    }

    var themeSelectItems = availableDesigns.Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t).Select(t => new SelectListItem
    {
        Value = t,
        Text = t + (t.Equals("Crizal", StringComparison.OrdinalIgnoreCase) ? " - Kurumsal (Yeşil Palet)" : (t.Equals("Modern", StringComparison.OrdinalIgnoreCase) ? " - Modern (Minimalist Palet)" : " - Özel Tasarım Şablonu")),
        Selected = string.Equals(activeTheme, t, StringComparison.OrdinalIgnoreCase)
    }).ToList();

    // Calculate security health score
    int securityScore = 0;
    if (is2FaActive) { securityScore += 35; }
    if (isRateLimitActive) { securityScore += 35; }
    if (isCaptchaActive) { securityScore += 30; }
}
@section Styles {
    <link href="~/Content/adminSettingsCenter.css?v=20260828r2" rel="stylesheet" />
}
<div class="settings-center-container" id="settingsCenterApp">
    <!-- Header Banner -->
    <div class="settings-header-banner mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                @Html.AdminBreadcrumb(AdminResource.SystemSettings)
                <h1 class="settings-main-title mb-1">
                    <i class="fa-solid fa-sliders text-primary me-2"></i>@AdminResource.AdminSystemSettings
                </h1>
                <p class="text-muted mb-0">@AdminResource.SettingsCenterSubtitle</p>
            </div>
            
            <!-- Global Search Box -->
            <div class="settings-search-wrapper position-relative">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" id="globalSettingsSearch" class="form-control border-start-0" placeholder="@AdminResource.SearchInSettingsPlaceholder" autocomplete="off" spellcheck="false" />
                    <button type="button" class="btn btn-outline-secondary border-start-0 d-none" id="btnClearSettingsSearch" title="@AdminResource.ClearSearch">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <div id="settingsSearchResults" class="settings-search-dropdown shadow-lg rounded" style="display: none;">
                    <div class="p-2 border-bottom text-muted small fw-bold text-uppercase d-flex justify-content-between align-items-center">
                        <span>@AdminResource.SearchResults</span>
                        <span id="searchResultCount" class="badge bg-secondary">0</span>
                    </div>
                    <div id="searchResultsList" class="list-group list-group-flush" style="max-height: 360px; overflow-y: auto;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Settings Form -->
    @using (Html.BeginForm("SystemSettings", "AdminSettings", FormMethod.Post, new { id = "systemSettingsForm", @class = "dirty-check-form" }))
    {
        @Html.AntiForgeryToken()

        <!-- Validation Summary -->
        <div id="validationSummaryContainer" class="mb-3">
            @Html.AdminValidationSummary()
        </div>

        <!-- Sticky Save Control Bar -->
        <div class="sticky-save-bar card shadow-sm mb-4 border-primary" id="stickySaveBar">
            <div class="card-body py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span id="saveStatusIndicator" class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <i class="fa-solid fa-circle-check me-1"></i> @AdminResource.SettingsUpToDate
                    </span>
                    <span id="unsavedChangesBadge" class="badge bg-warning text-dark px-2 py-1 d-none">
                        <i class="fa-solid fa-pencil me-1"></i> @AdminResource.UnsavedChangesExist
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnDiscardChanges" disabled>
                        <i class="fa-solid fa-arrow-rotate-left me-1"></i> @AdminResource.ResetChanges
                    </button>
                    <button type="submit" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" id="btnSaveSystemSettings">
                        <i class="fa-solid fa-floppy-disk me-1"></i> @AdminResource.SaveButtonText
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile drawer trigger & scrollable tabs -->
        <div class="d-lg-none mb-3">
            <button type="button" class="btn btn-outline-primary w-100 settings-mobile-trigger d-flex align-items-center justify-content-between" id="btnOpenSettingsNav" aria-expanded="false" aria-controls="settingsNavCard">
                <span><i class="fa-solid fa-sliders me-2"></i> Ayar Kategorileri</span>
                <span class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary" id="mobileActiveCategoryLabel">Genel Bakış</span>
                    <i class="fa-solid fa-chevron-down small"></i>
                </span>
            </button>
            <div class="settings-mobile-tabs mt-2" id="settingsMobileTabs" role="tablist" aria-label="Ayar kategorileri"></div>
        </div>
        <div class="settings-nav-overlay" id="settingsNavOverlay" aria-hidden="true"></div>

        <div class="row g-3">
            <!-- Left Information Architecture Navigation -->
            <div class="col-lg-3 col-md-4">
                <div class="settings-nav-card card shadow-sm sticky-lg-top" id="settingsNavCard" style="top: 20px; z-index: 10;">
                    <div class="card-header bg-light py-2 px-3 border-bottom">
                        <span class="fw-bold text-uppercase small text-muted"><i class="fa-solid fa-compass me-1"></i> @AdminResource.SettingCategories</span>
                    </div>
                    <div class="list-group list-group-flush settings-tab-menu" id="settingsTabs" role="tablist">
                        <!-- Overview -->
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between active" data-bs-toggle="pill" href="#overview" role="tab">
                            <span><i class="fa-solid fa-gauge text-primary me-2"></i><strong>@AdminResource.Overview</strong></span>
                            <span class="badge bg-primary rounded-pill"><i class="fa-solid fa-house"></i></span>
                        </a>

                        <!-- STORE Domain -->
                        <div class="settings-nav-domain-header text-uppercase">
                            <i class="fa-solid fa-cart-shopping text-muted me-1"></i> @AdminResource.DomainStore
                        </div>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-general" role="tab">
                            <span><i class="fa-solid fa-gear text-secondary me-2"></i> @AdminResource.GeneralAndStorefront</span>
                            @if (!isSiteLive) { <span class="badge bg-warning text-dark small" title="Maintenance mode active">Maintenance</span> }
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-appearance" role="tab">
                            <span><i class="fa-solid fa-paintbrush text-secondary me-2"></i> @AdminResource.AppearanceAndPwa</span>
                            <span class="badge bg-light text-dark border small">@activeTheme</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-media" role="tab">
                            <span><i class="fa-regular fa-image text-secondary me-2"></i> @AdminResource.MediaAndUpload</span>
                            @if (isWebPActive) { <span class="badge bg-info-subtle text-info border border-info-subtle small">WebP</span> }
                        </a>

                        <!-- PRODUCT Domain — new dedicated section -->
                        <div class="settings-nav-domain-header text-uppercase">
                            <i class="fa-solid fa-cubes text-muted me-1"></i> Ürün &amp; Katalog
                        </div>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-products" role="tab" id="nav-tab-products">
                            <span><i class="fa-solid fa-tags text-secondary me-2"></i> Ürün &amp; Fiyatlandırma</span>
                            <span class="d-flex align-items-center gap-1">
                                <span class="badge bg-light text-dark border small">@(Model.ProductPriceFilterSetting != null ? Model.ProductPriceFilterSetting.Split(new[]{'|',';'}, StringSplitOptions.RemoveEmptyEntries).Length : 0) filtre</span>
                                @if (!isPriceActive) { <span class="badge bg-warning text-dark small">Katalog</span> }
                            </span>
                        </a>

                        <!-- BUSINESS Domain -->
                        <div class="settings-nav-domain-header text-uppercase">
                            <i class="fa-solid fa-briefcase text-muted me-1"></i> @AdminResource.DomainBusiness
                        </div>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-payments" role="tab" id="nav-tab-payments">
                            <span><i class="fa-solid fa-credit-card text-secondary me-2"></i> @AdminResource.SalesAndPayments</span>
                            <span class="badge bg-secondary payment-disabled-badge d-none small">Locked</span>
                        </a>

                        <!-- SYSTEM Domain -->
                        <div class="settings-nav-domain-header text-uppercase">
                            <i class="fa-solid fa-server text-muted me-1"></i> @AdminResource.DomainSystem
                        </div>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-security" role="tab">
                            <span><i class="fa-solid fa-shield text-secondary me-2"></i> @AdminResource.SecurityAndRequestProtection</span>
                            <span class="badge @(securityScore >= 70 ? "bg-success" : (securityScore >= 35 ? "bg-warning text-dark" : "bg-danger")) small">
                                @(securityScore >= 70 ? "Good" : (securityScore >= 35 ? "Medium" : "Weak"))
                            </span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-smtp" role="tab">
                            <span><i class="fa-regular fa-envelope text-secondary me-2"></i> @AdminResource.SmtpEmailSettings</span>
                            <span class="badge @(isSmtpConfigured ? "bg-success" : "bg-warning text-dark") small">
                                @(isSmtpConfigured ? "Ready" : "Required")
                            </span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-integrations" role="tab">
                            <span><i class="fa-solid fa-plug text-secondary me-2"></i> @AdminResource.IntegrationsAndServices</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-tools" role="tab">
                            <span><i class="fa-solid fa-wrench text-secondary me-2"></i> @AdminResource.SystemToolsAndMaintenance</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-page-help" role="tab" id="nav-tab-page-help">
                            <span><i class="fa-solid fa-circle-question text-secondary me-2"></i> Sayfa Yardım Rehberleri</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle small" id="badgePageHelpCount">Rehberler</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Tab Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="tab-content" id="settingsTabContent">
                    
                    <!-- ========================================================================= -->
                    <!-- 0. OVERVIEW DASHBOARD TAB -->
                    <!-- ========================================================================= -->
                    <div id="overview" class="tab-pane fade show active" role="tabpanel">
                        <div class="card shadow-sm mb-4 border-0">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h4 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-gauge text-primary me-2"></i>@AdminResource.SettingsCenterOverview</h4>
                                    <small class="text-muted">@AdminResource.LiveSummaryOfStoreAndSystem</small>
                                </div>
                                <span class="badge bg-light text-secondary border px-3 py-2">
                                    <i class="fa-regular fa-clock me-1"></i> @AdminResource.LiveConfiguration
                                </span>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <!-- Storefront Status Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-primary-subtle text-primary rounded p-2"><i class="fa-solid fa-bag-shopping fa-lg"></i></span>
                                                    <span class="badge @(isSiteLive ? "bg-success" : "bg-warning text-dark")">
                                                        @(isSiteLive ? AdminResource.LiveOnSite : AdminResource.InMaintenanceMode)
                                                    </span>
                                                </div>
                                                <h6 class="fw-bold mb-1">@AdminResource.StoreAndShowcase</h6>
                                                <p class="text-muted small mb-2">@AdminResource.StoreAndShowcaseDesc</p>
                                                <ul class="list-unstyled small mb-0">
                                                    <li><i class="fa-solid fa-circle @(isPriceActive ? "text-success" : "text-secondary") me-1 small"></i> @AdminResource.PriceAndSales: <strong>@(isPriceActive ? "Aktif" : AdminResource.CatalogMode)</strong></li>
                                                    <li><i class="fa-solid fa-circle @(isSearchIndexing ? "text-success" : "text-danger") me-1 small"></i> @AdminResource.SeoIndexing: <strong>@(isSearchIndexing ? "Açık" : "Kapalı")</strong></li>
                                                    <li><i class="fa-solid fa-circle text-primary me-1 small"></i> @AdminResource.ActiveThemeLabel: <strong>@activeTheme</strong></li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary btn-sm w-100 mt-3" onclick="navigateToTab('#tab-general')">
                                                <i class="fa-solid fa-arrow-right me-1"></i> @AdminResource.OpenGeneralSettings
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Security Status Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-danger-subtle text-danger rounded p-2"><i class="fa-solid fa-shield fa-lg"></i></span>
                                                    <span class="badge @(securityScore >= 70 ? "bg-success" : (securityScore >= 35 ? "bg-warning text-dark" : "bg-danger"))">
                                                        @AdminResource.SecurityScore: %@securityScore
                                                    </span>
                                                </div>
                                                <h6 class="fw-bold mb-1">@AdminResource.SecurityAndProtection</h6>
                                                <p class="text-muted small mb-2">@AdminResource.SecurityAndProtectionDesc</p>
                                                <ul class="list-unstyled small mb-0">
                                                    <li><i class="fa-solid @(is2FaActive ? "fa-check text-success" : "fa-xmark text-danger") me-1"></i> @AdminResource.Administrator 2FA: <strong>@(is2FaActive ? AdminResource.Mandatory : "Kapalı")</strong></li>
                                                    <li><i class="fa-solid @(isCaptchaActive ? "fa-check text-success" : "fa-xmark text-warning") me-1"></i> Spam Captcha: <strong>@Model.CaptchaProvider</strong></li>
                                                    <li><i class="fa-solid @(isRateLimitActive ? "fa-check text-success" : "fa-xmark text-danger") me-1"></i> Rate Limiting: <strong>@(isRateLimitActive ? "Aktif" : "Devre Dışı")</strong></li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-outline-danger btn-sm w-100 mt-3" onclick="navigateToTab('#tab-security')">
                                                <i class="fa-solid fa-arrow-right me-1"></i> @AdminResource.GoToSecurityPanel
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Email & SMTP Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-warning-subtle text-warning rounded p-2"><i class="fa-regular fa-envelope fa-lg"></i></span>
                                                    <span class="badge @(isSmtpConfigured ? "bg-success" : "bg-danger")">
                                                        @(isSmtpConfigured ? AdminResource.SmtpConfigured : AdminResource.ConfigRequired)
                                                    </span>
                                                </div>
                                                <h6 class="fw-bold mb-1">@AdminResource.EmailAndSmtp</h6>
                                                <p class="text-muted small mb-2">@AdminResource.EmailAndSmtpDesc</p>
                                                <ul class="list-unstyled small mb-0">
                                                    <li class="text-truncate"><i class="fa-solid fa-server text-muted me-1"></i> @AdminResource.ServerLabel <strong>@(string.IsNullOrWhiteSpace(Model.AdminEmailHost) ? AdminResource.Undefined : Model.AdminEmailHost)</strong></li>
                                                    <li class="text-truncate"><i class="fa-solid fa-at text-muted me-1"></i> @AdminResource.SenderLabel <strong>@(string.IsNullOrWhiteSpace(Model.AdminEmail) ? AdminResource.Undefined : Model.AdminEmail)</strong></li>
                                                    <li><i class="fa-solid fa-lock text-muted me-1"></i> @AdminResource.SecurityLabel <strong>@(Model.AdminEmailEnableSsl ? AdminResource.SslTlsActive : AdminResource.PlainConnection)</strong></li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-outline-warning btn-sm w-100 mt-3 text-dark" onclick="navigateToTab('#tab-smtp')">
                                                <i class="fa-solid fa-arrow-right me-1"></i> @AdminResource.OpenEmailSettings
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Media Optimization Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-info-subtle text-info rounded p-2"><i class="fa-regular fa-image fa-lg"></i></span>
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                        @(isWebPActive ? AdminResource.WebPActive : "JPEG/PNG")
                                                    </span>
                                                </div>
                                                <h6 class="fw-bold mb-1">@AdminResource.MediaAndOptimization</h6>
                                                <p class="text-muted small mb-2">@AdminResource.MediaAndOptimizationDesc</p>
                                                <ul class="list-unstyled small mb-0">
                                                    <li><i class="fa-solid fa-compress text-muted me-1"></i> @AdminResource.JpegQualityLabel <strong>%@Model.ImageUploadJpegQuality</strong></li>
                                                    <li><i class="fa-regular fa-file-image text-muted me-1"></i> @AdminResource.WebPQualityLabel <strong>%@Model.ImageUploadWebPQuality</strong></li>
                                                    <li><i class="fa-solid fa-clone text-muted me-1"></i> @AdminResource.SidecarLabel <strong>@(Model.ImageUploadSaveWebPSidecar ? "Açık" : "Kapalı")</strong></li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-outline-info btn-sm w-100 mt-3" onclick="navigateToTab('#tab-media')">
                                                <i class="fa-solid fa-arrow-right me-1"></i> @AdminResource.OpenMediaSettings
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Business Profile Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-success-subtle text-success rounded p-2"><i class="fa-regular fa-building fa-lg"></i></span>
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">@AdminResource.BusinessProfile</span>
                                                </div>
                                                <h6 class="fw-bold mb-1">@AdminResource.CompanyAndContact</h6>
                                                <p class="text-muted small mb-2">@AdminResource.CompanyInfoAndContactDetails</p>
                                                <ul class="list-unstyled small mb-0">
                                                    <li><i class="fa-regular fa-id-card text-muted me-1"></i> @AdminResource.CompanyName</li>
                                                    <li><i class="fa-regular fa-envelope text-muted me-1"></i> @AdminResource.WebSiteCompanyEmailAddress</li>
                                                    <li><i class="fa-solid fa-location-dot text-muted me-1"></i> @AdminResource.CompanyAddress</li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-outline-success btn-sm w-100 mt-3" onclick="window.location.href='@Url.Action("Index", "AdminSettings", new { area = "admin" })'">
                                                <i class="fa-solid fa-arrow-right me-1"></i> @AdminResource.EditCompanyInfo
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Maintenance & Tools Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-secondary-subtle text-secondary rounded p-2"><i class="fa-solid fa-wrench fa-lg"></i></span>
                                                    <span class="badge bg-secondary">@AdminResource.Tools</span>
                                                </div>
                                                <h6 class="fw-bold mb-1">Sistem &amp; Yedekleme</h6>
                                                <p class="text-muted small mb-2">@AdminResource.SystemMetricsLogsDesc</p>
                                                <div class="d-flex flex-wrap gap-1 mt-2">
                                                    <span class="badge bg-light text-dark border"><i class="fa-solid fa-database text-success me-1"></i> JSON ZIP</span>
                                                    <span class="badge bg-light text-dark border"><i class="fa-solid fa-heart-pulse text-danger me-1"></i> Health</span>
                                                    <span class="badge bg-light text-dark border"><i class="fa-solid fa-chart-line text-primary me-1"></i> Metrics</span>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 mt-3" onclick="navigateToTab('#tab-tools')">
                                                <i class="fa-solid fa-arrow-right me-1"></i> Sistem @AdminResource.OpenSystemTools Aç
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 1. GENERAL & SEO TAB -->
                    <!-- ========================================================================= -->
                    <div id="tab-general" class="tab-pane fade" role="tabpanel">
                        <!-- Section: Site Durumu & SEO -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Site Durumu & SEO">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-globe text-primary me-2"></i>@AdminResource.SiteStatusAndIndexing</h5>
                                <small class="text-muted">@AdminResource.ManageStorefrontVisibility</small>
                            </div>
