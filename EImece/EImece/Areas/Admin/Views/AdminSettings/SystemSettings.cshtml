                                        <div class="input-group">
                                            @Html.EditorFor(model => model.DefaultImageHeight, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", placeholder = "900" } })
                                            <span class="input-group-text">px</span>
                                        </div>
                                        <div class="form-text small">@AdminResource.StandardImageHeightDesc</div>
                                        @Html.ValidationMessageFor(model => model.DefaultImageHeight, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Section: Tam Boyut Görsel Politikaları & JPEG -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="@AdminResource.FullSizeImagesAndCompression">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-compress text-primary me-2"></i>@AdminResource.FullSizeImagePoliciesAndJpegQuality</h5>
                                <small class="text-muted">@AdminResource.FullSizeImagesAndCompressionDesc</small>
                            </div>
                            <div class="card-body">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-4 setting-item" data-setting-name="ImageUploadMaxWidth" data-setting-label="Tam Boyut Maksimum Genişlik" data-setting-desc="Tam boyutlu fotoğraflar için maksimum genişlik sınırı (px). 0 = sınır yok." data-keywords="maksimum genişlik max width sınır boyutlandırma">
                                        <label class="form-label fw-bold small" for="ImageUploadMaxWidth">@Html.DisplayNameFor(model => model.ImageUploadMaxWidth)</label>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.ImageUploadMaxWidth, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", max = "10000", placeholder = "2560" } })
                                            <span class="input-group-text">px</span>
                                        </div>
                                        <div class="form-text small">@AdminResource.ZeroNoLimitDesc</div>
                                        @Html.ValidationMessageFor(model => model.ImageUploadMaxWidth, "", new { @class = "text-danger small" })
                                    </div>

                                    <div class="col-md-4 setting-item" data-setting-name="ImageUploadMaxHeight" data-setting-label="Tam Boyut Maksimum Yükseklik" data-setting-desc="Tam boyutlu fotoğraflar için maksimum yükseklik sınırı (px). 0 = sınır yok." data-keywords="maksimum yükseklik max height sınır boyutlandırma">
                                        <label class="form-label fw-bold small" for="ImageUploadMaxHeight">@Html.DisplayNameFor(model => model.ImageUploadMaxHeight)</label>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.ImageUploadMaxHeight, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", max = "10000", placeholder = "1440" } })
                                            <span class="input-group-text">px</span>
                                        </div>
                                        <div class="form-text small">@AdminResource.ZeroNoLimitDesc</div>
                                        @Html.ValidationMessageFor(model => model.ImageUploadMaxHeight, "", new { @class = "text-danger small" })
                                    </div>

                                    <div class="col-md-4 setting-item" data-setting-name="ImageUploadJpegQuality" data-setting-label="JPEG Sıkıştırma Kalitesi" data-setting-desc="JPEG formatındaki fotoğrafların kalite faktörü (40–95). Varsayılan: 82" data-keywords="jpeg kalite sıkıştırma compression quality jpeg quality">
                                        <label class="form-label fw-bold small" for="ImageUploadJpegQuality">@Html.DisplayNameFor(model => model.ImageUploadJpegQuality)</label>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.ImageUploadJpegQuality, new { htmlAttributes = new { @class = "form-control", type = "number", min = "40", max = "95", placeholder = "82" } })
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <div class="form-text small">JPEG kalitesi (40–95, Varsayılan: 82).</div>
                                        @Html.ValidationMessageFor(model => model.ImageUploadJpegQuality, "", new { @class = "text-danger small" })
                                    </div>
                                </div>

                                <!-- Keep Original If Smaller -->
                                <div class="setting-item p-3 rounded border bg-light" data-setting-name="ImageUploadKeepOriginalIfSmaller" data-setting-label="Daha Küçükse Orijinali Koru" data-setting-desc="Yeniden kodlama boyutu küçültmüyorsa orijinal görsel dosyasını korur" data-keywords="orijinal koru byte boyutu sıkıştırma">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="ImageUploadKeepOriginalIfSmaller">
                                                <i class="fa-regular fa-file-image text-secondary me-1"></i> Orijinal Dosyayı Koru (Daha Küçükse)
                                            </label>
