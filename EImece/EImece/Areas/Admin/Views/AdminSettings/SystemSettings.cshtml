                                                </div>
                                                <div class="form-check form-switch fs-5 mb-0">
                                                    @Html.CheckBoxFor(model => model.ImageUploadSaveWebPSidecar, new { @class = "form-check-input", role = "switch" })
                                                </div>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.ImageUploadSaveWebPSidecar, "", new { @class = "text-danger small mt-1 d-block" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

