                <div id="tab-scripts" class="tab-pane fade">
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Dış Bağlantılar & Scriptler</h3></div>
                        <div class="card-body">
                            <div class="form-group row mb-3">
                                <label class="col-form-label col-md-3" for="GoogleAnalyticsTrackingScript">
                                    @Html.DisplayNameFor(model => model.GoogleAnalyticsTrackingScript)
                                    @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.GoogleAnalyticsTrackingScriptTooltip } })
                                </label>
                                <div class="col-md-9">
                                    @Html.TextAreaFor(model => model.GoogleAnalyticsTrackingScript, 10, 50, new { @class = "form-control", placeholder = "<script>...</script>", title = AdminResource.GoogleAnalyticsTrackingScriptTooltip })
                                    @Html.ValidationMessageFor(model => model.GoogleAnalyticsTrackingScript, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.GoogleAnalyticsTrackingScriptTooltip</p>
                                </div>
                            </div>
                            <hr />
                            <div class="form-group row mb-3">
                                <label class="col-form-label col-md-3" for="WhatsAppCommunicationLink">
                                    @Html.DisplayNameFor(model => model.WhatsAppCommunicationLink)
                                    @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.WhatsAppCommunicationLinkTooltip } })
                                </label>
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.WhatsAppCommunicationLink, new { htmlAttributes = new { @class = "form-control", placeholder = "https://wa.me/90555...", title = AdminResource.WhatsAppCommunicationLinkTooltip } })
                                    @Html.ValidationMessageFor(model => model.WhatsAppCommunicationLink, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.WhatsAppCommunicationLinkTooltip</p>
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                <label class="col-form-label col-md-3" for="WhatsAppCommunicationScript">
                                    @Html.DisplayNameFor(model => model.WhatsAppCommunicationScript)
                                    @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.WhatsAppCommunicationScriptTooltip } })
                                </label>
                                <div class="col-md-9">
                                    @Html.TextAreaFor(model => model.WhatsAppCommunicationScript, 10, 50, new { @class = "form-control", placeholder = "WhatsApp Eklenti Scripti", title = AdminResource.WhatsAppCommunicationScriptTooltip })
                                    @Html.ValidationMessageFor(model => model.WhatsAppCommunicationScript, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.WhatsAppCommunicationScriptTooltip</p>
                                </div>
                            </div>
                            <hr />
                            <div class="form-group row mb-3">
                                <label class="col-form-label col-md-3" for="GoogleMapScript">
                                    @Html.DisplayNameFor(model => model.GoogleMapScript)
                                    @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.GoogleMapScriptTooltip } })
                                </label>
                                <div class="col-md-9">
                                    @Html.TextAreaFor(model => model.GoogleMapScript, 10, 50, new { @class = "form-control", placeholder = "<iframe src='...'></iframe>", title = AdminResource.GoogleMapScriptTooltip })
                                    @Html.ValidationMessageFor(model => model.GoogleMapScript, "", new { @class = "text-danger" })
                                    <p class="form-text">@AdminResource.GoogleMapScriptTooltip</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 10. System Tools Tab -->
                <div id="tab-tools" class="tab-pane fade">
                    <div class="card">
                        <div class="card-header"><h3 class="card-title">Sistem Araçları & İzleme</h3></div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="p-3 border rounded text-center bg-light">
                                        <h4><i class="fa fa-dashboard text-primary" style="font-size:24px;"></i><br/>@AdminResource.SystemMonitoring</h4>
                                        <p class="text-muted">Sistem durumunu ve performansını inceleyin.</p>
                                        <a href="@Url.Action("Index", "Metrics", new { area = "admin" })" class="btn btn-primary w-100">
                                            <i class="fa fa-line-chart" aria-hidden="true"></i> @AdminResource.Metrics
                                        </a>
                                        <a href="@Url.Action("Index", "Health", new { area = "" })" class="btn btn-secondary w-100 mt-2" target="_blank" rel="noopener noreferrer">
                                            <i class="fa fa-heartbeat" aria-hidden="true"></i> @AdminResource.Health
                                        </a>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="p-3 border rounded text-center bg-light">
                                        <h4><i class="fa fa-cogs text-warning" style="font-size:24px;"></i><br />@AdminResource.AppLogs & Bakım</h4>
                                        <p class="text-muted">Uygulama kayıtlarını görüntüleyin ve bakım yapın.</p>
                                        @Html.ActionLink(AdminResource.AppLogs, "Index", "AppLogs", null, new { @class = "btn w-100 btn-warning" })
                                        <a href="@Url.Action("DownloadCompressedImages", "Images", new { area = "admin" })" class="btn btn-outline-primary w-100 mt-2">
                                            <i class="fa fa-file-archive-o" aria-hidden="true"></i> Sıkıştırılmış Görseller (ZIP)
                                        </a>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="p-3 border rounded text-center" style="border: 1px solid #198754; background-color: #f8fff9;">
                                        <h4><i class="fa fa-database text-success" style="font-size:24px;"></i><br />Veri Yedekleme (JSON)</h4>
                                        <p class="text-muted">Uygulama iş verilerini versiyonlu JSON formatında yedekleyin.</p>
                                        <div class="mb-2">
                                            <span class="badge bg-success" style="font-size: 11px;">v1.0 JSON</span>
                                            <span class="badge bg-info text-dark" style="font-size: 11px;">İlişki Korumalı</span>
                                            <span class="badge bg-secondary" style="font-size: 11px;">ZIP Paket</span>
                                        </div>
                                        <a href="@Url.Action("ExportBackup", "AdminSettings", new { area = "admin" })" class="btn btn-success w-100 btn-export-backup" id="btnExportBackup" title="Tüm sistem verilerini JSON ZIP olarak dışa aktar">
                                            <i class="fa fa-download" aria-hidden="true"></i> Verileri Dışa Aktar (ZIP)
                                        </a>
                                        <p class="form-text text-muted mt-2" style="font-size: 11px;">
                                            Katalog, siparişler, ayarlar ve kullanıcı meta verilerini içerir. Şifreler ve ödeme kart bilgileri dahil edilmez.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
}

