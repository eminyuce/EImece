@model EImece.Domain.Models.AdminModels.SystemSettingModel
@using Resources;
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>@AdminResource.AdminSystemSettings</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "systemSettingsHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada sitenizin <strong>genel sistem ayarlarını</strong> yönetebilirsiniz.</li>
    <li><strong>Genel Ayarlar:</strong> Varsayılan resim boyutları, ürün fiyat/yorum gösterimi ve kargo için minimum sepet tutarı gibi ayarları içerir.</li>
    <li><strong>Firma Ayarları:</strong> Sitede görünen firma adı, adresi, e-posta ve telefon/lokasyon bilgilerini güncelleyebilirsiniz.</li>
    <li><strong>SMTP E-Posta Ayarları:</strong> Sistemin e-posta gönderebilmesi için gereken sunucu bilgilerini (Host, Port, Kullanıcı vb.) ayarlayıp test edebilirsiniz.</li>
    <li><strong>Sosyal Medya Ayarları:</strong> Sitenizdeki sosyal medya (Facebook, Instagram vb.) ve canlı destek (Zopim) bağlantılarını tanımlayabilirsiniz.</li>
    <li><strong>Dışa Bağlantı ve Script Ayarları:</strong> Google Analytics, WhatsApp iletişim ve Google Haritalar script/link ayarlarınızı buradan yapabilirsiniz.</li>
    <li><strong>Sistem İzleme & Log:</strong> Uygulama metriklerini, logları görebilir ve veritabanı yedeği alabilirsiniz.</li>
</ul>
<p style="margin-top: 12px; margin-bottom: 0;"><strong>Önemli:</strong> Yaptığınız değişikliklerin geçerli olması için kaydet butonuna tıklamayı unutmayın.</p>
@Html.Partial("_AdminHelpAccordionEnd")

@using (Html.BeginForm("SystemSettings", "AdminSettings"))
{
