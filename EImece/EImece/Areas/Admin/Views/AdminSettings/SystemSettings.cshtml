                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.ImageUploadKeepOriginalIfSmaller, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.ImageUploadKeepOriginalIfSmaller, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                            </div>
                        </div>

                        <!-- Section: WebP Formatı & Politikaları -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="WebP Görsel Politikaları">
