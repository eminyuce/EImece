                        <!-- Section: PWA & Web App Manifest -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="PWA & Web App Manifest">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
