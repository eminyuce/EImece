                    </a>
                </li>
                <li>
                    <a data-toggle="pill" href="#tab-smtp">
                        <i class="glyphicon glyphicon-envelope" style="margin-right:8px;"></i> @AdminResource.SmtpEmailSettings
                    </a>
                </li>
                <li>
