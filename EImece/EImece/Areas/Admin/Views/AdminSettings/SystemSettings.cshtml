<script>
    function syncPaymentSettingsState() {
        var isPriceEnabled = $('#IsProductPriceEnable').is(':checked');
        if (isPriceEnabled) {
            $('#payment-disabled-alert').hide();
            $('.payment-disabled-badge').hide();
            $('#payment-settings-fields').css({ 'opacity': '1', 'pointer-events': 'auto' });
            $('.payment-input').prop('disabled', false);
        } else {
            $('#payment-disabled-alert').show();
            $('.payment-disabled-badge').show();
            $('#payment-settings-fields').css({ 'opacity': '0.5', 'pointer-events': 'none' });
            $('.payment-input').prop('disabled', true);
        }
    }

    // Tab persist via hash in URL
    $(function(){
        var hash = window.location.hash;
        if (hash) {
            $(".nav-pills a[href='" + hash + "']").tab('show');
        }
        $('.nav-pills a').click(function (e) {
            $(this).tab('show');
            var scrollmem = $('body').scrollTop() || $('html').scrollTop();
            window.location.hash = this.hash;
            $('html,body').scrollTop(scrollmem);
        });

        $('#IsProductPriceEnable').on('change', syncPaymentSettingsState);
        syncPaymentSettingsState();
    });
</script>

