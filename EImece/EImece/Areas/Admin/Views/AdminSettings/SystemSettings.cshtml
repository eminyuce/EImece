                                                new SelectListItem { Text = "Iyzico (Checkout Form & 3D Secure)", Value = "Iyzico" }
                                            }, new { @class = "form-select payment-input" })
                                            <div class="form-text small">Kullanılacak sanal POS ve güvenli ödeme altyapısı.</div>
                                            @Html.ValidationMessageFor(model => model.PaymentProvider, "", new { @class = "text-danger small" })
                                        </div>

                                        <!-- Enabled Installments -->
                                        <div class="col-md-6 setting-item" data-setting-name="IyzicoEnabledInstallments" data-setting-label="İyzico Taksit Seçenekleri" data-setting-desc="Müşteriye sunulacak taksit seçenekleri (virgülle ayrılmış: 1,2,4,6,9)" data-keywords="taksit taksitler installment iyzico vade">
                                            <label class="form-label fw-bold small" for="IyzicoEnabledInstallments">@Html.DisplayNameFor(model => model.IyzicoEnabledInstallments)</label>
                                            @Html.EditorFor(model => model.IyzicoEnabledInstallments, new { htmlAttributes = new { @class = "form-control payment-input", placeholder = "1,2,4,6,9" } })
                                            <div class="form-text small">Ödeme ekranında izin verilen taksitler (Virgülle ayrılmış, örn: 1,2,4,6,9).</div>
                                            @Html.ValidationMessageFor(model => model.IyzicoEnabledInstallments, "", new { @class = "text-danger small" })
                                        </div>

                                        <!-- Buyer Identity Number -->
                                        <div class="col-md-6 setting-item" data-setting-name="BuyerIdentityNumber" data-setting-label="Varsayılan Alıcı TCKN" data-setting-desc="Kullanıcı TCKN belirtmediğinde kullanılan varsayılan kimlik numarası" data-keywords="tckn kimlik no buyer identity alıcı kimlik">
                                            <label class="form-label fw-bold small" for="BuyerIdentityNumber">@Html.DisplayNameFor(model => model.BuyerIdentityNumber)</label>
                                            @Html.EditorFor(model => model.BuyerIdentityNumber, new { htmlAttributes = new { @class = "form-control payment-input", placeholder = "10000000000" } })
                                            <div class="form-text small">Müşteri TCKN girmediğinde fatura/ödeme entegrasyonuna iletilen yedek kimlik no.</div>
                                            @Html.ValidationMessageFor(model => model.BuyerIdentityNumber, "", new { @class = "text-danger small" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 6. SECURITY & RATE LIMITING TAB -->
                    <!-- ========================================================================= -->
                    <div id="tab-security" class="tab-pane fade" role="tabpanel">
                        <!-- Security Health Dashboard -->
                        <div class="card shadow-sm mb-4 border-0">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                                <h5 class="mb-0 fw-bold"><i class="fa fa-shield text-danger me-2"></i>Güvenlik Durumu Gösterge Paneli</h5>
                                <span class="badge @(securityScore >= 70 ? "bg-success" : (securityScore >= 35 ? "bg-warning text-dark" : "bg-danger")) px-3 py-2">
                                    Genel Koruma: @(securityScore >= 70 ? "Güçlü" : (securityScore >= 35 ? "Orta Düzey" : "Kritik"))
                                </span>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="p-3 rounded border @(is2FaActive ? "bg-success-subtle border-success-subtle" : "bg-warning-subtle border-warning-subtle")">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="fa @(is2FaActive ? "fa-check-circle text-success" : "fa-exclamation-circle text-warning") fs-5"></i>
                                                <strong class="small">Yönetici 2FA</strong>
                                            </div>
                                            <div class="small text-muted">@(is2FaActive ? "Tüm yöneticiler için TOTP zorunlu." : "Yöneticiler şifre ile giriş yapabilir.")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 rounded border @(isCaptchaActive ? "bg-success-subtle border-success-subtle" : "bg-warning-subtle border-warning-subtle")">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="fa @(isCaptchaActive ? "fa-check-circle text-success" : "fa-exclamation-circle text-warning") fs-5"></i>
                                                <strong class="small">Spam / Captcha</strong>
                                            </div>
                                            <div class="small text-muted">@(isCaptchaActive ? $"Aktif sağlayıcı: {Model.CaptchaProvider}" : "Form spam koruması kapalı.")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="p-3 rounded border @(isRateLimitActive ? "bg-success-subtle border-success-subtle" : "bg-danger-subtle border-danger-subtle")">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="fa @(isRateLimitActive ? "fa-check-circle text-success" : "fa-times-circle text-danger") fs-5"></i>
                                                <strong class="small">Rate Limiting</strong>
                                            </div>
                                            <div class="small text-muted">@(isRateLimitActive ? "Brute-force ve DDoS koruması aktif." : "İstek sınırlama devre dışı.")</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 1. Administrator 2FA -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Yönetici 2FA Güvenliği">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa fa-mobile text-primary me-2"></i>Yönetici İki Adımlı Doğrulama (TOTP 2FA)</h5>
                                <small class="text-muted">Google Authenticator, Microsoft Authenticator veya 1Password entegrasyonu.</small>
                            </div>
                            <div class="card-body">
                                <div class="setting-item p-3 rounded border bg-light" data-setting-name="RequireAdminAuthenticator" data-setting-label="Yönetici Authenticator 2FA" data-setting-desc="Yöneticilerin panel girişinde Authenticator TOTP kodu girmesini zorunlu kılar" data-keywords="2fa totp iki adımlı doğrulama authenticator güvenlik şifre admin login">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="RequireAdminAuthenticator">
                                                <i class="fa fa-key text-primary me-1"></i> İki Adımlı Doğrulama (2FA) Zorunluluğu
                                            </label>
                                            <p class="text-muted small mb-0">
                                                Açık olduğunda tüm yöneticiler sisteme giriş yaparken mobil Authenticator uygulamasındaki 6 haneli kodu girmek zorundadır.
                                                Kapatıldığında yöneticiler yalnızca kullanıcı adı ve şifre ile giriş yapabilir.
                                            </p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.RequireAdminAuthenticator, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.RequireAdminAuthenticator, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                            </div>
                        </div>

                        <!-- 2. Bot & Spam Protection (Captcha) -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Spam & Captcha Koruması">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa fa-robot text-primary me-2"></i>Bot &amp; Spam Koruması (Captcha)</h5>
                                <small class="text-muted">Kayıt, giriş ve iletişim formlarını bot saldırılarına karşı koruyun.</small>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6 setting-item" data-setting-name="CaptchaProvider" data-setting-label="Captcha Sağlayıcı" data-setting-desc="Formlarda kullanılacak bot doğrulama yöntemi: None, Legacy, Recaptcha" data-keywords="captcha recaptcha bot spam legacy koruma">
                                        <label class="form-label fw-bold small" for="CaptchaProvider">@Html.DisplayNameFor(model => model.CaptchaProvider)</label>
                                        @Html.DropDownListFor(model => model.CaptchaProvider, new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "None (Devre Dışı)", Value = "None" },
                                            new SelectListItem { Text = "Legacy (Dahili Matematiksel Görsel)", Value = "Legacy" },
                                            new SelectListItem { Text = "Recaptcha (Google reCAPTCHA v2)", Value = "Recaptcha" }
                                        }, new { @class = "form-select", id = "CaptchaProvider" })
                                        <div class="form-text small">Kullanılacak spam doğrulama mekanizması.</div>
                                        @Html.ValidationMessageFor(model => model.CaptchaProvider, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Recaptcha Site Key (Progressively disclosed) -->
                                    <div class="col-md-6 setting-item" id="recaptchaSiteKeyWrapper" data-setting-name="RecaptchaSiteKey" data-setting-label="Google reCAPTCHA Site Key" data-setting-desc="Google reCAPTCHA v2 genel istemci anahtarı" data-keywords="recaptcha site key google anahtar public key" style="@(string.Equals(Model.CaptchaProvider, "Recaptcha", StringComparison.OrdinalIgnoreCase) ? "" : "display:none;")">
                                        <label class="form-label fw-bold small" for="RecaptchaSiteKey">@Html.DisplayNameFor(model => model.RecaptchaSiteKey)</label>
                                        @Html.EditorFor(model => model.RecaptchaSiteKey, new { htmlAttributes = new { @class = "form-control", placeholder = "6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI" } })
                                        <div class="form-text small">Google reCAPTCHA v2 Genel Site Anahtarı (Secret Key <code>Web.config</code> dosyasında kalır).</div>
                                        @Html.ValidationMessageFor(model => model.RecaptchaSiteKey, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. Request Protection (Rate Limiting) -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="İstek Sınırlandırma (Rate Limiting)">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa fa-tachometer text-primary me-2"></i>İstek Sınırlandırma (Rate Limiting)</h5>
                                <small class="text-muted">Brute-force şifre denemeleri, iletişim formu suistimali ve DDoS ataklarına karşı IP tabanlı kısıtlama.</small>
                            </div>
                            <div class="card-body">
                                <!-- Master Rate Limit Switch -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="RateLimit_Enabled" data-setting-label="Rate Limiting Anahtarı" data-setting-desc="Tüm istek sınırlama mekanizmasını açar veya kapatır" data-keywords="rate limit istek sınırlama brute force ddos">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="RateLimit_Enabled">
                                                <i class="fa fa-shield text-danger me-1"></i> İstek Sınırlandırma Korumasını Aktif Et
                                            </label>
                                            <p class="text-muted small mb-0">Aktif olduğunda belirli zaman pencerelerinde sınırları aşan IP adresleri geçici olarak engellenir (HTTP 429 Too Many Requests).</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.RateLimit_Enabled, new { @class = "form-check-input", role = "switch", id = "RateLimit_Enabled" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.RateLimit_Enabled, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <!-- Feature Limits Grid -->
                                <div id="rateLimitConfigContainer" style="@(Model.RateLimit_Enabled ? "" : "opacity: 0.5; pointer-events: none;")">
                                    <h6 class="fw-bold text-secondary mb-3"><i class="fa fa-sliders me-1"></i> Özellik Bazlı İstek Sınırları &amp; Zaman Pencereleri</h6>
                                    <div class="row g-3">
                                        <!-- Login Limit -->
                                        <div class="col-md-6 col-xl-3 setting-item" data-setting-name="RateLimit_Login_Limit" data-setting-label="Giriş Sayfası İstek Limiti" data-setting-desc="Giriş sayfası için IP başına izin verilen istek sayısı ve süresi" data-keywords="login limit giriş brute force rate limit">
                                            <div class="card h-100 border bg-white shadow-none">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <i class="fa fa-sign-in text-primary fs-5"></i>
                                                        <strong class="small">Giriş (Login)</strong>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small mb-1" for="RateLimit_Login_Limit">Maks. İstek</label>
                                                        @Html.EditorFor(model => model.RateLimit_Login_Limit, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1000", placeholder = "5" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Login_Limit, "", new { @class = "text-danger small" })
                                                    </div>
                                                    <div>
                                                        <label class="form-label small mb-1" for="RateLimit_Login_WindowMinutes">Süre (Dakika)</label>
                                                        @Html.EditorFor(model => model.RateLimit_Login_WindowMinutes, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1440", placeholder = "1" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Login_WindowMinutes, "", new { @class = "text-danger small" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Contact Limit -->
                                        <div class="col-md-6 col-xl-3 setting-item" data-setting-name="RateLimit_Contact_Limit" data-setting-label="İletişim Formu İstek Limiti" data-setting-desc="İletişim formu için IP başına izin verilen istek sayısı ve süresi" data-keywords="iletişim contact form spam rate limit">
                                            <div class="card h-100 border bg-white shadow-none">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <i class="fa fa-envelope text-info fs-5"></i>
                                                        <strong class="small">İletişim (Contact)</strong>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small mb-1" for="RateLimit_Contact_Limit">Maks. İstek</label>
                                                        @Html.EditorFor(model => model.RateLimit_Contact_Limit, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1000", placeholder = "3" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Contact_Limit, "", new { @class = "text-danger small" })
                                                    </div>
                                                    <div>
                                                        <label class="form-label small mb-1" for="RateLimit_Contact_WindowMinutes">Süre (Dakika)</label>
                                                        @Html.EditorFor(model => model.RateLimit_Contact_WindowMinutes, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1440", placeholder = "1" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Contact_WindowMinutes, "", new { @class = "text-danger small" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Checkout Limit -->
                                        <div class="col-md-6 col-xl-3 setting-item" data-setting-name="RateLimit_Checkout_Limit" data-setting-label="Ödeme İsteği Limiti" data-setting-desc="Ödeme adımı için IP başına izin verilen istek sayısı ve süresi" data-keywords="checkout ödeme fraud rate limit">
                                            <div class="card h-100 border bg-white shadow-none">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <i class="fa fa-shopping-cart text-success fs-5"></i>
                                                        <strong class="small">Ödeme (Checkout)</strong>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small mb-1" for="RateLimit_Checkout_Limit">Maks. İstek</label>
                                                        @Html.EditorFor(model => model.RateLimit_Checkout_Limit, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1000", placeholder = "5" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Checkout_Limit, "", new { @class = "text-danger small" })
                                                    </div>
                                                    <div>
                                                        <label class="form-label small mb-1" for="RateLimit_Checkout_WindowMinutes">Süre (Dakika)</label>
                                                        @Html.EditorFor(model => model.RateLimit_Checkout_WindowMinutes, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1440", placeholder = "5" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Checkout_WindowMinutes, "", new { @class = "text-danger small" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Search Limit -->
                                        <div class="col-md-6 col-xl-3 setting-item" data-setting-name="RateLimit_Search_Limit" data-setting-label="Arama İstek Limiti" data-setting-desc="Arama sorguları için IP başına izin verilen istek sayısı ve süresi" data-keywords="arama search crawler scraper rate limit">
                                            <div class="card h-100 border bg-white shadow-none">
                                                <div class="card-body p-3">
                                                    <div class="d-flex align-items-center gap-2 mb-2">
                                                        <i class="fa fa-search text-warning fs-5"></i>
                                                        <strong class="small">Arama (Search)</strong>
                                                    </div>
                                                    <div class="mb-2">
                                                        <label class="form-label small mb-1" for="RateLimit_Search_Limit">Maks. İstek</label>
                                                        @Html.EditorFor(model => model.RateLimit_Search_Limit, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1000", placeholder = "30" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Search_Limit, "", new { @class = "text-danger small" })
                                                    </div>
                                                    <div>
                                                        <label class="form-label small mb-1" for="RateLimit_Search_WindowMinutes">Süre (Dakika)</label>
                                                        @Html.EditorFor(model => model.RateLimit_Search_WindowMinutes, new { htmlAttributes = new { @class = "form-control form-control-sm", type = "number", min = "1", max = "1440", placeholder = "1" } })
                                                        @Html.ValidationMessageFor(model => model.RateLimit_Search_WindowMinutes, "", new { @class = "text-danger small" })
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 7. EMAIL & SMTP TAB -->
                    <!-- ========================================================================= -->
                    <div id="tab-smtp" class="tab-pane fade" role="tabpanel">
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="E-Posta & SMTP Yapılandırması">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-0 fw-bold"><i class="fa fa-envelope text-primary me-2"></i>@AdminResource.SmtpEmailSettings</h5>
                                    <small class="text-muted">Sipariş onayları, şifre sıfırlama ve sistem bildirim e-postalarını ileten SMTP sunucusu.</small>
                                </div>
                                <span class="badge @(isSmtpConfigured ? "bg-success" : "bg-warning text-dark") px-3 py-2">
                                    <i class="fa @(isSmtpConfigured ? "fa-check-circle" : "fa-exclamation-circle") me-1"></i>
                                    @(isSmtpConfigured ? "SMTP Yapılandırıldı" : "Yapılandırma Bekleniyor")
                                </span>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <!-- Sender Email -->
                                    <div class="col-md-6 setting-item" data-setting-name="AdminEmail" data-setting-label="Gönderen E-Posta Adresi" data-setting-desc="E-postaların From alanında görünecek sistem e-posta adresi" data-keywords="gönderen email mail admin email smtp from">
                                        <label class="form-label fw-bold small" for="AdminEmail">
                                            @Html.DisplayNameFor(model => model.AdminEmail)
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.AdminEmailTooltip } })
                                        </label>
                                        @Html.EditorFor(model => model.AdminEmail, new { htmlAttributes = new { @class = "form-control", type = "email", placeholder = "gonderen@ornek.com", title = AdminResource.AdminEmailTooltip } })
                                        <div class="form-text small">@AdminResource.AdminEmailTooltip</div>
                                        @Html.ValidationMessageFor(model => model.AdminEmail, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Display Name -->
                                    <div class="col-md-6 setting-item" data-setting-name="AdminEmailDisplayName" data-setting-label="E-Posta Gönderen Adı" data-setting-desc="Gelen kutusunda görünecek firma veya mağaza adı" data-keywords="gönderen adı display name firma mail başlık">
                                        <label class="form-label fw-bold small" for="AdminEmailDisplayName">
                                            @Html.DisplayNameFor(model => model.AdminEmailDisplayName)
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.AdminEmailDisplayNameTooltip } })
                                        </label>
                                        @Html.EditorFor(model => model.AdminEmailDisplayName, new { htmlAttributes = new { @class = "form-control", placeholder = "EImece Müşteri Hizmetleri", title = AdminResource.AdminEmailDisplayNameTooltip } })
                                        <div class="form-text small">@AdminResource.AdminEmailDisplayNameTooltip</div>
                                        @Html.ValidationMessageFor(model => model.AdminEmailDisplayName, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Host -->
                                    <div class="col-md-8 setting-item" data-setting-name="AdminEmailHost" data-setting-label="SMTP Sunucu Adresi (Host)" data-setting-desc="SMTP sunucu ana bilgisayar adresi veya IP'si (örn: smtp.example.com)" data-keywords="smtp host sunucu mail server">
                                        <label class="form-label fw-bold small" for="AdminEmailHost">
                                            @Html.DisplayNameFor(model => model.AdminEmailHost)
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.AdminEmailHostTooltip } })
                                        </label>
                                        @Html.EditorFor(model => model.AdminEmailHost, new { htmlAttributes = new { @class = "form-control", placeholder = "smtp.example.com", title = AdminResource.AdminEmailHostTooltip } })
                                        <div class="form-text small">@AdminResource.AdminEmailHostTooltip</div>
                                        @Html.ValidationMessageFor(model => model.AdminEmailHost, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Port -->
                                    <div class="col-md-4 setting-item" data-setting-name="AdminEmailPort" data-setting-label="SMTP Port Numarası" data-setting-desc="SMTP bağlantı portu (587 TLS, 465 SSL, 25 Düz)" data-keywords="port smtp port 587 465 25">
                                        <label class="form-label fw-bold small" for="AdminEmailPort">
                                            @Html.DisplayNameFor(model => model.AdminEmailPort)
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.AdminEmailPortTooltip } })
                                        </label>
                                        @Html.EditorFor(model => model.AdminEmailPort, new { htmlAttributes = new { @class = "form-control", type = "number", placeholder = "587", title = AdminResource.AdminEmailPortTooltip } })
                                        <div class="form-text small">Standart TLS için 587, SSL için 465.</div>
                                        @Html.ValidationMessageFor(model => model.AdminEmailPort, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Username -->
                                    <div class="col-md-6 setting-item" data-setting-name="AdminUserName" data-setting-label="SMTP Kullanıcı Adı" data-setting-desc="SMTP kimlik doğrulaması için hesap kullanıcı adı" data-keywords="kullanıcı adı username smtp auth">
                                        <label class="form-label fw-bold small" for="AdminUserName">
                                            @Html.DisplayNameFor(model => model.AdminUserName)
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.AdminUserNameTooltip } })
                                        </label>
                                        @Html.EditorFor(model => model.AdminUserName, new { htmlAttributes = new { @class = "form-control", placeholder = "kullanici@ornek.com", title = AdminResource.AdminUserNameTooltip } })
                                        <div class="form-text small">@AdminResource.AdminUserNameTooltip</div>
                                        @Html.ValidationMessageFor(model => model.AdminUserName, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Password with Toggle -->
                                    <div class="col-md-6 setting-item" data-setting-name="AdminEmailPassword" data-setting-label="SMTP Şifresi" data-setting-desc="SMTP sunucusu hesap giriş parolası" data-keywords="şifre parola password smtp pass">
                                        <label class="form-label fw-bold small" for="AdminEmailPassword">
                                            @Html.DisplayNameFor(model => model.AdminEmailPassword)
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.AdminEmailPasswordTooltip } })
                                        </label>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.AdminEmailPassword, new { htmlAttributes = new { @class = "form-control", type = "password", id = "txtAdminEmailPassword", placeholder = "••••••••", title = AdminResource.AdminEmailPasswordTooltip } })
                                            <button type="button" class="btn btn-outline-secondary" id="btnToggleSmtpPassword" title="Şifreyi Göster/Gizle">
                                                <i class="fa fa-eye"></i>
                                            </button>
                                        </div>
                                        <div class="form-text small">@AdminResource.AdminEmailPasswordTooltip</div>
                                        @Html.ValidationMessageFor(model => model.AdminEmailPassword, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- SSL & Default Credentials Switches -->
                                    <div class="col-md-6 setting-item" data-setting-name="AdminEmailEnableSsl" data-setting-label="SSL/TLS Güvenli Bağlantı" data-setting-desc="SMTP sunucusuna bağlanırken SSL/TLS şifrelemesi kullanır" data-keywords="ssl tls ssl enable ssl şifreleme">
                                        <div class="p-3 rounded border bg-light h-100 d-flex flex-column justify-content-between">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <label class="fw-bold mb-1 d-block" for="AdminEmailEnableSsl">
                                                        <i class="fa fa-lock text-success me-1"></i> SSL / TLS Şifrelemesi
                                                    </label>
                                                    <p class="text-muted small mb-0">SMTP bağlantısında güvenli TLS protokolü kullanılsın.</p>
                                                </div>
                                                <div class="form-check form-switch fs-5 mb-0">
                                                    @Html.CheckBoxFor(model => model.AdminEmailEnableSsl, new { @class = "form-check-input", role = "switch" })
                                                </div>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.AdminEmailEnableSsl, "", new { @class = "text-danger small mt-1 d-block" })
                                        </div>
                                    </div>

                                    <div class="col-md-6 setting-item" data-setting-name="AdminEmailUseDefaultCredentials" data-setting-label="Varsayılan Kimlik Bilgileri" data-setting-desc="SMTP için sunucunun varsayılan Windows kimlik bilgilerini kullanır" data-keywords="default credentials kimlik bilgisi windows auth">
                                        <div class="p-3 rounded border bg-light h-100 d-flex flex-column justify-content-between">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <label class="fw-bold mb-1 d-block" for="AdminEmailUseDefaultCredentials">
                                                        <i class="fa fa-id-badge text-secondary me-1"></i> Varsayılan Kimlik Bilgileri
                                                    </label>
                                                    <p class="text-muted small mb-0">SMTP sunucusu için yerel sistem kimliğini kullanır.</p>
                                                </div>
                                                <div class="form-check form-switch fs-5 mb-0">
                                                    @Html.CheckBoxFor(model => model.AdminEmailUseDefaultCredentials, new { @class = "form-check-input", role = "switch" })
                                                </div>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.AdminEmailUseDefaultCredentials, "", new { @class = "text-danger small mt-1 d-block" })
                                        </div>
                                    </div>

                                    <!-- Test Email Action Box -->
                                    <div class="col-12 mt-4">
                                        <div class="p-3 rounded border border-info bg-info-subtle d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                                            <div>
                                                <h6 class="fw-bold text-dark mb-1"><i class="fa fa-paper-plane text-primary me-1"></i> Canlı E-Posta Testi</h6>
                                                <p class="text-muted small mb-0">Yapılandırdığınız SMTP ayarlarıyla resmi firma e-posta adresinize (<code>@(string.IsNullOrWhiteSpace(Model.WebSiteCompanyEmailAddress) ? "Firma E-postası" : Model.WebSiteCompanyEmailAddress)</code>) anında test e-maili gönderin.</p>
                                            </div>
                                            <a href="@Url.Action("SendSampleEmail", "AdminSettings")" class="btn btn-primary px-3 text-nowrap shadow-sm" id="btnSendSampleEmail">
                                                <i class="fa fa-send me-1"></i> Test E-Postası Gönder
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 8. INTEGRATIONS TAB -->
                    <!-- ========================================================================= -->
                    <div id="tab-integrations" class="tab-pane fade" role="tabpanel">
                        <!-- Social Media Links -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Sosyal Medya Hesapları">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa fa-share-alt text-primary me-2"></i>@AdminResource.SocialMediaSetttings</h5>
                                <small class="text-muted">Mağazanızı temsil eden resmi sosyal medya profil ve kanal linkleri.</small>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <!-- Facebook -->
                                    <div class="col-md-6 setting-item" data-setting-name="FacebookWebSiteLink" data-setting-label="Facebook Profili" data-setting-desc="Resmi Facebook sayfa veya profil linki" data-keywords="facebook fb sosyal medya link">
                                        <label class="form-label fw-bold small" for="FacebookWebSiteLink"><i class="fa fa-facebook-square text-primary me-1"></i> Facebook</label>
                                        @Html.EditorFor(model => model.FacebookWebSiteLink, new { htmlAttributes = new { @class = "form-control", placeholder = "https://facebook.com/eimece" } })
                                        @Html.ValidationMessageFor(model => model.FacebookWebSiteLink, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Instagram -->
                                    <div class="col-md-6 setting-item" data-setting-name="InstagramWebSiteLink" data-setting-label="Instagram Profili" data-setting-desc="Resmi Instagram sayfa veya profil linki" data-keywords="instagram ig sosyal medya link">
                                        <label class="form-label fw-bold small" for="InstagramWebSiteLink"><i class="fa fa-instagram text-danger me-1"></i> Instagram</label>
                                        @Html.EditorFor(model => model.InstagramWebSiteLink, new { htmlAttributes = new { @class = "form-control", placeholder = "https://instagram.com/eimece" } })
                                        @Html.ValidationMessageFor(model => model.InstagramWebSiteLink, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Twitter / X -->
                                    <div class="col-md-6 setting-item" data-setting-name="TwitterWebSiteLink" data-setting-label="Twitter / X Profili" data-setting-desc="Resmi Twitter (X) hesap linki" data-keywords="twitter x tweet sosyal medya link">
                                        <label class="form-label fw-bold small" for="TwitterWebSiteLink"><i class="fa fa-twitter text-info me-1"></i> Twitter / X</label>
                                        @Html.EditorFor(model => model.TwitterWebSiteLink, new { htmlAttributes = new { @class = "form-control", placeholder = "https://twitter.com/eimece" } })
                                        @Html.ValidationMessageFor(model => model.TwitterWebSiteLink, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- LinkedIn -->
                                    <div class="col-md-6 setting-item" data-setting-name="LinkedinWebSiteLink" data-setting-label="LinkedIn Profili" data-setting-desc="Resmi LinkedIn şirket veya profil linki" data-keywords="linkedin şirket kariyer sosyal medya link">
                                        <label class="form-label fw-bold small" for="LinkedinWebSiteLink"><i class="fa fa-linkedin-square text-primary me-1"></i> LinkedIn</label>
                                        @Html.EditorFor(model => model.LinkedinWebSiteLink, new { htmlAttributes = new { @class = "form-control", placeholder = "https://linkedin.com/company/eimece" } })
                                        @Html.ValidationMessageFor(model => model.LinkedinWebSiteLink, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- YouTube -->
                                    <div class="col-md-6 setting-item" data-setting-name="YotubeWebSiteLink" data-setting-label="YouTube Kanalı" data-setting-desc="Resmi YouTube video kanalı linki" data-keywords="youtube video kanal link yotube">
                                        <label class="form-label fw-bold small" for="YotubeWebSiteLink"><i class="fa fa-youtube-play text-danger me-1"></i> YouTube</label>
                                        @Html.EditorFor(model => model.YotubeWebSiteLink, new { htmlAttributes = new { @class = "form-control", placeholder = "https://youtube.com/@eimece" } })
                                        @Html.ValidationMessageFor(model => model.YotubeWebSiteLink, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Pinterest -->
                                    <div class="col-md-6 setting-item" data-setting-name="PinterestWebSiteLink" data-setting-label="Pinterest Profili" data-setting-desc="Resmi Pinterest pano linki" data-keywords="pinterest pano pin sosyal medya link">
                                        <label class="form-label fw-bold small" for="PinterestWebSiteLink"><i class="fa fa-pinterest text-danger me-1"></i> Pinterest</label>
                                        @Html.EditorFor(model => model.PinterestWebSiteLink, new { htmlAttributes = new { @class = "form-control", placeholder = "https://pinterest.com/eimece" } })
                                        @Html.ValidationMessageFor(model => model.PinterestWebSiteLink, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Direct Communication & Live Support -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Canlı Destek & WhatsApp">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa fa-comments text-primary me-2"></i>Anlık İletişim &amp; Canlı Destek Servisleri</h5>
                                <small class="text-muted">WhatsApp doğrudan mesaj linki ve üçüncü parti canlı destek widget'ları.</small>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <!-- WhatsApp Direct Link -->
                                    <div class="col-md-6 setting-item" data-setting-name="WhatsAppCommunicationLink" data-setting-label="WhatsApp İletişim Linki" data-setting-desc="Müşterilerin tek tıkla mesaj atmasını sağlayan WhatsApp linki (örn: https://wa.me/90555...)" data-keywords="whatsapp wa.me direkt mesaj link iletişim">
                                        <label class="form-label fw-bold small" for="WhatsAppCommunicationLink">
                                            <i class="fa fa-whatsapp text-success me-1"></i> @Html.DisplayNameFor(model => model.WhatsAppCommunicationLink)
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.WhatsAppCommunicationLinkTooltip } })
                                        </label>
                                        @Html.EditorFor(model => model.WhatsAppCommunicationLink, new { htmlAttributes = new { @class = "form-control", placeholder = "https://wa.me/905555550123", title = AdminResource.WhatsAppCommunicationLinkTooltip } })
                                        <div class="form-text small">@AdminResource.WhatsAppCommunicationLinkTooltip</div>
                                        @Html.ValidationMessageFor(model => model.WhatsAppCommunicationLink, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- WhatsApp Script -->
                                    <div class="col-md-6 setting-item" data-setting-name="WhatsAppCommunicationScript" data-setting-label="WhatsApp Eklenti Scripti" data-setting-desc="Özel WhatsApp sohbet widget'ı veya buton scripti" data-keywords="whatsapp script widget eklenti kod">
                                        <label class="form-label fw-bold small" for="WhatsAppCommunicationScript">
                                            <i class="fa fa-code text-secondary me-1"></i> @Html.DisplayNameFor(model => model.WhatsAppCommunicationScript)
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.WhatsAppCommunicationScriptTooltip } })
                                        </label>
                                        @Html.TextAreaFor(model => model.WhatsAppCommunicationScript, 3, 50, new { @class = "form-control font-monospace", placeholder = "<script>...</script>", title = AdminResource.WhatsAppCommunicationScriptTooltip })
                                        <div class="form-text small">@AdminResource.WhatsAppCommunicationScriptTooltip</div>
                                        @Html.ValidationMessageFor(model => model.WhatsAppCommunicationScript, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Zopim / Zendesk Live Chat -->
                                    <div class="col-12 setting-item" data-setting-name="Zopim" data-setting-label="Zopim / Zendesk Canlı Destek Scripti" data-setting-desc="Zopim veya Zendesk Chat canlı destek eklenti kodu" data-keywords="zopim zendesk canlı destek chat widget script">
                                        <label class="form-label fw-bold small" for="Zopim"><i class="fa fa-commenting text-primary me-1"></i> @Html.DisplayNameFor(model => model.Zopim) (Canlı Destek Scripti)</label>
                                        @Html.TextAreaFor(model => model.Zopim, 3, 50, new { @class = "form-control font-monospace", placeholder = "window.$zopim||(function(d,s){...})(document,'script');" })
                                        <div class="form-text small">Zopim / Zendesk Chat gibi harici canlı destek platformlarının entegrasyon scripti.</div>
                                        @Html.ValidationMessageFor(model => model.Zopim, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Analytics & Maps -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Analitik & Harita Servisleri">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa fa-line-chart text-primary me-2"></i>Analitik &amp; Harita Scriptleri</h5>
                                <small class="text-muted">Google Analytics takip kodları ve Google Harita yerleştirme (iframe) kodları.</small>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-warning py-2 px-3 mb-3 small">
                                    <i class="fa fa-exclamation-triangle me-1"></i> <strong>Güvenlik Uyarısı:</strong> Buraya eklenen scriptler doğrudan mağaza sayfalarında çalıştırılır. Yalnızca güvendiğiniz üçüncü parti servislerin kodlarını ekleyin.
                                </div>
                                <div class="row g-3">
                                    <!-- Google Analytics -->
                                    <div class="col-md-6 setting-item" data-setting-name="GoogleAnalyticsTrackingScript" data-setting-label="Google Analytics Takip Kodu" data-setting-desc="Google Analytics (GA4 / GTM) global site etiketi (gtag.js)" data-keywords="google analytics ga4 gtag gtm analiz tracking script">
                                        <label class="form-label fw-bold small" for="GoogleAnalyticsTrackingScript">
                                            @Html.DisplayNameFor(model => model.GoogleAnalyticsTrackingScript)
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.GoogleAnalyticsTrackingScriptTooltip } })
                                        </label>
                                        @Html.TextAreaFor(model => model.GoogleAnalyticsTrackingScript, 6, 50, new { @class = "form-control font-monospace", placeholder = "<script async src='https://www.googletagmanager.com/gtag/js?id=G-...'></script>\n<script>...</script>", title = AdminResource.GoogleAnalyticsTrackingScriptTooltip })
                                        <div class="form-text small">@AdminResource.GoogleAnalyticsTrackingScriptTooltip (Sayfa <code>&lt;head&gt;</code> alanında çalıştırılır).</div>
                                        @Html.ValidationMessageFor(model => model.GoogleAnalyticsTrackingScript, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Google Maps -->
                                    <div class="col-md-6 setting-item" data-setting-name="GoogleMapScript" data-setting-label="Google Harita Yerleştirme (Iframe)" data-setting-desc="İletişim ve hakkımızda sayfalarında gösterilecek Google Haritalar iframe yerleştirme kodu" data-keywords="google map harita iframe konum google maps script">
                                        <label class="form-label fw-bold small" for="GoogleMapScript">
                                            @Html.DisplayNameFor(model => model.GoogleMapScript)
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.GoogleMapScriptTooltip } })
                                        </label>
                                        @Html.TextAreaFor(model => model.GoogleMapScript, 6, 50, new { @class = "form-control font-monospace", placeholder = "<iframe src='https://www.google.com/maps/embed?...' width='600' height='450' style='border:0;' allowfullscreen='' loading='lazy'></iframe>", title = AdminResource.GoogleMapScriptTooltip })
                                        <div class="form-text small">@AdminResource.GoogleMapScriptTooltip (İletişim sayfasında harita kutusunda gösterilir).</div>
                                        @Html.ValidationMessageFor(model => model.GoogleMapScript, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 9. MAINTENANCE & SYSTEM TOOLS TAB -->
                    <!-- ========================================================================= -->
                    <div id="tab-tools" class="tab-pane fade" role="tabpanel">
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Sistem Araçları & Operasyonlar">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa fa-wrench text-primary me-2"></i>Sistem Araçları, Sağlık Kontrolü &amp; Yedekleme</h5>
                                <small class="text-muted">Performans metrikleri, günlükler ve tam sistem verisi dışa aktarma operasyonları.</small>
                            </div>
                            <div class="card-body">
                                <div class="row g-4">
                                    <!-- Monitoring & Health -->
                                    <div class="col-md-4">
                                        <div class="p-3 border rounded h-100 bg-light d-flex flex-column justify-content-between shadow-sm">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                    <span class="p-2 bg-primary-subtle text-primary rounded"><i class="fa fa-dashboard fa-lg"></i></span>
                                                    <h6 class="fw-bold mb-0">@AdminResource.SystemMonitoring</h6>
                                                </div>
                                                <p class="text-muted small mb-3">Sistem kaynak kullanımını, veritabanı yanıt sürelerini ve sağlık durumunu inceleyin.</p>
                                            </div>
                                            <div class="d-flex flex-column gap-2">
                                                <a href="@Url.Action("Index", "Metrics", new { area = "admin" })" class="btn btn-primary btn-sm w-100">
                                                    <i class="fa fa-line-chart me-1"></i> @AdminResource.Metrics
                                                </a>
                                                <a href="@Url.Action("Index", "Health", new { area = "" })" class="btn btn-outline-secondary btn-sm w-100" target="_blank" rel="noopener noreferrer">
                                                    <i class="fa fa-heartbeat text-danger me-1"></i> @AdminResource.Health (Canlı Durum)
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Logs & Asset Maintenance -->
                                    <div class="col-md-4">
                                        <div class="p-3 border rounded h-100 bg-light d-flex flex-column justify-content-between shadow-sm">
                                            <div>
                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                    <span class="p-2 bg-warning-subtle text-warning rounded"><i class="fa fa-cogs fa-lg"></i></span>
                                                    <h6 class="fw-bold mb-0">@AdminResource.AppLogs &amp; Bakım</h6>
                                                </div>
                                                <p class="text-muted small mb-3">Uygulama hata kayıtlarını izleyin veya optimize edilmiş medya arşivini indirin.</p>
                                            </div>
                                            <div class="d-flex flex-column gap-2">
                                                @Html.ActionLink(AdminResource.AppLogs, "Index", "AppLogs", null, new { @class = "btn btn-warning btn-sm w-100 text-dark fw-bold" })
                                                <a href="@Url.Action("DownloadCompressedImages", "Images", new { area = "admin" })" class="btn btn-outline-primary btn-sm w-100">
                                                    <i class="fa fa-file-archive-o me-1"></i> Sıkıştırılmış Görseller (ZIP)
                                                </a>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- JSON Backup & Export -->
                                    <div class="col-md-4">
                                        <div class="p-3 border border-success rounded h-100 d-flex flex-column justify-content-between shadow-sm" style="background-color: #f8fff9;">
                                            <div>
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="p-2 bg-success-subtle text-success rounded"><i class="fa fa-database fa-lg"></i></span>
                                                        <h6 class="fw-bold mb-0 text-success">Veri Yedekleme (JSON)</h6>
                                                    </div>
                                                </div>
                                                <p class="text-muted small mb-2">Tüm katalog, sipariş ve ayar verilerini ilişkileri korumalı versiyonlu JSON formatında yedekleyin.</p>
                                                <div class="d-flex flex-wrap gap-1 mb-3">
                                                    <span class="badge bg-success small">v1.0 JSON</span>
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle small">İlişki Korumalı</span>
                                                    <span class="badge bg-secondary-subtle text-secondary small">ZIP Paket</span>
                                                </div>
                                            </div>
                                            <div>
                                                <a href="@Url.Action("ExportBackup", "AdminSettings", new { area = "admin" })" class="btn btn-success btn-sm w-100 fw-bold btn-export-backup shadow-sm" id="btnExportBackup" title="Tüm sistem verilerini JSON ZIP olarak dışa aktar">
                                                    <i class="fa fa-download me-1"></i> Verileri Dışa Aktar (ZIP)
                                                </a>
                                                <p class="text-muted mt-2 mb-0" style="font-size: 11px;">
                                                    <i class="fa fa-lock text-success me-1"></i> Şifreler ve kart bilgileri güvenlik nedeniyle yedek paketine dahil edilmez.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

<!-- ========================================================================= -->
<!-- STYLES -->
<!-- ========================================================================= -->
<style>
    .settings-center-container {
        font-family: inherit;
        padding-bottom: 40px;
    }
    .settings-header-banner {
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 16px;
    }
    .settings-main-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1e293b;
    }
    .settings-search-wrapper {
        min-width: 320px;
        max-width: 440px;
    }
    .settings-search-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #fff;
        border: 1px solid #cbd5e1;
        z-index: 1050;
        margin-top: 4px;
    }
    .search-result-item {
        cursor: pointer;
        padding: 10px 14px;
        transition: background 0.15s ease;
    }
    .search-result-item:hover {
        background-color: #f1f5f9;
    }
    .search-result-item .result-title {
        font-weight: 600;
        color: #0f172a;
        font-size: 0.875rem;
    }
    .search-result-item .result-category {
        font-size: 0.75rem;
        color: #64748b;
    }
    .search-result-item .result-desc {
        font-size: 0.8rem;
        color: #475569;
    }
    .settings-nav-domain-header {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: #94a3b8;
        padding: 12px 16px 4px 16px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }
    .settings-nav-domain-header:first-of-type {
        border-top: none;
    }
    .settings-tab-menu .list-group-item {
        border: none;
        border-radius: 0;
        padding: 10px 16px;
        font-size: 0.875rem;
        color: #334155;
        border-left: 3px solid transparent;
        transition: all 0.15s ease;
    }
    .settings-tab-menu .list-group-item:hover {
        background-color: #f1f5f9;
        color: #0284c7;
    }
    .settings-tab-menu .list-group-item.active {
        background-color: #e0f2fe;
        color: #0369a1;
        font-weight: 600;
        border-left-color: #0284c7;
    }
    .setting-section-card {
        border-radius: 8px;
        border: 1px solid #e2e8f0;
    }
    .setting-section-card .card-header {
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }
    .setting-item {
        transition: background-color 0.2s ease, box-shadow 0.2s ease;
    }
    .setting-item.highlight-pulse {
        animation: pulseHighlight 1.6s cubic-bezier(0.4, 0, 0.6, 1);
    }
    @@keyframes pulseHighlight {
        0%, 100% { background-color: #f8fafc; box-shadow: none; }
        50% { background-color: #fef08a; box-shadow: 0 0 0 3px #facc15; }
    }
    .sticky-save-bar {
        position: -webkit-sticky;
        position: sticky;
        top: 10px;
        z-index: 1020;
        background-color: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(8px);
        border-radius: 8px;
    }
    .theme-select-card:hover {
        transform: translateY(-2px);
    }
</style>

<!-- ========================================================================= -->
<!-- JAVASCRIPT LOGIC -->
<!-- ========================================================================= -->
<script>
    (function () {
        var isFormDirty = false;
        var initialFormData = null;

        function navigateToTab(tabHash) {
            if (!tabHash) return;
            var $link = $('.settings-tab-menu a[href="' + tabHash + '"]');
            if ($link.length) {
                $link.tab('show');
                window.location.hash = tabHash;
                $('html, body').animate({ scrollTop: 0 }, 150);
            }
        }
        window.navigateToTab = navigateToTab;

        function syncPaymentState() {
            var isPriceEnabled = $('#IsProductPriceEnable').is(':checked');
            if (isPriceEnabled) {
                $('#payment-disabled-alert').slideUp(150);
                $('.payment-disabled-badge').addClass('d-none');
                $('#payment-settings-fields').css({ 'opacity': '1', 'pointer-events': 'auto' });
                $('.payment-input').prop('disabled', false);
            } else {
                $('#payment-disabled-alert').slideDown(150);
                $('.payment-disabled-badge').removeClass('d-none');
                $('#payment-settings-fields').css({ 'opacity': '0.5', 'pointer-events': 'none' });
                $('.payment-input').prop('disabled', true);
            }
        }

        function syncCaptchaState() {
            var selected = $('#CaptchaProvider').val();
            if (selected === 'Recaptcha') {
                $('#recaptchaSiteKeyWrapper').slideDown(150);
            } else {
                $('#recaptchaSiteKeyWrapper').slideUp(150);
            }
        }

        function syncRateLimitState() {
            var isRateLimit = $('#RateLimit_Enabled').is(':checked');
            if (isRateLimit) {
                $('#rateLimitConfigContainer').css({ 'opacity': '1', 'pointer-events': 'auto' });
            } else {
                $('#rateLimitConfigContainer').css({ 'opacity': '0.5', 'pointer-events': 'none' });
            }
        }

        function updateDirtyState() {
            if (!initialFormData) return;
            var currentData = $('#systemSettingsForm').serialize();
            isFormDirty = (currentData !== initialFormData);

            if (isFormDirty) {
                $('#saveStatusIndicator').addClass('d-none');
                $('#unsavedChangesBadge').removeClass('d-none');
                $('#btnDiscardChanges').prop('disabled', false);
                $('#stickySaveBar').addClass('border-warning').removeClass('border-primary');
            } else {
                $('#saveStatusIndicator').removeClass('d-none');
                $('#unsavedChangesBadge').addClass('d-none');
                $('#btnDiscardChanges').prop('disabled', true);
                $('#stickySaveBar').addClass('border-primary').removeClass('border-warning');
            }
        }

        // Global Search Logic
        function initSearch() {
            var $searchInput = $('#globalSettingsSearch');
            var $clearBtn = $('#btnClearSettingsSearch');
            var $resultsContainer = $('#settingsSearchResults');
            var $resultsList = $('#searchResultsList');
            var $resultCount = $('#searchResultCount');

            // Build search index from DOM
            var searchIndex = [];
            $('.setting-item').each(function () {
                var $item = $(this);
                var name = $item.data('setting-name') || '';
                var label = $item.data('setting-label') || $item.find('label').first().text().trim() || name;
                var desc = $item.data('setting-desc') || $item.find('.form-text').first().text().trim() || '';
                var keywords = $item.data('keywords') || '';
                var $tabPane = $item.closest('.tab-pane');
                var tabId = $tabPane.attr('id') || 'overview';
                var sectionName = $item.closest('.setting-section-card').data('section-name') || 'Genel';

                if (name || label) {
                    searchIndex.push({
                        element: $item,
                        name: name.toLowerCase(),
                        label: label,
                        desc: desc,
                        keywords: keywords.toLowerCase(),
                        tabId: '#' + tabId,
                        sectionName: sectionName
                    });
                }
            });

            function performSearch(query) {
                query = (query || '').trim().toLowerCase();
                if (!query) {
                    $resultsContainer.hide();
                    $clearBtn.addClass('d-none');
                    return;
                }

                $clearBtn.removeClass('d-none');
                var matches = searchIndex.filter(function (item) {
                    return item.label.toLowerCase().indexOf(query) >= 0 ||
                           item.desc.toLowerCase().indexOf(query) >= 0 ||
                           item.name.indexOf(query) >= 0 ||
                           item.keywords.indexOf(query) >= 0 ||
                           item.sectionName.toLowerCase().indexOf(query) >= 0;
                });

                $resultCount.text(matches.length);
                $resultsList.empty();

                if (matches.length === 0) {
                    $resultsList.html('<div class="p-3 text-center text-muted small"><i class="fa fa-info-circle me-1"></i> Eşleşen ayar bulunamadı</div>');
                } else {
                    matches.forEach(function (m) {
                        var $row = $('<div class="search-result-item border-bottom">' +
                            '<div class="d-flex justify-content-between align-items-center mb-1">' +
                                '<span class="result-title">' + m.label + '</span>' +
                                '<span class="result-category badge bg-light text-secondary border">' + m.sectionName + '</span>' +
                            '</div>' +
                            '<div class="result-desc text-truncate">' + m.desc + '</div>' +
                        '</div>');

                        $row.on('click', function () {
                            $resultsContainer.hide();
                            $searchInput.val('');
                            $clearBtn.addClass('d-none');

                            // Show tab
                            navigateToTab(m.tabId);

                            // Scroll and highlight
                            setTimeout(function () {
                                var targetOffset = m.element.offset().top - 120;
                                $('html, body').animate({ scrollTop: targetOffset }, 200, function () {
                                    m.element.addClass('highlight-pulse');
                                    setTimeout(function () {
                                        m.element.removeClass('highlight-pulse');
                                    }, 2000);
                                    var $input = m.element.find('input, select, textarea').first();
                                    if ($input.length) {
                                        $input.focus();
                                    }
                                });
                            }, 150);
                        });

                        $resultsList.append($row);
                    });
                }

                $resultsContainer.show();
            }

            $searchInput.on('input', function () {
                performSearch($(this).val());
            });

            $clearBtn.on('click', function () {
                $searchInput.val('').focus();
                $resultsContainer.hide();
                $clearBtn.addClass('d-none');
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.settings-search-wrapper').length) {
                    $resultsContainer.hide();
                }
            });
        }

        // Initialize document
        $(function () {
            // Active storefront theme dropdown
            $('#ActiveDesign').on('change', function () {
                var selectedTheme = $(this).val();
                $('#themeDisplayName').text(selectedTheme);
                $('#themeFolderName').text(selectedTheme);
                updateDirtyState();
            });

            // Password reveal toggle
            $('#btnToggleSmtpPassword').on('click', function () {
                var $pwd = $('#txtAdminEmailPassword');
                var $icon = $(this).find('i');
                if ($pwd.attr('type') === 'password') {
                    $pwd.attr('type', 'text');
                    $icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    $pwd.attr('type', 'password');
                    $icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Hash persistence & routing
            var hash = window.location.hash;
            if (hash) {
                // Map legacy aliases
                if (hash === '#tab-design') hash = '#tab-appearance';
                if (hash === '#tab-social' || hash === '#tab-scripts') hash = '#tab-integrations';
                
                var $targetTab = $(".settings-tab-menu a[href='" + hash + "']");
                if ($targetTab.length) {
                    $targetTab.tab('show');
                }
            }

            $('.settings-tab-menu a').on('click', function (e) {
                $(this).tab('show');
                var scrollmem = $('body').scrollTop() || $('html').scrollTop();
                window.location.hash = this.hash;
                $('html,body').scrollTop(scrollmem);
            });

            // Sync dynamic states
            $('#IsProductPriceEnable').on('change', function () {
                syncPaymentState();
                updateDirtyState();
            });
            $('#CaptchaProvider').on('change', function () {
                syncCaptchaState();
                updateDirtyState();
            });
            $('#RateLimit_Enabled').on('change', function () {
                syncRateLimitState();
                updateDirtyState();
            });

            syncPaymentState();
            syncCaptchaState();
            syncRateLimitState();

            // Track dirty form state
            initialFormData = $('#systemSettingsForm').serialize();
            $('#systemSettingsForm').on('input change', 'input, select, textarea', function () {
                updateDirtyState();
            });

            // Discard changes button
            $('#btnDiscardChanges').on('click', function () {
                if (confirm("Yapılan kaydedilmemiş tüm değişiklikler geri alınsın mı?")) {
                    window.location.reload();
                }
            });

            // Warn on unload if dirty
            window.addEventListener('beforeunload', function (e) {
                if (isFormDirty) {
                    e.preventDefault();
                    e.returnValue = 'Kaydedilmemiş değişiklikleriniz var. Sayfadan ayrılmak istediğinize emin misiniz?';
                    return e.returnValue;
                }
            });

            // Form submit clears dirty flag
            $('#systemSettingsForm').on('submit', function () {
                isFormDirty = false;
            });

            // Auto-navigate to first invalid field tab if validation errors exist
            var $firstInvalid = $('#systemSettingsForm').find('.input-validation-error, .text-danger:not(:empty)').first();
            if ($firstInvalid.length) {
                var $parentPane = $firstInvalid.closest('.tab-pane');
                if ($parentPane.length && $parentPane.attr('id')) {
                    var tabSelector = '#' + $parentPane.attr('id');
                    navigateToTab(tabSelector);
                    $('html, body').animate({ scrollTop: $firstInvalid.offset().top - 120 }, 200);
                }
            }

            // Init search index
            initSearch();
        });
    })();
</script>

@Html.Partial("_AdminInitTooltips")
