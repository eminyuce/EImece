<!-- ========================================================================= -->
<!-- JAVASCRIPT LOGIC -->
<!-- ========================================================================= -->
<script>
    (function () {
        var isFormDirty = false;
        var initialFormData = null;

        function navigateToTab(tabHash) {
            if (!tabHash) return;
            var $link = $('.settings-tab-menu a[href="' + tabHash + '"]');
            if ($link.length) {
                if (window.bootstrap && bootstrap.Tab) {
                    bootstrap.Tab.getOrCreateInstance($link[0]).show();
                } else if ($link.tab) {
                    $link.tab('show');
                }
                window.location.hash = tabHash;
                $('html, body').animate({ scrollTop: 0 }, 150);
            }
        }
        window.navigateToTab = navigateToTab;

        function syncPaymentState() {
            var isPriceEnabled = $('#IsProductPriceEnable').is(':checked');
            // Any price related input is fully hidden when pricing is disabled.
            $('.price-dependent-setting').each(function () {
                if (isPriceEnabled) { $(this).removeClass('d-none'); } else { $(this).addClass('d-none'); }
            });
            if (isPriceEnabled) {
                $('#payment-disabled-alert').slideUp(150);
                $('.payment-disabled-badge').addClass('d-none');
                $('#payment-settings-fields').removeClass('d-none');
                $('#payment-settings-fields').css({ 'opacity': '1', 'pointer-events': 'auto' });
                $('.payment-input').prop('disabled', false);
            } else {
                $('#payment-disabled-alert').slideDown(150);
                $('.payment-disabled-badge').removeClass('d-none');
                $('#payment-settings-fields').css({ 'opacity': '', 'pointer-events': '' });
                $('#payment-settings-fields').addClass('d-none');
            }
        }

        function syncCaptchaState() {
            var selected = $('#CaptchaProvider').val();
            if (selected === 'Recaptcha') {
                $('#recaptchaSiteKeyWrapper').slideDown(150);
            } else {
                $('#recaptchaSiteKeyWrapper').slideUp(150);
            }
        }

        function syncRateLimitState() {
            var isRateLimit = $('#RateLimit_Enabled').is(':checked');
            if (isRateLimit) {
                $('#rateLimitConfigContainer').css({ 'opacity': '1', 'pointer-events': 'auto' });
            } else {
                $('#rateLimitConfigContainer').css({ 'opacity': '0.5', 'pointer-events': 'none' });
            }
        }

        function updateDirtyState() {
            if (!initialFormData) return;
            var currentData = $('#systemSettingsForm').serialize();
            isFormDirty = (currentData !== initialFormData);

            if (isFormDirty) {
                $('#saveStatusIndicator').addClass('d-none');
                $('#unsavedChangesBadge').removeClass('d-none');
                $('#btnDiscardChanges').prop('disabled', false);
                $('#stickySaveBar').addClass('border-warning').removeClass('border-primary');
            } else {
                $('#saveStatusIndicator').removeClass('d-none');
                $('#unsavedChangesBadge').addClass('d-none');
                $('#btnDiscardChanges').prop('disabled', true);
                $('#stickySaveBar').addClass('border-primary').removeClass('border-warning');
            }
        }

        // Global Search Logic
        function initSearch() {
            var $searchInput = $('#globalSettingsSearch');
            var $clearBtn = $('#btnClearSettingsSearch');
            var $resultsContainer = $('#settingsSearchResults');
            var $resultsList = $('#searchResultsList');
            var $resultCount = $('#searchResultCount');

            // Build search index from DOM
            var searchIndex = [];
            $('.setting-item').each(function () {
                var $item = $(this);
                var name = $item.data('setting-name') || '';
                var label = $item.data('setting-label') || $item.find('label').first().text().trim() || name;
                var desc = $item.data('setting-desc') || $item.find('.form-text').first().text().trim() || '';
                var keywords = $item.data('keywords') || '';
                var $tabPane = $item.closest('.tab-pane');
                var tabId = $tabPane.attr('id') || 'overview';
                var sectionName = $item.closest('.setting-section-card').data('section-name') || 'Genel';

                if (name || label) {
                    searchIndex.push({
                        element: $item,
                        name: name.toLowerCase(),
                        label: label,
                        desc: desc,
                        keywords: keywords.toLowerCase(),
                        tabId: '#' + tabId,
                        sectionName: sectionName
                    });
                }
            });

            function performSearch(query) {
                query = (query || '').trim().toLowerCase();
                if (!query) {
                    $resultsContainer.hide();
                    $clearBtn.addClass('d-none');
                    return;
                }

                $clearBtn.removeClass('d-none');
                var matches = searchIndex.filter(function (item) {
                    return item.label.toLowerCase().indexOf(query) >= 0 ||
                           item.desc.toLowerCase().indexOf(query) >= 0 ||
                           item.name.indexOf(query) >= 0 ||
                           item.keywords.indexOf(query) >= 0 ||
                           item.sectionName.toLowerCase().indexOf(query) >= 0;
                });

                $resultCount.text(matches.length);
                $resultsList.empty();

                if (matches.length === 0) {
                    $resultsList.html('<div class="p-3 text-center text-muted small"><i class="fa-solid fa-circle-info me-1"></i> @AdminResource.NoMatchingSettingsFound</div>');
                } else {
                    matches.forEach(function (m) {
                        var $row = $('<div class="search-result-item border-bottom">' +
                            '<div class="d-flex justify-content-between align-items-center mb-1">' +
                                '<span class="result-title">' + m.label + '</span>' +
                                '<span class="result-category badge bg-light text-secondary border">' + m.sectionName + '</span>' +
                            '</div>' +
                            '<div class="result-desc text-truncate">' + m.desc + '</div>' +
                        '</div>');

                        $row.on('click', function () {
                            $resultsContainer.hide();
                            $searchInput.val('');
                            $clearBtn.addClass('d-none');

                            // Show tab
                            navigateToTab(m.tabId);

                            // Scroll and highlight
                            setTimeout(function () {
                                var targetOffset = m.element.offset().top - 120;
                                $('html, body').animate({ scrollTop: targetOffset }, 200, function () {
                                    m.element.addClass('highlight-pulse');
                                    setTimeout(function () {
                                        m.element.removeClass('highlight-pulse');
                                    }, 2000);
                                    var $input = m.element.find('input, select, textarea').first();
                                    if ($input.length) {
                                        $input.focus();
                                    }
                                });
                            }, 150);
                        });

                        $resultsList.append($row);
                    });
                }

                $resultsContainer.show();
            }

            $searchInput.on('input', function () {
                performSearch($(this).val());
            });

            $clearBtn.on('click', function () {
                $searchInput.val('').focus();
                $resultsContainer.hide();
                $clearBtn.addClass('d-none');
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('.settings-search-wrapper').length) {
                    $resultsContainer.hide();
                }
            });
        }

        // Initialize document
        $(function () {
            // Active storefront theme dropdown
            $('#ActiveDesign').on('change', function () {
                var selectedTheme = $(this).val();
                $('#themeDisplayName').text(selectedTheme);
                $('#themeFolderName').text(selectedTheme);
                updateDirtyState();
            });

            // Password reveal toggle
            $('#btnToggleSmtpPassword').on('click', function () {
                var $pwd = $('#txtAdminEmailPassword');
                var $icon = $(this).find('i');
                if ($pwd.attr('type') === 'password') {
                    $pwd.attr('type', 'text');
                    $icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    $pwd.attr('type', 'password');
                    $icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Hash persistence & routing
            var hash = window.location.hash;
            if (hash) {
                // Map legacy aliases
                if (hash === '#tab-design') hash = '#tab-appearance';
                if (hash === '#tab-social' || hash === '#tab-scripts') hash = '#tab-integrations';
                if (hash === '#tab-company') {
                    // Company settings moved to the general settings page.
                    window.location.href = '@Url.Action("Index", "AdminSettings", new { area = "admin" })';
                    return;
                }
                
                var $targetTab = $(".settings-tab-menu a[href='" + hash + "']");
                if ($targetTab.length) {
                    if (window.bootstrap && bootstrap.Tab) {
                        bootstrap.Tab.getOrCreateInstance($targetTab[0]).show();
                    } else if ($targetTab.tab) {
                        $targetTab.tab('show');
                    }
                }
            }

            $('.settings-tab-menu a').on('click', function (e) {
                if (window.bootstrap && bootstrap.Tab) {
                    bootstrap.Tab.getOrCreateInstance(this).show();
                } else if ($(this).tab) {
                    $(this).tab('show');
                }
                var scrollmem = $('body').scrollTop() || $('html').scrollTop();
                window.location.hash = this.hash;
                $('html,body').scrollTop(scrollmem);
            });

            // Sync dynamic states
            $('#IsProductPriceEnable').on('change', function () {
                syncPaymentState();
                updateDirtyState();
            });
            $('#CaptchaProvider').on('change', function () {
                syncCaptchaState();
                updateDirtyState();
            });
            $('#RateLimit_Enabled').on('change', function () {
                syncRateLimitState();
                updateDirtyState();
            });

            // Suitable for sale product states sync
            function syncSaleStatesString() {
                var selected = [];
                $('.sale-state-chk:checked').each(function () {
                    selected.push($(this).val());
                });
                $('#SuitableForSaleProductStates').val(selected.join(',')).trigger('input');
                updateDirtyState();
            }

            $('.sale-state-chk').on('change', function () {
                syncSaleStatesString();
            });

            $('#btnSelectDefaultSaleStates').on('click', function () {
                var defaultStates = ['ProductInStock', 'PreOrder', 'LimitedStock'];
                $('.sale-state-chk').each(function () {
                    var val = $(this).val();
                    $(this).prop('checked', defaultStates.indexOf(val) !== -1);
                });
                syncSaleStatesString();
            });

            $('#btnSelectAllSaleStates').on('click', function () {
                $('.sale-state-chk').prop('checked', true);
                syncSaleStatesString();
            });

            $('#btnClearAllSaleStates').on('click', function () {
                $('.sale-state-chk').prop('checked', false);
                syncSaleStatesString();
            });

            syncPaymentState();
            syncCaptchaState();
            syncRateLimitState();

            // Track dirty form state
            initialFormData = $('#systemSettingsForm').serialize();
            $('#systemSettingsForm').on('input change', 'input, select, textarea', function () {
                updateDirtyState();
            });

            // Discard changes button
            $('#btnDiscardChanges').on('click', function () {
                if (confirm("@AdminResource.DiscardUnsavedChangesPrompt")) {
                    window.location.reload();
                }
            });

            function syncContentLanguageHints() {
                var tr = $('#ContentLanguageTurkish').is(':checked');
                var en = $('#ContentLanguageEnglish').is(':checked');
                var $single = $('#contentLanguageSingleHint');
                var $bilingual = $('#contentLanguageBilingualHint');
                if (tr && en) {
                    $single.hide();
                    $bilingual.show();
                } else {
                    var name = en ? $single.attr('data-name-en') : $single.attr('data-name-tr');
                    $('#contentLanguageActiveName').text(name);
                    $('#contentLanguageFlagTr').toggle(!en);
                    $('#contentLanguageFlagUs').toggle(en);
                    $bilingual.hide();
                    $single.show();
                }
            }

            $('.content-language-checkbox').on('click', function (e) {
                if ($('.content-language-checkbox:checked').length === 0) {
                    e.preventDefault();
                    $(this).prop('checked', true);
                    alert($('#contentLanguageSingleHint').attr('data-at-least-one'));
                    return false;
                }
            });
            $('.content-language-checkbox').on('change', syncContentLanguageHints);
            syncContentLanguageHints();

            // Quick change Admin Panel Language button
            $('#btnChangeAdminLanguage').on('click', function () {
                var selectedLang = $('#AdminPanelLanguage').val();
                if (!selectedLang) return;

                var $btn = $(this);
                var originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> @AdminResource.Processing');

                var token = $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val()
                    || $('#systemSettingsForm input[name="__RequestVerificationToken"]').val()
                    || $('input[name="__RequestVerificationToken"]').first().val();

                $.ajax({
                    url: '@Url.Action("ChangeAdminPanelLanguage", "AdminSettings", new { area = "admin" })',
                    type: 'POST',
                    data: {
                        language: selectedLang,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res && res.success) {
                            isFormDirty = false;
                            window.location.reload();
                        } else {
                            alert(res && res.message ? res.message : 'Error updating language.');
                            $btn.prop('disabled', false).html(originalHtml);
                        }
                    },
                    error: function () {
                        alert('Error updating language.');
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            });

            // Warn on unload if dirty
            window.addEventListener('beforeunload', function (e) {
                if (isFormDirty) {
                    e.preventDefault();
                    e.returnValue = '@AdminResource.UnsavedChangesLeavePrompt';
                    return e.returnValue;
                }
            });

            // Form submit clears dirty flag
            $('#systemSettingsForm').on('submit', function () {
                isFormDirty = false;
            });

            // Auto-navigate to first invalid field tab if validation errors exist
            var $firstInvalid = $('#systemSettingsForm').find('.input-validation-error, .field-validation-error:not(:empty)').first();
            if ($firstInvalid.length && (!window.location.hash || window.location.hash === '#overview')) {
                var $parentPane = $firstInvalid.closest('.tab-pane');
                if ($parentPane.length && $parentPane.attr('id')) {
                    var tabSelector = '#' + $parentPane.attr('id');
                    navigateToTab(tabSelector);
                    $('html, body').animate({ scrollTop: $firstInvalid.offset().top - 120 }, 200);
                }
            }

            // Init search index
            initSearch();
        });
    })();
</script>
<script>
(function(){
  // Mobile drawer & scrollable tabs
  var $navCard = $('#settingsNavCard');
  var $overlay = $('#settingsNavOverlay');
  var $trigger = $('#btnOpenSettingsNav');
  var $mobileTabs = $('#settingsMobileTabs');
  var $tabLinks = $('#settingsTabs a[data-bs-toggle="pill"]');
  function syncMobileLabel(){
    var $active = $('#settingsTabs a.active');
    var txt = $active.text().trim().split('\n')[0].trim() || 'Genel Bakış';
    $('#mobileActiveCategoryLabel').text(txt.replace(/\s+/g,' ').slice(0,24));
  }
  function buildMobileTabs(){
    if(!$mobileTabs.length) return;
    $mobileTabs.empty();
    $tabLinks.each(function(){
      var $a = $(this);
      var href = $a.attr('href');
      var txt = $a.find('span').first().text().trim() || $a.text().trim();
      var icon = $a.find('i').first().attr('class') || 'fa-solid fa-circle';
      var $btn = $('<button type="button" class="btn btn-sm"></button>').text(txt).attr('data-href', href);
      $btn.prepend('<i class="'+icon+' me-1"></i>');
      if($a.hasClass('active')) $btn.addClass('btn-primary').removeClass('btn-outline-secondary');
      else $btn.addClass('btn-outline-secondary');
      $mobileTabs.append($btn);
    });
  }
  buildMobileTabs();
  syncMobileLabel();
  $(document).on('shown.bs.tab', '#settingsTabs a[data-bs-toggle="pill"]', function(){ syncMobileLabel(); buildMobileTabs(); });
  if($trigger.length){
    $trigger.on('click', function(){
      var open = $navCard.hasClass('is-open');
      $navCard.toggleClass('is-open', !open);
      $overlay.toggleClass('is-visible', !open);
      $trigger.attr('aria-expanded', String(!open));
      $('body').toggleClass('overflow-hidden', !open);
    });
  }
  $overlay.on('click', function(){ $navCard.removeClass('is-open'); $overlay.removeClass('is-visible'); $trigger.attr('aria-expanded','false'); $('body').removeClass('overflow-hidden'); });
  $mobileTabs.on('click','button', function(){
    var href = $(this).data('href');
    var $target = $('#settingsTabs a[href="'+href+'"]');
    if($target.length) {
        if (window.bootstrap && bootstrap.Tab) {
            bootstrap.Tab.getOrCreateInstance($target[0]).show();
        } else if ($target.tab) {
            $target.tab('show');
        }
    }
    window.scrollTo({top:0, behavior:'smooth'});
  });
  $(document).on('click', '#settingsTabs a', function(){
    if(window.innerWidth < 992){ $navCard.removeClass('is-open'); $overlay.removeClass('is-visible'); $trigger.attr('aria-expanded','false'); $('body').removeClass('overflow-hidden'); }
  });

  // Per-section unsaved indicator
  var sectionMap = {
    '#overview': null,
    '#tab-general': ['#tab-general'],
    '#tab-products': ['#tab-products'],
    '#tab-appearance': ['#tab-appearance'],
    '#tab-media': ['#tab-media'],
    '#tab-payments': ['#tab-payments'],
    '#tab-security': ['#tab-security'],
    '#tab-smtp': ['#tab-smtp'],
    '#tab-integrations': ['#tab-integrations'],
    '#tab-tools': ['#tab-tools'],
    '#tab-page-help': ['#tab-page-help']
  };
  var initialData = $('#systemSettingsForm').serialize();
  function updateSectionBadges(){
    var current = $('#systemSettingsForm').serialize();
    var isDirty = current !== initialData;
    $('#stickySaveBar').toggleClass('is-dirty', isDirty).toggleClass('is-clean', !isDirty);
    $('#saveStatusIndicator').toggleClass('d-none', isDirty);
    $('#unsavedChangesBadge').toggleClass('d-none', !isDirty);
    $('#btnDiscardChanges').prop('disabled', !isDirty);
    // mark nav items with unsaved
    $('#settingsTabs a').each(function(){
      var href = $(this).attr('href');
      var pane = $(href);
      if(!pane.length) return;
      var hasChanges = pane.find('input, select, textarea').filter(function(){ return $(this).val() !== $(this).prop('defaultValue') && !$(this).is('[data-unchanged]'); }).length > 0;
      // fallback: compare serialized slices
      // simple: if dirty and pane contains any dirty input, mark
      var paneIsDirty = isDirty && pane.find('.is-highlight, .has-error').length===0 ? false : false;
      // use heuristic: if form is dirty, check if pane has any input that changed from default
      var dirtyInPane = false;
      pane.find('input, select, textarea').each(function(){
        var $el = $(this);
        var def = $el.prop('defaultValue');
        var cur = $el.val();
        if($el.is(':checkbox') || $el.is(':radio')){ if($el.prop('checked') !== $el.prop('defaultChecked')) dirtyInPane = true; }
        else if(cur !== def) dirtyInPane = true;
      });
      $(this).toggleClass('has-unsaved', dirtyInPane);
    });
  }
  $('#systemSettingsForm').on('input change', 'input, select, textarea', function(){ setTimeout(updateSectionBadges, 60); });
  setTimeout(updateSectionBadges, 400);

  // Search polish — keyboard nav + elegant pulse
  var $search = $('#globalSettingsSearch');
  var $results = $('#settingsSearchResults');
  var $list = $('#searchResultsList');
  var selectedIdx = -1;
  $search.on('keydown', function(e){
    var $items = $list.find('.list-group-item');
    if(!$items.length) return;
    if(e.key === 'ArrowDown'){ e.preventDefault(); selectedIdx = Math.min(selectedIdx+1, $items.length-1); $items.removeClass('is-highlighted').eq(selectedIdx).addClass('is-highlighted').focus(); }
    else if(e.key === 'ArrowUp'){ e.preventDefault(); selectedIdx = Math.max(selectedIdx-1, 0); $items.removeClass('is-highlighted').eq(selectedIdx).addClass('is-highlighted'); }
    else if(e.key === 'Enter' && selectedIdx >=0){ e.preventDefault(); $items.eq(selectedIdx).trigger('click'); }
    else if(e.key === 'Escape'){ $results.hide(); selectedIdx=-1; }
  });
  // Pulse highlight elegant — override existing highlight to use is-highlight + pulse
  var origHighlight = window.highlightSettingItem || function(){};
  // Enhance pulse: add smooth scroll and soft pulse
  $(document).on('click', '#searchResultsList .list-group-item', function(){
    setTimeout(function(){
      var $target = $('.setting-item.is-highlight').first();
      if($target.length){
        $target.addClass('pulse');
        setTimeout(function(){ $target.removeClass('pulse'); }, 1400);
      }
    }, 320);
  });
})();
</script>
<script>
(function ($) {
    'use strict';

    var pageHelpData = [];
    var isLoaded = false;
    var csrfToken = function () {
        return $('input[name="__RequestVerificationToken"]').first().val();
    };

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function loadPageHelpList() {
        $('#pageHelpLoading').show();
        $('#pageHelpTableContainer').hide();
        $('#pageHelpModalAlert').addClass('d-none').text('');

        $.ajax({
            url: '@Url.Action("GetPageHelpList", "AdminSettings", new { area = "admin" })',
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                $('#pageHelpLoading').hide();
                if (res && res.success && res.items) {
                    pageHelpData = res.items;
                    isLoaded = true;
                    populateCategoryDropdown();
                    populatePresetDropdown();
                    renderTable();
                    updateCounters();
                    $('#pageHelpTableContainer').fadeIn(150);
                } else {
                    $('#pageHelpTableContainer').show();
                    $('#pageHelpTableBody').html('<tr><td colspan="5" class="text-center text-danger py-4">Veriler yüklenirken hata oluştu.</td></tr>');
                }
            },
            error: function () {
                $('#pageHelpLoading').hide();
                $('#pageHelpTableContainer').show();
                $('#pageHelpTableBody').html('<tr><td colspan="5" class="text-center text-danger py-4">Sunucu ile iletişim kurulamadı.</td></tr>');
            }
        });
    }

    function updateCounters() {
        var total = pageHelpData.length;
        var custom = pageHelpData.filter(function (x) { return x.IsCustomized; }).length;
        var def = total - custom;

        $('#statTotalPages').text(total);
        $('#statCustomPages').text(custom);
        $('#statDefaultPages').text(def);
        $('#badgePageHelpCount').text(custom > 0 ? custom + ' Özel' : 'Rehberler');
    }

    function populateCategoryDropdown() {
        var $catSelect = $('#filterPageHelpCategory');
        $catSelect.find('option:not(:first)').remove();

        var categories = [];
        pageHelpData.forEach(function (item) {
            if (item.Category && categories.indexOf(item.Category) === -1) {
                categories.push(item.Category);
            }
        });
        categories.sort();

        categories.forEach(function (c) {
            $catSelect.append($('<option>', { value: c, text: c }));
        });
    }

    function populatePresetDropdown() {
        var $presetSelect = $('#pageHelpPresetSelect');
        $presetSelect.find('option:not(:first)').remove();

        pageHelpData.forEach(function (item) {
            $presetSelect.append($('<option>', {
                value: item.Key,
                text: item.PageName + ' (' + (item.Category || 'Özel') + ')'
            }));
        });
    }

    function renderTable() {
        var query = ($('#filterPageHelpSearch').val() || '').trim().toLowerCase();
        var selectedCat = $('#filterPageHelpCategory').val() || '';
        var selectedStatus = $('#filterPageHelpStatus').val() || '';

        var filtered = pageHelpData.filter(function (item) {
            if (query) {
                var nameMatch = item.PageName && item.PageName.toLowerCase().indexOf(query) !== -1;
                var keyMatch = item.Key && item.Key.toLowerCase().indexOf(query) !== -1;
                var routeMatch = item.RouteInfo && item.RouteInfo.toLowerCase().indexOf(query) !== -1;
                if (!nameMatch && !keyMatch && !routeMatch) return false;
            }
            if (selectedCat && item.Category !== selectedCat) {
                return false;
            }
            if (selectedStatus === 'custom' && !item.IsCustomized) {
                return false;
            }
            if (selectedStatus === 'default' && item.IsCustomized) {
                return false;
            }
            return true;
        });

        var $tbody = $('#pageHelpTableBody');
        $tbody.empty();

        if (!filtered.length) {
            $('#pageHelpEmptyNotice').removeClass('d-none');
            $('#tablePageHelp').hide();
            return;
        }

        $('#pageHelpEmptyNotice').addClass('d-none');
        $('#tablePageHelp').show();

        filtered.forEach(function (item) {
            var statusBadge = item.IsCustomized
                ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="fa-solid fa-circle-check me-1"></i>Özelleştirildi (DB)</span>'
                : '<span class="badge bg-secondary-subtle text-secondary border px-2 py-1"><i class="fa-solid fa-shield-halved me-1"></i>Varsayılan Şablon</span>';

            var updatedText = item.UpdatedDate
                ? momentDateOrString(item.UpdatedDate)
                : '<span class="text-muted">-</span>';

            var routeBadge = item.RouteInfo
                ? '<small class="text-muted d-block font-monospace" style="font-size:11px;">' + escapeHtml(item.RouteInfo) + '</small>'
                : '';

            var resetBtn = item.IsCustomized
                ? '<button type="button" class="btn btn-outline-danger btn-sm btn-reset-page-help" data-key="' + escapeHtml(item.Key) + '" title="Varsayılan Şablona Sıfırla"><i class="fa-solid fa-rotate-left"></i></button>'
                : '';

            var $tr = $('<tr>' +
                '<td>' +
                    '<div class="fw-bold text-dark">' + escapeHtml(item.PageName) + '</div>' +
                    routeBadge +
                '</td>' +
                '<td><span class="badge bg-light text-dark border">' + escapeHtml(item.Category || 'Özel') + '</span></td>' +
                '<td>' + statusBadge + '</td>' +
                '<td><small class="text-muted">' + updatedText + '</small></td>' +
                '<td class="text-end">' +
                    '<div class="btn-group btn-group-sm" role="group">' +
                        '<button type="button" class="btn btn-outline-primary btn-preview-page-help" data-key="' + escapeHtml(item.Key) + '" title="Önizle"><i class="fa-solid fa-eye me-1"></i>Önizle</button>' +
                        '<button type="button" class="btn btn-primary btn-edit-page-help" data-key="' + escapeHtml(item.Key) + '" title="Düzenle"><i class="fa-solid fa-pen-to-square me-1"></i>Düzenle</button>' +
                        resetBtn +
                    '</div>' +
                '</td>' +
            '</tr>');

            $tbody.append($tr);
        });
    }

    function momentDateOrString(d) {
        if (!d) return '-';
        if (typeof d === 'string') {
            var match = d.match(/\/Date\((\d+)\)\//);
            if (match) {
                var dt = new Date(parseInt(match[1], 10));
                return dt.toLocaleDateString('tr-TR') + ' ' + dt.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
            }
            return escapeHtml(d.replace('T', ' ').slice(0, 16));
        }
        return '-';
    }

    // Tab Navigation Trigger: Load list when tab-page-help is shown
    $(document).on('shown.bs.tab', 'a[href="#tab-page-help"]', function () {
        if (!isLoaded) {
            loadPageHelpList();
        }
    });

    if (window.location.hash === '#tab-page-help') {
        setTimeout(function () {
            if (!isLoaded) loadPageHelpList();
        }, 150);
    }

    $('#btnRefreshPageHelpList').on('click', function () {
        loadPageHelpList();
    });

    // Filters
    $('#filterPageHelpSearch').on('input', function () {
        var val = $(this).val();
        $('#btnClearPageHelpFilter').toggleClass('d-none', !val);
        renderTable();
    });

    $('#btnClearPageHelpFilter').on('click', function () {
        $('#filterPageHelpSearch').val('').trigger('input').focus();
    });

    $('#filterPageHelpCategory, #filterPageHelpStatus').on('change', function () {
        renderTable();
    });

    // Open Add Modal
    $('#btnAddNewPageHelp').on('click', function () {
        $('#pageHelpEditModalTitle').html('<i class="fa-solid fa-circle-plus text-primary me-2"></i>Yeni Sayfa Yardım Bilgisi Ekle');
        $('#pageHelpPresetGroup').show();
        $('#pageHelpPresetSelect').val('');
        $('#pageHelpModalName').val('');
        $('#pageHelpModalKey').val('').prop('readonly', false);
        $('#pageHelpModalContent').val('');
        $('#pageHelpModalAlert').addClass('d-none').text('');
        switchModalTab('edit');

        var modal = new bootstrap.Modal(document.getElementById('pageHelpEditModal'));
        modal.show();
    });

    // Preset Selection in Add Modal
    $('#pageHelpPresetSelect').on('change', function () {
        var selectedKey = $(this).val();
        if (!selectedKey) return;

        var found = pageHelpData.filter(function (x) { return x.Key === selectedKey; })[0];
        if (found) {
            $('#pageHelpModalName').val(found.PageName);
            $('#pageHelpModalKey').val(found.Key);
            $('#pageHelpModalContent').val(found.CurrentContent || found.DefaultContent || '');
            updateLivePreview();
        }
    });

    // Open Edit Modal for a specific row
    $(document).on('click', '.btn-edit-page-help', function () {
        var key = $(this).data('key');
        var found = pageHelpData.filter(function (x) { return x.Key === key; })[0];

        $('#pageHelpEditModalTitle').html('<i class="fa-solid fa-pen-to-square text-primary me-2"></i>Sayfa Yardım Bilgisi Düzenle');
        $('#pageHelpPresetGroup').hide();
        $('#pageHelpModalAlert').addClass('d-none').text('');
        switchModalTab('edit');

        if (found) {
            $('#pageHelpModalName').val(found.PageName);
            $('#pageHelpModalKey').val(found.Key).prop('readonly', true);
            $('#pageHelpModalContent').val(found.CurrentContent || found.DefaultContent || '');
            updateLivePreview();
            var modal = new bootstrap.Modal(document.getElementById('pageHelpEditModal'));
            modal.show();
        } else {
            $.getJSON('@Url.Action("GetPageHelpDetail", "AdminSettings", new { area = "admin" })', { key: key }, function (res) {
                if (res && res.success) {
                    $('#pageHelpModalName').val(res.name);
                    $('#pageHelpModalKey').val(res.key).prop('readonly', true);
                    $('#pageHelpModalContent').val(res.content || res.defaultContent || '');
                    updateLivePreview();
                    var modal = new bootstrap.Modal(document.getElementById('pageHelpEditModal'));
                    modal.show();
                }
            });
        }
    });

    // Preview button from row
    $(document).on('click', '.btn-preview-page-help', function () {
        var key = $(this).data('key');
        var found = pageHelpData.filter(function (x) { return x.Key === key; })[0];

        if (found) {
            showPreviewModal(found.PageName, found.Key, found.CurrentContent || found.DefaultContent);
        } else {
            $.getJSON('@Url.Action("GetPageHelpDetail", "AdminSettings", new { area = "admin" })', { key: key }, function (res) {
                if (res && res.success) {
                    showPreviewModal(res.name, res.key, res.content || res.defaultContent);
                }
            });
        }
    });

    function showPreviewModal(title, key, content) {
        $('#pageHelpPreviewModalTitle').text(title || 'Sayfa Yardım Rehberi');
        $('#pageHelpPreviewModalSubtitle').text('Önizleme');
        $('#pageHelpPreviewModalKeyBadge').text(key);
        $('#pageHelpPreviewModalBody').html(content || '<p class="text-muted fst-italic">İçerik bulunmuyor.</p>');

        var modal = new bootstrap.Modal(document.getElementById('pageHelpPreviewModal'));
        modal.show();
    }

    // Reset / Delete row
    $(document).on('click', '.btn-reset-page-help', function () {
        var key = $(this).data('key');
        if (!confirm('Bu sayfa yardım içeriğini varsayılan şablona sıfırlamak istediğinize emin misiniz?')) {
            return;
        }

        var $btn = $(this);
        $btn.prop('disabled', true);

        $.ajax({
            url: '@Url.Action("DeletePageHelp", "AdminSettings", new { area = "admin" })',
            type: 'POST',
            data: {
                key: key,
                __RequestVerificationToken: csrfToken()
            },
            success: function (res) {
                if (res && res.success) {
                    var item = pageHelpData.filter(function (x) { return x.Key === key; })[0];
                    if (item) {
                        item.IsCustomized = false;
                        item.CurrentContent = res.defaultContent || item.DefaultContent;
                        item.UpdatedDate = null;
                    }
                    renderTable();
                    updateCounters();
                } else {
                    alert(res && res.message ? res.message : 'Sıfırlama sırasında hata oluştu.');
                    $btn.prop('disabled', false);
                }
            },
            error: function () {
                alert('Sunucu ile iletişim kurulamadı.');
                $btn.prop('disabled', false);
            }
        });
    });

    // Modal Tabs (Editor vs Live Preview)
    function switchModalTab(tab) {
        if (tab === 'edit') {
            $('#btnTabEditContent').addClass('active');
            $('#btnTabPreviewContent').removeClass('active');
            $('#pageHelpEditorPane').show();
            $('#pageHelpEditorToolbar').show();
            $('#pageHelpPreviewPane').hide();
        } else {
            $('#btnTabEditContent').removeClass('active');
            $('#btnTabPreviewContent').addClass('active');
            $('#pageHelpEditorPane').hide();
            $('#pageHelpEditorToolbar').hide();
            $('#pageHelpPreviewPane').show();
            updateLivePreview();
        }
    }

    $('#btnTabEditContent').on('click', function () { switchModalTab('edit'); });
    $('#btnTabPreviewContent').on('click', function () { switchModalTab('preview'); });

    function updateLivePreview() {
        var html = $('#pageHelpModalContent').val() || '<p class="text-muted fst-italic">Önizlenecek içerik boş.</p>';
        $('#pageHelpLivePreviewContent').html(html);
    }

    $('#pageHelpModalContent').on('input', function () {
        if ($('#pageHelpPreviewPane').is(':visible')) {
            updateLivePreview();
        }
    });

    // Formatting Toolbar Buttons
    $('#pageHelpEditorToolbar button[data-tag]').on('click', function () {
        var tag = $(this).data('tag');
        var textarea = document.getElementById('pageHelpModalContent');
        if (!textarea) return;

        var start = textarea.selectionStart;
        var end = textarea.selectionEnd;
        var text = textarea.value;
        var selected = text.substring(start, end);
        var replacement = '';

        switch (tag) {
            case 'b':
                replacement = '<strong>' + (selected || 'Kalın Metin') + '</strong>';
                break;
            case 'p':
                replacement = '<p>' + (selected || 'Yeni paragraf metni...') + '</p>';
                break;
            case 'ul':
                replacement = '<ul>\n  <li>' + (selected || 'Madde 1') + '</li>\n  <li>Madde 2</li>\n</ul>';
                break;
            case 'code':
                replacement = '<code>' + (selected || 'kod_ornek') + '</code>';
                break;
            case 'alert':
                replacement = '<div class="alert alert-info py-2 px-3 small my-2">\n  <i class="fa-solid fa-circle-info me-1"></i> ' + (selected || 'Önemli not veya ipucu...') + '\n</div>';
                break;
        }

        textarea.value = text.substring(0, start) + replacement + text.substring(end);
        textarea.focus();
        textarea.selectionStart = start + replacement.length;
        textarea.selectionEnd = start + replacement.length;
        updateLivePreview();
    });

    // Load Default Template button inside Edit Modal
    $('#btnLoadDefaultTemplate').on('click', function () {
        var key = ($('#pageHelpModalKey').val() || '').trim();
        var found = pageHelpData.filter(function (x) { return x.Key === key; })[0];
        if (found && found.DefaultContent) {
            $('#pageHelpModalContent').val(found.DefaultContent);
            updateLivePreview();
            return;
        }

        var generic = '<p>Bu sayfada <strong>' + ($('#pageHelpModalName').val() || 'işlemlerinizi') + '</strong> gerçekleştirirsiniz.</p>\n' +
            '<ul>\n' +
            '  <li>Arama ve filtreleme alanlarını kullanarak kayıtlara hızlıca ulaşabilirsiniz.</li>\n' +
            '  <li>İşlemler sütunundaki butonlar ile detayları düzenleyebilir veya silebilirsiniz.</li>\n' +
            '</ul>';
        $('#pageHelpModalContent').val(generic);
        updateLivePreview();
    });

    // Save Button in Edit Modal
    $('#btnSavePageHelpModal').on('click', function () {
        var key = ($('#pageHelpModalKey').val() || '').trim();
        var name = ($('#pageHelpModalName').val() || '').trim();
        var content = $('#pageHelpModalContent').val();

        if (!name) {
            $('#pageHelpModalAlert').removeClass('d-none').text('Sayfa / rehber başlığı zorunludur.');
            $('#pageHelpModalName').focus();
            return;
        }

        if (!key) {
            key = name.toLowerCase()
                .replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ş/g, 's').replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ç/g, 'c')
                .replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '') + '_help/info_section';
            $('#pageHelpModalKey').val(key);
        }

        var $btn = $(this);
        var origHtml = $btn.html();
        $btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Kaydediliyor...');
        $('#pageHelpModalAlert').addClass('d-none').text('');

        $.ajax({
            url: '@Url.Action("SavePageHelp", "AdminSettings", new { area = "admin" })',
            type: 'POST',
            data: {
                key: key,
                name: name,
                content: content,
                __RequestVerificationToken: csrfToken()
            },
            success: function (res) {
                $btn.prop('disabled', false).html(origHtml);
                if (res && res.success) {
                    var modalEl = document.getElementById('pageHelpEditModal');
                    var modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    var existing = pageHelpData.filter(function (x) { return x.Key === res.key; })[0];
                    if (existing) {
                        existing.PageName = res.name || existing.PageName;
                        existing.CurrentContent = content;
                        existing.IsCustomized = true;
                        existing.UpdatedDate = new Date().toISOString();
                    } else {
                        pageHelpData.unshift({
                            Key: res.key,
                            PageName: res.name || key,
                            Category: 'Özel',
                            RouteInfo: '',
                            DefaultContent: content,
                            CurrentContent: content,
                            IsCustomized: true,
                            UpdatedDate: new Date().toISOString()
                        });
                    }

                    renderTable();
                    updateCounters();
                } else {
                    $('#pageHelpModalAlert').removeClass('d-none').text(res && res.message ? res.message : 'Kayıt sırasında hata oluştu.');
                }
            },
            error: function () {
                $btn.prop('disabled', false).html(origHtml);
                $('#pageHelpModalAlert').removeClass('d-none').text('Sunucu hatası oluştu.');
            }
        });
    });

})(jQuery);
</script>
@Html.Partial("_AdminInitTooltips")
