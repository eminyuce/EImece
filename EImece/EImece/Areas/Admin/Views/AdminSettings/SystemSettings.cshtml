                                    @Html.TextAreaFor(model => model.UnderConstructionHtml, new { @class = "form-control font-monospace", rows = 4, placeholder = "Örn: <p>Sistemlerimizde planlı altyapı yükseltmesi yapılmaktadır. Saat 02:00 itibarıyla yeniden hizmetinizdeyiz.</p>" })
                                    @Html.ValidationMessageFor(model => model.UnderConstructionHtml, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <!-- SEO Indexing -->
                                <div class="setting-item p-3 rounded border bg-light" data-setting-name="AllowSearchEngineIndexing" data-setting-label="Arama Motoru İndeksleme" data-setting-desc="Google, Bing ve diğer arama motorlarının sitenizi dizine eklemesine izin verir" data-keywords="seo google bing robot robots.txt meta indexing">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="AllowSearchEngineIndexing">
                                                <i class="fa-solid fa-magnifying-glass text-success me-1"></i> @AdminResource.AllowSearchEngineIndexing
                                            </label>
                                            <p class="text-muted small mb-0">@AdminResource.AllowSearchEngineIndexingDesc</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.AllowSearchEngineIndexing, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AllowSearchEngineIndexing, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                            </div>
                        </div>

                                                <!-- Section: Genel Listeleme Tercihleri (Slimmed — product settings moved to Ürün & Fiyatlandırma) -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Genel Listeleme Tercihleri">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-table text-primary me-2"></i>Genel Listeleme Tercihleri</h5>
                                <small class="text-muted">Yönetim listeleri ve arayüz dili — ürün fiyat/katalog ayarları artık <a href="#tab-products" data-bs-toggle="pill" class="fw-bold">Ürün &amp; Fiyatlandırma</a> sekmesinde.</small>
                            </div>
                            <div class="card-body">
                                <div class="row g-3 mb-3">
                                    <div class="col-md-12 setting-item" data-setting-name="GridPageSizeNumber" data-setting-label="Admin Liste Satır Sayısı" data-setting-desc="Yönetim panelinde sayfa başına gösterilecek satır sayısı" data-keywords="grid sayfa boyutu satır sayısı pagination page size">
                                        <label class="form-label fw-bold small" for="GridPageSizeNumber">
                                            @Html.DisplayNameFor(model => model.GridPageSizeNumber)
                                        </label>
                                        @Html.EditorFor(model => model.GridPageSizeNumber, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1", max = "1000", placeholder = "100" } })
                                        <div class="form-text small">@AdminResource.AdminGridPageSizeDesc</div>
                                        @Html.ValidationMessageFor(model => model.GridPageSizeNumber, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                                <!-- Admin Panel UI Language -->
                                <div class="setting-item mb-3 p-3 border rounded bg-light" data-setting-name="AdminPanelLanguage" data-setting-label="@AdminResource.AdminPanelUILanguageTitle" data-setting-desc="@AdminResource.AdminPanelUILanguageHelp" data-keywords="yönetim paneli dil arayüz language ui tr en">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <label class="form-label fw-bold small m-0 d-flex align-items-center gap-2" for="AdminPanelLanguage">
                                            <span class="badge bg-primary text-uppercase"><i class="fa-solid fa-desktop me-1"></i>UI</span>
                                            <span>@AdminResource.AdminPanelUILanguageTitle</span>
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.AdminPanelUILanguageHelp } })
                                        </label>
                                    </div>
                                    <div class="input-group mb-1">
                                        @Html.DropDownListFor(model => model.AdminPanelLanguage, new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "🇹🇷 Türkçe (Turkish)", Value = "tr-TR" },
                                            new SelectListItem { Text = "🇺🇸 English (en-US)", Value = "en-US" }
                                        }, new { @class = "form-select", id = "AdminPanelLanguage" })
                                        <button type="button" class="btn btn-primary" id="btnChangeAdminLanguage" title="@AdminResource.ApplyAndRefresh">
                                            <i class="fa-solid fa-arrows-rotate me-1" aria-hidden="true"></i> @AdminResource.ApplyAndRefresh
                                        </button>
                                    </div>
                                    <div class="form-text small text-muted">
                                        <i class="fa-solid fa-circle-info me-1 text-primary"></i>@AdminResource.AdminPanelUILanguageHelp
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AdminPanelLanguage, "", new { @class = "text-danger small" })
                                </div>
                                <!-- Content languages (storefront / data-entry) — independent of Admin Panel UI language -->
                                <div class="setting-item mb-0 p-3 border rounded bg-light" data-setting-name="SupportedContentLanguages" data-setting-label="@AdminResource.ContentLanguagesTitle" data-setting-desc="@AdminResource.ContentLanguagesHelp" data-keywords="içerik dili content language turkish english tr en bilingual veri giriş">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <label class="form-label fw-bold small m-0 d-flex align-items-center gap-2">
                                            <span class="badge bg-success text-uppercase"><i class="fa-solid fa-language me-1"></i>DATA</span>
                                            <span>@AdminResource.ContentLanguagesTitle</span>
                                            @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.ContentLanguagesHelp } })
                                        </label>
                                    </div>
                                    @Html.HiddenFor(model => model.SupportedContentLanguages)
                                    <div class="d-flex flex-wrap gap-3 mb-2">
                                        <div class="form-check">
                                            @Html.CheckBoxFor(model => model.ContentLanguageTurkish, new { @class = "form-check-input content-language-checkbox", id = "ContentLanguageTurkish", data_lang = "tr" })
                                            <label class="form-check-label" for="ContentLanguageTurkish">
                                                <span class="content-lang-flag" title="tr-TR" aria-hidden="true">
                                                    <svg viewBox="0 0 36 24" width="18" height="12" focusable="false"><rect width="36" height="24" fill="#E30A17"/><circle cx="12.6" cy="12" r="7.2" fill="#fff"/><circle cx="14.7" cy="12" r="5.76" fill="#E30A17"/><polygon fill="#fff" points="20.5,12 16.9,13.17 19.22,9.9 19.22,14.1 16.9,10.83"/></svg>
                                                </span>
                                                @AdminResource.ContentLanguageTurkish
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            @Html.CheckBoxFor(model => model.ContentLanguageEnglish, new { @class = "form-check-input content-language-checkbox", id = "ContentLanguageEnglish", data_lang = "en" })
                                            <label class="form-check-label" for="ContentLanguageEnglish">
                                                <span class="content-lang-flag" title="en-US" aria-hidden="true">
                                                    <svg viewBox="0 0 36 24" width="18" height="12" focusable="false"><rect width="36" height="24" fill="#BF0A30"/><rect y="1.85" width="36" height="1.85" fill="#fff"/><rect y="5.54" width="36" height="1.85" fill="#fff"/><rect y="9.23" width="36" height="1.85" fill="#fff"/><rect y="12.92" width="36" height="1.85" fill="#fff"/><rect y="16.62" width="36" height="1.85" fill="#fff"/><rect y="20.31" width="36" height="1.85" fill="#fff"/><rect width="14.4" height="13.1" fill="#002868"/></svg>
                                                </span>
                                                @AdminResource.ContentLanguageEnglish
                                            </label>
                                        </div>
                                    </div>
                                    <div id="contentLanguageSingleHint" class="form-text small mb-1" style="display:none;"
                                         data-name-tr="@AdminResource.ContentLanguageTurkishName"
                                         data-name-en="@AdminResource.ContentLanguageEnglishName"
                                         data-at-least-one="@AdminResource.ContentLanguagesAtLeastOne">
                                        <i class="fa-solid fa-flag text-success me-1" aria-hidden="true"></i>
                                        @AdminResource.DataEntryLanguageShort:
                                        <span id="contentLanguageFlagTr" class="content-lang-flag" title="tr-TR" aria-hidden="true">
                                            <svg viewBox="0 0 36 24" width="18" height="12" focusable="false"><rect width="36" height="24" fill="#E30A17"/><circle cx="12.6" cy="12" r="7.2" fill="#fff"/><circle cx="14.7" cy="12" r="5.76" fill="#E30A17"/><polygon fill="#fff" points="20.5,12 16.9,13.17 19.22,9.9 19.22,14.1 16.9,10.83"/></svg>
                                        </span>
                                        <span id="contentLanguageFlagUs" class="content-lang-flag" title="en-US" aria-hidden="true" style="display:none;">
                                            <svg viewBox="0 0 36 24" width="18" height="12" focusable="false"><rect width="36" height="24" fill="#BF0A30"/><rect y="1.85" width="36" height="1.85" fill="#fff"/><rect y="5.54" width="36" height="1.85" fill="#fff"/><rect y="9.23" width="36" height="1.85" fill="#fff"/><rect y="12.92" width="36" height="1.85" fill="#fff"/><rect y="16.62" width="36" height="1.85" fill="#fff"/><rect y="20.31" width="36" height="1.85" fill="#fff"/><rect width="14.4" height="13.1" fill="#002868"/></svg>
                                        </span>
                                        <strong class="text-success fw-bold" id="contentLanguageActiveName"></strong>
                                    </div>
                                    <div id="contentLanguageBilingualHint" class="form-text small mb-1" style="display:none;">
                                        <i class="fa-solid fa-right-left me-1 text-success"></i>@AdminResource.ContentLanguagesBilingualMode
                                    </div>
                                    <div class="form-text small text-muted">
                                        <i class="fa-solid fa-circle-info me-1 text-primary"></i>@AdminResource.ContentLanguagesHelp
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SupportedContentLanguages, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 1.5 ÜRÜN & FİYATLANDIRMA — NEW DEDICATED SECTION (entire page as /admin/adminsettings) -->
                    <!-- ========================================================================= -->
                    <div id="tab-products" class="tab-pane fade" role="tabpanel">
                        <!-- Section: Katalog Modu & Satış Davranışı -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Katalog & Satış Davranışı">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-bag-shopping text-primary me-2"></i>Katalog &amp; Satış Davranışı</h5>
                                <small class="text-muted">Mağaza vitrininde fiyat gösterimi, sepete ekleme ve satışa uygunluk — tüm ürün fiyat/katalog ayarları burada.</small>
                            </div>
                            <div class="card-body">
                                <!-- Product Prices & Catalog Mode -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="IsProductPriceEnable" data-setting-label="Ürün Fiyatları ve Sepet" data-setting-desc="Ürün fiyatlarını gösterir ve sepete ekleme/satın alma fonksiyonlarını aktif eder" data-keywords="fiyat katalog modu sepete ekleme sipariş product price">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="IsProductPriceEnable">
                                                <i class="fa-solid fa-tag text-primary me-1"></i> @AdminResource.ProductPricesAndAddToCart
                                            </label>
                                            <p class="text-muted small mb-0">@AdminResource.CatalogShowcaseModeDesc</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.IsProductPriceEnable, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsProductPriceEnable, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                                <!-- Suitable For Sale Product States -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light price-dependent-setting" data-setting-name="SuitableForSaleProductStates" data-setting-label="@AdminResource.SuitableForSaleProductStates" data-setting-desc="@AdminResource.SuitableForSaleProductStatesDesc" data-keywords="satışa uygun durumlar product state in sale buyable ön sipariş stokta pre-order">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block">
                                                <i class="fa-solid fa-cart-shopping text-success me-1"></i> @AdminResource.SuitableForSaleProductStates
                                                @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", AdminResource.SuitableForSaleProductStatesHelp } })
                                            </label>
                                            <p class="text-muted small mb-0">@AdminResource.SuitableForSaleProductStatesDesc</p>
                                        </div>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-secondary" id="btnSelectDefaultSaleStates" title="Varsayılanları Seç (Stokta, Ön Sipariş, Sınırlı Stok)">
                                                <i class="fa-solid fa-arrow-rotate-left me-1"></i> Varsayılan
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary" id="btnSelectAllSaleStates" title="Tümünü Seç">
                                                <i class="fa-regular fa-square-check me-1"></i> Tümünü Seç
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary" id="btnClearAllSaleStates" title="Tümünü Temizle">
                                                <i class="fa-regular fa-square me-1"></i> Temizle
                                            </button>
                                        </div>
                                    </div>
                                    @Html.HiddenFor(model => model.SuitableForSaleProductStates, new { id = "SuitableForSaleProductStates" })
                                    @{
                                        var activeSaleStates = ProductStateHelper.ParseSuitableForSaleStates(Model.SuitableForSaleProductStates);
                                        var allSelectableStates = ProductStateHelper.GetAllSelectableStates();
                                    }
                                    <div class="row g-2 mt-1" id="saleProductStatesCheckboxGroup">
                                        @foreach (var pState in allSelectableStates)
                                        {
                                            var isChecked = activeSaleStates.Contains(pState);
                                            var stateName = pState.ToString();
                                            var stateDisplayName = ProductStateHelper.GetStateDisplayName(pState);
                                            var badgeClass = (pState == EImece.Domain.Models.Enums.ProductState.ProductInStock || pState == EImece.Domain.Models.Enums.ProductState.LimitedStock) ? "border-success" :
                                                             (pState == EImece.Domain.Models.Enums.ProductState.PreOrder || pState == EImece.Domain.Models.Enums.ProductState.Backorder) ? "border-info" :
                                                             (pState == EImece.Domain.Models.Enums.ProductState.ComingSoon || pState == EImece.Domain.Models.Enums.ProductState.AwaitingRestock) ? "border-warning" : "border-secondary";
                                            <div class="col-sm-6 col-lg-4">
                                                <div class="form-check p-2 bg-white rounded border @badgeClass h-100 d-flex align-items-center">
                                                    <input class="form-check-input ms-1 me-2 sale-state-chk" type="checkbox" id="chk_state_@stateName" value="@stateName" @(isChecked ? "checked=\"checked\"" : null) />
                                                    <label class="form-check-label small fw-semibold text-dark mb-0 cursor-pointer w-100" for="chk_state_@stateName">
                                                        @stateDisplayName
                                                        <span class="text-muted d-block font-monospace" style="font-size: 0.75rem;">(@stateName)</span>
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SuitableForSaleProductStates, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                                <!-- Product Reviews -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="IsProductReviewEnable" data-setting-label="Ürün Yorumları" data-setting-desc="Kullanıcıların ürünlere yorum yapmasını ve puan vermesini sağlar" data-keywords="yorum puan review rating değerlendirme">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="IsProductReviewEnable">
                                                <i class="fa-regular fa-comments text-info me-1"></i> @AdminResource.ProductReviewsAndRatingsTitle
                                            </label>
                                            <p class="text-muted small mb-0">@AdminResource.ProductReviewsAndRatingsDesc</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.IsProductReviewEnable, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsProductReviewEnable, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                                <div class="alert alert-info py-2 px-3 mb-0 small">
                                    <i class="fa-solid fa-circle-info me-1"></i> <strong>İpucu:</strong> Fiyatlar kapalı iken mağaza <em>Katalog / Tanıtım Modu</em>nda çalışır, sepete ekleme ve ödeme adımları devre dışı kalır. <a href="#tab-payments" data-bs-toggle="pill" class="fw-bold">Satış &amp; Ödemeler</a> sekmesindeki ayarlar da kilitlenir.
                                </div>
                            </div>
                        </div>
                        <!-- Section: Liste & Önizleme -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Liste & Önizleme">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-list text-primary me-2"></i>Liste &amp; Önizleme Ayarları</h5>
                                <small class="text-muted">Ürün liste sayfaları ve kısa açıklama önizleme uzunluğu.</small>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6 setting-item" data-setting-name="ProductShortDescriptionPreviewLength" data-setting-label="Ürün Kısa Açıklama Karakter Limiti" data-setting-desc="Ürün detayında Devamını Gör butonundan önce gösterilecek karakter sayısı" data-keywords="kısa açıklama önizleme karakter sınırı preview length description">
                                        <label class="form-label fw-bold small" for="ProductShortDescriptionPreviewLength">
                                            @Html.DisplayNameFor(model => model.ProductShortDescriptionPreviewLength)
                                        </label>
                                        @Html.EditorFor(model => model.ProductShortDescriptionPreviewLength, new { htmlAttributes = new { @class = "form-control", type = "number", min = "10", max = "5000", placeholder = "180" } })
                                        <div class="form-text small">@AdminResource.ProductShortDescLengthDesc</div>
                                        @Html.ValidationMessageFor(model => model.ProductShortDescriptionPreviewLength, "", new { @class = "text-danger small" })
                                    </div>
                                    <div class="col-md-6">
                                        <div class="p-3 bg-light rounded border h-100">
                                            <div class="d-flex align-items-center gap-2 mb-1"><span class="badge bg-primary-subtle text-primary border border-primary-subtle">Önizleme</span><strong class="small">Kısa Açıklama Önizleme</strong></div>
                                            <p class="small text-muted mb-0">Bu değer ürün detay sayfasındaki kısa açıklamanın kaç karakter sonra “Devamını Gör” ile kesileceğini belirler. Tam metin her zaman SEO ve detay sekmesinde korunur.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Section: Fiyat Filtresi & Ödeme Detayı — entire page as requested -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Fiyat Filtresi &amp; Ödeme Detayı">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-sliders text-primary me-2"></i>Fiyat Filtresi &amp; Ürün Detay Ödeme Sekmesi</h5>
                                <small class="text-muted">Kategori slider aralıkları ve ürün detayındaki ödeme bilgisi HTML’i — vitrin deneyimini doğrudan etkiler.</small>
                            </div>
                            <div class="card-body">
                                <details class="sc-advanced-panel mb-3" data-setting-name="ProductPriceFilterSetting" data-setting-label="Fiyat Filtresi Aralıkları" data-setting-desc="Kategori ve arama sayfalarında gösterilen dinamik fiyat filtre aralıkları" data-keywords="fiyat aralığı filtre kategori slider range price filter">
                                    <summary>
                                        <span><i class="fa-solid fa-sliders me-2 text-primary"></i> Fiyat Filtresi Aralıkları <span class="badge bg-light text-secondary border ms-2">Gelişmiş</span></span>
                                        <span class="small text-muted">8 aralık • kategori slider</span>
                                    </summary>
                                    <div class="sc-advanced-body">
