                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.IsSiteUnderConstruction, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsSiteUnderConstruction, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <!-- Under Construction Custom HTML Message -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="UnderConstructionHtml" data-setting-label="@AdminResource.MaintenanceCustomMessageHtml" data-setting-desc="Bakım modu aktifken ziyaretçilere gösterilecek özel duyuru veya HTML metni" data-keywords="bakım modu html duyuru mesaj özel under construction custom html message">
                                    <label class="fw-bold mb-1 d-block" for="UnderConstructionHtml">
                                        <i class="fa-solid fa-code text-info me-1"></i> @AdminResource.MaintenanceCustomMessageHtml
                                    </label>
