                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="ImageUploadPreferWebP" data-setting-label="@AdminResource.PreferWebPFormat" data-setting-desc="Yüklenen görselleri otomatik modern WebP formatına dönüştürür" data-keywords="webp dönüştürme web performance format">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="ImageUploadPreferWebP">
                                                <i class="fa-solid fa-wand-magic-sparkles text-info me-1"></i> Otomatik WebP Dönüştürme
                                            </label>
                                            <p class="text-muted small mb-0">Yüklenen JPEG ve PNG fotoğrafları otomatik olarak yüksek sıkıştırmalı WebP formatına dönüştürerek sayfa yüklenme hızını artırır.</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.ImageUploadPreferWebP, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.ImageUploadPreferWebP, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <div class="row g-3">
                                    <!-- WebP Quality -->
                                    <div class="col-md-6 setting-item" data-setting-name="ImageUploadWebPQuality" data-setting-label="WebP Kalitesi" data-setting-desc="WebP formatı sıkıştırma kalitesi (40–100)" data-keywords="webp kalite quality sıkıştırma">
                                        <label class="form-label fw-bold small" for="ImageUploadWebPQuality">@Html.DisplayNameFor(model => model.ImageUploadWebPQuality)</label>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.ImageUploadWebPQuality, new { htmlAttributes = new { @class = "form-control", type = "number", min = "40", max = "100", placeholder = "85" } })
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <div class="form-text small">WebP sıkıştırma kalite faktörü (40–100, Varsayılan: 85).</div>
                                        @Html.ValidationMessageFor(model => model.ImageUploadWebPQuality, "", new { @class = "text-danger small" })
