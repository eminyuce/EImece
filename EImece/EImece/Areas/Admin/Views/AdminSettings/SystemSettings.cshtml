                                        <label>
                                            @Html.EditorFor(model => model.IsProductPriceEnable) Ürün Fiyatları Gösterilsin mi?
                                        </label>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsProductPriceEnable, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.IsProductReviewEnable, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    <div class="checkbox" style="padding-top:7px;">
                                        <label>
