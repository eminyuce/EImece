                    </a>
                </li>
                <li>
                    <a data-toggle="pill" href="#tab-tools">
                        <i class="glyphicon glyphicon-wrench" style="margin-right:8px;"></i> Sistem Araçları
                    </a>
                </li>
            </ul>
        </div>

        <!-- Vertical Tabs Content -->
        <div class="col-md-9">
            <div class="tab-content form-horizontal">
                
                <!-- General Settings -->
                <div id="tab-general" class="tab-pane fade in active">
                    <div class="panel panel-default">
