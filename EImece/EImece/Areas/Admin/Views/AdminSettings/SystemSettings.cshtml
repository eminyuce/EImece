@model EImece.Domain.Models.AdminModels.SystemSettingModel
@using Resources;
@{
    ViewBag.Title = AdminResource.AdminSystemSettings;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    // Pre-calculate status summaries for overview dashboard
    var isSiteLive = !Model.IsSiteUnderConstruction;
    var isSearchIndexing = Model.AllowSearchEngineIndexing;
    var is2FaActive = Model.RequireAdminAuthenticator;
    var isRateLimitActive = Model.RateLimit_Enabled;
    var isCaptchaActive = !string.Equals(Model.CaptchaProvider, "None", StringComparison.OrdinalIgnoreCase);
    var isSmtpConfigured = !string.IsNullOrWhiteSpace(Model.AdminEmailHost) && !string.IsNullOrWhiteSpace(Model.AdminEmail);
    var isWebPActive = Model.ImageUploadPreferWebP;
    var isPriceActive = Model.IsProductPriceEnable;

    var activeTheme = string.IsNullOrWhiteSpace(Model.ActiveDesign) ? "Crizal" : Model.ActiveDesign;
    var showThemeSelection = AppConfig.ShowThemeSelectionInAdmin;

    var availableDesigns = new List<string>();
    try
    {
        string designsDir = Server.MapPath("~/Views/Designs");
        if (System.IO.Directory.Exists(designsDir))
        {
            availableDesigns.AddRange(System.IO.Directory.GetDirectories(designsDir)
                .Select(System.IO.Path.GetFileName)
                .Where(d => !string.IsNullOrWhiteSpace(d)));
        }
    }
    catch { }

    if (!availableDesigns.Any(d => d.Equals("Crizal", StringComparison.OrdinalIgnoreCase)))
    {
        availableDesigns.Add("Crizal");
    }
    if (!availableDesigns.Any(d => d.Equals("Modern", StringComparison.OrdinalIgnoreCase)))
    {
        availableDesigns.Add("Modern");
    }

    var themeSelectItems = availableDesigns.Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(t => t).Select(t => new SelectListItem
    {
        Value = t,
        Text = t + (t.Equals("Crizal", StringComparison.OrdinalIgnoreCase) ? " - Kurumsal (Yeşil Palet)" : (t.Equals("Modern", StringComparison.OrdinalIgnoreCase) ? " - Modern (Minimalist Palet)" : " - Özel Tasarım Şablonu")),
        Selected = string.Equals(activeTheme, t, StringComparison.OrdinalIgnoreCase)
    }).ToList();

    // Calculate security health score
    int securityScore = 0;
    if (is2FaActive) { securityScore += 35; }
    if (isRateLimitActive) { securityScore += 35; }
    if (isCaptchaActive) { securityScore += 30; }
}

<div class="settings-center-container" id="settingsCenterApp">
    <!-- Header Banner -->
    <div class="settings-header-banner mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard", new { area = "admin" })"><i class="fa fa-home"></i> @AdminResource.AdminHome</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@AdminResource.SystemSettings</li>
                    </ol>
                </nav>
                <h1 class="settings-main-title mb-1">
                    <i class="fa fa-sliders text-primary me-2"></i>@AdminResource.AdminSystemSettings
                </h1>
                <p class="text-muted mb-0">Mağazanızın görünüm, satış, güvenlik, entegrasyon ve sistem operasyonlarını tek merkezden yapılandırın.</p>
            </div>
            
            <!-- Global Search Box -->
            <div class="settings-search-wrapper position-relative">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="fa fa-search text-muted"></i></span>
                    <input type="text" id="globalSettingsSearch" class="form-control border-start-0" placeholder="Ayarlarda ara... (örn: SMTP, 2FA, WebP, Fiyat)" autocomplete="off" spellcheck="false" />
                    <button type="button" class="btn btn-outline-secondary border-start-0 d-none" id="btnClearSettingsSearch" title="Aramayı temizle">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <div id="settingsSearchResults" class="settings-search-dropdown shadow-lg rounded" style="display: none;">
                    <div class="p-2 border-bottom text-muted small fw-bold text-uppercase d-flex justify-content-between align-items-center">
                        <span>Arama Sonuçları</span>
                        <span id="searchResultCount" class="badge bg-secondary">0</span>
                    </div>
                    <div id="searchResultsList" class="list-group list-group-flush" style="max-height: 360px; overflow-y: auto;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Help Accordion -->
    <div class="mb-3">
        @{ ViewData["HelpId"] = "systemSettingsHelp"; }
        @Html.Partial("_AdminHelpAccordionStart")
        <div class="row">
            <div class="col-md-4">
                <h6 class="fw-bold text-primary"><i class="fa fa-shopping-bag me-1"></i> Mağaza Yapılandırması</h6>
                <ul class="small ps-3 mb-0">
                    <li><strong>Genel & SEO:</strong> Bakım modu, Google indeksleme izni ve ürün katalog modu.</li>
                    <li><strong>Görünüm & PWA:</strong> Vitrin teması seçimi, PWA renk ve açılış ayarları.</li>
                    <li><strong>Medya Politikaları:</strong> Görsel boyutlandırma, JPEG/WebP sıkıştırma ve Sidecar.</li>
                </ul>
            </div>
            <div class="col-md-4">
                <h6 class="fw-bold text-success"><i class="fa fa-briefcase me-1"></i> İşletme & Ticaret</h6>
                <ul class="small ps-3 mb-0">
                    <li><strong>Firma Bilgileri:</strong> Resmi unvan, iletişim kanalları ve ücretsiz kargo limiti.</li>
                    <li><strong>Satış & Ödemeler:</strong> Ödeme sağlayıcı (İyzico), taksit seçenekleri ve kimlik bilgileri.</li>
                </ul>
            </div>
            <div class="col-md-4">
                <h6 class="fw-bold text-danger"><i class="fa fa-shield me-1"></i> Sistem & Güvenlik</h6>
                <ul class="small ps-3 mb-0">
                    <li><strong>Güvenlik:</strong> Yönetici 2FA, Captcha bot koruması ve istek sınırlama (Rate Limiting).</li>
                    <li><strong>E-Posta:</strong> SMTP sunucusu yapılandırması ve canlı test e-postası.</li>
                    <li><strong>Entegrasyonlar & Araçlar:</strong> Sosyal medya, harici scriptler, metrikler ve veri yedekleme.</li>
                </ul>
            </div>
        </div>
        @Html.Partial("_AdminHelpAccordionEnd")
    </div>

    <!-- Main Settings Form -->
    @using (Html.BeginForm("SystemSettings", "AdminSettings", FormMethod.Post, new { id = "systemSettingsForm", @class = "dirty-check-form" }))
    {
        @Html.AntiForgeryToken()

        <!-- Validation Summary -->
        <div id="validationSummaryContainer" class="mb-3">
            @Html.AdminValidationSummary()
        </div>

        <!-- Sticky Save Control Bar -->
        <div class="sticky-save-bar card shadow-sm mb-4 border-primary" id="stickySaveBar">
            <div class="card-body py-2 px-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span id="saveStatusIndicator" class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <i class="fa fa-check-circle me-1"></i> Ayarlar Güncel
                    </span>
                    <span id="unsavedChangesBadge" class="badge bg-warning text-dark px-2 py-1 d-none">
                        <i class="fa fa-pencil me-1"></i> Kaydedilmemiş Değişiklikler Var
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnDiscardChanges" disabled>
                        <i class="fa fa-undo me-1"></i> Değişiklikleri Sıfırla
                    </button>
                    <button type="submit" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" id="btnSaveSystemSettings">
                        <i class="fa fa-save me-1"></i> @AdminResource.SaveButtonText
                    </button>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <!-- Left Information Architecture Navigation -->
            <div class="col-lg-3 col-md-4">
                <div class="settings-nav-card card shadow-sm sticky-lg-top" style="top: 20px; z-index: 10;">
                    <div class="card-header bg-light py-2 px-3 border-bottom">
                        <span class="fw-bold text-uppercase small text-muted"><i class="fa fa-compass me-1"></i> Ayar Kategorileri</span>
                    </div>
                    <div class="list-group list-group-flush settings-tab-menu" id="settingsTabs" role="tablist">
                        <!-- Overview -->
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between active" data-bs-toggle="pill" href="#overview" role="tab">
                            <span><i class="fa fa-dashboard text-primary me-2"></i><strong>Genel Bakış</strong></span>
                            <span class="badge bg-primary rounded-pill"><i class="fa fa-home"></i></span>
                        </a>

                        <!-- STORE Domain -->
                        <div class="settings-nav-domain-header text-uppercase">
                            <i class="fa fa-shopping-cart text-muted me-1"></i> Mağaza (Store)
                        </div>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-general" role="tab">
                            <span><i class="fa fa-cog text-secondary me-2"></i> Genel &amp; Vitrin</span>
                            @if (!isSiteLive) { <span class="badge bg-warning text-dark small" title="Bakım modu aktif">Bakım</span> }
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-appearance" role="tab">
                            <span><i class="fa fa-paint-brush text-secondary me-2"></i> Görünüm &amp; PWA</span>
                            <span class="badge bg-light text-dark border small">@activeTheme</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-media" role="tab">
                            <span><i class="fa fa-picture-o text-secondary me-2"></i> Medya &amp; Yükleme</span>
                            @if (isWebPActive) { <span class="badge bg-info-subtle text-info border border-info-subtle small">WebP</span> }
                        </a>

                        <!-- BUSINESS Domain -->
                        <div class="settings-nav-domain-header text-uppercase">
                            <i class="fa fa-briefcase text-muted me-1"></i> İşletme (Business)
                        </div>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-company" role="tab">
                            <span><i class="fa fa-building-o text-secondary me-2"></i> @AdminResource.CompanyAdminSettings</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-payments" role="tab" id="nav-tab-payments">
                            <span><i class="fa fa-credit-card text-secondary me-2"></i> Satış &amp; Ödemeler</span>
                            <span class="badge bg-secondary payment-disabled-badge d-none small">Kilitli</span>
                        </a>

                        <!-- SYSTEM Domain -->
                        <div class="settings-nav-domain-header text-uppercase">
                            <i class="fa fa-server text-muted me-1"></i> Sistem (System)
                        </div>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-security" role="tab">
                            <span><i class="fa fa-shield text-secondary me-2"></i> Güvenlik &amp; İstek Koruması</span>
                            <span class="badge @(securityScore >= 70 ? "bg-success" : (securityScore >= 35 ? "bg-warning text-dark" : "bg-danger")) small">
                                @(securityScore >= 70 ? "İyi" : (securityScore >= 35 ? "Orta" : "Zayıf"))
                            </span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-smtp" role="tab">
                            <span><i class="fa fa-envelope-o text-secondary me-2"></i> @AdminResource.SmtpEmailSettings</span>
                            <span class="badge @(isSmtpConfigured ? "bg-success" : "bg-warning text-dark") small">
                                @(isSmtpConfigured ? "Hazır" : "Gerekli")
                            </span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-integrations" role="tab">
                            <span><i class="fa fa-plug text-secondary me-2"></i> Entegrasyonlar &amp; Servisler</span>
                        </a>
                        <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between" data-bs-toggle="pill" href="#tab-tools" role="tab">
                            <span><i class="fa fa-wrench text-secondary me-2"></i> Sistem Araçları &amp; Bakım</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Tab Content Area -->
            <div class="col-lg-9 col-md-8">
                <div class="tab-content" id="settingsTabContent">
                    
                    <!-- ========================================================================= -->
                    <!-- 0. OVERVIEW DASHBOARD TAB -->
                    <!-- ========================================================================= -->
                    <div id="overview" class="tab-pane fade show active" role="tabpanel">
                        <div class="card shadow-sm mb-4 border-0">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h4 class="mb-0 fw-bold text-dark"><i class="fa fa-tachometer text-primary me-2"></i>Ayarlar Merkezi Genel Bakış</h4>
                                    <small class="text-muted">Mağaza ve sistem durumunun anlık özeti</small>
                                </div>
                                <span class="badge bg-light text-secondary border px-3 py-2">
                                    <i class="fa fa-clock-o me-1"></i> Canlı Yapılandırma
                                </span>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <!-- Storefront Status Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-primary-subtle text-primary rounded p-2"><i class="fa fa-shopping-bag fa-lg"></i></span>
                                                    <span class="badge @(isSiteLive ? "bg-success" : "bg-warning text-dark")">
                                                        @(isSiteLive ? "Canlı Yayında" : "Bakım Modunda")
                                                    </span>
                                                </div>
                                                <h6 class="fw-bold mb-1">Mağaza &amp; Vitrin</h6>
                                                <p class="text-muted small mb-2">Tema, SEO ve ürün satış davranışları.</p>
                                                <ul class="list-unstyled small mb-0">
                                                    <li><i class="fa fa-circle @(isPriceActive ? "text-success" : "text-secondary") me-1 small"></i> Fiyat &amp; Satış: <strong>@(isPriceActive ? "Aktif" : "Katalog Modu")</strong></li>
                                                    <li><i class="fa fa-circle @(isSearchIndexing ? "text-success" : "text-danger") me-1 small"></i> SEO İndeksleme: <strong>@(isSearchIndexing ? "Açık" : "Kapalı")</strong></li>
                                                    <li><i class="fa fa-circle text-primary me-1 small"></i> Aktif Tema: <strong>@activeTheme</strong></li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary btn-sm w-100 mt-3" onclick="navigateToTab('#tab-general')">
                                                <i class="fa fa-arrow-right me-1"></i> Genel Ayarları Aç
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Security Status Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-danger-subtle text-danger rounded p-2"><i class="fa fa-shield fa-lg"></i></span>
                                                    <span class="badge @(securityScore >= 70 ? "bg-success" : (securityScore >= 35 ? "bg-warning text-dark" : "bg-danger"))">
                                                        Güvenlik Skoru: %@securityScore
                                                    </span>
                                                </div>
                                                <h6 class="fw-bold mb-1">Güvenlik &amp; Koruma</h6>
                                                <p class="text-muted small mb-2">Yönetici hesapları ve istek korumaları.</p>
                                                <ul class="list-unstyled small mb-0">
                                                    <li><i class="fa @(is2FaActive ? "fa-check text-success" : "fa-times text-danger") me-1"></i> Yönetici 2FA: <strong>@(is2FaActive ? "Zorunlu" : "Kapalı")</strong></li>
                                                    <li><i class="fa @(isCaptchaActive ? "fa-check text-success" : "fa-times text-warning") me-1"></i> Spam Captcha: <strong>@Model.CaptchaProvider</strong></li>
                                                    <li><i class="fa @(isRateLimitActive ? "fa-check text-success" : "fa-times text-danger") me-1"></i> Rate Limiting: <strong>@(isRateLimitActive ? "Aktif" : "Devre Dışı")</strong></li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-outline-danger btn-sm w-100 mt-3" onclick="navigateToTab('#tab-security')">
                                                <i class="fa fa-arrow-right me-1"></i> Güvenlik Paneline Git
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Email & SMTP Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-warning-subtle text-warning rounded p-2"><i class="fa fa-envelope-o fa-lg"></i></span>
                                                    <span class="badge @(isSmtpConfigured ? "bg-success" : "bg-danger")">
                                                        @(isSmtpConfigured ? "SMTP Yapılandırıldı" : "Yapılandırma Gerekli")
                                                    </span>
                                                </div>
                                                <h6 class="fw-bold mb-1">E-Posta &amp; SMTP</h6>
                                                <p class="text-muted small mb-2">Giden bildirim ve sipariş e-postaları.</p>
                                                <ul class="list-unstyled small mb-0">
                                                    <li class="text-truncate"><i class="fa fa-server text-muted me-1"></i> Sunucu: <strong>@(string.IsNullOrWhiteSpace(Model.AdminEmailHost) ? "Tanımsız" : Model.AdminEmailHost)</strong></li>
                                                    <li class="text-truncate"><i class="fa fa-at text-muted me-1"></i> Gönderen: <strong>@(string.IsNullOrWhiteSpace(Model.AdminEmail) ? "Tanımsız" : Model.AdminEmail)</strong></li>
                                                    <li><i class="fa fa-lock text-muted me-1"></i> Güvenlik: <strong>@(Model.AdminEmailEnableSsl ? "SSL/TLS Aktif" : "Düz Bağlantı")</strong></li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-outline-warning btn-sm w-100 mt-3 text-dark" onclick="navigateToTab('#tab-smtp')">
                                                <i class="fa fa-arrow-right me-1"></i> E-Posta Ayarlarını Aç
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Media Optimization Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-info-subtle text-info rounded p-2"><i class="fa fa-picture-o fa-lg"></i></span>
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                                        @(isWebPActive ? "WebP Aktif" : "JPEG/PNG")
                                                    </span>
                                                </div>
                                                <h6 class="fw-bold mb-1">Medya &amp; Optimizasyon</h6>
                                                <p class="text-muted small mb-2">Görsel boyutları ve sıkıştırma kalitesi.</p>
                                                <ul class="list-unstyled small mb-0">
                                                    <li><i class="fa fa-compress text-muted me-1"></i> JPEG Kalitesi: <strong>%@Model.ImageUploadJpegQuality</strong></li>
                                                    <li><i class="fa fa-file-image-o text-muted me-1"></i> WebP Kalitesi: <strong>%@Model.ImageUploadWebPQuality</strong></li>
                                                    <li><i class="fa fa-clone text-muted me-1"></i> Sidecar: <strong>@(Model.ImageUploadSaveWebPSidecar ? "Açık" : "Kapalı")</strong></li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-outline-info btn-sm w-100 mt-3" onclick="navigateToTab('#tab-media')">
                                                <i class="fa fa-arrow-right me-1"></i> Medya Ayarlarını Aç
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Business Profile Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-success-subtle text-success rounded p-2"><i class="fa fa-building-o fa-lg"></i></span>
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">İşletme Profili</span>
                                                </div>
                                                <h6 class="fw-bold mb-1">Firma &amp; İletişim</h6>
                                                <p class="text-muted small mb-2">Firma unvanı ve iletişim detayları.</p>
                                                <ul class="list-unstyled small mb-0">
                                                    <li class="text-truncate"><i class="fa fa-id-card-o text-muted me-1"></i> Unvan: <strong>@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "Belirtilmemiş" : Model.CompanyName)</strong></li>
                                                    <li class="text-truncate"><i class="fa fa-truck text-muted me-1"></i> Ücretsiz Kargo: <strong>@Model.BasketMinTotalPriceForCargo.ToString("N0") ₺</strong></li>
                                                    <li class="text-truncate"><i class="fa fa-phone text-muted me-1"></i> İletişim: <strong>@(string.IsNullOrWhiteSpace(Model.WebSiteCompanyPhoneAndLocation) ? "-" : Model.WebSiteCompanyPhoneAndLocation)</strong></li>
                                                </ul>
                                            </div>
                                            <button type="button" class="btn btn-outline-success btn-sm w-100 mt-3" onclick="navigateToTab('#tab-company')">
                                                <i class="fa fa-arrow-right me-1"></i> Firma Bilgilerini Düzenle
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Maintenance & Tools Card -->
                                    <div class="col-md-6 col-xl-4">
                                        <div class="overview-metric-card h-100 p-3 rounded border bg-light shadow-sm d-flex flex-column justify-content-between">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="metric-icon-box bg-secondary-subtle text-secondary rounded p-2"><i class="fa fa-wrench fa-lg"></i></span>
                                                    <span class="badge bg-secondary">Araçlar</span>
                                                </div>
                                                <h6 class="fw-bold mb-1">Sistem &amp; Yedekleme</h6>
                                                <p class="text-muted small mb-2">Sistem metrikleri, günlükler ve veri ihracı.</p>
                                                <div class="d-flex flex-wrap gap-1 mt-2">
                                                    <span class="badge bg-light text-dark border"><i class="fa fa-database text-success me-1"></i> JSON ZIP</span>
                                                    <span class="badge bg-light text-dark border"><i class="fa fa-heartbeat text-danger me-1"></i> Health</span>
                                                    <span class="badge bg-light text-dark border"><i class="fa fa-line-chart text-primary me-1"></i> Metrics</span>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-outline-secondary btn-sm w-100 mt-3" onclick="navigateToTab('#tab-tools')">
                                                <i class="fa fa-arrow-right me-1"></i> Sistem Araçlarını Aç
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 1. GENERAL & SEO TAB -->
                    <!-- ========================================================================= -->
                    <div id="tab-general" class="tab-pane fade" role="tabpanel">
                        <!-- Section: Site Durumu & SEO -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Site Durumu & SEO">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa fa-globe text-primary me-2"></i>Site Durumu &amp; Arama Motoru İndeksleme</h5>
                                <small class="text-muted">Mağazanızın ziyaretçi erişimi ve arama motorlarındaki görünürlüğünü yönetin.</small>
                            </div>
                            <div class="card-body">
                                <!-- Maintenance Mode -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="IsSiteUnderConstruction" data-setting-label="Bakım Modu" data-setting-desc="Ziyaretçilere bakım sayfası gösterilir ve arama motorlarına noindex verilir" data-keywords="bakım modu site kapalı under construction maintenance">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="IsSiteUnderConstruction">
                                                <i class="fa fa-wrench text-warning me-1"></i> Bakım Modu (Site Durumu)
                                            </label>
                                            <p class="text-muted small mb-0">Aktif edildiğinde ziyaretçilere bakım sayfası gösterilir ve arama motorlarına otomatik <code>noindex</code> sinyali iletilir.</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.IsSiteUnderConstruction, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsSiteUnderConstruction, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <!-- Under Construction Custom HTML Message -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="UnderConstructionHtml" data-setting-label="Bakım Sayfası Özel Mesaj / HTML" data-setting-desc="Bakım modu aktifken ziyaretçilere gösterilecek özel duyuru veya HTML metni" data-keywords="bakım modu html duyuru mesaj özel under construction custom html message">
                                    <label class="fw-bold mb-1 d-block" for="UnderConstructionHtml">
                                        <i class="fa fa-code text-info me-1"></i> Bakım Sayfası Özel Mesaj / HTML
                                    </label>
                                    <p class="text-muted small mb-2">Bakım sayfası yayındayken ziyaretçilerinize gösterilecek özel duyuru, bilgilendirme metni veya HTML kodu girebilirsiniz. Boş bırakılırsa standart bakım mesajı gösterilir.</p>
                                    @Html.TextAreaFor(model => model.UnderConstructionHtml, new { @class = "form-control font-monospace", rows = 4, placeholder = "Örn: <p>Sistemlerimizde planlı altyapı yükseltmesi yapılmaktadır. Saat 02:00 itibarıyla yeniden hizmetinizdeyiz.</p>" })
                                    @Html.ValidationMessageFor(model => model.UnderConstructionHtml, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <!-- SEO Indexing -->
                                <div class="setting-item p-3 rounded border bg-light" data-setting-name="AllowSearchEngineIndexing" data-setting-label="Arama Motoru İndeksleme" data-setting-desc="Google, Bing ve diğer arama motorlarının sitenizi dizine eklemesine izin verir" data-keywords="seo google bing robot robots.txt meta indexing">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="AllowSearchEngineIndexing">
                                                <i class="fa fa-search text-success me-1"></i> Arama Motoru İndekslemesine İzin Ver
                                            </label>
                                            <p class="text-muted small mb-0">Açık olduğunda <code>robots.txt</code> ve meta etiketleri üzerinden Google ve Bing botlarına tam tarama ve dizin izni verilir.</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.AllowSearchEngineIndexing, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AllowSearchEngineIndexing, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>
                            </div>
                        </div>

                        <!-- Section: Mağaza & Ürün Davranışları -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Mağaza Davranışı">
                            <div class="card-header bg-white py-3 border-bottom">
                                <h5 class="mb-0 fw-bold"><i class="fa fa-shopping-bag text-primary me-2"></i>Mağaza Davranışı &amp; Katalog Tercihleri</h5>
                                <small class="text-muted">Ürün fiyatlandırması, yorumlar ve liste sayfalarının işleyişi.</small>
                            </div>
                            <div class="card-body">
                                <!-- Product Prices & Catalog Mode -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="IsProductPriceEnable" data-setting-label="Ürün Fiyatları ve Sepet" data-setting-desc="Ürün fiyatlarını gösterir ve sepete ekleme/satın alma fonksiyonlarını aktif eder" data-keywords="fiyat katalog modu sepete ekleme sipariş product price">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="IsProductPriceEnable">
                                                <i class="fa fa-tag text-primary me-1"></i> Ürün Fiyatları ve Sepete Ekleme
                                            </label>
                                            <p class="text-muted small mb-0">Kapalı olduğunda mağaza <strong>Katalog / Tanıtım Modunda</strong> çalışır; fiyatlar gizlenir ve ödeme adımları devre dışı bırakılır.</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.IsProductPriceEnable, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsProductPriceEnable, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <!-- Product Reviews -->
                                <div class="setting-item p-3 mb-3 rounded border bg-light" data-setting-name="IsProductReviewEnable" data-setting-label="Ürün Yorumları" data-setting-desc="Kullanıcıların ürünlere yorum yapmasını ve puan vermesini sağlar" data-keywords="yorum puan review rating değerlendirme">
                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                        <div>
                                            <label class="fw-bold mb-1 d-block" for="IsProductReviewEnable">
                                                <i class="fa fa-comments-o text-info me-1"></i> Ürün Yorumları ve Puanlama
                                            </label>
                                            <p class="text-muted small mb-0">Ziyaretçilerin ve kayıtlı müşterilerin ürün detay sayfalarında yorum ve yıldızlı puan bırakmasına izin verin.</p>
                                        </div>
                                        <div class="form-check form-switch fs-5 mb-0">
                                            @Html.CheckBoxFor(model => model.IsProductReviewEnable, new { @class = "form-check-input", role = "switch" })
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.IsProductReviewEnable, "", new { @class = "text-danger small mt-1 d-block" })
                                </div>

                                <!-- Admin Grid Page Size & Description Length -->
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6 setting-item" data-setting-name="GridPageSizeNumber" data-setting-label="Admin Liste Satır Sayısı" data-setting-desc="Yönetim panelinde sayfa başına gösterilecek satır sayısı" data-keywords="grid sayfa boyutu satır sayısı pagination page size">
                                        <label class="form-label fw-bold small" for="GridPageSizeNumber">
                                            @Html.DisplayNameFor(model => model.GridPageSizeNumber)
                                        </label>
                                        @Html.EditorFor(model => model.GridPageSizeNumber, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1", max = "1000", placeholder = "100" } })
                                        <div class="form-text small">Yönetim paneli listelerinde sayfa başına gösterilecek kayıt adedi (Örn: 100).</div>
                                        @Html.ValidationMessageFor(model => model.GridPageSizeNumber, "", new { @class = "text-danger small" })
                                    </div>

                                    <div class="col-md-6 setting-item" data-setting-name="ProductShortDescriptionPreviewLength" data-setting-label="Ürün Kısa Açıklama Karakter Limiti" data-setting-desc="Ürün detayında Devamını Gör butonundan önce gösterilecek karakter sayısı" data-keywords="kısa açıklama önizleme karakter sınırı preview length description">
                                        <label class="form-label fw-bold small" for="ProductShortDescriptionPreviewLength">
                                            @Html.DisplayNameFor(model => model.ProductShortDescriptionPreviewLength)
                                        </label>
                                        @Html.EditorFor(model => model.ProductShortDescriptionPreviewLength, new { htmlAttributes = new { @class = "form-control", type = "number", min = "10", max = "5000", placeholder = "180" } })
                                        <div class="form-text small">Vitrin ürün detayında "Devamını Gör" öncesi metin uzunluğu (Karakter).</div>
                                        @Html.ValidationMessageFor(model => model.ProductShortDescriptionPreviewLength, "", new { @class = "text-danger small" })
                                    </div>
                                </div>

                                <!-- Admin Panel Language -->
                                <div class="setting-item mb-3" data-setting-name="AdminPanelLanguage" data-setting-label="Yönetim Paneli Dili" data-setting-desc="Yönetim paneli arayüzünün görüntüleneceği dil (menüler, etiketler, butonlar, mesajlar). Veri giriş dili (üst çubuk) ile bağımsızdır." data-keywords="yönetim paneli dil arayüz language ui tr en">
                                    <label class="form-label fw-bold small" for="AdminPanelLanguage">
                                        @Html.DisplayNameFor(model => model.AdminPanelLanguage)
                                        @Html.Partial("_AdminFieldTip", null, new ViewDataDictionary { { "TipText", Resource.AdminPanelLanguageDescription } })
                                    </label>
                                    @Html.DropDownListFor(model => model.AdminPanelLanguage, new List<SelectListItem>
                                    {
                                        new SelectListItem { Text = "Türkçe (Turkish)", Value = "tr-TR" },
                                        new SelectListItem { Text = "English", Value = "en-US" }
                                    }, new { @class = "form-select", id = "AdminPanelLanguage" })
                                    <div class="form-text small">Yönetim paneli arayüz dili (menüler, butonlar, mesajlar). Veri giriş dili (üst çubuk) ayrı bir ayardır.</div>
                                    @Html.ValidationMessageFor(model => model.AdminPanelLanguage, "", new { @class = "text-danger small" })
                                </div>

                                <!-- Price Filter Setting Editor Partial -->
                                <div class="setting-item mb-3" data-setting-name="ProductPriceFilterSetting" data-setting-label="Fiyat Filtresi Aralıkları" data-setting-desc="Kategori ve arama sayfalarında gösterilen dinamik fiyat filtre aralıkları" data-keywords="fiyat aralığı filtre kategori slider range price filter">
                                    <label class="form-label fw-bold small">
                                        @Html.DisplayNameFor(model => model.ProductPriceFilterSetting)
                                    </label>
                                    @Html.Partial("_ProductPriceFilterEditor", Model.ProductPriceFilterSetting)
                                    @Html.ValidationMessageFor(model => model.ProductPriceFilterSetting, "", new { @class = "text-danger small" })
                                </div>

                                <!-- Payment Detail Tab HTML -->
                                <div class="setting-item" data-setting-name="PaymentDetailHtml" data-setting-label="Ürün Detay Ödeme Sekmesi HTML" data-setting-desc="Ürün detay sayfasındaki Ödeme Bilgisi sekmesinde gösterilecek özel HTML veya metin" data-keywords="ödeme sekmesi html taksit detay payment detail">
                                    <label class="form-label fw-bold small" for="PaymentDetailHtml">
                                        @Html.DisplayNameFor(model => model.PaymentDetailHtml)
                                    </label>
                                    @Html.TextAreaFor(model => model.PaymentDetailHtml, 6, 50, new { @class = "form-control font-monospace", placeholder = "<p>Tüm kredi kartlarına 12 aya varan taksit imkanı...</p>" })
                                    <div class="form-text small">Ürün detay sayfasındaki "Ödeme &amp; Taksit Bilgisi" sekmesinde doğrudan müşteriye sunulur.</div>
                                    @Html.ValidationMessageFor(model => model.PaymentDetailHtml, "", new { @class = "text-danger small" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================================================= -->
                    <!-- 2. APPEARANCE & PWA TAB -->
                    <!-- ========================================================================= -->
                    <div id="tab-appearance" class="tab-pane fade" role="tabpanel">
                        @if (showThemeSelection)
                        {
                            <!-- Section: Storefront Theme -->
                            <div class="card shadow-sm mb-4 setting-section-card" data-section-name="Vitrin Teması">
                                <div class="card-header bg-white py-3 border-bottom">
                                    <h5 class="mb-0 fw-bold"><i class="fa fa-paint-brush text-primary me-2"></i>Aktif Vitrin Teması</h5>
                                    <small class="text-muted">Müşterilerinize sunulan mağaza ön yüz tasarım şablonu.</small>
                                </div>
                                <div class="card-body setting-item" data-setting-name="ActiveDesign" data-setting-label="Aktif Tema" data-setting-desc="Ön yüz vitrin teması seçimi" data-keywords="tema tasarım crizal modern görünüm theme active design şablon template dropdown">
                                    <div class="row align-items-center g-3">
                                        <div class="col-md-6 col-lg-5">
                                            <label for="ActiveDesign" class="form-label fw-semibold">
                                                <i class="fa fa-th-large text-primary me-1"></i>Mağaza Ön Yüz Tasarım Şablonu
                                            </label>
                                            @Html.DropDownListFor(model => model.ActiveDesign, themeSelectItems, new { @class = "form-select form-select-lg shadow-sm", id = "ActiveDesign" })
                                            <div class="form-text small mt-1">
                                                Müşterilerinize sunulacak aktif vitrin temasını listeden seçiniz. Gelecekte eklenen tüm şablonlar bu listede yer alır.
                                            </div>
                                            @Html.ValidationMessageFor(model => model.ActiveDesign, "", new { @class = "text-danger small mt-1 d-block" })
                                        </div>
                                        <div class="col-md-6 col-lg-7">
                                            <div class="p-3 bg-light rounded border" id="themePreviewBox">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="fw-bold text-dark" id="themePreviewTitle">
                                                        <i class="fa fa-desktop text-primary me-1"></i>Seçili Tema: <span id="themeDisplayName">@activeTheme</span>
                                                    </span>
                                                    <span class="badge bg-success" id="themeActiveBadge">
                                                        <i class="fa fa-check me-1"></i>Aktif Şablon
                                                    </span>
                                                </div>
                                                <p class="text-muted small mb-2" id="themePreviewDesc">
                                                    Tasarım şablonu kaydedildiğinde tüm vitrin ve kategori sayfaları seçilen temanın arayüzü ile sunulur.
                                                </p>
                                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                                    <span class="badge bg-white text-secondary border">
                                                        <i class="fa fa-folder-open-o me-1"></i>Klasör: <code>/Views/Designs/<span id="themeFolderName">@activeTheme</span>/</code>
                                                    </span>
                                                    <a href="@Url.Action("Index", "Home", new { area = "" })" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 0.8rem;">
                                                        <i class="fa fa-external-link me-1"></i>Mağazayı Önizle
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            @Html.HiddenFor(model => model.ActiveDesign)
                        }

                        <!-- Section: PWA & Web App Manifest -->
                        <div class="card shadow-sm mb-4 setting-section-card" data-section-name="PWA & Web App Manifest">
                            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <h5 class="mb-0 fw-bold"><i class="fa fa-mobile text-primary me-2"></i>PWA &amp; Web App Manifest Yapılandırması</h5>
                                    <small class="text-muted">Mobil cihazlarda ana ekrana ekleme, açılış ekranı ve tarayıcı başlık renkleri.</small>
                                </div>
                                <a href="@Url.Content("~/manifest.json")" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary shadow-sm" id="btnPreviewManifest">
                                    <i class="fa fa-external-link me-1"></i> manifest.json Test Et
                                </a>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="small">
                                        <i class="fa fa-info-circle me-1"></i>
                                        PWA manifest yapılandırmanızın canlı çıktısını incelemek ve doğrulamak için:
                                        <a href="@Url.Content("~/manifest.json")" target="_blank" rel="noopener noreferrer" class="fw-bold text-decoration-underline ms-1">
                                            /manifest.json <i class="fa fa-external-link small"></i>
                                        </a>
                                    </div>
                                    <a href="@Url.Content("~/manifest.json")" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">
                                        Canlı Çıktıyı Aç
                                    </a>
                                </div>

                                <div class="row g-3">
                                    <!-- Theme Color -->
                                    <div class="col-md-6 setting-item" data-setting-name="ThemeColor" data-setting-label="PWA Tema Rengi" data-setting-desc="Tarayıcı adres çubuğu ve PWA başlık rengi (Hex)" data-keywords="tema rengi pwa renk adres çubuğu hex theme color">
                                        <label class="form-label fw-bold small" for="ThemeColor">@Html.DisplayNameFor(model => model.ThemeColor)</label>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.ThemeColor, new { htmlAttributes = new { @class = "form-control", placeholder = "#1789F9" } })
                                            <span class="input-group-text p-1 bg-white">
                                                <input type="color" class="form-control form-control-color border-0" style="width:36px;height:30px;padding:0;" onchange="$('#ThemeColor').val(this.value).trigger('input');" value="@(string.IsNullOrWhiteSpace(Model.ThemeColor) ? "#1789F9" : Model.ThemeColor)" />
                                            </span>
                                        </div>
                                        <div class="form-text small">Tarayıcı başlık ve adres çubuğu rengi (Hex örn: #1789F9).</div>
                                        @Html.ValidationMessageFor(model => model.ThemeColor, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Background Color -->
                                    <div class="col-md-6 setting-item" data-setting-name="ManifestBackgroundColor" data-setting-label="PWA Açılış Arka Plan Rengi" data-setting-desc="PWA açılış ekranı (Splash Screen) arka plan rengi (Hex)" data-keywords="splash screen arka plan rengi pwa background color">
                                        <label class="form-label fw-bold small" for="ManifestBackgroundColor">@Html.DisplayNameFor(model => model.ManifestBackgroundColor)</label>
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.ManifestBackgroundColor, new { htmlAttributes = new { @class = "form-control", placeholder = "#ffffff" } })
                                            <span class="input-group-text p-1 bg-white">
                                                <input type="color" class="form-control form-control-color border-0" style="width:36px;height:30px;padding:0;" onchange="$('#ManifestBackgroundColor').val(this.value).trigger('input');" value="@(string.IsNullOrWhiteSpace(Model.ManifestBackgroundColor) ? "#ffffff" : Model.ManifestBackgroundColor)" />
                                            </span>
                                        </div>
                                        <div class="form-text small">PWA açılış ekranı (Splash Screen) arka plan rengi.</div>
                                        @Html.ValidationMessageFor(model => model.ManifestBackgroundColor, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Manifest Display -->
                                    <div class="col-md-6 setting-item" data-setting-name="ManifestDisplay" data-setting-label="PWA Görüntüleme Modu" data-setting-desc="PWA pencere modu: standalone, fullscreen, minimal-ui, browser" data-keywords="pwa display standalone pencere tam ekran manifest">
                                        <label class="form-label fw-bold small" for="ManifestDisplay">@Html.DisplayNameFor(model => model.ManifestDisplay)</label>
                                        @Html.DropDownListFor(model => model.ManifestDisplay, new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "standalone (Bağımsız Uygulama Penceresi - Önerilen)", Value = "standalone" },
                                            new SelectListItem { Text = "fullscreen (Tam Ekran)", Value = "fullscreen" },
                                            new SelectListItem { Text = "minimal-ui (Minimal Tarayıcı Kontrolleri)", Value = "minimal-ui" },
                                            new SelectListItem { Text = "browser (Standart Tarayıcı)", Value = "browser" }
                                        }, new { @class = "form-select" })
                                        <div class="form-text small">Uygulamanın mobil cihazda açılış penceresi biçimi.</div>
                                        @Html.ValidationMessageFor(model => model.ManifestDisplay, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Manifest Orientation -->
                                    <div class="col-md-6 setting-item" data-setting-name="ManifestOrientation" data-setting-label="PWA Ekran Yönelimi" data-setting-desc="PWA ekran yönelimi: portrait, landscape, any" data-keywords="ekran yönü portrait landscape dikey yatay orientation">
                                        <label class="form-label fw-bold small" for="ManifestOrientation">@Html.DisplayNameFor(model => model.ManifestOrientation)</label>
                                        @Html.DropDownListFor(model => model.ManifestOrientation, new List<SelectListItem>
                                        {
                                            new SelectListItem { Text = "portrait (Dikey - Önerilen)", Value = "portrait" },
                                            new SelectListItem { Text = "landscape (Yatay)", Value = "landscape" },
                                            new SelectListItem { Text = "any (Otomatik / Serbest)", Value = "any" }
                                        }, new { @class = "form-select" })
                                        <div class="form-text small">Mobil cihazlar için varsayılan ekran açısı.</div>
                                        @Html.ValidationMessageFor(model => model.ManifestOrientation, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Manifest Start Url -->
                                    <div class="col-md-4 setting-item" data-setting-name="ManifestStartUrl" data-setting-label="PWA Başlangıç URL'si" data-setting-desc="Uygulama simgesine tıklandığında açılacak ilk sayfa adresi" data-keywords="başlangıç adresi start url pwa açılış">
                                        <label class="form-label fw-bold small" for="ManifestStartUrl">@Html.DisplayNameFor(model => model.ManifestStartUrl)</label>
                                        @Html.EditorFor(model => model.ManifestStartUrl, new { htmlAttributes = new { @class = "form-control", placeholder = "/" } })
                                        <div class="form-text small">Uygulama açılış yolu (Varsayılan: /).</div>
                                        @Html.ValidationMessageFor(model => model.ManifestStartUrl, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Manifest Fallback Name -->
                                    <div class="col-md-4 setting-item" data-setting-name="ManifestFallbackName" data-setting-label="PWA Yedek Uygulama Adı" data-setting-desc="Firma adı boş olduğunda kullanılan PWA adı" data-keywords="yedek ad fallback name pwa app name">
                                        <label class="form-label fw-bold small" for="ManifestFallbackName">@Html.DisplayNameFor(model => model.ManifestFallbackName)</label>
                                        @Html.EditorFor(model => model.ManifestFallbackName, new { htmlAttributes = new { @class = "form-control", placeholder = "Web App" } })
                                        <div class="form-text small">Firma unvanı tanımlanmadığında kullanılır.</div>
                                        @Html.ValidationMessageFor(model => model.ManifestFallbackName, "", new { @class = "text-danger small" })
                                    </div>

                                    <!-- Manifest Short Name Length -->
