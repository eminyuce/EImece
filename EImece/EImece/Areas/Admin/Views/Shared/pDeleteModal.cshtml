@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using Resources;
@{
    string deleteIcon = ViewData["DeleteIcon"].ToStr();
    string action = ViewData["action"].ToStr("Delete");
    string controllerName = ViewData["controllerName"].ToStr();
    string Id = ViewData["ItemId"].ToStr();
    string gridDeleteText = ViewData["gridDeleteText"].ToStr(AdminResource.Delete);
    string ItemDescription = ViewData["ItemDescription"].ToStr();
    string deleteUrl = Url.Action(action, controllerName, new { id = Id, area = "Admin" });
    string triggerClass = !String.IsNullOrEmpty(deleteIcon)
        ? deleteIcon
        : "btn btn-danger btn-sm";
}
<button type="button"
   class="@triggerClass"
   data-admin-delete="1"
   data-delete-url="@deleteUrl"
   data-delete-id="@Id"
   data-entity-name="@ItemDescription"
   data-delete-title="@AdminResource.AreYouSure"
   data-delete-message="@AdminResource.DeletePopupDescription"
   data-delete-button="@gridDeleteText"
   title="@gridDeleteText"
   aria-label="@gridDeleteText">@if (String.IsNullOrEmpty(deleteIcon))
{<text><i class="glyphicon glyphicon-trash" aria-hidden="true"></i> @gridDeleteText</text>}
else
{<span class="sr-only">@gridDeleteText</span>}</button>
