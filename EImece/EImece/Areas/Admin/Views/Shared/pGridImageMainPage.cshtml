@model BaseContent
@using EImece.Domain.Helpers
@using EImece.Domain
@using Resources
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Entities
@using System.Data.Entity.Core.Objects
@{
    var baseContent = Model;
    FileStorage f = baseContent != null ? baseContent.MainImage : null;
    var gridMainPageImageText = AdminResource.GridMainPageImageText;
    Boolean IsMainImageExists = baseContent != null && FilesHelper.IsMainImageExists(baseContent.MainImageId, f);
    string className = baseContent != null ? ObjectContext.GetObjectType(baseContent.GetType()).Name : "";
    var confirmationText = AdminResource.RemoveMainImageConfirmationText;
    bool showRemove = (ViewData["ShowRemoveImage"] == null ? true : ViewData["ShowRemoveImage"].ToBool(true)) && UserRoleHelper.IsDeletedEnableRoles();
    bool showExistingLabel = ViewData["ShowExistingLabel"] == null ? showRemove : ViewData["ShowExistingLabel"].ToBool(false);
    var modalTarget = (IsMainImageExists && f != null) ? ("#myModal_" + f.Id) : "";
}
<div class="eg-image-preview">
@if (IsMainImageExists && f != null)
{
    if (showExistingLabel)
    {
        <div class="small fw-semibold mb-1">@AdminResource.ExistingMainImageText</div>
    }
    <span data-main-image-delete-id="@f.Id">
        <button type="button" class="btn btn-sm btn-primary eg-image-preview-btn" data-bs-toggle="modal" data-bs-target="@modalTarget"><i class="fa-regular fa-image" aria-hidden="true"></i> @gridMainPageImageText</button>
        @Html.Partial("pImagePopUp", f)
        @if (showRemove)
        {
            <input id="MainImageId" name="MainImageId" type="hidden" value="@baseContent.MainImageId" />
            <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteBaseContentMainImage(@baseContent.Id, @f.Id,'@className','@confirmationText')">@AdminResource.RemoveJustImage</button>
        }
    </span>
}
else
{
    <span class="eg-image-none">@AdminResource.GridNoMainPageImageText</span>
}
</div>
