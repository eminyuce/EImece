@using EImece.Domain.Helpers;
@using Resources;
@using EImece.Domain.Models.Enums;
@using System.Collections.Generic;
@using System.Web.Routing;
@{
    var controllerName = ViewData["controllerName"].ToStr();

    var orderingButton = ViewData["orderingButton"].ToBool(true);
    var selectAll = ViewData["selectAll"].ToBool(true);
    var deleteAll = ViewData["deleteAll"].ToBool(true) && UserRoleHelper.IsDeletedEnableRoles();
    var IdValueExists = ViewData["IdValueExists"].ToBool(false);
    var SetStateOnOrOff = ViewData["SetStateOnOrOff"].ToBool(true);
    var StateTypes = ViewData["StateTypes"].ToStr("State,ImageState,MainPage");
    // Product stock/status controls belong only on product grids (opt-in).
    var ProductState = ViewData["ProductState"].ToBool(false);
    var isNewRecordButtonEnabled = ViewData["IsNewRecordButtonEnabled"].ToBool(true);
    var IsExcelButtonEnabled = ViewData["IsExcelButtonEnabled"].ToBool(false);
    var IsSearchFormEnabled = ViewData["IsSearchFormEnabled"].ToBool(true);
    var NewRecordText = AdminResource.NewRecordText;

    var GridSelectAllButtonText = AdminResource.GridSelectAllButtonText;
    var GridDeSelectAllButtonText = AdminResource.GridDeSelectAllButtonText;
    var GridDeleteSelectedButtonText = AdminResource.GridDeleteSelectedButtonText;
    var GridActiveSelectedButtonText = AdminResource.GridActiveSelectedButtonText;
    var GridDeActiveSelectedButtonText = AdminResource.GridDeActiveSelectedButtonText;
    var GridOrderingAllButtonText = AdminResource.GridOrderingAllButtonText;
    var ProductStateChangeText = AdminResource.ProductStateChangeText;
    var State = AdminResource.IsActive;
    var ImageState = AdminResource.ImageState;
    var MainPage = AdminResource.MainPage;
    var IsCampaign = AdminResource.IsCampaign;
    var AdminDeleteConfirmMessage = AdminResource.AdminDeleteConfirmMessage;

    var hasBulkActions = selectAll || deleteAll || SetStateOnOrOff || orderingButton || ProductState;
    var currentSearch = Request.QueryString["search"].ToStr();
    var preserveQuery = ViewData["PreserveQuery"] as IDictionary<string, string>;
    var exportId = "";
    if (IdValueExists)
    {
        exportId = ViewContext.RouteData.Values["id"].ToStr();
    }
}

<div class="card border-info admin-grid-ops eg-bulk-bar">
    <div class="card-body">

        @if (isNewRecordButtonEnabled || IsSearchFormEnabled || IsExcelButtonEnabled)
        {
            <div class="eg-ops-primary">
                @if (isNewRecordButtonEnabled)
                {
                    <a class="btn btn-primary eg-ops-new" href="@Url.Action("SaveOrEdit", controllerName)">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        <span>@NewRecordText</span>
                    </a>
                }
                @if (IsSearchFormEnabled)
                {
                    <div class="eg-ops-search">
                        @{
                            var searchViewData = new ViewDataDictionary(ViewData);
                            searchViewData["IdValueExists"] = IdValueExists;
                        }
                        @Html.Partial("pAdminSearchForm", searchViewData)
                    </div>
                }
                @if (IsExcelButtonEnabled)
                {
                    var excelRoute = new RouteValueDictionary();
                    excelRoute["format"] = "excel";
                    excelRoute["search"] = currentSearch;
                    if (!string.IsNullOrEmpty(exportId))
                    {
                        excelRoute["id"] = exportId;
                    }
                    if (preserveQuery != null)
                    {
                        foreach (var kv in preserveQuery)
                        {
                            if (!string.IsNullOrEmpty(kv.Key) && kv.Value != null)
                            {
                                excelRoute[kv.Key] = kv.Value;
                            }
                        }
                    }
                    var csvRoute = new RouteValueDictionary(excelRoute);
                    csvRoute["format"] = "csv";
                    <fieldset class="eg-ops-export" style="border:0;padding:0;margin:0;min-width:0">
                        <legend class="visually-hidden">@AdminResource.Excel</legend>
                        <a class="btn btn-secondary btn-sm eg-ops-btn eg-ops-btn-export" href="@Url.Action("ExportExcel", controllerName, excelRoute)" title="@AdminResource.Excel">
                            <i class="fa-solid fa-upload" aria-hidden="true"></i>
                            <span>@AdminResource.Excel</span>
                        </a>
                        <a class="btn btn-secondary btn-sm eg-ops-btn eg-ops-btn-export" href="@Url.Action("ExportExcel", controllerName, csvRoute)" title="@AdminResource.Csv">
                            <i class="fa-solid fa-download" aria-hidden="true"></i>
                            <span>@AdminResource.Csv</span>
                        </a>
                    </fieldset>
                }
            </div>
        }

        @if (hasBulkActions)
        {
            <details class="eg-ops-more">
                <summary class="eg-ops-more-summary">
                    <span class="eg-ops-more-summary-main">
                        <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                        <span>@AdminResource.BulkOperations</span>
                    </span>
                    <span class="eg-ops-more-hint">@AdminResource.BulkOperationsHint</span>
                </summary>
                <div class="admin-grid-toolbar eg-ops-toolbar" role="toolbar" aria-label="@AdminResource.BulkOperations">

                    @if (selectAll)
                    {
                        <fieldset class="admin-grid-toolbar-group eg-ops-group eg-ops-group-select" style="border:0;padding:0;margin:0;min-width:0">
                            <legend class="visually-hidden">@GridSelectAllButtonText</legend>
                            <button type="button" class="btn btn-secondary btn-sm eg-ops-btn" id="SelectAll" title="@GridSelectAllButtonText">
                                <i class="fa-regular fa-square-check" aria-hidden="true"></i>
                                <span>@AdminResource.All</span>
                            </button>
                            <button type="button" class="btn btn-secondary btn-sm eg-ops-btn" id="DeselectAll" title="@GridDeSelectAllButtonText">
                                <i class="fa-regular fa-square" aria-hidden="true"></i>
                                <span>@AdminResource.Clear</span>
                            </button>
                        </fieldset>
                    }

                    @if (SetStateOnOrOff)
                    {
                        <fieldset class="admin-grid-toolbar-group eg-ops-group" style="border:0;padding:0;margin:0;min-width:0">
                            <legend class="visually-hidden">@State</legend>
                            <label class="visually-hidden" for="ItemStateSelection">@State</label>
                            @if (StateTypes.Equals("State,ImageState,MainPage,IsCampaign"))
                            {
                                <select class="form-select form-select-sm admin-grid-state-select eg-ops-select" name="ItemStateSelection" id="ItemStateSelection" title="@State">
                                    <option value="State">@State</option>
                                    <option value="ImageState">@ImageState</option>
                                    <option value="MainPage">@MainPage</option>
                                    <option value="IsCampaign">@IsCampaign</option>
                                </select>
                            }
                            else if (StateTypes.Equals("State,ImageState,MainPage"))
                            {
                                <select class="form-select form-select-sm admin-grid-state-select eg-ops-select" name="ItemStateSelection" id="ItemStateSelection" title="@State">
                                    <option value="State">@State</option>
                                    <option value="ImageState">@ImageState</option>
                                    <option value="MainPage">@MainPage</option>
                                </select>
                            }
                            else if (StateTypes.Equals("State,ImageState"))
                            {
                                <select class="form-select form-select-sm admin-grid-state-select eg-ops-select" name="ItemStateSelection" id="ItemStateSelection" title="@State">
                                    <option value="State">@State</option>
                                    <option value="ImageState">@ImageState</option>
                                </select>
                            }
                            else if (StateTypes.Equals("State"))
                            {
                                <input value="State" type="hidden" name="ItemStateSelection" id="ItemStateSelection" aria-label="@State" />
                            }

                            <button type="button" class="btn btn-success btn-sm eg-ops-btn eg-ops-btn-success" id="SetStateOnAll" title="@GridActiveSelectedButtonText">
                                <i class="fa-solid fa-check" aria-hidden="true"></i>
                                <span>@AdminResource.Publish</span>
                            </button>
                            <button type="button" class="btn btn-warning btn-sm eg-ops-btn eg-ops-btn-warning" id="SetStateOffAll" title="@GridDeActiveSelectedButtonText">
                                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                <span>@AdminResource.Unpublish</span>
                            </button>
                        </fieldset>
                    }
                    else if (StateTypes.Equals("State"))
                    {
                        <input value="State" type="hidden" name="ItemStateSelection" id="ItemStateSelection" />
                    }

                    @if (orderingButton)
                    {
                        <fieldset class="admin-grid-toolbar-group eg-ops-group" style="border:0;padding:0;margin:0;min-width:0">
                            <legend class="visually-hidden">@GridOrderingAllButtonText</legend>
                            <button type="button" class="btn btn-secondary btn-sm eg-ops-btn" id="OrderingAll" title="@GridOrderingAllButtonText">
                                <i class="fa-solid fa-sort" aria-hidden="true"></i>
                                <span>@AdminResource.Order</span>
                            </button>
                        </fieldset>
                    }

                    @if (ProductState)
                    {
                        <fieldset class="admin-grid-toolbar-group admin-grid-toolbar-product eg-ops-group eg-ops-group-product" style="border:0;padding:0;margin:0;min-width:0">
                            <legend class="visually-hidden">@ProductStateChangeText</legend>
                            <label class="visually-hidden" for="ProductStateSelection">@ProductStateChangeText</label>
                            <select class="form-select form-select-sm admin-grid-state-select eg-ops-select eg-ops-select-wide" name="ProductStateSelection" id="ProductStateSelection" title="@ProductStateChangeText">
                                @foreach (EImece.Domain.Models.Enums.ProductState state in Enum.GetValues(typeof(EImece.Domain.Models.Enums.ProductState)))
                                {
                                    <option value="@((int)state)">@GetProductStateResourceText(state)</option>
                                }
                            </select>
                            <button type="button" class="btn btn-info btn-sm eg-ops-btn eg-ops-btn-info" id="ProductStateChanged" title="@ProductStateChangeText">
                                <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                                <span>@AdminResource.Update</span>
                            </button>
                        </fieldset>
                    }

                    @if (deleteAll)
                    {
                        <fieldset class="admin-grid-toolbar-group eg-ops-group eg-ops-group-danger" style="border:0;padding:0;margin:0;min-width:0">
                            <legend class="visually-hidden">@GridDeleteSelectedButtonText</legend>
                            <button type="button" class="btn btn-danger btn-sm eg-ops-btn eg-ops-btn-danger" id="DeleteAll" title="@GridDeleteSelectedButtonText">
                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                <span>@AdminResource.Delete</span>
                            </button>
                        </fieldset>
                    }
                </div>
            </details>
        }

        <div id="ErrorMessagePanel" style="display: none;" class="alert alert-danger eg-ops-error">
            <span id="ErrorMessage"></span>
        </div>
    </div>
</div>
@* Bulk delete confirmation uses shared #adminDeleteConfirmModal via showDeleteConfirmation() *@
<span style="display:none;" id="AdminMultiSelectDeleteConfirmMessage">@AdminDeleteConfirmMessage</span>
@functions {

    private string GetProductStateResourceText(ProductState state)
    {
        switch (state)
        {
            case ProductState.NONE:
                return Resource.NONE;
            case ProductState.ProductInStock:
                return Resource.ProductInStock;
            case ProductState.ProductOutOfStock:
                return Resource.ProductOutOfStock;
            case ProductState.PreOrder:
                return Resource.PreOrderAvailable;
            case ProductState.Discontinued:
                return Resource.Discontinued;
            case ProductState.Backorder:
                return Resource.BackorderAvailable;
            case ProductState.ComingSoon:
                return Resource.ComingSoon;
            case ProductState.LimitedStock:
                return Resource.LimitedStockAvailable;
            case ProductState.Reserved:
                return Resource.ReservedForCustomers;
            case ProductState.AwaitingRestock:
                return Resource.AwaitingRestock;
            case ProductState.NotForSale:
                return Resource.NotForSale;
            default:
                throw new ArgumentOutOfRangeException("Unknown ProductState value:" + state);
        }
    }
}
