@{
    var tipText = ViewData["TipText"] as string ?? "";
    var tipPlacement = ViewData["TipPlacement"] as string ?? "top";
}
@if (!string.IsNullOrWhiteSpace(tipText))
{
    <button type="button"
            class="admin-field-tip"
            data-toggle="tooltip"
            data-placement="@tipPlacement"
            title="@tipText"
            aria-label="@tipText">
        <span class="glyphicon glyphicon-question-sign" aria-hidden="true"></span>
    </button>
}
