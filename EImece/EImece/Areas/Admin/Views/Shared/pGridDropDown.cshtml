@using System.Collections
@using System.Linq
@using Resources

@* Accepts any enumerable (BaseEntity lists, view-models, etc.). *@
@model IEnumerable

@{
    var GridResultRecordNumber = AdminResource.GridResultRecordNumber;
    int count = 0;
    if (Model != null)
    {
        var collection = Model as ICollection;
        count = collection != null ? collection.Count : Model.Cast<object>().Count();
    }
}

<output class="panel-heading grid-record-count" aria-live="polite">
    <div class="grid-record-count-inner">
        <span class="grid-record-count-badge">@count</span>
        <span class="grid-record-count-label">@GridResultRecordNumber</span>
    </div>
</output>
