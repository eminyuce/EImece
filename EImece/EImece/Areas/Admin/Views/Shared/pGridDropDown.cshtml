@using System.Collections
@using System.Linq
@using Resources

@* Accepts any enumerable (BaseEntity lists, view-models, etc.). *@
@model IEnumerable

@{
    var GridResultRecordNumber = AdminResource.GridResultRecordNumber;
    int count;
    if (Model == null)
    {
        count = 0;
    }
    else if (Model is ICollection collection)
    {
        count = collection.Count;
    }
    else
    {
        count = Model.Cast<object>().Count();
    }
}

<div class="panel-heading grid-record-count" role="status" aria-live="polite">
    <div class="grid-record-count-inner">
        <span class="grid-record-count-badge">@count</span>
        <span class="grid-record-count-label">@GridResultRecordNumber</span>
    </div>
</div>
