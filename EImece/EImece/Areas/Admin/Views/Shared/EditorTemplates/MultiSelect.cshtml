@using System
@using System.Linq
@using System.Xml.Linq
@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@model ProductSpecification

@{
    var field = Model != null ? Model.FieldFormat : null;
    var name = field != null ? field.Attribute("name") : null;
    var unit = field != null ? field.Attribute("unit") : null;
    var values = field != null ? field.Attribute("values") : null;
    var display = field != null ? field.Attribute("display") : null;
    var dbValue = Model != null ? Model.Value : null;
    var valueDisplayName = display != null ? display.Value : (name != null ? name.Value : "");
    var fieldKey = name != null ? name.Value : "";
    var listName = values != null ? values.Value : "";
    var tipText = string.IsNullOrEmpty(listName)
        ? "Çoklu seçim. Seçilen değerler virgülle ayrılmış olarak kaydedilir."
        : ("Çoklu seçim; seçenekler \"" + listName + "\" listesinden gelir. Kayıt: virgülle ayrılmış değerler.");
    var options = ProductSpecificationFieldHelper.ResolveOptions(listName, null);
    var listMissing = !string.IsNullOrEmpty(listName) && listName.IndexOf(',') < 0 && !options.Any();
    var selectedPreview = ProductSpecificationFieldHelper.NormalizeMultiSelectStorageValue(dbValue);
}

<div class="form-group">
    <div class="col-md-2">
        <span class="control-label" style="text-align:left;">
            @valueDisplayName
            <button type="button" class="admin-field-tip" data-toggle="tooltip" data-placement="top" title="@tipText" aria-label="@tipText">
                <span class="glyphicon glyphicon-question-sign" aria-hidden="true"></span>
            </button>
        </span>
        <div class="admin-spec-field-meta">çoklu seçim</div>
    </div>
    <div class="col-md-8">
        @if (options.Any())
        {
            <fieldset class="admin-spec-multiselect-list" style="border:0;padding:0;margin:0;min-width:0" data-spec-multiselect="@fieldKey">
                <legend class="sr-only">@valueDisplayName</legend>
                @foreach (var opt in options)
                {
                    var optId = "spec_" + fieldKey + "_" + (opt.Value ?? "").GetHashCode().ToString("x");
                    var isChecked = ProductSpecificationFieldHelper.IsValueSelected(dbValue, opt.Value);
                    <label class="admin-spec-multiselect-item" for="@optId">
                        <input id="@optId" type="checkbox" name="@fieldKey" value="@opt.Value"
                               @(isChecked ? "checked=\"checked\"" : null) title="@tipText" />
                        <span>@opt.Text</span>
                    </label>
                }
            </fieldset>
            <span class="admin-field-help">
                Kaydedilen biçim: <code>değer1, değer2</code>
                @if (!string.IsNullOrEmpty(selectedPreview))
                {
                    <text> · şu an: <strong>@selectedPreview</strong></text>
                }
            </span>
        }
        else
        {
            <div class="alert alert-warning" style="margin-bottom:0;">
                Seçenek yok. Şablonda <code>values</code> tanımlayın
                (<a href="@Url.Action("Index", "Lists")" target="_blank">Değer listeleri</a>
                veya virgüllü liste: <code>values="A, B, C"</code>).
            </div>
            if (listMissing)
            {
                <span class="admin-field-help">Liste bulunamadı: <code>@listName</code></span>
            }
        }
    </div>
    <div class="col-md-1">
        @if (unit != null)
        {
            <span class="help-block" style="margin-top:8px;">@unit.Value</span>
        }
    </div>
</div>
