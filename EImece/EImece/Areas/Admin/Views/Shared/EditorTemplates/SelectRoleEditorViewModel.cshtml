@using EImece.Models;
@using EImece.Domain;
@model SelectRoleEditorViewModel
@using Resources;
@{
    var isAdmin = Model.RoleName.Equals(Constants.AdministratorRole, StringComparison.InvariantCultureIgnoreCase);
    var isEditor = Model.RoleName.Equals(Constants.EditorRole, StringComparison.InvariantCultureIgnoreCase);

    string roleTitle;
    string roleDescription;

    if (isAdmin)
    {
        roleTitle = "Yönetici (Admin)";
        roleDescription = AdminResource.AdminUserRoleDescription;
    }
    else if (isEditor)
    {
        roleTitle = "Editör (NormalUser)";
        roleDescription = AdminResource.EditorUserRoleDescription;
    }
    else
    {
        roleTitle = Model.RoleName;
        roleDescription = Model.RoleName;
    }

    var selectedId = Html.IdFor(model => model.Selected);
}
@Html.HiddenFor(model => model.RoleName)
@Html.HiddenFor(model => model.RoleId)
<div class="form-check user-role-check">
    @Html.CheckBoxFor(model => model.Selected, new { @class = "form-check-input" })
    <label class="form-check-label" for="@selectedId">
        <span class="fw-semibold d-block">@roleTitle</span>
        <span class="text-muted small d-block">@roleDescription</span>
        <span class="badge text-bg-light border mt-1">@Model.RoleName</span>
    </label>
</div>
