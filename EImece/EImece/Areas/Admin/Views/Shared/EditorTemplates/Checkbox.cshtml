@using System
@using System.Xml.Linq
@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@model ProductSpecification

@{
    var field = Model.FieldFormat;
    var name = field != null ? field.Attribute("name") : null;
    var unit = field != null ? field.Attribute("unit") : null;
    var display = field != null ? field.Attribute("display") : null;
    var dbValue = Model.Value;
    var valueDisplayName = display != null ? display.Value : (name != null ? name.Value : "");
    var fieldKey = name != null ? name.Value : "";
    var tipText = "Evet/Hayır alanı. İşaretli = Evet (true), boş = Hayır (false).";
    var isChecked = ProductSpecificationValueHelper.IsTruthyCheckboxValue(dbValue);
}

<div class="form-group">
    <div class="col-md-2">
        <label class="control-label" for="spec_@fieldKey" style="text-align:left;">
            @valueDisplayName
            <button type="button" class="admin-field-tip" data-toggle="tooltip" data-placement="top" title="@tipText" aria-label="@tipText"><span class="glyphicon glyphicon-question-sign" aria-hidden="true"></span></button>
        </label>
        <div class="admin-spec-field-meta">evet / hayır</div>
    </div>
    <div class="col-md-5">
        <input id="spec_@fieldKey" name="@fieldKey" type="checkbox" value="true"
               @(isChecked ? "checked=\"checked\"" : null)
               title="@tipText" style="margin-top:8px;" />
        <span class="admin-field-help">İşaretli → sitede <strong>Evet</strong>. İşaretsiz → <strong>Hayır</strong>.</span>
    </div>
    <div class="col-md-1">
        @if (unit != null)
        {
            <span class="help-block" style="margin-top:8px;">@unit.Value</span>
        }
    </div>
</div>
