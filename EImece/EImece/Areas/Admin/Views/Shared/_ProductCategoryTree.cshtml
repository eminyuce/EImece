@using System.Web;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Models.FrontModels;
@model List<ProductCategoryTreeModel>
@{
    var treeNodes = Model ?? new List<ProductCategoryTreeModel>();
    String urlPattern = ViewData["UrlPattern"].ToStr();
    String urlQuery = ViewData["UrlQuery"].ToStr();
    var selectedCategoryId = ViewData["SelectedCategoryId"].ToInt();
    var showAllLink = ViewData["ShowAllLink"].ToBool(true);
    string querySuffix = string.IsNullOrEmpty(urlQuery) ? "" : "?" + urlQuery;

    var viewData = new ViewDataDictionary
    {
        { "UrlPattern", urlPattern },
        { "UrlQuery", urlQuery },
        { "SelectedCategoryId", selectedCategoryId },
        { "IsExcelButtonEnabled", true }
    };

    string allHref = string.IsNullOrEmpty(urlPattern)
        ? "#"
        : string.Format("{0}{1}{2}", urlPattern, 0, querySuffix);
    // Collapse by default on mobile unless a category is already selected.
    var mobileCollapsedClass = selectedCategoryId > 0 ? "" : "is-mobile-collapsed";
    var treeToggleExpanded = selectedCategoryId > 0 ? "true" : "false";
}
<div class="eg-category-tree @mobileCollapsedClass" data-eg-category-tree="1" data-selected-id="@selectedCategoryId">
    <div class="eg-category-tree-head">
        <button type="button"
                class="eg-category-tree-toggle"
                aria-expanded="@treeToggleExpanded"
                title="Kategori listesini aç/kapat">
            <span class="eg-category-tree-title">
                <i class="glyphicon glyphicon-folder-open" aria-hidden="true"></i>
                <span>Kategoriler</span>
            </span>
            <i class="glyphicon glyphicon-chevron-down eg-category-tree-chevron" aria-hidden="true"></i>
        </button>
        @if (showAllLink && !string.IsNullOrEmpty(urlPattern))
        {
            <a class="eg-category-all @(selectedCategoryId <= 0 ? "is-active" : "")" href="@allHref" title="Tüm ürünler">Tümü</a>
        }
    </div>

    <ul class="treeProducts eg-tree eg-category-tree-body" id="responsive">
        @foreach (ProductCategoryTreeModel p in treeNodes)
        {
            var productCategory = p.ProductCategory;
            var hasChildren = p.Childrens != null && p.Childrens.Any();
            var isActive = selectedCategoryId > 0 && productCategory != null && productCategory.Id == selectedCategoryId;
            var count = p.ProductCountAdmin;
            var name = productCategory != null ? productCategory.Name : p.AdminText;
            var nodeId = productCategory != null ? productCategory.Id : 0;
            <li class="eg-tree-node @(hasChildren ? "has-children is-open" : "is-leaf") @(isActive ? "is-active" : "")" data-category-id="@nodeId">
                <div class="eg-tree-row">
                    @if (hasChildren)
                    {
                        <button type="button" class="eg-tree-toggle" aria-expanded="true" aria-label="Alt kategorileri aç/kapat" title="Alt kategorileri aç/kapat">
                            <i class="glyphicon glyphicon-chevron-down" aria-hidden="true"></i>
                        </button>
                    }
                    else
                    {
                        <span class="eg-tree-toggle eg-tree-toggle-spacer" aria-hidden="true"></span>
                    }

                    @if (String.IsNullOrEmpty(urlPattern))
                    {
                        <a class="eg-tree-link @(isActive ? "is-active" : "")"
                           href="javascript:void(0)"
                           onclick="productTreeClick(event,@nodeId,'@HttpUtility.JavaScriptStringEncode(name)')">
                            <span class="eg-tree-name">@name</span>
                            @if (count > 0)
                            {
                                <span class="eg-tree-count">@count</span>
                            }
                        </a>
                    }
                    else
                    {
                        <a class="eg-tree-link @(isActive ? "is-active" : "")"
                           href="@String.Format("{0}{1}{2}", urlPattern, nodeId, querySuffix)">
                            <span class="eg-tree-name">@name</span>
                            @if (count > 0)
                            {
                                <span class="eg-tree-count">@count</span>
                            }
                        </a>
                    }
                </div>

                @if (hasChildren)
                {
                    @Html.Partial("_ProductCategoryTreeChildren", p.Childrens, viewData)
                }
            </li>
        }
    </ul>
</div>
