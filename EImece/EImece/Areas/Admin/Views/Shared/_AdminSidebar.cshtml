@using System.Linq;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers;
@using Resources;
@{
    var companyNameSetting = ViewBag.CompanyNameSetting as string ?? "";
    var currentController = ((string)ViewContext.RouteData.Values["controller"] ?? "").ToLowerInvariant();
    var currentAction = ((string)ViewContext.RouteData.Values["action"] ?? "").ToLowerInvariant();
    Setting isProductPriceEnable = ViewBag.IsProductPriceEnable;
    var productPriceEnabled = isProductPriceEnable == null || isProductPriceEnable.SettingValue.ToBool(true);

    Func<string, string> controllerActive = (controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    Func<string, string, string> actionActive = (controllerName, actionName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    Func<string[], bool> groupOpen = (controllers) =>
        controllers.Any(c => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase));

    var catalogControllers = productPriceEnabled
        ? new[] { "products", "productcategories", "brands", "templates", "lists", "coupons" }
        : new[] { "products", "productcategories", "brands", "templates", "lists" };
    var catalogOpen = groupOpen(catalogControllers);
    var salesOpen = productPriceEnabled && groupOpen(new[] { "orders", "customers", "shoppingcarts", "report" });
    var contentOpen = groupOpen(new[] { "menus", "mainpageimages", "stories", "storycategories", "tags", "tagcategories", "faq", "subscribers", "rssfeeds" });
    var systemOpen = groupOpen(new[] { "mailtemplates", "settings", "adminsettings", "users" })
        || (string.Equals(currentController, "dashboard", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "systemhealth", StringComparison.OrdinalIgnoreCase));
}
<aside class="admin-sidebar" id="adminSidebar" aria-label="@AdminResource.AdminNavigation" data-collapsed="false">
    <div class="admin-sidebar-brand">
        <a href="@Url.Action("Index", "Dashboard", new { area = "admin" })" title="@companyNameSetting">
            <i class="fa fa-cubes" aria-hidden="true"></i>
            <span class="admin-sidebar-brand-text">@companyNameSetting</span>
        </a>
        <button type="button"
                class="admin-sidebar-close"
                id="adminSidebarClose"
                aria-label="@AdminResource.CloseSidebar"
                title="@AdminResource.Close">
            <i class="fa fa-times" aria-hidden="true"></i>
        </button>
    </div>

    <nav class="admin-sidebar-nav">
        <a class="admin-nav-item @(actionActive("dashboard", "index"))"
           href="@Url.Action("Index", "Dashboard", new { area = "admin" })"
           title="@AdminResource.AdminHome">
            <i class="fa fa-home" aria-hidden="true"></i>
            <span class="admin-nav-label">@AdminResource.AdminHome</span>
        </a>
        <a class="admin-nav-item @(actionActive("dashboard", "oursitefeatures"))"
           href="@Url.Action("OurSiteFeatures", "Dashboard", new { area = "admin" })"
           title="@AdminResource.OurSiteFeatures">
            <i class="fa fa-book" aria-hidden="true"></i>
            <span class="admin-nav-label">@AdminResource.OurSiteFeatures</span>
        </a>
        <a class="admin-nav-item"
           href="/"
           target="_blank"
           rel="noopener noreferrer"
           title="@AdminResource.WebSite">
            <i class="fa fa-globe" aria-hidden="true"></i>
            <span class="admin-nav-label">@AdminResource.WebSite</span>
        </a>

        <!-- Small Admin Menu Search Box -->
        <div class="admin-sidebar-search" id="adminSidebarSearchContainer">
            <div class="admin-sidebar-search-inner" title="@AdminResource.SearchMenu">
                <i class="fa fa-search admin-sidebar-search-icon" aria-hidden="true"></i>
                <input type="text"
                       id="adminSidebarSearchInput"
                       class="admin-sidebar-search-input"
                       placeholder="@AdminResource.SearchMenu..."
                       autocomplete="off"
                       spellcheck="false"
                       aria-label="@AdminResource.SearchMenu" />
                <button type="button"
                        id="adminSidebarSearchClear"
                        class="admin-sidebar-search-clear"
                        title="@AdminResource.Clear"
                        aria-label="@AdminResource.Clear"
                        style="display: none;">
                    <i class="fa fa-times" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <div id="adminSidebarSearchEmpty" class="admin-sidebar-search-empty" style="display: none;">
            <i class="fa fa-info-circle" aria-hidden="true"></i> @AdminResource.NoMatchingMenuFound
        </div>

        <div class="admin-nav-group @(catalogOpen ? "is-open" : "")" data-group="catalog">
            <button type="button"
                    class="admin-nav-group-toggle"
                    aria-expanded="@(catalogOpen ? "true" : "false")"
                    title="@AdminResource.Catalog">
                <i class="fa fa-th-large" aria-hidden="true"></i>
                <span class="admin-nav-label">@AdminResource.Catalog</span>
                <i class="fa fa-chevron-down admin-nav-caret" aria-hidden="true"></i>
            </button>
            <div class="admin-nav-group-body">
                <a class="admin-nav-item @(controllerActive("products"))"
                   href="@Url.Action("Index", "Products", new { area = "admin" })"
                   title="@AdminResource.Products">
                    <i class="fa fa-cube" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.Products</span>
                </a>
                <a class="admin-nav-item @(controllerActive("productcategories"))"
                   href="@Url.Action("Index", "ProductCategories", new { area = "admin" })"
                   title="@AdminResource.ProductCategories">
                    <i class="fa fa-sitemap" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.ProductCategories</span>
                </a>
                <a class="admin-nav-item @(controllerActive("brands"))"
                   href="@Url.Action("Index", "Brands", new { area = "admin" })"
                   title="@AdminResource.Brands">
                    <i class="fa fa-tags" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.Brands</span>
                </a>
                <a class="admin-nav-item @(controllerActive("templates"))"
                   href="@Url.Action("Index", "Templates", new { area = "admin" })"
                   title="@AdminResource.ProductDynamicTemplates">
                    <i class="fa fa-file-code-o" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.ProductDynamicTemplates</span>
                </a>
                <a class="admin-nav-item @(controllerActive("lists"))"
                   href="@Url.Action("Index", "Lists", new { area = "admin" })"
                   title="@AdminResource.ProductSpecTemplateItemList">
                    <i class="fa fa-list-alt" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.ProductSpecTemplateItemList</span>
                </a>
                @if (productPriceEnabled)
                {
                    <a class="admin-nav-item @(controllerActive("coupons"))"
                       href="@Url.Action("Index", "Coupons", new { area = "admin" })"
                       title="@AdminResource.Coupons">
                        <i class="fa fa-ticket" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.Coupons</span>
                    </a>
                }
            </div>
        </div>

        @if (productPriceEnabled)
        {
            <div class="admin-nav-group @(salesOpen ? "is-open" : "")" data-group="sales">
                <button type="button"
                        class="admin-nav-group-toggle"
                        aria-expanded="@(salesOpen ? "true" : "false")"
                        title="@AdminResource.Sales">
                    <i class="fa fa-shopping-bag" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.Sales</span>
                    <i class="fa fa-chevron-down admin-nav-caret" aria-hidden="true"></i>
                </button>
                <div class="admin-nav-group-body">
                    <a class="admin-nav-item @(controllerActive("orders"))"
                       href="@Url.Action("Index", "Orders", new { area = "admin" })"
                       title="@AdminResource.Orders">
                        <i class="fa fa-shopping-bag" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.Orders</span>
                    </a>
                    <a class="admin-nav-item @(controllerActive("customers"))"
                       href="@Url.Action("Index", "Customers", new { area = "admin" })"
                       title="@AdminResource.Customers">
                        <i class="fa fa-users" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.Customers</span>
                    </a>
                    <a class="admin-nav-item @(controllerActive("shoppingcarts"))"
                       href="@Url.Action("Index", "ShoppingCarts", new { area = "admin" })"
                       title="@AdminResource.ShoppingCarts">
                        <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.ShoppingCarts</span>
                    </a>
                    <a class="admin-nav-item @(controllerActive("report"))"
                       href="@Url.Action("Index", "Report", new { area = "admin" })"
                       title="@AdminResource.Reports">
                        <i class="fa fa-bar-chart" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.Reports</span>
                    </a>
                </div>
            </div>
        }

        <div class="admin-nav-group @(contentOpen ? "is-open" : "")" data-group="content">
            <button type="button"
                    class="admin-nav-group-toggle"
                    aria-expanded="@(contentOpen ? "true" : "false")"
                    title="@AdminResource.Content">
                <i class="fa fa-file-text-o" aria-hidden="true"></i>
                <span class="admin-nav-label">@AdminResource.Content</span>
                <i class="fa fa-chevron-down admin-nav-caret" aria-hidden="true"></i>
            </button>
            <div class="admin-nav-group-body">
                <a class="admin-nav-item @(controllerActive("menus"))"
                   href="@Url.Action("Index", "Menus", new { area = "admin" })"
                   title="@AdminResource.Menus">
                    <i class="fa fa-bars" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.Menus</span>
                </a>
                <a class="admin-nav-item @(controllerActive("mainpageimages"))"
                   href="@Url.Action("Index", "MainPageImages", new { area = "admin" })"
                   title="@AdminResource.MainPageImages">
                    <i class="fa fa-picture-o" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.MainPageImages</span>
                </a>
                <a class="admin-nav-item @(controllerActive("stories"))"
                   href="@Url.Action("Index", "Stories", new { area = "admin" })"
                   title="@AdminResource.Stories">
                    <i class="fa fa-newspaper-o" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.Stories</span>
                </a>
                <a class="admin-nav-item @(controllerActive("storycategories"))"
                   href="@Url.Action("Index", "StoryCategories", new { area = "admin" })"
                   title="@AdminResource.StoryCategories">
                    <i class="fa fa-folder-open" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.StoryCategories</span>
                </a>
                <a class="admin-nav-item @(controllerActive("tags"))"
                   href="@Url.Action("Index", "Tags", new { area = "admin" })"
                   title="@AdminResource.Tags">
                    <i class="fa fa-tag" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.Tags</span>
                </a>
                <a class="admin-nav-item @(controllerActive("tagcategories"))"
                   href="@Url.Action("Index", "TagCategories", new { area = "admin" })"
                   title="@AdminResource.TagCategories">
                    <i class="fa fa-bookmark" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.TagCategories</span>
                </a>
                <a class="admin-nav-item @(controllerActive("faq"))"
                   href="@Url.Action("Index", "Faq", new { area = "admin" })"
                   title="@AdminResource.Faq">
                    <i class="fa fa-question-circle" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.Faq</span>
                </a>
                <a class="admin-nav-item @(controllerActive("subscribers"))"
                   href="@Url.Action("Index", "Subscribers", new { area = "admin" })"
                   title="@AdminResource.Subscribers">
                    <i class="fa fa-envelope" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.Subscribers</span>
                </a>
                <a class="admin-nav-item @(controllerActive("rssfeeds"))"
                   href="@Url.Action("Index", "RssFeeds", new { area = "admin" })"
                   title="@AdminResource.RssFeeds">
                    <i class="fa fa-rss" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.RssFeeds</span>
                </a>
            </div>
        </div>

        @if (UserRoleHelper.IsAdminManagementRoles())
        {
            <div class="admin-nav-group @(systemOpen ? "is-open" : "")" data-group="system">
                <button type="button"
                        class="admin-nav-group-toggle"
                        aria-expanded="@(systemOpen ? "true" : "false")"
                        title="@AdminResource.System">
                    <i class="fa fa-cogs" aria-hidden="true"></i>
                    <span class="admin-nav-label">@AdminResource.System</span>
                    <i class="fa fa-chevron-down admin-nav-caret" aria-hidden="true"></i>
                </button>
                <div class="admin-nav-group-body">
                    <a class="admin-nav-item @(controllerActive("mailtemplates"))"
                       href="@Url.Action("Index", "MailTemplates", new { area = "admin" })"
                       title="@AdminResource.MailTemplates">
                        <i class="fa fa-file-text-o" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.MailTemplates</span>
                    </a>
                    <a class="admin-nav-item @(actionActive("settings", "addwebsitelogo") != "" || actionActive("settings", "websitelogo") != "" ? "active" : "")"
                       href="@Url.Action("AddWebSiteLogo", "Settings", new { area = "admin" })"
                       title="@AdminResource.WebSiteLogo">
                        <i class="fa fa-image" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.WebSiteLogo</span>
                    </a>
                    <a class="admin-nav-item @actionActive("adminsettings", "index")"
                       href="@Url.Action("Index", "AdminSettings", new { area = "admin" })"
                       title="@AdminResource.AdminSettings">
                        <i class="fa fa-cogs" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.AdminSettings</span>
                    </a>
                    <a class="admin-nav-item @actionActive("adminsettings", "systemsettings")"
                       href="@Url.Action("SystemSettings", "AdminSettings", new { area = "admin" })"
                       title="@AdminResource.SystemSettings">
                        <i class="fa fa-sliders" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.SystemSettings</span>
                    </a>
                    <a class="admin-nav-item @actionActive("users", "index")"
                       href="@Url.Action("Index", "Users", new { area = "admin" })"
                       title="@AdminResource.UsersManagement">
                        <i class="fa fa-user" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.UsersManagement</span>
                    </a>
                    <a class="admin-nav-item @actionActive("users", "changepassword")"
                       href="@Url.Action("changepassword", "Users", new { area = "admin" })"
                       title="@AdminResource.ChangePassword">
                        <i class="fa fa-key" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.ChangePassword</span>
                    </a>
                    <a class="admin-nav-item @actionActive("users", "enableauthenticator")"
                       href="@Url.Action("EnableAuthenticator", "Users", new { area = "admin" })"
                       title="@AdminResource.Authenticator2FA">
                        <i class="fa fa-shield" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.Authenticator2FA</span>
                    </a>
                    <a class="admin-nav-item @actionActive("dashboard", "systemhealth")"
                       href="@Url.Action("SystemHealth", "Dashboard", new { area = "admin" })"
                       title="@AdminResource.SystemHealth">
                        <i class="fa fa-heartbeat" aria-hidden="true"></i>
                        <span class="admin-nav-label">@AdminResource.SystemHealth</span>
                    </a>
                </div>
            </div>
        }
    </nav>
</aside>
<div class="admin-sidebar-overlay" id="adminSidebarOverlay" aria-hidden="true"></div>
