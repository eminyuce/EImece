@using System.Linq;
@using EImece.Domain.Helpers;
@using Resources;
@{
    var companyNameSetting = ViewBag.CompanyNameSetting as string ?? "";
    var currentController = ((string)ViewContext.RouteData.Values["controller"] ?? "").ToLowerInvariant();
    var currentAction = ((string)ViewContext.RouteData.Values["action"] ?? "").ToLowerInvariant();

    Func<string, string> controllerActive = (controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    Func<string, string, string> actionActive = (controllerName, actionName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    Func<string[], bool> groupOpen = (controllers) =>
        controllers.Any(c => string.Equals(currentController, c, StringComparison.OrdinalIgnoreCase));

    var catalogOpen = groupOpen(new[] { "products", "productcategories", "brands", "templates", "lists", "coupons" });
    var salesOpen = groupOpen(new[] { "orders", "customers", "shoppingcarts", "report" });
    var contentOpen = groupOpen(new[] { "menus", "mainpageimages", "stories", "storycategories", "tags", "tagcategories", "faq", "subscribers" });
    var mediaOpen = groupOpen(new[] { "fileupload", "media", "images" });
    var systemOpen = groupOpen(new[] { "mailtemplates", "settings", "adminsettings", "metrics", "users" });
}
<aside class="admin-sidebar" id="adminSidebar" role="navigation" aria-label="Admin navigation">
    <div class="admin-sidebar-brand">
        <a href="@Url.Action("Index", "Dashboard", new { area = "admin" })" title="@companyNameSetting">
            <i class="fa fa-cubes" aria-hidden="true"></i>
            <span class="admin-sidebar-brand-text">@companyNameSetting</span>
        </a>
    </div>

    <nav class="admin-sidebar-nav">
        <div class="admin-nav-group">
            <div class="admin-nav-group-title">Dashboard</div>
            <ul>
                <li class="@controllerActive("dashboard")">
                    <a href="@Url.Action("Index", "Dashboard", new { area = "admin" })">
                        <i class="fa fa-home" aria-hidden="true"></i>
                        <span>@AdminResource.AdminHome</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="admin-nav-group @(catalogOpen ? "is-open" : "")">
            <div class="admin-nav-group-title">Catalog</div>
            <ul>
                <li class="@controllerActive("products")">
                    <a href="@Url.Action("Index", "Products", new { area = "admin" })">
                        <i class="fa fa-cube" aria-hidden="true"></i>
                        <span>@AdminResource.Products</span>
                    </a>
                </li>
                <li class="@controllerActive("productcategories")">
                    <a href="@Url.Action("Index", "ProductCategories", new { area = "admin" })">
                        <i class="fa fa-sitemap" aria-hidden="true"></i>
                        <span>@AdminResource.ProductCategories</span>
                    </a>
                </li>
                <li class="@controllerActive("brands")">
                    <a href="@Url.Action("Index", "Brands", new { area = "admin" })">
                        <i class="fa fa-tags" aria-hidden="true"></i>
                        <span>@AdminResource.Brands</span>
                    </a>
                </li>
                <li class="@controllerActive("templates")">
                    <a href="@Url.Action("Index", "Templates", new { area = "admin" })">
                        <i class="fa fa-file-code-o" aria-hidden="true"></i>
                        <span>@AdminResource.ProductDynamicTemplates</span>
                    </a>
                </li>
                <li class="@controllerActive("lists")">
                    <a href="@Url.Action("Index", "Lists", new { area = "admin" })">
                        <i class="fa fa-list-alt" aria-hidden="true"></i>
                        <span>@AdminResource.ProductSpecTemplateItemList</span>
                    </a>
                </li>
                <li class="@controllerActive("coupons")">
                    <a href="@Url.Action("Index", "Coupons", new { area = "admin" })">
                        <i class="fa fa-ticket" aria-hidden="true"></i>
                        <span>@AdminResource.Coupons</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="admin-nav-group @(salesOpen ? "is-open" : "")">
            <div class="admin-nav-group-title">Sales</div>
            <ul>
                <li class="@controllerActive("orders")">
                    <a href="@Url.Action("Index", "Orders", new { area = "admin" })">
                        <i class="fa fa-shopping-bag" aria-hidden="true"></i>
                        <span>@AdminResource.Orders</span>
                    </a>
                </li>
                <li class="@controllerActive("customers")">
                    <a href="@Url.Action("Index", "Customers", new { area = "admin" })">
                        <i class="fa fa-users" aria-hidden="true"></i>
                        <span>@AdminResource.Customers</span>
                    </a>
                </li>
                <li class="@controllerActive("shoppingcarts")">
                    <a href="@Url.Action("Index", "ShoppingCarts", new { area = "admin" })">
                        <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                        <span>Shopping Carts</span>
                    </a>
                </li>
                <li class="@controllerActive("report")">
                    <a href="@Url.Action("Index", "Report", new { area = "admin" })">
                        <i class="fa fa-bar-chart" aria-hidden="true"></i>
                        <span>@AdminResource.Reports</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="admin-nav-group @(contentOpen ? "is-open" : "")">
            <div class="admin-nav-group-title">Content</div>
            <ul>
                <li class="@controllerActive("menus")">
                    <a href="@Url.Action("Index", "Menus", new { area = "admin" })">
                        <i class="fa fa-bars" aria-hidden="true"></i>
                        <span>@AdminResource.Menus</span>
                    </a>
                </li>
                <li class="@controllerActive("mainpageimages")">
                    <a href="@Url.Action("Index", "MainPageImages", new { area = "admin" })">
                        <i class="fa fa-picture-o" aria-hidden="true"></i>
                        <span>@AdminResource.MainPageImages</span>
                    </a>
                </li>
                <li class="@controllerActive("stories")">
                    <a href="@Url.Action("Index", "Stories", new { area = "admin" })">
                        <i class="fa fa-newspaper-o" aria-hidden="true"></i>
                        <span>@AdminResource.Stories</span>
                    </a>
                </li>
                <li class="@controllerActive("storycategories")">
                    <a href="@Url.Action("Index", "StoryCategories", new { area = "admin" })">
                        <i class="fa fa-folder-open" aria-hidden="true"></i>
                        <span>@AdminResource.StoryCategories</span>
                    </a>
                </li>
                <li class="@controllerActive("tags")">
                    <a href="@Url.Action("Index", "Tags", new { area = "admin" })">
                        <i class="fa fa-tag" aria-hidden="true"></i>
                        <span>@AdminResource.Tags</span>
                    </a>
                </li>
                <li class="@controllerActive("tagcategories")">
                    <a href="@Url.Action("Index", "TagCategories", new { area = "admin" })">
                        <i class="fa fa-bookmark" aria-hidden="true"></i>
                        <span>@AdminResource.TagCategories</span>
                    </a>
                </li>
                <li class="@controllerActive("faq")">
                    <a href="@Url.Action("Index", "Faq", new { area = "admin" })">
                        <i class="fa fa-question-circle" aria-hidden="true"></i>
                        <span>@AdminResource.Faq</span>
                    </a>
                </li>
                <li class="@controllerActive("subscribers")">
                    <a href="@Url.Action("Index", "Subscribers", new { area = "admin" })">
                        <i class="fa fa-envelope" aria-hidden="true"></i>
                        <span>@AdminResource.Subscribers</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="admin-nav-group @(mediaOpen ? "is-open" : "")">
            <div class="admin-nav-group-title">Media</div>
            <ul>
                <li class="@controllerActive("fileupload")">
                    <a href="@Url.Action("Index", "FileUpload", new { area = "admin" })">
                        <i class="fa fa-upload" aria-hidden="true"></i>
                        <span>@AdminResource.FileUploadingPage</span>
                    </a>
                </li>
            </ul>
        </div>

        @if (UserRoleHelper.IsAdminManagementRoles())
        {
            <div class="admin-nav-group @(systemOpen ? "is-open" : "")">
                <div class="admin-nav-group-title">System</div>
                <ul>
                    <li class="@controllerActive("mailtemplates")">
                        <a href="@Url.Action("Index", "MailTemplates", new { area = "admin" })">
                            <i class="fa fa-file-text-o" aria-hidden="true"></i>
                            <span>@AdminResource.MailTemplates</span>
                        </a>
                    </li>
                    <li class="@(actionActive("settings", "addwebsitelogo") != "" || actionActive("settings", "websitelogo") != "" ? "active" : "")">
                        <a href="@Url.Action("AddWebSiteLogo", "Settings", new { area = "admin" })">
                            <i class="fa fa-image" aria-hidden="true"></i>
                            <span>@AdminResource.WebSiteLogo</span>
                        </a>
                    </li>
                    <li class="@actionActive("adminsettings", "index")">
                        <a href="@Url.Action("Index", "AdminSettings", new { area = "admin" })">
                            <i class="fa fa-cogs" aria-hidden="true"></i>
                            <span>@AdminResource.AdminSettings</span>
                        </a>
                    </li>
                    <li class="@actionActive("adminsettings", "systemsettings")">
                        <a href="@Url.Action("SystemSettings", "AdminSettings", new { area = "admin" })">
                            <i class="fa fa-sliders" aria-hidden="true"></i>
                            <span>@AdminResource.SystemSettings</span>
                        </a>
                    </li>
                    <li class="@controllerActive("metrics")">
                        <a href="@Url.Action("Index", "Metrics", new { area = "admin" })">
                            <i class="fa fa-line-chart" aria-hidden="true"></i>
                            <span>Metrics</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "Health", new { area = "" })" target="_blank" rel="noopener noreferrer">
                            <i class="fa fa-heartbeat" aria-hidden="true"></i>
                            <span>Health</span>
                        </a>
                    </li>
                    <li class="@actionActive("users", "index")">
                        <a href="@Url.Action("Index", "Users", new { area = "admin" })">
                            <i class="fa fa-user" aria-hidden="true"></i>
                            <span>@AdminResource.UsersManagement</span>
                        </a>
                    </li>
                    <li class="@actionActive("users", "changepassword")">
                        <a href="@Url.Action("changepassword", "Users", new { area = "admin" })">
                            <i class="fa fa-key" aria-hidden="true"></i>
                            <span>@AdminResource.ChangePassword</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </nav>
</aside>
<div class="admin-sidebar-overlay" id="adminSidebarOverlay" aria-hidden="true"></div>
