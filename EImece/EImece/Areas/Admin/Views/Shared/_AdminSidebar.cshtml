@using EImece.Domain.Entities;
@using EImece.Domain.Helpers;
@using Microsoft.AspNet.Identity;
@using Resources;
@{
    var currentController = ((string)ViewContext.RouteData.Values["controller"] ?? "").ToLowerInvariant();
    var currentAction = ((string)ViewContext.RouteData.Values["action"] ?? "").ToLowerInvariant();
    Setting isProductPriceEnable = ViewBag.IsProductPriceEnable;
    var productPriceEnabled = isProductPriceEnable == null || isProductPriceEnable.SettingValue.ToBool(true);
    Setting isProductReviewEnable = ViewBag.IsProductReviewEnable;
    var productReviewEnabled = isProductReviewEnable == null || isProductReviewEnable.SettingValue.ToBool(true);
    var isAdminRole = UserRoleHelper.IsAdminManagementRoles();

    var userName = User.Identity.GetUserName() ?? "";
    var displayName = userName;
    var atIndex = userName.IndexOf('@');
    if (atIndex > 0)
    {
        displayName = userName.Substring(0, atIndex);
    }
    var initials = "";
    if (!string.IsNullOrWhiteSpace(displayName))
    {
        var parts = displayName.Split(new[] { '.', '_', '-', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            initials = (parts[0].Substring(0, 1) + parts[1].Substring(0, 1)).ToUpperInvariant();
        }
        else
        {
            initials = displayName.Substring(0, Math.Min(2, displayName.Length)).ToUpperInvariant();
        }
    }

    Func<string, string> controllerActive = (controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    Func<string, string, string> actionActive = (controllerName, actionName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    var overviewCount = 3;
    var catalogCount = 5 + (productPriceEnabled ? 1 : 0) + (productReviewEnabled ? 1 : 0);
    var salesCount = 4;
    var contentCount = 9;
    var userManagementCount = isAdminRole ? 4 : 2;
    var systemCount = 5;
}

@helper MegaItem(string href, string title, string icon, string activeClass, string target = null)
{
    if (!string.IsNullOrEmpty(target))
    {
        <a class="admin-mega-item @activeClass" href="@href" title="@title" target="@target" rel="noopener noreferrer" @(activeClass == "active" ? "aria-current=\"page\"" : null)>
            <i class="fa @icon" aria-hidden="true"></i>
            <span>@title</span>
        </a>
    }
    else
    {
        <a class="admin-mega-item @activeClass" href="@href" title="@title" @(activeClass == "active" ? "aria-current=\"page\"" : null)>
            <i class="fa @icon" aria-hidden="true"></i>
            <span>@title</span>
        </a>
    }
}

<div class="admin-mega-menu" id="adminMegaMenu" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="adminMegaMenuTitle">
    <div class="admin-mega-dialog">
        <header class="admin-mega-header">
            <div class="admin-mega-user">
                <span class="admin-mega-avatar" aria-hidden="true">@initials</span>
                <div class="admin-mega-user-text">
                    <div class="admin-mega-user-row">
                        <span class="admin-mega-user-name" id="adminMegaMenuTitle">@displayName</span>
                        @if (isAdminRole)
                        {
                            <span class="admin-mega-role">@AdminResource.AdminBadge</span>
                        }
                    </div>
                    <div class="admin-mega-user-email">@userName</div>
                </div>
            </div>
            <div class="admin-mega-header-actions">
                <a class="admin-mega-header-btn"
                   href="@Url.Action("changepassword", "Users", new { area = "admin" })">
                    <i class="fa fa-user" aria-hidden="true"></i>
                    @AdminResource.Profile
                </a>
                @if (isAdminRole)
                {
                    <a class="admin-mega-header-btn"
                       href="@Url.Action("Index", "Users", new { area = "admin" })">
                        <i class="fa fa-check-square-o" aria-hidden="true"></i>
                        @AdminResource.Users
                    </a>
                }
                else
                {
                    <a class="admin-mega-header-btn"
                       href="@Url.Action("EnableAuthenticator", "Users", new { area = "admin" })">
                        <i class="fa fa-shield" aria-hidden="true"></i>
                        @AdminResource.Authenticator2FA
                    </a>
                }
                <a class="admin-mega-logout"
                   href="javascript:document.getElementById('logoutForm').submit()"
                   title="@AdminResource.Logout">
                    <i class="fa fa-power-off" aria-hidden="true"></i>
                    @AdminResource.Logout
                </a>
                <button type="button"
                        class="admin-mega-header-btn admin-mega-header-btn--icon"
                        id="adminMegaMenuClose"
                        aria-label="@AdminResource.CloseMenu"
                        title="@AdminResource.CloseMenu">
                    <i class="fa fa-times" aria-hidden="true"></i>
                </button>
            </div>
        </header>

        <div class="admin-mega-search" id="adminSidebarSearchContainer">
            <div class="admin-mega-search-inner">
                <i class="fa fa-search admin-mega-search-icon" aria-hidden="true"></i>
                <input type="text"
                       id="adminSidebarSearchInput"
                       class="admin-mega-search-input form-control"
                       placeholder="@AdminResource.SearchAdminTools"
                       autocomplete="off"
                       spellcheck="false"
                       aria-label="@AdminResource.SearchAdminTools" />
                <button type="button"
                        id="adminSidebarSearchClear"
                        class="admin-mega-search-clear"
                        title="@AdminResource.Clear"
                        aria-label="@AdminResource.Clear"
                        style="display: none;">
                    <i class="fa fa-times" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <div class="admin-mega-body">
            <div id="adminSidebarSearchEmpty" class="admin-mega-empty" style="display: none;">
                <i class="fa fa-info-circle" aria-hidden="true"></i> @AdminResource.NoMatchingMenuFound
            </div>
            <div class="admin-mega-grid">
                <section class="admin-mega-card admin-mega-card--overview" data-mega-group="overview">
                    <header class="admin-mega-card-head">
                        <span class="admin-mega-card-icon"><i class="fa fa-home" aria-hidden="true"></i></span>
                        <h3 class="admin-mega-card-title">@AdminResource.AdminHome</h3>
                        <span class="admin-mega-count">@overviewCount</span>
                    </header>
                    <div class="admin-mega-card-body">
                        @MegaItem(Url.Action("Index", "Dashboard", new { area = "admin" }), AdminResource.AdminHome, "fa-home", actionActive("dashboard", "index"))
                        @MegaItem(Url.Action("OurSiteFeatures", "Dashboard", new { area = "admin" }), AdminResource.OurSiteFeatures, "fa-book", actionActive("dashboard", "oursitefeatures"))
                        @MegaItem("/", AdminResource.WebSite, "fa-globe", "", "_blank")
                    </div>
                </section>

                <section class="admin-mega-card admin-mega-card--catalog" data-mega-group="catalog">
                    <header class="admin-mega-card-head">
                        <span class="admin-mega-card-icon"><i class="fa fa-th-large" aria-hidden="true"></i></span>
                        <h3 class="admin-mega-card-title">@AdminResource.Catalog</h3>
                        <span class="admin-mega-count">@catalogCount</span>
                    </header>
                    <div class="admin-mega-card-body">
                        @MegaItem(Url.Action("Index", "Products", new { area = "admin" }), AdminResource.Products, "fa-cube", controllerActive("products"))
                        @MegaItem(Url.Action("Index", "ProductCategories", new { area = "admin" }), AdminResource.ProductCategories, "fa-sitemap", controllerActive("productcategories"))
                        @MegaItem(Url.Action("Index", "Brands", new { area = "admin" }), AdminResource.Brands, "fa-tags", controllerActive("brands"))
                        @if (productReviewEnabled)
                        {
                            @MegaItem(Url.Action("Index", "ProductComments", new { area = "admin" }), AdminResource.ProductComments, "fa-comments", controllerActive("productcomments"))
                        }
                        @MegaItem(Url.Action("Index", "Templates", new { area = "admin" }), AdminResource.ProductDynamicTemplates, "fa-file-code-o", controllerActive("templates"))
                        @MegaItem(Url.Action("Index", "Lists", new { area = "admin" }), AdminResource.ProductSpecTemplateItemList, "fa-list-alt", controllerActive("lists"))
                        @if (productPriceEnabled)
                        {
                            @MegaItem(Url.Action("Index", "Coupons", new { area = "admin" }), AdminResource.Coupons, "fa-ticket", controllerActive("coupons"))
                        }
                    </div>
                </section>

                @if (productPriceEnabled)
                {
                    <section class="admin-mega-card admin-mega-card--sales" data-mega-group="sales">
                        <header class="admin-mega-card-head">
                            <span class="admin-mega-card-icon"><i class="fa fa-shopping-bag" aria-hidden="true"></i></span>
                            <h3 class="admin-mega-card-title">@AdminResource.Sales</h3>
                            <span class="admin-mega-count">@salesCount</span>
                        </header>
                        <div class="admin-mega-card-body">
                            @MegaItem(Url.Action("Index", "Orders", new { area = "admin" }), AdminResource.Orders, "fa-shopping-bag", controllerActive("orders"))
                            @MegaItem(Url.Action("Index", "Customers", new { area = "admin" }), AdminResource.Customers, "fa-users", controllerActive("customers"))
                            @MegaItem(Url.Action("Index", "ShoppingCarts", new { area = "admin" }), AdminResource.ShoppingCarts, "fa-shopping-cart", controllerActive("shoppingcarts"))
                            @MegaItem(Url.Action("Index", "Report", new { area = "admin" }), AdminResource.Reports, "fa-bar-chart", controllerActive("report"))
                        </div>
                    </section>
                }

                <section class="admin-mega-card admin-mega-card--content" data-mega-group="content">
                    <header class="admin-mega-card-head">
                        <span class="admin-mega-card-icon"><i class="fa fa-file-text-o" aria-hidden="true"></i></span>
                        <h3 class="admin-mega-card-title">@AdminResource.Content</h3>
                        <span class="admin-mega-count">@contentCount</span>
                    </header>
                    <div class="admin-mega-card-body">
                        @MegaItem(Url.Action("Index", "Menus", new { area = "admin" }), AdminResource.Menus, "fa-bars", controllerActive("menus"))
                        @MegaItem(Url.Action("Index", "MainPageImages", new { area = "admin" }), AdminResource.MainPageImages, "fa-picture-o", controllerActive("mainpageimages"))
                        @MegaItem(Url.Action("Index", "Stories", new { area = "admin" }), AdminResource.Stories, "fa-newspaper-o", controllerActive("stories"))
                        @MegaItem(Url.Action("Index", "StoryCategories", new { area = "admin" }), AdminResource.StoryCategories, "fa-folder-open", controllerActive("storycategories"))
                        @MegaItem(Url.Action("Index", "Tags", new { area = "admin" }), AdminResource.Tags, "fa-tag", controllerActive("tags"))
                        @MegaItem(Url.Action("Index", "TagCategories", new { area = "admin" }), AdminResource.TagCategories, "fa-bookmark", controllerActive("tagcategories"))
                        @MegaItem(Url.Action("Index", "Faq", new { area = "admin" }), AdminResource.Faq, "fa-question-circle", controllerActive("faq"))
                        @MegaItem(Url.Action("Index", "Subscribers", new { area = "admin" }), AdminResource.Subscribers, "fa-envelope", controllerActive("subscribers"))
                        @MegaItem(Url.Action("Index", "RssFeeds", new { area = "admin" }), AdminResource.RssFeeds, "fa-rss", controllerActive("rssfeeds"))
                    </div>
                </section>

                <section class="admin-mega-card admin-mega-card--users" data-mega-group="users">
                    <header class="admin-mega-card-head">
                        <span class="admin-mega-card-icon"><i class="fa fa-users" aria-hidden="true"></i></span>
                        <h3 class="admin-mega-card-title">@AdminResource.UsersManagement</h3>
                        <span class="admin-mega-count">@userManagementCount</span>
                    </header>
                    <div class="admin-mega-card-body">
                        @if (isAdminRole)
                        {
                            @MegaItem(Url.Action("Index", "Users", new { area = "admin" }), AdminResource.Users, "fa-user", actionActive("users", "index") != "" || actionActive("users", "edit") != "" || actionActive("users", "register") != "" || actionActive("users", "userroles") != "" ? "active" : "")
                            @MegaItem(Url.Action("CustomerRoles", "Users", new { area = "admin" }), AdminResource.CustomersWithAccounts, "fa-users", actionActive("users", "customerroles"))
                        }
                        @MegaItem(Url.Action("changepassword", "Users", new { area = "admin" }), AdminResource.ChangePassword, "fa-key", actionActive("users", "changepassword"))
                        @MegaItem(Url.Action("EnableAuthenticator", "Users", new { area = "admin" }), AdminResource.Authenticator2FA, "fa-shield", actionActive("users", "enableauthenticator"))
                    </div>
                </section>

                @if (isAdminRole)
                {
                    <section class="admin-mega-card admin-mega-card--system" data-mega-group="system">
                        <header class="admin-mega-card-head">
                            <span class="admin-mega-card-icon"><i class="fa fa-cogs" aria-hidden="true"></i></span>
                            <h3 class="admin-mega-card-title">@AdminResource.System</h3>
                            <span class="admin-mega-count">@systemCount</span>
                        </header>
                        <div class="admin-mega-card-body">
                            @MegaItem(Url.Action("Index", "MailTemplates", new { area = "admin" }), AdminResource.MailTemplates, "fa-file-text-o", controllerActive("mailtemplates"))
                            @MegaItem(Url.Action("AddWebSiteLogo", "Settings", new { area = "admin" }), AdminResource.WebSiteLogo, "fa-image", actionActive("settings", "addwebsitelogo") != "" || actionActive("settings", "websitelogo") != "" ? "active" : "")
                            @MegaItem(Url.Action("Index", "AdminSettings", new { area = "admin" }), AdminResource.AdminSettings, "fa-cogs", actionActive("adminsettings", "index"))
                            @MegaItem(Url.Action("SystemSettings", "AdminSettings", new { area = "admin" }), AdminResource.SystemSettings, "fa-sliders", actionActive("adminsettings", "systemsettings"))
                            @MegaItem(Url.Action("SystemHealth", "Dashboard", new { area = "admin" }), AdminResource.SystemHealth, "fa-heartbeat", actionActive("dashboard", "systemhealth"))
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>
</div>
<div class="admin-sidebar-overlay" id="adminSidebarOverlay" aria-hidden="true"></div>
