@model EImece.Domain.Entities.BaseContent
@using EImece.Domain
@using EImece.Domain.Helpers
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Helpers.HtmlHelpers
@using Resources
@{
    var o = Model;
    var hasImage = FilesHelper.IsMainImageExists(o.MainImageId, o.MainImage);
    var thumbUrl = hasImage ? o.GetCroppedImageUrl(o.MainImageId, 72, 72, false, true) : "";
    bool showImageState = ViewData["ShowImageState"].ToBool(true);
}
<div class="eg-image-cell">
    <div class="eg-thumb @(hasImage ? "" : "is-placeholder")" title="@(hasImage ? "" : AdminResource.NoImage)">
        @if (hasImage && !string.IsNullOrEmpty(thumbUrl))
        {
            <img src="@thumbUrl" alt="" width="48" height="48" loading="lazy" />
        }
        else
        {
            <span class="eg-thumb-placeholder" aria-hidden="true">
                <i class="fa fa-picture-o"></i>
            </span>
        }
    </div>
    @if (showImageState)
    {
        <div class="eg-image-meta">
            @Html.GridStatusToggle(o.Id, o.ImageState, "ImageState", AdminResource.ImageState, AdminResource.ImageShort)
            @Html.Partial("pGridImageMainPage", o, new ViewDataDictionary(ViewData) { { "ShowRemoveImage", false }, { "ShowExistingLabel", false } })
        </div>
    }
</div>
