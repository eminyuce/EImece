@model EImece.Domain.Entities.Product
@using EImece.Web.Helpers.HtmlHelpers
@using Resources
@{
    var o = Model;
}
@Html.GridStatusToggleGroupOpen()
@Html.GridStatusToggle(o.Id, o.IsActive, "State", AdminResource.IsActive, AdminResource.PublishedShort)
@Html.GridStatusToggle(o.Id, o.MainPage, "MainPage", AdminResource.MainPage, AdminResource.MainPageShort)
@Html.GridStatusToggle(o.Id, o.IsCampaign, "IsCampaign", AdminResource.IsCampaign, AdminResource.CampaignShort)
@Html.GridStatusToggleGroupClose()
