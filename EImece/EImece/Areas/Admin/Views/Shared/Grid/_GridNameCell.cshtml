@model EImece.Domain.Entities.Product
@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Helpers.HtmlHelpers
@using Resources
@{
    var product = Model;
    string name;
    string itemId;
    string linkUrl = null;
    string subName = null;

    if (product != null)
    {
        name = product.Name;
        itemId = product.Id.ToString();
        var categoryName = product.ProductCategory != null ? product.ProductCategory.Name : "";
        var seoCategory = GeneralHelper.GetUrlSeoString(categoryName);
        linkUrl = Url.Action("Detail", "Products", new { area = "", categoryName = seoCategory, id = product.GetSeoUrl() });
        if (!string.IsNullOrEmpty(product.NameLong)
            && !string.Equals(product.NameLong.Trim(), (product.Name ?? "").Trim(), StringComparison.OrdinalIgnoreCase))
        {
            subName = product.NameLong;
        }
    }
    else
    {
        name = ViewData["Name"].ToStr();
        itemId = ViewData["ItemId"].ToStr();
        linkUrl = ViewData["LinkUrl"].ToStr();
        subName = ViewData["SubName"].ToStr();
    }
}
<div class="eg-name-cell">
    @if (!string.IsNullOrEmpty(linkUrl))
    {
        <a class="eg-name-link" href="@linkUrl" target="_blank" rel="noopener">@name</a>
    }
    else
    {
        <span class="eg-name-link">@name</span>
    }
    <div class="eg-name-meta">
        @Html.GridMeta("ID", itemId)
        @if (product != null && !string.IsNullOrEmpty(product.ProductCode))
        {
            @Html.GridMeta(AdminResource.ProductCode, product.ProductCode)
        }
    </div>
    @if (!string.IsNullOrEmpty(subName))
    {
        <div class="eg-name-sub">@subName</div>
    }
</div>
