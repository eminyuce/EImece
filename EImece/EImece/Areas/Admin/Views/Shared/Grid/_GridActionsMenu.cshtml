@model object
@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using EImece.Domain.Helpers.Extensions
@using Resources
@{
    var product = Model as Product;
    var controllerName = ViewData["controllerName"].ToStr("Products");
    var itemId = product != null ? product.Id.ToString() : ViewData["ItemId"].ToStr();
    var itemName = product != null ? product.Name : ViewData["ItemName"].ToStr();

    var showMedia = ViewData.ContainsKey("ShowMedia") ? ViewData["ShowMedia"].ToBool() : product != null;
    var showEdit = ViewData.ContainsKey("ShowEdit") ? ViewData["ShowEdit"].ToBool() : true;
    var showDelete = ViewData.ContainsKey("ShowDelete") ? ViewData["ShowDelete"].ToBool() : true;

    var detailUrl = ViewData["DetailUrl"].ToStr();
    var detailText = ViewData["DetailText"].ToStr(AdminResource.GridDetailText);
    var ordersUrl = ViewData["OrdersUrl"].ToStr();
    var ordersText = ViewData["OrdersText"].ToStr();

    var editAction = ViewData["EditAction"].ToStr("SaveOrEdit");
    var editUrl = ViewData["EditUrl"].ToStr();
    if (string.IsNullOrEmpty(editUrl) && showEdit)
    {
        editUrl = Url.Action(editAction, controllerName, new { id = itemId });
    }

    var forgotPasswordUrl = ViewData["ForgotPasswordUrl"].ToStr();
    var newPasswordUrl = ViewData["NewPasswordUrl"].ToStr();
    var rolesUrl = ViewData["RolesUrl"].ToStr();
    var unlockUrl = ViewData["UnlockUrl"].ToStr();

    var hasSpecs = product != null
        && product.ProductCategory != null
        && product.ProductCategory.TemplateId.HasValue
        && product.ProductCategory.TemplateId > 0;
    var productReviewEnabled = true;
    var reviewSetting = ViewBag.IsProductReviewEnable as Setting;
    if (reviewSetting != null)
    {
        productReviewEnabled = reviewSetting.SettingValue.ToBool(true);
    }
    var hasComments = productReviewEnabled && product != null && product.ProductComments.IsNotEmpty();
    var hasDelete = showDelete && UserRoleHelper.IsDeletedEnableRoles();
    var hasEdit = showEdit && !string.IsNullOrEmpty(editUrl);
    var actionCount = 0;
    if (!string.IsNullOrEmpty(detailUrl)) { actionCount++; }
    if (!string.IsNullOrEmpty(ordersUrl)) { actionCount++; }
    if (showMedia) { actionCount++; }
    if (hasEdit) { actionCount++; }
    if (hasSpecs) { actionCount++; }
    if (hasComments) { actionCount++; }
    if (!string.IsNullOrEmpty(forgotPasswordUrl)) { actionCount++; }
    if (!string.IsNullOrEmpty(newPasswordUrl)) { actionCount++; }
    if (!string.IsNullOrEmpty(rolesUrl)) { actionCount++; }
    if (!string.IsNullOrEmpty(unlockUrl)) { actionCount++; }
    if (hasDelete) { actionCount++; }
    var isSingleAction = actionCount == 1;
    var hasMenuItems = actionCount > 0;

    var deleteMenuVd = new ViewDataDictionary(ViewData);
    deleteMenuVd["ItemId"] = itemId;
    deleteMenuVd["controllerName"] = controllerName;
    deleteMenuVd["DeleteIcon"] = "";
    deleteMenuVd["ItemDescription"] = itemName;
    deleteMenuVd["gridDeleteText"] = ViewData["gridDeleteText"].ToStr(AdminResource.GridDeleteText);

    var deleteCompactVd = new ViewDataDictionary(ViewData);
    deleteCompactVd["ItemId"] = itemId;
    deleteCompactVd["controllerName"] = controllerName;
    deleteCompactVd["DeleteIcon"] = "btn btn-danger btn-sm fa fa-times-circle";
    deleteCompactVd["ItemDescription"] = itemName;
    deleteCompactVd["gridDeleteText"] = ViewData["gridDeleteText"].ToStr(AdminResource.GridDeleteText);
}
@if (hasMenuItems)
{
if (!isSingleAction)
{
<div class="eg-actions btn-group">
    <button type="button"
            class="btn btn-secondary btn-sm dropdown-toggle eg-actions-toggle"
            data-bs-toggle="dropdown"
            data-bs-display="static"
            aria-haspopup="true"
            aria-expanded="false">
        <i class="fa fa-cog" aria-hidden="true"></i>
        <span>@AdminResource.Actions</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end eg-actions-menu">
        @if (!string.IsNullOrEmpty(detailUrl))
        {
            <li>
                <a class="dropdown-item" href="@detailUrl">
                    <i class="fa fa-info-circle"></i> @detailText
                </a>
            </li>
        }
        @if (!string.IsNullOrEmpty(ordersUrl))
        {
            <li>
                <a class="dropdown-item" href="@ordersUrl">
                    <i class="fa fa-shopping-cart"></i> @ordersText
                </a>
            </li>
        }
        @if (showMedia)
        {
            <li>
                <a class="dropdown-item" href="@Url.Action("Media", controllerName, new { Id = itemId })">
                    <i class="fa fa-camera"></i> @AdminResource.GridImagesText
                </a>
            </li>
        }
        @if (hasEdit)
        {
            <li>
                <a class="dropdown-item" href="@editUrl">
                    <i class="fa fa-pencil"></i> @AdminResource.GridEditText
                </a>
            </li>
        }
        @if (hasSpecs)
        {
            <li>
                <a class="dropdown-item" href="@Url.Action("SaveOrEditProductSpecs", controllerName, new { Id = itemId })"
                   title="@AdminResource.ProductSpecs">
                    <i class="fa fa-plus"></i> @AdminResource.ProductSpecs
                </a>
            </li>
        }
        @if (hasComments)
        {
            <li>
                <a class="dropdown-item" href="@Url.Action("Index", "ProductComments", new { Id = itemId })">
                    <i class="fa fa-user"></i> @AdminResource.Comments
                </a>
            </li>
        }
        @if (!string.IsNullOrEmpty(forgotPasswordUrl))
        {
            <li>
                <a class="dropdown-item" href="@forgotPasswordUrl">
                    <i class="fa fa-envelope"></i> @AdminResource.ForgotPassword
                </a>
            </li>
        }
        @if (!string.IsNullOrEmpty(newPasswordUrl))
        {
            <li>
                <a class="dropdown-item" href="@newPasswordUrl">
                    <i class="fa fa-lock"></i> @AdminResource.NewPassword
                </a>
            </li>
        }
        @if (!string.IsNullOrEmpty(rolesUrl))
        {
            <li>
                <a class="dropdown-item" href="@rolesUrl">
                    <i class="fa fa-user"></i> @AdminResource.Roles
                </a>
            </li>
        }
        @if (!string.IsNullOrEmpty(unlockUrl))
        {
            <li>
                <form action="@unlockUrl" method="post" class="eg-unlock-form">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="dropdown-item text-warning"
                            onclick="return confirm('@AdminResource.UnlockAccountConfirm');">
                        <i class="fa fa-unlock"></i> @AdminResource.UnlockAccount
                    </button>
                </form>
            </li>
        }
        @if (hasDelete)
        {
            <li><hr class="dropdown-divider" /></li>
            <li class="eg-actions-danger">
                @Html.Partial("pDeleteModal", deleteMenuVd)
            </li>
        }
    </ul>
</div>
}
<div class="eg-actions-compact@(isSingleAction ? " eg-actions-single" : "")" aria-hidden="@(isSingleAction ? "false" : "true")">
    @if (!string.IsNullOrEmpty(detailUrl))
    {
        <a href="@detailUrl" class="btn btn-info btn-sm" title="@detailText">
            <i class="fa fa-info-circle"></i>
        </a>
    }
    @if (!string.IsNullOrEmpty(ordersUrl))
    {
        <a href="@ordersUrl" class="btn btn-success btn-sm" title="@ordersText">
            <i class="fa fa-shopping-cart"></i>
        </a>
    }
    @if (showMedia)
    {
        <a href="@Url.Action("Media", controllerName, new { Id = itemId })"
           class="btn btn-secondary btn-sm" title="@AdminResource.GridImagesText">
            <i class="fa fa-camera"></i>
        </a>
    }
    @if (hasEdit)
    {
        <a href="@editUrl" class="btn btn-primary btn-sm" title="@AdminResource.GridEditText">
            <i class="fa fa-pencil"></i>
            @if (isSingleAction)
            {
                <span>@AdminResource.GridEditText</span>
            }
        </a>
    }
    @if (hasSpecs)
    {
        <a href="@Url.Action("SaveOrEditProductSpecs", controllerName, new { Id = itemId })"
           class="btn btn-secondary btn-sm" title="@AdminResource.ProductSpecs">
            <i class="fa fa-plus"></i>
        </a>
    }
    @if (hasDelete)
    {
        @Html.Partial("pDeleteModal", isSingleAction ? deleteMenuVd : deleteCompactVd)
    }
    @if (hasComments)
    {
        <a href="@Url.Action("Index", "ProductComments", new { Id = itemId })"
           class="btn btn-secondary btn-sm" title="@AdminResource.Comments">
            <i class="fa fa-user"></i>
        </a>
    }
</div>
}
