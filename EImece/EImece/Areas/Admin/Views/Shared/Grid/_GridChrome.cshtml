@* Density + selected-count chrome for modern Grid.Mvc lists *@
<div class="eg-grid-chrome" data-eg-grid-chrome="1">
    <div class="eg-grid-chrome-left">
        <span class="eg-selected-count" data-eg-selected-count hidden>
            <strong data-eg-selected-number>0</strong> seçili
        </span>
    </div>
    <div class="eg-grid-chrome-right" aria-label="Tablo yoğunluğu">
        <span class="eg-density-label">Yoğunluk</span>
        <div class="btn-group eg-density-toggle" data-eg-density-toggle="1">
            <button type="button" class="btn btn-default btn-xs" data-eg-density="comfortable" aria-pressed="true">Rahat</button>
            <button type="button" class="btn btn-default btn-xs" data-eg-density="compact" aria-pressed="false">Kompakt</button>
        </div>
    </div>
</div>
