@using EImece.Domain.Helpers
@using EImece.Helpers.HtmlHelpers
@using Resources
@{
    int itemId = ViewData["ItemId"].ToInt();
    bool showState = ViewData["ShowState"].ToBool(true);
    bool showMainPage = ViewData["ShowMainPage"].ToBool(false);
    bool showImageState = ViewData["ShowImageState"].ToBool(false);
    bool showIsCampaign = ViewData["ShowIsCampaign"].ToBool(false);

    bool isActive = ViewData["IsActive"].ToBool(false);
    bool mainPage = ViewData["MainPage"].ToBool(false);
    bool imageState = ViewData["ImageState"].ToBool(false);
    bool isCampaign = ViewData["IsCampaign"].ToBool(false);
}
@Html.GridStatusToggleGroupOpen()
@if (showState)
{
    @Html.GridStatusToggle(itemId, isActive, "State", AdminResource.IsActive, AdminResource.PublishedShort)
}
@if (showMainPage)
{
    @Html.GridStatusToggle(itemId, mainPage, "MainPage", AdminResource.MainPage, AdminResource.MainPageShort)
}
@if (showIsCampaign)
{
    @Html.GridStatusToggle(itemId, isCampaign, "IsCampaign", AdminResource.IsCampaign, AdminResource.CampaignShort)
}
@if (showImageState)
{
    @Html.GridStatusToggle(itemId, imageState, "ImageState", AdminResource.ImageState, AdminResource.ImageShort)
}
@Html.GridStatusToggleGroupClose()
