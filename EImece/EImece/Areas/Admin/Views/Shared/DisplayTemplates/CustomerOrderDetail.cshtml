@model EImece.Domain.Entities.Customer
@using EImece.Domain.Helpers
@using EImece.Domain.Entities
@using Resources
@using EImece.Domain.Models.Enums

<div class="row g-3">
    <div class="col-sm-6 col-lg-3">
        <div class="text-muted small">@String.Format("{0} {1}", AdminResource.Name, AdminResource.LastName)</div>
        <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.FullName) ? "—" : Model.FullName)</div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="text-muted small">@AdminResource.Email</div>
        <div>
            @if (!string.IsNullOrWhiteSpace(Model.Email))
            {
                <a href="mailto:@Model.Email">@Model.Email</a>
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </div>
    </div>
    <div class="col-sm-6 col-lg-2">
        <div class="text-muted small">@AdminResource.PhoneNumber</div>
        <div>@(string.IsNullOrWhiteSpace(Model.GsmNumber) ? "—" : Model.GsmNumber)</div>
    </div>
    <div class="col-sm-6 col-lg-2">
        <div class="text-muted small">@AdminResource.Gender</div>
        <div>@GetGenderText(Model.Gender)</div>
    </div>
    <div class="col-sm-6 col-lg-2">
        <div class="text-muted small">@AdminResource.CustomerRegistrationDate</div>
        <div>@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Company))
    {
        <div class="col-sm-6 col-lg-3">
            <div class="text-muted small">@Html.DisplayNameFor(model => model.Company)</div>
            <div>@Model.Company</div>
        </div>
    }
</div>

<div class="mt-3 pt-3 border-top">
    <div class="text-muted small mb-2">@AdminResource.CustomerRegistrationAddress</div>
    <div class="row g-2 small">
        <div class="col-sm-6 col-lg-2"><span class="text-muted">@Resource.City:</span> @Empty(Model.City)</div>
        <div class="col-sm-6 col-lg-2"><span class="text-muted">@Resource.Town:</span> @Empty(Model.Town)</div>
        <div class="col-sm-6 col-lg-2"><span class="text-muted">@Resource.District:</span> @Empty(Model.District)</div>
        <div class="col-sm-6 col-lg-3"><span class="text-muted">@Resource.Street:</span> @Empty(Model.Street)</div>
        <div class="col-sm-6 col-lg-1"><span class="text-muted">@Resource.ZipCode:</span> @Empty(Model.ZipCode)</div>
        <div class="col-sm-6 col-lg-2"><span class="text-muted">@Resource.Country:</span> @Empty(Model.Country)</div>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="col-12"><span class="text-muted">@Resource.Description:</span> @Model.Description</div>
        }
    </div>
</div>

<div class="mt-3">
    @if (Model.IsPermissionGranted)
    {
        <span class="badge text-bg-success">@AdminResource.IsPermissionGrantedDescription</span>
    }
    else
    {
        <span class="badge text-bg-secondary">@AdminResource.IsPermissionGrantedDescription</span>
    }
</div>

@helper GetGenderText(int gender)
{
    var genderEnum = (GenderType)gender;
    if (GenderType.Man == genderEnum)
    {
        @AdminResource.ManGender
    }
    else if (GenderType.Woman == genderEnum)
    {
        @AdminResource.WomanGender
    }
    else
    {
        <span class="text-muted">—</span>
    }
}

@helper Empty(string value)
{
    @(string.IsNullOrWhiteSpace(value) ? "—" : value)
}