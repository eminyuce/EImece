@using Resources
@model EImece.Domain.Entities.AppLog
@{
}
<div>
    <h4>
        @Model.CreatedDate.ToLongDateString()
    </h4>
    <hr />
    <dl class="dl-horizontal">
        @if (!string.IsNullOrEmpty(Model.EventLevel))
        {
        <dt>
            @Html.DisplayNameFor(model => model.EventLevel)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.EventLevel)
        </dd>
        }
        @if (!string.IsNullOrEmpty(Model.EventMessage))
        {
        <dt>
            @Html.DisplayNameFor(model => model.EventMessage)
        </dt>

        <dd>
            <textarea readonly="" class="eg-admin-fluid-textarea">@Model.EventMessage</textarea>
        </dd>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorSource))
        {
        <dt>
            @Html.DisplayNameFor(model => model.ErrorSource)
        </dt>

        <dd>
            <textarea readonly="" class="eg-admin-fluid-textarea">@Model.ErrorSource</textarea>
        </dd>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorClass))
        {
        <dt>
            @Html.DisplayNameFor(model => model.ErrorClass)
        </dt>

        <dd>
            <textarea readonly="" class="eg-admin-fluid-textarea">@Model.ErrorClass</textarea>
        </dd>
        }
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
        <dt>
            @Html.DisplayNameFor(model => model.ErrorMessage)
        </dt>

        <dd>
            <textarea readonly="" class="eg-admin-fluid-textarea">@Model.ErrorMessage</textarea>
        </dd>
        }
        @if (!string.IsNullOrEmpty(Model.InnerErrorMessage))
        {
        <dt>
            @Html.DisplayNameFor(model => model.InnerErrorMessage)
        </dt>

        <dd>
            <textarea readonly="" class="eg-admin-fluid-textarea">@Model.InnerErrorMessage</textarea>
        </dd>
        }
    </dl>
</div>