@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using EImece.Domain.Helpers.Extensions
@using Resources
@model BaseContent
@{
    var gridEditText = AdminResource.GridEditText;
    var actionNameEdit = "SaveOrEdit";
    var controllerName = "";
    var itemTypeName = "";
    var typeClass = "admin-search-card__type--default";
    var baseContent = Model;
    var editUrl = "#";

    if (Model is Product)
    {
        controllerName = "Products";
        itemTypeName = AdminResource.Product;
        typeClass = "admin-search-card__type--product";
    }
    else if (Model is Story)
    {
        controllerName = "Stories";
        itemTypeName = AdminResource.Story;
        typeClass = "admin-search-card__type--story";
    }
    else if (Model is Menu)
    {
        controllerName = "Menus";
        itemTypeName = AdminResource.Menu;
        typeClass = "admin-search-card__type--menu";
    }
    else if (Model is StoryCategory)
    {
        controllerName = "StoryCategories";
        itemTypeName = AdminResource.StoryCategory;
        typeClass = "admin-search-card__type--story";
    }
    else if (Model is ProductCategory)
    {
        controllerName = "ProductCategories";
        itemTypeName = AdminResource.ProductCategory;
        typeClass = "admin-search-card__type--product";
    }

    if (!string.IsNullOrEmpty(controllerName))
    {
        editUrl = Url.Action(actionNameEdit, controllerName, new { area = "admin", id = baseContent.Id });
    }

    string imageUrl = null;
    if (baseContent.MainImageId > 0 && baseContent.MainImage != null)
    {
        imageUrl = baseContent.GetCroppedImageUrl(baseContent.MainImageId, 96, 96);
        if (string.IsNullOrWhiteSpace(imageUrl))
        {
            imageUrl = baseContent.MainImage.GetAdminCroppedImageUrl(96, 96);
        }
    }

    var description = !string.IsNullOrEmpty(baseContent.Description)
        ? GeneralHelper.GetDescription(baseContent.Description, 180)
        : "";
}

<li class="admin-search-card">
    <div class="admin-search-card__media" aria-hidden="true">
        @if (!string.IsNullOrWhiteSpace(imageUrl))
        {
            <img src="@Html.Raw(imageUrl)"
                 alt=""
                 width="96"
                 height="96"
                 loading="lazy"
                 class="js-admin-search-img" />
        }
        else
        {
            <span class="admin-search-card__media-fallback"><i class="fa-regular fa-image"></i></span>
        }
    </div>

    <div class="admin-search-card__body">
        <div class="admin-search-card__meta">
            <span class="admin-search-card__type @typeClass">@itemTypeName</span>
            <span class="admin-search-card__date">
                <i class="fa-solid fa-calendar" aria-hidden="true"></i>
                @baseContent.UpdatedDate.ToShortDateString()
            </span>
        </div>

        <div class="admin-search-card__content">
            @if (baseContent is Product)
            {
                @Html.Partial("BaseContentSearchItem/ProductSearchItem", (Product)baseContent)
            }
            else
            {
                <h2 class="admin-search-card__title">
                    <a href="@editUrl" target="_blank" rel="noopener noreferrer">@baseContent.Name</a>
                </h2>
            }

            @if (!string.IsNullOrEmpty(description))
            {
                <p class="admin-search-card__desc">@description</p>
            }
        </div>
    </div>

    <div class="admin-search-card__actions">
        <a class="btn btn-primary btn-sm admin-search-card__edit"
           href="@editUrl"
           target="_blank"
           rel="noopener noreferrer">
            <i class="fa-solid fa-pencil" aria-hidden="true"></i>
            @gridEditText
        </a>
    </div>
</li>
