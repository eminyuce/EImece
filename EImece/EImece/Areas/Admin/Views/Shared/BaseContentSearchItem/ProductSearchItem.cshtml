@using EImece.Domain.Entities
@using Resources
@model Product
@{
    var product = Model;
    var editUrl = Url.Action("SaveOrEdit", "Products", new { area = "admin", id = product.Id });
    var showLongName = !string.IsNullOrEmpty(product.NameLong)
        && !string.Equals(product.NameLong.Trim(), (product.Name ?? "").Trim(), StringComparison.OrdinalIgnoreCase);
}

<h2 class="admin-search-card__title">
    <a href="@editUrl" target="_blank" rel="noopener noreferrer">@product.Name</a>
</h2>

<ul class="admin-search-card__facts">
    @if (!string.IsNullOrEmpty(product.ProductCode))
    {
        <li><span>Kod</span> @product.ProductCode</li>
    }
    @if (product.ProductCategory != null && !string.IsNullOrEmpty(product.ProductCategory.Name))
    {
        <li><span>@AdminResource.ProductCategory</span> @product.ProductCategory.Name</li>
    }
    @if (showLongName)
    {
        <li><span>Uzun ad</span> @product.NameLong</li>
    }
</ul>
