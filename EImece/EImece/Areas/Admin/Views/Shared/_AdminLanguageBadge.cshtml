@using Resources
@model int?
@{
    var langValue = Model ?? 1;
    var isTR = langValue == 1;
    var flag = isTR ? "🇹🇷" : langValue == 2 ? "🇬🇧" : "🏳️";
    var code = isTR ? "tr-TR" : langValue == 2 ? "en-US" : langValue.ToString();
    var native = isTR ? "Türkçe" : langValue == 2 ? "English" : "Lang " + langValue;
}
<div class="d-inline-flex align-items-center gap-2 px-3 py-2 mb-3" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; font-size:13px; color:#334155;">
    <span style="font-size:16px;">@flag</span>
    <span><strong>@native</strong> <span style="color:#64748b;">@code</span></span>
    <span style="width:1px; height:14px; background:#e2e8f0; margin:0 4px;"></span>
    <span style="color:#64748b; font-size:12px;">Dil / Language</span>
</div>
