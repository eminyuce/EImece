@using Resources;
@using Microsoft.AspNet.Identity;
@using EImece.Domain;
@{
    var companyNameSetting = ViewBag.CompanyNameSetting as string ?? "";
    var userName = User.Identity.GetUserName();
    var pageTitle = ViewBag.Title as string;
}
<header class="admin-topbar">
    <div class="admin-topbar-left">
        <button type="button"
                class="admin-sidebar-toggle"
                id="adminSidebarToggle"
                aria-controls="adminSidebar"
                aria-expanded="false"
                title="Menu">
            <i class="fa fa-bars" aria-hidden="true"></i>
            <span class="sr-only">Toggle navigation</span>
        </button>
        <div class="admin-topbar-title">
            <span class="admin-topbar-panel">@String.Format("{0} Yönetim Paneli", companyNameSetting)</span>
            @if (!string.IsNullOrWhiteSpace(pageTitle))
            {
                <span class="admin-topbar-page">@pageTitle</span>
            }
            @if (AppConfig.BypassAdminAuth)
            {
                <span class="admin-topbar-page" style="color:#b32d2e;">TEMP: Admin auth bypass ON</span>
            }
        </div>
    </div>

    <div class="admin-topbar-right">
        <ul class="admin-topbar-actions">
            @Html.Action("Languages", "Dashboard")
            <li>
                <a href="@Url.Action("OurSiteFeatures", "Dashboard", new { area = "admin" })" title="@AdminResource.OurSiteFeatures">
                    <i class="fa fa-book" aria-hidden="true"></i>
                    <span class="admin-topbar-label">@AdminResource.OurSiteFeatures</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("ClearCache", "Dashboard", new { area = "admin" })" title="@AdminResource.Refresh">
                    <i class="fa fa-refresh" aria-hidden="true"></i>
                    <span class="admin-topbar-label">@AdminResource.Refresh</span>
                </a>
            </li>
            <li>
                <a href="/" target="_blank" rel="noopener noreferrer" title="@AdminResource.WebSite">
                    <i class="fa fa-globe" aria-hidden="true"></i>
                    <span class="admin-topbar-label">@AdminResource.WebSite</span>
                </a>
            </li>
            <li class="admin-topbar-user">
                <a href="@Url.Action("changepassword", "Users", new { area = "admin" })" title="Manage">
                    <i class="fa fa-user" aria-hidden="true"></i>
                    <span class="admin-topbar-label">@AdminResource.Hello @userName!</span>
                </a>
            </li>
            <li>
                <a href="javascript:document.getElementById('logoutForm').submit()" title="@AdminResource.Logout">
                    <i class="fa fa-sign-out" aria-hidden="true"></i>
                    <span class="admin-topbar-label">@AdminResource.Logout</span>
                </a>
                @using (Html.BeginForm("LogOff", "DashBoard", FormMethod.Post, new { id = "logoutForm", @class = "admin-logout-form" }))
                {
                    @Html.AntiForgeryToken()
                }
            </li>
        </ul>
    </div>
</header>
