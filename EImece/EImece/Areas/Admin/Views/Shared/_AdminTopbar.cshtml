@using Resources;
@using Microsoft.AspNet.Identity;
@using EImece.Domain;
@{
    var companyNameSetting = ViewBag.CompanyNameSetting as string ?? "";
    var userName = User.Identity.GetUserName();
    var pageTitle = ViewBag.Title as string;
}
<header class="admin-topbar">
    <div class="admin-topbar-left">
        <button type="button"
                class="admin-menu-trigger"
                id="adminMegaMenuOpen"
                aria-controls="adminMegaMenu"
                aria-expanded="false"
                title="@AdminResource.OpenMenu"
                data-label-open="@AdminResource.OpenMenu"
                data-label-close="@AdminResource.CloseMenu">
            <i class="fa-solid fa-table-cells" aria-hidden="true"></i>
            <span class="admin-menu-trigger-label">@AdminResource.OpenMenu</span>
        </button>
        <div class="admin-topbar-title">
            <span class="admin-topbar-panel">
                <span class="admin-topbar-panel-full">@String.Format(AdminResource.AdminPanelTitleFormat, companyNameSetting)</span>
                <span class="admin-topbar-panel-short">
                    <i class="fa-solid fa-gauge" aria-hidden="true"></i>
                    <span>@AdminResource.Admin</span>
                </span>
            </span>
            @if (!string.IsNullOrWhiteSpace(pageTitle))
            {
                <span class="admin-topbar-page">@pageTitle</span>
            }
        </div>
    </div>

    <div class="admin-topbar-right">
        <ul class="admin-topbar-actions">
            @Html.Action("Languages", "Dashboard")
            <li class="admin-topbar-overflow dropdown">
                <button type="button"
                   class="dropdown-toggle admin-topbar-overflow-toggle"
                   data-bs-toggle="dropdown"
                   aria-haspopup="true"
                   aria-expanded="false"
                   title="@AdminResource.OtherLinks">
                    <i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i>
                    <span class="visually-hidden">@AdminResource.OtherLinks</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end admin-topbar-overflow-menu">
                    <li>
                        <a class="dropdown-item" href="@Url.Action("ClearCache", "Dashboard", new { area = "admin" })">
                            <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                            @AdminResource.Refresh
                        </a>
                    </li>
                </ul>
            </li>
            <li class="admin-topbar-action--secondary">
                <a href="@Url.Action("ClearCache", "Dashboard", new { area = "admin" })" title="@AdminResource.Refresh">
                    <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
                    <span class="admin-topbar-label">@AdminResource.Refresh</span>
                </a>
            </li>
            <li class="admin-topbar-user admin-topbar-action--essential">
                <a href="@Url.Action("changepassword", "Users", new { area = "admin" })" title="Manage">
                    <i class="fa-solid fa-user" aria-hidden="true"></i>
                    <span class="admin-topbar-label">@AdminResource.Hello @userName!</span>
                </a>
            </li>
            <li class="admin-topbar-action--essential">
                <a href="javascript:document.getElementById('logoutForm').submit()" title="@AdminResource.Logout">
                    <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                    <span class="admin-topbar-label">@AdminResource.Logout</span>
                </a>
                @using (Html.BeginForm("LogOff", "DashBoard", FormMethod.Post, new { id = "logoutForm", @class = "admin-logout-form" }))
                {
                    @Html.AntiForgeryToken()
                }
            </li>
        </ul>
    </div>
</header>
