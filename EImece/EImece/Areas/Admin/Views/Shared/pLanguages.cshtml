@using EImece.Domain.Entities;
@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.Extensions;
@model  List<SelectListItem>
@{
    var listItems = Model;
}
@if (listItems.Count() > 1)
{
<li class="admin-topbar-action--essential admin-topbar-lang-item">
    <label class="sr-only" for="CookieLanguage">Dil</label>
    <select class="form-control admin-topbar-lang" id="CookieLanguage" name="CookieLanguage" onchange="setlanguage(this.value)">
        @foreach (var l in listItems)
        {
            if (l.Selected)
            {
        <option selected="selected" value="@l.Value">@l.Text</option>
            }
            else
            {
        <option value="@l.Value">@l.Text</option>
            }

        }
    </select>
</li>
}