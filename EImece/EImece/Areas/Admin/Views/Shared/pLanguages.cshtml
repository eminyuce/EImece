@using Resources
@using EImece.Domain.Helpers;
@model List<SelectListItem>
@{
    var listItems = Model;
    var selected = listItems.FirstOrDefault(l => l.Selected);
    var selectedValue = selected != null ? selected.Value : "";
}
@if (listItems.Count() > 1)
{
<li class="admin-topbar-data-lang" title="@AdminResource.DataEntryLanguageTooltip">
    <label for="CookieLanguage" class="admin-topbar-data-lang__label">
        <i class="fa fa-pencil-square-o" style="color:#6366f1; font-size:13px;" aria-hidden="true"></i>
        <span>@AdminResource.DataEntryLanguageShort</span>
        <span class="admin-topbar-data-lang__badge">DATA</span>
    </label>
    <div style="position:relative; display:inline-flex; align-items:center;">
        <select id="CookieLanguage" name="CookieLanguage" onchange="setlanguage(this.value)"
                class="admin-topbar-data-lang__select"
                aria-label="@AdminResource.DataEntryLanguage"
                title="@AdminResource.DataEntryLanguageTooltip">
            @foreach (var l in listItems)
            {
                var v = l.Value;
                var flag = v == "1" ? "🇹🇷" : v == "2" ? "🇬🇧" : v == "3" ? "🇷🇺" : v == "4" ? "🇩🇪" : "🏳️";
                var name = string.IsNullOrWhiteSpace(l.Text) ? (v == "1" ? "Türkçe" : v == "2" ? "English" : v) : l.Text;
                if (l.Selected)
                {
            <option selected="selected" value="@l.Value">@flag @name</option>
                }
                else
                {
            <option value="@l.Value">@flag @name</option>
                }
            }
        </select>
        <i class="fa fa-chevron-down" aria-hidden="true" style="position:absolute; right:8px; top:50%; transform:translateY(-50%); font-size:9px; color:#94a3b8; pointer-events:none;"></i>
    </div>
</li>
}
