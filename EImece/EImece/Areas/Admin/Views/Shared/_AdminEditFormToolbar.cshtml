@model object
@using Resources
@{
    var contentSectionTitle = ViewBag.ContentSectionTitle as string ?? AdminResource.EntityDescriptionPage;
}
<div class="panel-heading admin-edit-tabs-heading">
    <ul class="nav nav-tabs admin-edit-tabs" role="tablist">
        <li class="active">
            <a href="#admin-edit-tab-fields"
               data-toggle="tab"
               role="tab"
               aria-controls="admin-edit-tab-fields"
               data-admin-edit-tab="fields">
                <span class="admin-edit-tab-step">1</span>
                <span class="admin-edit-tab-text">@AdminResource.EntityShortFields</span>
            </a>
        </li>
        <li>
            <a href="#admin-edit-tab-content"
               data-toggle="tab"
               role="tab"
               aria-controls="admin-edit-tab-content"
               data-admin-edit-tab="content"
               data-admin-edit-content-tab="1">
                <span class="admin-edit-tab-step">2</span>
                <span class="admin-edit-tab-text">@contentSectionTitle</span>
                <span class="admin-edit-tab-badge">editör</span>
            </a>
        </li>
    </ul>
    @Html.Partial("_AdminEditToolbarActions", (object)Model)
</div>
