@using Resources
@model BaseContent
@using EImece.Domain.Entities

@Html.HiddenFor(model => model.ImageHeight)
@Html.HiddenFor(model => model.ImageWidth)

<div class="admin-image-upload-help">
    <div class="admin-image-size-override"
         data-admin-image-size
         data-default-w="@Model.ImageWidth"
         data-default-h="@Model.ImageHeight">
        <div class="admin-image-upload-help__header">
            <span class="admin-image-upload-help__badge"
                  data-image-size-summary>@Model.ImageWidth × @Model.ImageHeight px</span>
            <p class="admin-image-upload-help__text">
                Yeni yüklemeler sitede bu boyutta kaydedilir. Orijinal fotoğrafınız durur; daha önce yüklenen görseller değişmez.
            </p>
        </div>
        <button type="button" class="admin-image-size-override__toggle collapsed"
                data-bs-toggle="collapse"
                data-bs-target="#adminImageSizeOverride"
                aria-expanded="false"
                aria-controls="adminImageSizeOverride">
            <span class="fa fa-expand" aria-hidden="true"></span>
            Bu yükleme için boyutu değiştir
        </button>
        <div id="adminImageSizeOverride" class="collapse admin-image-size-override__panel">
            <p class="form-text admin-image-size-override__hint">
                Varsayılan değerler sistem ayarlarından gelir. Buradaki genişlik ve yükseklik yalnızca bu yükleme için kullanılır.
            </p>
            <div class="admin-image-size-override__presets" data-image-size-presets>
                <button type="button" class="btn btn-secondary btn-sm" data-image-preset="default">Varsayılan</button>
                <button type="button" class="btn btn-secondary btn-sm" data-image-preset="800" data-w="800" data-h="600">Küçük (800×600)</button>
                <button type="button" class="btn btn-secondary btn-sm" data-image-preset="1200" data-w="1200" data-h="900">Orta (1200×900)</button>
                <button type="button" class="btn btn-secondary btn-sm" data-image-preset="1600" data-w="1600" data-h="1200">Büyük (1600×1200)</button>
            </div>
            <div class="admin-image-size-override__fields">
                <div class="admin-image-size-override__field">
                    <label for="imageWidthTxt">Genişlik (px)</label>
                    <input type="number"
                           class="form-control"
                           id="imageWidthTxt"
                           min="0"
                           max="2000"
                           step="10"
                           value="@Model.ImageWidth"
                           autocomplete="off" />
                </div>
                <div class="admin-image-size-override__field">
                    <label for="imageHeightTxt">Yükseklik (px)</label>
                    <input type="number"
                           class="form-control"
                           id="imageHeightTxt"
                           min="0"
                           max="2000"
                           step="10"
                           value="@Model.ImageHeight"
                           autocomplete="off" />
                </div>
            </div>
        </div>
    </div>
</div>
