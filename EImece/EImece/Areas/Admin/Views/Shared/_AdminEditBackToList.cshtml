@using Resources
@{
    var backUrl = ViewBag.BackUrl as string ?? Url.Action("Index");
    var backText = ViewBag.BackButtonText as string ?? AdminResource.BackToList;
}
<div class="admin-edit-back-to-list clearfix">
    <a href="@backUrl" class="btn w-100 admin-edit-back-to-list-btn">
        <span class="admin-edit-back-to-list-icon" aria-hidden="true">←</span>
        <span>@backText</span>
    </a>
</div>
