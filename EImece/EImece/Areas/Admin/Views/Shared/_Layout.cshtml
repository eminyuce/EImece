@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@using EImece.Domain.Services.IServices;
@{
    var SettingService = DependencyResolver.Current.GetService<ISettingService>();
    string companyName = EImece.Domain.Constants.CompanyName;
    var companyNameSetting = SettingService.GetSettingByKey(companyName).ToStr();
    ViewBag.CompanyNameSetting = companyNameSetting;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>@companyNameSetting Admin Panel </title>

    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/adminJquery")
    @Scripts.Render("~/bundles/adminJqueryMigrate")

    @Scripts.Render("~/bundles/adminJqueryUi")
    @Scripts.Render("~/bundles/adminBootstrap")
    @Scripts.Render("~/bundles/adminScripts")
    @Styles.Render("~/Content/adminBootstrapCss")
    @Styles.Render("~/Content/admincss")
    @* Cache-bust report filter styles so IIS/bundle cache does not keep oversized date inputs *@
    <link href="~/Content/adminReports.css?v=20260824card1" rel="stylesheet" type="text/css" />
    <link href="~/Content/adminSite.css?v=20260827brandSearch" rel="stylesheet" type="text/css" />
    <link href="~/Content/adminShell.css?v=20260829mega13" rel="stylesheet" type="text/css" />
    <link href="~/Content/adminGridModern.css?v=20260824card1" rel="stylesheet" type="text/css" />
    <link href="~/Content/adminTree.css?v=20260829tree3" rel="stylesheet" type="text/css" />
    <link href="~/Content/adminMobile.css?v=20260824card1" rel="stylesheet" type="text/css" />
    <link href="~/Content/adminGriddlyCompat.css?v=20260824card1" rel="stylesheet" type="text/css" />
    @RenderSection("scripts", required: false)
    @Styles.Render("~/Content/adminJqueryUiCss")
    @RenderSection("Styles", false)
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css">
</head>
<body class="admin-app">
    <input type="hidden" id="CheckboxesDataTableDoesNotSelected" value="@AdminResource.CheckboxesDataTableDoesNotSelected" />
    <input type="hidden" id="CookieLanguage" value="@AppConfig.MainLanguage" />
    <form id="__AjaxAntiForgeryForm" style="display:none">@Html.AntiForgeryToken()</form>

    @Html.Partial("_AdminSidebar")

    <div class="admin-main">
        @Html.Partial("_AdminTopbar")
        <main class="admin-content">
            @Html.Partial("_StatusMessage")
            @RenderBody()
        </main>
    </div>

    @Html.Partial("_DeleteConfirmationModal")

    <script>
        (function () {
            function wireAjaxAntiForgery() {
                if (!window.jQuery) {
                    return;
                }
                var token = $('#__AjaxAntiForgeryForm input[name="__RequestVerificationToken"]').val()
                    || $('input[name="__RequestVerificationToken"]').first().val();
                if (!token) {
                    return;
                }
                $.ajaxSetup({
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader('RequestVerificationToken', token);
                    }
                });
            }

        $(function () {
            $(".js-griddly-async").each(function () {
                var $el = $(this);
                var url = $el.attr("data-url");
                if (!url) {
                    return;
                }
                var sep = url.indexOf("?") >= 0 ? "&" : "?";
                var embedUrl = url + sep + "gridembed=1";
                $el.addClass("is-loading").html('<div class="eg-grid-embed-loading" style="padding:16px;color:#607487">@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.Loading))</div>');
                $.ajax({
                    url: embedUrl,
                    type: "GET",
                    dataType: "html",
                    beforeSend: function (xhr) {
                        xhr.setRequestHeader("X-Requested-With", "EimeceGridEmbed");
                    },
                    success: function (html) {
                        $el.html(html).removeClass("is-loading");
                        var $grid = $el.find("[data-role=griddly]");
                        if ($grid.length && $.fn.griddly) {
                            $grid.griddly();
                        }
                        var n = $grid.attr("data-griddly-count");
                        if (n) {
                            $el.find(".grid-record-count-badge").text(n);
                        }
                        if (typeof window.egMarkModernGrids === "function") {
                            window.egMarkModernGrids();
                        }
                    },
                    error: function () {
                        $el.removeClass("is-loading").html('<div class="eg-grid-embed-loading" style="padding:16px;color:#b42318">@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.GridLoadError))</div>');
                    }
                });
            });
        });
            function syncBulkDetails() {
                var open = window.matchMedia('(min-width: 992px)').matches;
                var nodes = document.querySelectorAll('details.eg-ops-more');
                for (var i = 0; i < nodes.length; i++) { nodes[i].open = open; }
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', syncBulkDetails);
            } else {
                syncBulkDetails();
            }
            if (window.jQuery) {
                wireAjaxAntiForgery();
            } else {
                document.addEventListener('DOMContentLoaded', wireAjaxAntiForgery);
            }
        })();

        function setlanguage(selectedLanguage) {
            window.location.href = "/admin/dashboard/setlanguage/" + selectedLanguage;
        }
    </script>
    <script src="~/Scripts/adminGridModern.js?v=20260829tree1"></script>
</body>
</html>
