@{
    var helpId = (ViewData["HelpId"] as string) ?? "adminHelp";
    var helpTitle = (ViewData["HelpTitle"] as string) ?? "Nasıl kullanılır?";
    var accordionId = helpId + "Accordion";
    var collapseId = helpId + "Collapse";
}
<div class="accordion" id="@accordionId" style="margin-bottom: 15px;">
    <div class="card border-info">
        <div class="card-header">
            <h4 class="card-title">
                <a data-bs-toggle="collapse" data-bs-parent="#@accordionId" href="#@collapseId" class="collapsed" aria-expanded="false">
                    <span class="fa fa-question-circle"></span>
                    @helpTitle <small>(açmak / kapatmak için tıklayın)</small>
                </a>
            </h4>
        </div>
        <div id="@collapseId" class="collapse">
            <div class="card-body">
