@model Setting
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using EImece.Domain.Entities;
@using Resources;
@{
    ViewBag.Title = AdminResource.WebSiteLogo;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var saveButtonText = AdminResource.SaveButtonText;
    string fileName = Model != null ? Model.SettingValue.ToStr() : "";
    string thumbUrl = !string.IsNullOrWhiteSpace(fileName)
        ? Url.Content("~/media/images/thumbs/thb" + fileName)
        : "";
    var hasLogo = !string.IsNullOrWhiteSpace(fileName);
}

<div class="row justify-content-center">
    <div class="col-lg-8 mx-auto">
        <h2 class="admin-page-title">@AdminResource.WebSiteLogo</h2>
        <p class="text-muted mb-3">Sitenizin üst menüsünde görünen logoyu buradan yükleyin. Kaydettikten sonra üst çubuktaki yenile ile önbelleği temizleyin.</p>

        @{ ViewData["HelpId"] = "webSiteLogoHelp"; }
        @Html.Partial("_AdminHelpAccordionStart")
        <ul class="mb-2">
            <li>Bu sayfada web sitenizin <strong>logosunu</strong> değiştirebilirsiniz.</li>
            <li>Logo seçmek için aşağıdaki alandan dosya (Gözat / Dosya Seç) butonuna tıklayın ve bilgisayarınızdan logonuzu seçin.</li>
            <li>Mevcut logo aşağıda önizleme olarak görünür. Önizleme yoksa yeni bir dosya yükleyin.</li>
            <li>Değişiklikleri kaydetmek için <strong>@saveButtonText</strong> butonuna tıklamayı unutmayın.</li>
            <li>Logo kaydedildikten sonra üst menüdeki <strong>@AdminResource.Refresh</strong> ile site önbelleğini temizleyebilirsiniz; ardından logo vitrinde görünür.</li>
        </ul>
        <p class="mb-0"><strong>Tavsiye:</strong> Yatay PNG (şeffaf arka plan), yaklaşık 240&times;80 piksel veya aynı oran. İhtiyacınız olmayan boyutlandırma ayarları kaldırılmıştır.</p>
        @Html.Partial("_AdminHelpAccordionEnd")

        @using (Html.BeginForm("UploadWebSiteLogo", "Settings", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(r => r.Id)
            @Html.AdminValidationSummary()

            <div class="card shadow-sm">
                <div class="card-header">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-picture-o me-1" aria-hidden="true"></i>
                        Mevcut logo ve yeni yükleme
                    </h3>
                </div>
                <div class="card-body">
                    <div class="mb-4 pb-3 border-bottom">
                        <div class="small text-uppercase text-muted fw-semibold mb-2">Mevcut logo</div>
                        <div class="admin-logo-preview rounded d-flex align-items-center justify-content-center mx-auto p-4">
                            @if (hasLogo)
                            {
                                <img src="@thumbUrl" alt="@AdminResource.WebSiteLogo" class="img-fluid" style="max-height: 168px; object-fit: contain;" onerror="this.classList.add('d-none'); var e=this.parentNode.querySelector('.js-logo-empty'); if(e){ e.classList.remove('d-none'); }" />
                                <div class="js-logo-empty d-none text-center text-muted">
                                    <i class="fa fa-picture-o fa-3x d-block mb-3" aria-hidden="true"></i>
                                    <div class="fw-semibold">Logo önizlemesi gösterilemiyor</div>
                                    <div class="small">Yeni bir dosya yükleyerek güncelleyebilirsiniz.</div>
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted">
                                    <i class="fa fa-picture-o fa-3x d-block mb-3" aria-hidden="true"></i>
                                    <div class="fw-semibold">Henüz logo yüklenmedi</div>
                                    <div class="small">Aşağıdan bir dosya seçip kaydedin.</div>
                                </div>
                            }
                        </div>
                        @if (hasLogo)
                        {
                            <p class="small text-muted text-center mt-2 mb-0">Kayıtlı dosya: @fileName</p>
                        }
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-semibold" for="postedImage">@AdminResource.WebSiteLogo dosyası (PNG, JPG)</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="fa fa-file-image-o" aria-hidden="true"></i></span>
                            <input type="file" id="postedImage" name="postedImage" class="form-control" accept=".png,.jpg,.jpeg,.gif,.webp,.svg,image/*" />
                        </div>
                        <div class="form-text mt-2">
                            <strong>Önerilen boyut:</strong> 240&times;80 piksel (veya aynı oran). Şeffaf arka planlı PNG tercih edilir.
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="fa fa-upload me-1" aria-hidden="true"></i> @saveButtonText
                    </button>
                </div>
            </div>
        }
    </div>
</div>
