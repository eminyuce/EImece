@model Setting
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using EImece.Domain.Entities;
@using Resources;
@{
    ViewBag.Title = AdminResource.WebSiteLogo;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var saveButtonText = AdminResource.SaveButtonText;
    string fileName = Model != null ? Model.SettingValue.ToStr() : "";
    string thumbUrl = !string.IsNullOrWhiteSpace(fileName)
        ? Url.Content("~/media/images/thumbs/thb" + fileName)
        : "";
}

<h2>@AdminResource.WebSiteLogo</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "webSiteLogoHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada web sitenizin <strong>logosunu</strong> değiştirebilirsiniz.</li>
    <li>Logo seçmek için aşağıdaki alandan dosya (Gözat / Dosya Seç) butonuna tıklayın ve bilgisayarınızdan logonuzu seçin.</li>
    <li>Mevcut logonuz sol tarafta önizleme olarak görünmektedir.</li>
    <li>Değişiklikleri kaydetmek için <strong>@saveButtonText</strong> butonuna tıklamayı unutmayın.</li>
    <li>Logo kaydedildikten sonra üst menüdeki <strong>@AdminResource.Refresh</strong> ile site önbelleğini temizleyebilirsiniz; ardından logo vitrinde görünür.</li>
</ul>
<p style="margin-top: 12px; margin-bottom: 0;"><strong>Tavsiye:</strong> Görseli, tasarımınızda görünmesini istediğiniz boyutlarda ve formatta (tercihen PNG) yüklemeniz tavsiye edilir. İhtiyacınız olmayan boyutlandırma ayarları kullanıcılara kolaylık sağlamak amacıyla kaldırılmıştır.</p>
@Html.Partial("_AdminHelpAccordionEnd")

@using (Html.BeginForm("UploadWebSiteLogo", "Settings", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(r => r.Id)
    
    <div class="row" style="margin-bottom: 20px;">
        <div class="col-md-9">
            @Html.AdminValidationSummary()
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-success w-100 btn-lg">
                <i class="fa fa-upload"></i> @saveButtonText
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Mevcut Logo ve Yeni Yükleme</h3></div>
                <div class="card-body">
                    <div class="row">
                        <!-- Current Logo Preview -->
                        <div class="col-md-4 text-center">
                            <h4 style="margin-bottom: 15px;">Mevcut Logo</h4>
                            <div class="well" style="min-height: 180px; display: flex; align-items: center; justify-content: center; background-color: #f9f9f9; border: 1px solid #e3e3e3;">
                                @if (!string.IsNullOrEmpty(thumbUrl))
                                {
                                    <img style="max-width: 100%; max-height: 150px; object-fit: contain;" src="@thumbUrl" alt="@AdminResource.WebSiteLogo" />
                                }
                                else
                                {
                                    <div class="text-muted" style="padding: 20px;">
                                        <i class="fa fa-picture-o" style="font-size: 32px; color: #ccc;"></i><br/><br/>
                                        Logo henüz yüklenmedi.
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <!-- Upload New Logo -->
                        <div class="col-md-8">
                            <h4 style="margin-bottom: 15px;">Yeni Logo Yükle</h4>
                            <div class="form-group row mb-3" style="background-color: #f5f5f5; padding: 20px; border-radius: 4px; border: 1px dashed #ccc; margin-top: 10px;">
                                <label class="col-form-label">@AdminResource.WebSiteLogo Dosyası (PNG, JPG vb.)</label>
                                <input type="file" name="postedImage" class="form-control" style="padding-bottom: 40px; margin-top: 10px;" />
                                <span class="form-text" style="margin-top: 15px;">
                                    <strong>Not:</strong> Logonuzu yüklerken sitenizin genel tasarımına uygun, transparan arka planlı PNG formatlarını tercih edebilirsiniz.
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}