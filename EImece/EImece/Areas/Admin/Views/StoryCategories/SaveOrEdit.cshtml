@model EImece.Domain.Entities.StoryCategory
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Entities;
@using Resources;

@{
    var saveButtonText = AdminResource.SaveButtonText;
    var ExistingMainImageText = AdminResource.ExistingMainImageText;
    ViewBag.Title = "SaveOrEdit";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var saveButtonAndCloseText = AdminResource.SaveButtonAndCloseText;

}

<h2>@AdminResource.StoryCategory</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "storyCategoriesHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0; margin-bottom: 0;">
    <li>Bu sayfada blog / hikâye yazıları için bir <strong>kategori</strong> oluşturur veya düzenlersiniz.</li>
    <li><strong>İsim</strong>: Kategori adı (ör. “Haberler”).</li>
    <li><strong>Yayında / Sıra</strong>: Sitede görünme ve listelenme sırası.</li>
    <li>İsterseniz kategori görseli ve açıklama ekleyebilirsiniz.</li>
    <li>Yazılar, Hikâyeler menüsünden bu kategoriye bağlanır.</li>
</ul>
@Html.Partial("_AdminHelpAccordionEnd")

@using (Html.BeginForm("SaveOrEdit", "StoryCategories", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
@Html.AntiForgeryToken()
<div class="form-horizontal">

    @Html.AdminValidationSummary()
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.AddUserId)
    @Html.HiddenFor(model => model.CreatedDate)
    @Html.HiddenFor(model => model.UpdatedDate)

    @Html.HiddenFor(model => model.Lang)

    <div class="card admin-edit-form">
                @Html.Partial("_AdminEditFormToolbar")
                <div class="card-body">
                    <div class="tab-content">
                        <div id="admin-edit-tab-fields" class="tab-pane fade show active" role="tabpanel">
<div class="form-group row mb-3">
                        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "col-form-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        @Html.LabelFor(model => model.MetaKeywords, htmlAttributes: new { @class = "col-form-label col-md-2" })
                        <div class="col-md-10">
                            @Html.TextAreaFor(model => model.MetaKeywords, 2, 20, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.MetaKeywords, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <div class="col-md-3">
                        </div>
                        <div class="col-md-3">
                            @Html.LabelFor(model => model.IsActive)
                            @Html.EditorFor(model => model.IsActive)
                            @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        @Html.LabelFor(model => model.Position, htmlAttributes: new { @class = "col-form-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Position, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Position, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        <div class="col-md-3">
                        </div>
                        <div class="col-md-3">
                            @Html.LabelFor(model => model.ImageState)
                            @Html.EditorFor(model => model.ImageState)
                            @Html.ValidationMessageFor(model => model.ImageState, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        @Html.LabelFor(model => model.MainImageId, htmlAttributes: new { @class = "col-form-label col-md-2" })
                        <div class="col-md-5">
                            <input type="file" name="postedImage" accept="image/gif,image/jpeg,image/jpg,image/png" />
                            @Html.ValidationMessageFor(model => model.MainImageId, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-5">
                            @if (Model.MainImageId.HasValue)
                            {
                            <b>@ExistingMainImageText :</b>
                            @Html.Partial("pGridImageMainPage", (BaseContent)Model)
                            }
                        </div>
                    </div>
                    @Html.Partial("pSliderResizing", (BaseContent)Model)

                    <div id="pageThemeWrapper" class="form-group row mb-3">
                        @Html.LabelFor(model => model.PageTheme, htmlAttributes: new { @class = "col-form-label col-md-2" })
                        <div class="col-md-10">
                            @Html.Partial("pPageThemes", Model)
                            @Html.ValidationMessageFor(model => model.PageTheme, "", new { @class = "text-danger" })
                        </div>
                    </div>
                            @Html.Partial("_AdminEditNextStep")
                        </div>
                        <div id="admin-edit-tab-content" class="tab-pane fade" role="tabpanel">
                            @Html.Partial("_AdminEditBackToFields")
<div class="form-group row mb-3">
                        <div class="col-md-12">
                            @Html.TextAreaFor(model => model.Description, new { @class = "form-control eimece-rich-text-editor" })
                        </div>
                    

                    </div>
                        </div>
                    </div>
                </div>
            </div>
</div>

}

@Html.Partial("_AdminEditBackToList")

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(function () {
            var $picker = $("#SayfaDuzenleri");
            $picker.on("change", ".page-theme-card__input", function () {
                $picker.find(".page-theme-card").removeClass("is-selected");
                $(this).closest(".page-theme-card").addClass("is-selected");
            });

            var $lightbox = $("#pageThemeLightbox");
            var $lightboxImg = $lightbox.find("img");
            var $lightboxTitle = $("#pageThemeLightboxTitle");
            function closeThemeLightbox() {
                $lightbox.attr("hidden", "hidden");
                $lightboxImg.attr("src", "");
            }
            $picker.on("click", ".page-theme-card__zoom", function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $btn = $(this);
                $lightboxTitle.text($btn.data("title") || "");
                $lightboxImg.attr("src", $btn.data("preview"));
                $lightboxImg.attr("alt", ($btn.data("title") || "") + " önizleme");
                $lightbox.removeAttr("hidden");
            });
            $lightbox.on("click", ".page-theme-lightbox__backdrop, .page-theme-lightbox__close", closeThemeLightbox);
            $(document).on("keydown.pageThemeLightbox", function (e) {
                if (e.key === "Escape" && !$lightbox.is("[hidden]")) {
                    closeThemeLightbox();
                }
            });
        });
    </script>
}