@model List<ProductCategory>
@using EImece.Domain.Helpers;
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain;
@using Resources;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Entities;
@using EImece.Domain.Models.FrontModels;
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : AppConfig.GridPageSizeNumber * (gridPage - 1);

    var controllerName = "ProductCategories";
    var title = "ProductCategories";
    var gridName = "ProductCategoriesGrid";
    var contents = Model;
    var baseList = contents.DownCasting();
    var productCategoryLeaves = (List<ProductCategory>)ViewBag.ProductCategoryLeaves;

    List<ProductCategoryTreeModel> ProductCategoryTree = ViewBag.ProductCategoryTree;

    Setting isProductPriceEnable = ViewBag.IsProductPriceEnable;
    var productPriceEnabled = isProductPriceEnable == null || isProductPriceEnable.SettingValue.ToBool(true);
}

<h2>@AdminResource.ProductCategory</h2>
<hr class="adminLine" />

<div class="row">

    <div class="col-md-2">
        @if (ProductCategoryTree != null)
        {
            @Html.Partial("_ProductCategoryTree", ProductCategoryTree, new ViewDataDictionary(ViewData){
                        {"UrlPattern","/admin/productcategories/saveoredit/"}
                      ,{"IsExcelButtonEnabled",true}})
        }
        <span id="treeClickContainer"></span>
    </div>
    <div class="col-md-10">

        @Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
            {"controllerName",controllerName}
                     ,{"StateTypes","State,ImageState,MainPage"}
           ,{"orderingButton",true}
           ,{"selectAll",true}
           ,{"deleteAll",true}
            ,{"SetStateOnOrOff",true},{"IsExcelButtonEnabled",true}})

        <div class="eg-products-toolbar-gap">
            <a class="eg-admin-move-link eg-products-move-link" href="@Url.Action("MoveProductCategory")">
                <i class="glyphicon glyphicon-transfer" aria-hidden="true"></i>
                <span>@AdminResource.MoveProductCategory</span>
            </a>
        </div>

        @Html.Partial("Grid/_GridChrome")

        <div class="panel panel-primary eg-grid-shell">
            @Html.Partial("pGridDropDown", baseList)
            @Html.Grid(contents).Named(gridName).Columns(columns =>
       {
           columns.Add()
               .Encoded(false)
               .Sanitized(false)
               .Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
               .RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

           columns.Add(o => o.Id, true);

           columns.Add()
               .Encoded(false)
               .Sanitized(false)
               .Css("gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check")
               .RenderValueAs(d => Html.Partial("pGridCheckbox", new ViewDataDictionary(ViewData){
                    {"ItemId",d.Id}}));

           columns.Add()
               .Titled(AdminResource.Images)
               .Encoded(false)
               .Sanitized(false)
               .Css("eg-col-image")
               .RenderValueAs(o => Html.Partial("Grid/_GridImageCell", o));

           columns.Add(c => c.Name)
               .Titled(AdminResource.Name)
               .Filterable(true)
               .Encoded(false)
               .Sanitized(false)
               .Css("eg-col-name")
               .RenderValueAs(d => Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) {
                   { "Name", d.Name },
                   { "ItemId", d.Id.ToString() }
               }));

           columns.Add(c => c.ParentId)
               .Titled(AdminResource.ProductCategoryParentId)
               .Encoded(false)
               .Filterable(true)
               .RenderValueAs(o => o.ParentId == 0 ? string.Format("{0}", Resource.RootCategory) : "");

           columns.Add(c => c.DiscountPercantage)
               .Titled(AdminResource.Discount)
               .Encoded(false)
               .Filterable(true)
               .RenderValueAs(o => o.DiscountPercantage.HasValue && o.DiscountPercantage.Value > 0 ? string.Format("%{0} {1}", o.DiscountPercantage, Resource.Discount) : "");

           columns.Add(o => o.Position).Titled(AdminResource.Position)
               .Encoded(false)
               .Sanitized(false)
               .Css("smallGridColumn")
               .RenderValueAs(o => String.Format("<label class='sr-only' for='pcat-pos-{0}'>Sıra</label><input id='pcat-pos-{0}'   gridkey-id='{0}' value='{1}'   class='GridOrderingTextbox input-xs' name='gridOrdering' type='type'>", o.Id, o.Position));

           columns.Add(o => o.IsActive)
               .Titled(AdminResource.IsActive)
               .Sortable(true)
               .Css("smallGridColumn eg-col-status")
               .SortInitialDirection(GridSortDirection.Descending)
               .Encoded(false)
               .Sanitized(false)
               .RenderValueAs(o => Html.Partial("Grid/_GridStatusToggles", null, new ViewDataDictionary(ViewData) {
                   { "ItemId", o.Id },
                   { "IsActive", o.IsActive },
                   { "MainPage", o.MainPage },
                   { "ShowState", true },
                   { "ShowMainPage", true },
                   { "ShowImageState", false }
               }));

           columns.Add(o => o.UpdatedDate)
               .Titled(AdminResource.UpdatedDate)
               .Sortable(true)
               .Css("gridDateClass")
               .RenderValueAs(o => o.UpdatedDate != null ? String.Format("{0}", o.UpdatedDate.ToShortDateString()) : null)
               .SortInitialDirection(GridSortDirection.Descending);

           if (productPriceEnabled)
           {
               columns.Add()
                   .Titled("Fiyat Güncellemesi")
                   .Encoded(false)
                   .Sanitized(false)
                   .Css("smallGridColumn")
                   .RenderValueAs(o => PriceUpdates(o));
           }

           columns.Add()
               .Titled("İşlemler")
               .Encoded(false)
               .Sanitized(false)
               .Css("eg-sticky-right eg-col-actions")
               .RenderValueAs(d => CategoryActionsCell(d, productCategoryLeaves, controllerName));

       }).SetRowCssClasses(item => item.IsActive ? string.Empty : "GridIsActive").WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
        </div>
    </div>
</div>

@helper PriceUpdates(ProductCategory d)
{
    @Html.Partial("pPriceUpdates", new ViewDataDictionary(ViewData) {
        { "ItemId", d.Id },
        { "ItemType", "ProductCategory" }
    });
}

@helper CategoryActionsCell(ProductCategory d, List<ProductCategory> productCategoryLeaves, string controllerName)
{
    var canDelete = false;
    string cannotDeleteMessage = null;

    if (d.Products != null && d.Products.Any())
    {
        cannotDeleteMessage = AdminResource.CategoryHasProducts;
    }
    else if (productCategoryLeaves != null && productCategoryLeaves.Any(r => r.Id == d.Id))
    {
        canDelete = true;
    }
    else
    {
        cannotDeleteMessage = AdminResource.CategoryCannotDelete;
    }

    @Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
        { "ItemId", d.Id },
        { "ItemName", d.Name },
        { "controllerName", controllerName },
        { "ShowMedia", false },
        { "ShowEdit", true },
        { "ShowDelete", canDelete }
    })

    if (UserRoleHelper.IsDeletedEnableRoles() && !canDelete && !string.IsNullOrEmpty(cannotDeleteMessage))
    {
        <span class="text-muted" style="font-size:11px;white-space:nowrap;">
            @cannotDeleteMessage
        </span>
    }
}
