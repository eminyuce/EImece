@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@using EImece.Domain.Entities;
@using EImece.Domain.Models.FrontModels;
@model EImece.Domain.Models.AdminHelperModels.MoveProductCategory

@{
    ViewBag.Title = AdminResource.MoveProductCategory;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var productCategoryDropDownList = (List<SelectListItem>)ViewBag.ProductCategoryDropDownList;
    var saveButtonText = AdminResource.SaveButtonText;
    List<ProductCategoryTreeModel> ProductCategoryTree = ViewBag.ProductCategoryTree;
}

<h2>@AdminResource.MoveProductCategory</h2>
<hr class="adminLine" />

<div class="row">
    <div class="col-md-3">
        @Html.Partial("_ProductCategoryTree", ProductCategoryTree, new ViewDataDictionary(ViewData){
                    {"UrlPattern",""}
                  ,{"IsExcelButtonEnabled",true}})
        <span id="treeClickContainer"></span>
    </div>
    <div class="col-md-9">
        @{ ViewData["HelpId"] = "moveCategoryHelp"; }
        @Html.Partial("_AdminHelpAccordionStart")
        <ul style="margin-bottom: 0; margin-top: 0;">
            <li>Bu sayfa, bir ürün kategorisini kategori ağacında başka bir yere taşımanızı sağlar.</li>
            <li><strong>Taşınacak ürün kategorisi</strong> listesinden taşımak istediğiniz kategoriyi seçin.</li>
            <li><strong>Yeni üst kategori</strong> listesinden kategorinin gideceği üst kategoriyi seçin.</li>
            <li>Kategoriyi en üst seviyeye almak için <strong>Yeni üst kategori</strong> alanında <strong>Ana Kategori Yap</strong> seçeneğini seçin.</li>
            <li>Soldaki ağaç mevcut kategori yapısını gösterir; kaydettikten sonra sayfayı yenileyerek sonucu görebilirsiniz.</li>
        </ul>
        @Html.Partial("_AdminHelpAccordionEnd")
        @using (Html.BeginForm("MoveProductCategory", "ProductCategories", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
        @Html.AntiForgeryToken()
        <div class="form-horizontal">
            <div class="form-group row mb-3">
                @Html.LabelFor(model => model.SecondCategoryId, htmlAttributes: new { @class = "col-form-label col-md-3" })
                <div class="col-md-6">
                    @Html.DropDownListFor(model => model.SecondCategoryId, productCategoryDropDownList, new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.SecondCategoryId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group row mb-3">
                @Html.LabelFor(model => model.FirstCategoryId, htmlAttributes: new { @class = "col-form-label col-md-3" })
                <div class="col-md-6">
                    @Html.DropDownListFor(model => model.FirstCategoryId, productCategoryDropDownList, new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.FirstCategoryId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group row mb-3">
                <div class="col-md-6 offset-md-3 d-flex flex-wrap align-items-center gap-2">
                    <button type="submit" name="saveButton" value="@saveButtonText" class="btn btn-success text-nowrap">@saveButtonText</button>
                    @Html.ActionLink("Ürün kategorileri listesine dön", "Index", null, new { @class = "btn btn-secondary text-nowrap" })
                </div>
            </div>
        </div>
        }
    </div>
</div>
