@model EImece.Domain.Entities.ProductCategory
@using EImece.Domain.Entities;
@using EImece.Domain.Models.Enums;
@using Resources;
@using EImece.Domain.Models.FrontModels;

@{
    var saveButtonText = AdminResource.SaveButtonText;
    var ExistingMainImageText = AdminResource.ExistingMainImageText;
    ViewBag.Title = "SaveOrEdit";
    var controllerName = "ProductCategories";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var parentCategory = (ProductCategory)ViewBag.ParentCategory;
    var templates = (List<SelectListItem>)ViewBag.Templates;
    var saveButtonAndCloseText = AdminResource.SaveButtonAndCloseText;
    List<ProductCategoryTreeModel> ProductCategoryTree = ViewBag.ProductCategoryTree;
    var productCategoryLeaves = (List<ProductCategory>)ViewBag.ProductCategoryLeaves;
}

<h2>@AdminResource.ProductCategory</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "productCategoriesHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada <strong>ürün kategorisi</strong> oluşturur veya düzenlersiniz.</li>
    <li>Soldaki ağaçtan <strong>üst kategoriyi</strong> seçin. Ana kategori için üst seçmeyin.</li>
    <li><strong>Şablon</strong>: Bu kategorideki ürünlerin ek özellik alanlarını (renk, beden vb.) belirler. Şablonlar menüsünden tanımlanır.</li>
    <li><strong>Kategori indirimi (%)</strong>: Kategorideki ürünlere uygulanacak yüzde indirim (varsa).</li>
    <li><strong>Ana sayfa / Yayında</strong>: Kategorinin sitede ve ana sayfada görünmesini kontrol eder.</li>
</ul>
<p style="margin-top: 12px; margin-bottom: 6px;"><strong>Örnek 1:</strong> Üst yok → İsim “Giyim” → Şablon “Giyim Özellikleri” → Kaydet.</p>
<p style="margin-bottom: 0;"><strong>Örnek 2:</strong> Üst “Giyim” → İsim “Tişörtler” → aynı şablon → alt kategori oluşur.</p>
@Html.Partial("_AdminHelpAccordionEnd")

<div class="row">

    <div class="col-md-3 eg-products-tree-col">
        @if (ProductCategoryTree != null)
        {
        @Html.Partial("_ProductCategoryTree", ProductCategoryTree, new ViewDataDictionary(ViewData){
                                 {"UrlPattern",""}
                               ,{"SelectedCategoryId", Model != null ? Model.ParentId : 0}
                               ,{"CurrentItemId", Model != null ? Model.Id : 0}
                               ,{"ShowAllLink", false}
                               ,{"ShowPickHint", true}
                               ,{"IsExcelButtonEnabled",true}})

        }
    </div>
    <div class="col-md-9 eg-products-main-col">
        <input id="errorMessageForSameSelection" type="hidden" value="@AdminResource.ProductSameSelectionErrorMessage" />
        @using (Html.BeginForm("SaveOrEdit", "ProductCategories", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">

            @Html.AdminValidationSummary()
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.AddUserId)
            @Html.HiddenFor(model => model.CreatedDate)
            @Html.HiddenFor(model => model.UpdatedDate)

            @Html.HiddenFor(model => model.Lang)

            <div class="card admin-edit-form">
                @Html.Partial("_AdminEditFormToolbar")
                <div class="card-body">
                    <div class="tab-content">
                        <div id="admin-edit-tab-fields" class="tab-pane fade show active" role="tabpanel">
<div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.ParentId, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.HiddenFor(model => model.ParentId)
                                    @Html.Partial("_AdminTreePicker", null, new ViewDataDictionary(ViewData) {
                                        { "Mode", "parent" },
                                        { "NameId", "ParentName" },
                                        { "HiddenId", "ParentId" },
                                        { "SelectedId", Model.ParentId },
                                        { "SelectedName", parentCategory != null ? parentCategory.Name : "" },
                                        { "ShowRootButton", true },
                                        { "RootText", "Ana kategori" },
                                        { "Hint", "Soldaki ağaçtan bir kategoriye tıklayın; bu kayıt onun altına yerleşir." }
                                    })
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.Name, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.ShortDescription, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.TextAreaFor(model => model.ShortDescription, 2, 20, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.ShortDescription, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.TemplateId, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    <div class="admin-brand-combobox" data-searchable-combobox data-placeholder="@AdminResource.SelectTemplate" data-entity-name="şablon" data-sort="name">
                                        @Html.DropDownListFor(model => model.TemplateId, templates, new { @class = "form-select", data_searchable_select = "true" })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.TemplateId, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.DiscountPercantage, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.DiscountPercantage, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.DiscountPercantage, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.MetaKeywords, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.TextAreaFor(model => model.MetaKeywords, 2, 20, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.MetaKeywords, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3 align-items-center">
                                <div class="col-md-2 col-form-label">Durum</div>
                                <div class="col-md-10 d-flex flex-wrap gap-4 align-items-center">
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.IsActive)
                                        @Html.AdminLabelFor(model => model.IsActive, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-check">
                                        @Html.EditorFor(model => model.MainPage)
                                        @Html.AdminLabelFor(model => model.MainPage, htmlAttributes: new { @class = "form-check-label" })
                                        @Html.ValidationMessageFor(model => model.MainPage, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.Position, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Position, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Position, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group row mb-3">
                                @Html.AdminLabelFor(model => model.MainImageId, htmlAttributes: new { @class = "col-form-label col-md-2" })
                                <div class="col-md-3">
                                    <input type="file" name="postedImage" class="form-control" />
                                    @Html.ValidationMessageFor(model => model.MainImageId, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-3">
                                    @Html.AdminLabelFor(model => model.ImageState)
                                    @Html.EditorFor(model => model.ImageState)
                                    @Html.ValidationMessageFor(model => model.ImageState, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-3">
                                    @Html.Partial("pGridImageMainPage", (BaseContent)Model)


                                </div>
                            </div>
                            @Html.Partial("pSliderResizing", (BaseContent)Model)
