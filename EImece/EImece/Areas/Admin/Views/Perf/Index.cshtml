@model EImece.Areas.Admin.Models.PerfIndexViewModel
@using EImece.Domain.Helpers
@using Resources
@using Griddly.Mvc

@{
    ViewBag.Title = AdminResource.PerformanceStatistics;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var stats = Model.Stats ?? new List<EImece.Domain.Observability.Metrics.PerfStatSnapshot>();
    var totalInvocations = stats.Sum(s => s.Count);
    var slowest = stats.OrderByDescending(s => s.AvgMs).FirstOrDefault();
    var fastest = stats.OrderBy(s => s.AvgMs).FirstOrDefault();
    var retentionHours = EImece.Domain.Observability.Metrics.PerfStats.GetRetentionHours();
    var currentSearch = Model.SearchTerm ?? "";
    var currentType = Model.SelectedType ?? "all";
}

@Html.AdminBreadcrumb(AdminResource.PerformanceStatistics)
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="admin-page-title mb-1"><i class="fa-solid fa-gauge text-primary me-2"></i>@AdminResource.PerformanceStatistics</h2>
        <p class="text-muted mb-0 small">@AdminResource.PerfStatsSubtitle</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("SystemSettings", "AdminSettings", new { area = "admin" })#tab-tools" class="btn btn-outline-primary btn-sm" title="@AdminResource.PerfStatsRetentionConfigTitle">
            <i class="fa-solid fa-gear me-1"></i> @AdminResource.PerfStatsRetentionBadge: @(retentionHours > 0 ? $"{retentionHours} {AdminResource.PerfStatsHoursSuffix}" : AdminResource.PerfStatsDisabledBadge)
        </a>
        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#clearPerfStatsModal">
            <i class="fa-solid fa-trash me-1"></i> @AdminResource.ClearStats
        </button>
        <a href="@Url.Action("Index", "Perf", new { area = "admin" })" class="btn btn-outline-secondary btn-sm" title="@AdminResource.Refresh">
            <i class="fa-solid fa-arrows-rotate me-1"></i> @AdminResource.Refresh
        </a>
    </div>
</div>
<hr class="adminLine" />

@if (retentionHours <= 0)
{
    <div class="alert alert-warning d-flex align-items-start gap-2 py-2 mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation fa-lg mt-1 text-warning"></i>
        <div class="small">
            <strong>@AdminResource.PerfStatsDisabledAlertTitle</strong> @AdminResource.PerfStatsDisabledAlertText <a href="@Url.Action("SystemSettings", "AdminSettings", new { area = "admin" })#tab-tools" class="alert-link">@AdminResource.AdminSettings</a>. @AdminResource.PerfStatsDisabledAlertAction
        </div>
    </div>
}
else
{
    <div class="alert alert-info d-flex align-items-start gap-2 py-2 mb-4" role="alert">
        <i class="fa-solid fa-circle-info fa-lg mt-1 text-info"></i>
        <div class="small">
            <strong>@AdminResource.PerfStatsInfoAlertTitle</strong> @AdminResource.PerfStatsInfoAlertText
        </div>
    </div>
}

<!-- Quick Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100 bg-light">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-bold">@AdminResource.ActiveMetrics</div>
                <div class="h3 fw-bold mb-0 text-primary">@stats.Count.ToString("N0")</div>
                <small class="text-muted">@AdminResource.DistinctMonitoredMethods</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100 bg-light">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-bold">@AdminResource.TotalInvocations</div>
                <div class="h3 fw-bold mb-0 text-success">@totalInvocations.ToString("N0")</div>
                <small class="text-muted">@(retentionHours > 0 ? $"{retentionHours} {AdminResource.PerfStatsHoursSuffix} " : "")@AdminResource.RecordedWithinWindow</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100 bg-light">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-bold">@AdminResource.SlowestAvgLatency</div>
                <div class="h3 fw-bold mb-0 text-danger">@(slowest != null ? $"{slowest.AvgMs:F2} ms" : "-")</div>
                <small class="text-truncate d-block text-muted" title="@(slowest?.Name ?? "")">@(slowest?.Name ?? "N/A")</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 h-100 bg-light">
            <div class="card-body p-3">
                <div class="text-muted small text-uppercase fw-bold">@AdminResource.FastestAvgLatency</div>
                <div class="h3 fw-bold mb-0 text-info">@(fastest != null ? $"{fastest.AvgMs:F2} ms" : "-")</div>
                <small class="text-truncate d-block text-muted" title="@(fastest?.Name ?? "")">@(fastest?.Name ?? "N/A")</small>
            </div>
        </div>
    </div>
</div>

<!-- Operations Bar (Exact same design as Brands Admin toolbar panel) -->
<div class="card border-info admin-grid-ops eg-bulk-bar mb-3">
    <div class="card-body">
        <div class="eg-ops-primary">
            <!-- Search Form -->
            <div class="eg-ops-search">
                @using (Html.BeginForm("Index", "Perf", FormMethod.Get, new { @class = "eg-search-form" }))
                {
                    <input type="hidden" name="type" value="@currentType" />
                    <div class="eg-search-field">
                        <span class="eg-search-icon" aria-hidden="true">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>
                        <label class="visually-hidden" for="searchTxtInput">@AdminResource.Search</label>
                        <input type="text"
                               class="form-control"
                               id="searchTxtInput"
                               name="search"
                               value="@currentSearch"
                               placeholder="@AdminResource.Search"
                               autocomplete="off" />
                        <div class="eg-search-actions">
                            @if (!string.IsNullOrEmpty(currentSearch))
                            {
                                <a href="@Url.Action("Index", "Perf", new { area = "admin", type = currentType })" class="btn btn-secondary eg-search-clear">@AdminResource.Clear</a>
                            }
                            <button class="btn btn-primary" id="SearchButton" type="submit">
                                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                                <span>@AdminResource.GridSearchButtonText</span>
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Type Filter Dropdown (Original English names: Controller, Service, Repository, Other) -->
            <div class="eg-ops-type-filter d-flex align-items-center gap-2">
                <form method="get" action="@Url.Action("Index", "Perf", new { area = "admin" })" class="d-flex align-items-center gap-1 m-0">
                    <input type="hidden" name="search" value="@currentSearch" />
                    <label for="perfTypeSelect" class="visually-hidden">@AdminResource.PerfFilterTypeLabel</label>
                    <select id="perfTypeSelect" name="type" class="form-select form-select-sm" style="min-width: 140px; height: 38px;" onchange="this.form.submit()">
                        <option value="all" @(string.Equals(currentType, "all", StringComparison.OrdinalIgnoreCase) ? "selected=\"selected\"" : null)>@AdminResource.PerfFilterAll</option>
                        <option value="controller" @(string.Equals(currentType, "controller", StringComparison.OrdinalIgnoreCase) ? "selected=\"selected\"" : null)>@AdminResource.TypeController</option>
                        <option value="service" @(string.Equals(currentType, "service", StringComparison.OrdinalIgnoreCase) ? "selected=\"selected\"" : null)>@AdminResource.TypeService</option>
                        <option value="repo" @(string.Equals(currentType, "repo", StringComparison.OrdinalIgnoreCase) ? "selected=\"selected\"" : null)>@AdminResource.TypeRepository</option>
                        <option value="other" @(string.Equals(currentType, "other", StringComparison.OrdinalIgnoreCase) ? "selected=\"selected\"" : null)>@AdminResource.TypeOther</option>
                    </select>
                </form>
            </div>

            <!-- Export Buttons identical to Brands page -->
            <fieldset class="eg-ops-export" style="border:0;padding:0;margin:0;min-width:0">
                <legend class="visually-hidden">@AdminResource.Excel</legend>
                <a class="btn btn-secondary btn-sm eg-ops-btn eg-ops-btn-export" href="@Url.Action("ExportExcel", "Perf", new { area = "admin", format = "excel", search = currentSearch, type = currentType })" title="@AdminResource.Excel">
                    <i class="fa-solid fa-upload" aria-hidden="true"></i>
                    <span>@AdminResource.Excel</span>
                </a>
                <a class="btn btn-secondary btn-sm eg-ops-btn eg-ops-btn-export" href="@Url.Action("ExportExcel", "Perf", new { area = "admin", format = "csv", search = currentSearch, type = currentType })" title="@AdminResource.Csv">
                    <i class="fa-solid fa-download" aria-hidden="true"></i>
                    <span>@AdminResource.Csv</span>
                </a>
            </fieldset>
        </div>
    </div>
</div>

<!-- Griddly Data Grid Container -->
@Html.Partial("Grid/_GridChrome")
<div class="js-griddly-async" data-url="@Url.Action("IndexGrid", new { search = currentSearch, type = currentType })"></div>

<!-- Clear Stats Confirmation Modal -->
<div class="modal fade" id="clearPerfStatsModal" tabindex="-1" aria-labelledby="clearPerfStatsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="clearPerfStatsModalLabel"><i class="fa-solid fa-trash me-2"></i>@AdminResource.ClearPerfStatsTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("ClearStats", "Perf", new { area = "admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <p>@AdminResource.ClearPerfStatsConfirm</p>
                    <div class="alert alert-warning py-2 small mb-0">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i> @AdminResource.ClearPerfStatsWarning
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@AdminResource.Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash me-1"></i> @AdminResource.ClearStatsNow</button>
                </div>
            }
        </div>
    </div>
</div>
