@model List<List>
@using EImece.Domain.Helpers;
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain;
@using EImece.Domain.Entities;
@using Resources;
@using EImece.Domain.Helpers.Extensions;

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = Request.QueryString["GridPageSize"].ToInt();
    pageSizeNumber = pageSizeNumber == 0 ? AppConfig.GridPageSizeNumber : pageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : pageSizeNumber * (gridPage - 1);

    var controllerName = "Lists";
    var gridName = "ListGrid";
    var contents = Model;
    var baseList = contents.DownCasting();
}

<h2>@AdminResource.ProductSpecTemplateItemList</h2>
<hr class="adminLine" />

<div class="admin-workflow-callout">
    <strong>Değer listeleri</strong> şablonlardaki açılır menü seçenekleridir.
    Yeni kayıtta <em>Rastgele örnek liste oluştur</em> kullanın; liste adı şablondaki <code>values="..."</code> ile aynı olmalı.
    Sonraki adım: <a href="@Url.Action("Index", "Templates")">Şablonlar</a>.
</div>

<div class="panel panel-info">
    @Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
            {"controllerName",controllerName}
                      ,{"StateTypes","State"}
           ,{"orderingButton",true}
           ,{"selectAll",true}
           ,{"deleteAll",true}
            ,{"SetStateOnOrOff",true}})
</div>

@Html.Partial("Grid/_GridChrome")

<div class="panel panel-primary eg-grid-shell">
    @Html.Partial("pGridDropDown", baseList)
    @Html.Grid(contents).Named(gridName).Columns(columns =>
{
columns.Add()
.Encoded(false)
.Sanitized(false)
.Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
.RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

columns.Add(o => o.Id, true);

columns.Add()
.Encoded(false)
.Sanitized(false)
.Css("gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check")
.RenderValueAs(d => Html.Partial("pGridCheckbox", new ViewDataDictionary(ViewData){
            {"ItemId",d.Id}}));

columns.Add(c => c.Name)
.Titled(AdminResource.Title)
.Filterable(true)
.Encoded(false)
.Sanitized(false)
.Css("eg-col-name")
.RenderValueAs(d => Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) {
    { "Name", d.Name },
    { "ItemId", d.Id.ToString() }
}));

columns.Add(o => o.IsService)
.Titled(AdminResource.IsService)
.Sortable(true)
.Css("smallGridColumn")
.SortInitialDirection(GridSortDirection.Descending).Encoded(false)
.Sanitized(false)
.RenderValueAs(o => String.Format("<span  gridkey-id='{0}' grid-data-value='{2}'  {1}  name='spanImageState'></span>",
                                              o.Id, (o.IsService ? Constants.OkStyle : Constants.CancelStyle), o.IsService));

columns.Add(o => o.IsValues)
.Titled(AdminResource.IsValues)
.Sortable(true)
.Css("smallGridColumn")
.SortInitialDirection(GridSortDirection.Descending).Encoded(false)
.Sanitized(false)
.RenderValueAs(o => String.Format("<span  gridkey-id='{0}' grid-data-value='{2}'  {1}  name='spanImageState'></span>",
                                            o.Id, (o.IsValues ? Constants.OkStyle : Constants.CancelStyle), o.IsValues));

columns.Add()
.Titled("İşlemler")
.Encoded(false)
.Sanitized(false)
.Css("eg-sticky-right eg-col-actions")
.RenderValueAs(d => Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
    { "ItemId", d.Id },
    { "ItemName", d.Name },
    { "controllerName", controllerName },
    { "ShowMedia", false },
    { "ShowEdit", true },
    { "ShowDelete", true }
}));

}).SetRowCssClasses(item => item.Id % 2 == 0 ? "warning" : string.Empty).WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
</div>
