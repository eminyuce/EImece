@model List<EImece.Domain.Entities.List>
@using Griddly.Mvc
@using EImece.Domain.Helpers
@using Resources

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var controllerName = "Lists";
}

@Html.AdminBreadcrumb(AdminResource.ProductSpecTemplateItemList)
<h2 class="admin-page-title">@AdminResource.ProductSpecTemplateItemList</h2>
<hr class="adminLine" />

<div class="admin-workflow-callout">
    <strong>Değer listeleri</strong> şablonlardaki açılır menü seçenekleridir.
    Yeni kayıtta <em>Rastgele örnek liste oluştur</em> kullanın; liste adı şablondaki <code>values="..."</code> ile aynı olmalı.
    Sonraki adım: <a href="@Url.Action("Index", "Templates")">Şablonlar</a>.
</div>

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
    {"controllerName",controllerName},
    {"StateTypes","State"},
    {"orderingButton",true},
    {"selectAll",true},
    {"deleteAll",true},
    {"SetStateOnOrOff",true}
})

@Html.Partial("Grid/_GridChrome")

<div class="js-griddly-async" data-url="@Url.Action("IndexGrid", new { search = Request.QueryString["search"] })"></div>
