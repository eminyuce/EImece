@model IEnumerable<EImece.Domain.Models.DTOs.CouponRedemptionDetailDto>
@using Resources
@{
    ViewBag.Title = AdminResource.CouponRedemptionsTitle;
    var coupon = ViewBag.Coupon as EImece.Domain.Entities.Coupon;
}
<h2>@string.Format(AdminResource.RedemptionsFor, coupon.Code + " (" + coupon.Name + ")")</h2>
<table class="table table-striped table-bordered">
<thead>
<tr><th>@AdminResource.Id</th><th>@AdminResource.CouponCode</th><th>@AdminResource.OrderId</th><th>@AdminResource.OrderNumber</th><th>@AdminResource.Customer</th><th>@AdminResource.UserId</th><th>@AdminResource.Discount</th><th>@AdminResource.Date</th></tr>
</thead>
<tbody>
@foreach(var r in Model)
{
    <tr>
        <td>@r.Id</td>
        <td>@r.CouponCode</td>
        <td>@r.OrderId</td>
        <td><a href="@Url.Action("Detail","Orders", new { id = r.OrderId })">@r.OrderNumber</a></td>
        <td>@r.CustomerName</td>
        <td>@r.UserId</td>
        <td>@r.DiscountAmount</td>
        <td>@r.CreatedDate</td>
    </tr>
}
</tbody>
</table>
<a href="@Url.Action("SaveOrEdit", new { id = coupon.Id })" class="btn btn-secondary">@AdminResource.BackToCoupon</a>
<a href="@Url.Action("Index")" class="btn btn-outline-secondary">@AdminResource.Coupons</a>
