@model EImece.Domain.Entities.Coupon
@using EImece.Domain.Models.Enums;
@using Resources;

@{
    var saveButtonText = AdminResource.SaveButtonText;
    ViewBag.Title = AdminResource.Coupon;
}

<h2>@AdminResource.Coupon</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "couponsHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada müşterilerin sepette kullanacağı <strong>indirim kuponu</strong> oluşturur veya düzenlersiniz.</li>
    <li><strong>Kupon adı</strong>: Yönetim panelinde görünen isim (müşteriye gösterilmez).</li>
    <li><strong>Kod</strong>: Müşterinin yazacağı kupon kodu (ör. <code>YAZ2026</code>).</li>
    <li><strong>Sabit indirim</strong> ve <strong>yüzde indirim</strong> alanlarından <strong>yalnızca birini</strong> doldurun. Sabit tutar doluysa yüzde yok sayılır.</li>
    <li><strong>Başlangıç / Bitiş tarihi</strong>: Biçim <code>gg/aa/yy</code> (ör. <code>01/08/26</code>). Bitiş tarihi başlangıçtan sonra olmalıdır.</li>
    <li><strong>Yayında mı</strong>: İşaretliyse kupon kullanılabilir.</li>
</ul>
<p style="margin-top: 12px; margin-bottom: 6px;"><strong>Örnek 1 — Sabit tutar indirimi:</strong></p>
<pre style="background:#f9f9f9; border:1px solid #cce5ff; padding:10px; margin-bottom:12px; white-space:pre-wrap;">Kod: 50TLINDIRIM
Sabit indirim: 50
Yüzde indirim: 0
Başlangıç: 01/08/26
Bitiş: 31/08/26</pre>
<p style="margin-bottom: 6px;"><strong>Örnek 2 — Yüzde indirim:</strong></p>
<pre style="background:#f9f9f9; border:1px solid #cce5ff; padding:10px; margin-bottom:0; white-space:pre-wrap;">Kod: YUZDE20
Sabit indirim: 0
Yüzde indirim: 20
Başlangıç: 01/09/26
Bitiş: 30/09/26</pre>
@Html.Partial("_AdminHelpAccordionEnd")

@using (Html.BeginForm())
{
@Html.AntiForgeryToken()

<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "alert alert-success" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.CreatedDate)
    @Html.HiddenFor(model => model.UpdatedDate)

    <div class="form-group">
        <label class="control-label col-md-2" for="@AdminResource.CouponName">@AdminResource.CouponName</label>
        <div class="col-md-10">
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.Code, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.Discount, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Discount, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Discount, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.DiscountPercentage, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.DiscountPercentage, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.DiscountPercentage, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.StartDateStr, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.StartDateStr, new { htmlAttributes = new { @class = "form-control", @data_date_picker = "1" } })
            @Html.ValidationMessageFor(model => model.StartDateStr, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.EndDateStr, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.EndDateStr, new { htmlAttributes = new { @class = "form-control", @data_date_picker = "2" } })
            @Html.ValidationMessageFor(model => model.EndDateStr, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-3">
        </div>
        <div class="col-md-3">
            @Html.LabelFor(model => model.IsActive)
            @Html.EditorFor(model => model.IsActive)
            @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Position, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Position, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Position, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="@saveButtonText" class="btn btn-success btn-block" />
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            @Html.ActionLink("Kupon listesine dön", "Index", null, new { @class = "btn btn-default btn-block" })
        </div>
    </div>
</div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script>
    $(function () {
        $('[data-date-picker]').datepicker({
            dateFormat: 'dd/mm/yy',
            defaultDate: ""
        });

    });
</script>
