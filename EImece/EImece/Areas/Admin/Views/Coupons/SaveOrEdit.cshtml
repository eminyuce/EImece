@model EImece.Domain.Entities.Coupon
@using EImece.Domain.Models.Enums;
@using Resources;

@{
    var saveButtonText = AdminResource.SaveButtonText;
    var saveButtonAndCloseText = AdminResource.SaveButtonAndCloseText;
    ViewBag.Title = AdminResource.Coupon;
}

<h2>@AdminResource.Coupon</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "couponsHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada müşterilerin sepette kullanacağı <strong>indirim kuponu</strong> oluşturur veya düzenlersiniz.</li>
    <li><strong>Kupon adı</strong>: Yönetim panelinde görünen isim (müşteriye gösterilmez).</li>
    <li><strong>Kod</strong>: customer yazacağı kupon kodu (ör. <code>YAZ2026</code>).</li>
    <li><strong>Sabit indirim</strong> ve <strong>yüzde indirim</strong> alanlarından <strong>yalnızca birini</strong> doldurun. Sabit tutar doluysa yüzde yok sayılır.</li>
    <li><strong>Başlangıç / Bitiş tarihi</strong>: Biçim <code>gg/aa/yy</code> (ör. <code>01/08/26</code>). Bitiş tarihi başlangıçtan sonra olmalıdır.</li>
    <li><strong>Yayında mı</strong>: İşaretliyse kupon kullanılabilir.</li>
</ul>
<p style="margin-top: 12px; margin-bottom: 6px;"><strong>Örnek 1 — Sabit tutar indirimi:</strong></p>
<pre style="background:#f9f9f9; border:1px solid #cce5ff; padding:10px; margin-bottom:12px; white-space:pre-wrap;">Kod: 50TLINDIRIM
Sabit indirim: 50
Yüzde indirim: 0
Başlangıç: 01/08/26
Bitiş: 31/08/26</pre>
<p style="margin-bottom: 6px;"><strong>Örnek 2 — Yüzde indirim:</strong></p>
<pre style="background:#f9f9f9; border:1px solid #cce5ff; padding:10px; margin-bottom:0; white-space:pre-wrap;">Kod: YUZDE20
Sabit indirim: 0
Yüzde indirim: 20
Başlangıç: 01/09/26
Bitiş: 30/09/26</pre>
@Html.Partial("_AdminHelpAccordionEnd")

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.AdminValidationSummary()
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.CreatedDate)
        @Html.HiddenFor(model => model.UpdatedDate)

        <div class="card admin-edit-form">
            @Html.Partial("_AdminEditSimpleToolbar")
            <div class="card-body">
                <div class="form-group row mb-3">
                    <label class="col-form-label col-md-2" for="@AdminResource.CouponName">@AdminResource.CouponName</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row mb-3">
                    @Html.LabelFor(model => model.Code, htmlAttributes: new { @class = "col-form-label col-md-2" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @class = "form-control", id = "CouponCode" } })
                        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100" onclick="document.getElementById('CouponCode').value='CPN'+Math.random().toString(36).substring(2,8).toUpperCase()">Generate</button>
                    </div>
                </div>
                <div class="form-group row mb-3">
                    <label class="col-form-label col-md-2">Customer Specific</label>
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.AssignedUserId, new { htmlAttributes = new { @class = "form-control", placeholder = "UserId (AspNetUsers Id) or leave empty for global" } })
                        <small class="text-muted">Leave empty for global coupon, or enter UserId for per-customer</small>
                    </div>
                    <label class="col-form-label col-md-2">CustomerId</label>
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.AssignedCustomerId, new { htmlAttributes = new { @class = "form-control", placeholder = "Customer Id" } })
                    </div>
                </div>
                <div class="form-group row mb-3">
                    @Html.LabelFor(model => model.Discount, htmlAttributes: new { @class = "col-form-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Discount, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Discount, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row mb-3">
                    @Html.LabelFor(model => model.DiscountPercentage, htmlAttributes: new { @class = "col-form-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.DiscountPercentage, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.DiscountPercentage, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group row mb-3">
                    @Html.LabelFor(model => model.DiscountType, htmlAttributes: new { @class = "col-form-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EnumDropDownListFor(model => model.DiscountType, new { @class = "form-control" })
                        <small class="text-muted">Fixed = use Discount, Percentage = use DiscountPercentage, FreeShipping = shipping becomes 0</small>
                    </div>
                </div>
                <div class="form-group row mb-3">
                    <label class="col-form-label col-md-2">Max Discount (for %)</label>
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.MaximumDiscountAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g., 200 for max 200 TRY cap" } })
                    </div>
                    <label class="col-form-label col-md-2">Currency</label>
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.Currency, new { htmlAttributes = new { @class = "form-control", placeholder = "TRY, USD or empty for any" } })
                    </div>
                </div>
                <hr />
                <h5>Usage Limits</h5>
                <div class="form-group row mb-3">
                    <label class="col-form-label col-md-2">Global Limit</label>
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.GlobalUsageLimit, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g., 100 or empty unlimited" } })
                    </div>
                    <label class="col-form-label col-md-2">Per-Customer Limit</label>
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.PerCustomerUsageLimit, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g., 1 for one-time" } })
                    </div>
                </div>
                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.IsFirstOrderOnly) @Html.EditorFor(model => model.IsFirstOrderOnly)
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.IsNewCustomerOnly) @Html.EditorFor(model => model.IsNewCustomerOnly)
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.AllowStacking) @Html.EditorFor(model => model.AllowStacking)
                        <small class="text-muted d-block">Allow stacking (default single coupon)</small>
                    </div>
                </div>
                @if (ViewBag.TotalRedemptions != null)
                {
                    <div class="alert alert-info py-2">
                        Total redemptions: @ViewBag.TotalRedemptions
                        @if (ViewBag.RemainingRedemptions != null) { <span> | Remaining: @ViewBag.RemainingRedemptions</span> }
                        @if (Model.Id > 0) { <a class="btn btn-sm btn-outline-primary ml-2" href="@Url.Action("Redemptions", new { id = Model.Id })">View redemptions</a> }
                    </div>
                }
                <hr />
                <h5>Cart Rules</h5>
                <div class="form-group row mb-3">
                    <label class="col-form-label col-md-2">Min Order Amount</label>
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.MinimumOrderAmount, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g., 500" } })
                        <small class="text-muted">Minimum eligible subtotal (excl. shipping)</small>
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.ExcludeSaleItems) @Html.EditorFor(model => model.ExcludeSaleItems)
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.IsFreeShipping) @Html.EditorFor(model => model.IsFreeShipping)
                    </div>
                </div>
                <div class="form-group row mb-3">
                    <label class="col-form-label col-md-2">Product IDs (csv)</label>
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.ProductIdsCsv, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g., 1,5,20" } })
                        <small class="text-muted">Only these products eligible (empty = all). OR logic with categories.</small>
                    </div>
                    <label class="col-form-label col-md-2">Category IDs (csv)</label>
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.CategoryIdsCsv, new { htmlAttributes = new { @class = "form-control", placeholder = "e.g., 3,7" } })
                    </div>
                </div>
                <hr />
                <h5>Audience</h5>
                <div class="form-group row mb-3">
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.RequireLogin) @Html.EditorFor(model => model.RequireLogin)
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.IsBirthdayCoupon) @Html.EditorFor(model => model.IsBirthdayCoupon)
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.BirthdayWindow) @Html.EnumDropDownListFor(model => model.BirthdayWindow, "No birthday", new { @class = "form-control" })
                    </div>
                </div>
                <div class="form-group row mb-3">
                    @Html.LabelFor(model => model.StartDateStr, htmlAttributes: new { @class = "col-form-label col-md-2" })
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.StartDateStr, new { htmlAttributes = new { @class = "form-control", @data_date_picker = "1" } })
                        @Html.ValidationMessageFor(model => model.StartDateStr, "", new { @class = "text-danger" })
                    </div>
                    @Html.LabelFor(model => model.EndDateStr, htmlAttributes: new { @class = "col-form-label col-md-2" })
                    <div class="col-md-4">
                        @Html.EditorFor(model => model.EndDateStr, new { htmlAttributes = new { @class = "form-control", @data_date_picker = "2" } })
                        @Html.ValidationMessageFor(model => model.EndDateStr, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row mb-3">
                    <div class="col-md-3">
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(model => model.IsActive)
                        @Html.EditorFor(model => model.IsActive)
                        @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group row mb-3">
                    @Html.LabelFor(model => model.Position, htmlAttributes: new { @class = "col-form-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Position, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Position, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script>
    $(function () {
        $('[data-date-picker]').datepicker({
            dateFormat: 'dd/mm/yy',
            defaultDate: ""
        });

    });
</script>
