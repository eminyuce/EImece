@model List<ProductComment>
@using EImece.Domain.Helpers;
@using GridMvc.Html
@using GridMvc.Sorting;
@using EImece.Domain;
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Entities;
@using Resources;
@using EImece.Domain.Helpers.Extensions;
@{
    ViewBag.Title = "ProductComments";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : AppConfig.GridPageSizeNumber * (gridPage - 1);

    var controllerName = "ProductComments";
    var gridName = "ProductCommentGrid";
    var contents = Model;
    var baseList = contents.DownCasting();
    var search = Request.QueryString["search"].ToStr();
    var ExportToExcel = AdminResource.ExportToExcel;
    Product product = ViewBag.Product;
}

<h2>@AdminResource.ProductComments</h2>
<hr class="adminLine" />
<div class="row">
    <div class="col-md-4">
        <h3>
            @Html.DisplayFor(model => product.Name)
            @Html.ActionLink(AdminResource.BackToList, "index", "products", new { search = product.Name }, new { @class = "btn btn-link" })
        </h3>
    </div>
    <div class="col-md-8">
    </div>
</div>

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
        {"controllerName",controllerName}
        ,{"StateTypes","State"}
       ,{"orderingButton",false}
       ,{"selectAll",true}
       ,{"deleteAll",true}  ,{"IdValueExists",true}
        ,{"SetStateOnOrOff",true},
{ "IsNewRecordButtonEnabled",false},{"IsExcelButtonEnabled",true}})

@Html.Partial("Grid/_GridChrome")

<div class="panel panel-primary eg-grid-shell">
    @Html.Partial("pGridDropDown", baseList)

    @Html.Grid(contents).Named(gridName).Columns(columns =>
{
    columns.Add()
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
        .RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

    columns.Add(o => o.Id, true);

    columns.Add()
        .Encoded(false)
        .Sanitized(false)
        .Css("gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check")
        .RenderValueAs(d => Html.Partial("pGridCheckbox", new ViewDataDictionary(ViewData){
            {"ItemId",d.Id}}));

    columns.Add(c => c.Subject)
        .Titled(AdminResource.ReviewSubject)
        .Filterable(true)
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-col-name")
        .RenderValueAs(d => Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) {
            { "Name", d.Subject },
            { "ItemId", d.Id.ToString() }
        }));

    columns.Add(c => c.Email)
        .Titled(AdminResource.Email)
        .Filterable(true);

    columns.Add(c => c.Rating)
        .Titled(AdminResource.Rating)
        .Filterable(true)
        .Encoded(false)
        .Sanitized(false)
        .Css("smallGridColumn")
        .RenderValueAs(o => String.Format("{0} Yıldız", o.Rating));

    columns.Add(o => o.Review)
        .Titled(AdminResource.Review)
        .Encoded(false)
        .Sanitized(false)
        .RenderValueAs(o => String.Format("<label class='sr-only' for='pcomment-{0}'>Yorum</label><textarea id='pcomment-{0}' readonly  style='height: 146px; background-color: transparent; width: 399px; margin: 0px;'>{1}</textarea>", o.Id, o.Review));

    columns.Add(o => o.IsActive)
        .Titled(AdminResource.IsActive)
        .Sortable(true)
        .Css("smallGridColumn eg-col-status")
        .SortInitialDirection(GridSortDirection.Descending)
        .Encoded(false)
        .Sanitized(false)
        .RenderValueAs(o => Html.Partial("Grid/_GridStatusToggles", null, new ViewDataDictionary(ViewData) {
            { "ItemId", o.Id },
            { "IsActive", o.IsActive },
            { "ShowState", true },
            { "ShowMainPage", false },
            { "ShowImageState", false }
        }));

    columns.Add(o => o.UpdatedDate)
        .Titled(AdminResource.UpdatedDate)
        .Sortable(true)
        .Css("gridDateClass")
        .RenderValueAs(o => o.UpdatedDate != null ? String.Format("{0}", o.UpdatedDate.ToShortDateString()) : null)
        .SortInitialDirection(GridSortDirection.Descending);

    if (UserRoleHelper.IsDeletedEnableRoles())
    {
        columns.Add()
            .Titled("İşlemler")
            .Encoded(false)
            .Sanitized(false)
            .Css("eg-sticky-right eg-col-actions")
            .RenderValueAs(d => Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
                { "ItemId", d.Id },
                { "ItemName", d.Subject + " " + d.Review },
                { "controllerName", controllerName },
                { "ShowMedia", false },
                { "ShowEdit", false },
                { "ShowDelete", true }
            }));
    }

}).SetRowCssClasses(item => item.IsActive ? string.Empty : "GridIsActive").WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
</div>
