@model EImece.Domain.Entities.MailTemplate
@using EImece.Domain.Models.AdminModels
@using Resources;
@{
    ViewBag.Title = "Mail Template";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var saveButtonText = AdminResource.SaveButtonText;
    var ExistingMainImageText = AdminResource.ExistingMainImageText;
    var saveButtonAndCloseText = AdminResource.SaveButtonAndCloseText;
    ViewBag.ContentSectionTitle = AdminResource.MailBody;
}

<h2>@AdminResource.MailTemplates</h2>
<div class="mail-template-test-toolbar">
    <button type="button"
            class="btn btn-info js-mail-template-test"
            data-template-id="@(Model != null ? Model.Id : 0)"
            data-template-name="@(Model != null ? Model.Name : "Taslak")"
            data-use-editor="true"
            title="Şablonu SMTP ile test e-postası olarak gönder">
        <i class="fa fa-paper-plane" aria-hidden="true"></i>
        Test E-posta Gönder
    </button>
</div>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "mailTemplatesHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada sistemin gönderdiği <strong>e-posta şablonlarını</strong> düzenlersiniz (sipariş onayı, şifre sıfırlama vb.).</li>
    <li><strong>İsim</strong>: Sistemin şablonu bulduğu anahtar ad. Düzenlerken genelde değiştirilmemelidir.</li>
    <li><strong>Konu</strong>: E-posta konusu. Dinamik alanlar Razor sözdizimi ile yazılabilir.</li>
    <li><strong>E-Posta İçerik</strong>: 2. sekmedeki editörde düzenlenen HTML e-posta içeriği.</li>
    <li><strong>Yayında / Sıra</strong>: Şablonun kullanımı ve listelenme sırası.</li>
    <li><strong>Test E-posta</strong>: Şablonu kaydetmeden veya kaydettikten sonra SMTP ayarlarıyla gerçek bir deneme e-postası gönderebilirsiniz. Model alanları şablondaki <code>@@Model</code> özelliklerinden otomatik üretilir.</li>
</ul>
<p style="margin-top: 12px; margin-bottom: 6px;"><strong>Örnek 1 — Konu:</strong></p>
<pre style="background:#f9f9f9; border:1px solid #cce5ff; padding:10px; margin-bottom:12px; white-space:pre-wrap;">Siparişiniz alındı - #@@Model.OrderNumber</pre>
<p style="margin-bottom: 6px;"><strong>Örnek 2 — Kısa gövde:</strong></p>
<pre style="background:#f9f9f9; border:1px solid #cce5ff; padding:10px; margin-bottom:0; white-space:pre-wrap;">&lt;p&gt;Merhaba @@Model.CustomerName,&lt;/p&gt;
&lt;p&gt;Siparişiniz başarıyla alındı.&lt;/p&gt;</pre>
@Html.Partial("_AdminHelpAccordionEnd")

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "editor-form" }))
{
@Html.AntiForgeryToken()

<div class="form-horizontal">
    @Html.AdminValidationSummary()
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.AddUserId)
    @Html.HiddenFor(model => model.UpdatedDate)
    @Html.HiddenFor(model => model.CreatedDate)
    @Html.HiddenFor(model => model.TrackWithBitly)
    @Html.HiddenFor(model => model.TrackWithMlnk)

    <div class="card admin-edit-form">
                @Html.Partial("_AdminEditFormToolbar")
                <div class="card-body">
                    <div class="tab-content">
                        <div id="admin-edit-tab-fields" class="tab-pane fade show active" role="tabpanel">
<div class="form-group row mb-3">
                        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "col-form-label col-md-2" })
                        <div class="col-md-10">
                            @if (Model.Id > 0)
                            {
                            <b>
                                @Model.Name
                            </b>
                            @Html.HiddenFor(model => model.Name)
                            }
                            else
                            {
                            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                            }

                            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        @Html.LabelFor(model => model.Subject, htmlAttributes: new { @class = "col-form-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Subject, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Subject, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <div class="col-md-3">
                        </div>
                        <div class="col-md-3">
                            @Html.LabelFor(model => model.IsActive)
                            @Html.EditorFor(model => model.IsActive)
                            @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group row mb-3">
                        @Html.LabelFor(model => model.Position, htmlAttributes: new { @class = "col-form-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.Position, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Position, "", new { @class = "text-danger" })
                        </div>
                    </div>
                            @Html.Partial("_AdminEditNextStep")
                        </div>
                        <div id="admin-edit-tab-content" class="tab-pane fade" role="tabpanel">
                            @Html.Partial("_AdminEditBackToFields")
<div class="form-group row mb-3">
                        <div class="col-md-12">
                            @Html.TextAreaFor(model => model.Body, 50, 50, new { @class = "form-control" })
                        </div>
                    

                    </div>
                        </div>
                    </div>
                </div>
            </div>
</div>
        }

@Html.Partial("_AuditFields", Model)

@Html.Partial("_AdminEditBackToList")
@Html.Partial("_TestEmailModal")