@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using Griddly.Mvc
@using Resources

@{
    Layout = null;
    var gridName = "MainPageImageGrid";
    int pageSizeNumber = ViewBag.GridPageSizeNumber != null ? (int)ViewBag.GridPageSizeNumber : AdminSettings.GridPageSizeNumber;
    int rowNum = 0;
    int startIndex = 0;

    var controllerName = "MainPageImages";

    var settings = new GriddlySettings<MainPageImage>()
    {
        ClassName = "eg-grid eg-grid-shell",
        TableClassName = "table table-hover table-striped eg-grid-table",
        PageSize = pageSizeNumber,
        AllowedFilterModes = FilterMode.None,
        RowClass = item => item.IsActive ? string.Empty : "GridIsActive",
        DefaultSort = new[] { new SortField() { Field = "UpdatedDate", Direction = SortDirection.Descending } }
    };

    settings.HtmlAttributes["data-gridname"] = gridName;

    settings.BeforeTemplate = @<text>
        <output class="card-header grid-record-count" style="display:block" aria-live="polite">
            <div class="grid-record-count-inner">
                <span class="grid-record-count-badge griddly-recordtotal"></span>
                <span class="grid-record-count-label">@AdminResource.GridResultRecordNumber</span>
            </div>
            <div class="eg-grid-scroll-controls" title="Tabloyu Sağa/Sola Kaydır">
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-left" title="Sola Kaydır" aria-label="Sola Kaydır">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-right" title="Sağa Kaydır" aria-label="Sağa Kaydır">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </output>
    </text>;

    settings
        .Column(caption: "", template: @<text><span class="eg-row-index">@(startIndex + (++rowNum))</span></text>, className: "eg-sticky-left eg-sticky-left-1 eg-col-index", width: "44px")
        .Column(caption: "", template: @<text><input gridkey-id="@item.Id" class="gridCheckboxes" name="checkboxGrid" type="checkbox" /></text>, className: "gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check", width: "44px")
        .Column(caption: AdminResource.Images, template: @<text>@Html.Partial("Grid/_GridImageCell", item, new ViewDataDictionary(ViewData) { { "ShowImageState", true } })</text>, className: "eg-col-image", width: "80px")
        .Column(x => x.Name, caption: AdminResource.Name, template: @<text>@Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) { { "Name", item.Name }, { "ItemId", item.Id.ToString() } })</text>, className: "eg-col-name", width: "300px")
        .Column(x => x.Position, caption: AdminResource.Position, template: @<text><label class="visually-hidden" for="mpi-pos-@item.Id">Sıra</label><input id="mpi-pos-@item.Id" gridkey-id="@item.Id" value="@item.Position" class="GridOrderingTextbox input-xs" name="gridOrdering" type="text" /></text>, className: "smallGridColumn", width: "80px")
        .Column(x => x.IsActive, caption: AdminResource.IsActive, template: @<text>@Html.Partial("Grid/_GridStatusToggles", null, new ViewDataDictionary(ViewData) { { "ItemId", item.Id }, { "IsActive", item.IsActive }, { "ShowState", true }, { "ShowMainPage", false }, { "ShowImageState", false } })</text>, className: "smallGridColumn eg-col-status", width: "120px")
        .Column(x => x.UpdatedDate, caption: AdminResource.UpdatedDate, template: @<text>@(item.UpdatedDate.ToShortDateString())</text>, className: "gridDateClass", width: "130px")
        .Column(caption: AdminResource.Actions, template: @<text>@Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) { { "ItemId", item.Id }, { "ItemName", item.Name }, { "controllerName", controllerName }, { "ShowMedia", false }, { "ShowEdit", true }, { "ShowDelete", true } })</text>, className: "eg-sticky-right eg-col-actions", width: "132px");
}

@Html.Griddly(settings)
