@model List<EImece.Domain.Entities.MainPageImage>
@using Griddly.Mvc
@using Resources

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var controllerName = "MainPageImages";
}

<h2>@AdminResource.MainPageImages</h2>
<hr class="adminLine" />

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
    {"controllerName",controllerName},
    {"StateTypes","State"},
    {"orderingButton",true},
    {"selectAll",true},
    {"deleteAll",true},
    {"SetStateOnOrOff",true}
})

@Html.Griddly("IndexGrid", new { search = Request.QueryString["search"] })
