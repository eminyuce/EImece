@model EImece.Domain.Entities.MainPageImage
@using EImece.Domain.Entities;
@using EImece.Domain.Models.Enums;

@using Resources;
@{
    ViewBag.Title = "SaveOrEdit";
    ViewBag.HelpSettingKey = "MainPageImages_help/info_section";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var saveButtonText = AdminResource.SaveButtonText;
    var ExistingMainImageText = AdminResource.ExistingMainImageText;
    var saveButtonAndCloseText = AdminResource.SaveButtonAndCloseText;
}

<h2>@AdminResource.MainPageImages</h2>
<hr class="adminLine" />

<div class="row" style="padding:20px;">

    @using (Html.BeginForm("SaveOrEdit", "MainPageImages", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {

    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        @Html.AdminValidationSummary()
        @Html.HiddenFor(model => model.Id)
        @Html.HiddenFor(model => model.AddUserId)
        @Html.HiddenFor(model => model.CreatedDate)
        @Html.HiddenFor(model => model.UpdatedDate)

        @Html.HiddenFor(model => model.Lang)

        <div class="card admin-edit-form">
                @Html.Partial("_AdminEditFormToolbar")
                <div class="card-body">
                    <div class="tab-content">
                        <div id="admin-edit-tab-fields" class="tab-pane fade show active" role="tabpanel">
<div class="form-group row mb-3">
                            @Html.AdminLabelFor(model => model.Name, htmlAttributes: new { @class = "col-form-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row mb-3">
                            @Html.AdminLabelFor(model => model.Link, htmlAttributes: new { @class = "col-form-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Link, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Link, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row mb-3">
                            @Html.AdminLabelFor(model => model.MetaKeywords, htmlAttributes: new { @class = "col-form-label col-md-2" })
                            <div class="col-md-10">
                                @Html.TextAreaFor(model => model.MetaKeywords, 2, 20, new { @class = "form-control" })
                                @Html.ValidationMessageFor(model => model.MetaKeywords, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row mb-3">
                            <div class="col-md-3">
                            </div>
                            <div class="col-md-3">
                                @Html.AdminLabelFor(model => model.IsActive)
                                @Html.EditorFor(model => model.IsActive)
                                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row mb-3">
                            @Html.AdminLabelFor(model => model.Position, htmlAttributes: new { @class = "col-form-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Position, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Position, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group row mb-3">
                            @Html.AdminLabelFor(model => model.MainImageId, htmlAttributes: new { @class = "col-form-label col-md-2" })
                            <div class="col-md-3">
                                <input type="file" name="postedImage" />
                                @Html.ValidationMessageFor(model => model.MainImageId, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-3">
                                @Html.AdminLabelFor(model => model.ImageState)
                                @Html.EditorFor(model => model.ImageState)
                                @Html.ValidationMessageFor(model => model.ImageState, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-3">
                                @Html.Partial("pGridImageMainPage", (BaseContent)Model)


                            </div>
                        </div>
                        @Html.Partial("pSliderResizing", (BaseContent)Model)
                            @Html.Partial("_AdminEditNextStep")
                        </div>
                        <div id="admin-edit-tab-content" class="tab-pane fade" role="tabpanel">
                            @Html.Partial("_AdminEditBackToFields")
<div class="form-group row mb-3">
                            <div class="col-md-12">
                                @Html.TextAreaFor(model => model.Description, new { @class = "form-control eimece-rich-text-editor" })
                            </div>
                        

                    </div>
                        </div>
                    </div>
                </div>
            </div>
    </div>
    }
</div>

@Html.Partial("_AdminEditBackToList")

@Html.Partial("_AuditFields", Model)

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        var $form = null;

        $(function () {

        });
    </script>

}