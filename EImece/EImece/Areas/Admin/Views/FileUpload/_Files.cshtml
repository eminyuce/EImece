<div class="admin-media-filepond-container">
    <!-- Top Action Toolbar matching blueimp UI -->
    <div class="admin-media-toolbar">
        <div class="admin-media-toolbar-left">
            <button type="button" class="btn btn-success filepond-btn-browse" title="Resimleri Seç">
                <i class="glyphicon glyphicon-plus"></i> <span>Resimler ekle...</span>
            </button>
            <button type="button" class="btn btn-primary filepond-btn-start" title="Yüklemeye Başla" disabled>
                <i class="glyphicon glyphicon-upload"></i> <span>Yüklemeye Başla</span>
            </button>
            <button type="button" class="btn btn-warning filepond-btn-cancel" title="Yüklemeyi İptal Et" disabled>
                <i class="glyphicon glyphicon-ban-circle"></i> <span>Yüklemeyi İptal Et</span>
            </button>
            <button type="button" class="btn btn-danger filepond-btn-delete" title="Sil / Listeyi Temizle" disabled>
                <i class="glyphicon glyphicon-trash"></i> <span>Sil</span>
            </button>
            <label class="admin-media-select-all" title="Tümünü Seç / Seçimi Kaldır">
                <input type="checkbox" class="filepond-toggle-all"> <span>Hepsi seç</span>
            </label>
        </div>

        <!-- Global Upload Progress Bar -->
        <div class="admin-media-toolbar-right filepond-global-progress-wrapper" style="display: none;">
            <div class="progress progress-striped active filepond-global-progress-bar-container">
                <div class="progress-bar progress-bar-success filepond-global-progress-bar" role="progressbar" style="width: 0%;"></div>
            </div>
            <div class="filepond-progress-extended">0.00 Mbit/s | 00:00:00 | 0.00 % | 0.00 MB / 0.00 MB</div>
        </div>
    </div>

    <!-- FilePond Input -->
    <div class="admin-media-filepond-wrapper">
        <input type="file" 
               class="filepond-fileupload-input" 
               name="files" 
               multiple 
               data-allow-reorder="true"
               data-max-file-size="20MB"
               data-max-files="50" />
    </div>
</div>