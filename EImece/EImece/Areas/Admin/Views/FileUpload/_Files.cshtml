<div class="admin-media-modern-uploader">
    <!-- Header Bar with Quick Status & Actions -->
    <div class="admin-media-upload-header" style="display: none;">
        <div class="admin-media-upload-status">
            <span class="badge badge-info admin-media-files-count-badge">
                <i class="glyphicon glyphicon-picture"></i> <span class="admin-media-count-text">0 Resim Seçildi</span>
            </span>
            <span class="admin-media-total-size-text text-muted" style="font-size: 12px; margin-left: 8px;"></span>
        </div>
        <div class="admin-media-upload-actions">
            <button type="button" class="btn btn-default btn-xs btn-clear-all-pond" title="Listeyi Temizle">
                <i class="glyphicon glyphicon-trash"></i> Tümünü Temizle
            </button>
        </div>
    </div>

    <!-- FilePond Input -->
    <div class="admin-media-filepond-wrapper">
        <input type="file" 
               class="filepond-fileupload-input" 
               name="files" 
               multiple 
               data-allow-reorder="true"
               data-max-file-size="20MB"
               data-max-files="50" />
    </div>
</div>