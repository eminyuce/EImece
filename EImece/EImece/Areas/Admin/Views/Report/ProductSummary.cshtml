@using Resources
﻿@model EImece.Domain.Models.AdminModels.DataSetReportViewModel
@using System.Collections.Generic
@using System.Data
@using EImece.Domain.Helpers
@{
    ViewBag.Title = "Ürün Özeti";
    ViewBag.ReportDescription = "Ürün satış ve stok özetini tarih, aktiflik ve kategori filtreleriyle gösterir.";
    ViewBag.ReportKey = "ProductSummary";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    bool hasData = false;
    DataTable firstTable = null;
    if (Model != null && Model.ReportData != null)
    {
        foreach (DataTable table in Model.ReportData.Tables)
        {
            if (table != null && table.Rows.Count > 0)
            {
                hasData = true;
                if (firstTable == null)
                {
                    firstTable = table;
                }
            }
        }
        if (firstTable == null && Model.ReportData.Tables.Count > 0)
        {
            firstTable = Model.ReportData.Tables[0];
        }
    }

    ViewBag.HasData = hasData;
    ViewBag.EmptyMessage = "Seçilen kriterlere uygun ürün özeti bulunamadı. Filtreleri değiştirerek tekrar deneyin.";

    var exportFilters = new Dictionary<string, object>();
    if (Model != null)
    {
        if (Model.StartDate.HasValue)
        {
            exportFilters["startDate"] = Model.StartDate.Value.ToString("yyyy-MM-dd");
        }
        if (Model.EndDate.HasValue)
        {
            exportFilters["endDate"] = Model.EndDate.Value.ToString("yyyy-MM-dd");
        }
        if (Model.IsActive.HasValue)
        {
            exportFilters["isActive"] = Model.IsActive.Value;
        }
        if (Model.ProductCategoryId.HasValue)
        {
            exportFilters["productCategoryId"] = Model.ProductCategoryId.Value;
        }
    }
    ViewBag.ExportFilters = exportFilters;
}

@Html.Partial("_ReportHeader")
@Html.Partial("_ReportExportButtons")

<div class="card report-filter-panel">
    <div class="card-header">Filtreler</div>
    <div class="card-body">
        @using (Html.BeginForm("ProductSummary", "Report", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReportActionName)

            <div class="report-filter-row">
                <div class="report-filter-field">
                    <div class="form-group row mb-3">
                        @Html.LabelFor(m => m.StartDate, "Başlangıç Tarihi")
                        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="report-filter-field">
                    <div class="form-group row mb-3">
                        @Html.LabelFor(m => m.EndDate, "Bitiş Tarihi")
                        @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="report-filter-field">
                    <div class="form-group row mb-3">
                        @Html.LabelFor(m => m.ProductCategoryId, "Kategori Id")
                        @Html.TextBoxFor(m => m.ProductCategoryId, new { @class = "form-control", type = "number" })
                        @Html.ValidationMessageFor(m => m.ProductCategoryId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="report-filter-field">
                    <div class="form-group row mb-3">
                        <label for="IsActive">Aktif Ürünler</label>
                        <div class="checkbox">
                            <label>
                                <input type="checkbox" id="IsActive" name="IsActive" value="true"
                                       @(Model != null && Model.IsActive.HasValue && Model.IsActive.Value ? "checked=\"checked\"" : null) />
                                Yalnızca aktif
                            </label>
                        </div>
                        @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="report-filter-field report-filter-actions">
                    <div class="form-group row mb-3">
                        <label>&nbsp;</label>
                        <div>
                            <button type="submit" class="btn btn-primary">Raporu Getir</button>
                        </div>
                    </div>
                </div>
            </div>

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        }
    </div>
</div>

@if (hasData && firstTable != null)
{
    @Html.Partial("_ReportKpis", firstTable)
    ViewBag.ReportTableTitle = "Sonuçlar";
    @Html.Partial("_ReportDataTable", firstTable)
}
else
{
    @Html.Partial("_ReportEmptyState")
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
