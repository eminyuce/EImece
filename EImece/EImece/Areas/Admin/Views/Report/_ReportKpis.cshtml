@using Resources
@model System.Data.DataTable
@using EImece.Domain.Helpers
@{
    var kpis = ReportUiHelper.TryBuildKpis(Model);
}

@if (kpis != null && kpis.Count > 0)
{
    <div class="report-kpi-row">
        @foreach (var kpi in kpis)
        {
            <div class="report-kpi-tile">
                <span class="report-kpi-label">@kpi.Label</span>
                <span class="report-kpi-value">@kpi.Value</span>
            </div>
        }
    </div>
}
