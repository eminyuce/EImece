@using Resources
@model System.Data.DataTable
@using System.Globalization
@using EImece.Domain.Helpers
@{
    var table = Model;
    var panelTitle = ViewBag.ReportTableTitle as string ?? "Sonuçlar";
    bool showPanel = ViewBag.ReportTableShowPanel as bool? ?? true;
    var tr = CultureInfo.GetCultureInfo("tr-TR");
}

@helper RenderTable(System.Data.DataTable data)
{
    <div class="table-responsive report-table-wrap">
        <table class="table table-striped table-bordered table-hover report-table">
            <thead>
                <tr>
                    @foreach (System.Data.DataColumn column in data.Columns)
                    {
                        var thClass = ReportUiHelper.IsRightAlignedColumn(column.ColumnName, column.DataType)
                            ? "report-cell-numeric"
                            : null;
                        <th class="@thClass">@ReportUiHelper.GetDisplayColumnName(column.ColumnName)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (System.Data.DataRow row in data.Rows)
                {
                    <tr>
                        @foreach (System.Data.DataColumn column in data.Columns)
                        {
                            var isNumeric = ReportUiHelper.IsRightAlignedColumn(column.ColumnName, column.DataType);
                            var isDate = column.DataType == typeof(DateTime)
                                         || column.DataType == typeof(DateTimeOffset)
                                         || (!string.IsNullOrEmpty(column.ColumnName)
                                             && column.ColumnName.IndexOf("Date", StringComparison.OrdinalIgnoreCase) >= 0);
                            var css = isNumeric ? "report-cell-numeric" : (isDate ? "report-cell-date" : null);
                            <td class="@css">@ReportUiHelper.FormatCell(row[column], column.ColumnName, column.DataType)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (table == null || table.Rows.Count == 0)
{
    @Html.Partial("_ReportEmptyState")
}
else if (showPanel)
{
    <div class="card report-results-panel">
        <div class="card-header">
            @panelTitle
            <span class="text-muted">(@table.Rows.Count.ToString("N0", tr) kayıt)</span>
        </div>
        <div class="card-body" style="padding:0;">
            @RenderTable(table)
        </div>
    </div>
}
else
{
    @RenderTable(table)
}
