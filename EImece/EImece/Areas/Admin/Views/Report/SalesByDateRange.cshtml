@using Resources
﻿@model System.Data.DataTable
@using System.Collections.Generic
@using EImece.Domain.Helpers
@{
    ViewBag.Title = "Tarih Aralığına Göre Satışlar";
    ViewBag.ReportDescription = "Seçilen tarih aralığındaki sipariş sayısı, toplam gelir ve ortalama sipariş tutarını gösterir.";
    ViewBag.ReportKey = "SalesByDateRange";
    ViewBag.HasData = Model != null && Model.Rows.Count > 0;
    ViewBag.EmptyTitle = Model == null ? "Rapor henüz oluşturulmadı" : "Sonuç bulunamadı";
    ViewBag.EmptyMessage = Model == null
        ? "Tarih aralığını seçip raporu getirin."
        : "Seçilen tarih aralığında satış verisi bulunamadı. Filtreleri değiştirerek tekrar deneyin.";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var exportFilters = new Dictionary<string, object>();
    if (ViewBag.StartDate != null)
    {
        exportFilters["startDate"] = ViewBag.StartDate;
    }
    if (ViewBag.EndDate != null)
    {
        exportFilters["endDate"] = ViewBag.EndDate;
    }
    ViewBag.ExportFilters = exportFilters;
}

@Html.Partial("_ReportHeader")
@Html.Partial("_ReportExportButtons")

<div class="card report-filter-panel">
    <div class="card-header">Filtreler</div>
    <div class="card-body">
        @using (Html.BeginForm("SalesByDateRange", "Report", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()

            <div class="report-filter-row">
                <div class="report-filter-field">
                    <div class="form-group row mb-3">
                        <label for="startDate">Başlangıç Tarihi</label>
                        <input type="date" class="form-control" id="startDate" name="startDate" value="@ViewBag.StartDate" required />
                    </div>
                </div>
                <div class="report-filter-field">
                    <div class="form-group row mb-3">
                        <label for="endDate">Bitiş Tarihi</label>
                        <input type="date" class="form-control" id="endDate" name="endDate" value="@ViewBag.EndDate" required />
                    </div>
                </div>
                <div class="report-filter-field report-filter-actions">
                    <div class="form-group row mb-3">
                        <label>&nbsp;</label>
                        <div>
                            <button type="submit" class="btn btn-primary">Raporu Getir</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (ViewBag.HasData)
{
    @Html.Partial("_ReportKpis", Model)
    @Html.Partial("_ReportDataTable", Model)
}
else
{
    @Html.Partial("_ReportEmptyState")
}
