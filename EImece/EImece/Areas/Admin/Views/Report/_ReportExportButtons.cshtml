@using System.Collections.Generic
@using System.Web.Routing
@using EImece.Domain.Helpers
@{
    var exportModel = ViewData.Model as ReportExportButtonsModel;
    string reportKey = exportModel != null
        ? exportModel.ReportKey
        : ViewBag.ReportKey as string;
    bool hasData = exportModel != null
        ? exportModel.HasData
        : (ViewBag.HasData as bool? ?? false);
    IDictionary<string, object> filters = exportModel != null
        ? exportModel.Filters
        : ViewBag.ExportFilters as IDictionary<string, object>;

    var baseRoute = new RouteValueDictionary
    {
        { "area", "Admin" },
        { "reportKey", reportKey }
    };

    if (filters != null)
    {
        foreach (var pair in filters)
        {
            if (!string.IsNullOrEmpty(pair.Key) && !baseRoute.ContainsKey(pair.Key))
            {
                baseRoute[pair.Key] = pair.Value;
            }
        }
    }

    var excelRoute = new RouteValueDictionary(baseRoute) { ["format"] = "excel" };
    var csvRoute = new RouteValueDictionary(baseRoute) { ["format"] = "csv" };
}

<div class="report-export-bar">
    @if (hasData && !string.IsNullOrWhiteSpace(reportKey))
    {
        <a class="btn btn-success btn-sm"
           href="@Url.Action("Export", "Report", excelRoute)">
            <i class="fa fa-file-excel-o"></i> Excel İndir
        </a>
        <a class="btn btn-secondary btn-sm"
           href="@Url.Action("Export", "Report", csvRoute)">
            <i class="fa fa-file-text-o"></i> CSV İndir
        </a>
    }
    else
    {
        <a class="btn btn-success btn-sm disabled" href="#" onclick="return false;">
            <i class="fa fa-file-excel-o"></i> Excel İndir
        </a>
        <a class="btn btn-secondary btn-sm disabled" href="#" onclick="return false;">
            <i class="fa fa-file-text-o"></i> CSV İndir
        </a>
        <span class="report-export-hint">Veri yokken dışa aktarma kullanılamaz.</span>
    }
</div>
