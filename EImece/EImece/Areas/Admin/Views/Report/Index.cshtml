@using Resources
@{
    ViewBag.Title = AdminResource.Reports;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    // Display metadata: Title + short user-friendly description
    var reportMeta = new Dictionary<string, Tuple<string, string>>(StringComparer.OrdinalIgnoreCase)
    {
        { "SalesByDateRange", Tuple.Create(AdminResource.ReportSalesByDateRangeTitle, AdminResource.ReportSalesByDateRangeDesc) },
        { "GetRegionalSalesReport", Tuple.Create(AdminResource.ReportGetRegionalSalesReportTitle, AdminResource.ReportGetRegionalSalesReportDesc) },
        { "OrderVolumeReport", Tuple.Create(AdminResource.ReportOrderVolumeReportTitle, AdminResource.ReportOrderVolumeReportDesc) },
        { "PaymentMethod", Tuple.Create(AdminResource.ReportPaymentMethodTitle, AdminResource.ReportPaymentMethodDesc) },
        { "PaymentStatus", Tuple.Create(AdminResource.ReportPaymentStatusTitle, AdminResource.ReportPaymentStatusDesc) },
        { "PaymentTransactionReport", Tuple.Create(AdminResource.ReportPaymentTransactionReportTitle, AdminResource.ReportPaymentTransactionReportDesc) },
        { "ProductSummary", Tuple.Create(AdminResource.ReportProductSummaryTitle, AdminResource.ReportProductSummaryDesc) },
        { "ProductStatsByDateRange", Tuple.Create(AdminResource.ReportProductStatsByDateRangeTitle, AdminResource.ReportProductStatsByDateRangeDesc) },
        { "PriceAnalysis", Tuple.Create(AdminResource.ReportPriceAnalysisTitle, AdminResource.ReportPriceAnalysisDesc) },
        { "ProductInventory", Tuple.Create(AdminResource.ReportProductInventoryTitle, AdminResource.ReportProductInventoryDesc) },
        { "FraudAnalysis", Tuple.Create(AdminResource.ReportFraudAnalysisTitle, AdminResource.ReportFraudAnalysisDesc) },
        { "FraudRiskReport", Tuple.Create(AdminResource.ReportFraudRiskReportTitle, AdminResource.ReportFraudRiskReportDesc) },
        { "PerformanceSystemReport", Tuple.Create(AdminResource.ReportPerformanceSystemReportTitle, AdminResource.ReportPerformanceSystemReportDesc) },
        { "CouponUsage", Tuple.Create(AdminResource.ReportCouponUsageTitle, AdminResource.ReportCouponUsageDesc) },
        { "ShipmentCompany", Tuple.Create(AdminResource.ReportShipmentCompanyTitle, AdminResource.ReportShipmentCompanyDesc) },
        { "FinancialReport", Tuple.Create(AdminResource.ReportFinancialReportTitle, AdminResource.ReportFinancialReportDesc) },
        { "UserAudit", Tuple.Create(AdminResource.ReportUserAuditTitle, AdminResource.ReportUserAuditDesc) }
    };

    var reportCategories = new Dictionary<string, List<string>>
    {
        { AdminResource.ReportCatAudit, new List<string> {
            "UserAudit"
        }},
        { AdminResource.ReportCatSales, new List<string> {
            "SalesByDateRange",
            "GetRegionalSalesReport",
            "OrderVolumeReport"
        }},
        { AdminResource.ReportCatPayment, new List<string> {
            "PaymentMethod",
            "PaymentStatus",
            "PaymentTransactionReport"
        }},
        { AdminResource.ReportCatProduct, new List<string> {
            "ProductSummary",
            "ProductStatsByDateRange",
            "PriceAnalysis",
            "ProductInventory"
        }},
        { AdminResource.ReportCatRisk, new List<string> {
            "FraudAnalysis",
            "FraudRiskReport",
            "PerformanceSystemReport"
        }},
        { AdminResource.ReportCatMarketing, new List<string> {
            "CouponUsage",
            "ShipmentCompany"
        }},
        { AdminResource.ReportCatFinance, new List<string> {
            "FinancialReport"
        }}
    };

    var categoryIcons = new Dictionary<string, string>
    {
        { AdminResource.ReportCatAudit, "fa-solid fa-users" },
        { AdminResource.ReportCatSales, "fa-solid fa-chart-column" },
        { AdminResource.ReportCatPayment, "fa-solid fa-credit-card" },
        { AdminResource.ReportCatProduct, "fa-solid fa-tags" },
        { AdminResource.ReportCatRisk, "fa-solid fa-triangle-exclamation" },
        { AdminResource.ReportCatMarketing, "fa-solid fa-paper-plane" },
        { AdminResource.ReportCatFinance, "fa-solid fa-briefcase" }
    };

    var allActions = new List<string> {
        "UserAudit",
        "CouponUsage", "FraudAnalysis", "PaymentMethod", "PaymentStatus",
        "GetRegionalSalesReport", "SalesByDateRange", "ShipmentCompany",
        "PerformanceSystemReport", "FinancialReport", "FraudRiskReport",
        "OrderVolumeReport", "PaymentTransactionReport", "ProductSummary",
        "PriceAnalysis", "ProductInventory", "ProductStatsByDateRange"
    };

    // Date-bound DataSet reports: Index uses POST. GetRegionalSalesReport and UserAudit are GET-only navigation.
    var postActions = new HashSet<string>(StringComparer.OrdinalIgnoreCase) {
        "PerformanceSystemReport", "FinancialReport", "FraudRiskReport",
        "OrderVolumeReport", "PaymentTransactionReport"
    };
}

<style>
    .report-index {
        margin: 0 0 28px;
        max-width: 1180px;
    }

    .report-index-header {
        margin-bottom: 22px;
    }

    .report-index-header h2 {
        margin: 0 0 8px;
    }

    .report-index-header p {
        margin: 0;
        color: #627d98;
        font-size: 14px;
        line-height: 1.5;
        max-width: 720px;
    }

    .nav-form {
        display: flex;
        flex-direction: column;
        height: 100%;
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .nav-form .btn-link {
        padding: 6px 0;
        color: #243b53;
        display: inline-block;
        text-decoration: none;
        background: none;
        border: none;
        text-align: left;
        font-weight: 600;
    }

    .nav-form .btn-link:hover,
    .nav-form .btn-link:focus {
        color: #2b6cb0;
        text-decoration: underline;
        background: none;
    }

    .report-category {
        margin-bottom: 28px;
    }

    .report-category-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e1e7ee;
        color: #334e68;
        font-family: "Source Sans 3", "Segoe UI", Arial, sans-serif;
        font-size: 16px;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .report-category-title > i {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: #e8f2fb;
        color: #2b6cb0;
        font-size: 13px;
    }

    .report-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 14px;
    }

    .report-card {
        border: 1px solid #d9e2ec;
        border-radius: 10px;
        padding: 16px 16px 14px;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
        box-shadow: 0 1px 2px rgba(16, 42, 67, 0.04);
        transition: box-shadow 160ms ease, border-color 160ms ease, transform 160ms ease;
        min-height: 148px;
        display: flex;
        flex-direction: column;
    }

    .report-card:hover {
        border-color: #9fb3c8;
        box-shadow: 0 6px 18px rgba(16, 42, 67, 0.08);
        transform: translateY(-1px);
    }

    .report-card h4 {
        margin: 0 0 8px;
        color: #102a43;
        font-family: "Source Sans 3", "Segoe UI", Arial, sans-serif;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: -0.01em;
    }

    .report-card p {
        flex: 1;
        margin: 0 0 14px;
        color: #627d98;
        font-size: 13px;
        line-height: 1.45;
    }

    .report-card .btn,
    .report-card .nav-form .btn {
        align-self: flex-start;
        border-radius: 7px;
        font-weight: 600;
        padding: 6px 12px;
        background: #2b6cb0;
        border-color: #2b6cb0;
    }

    .report-card .btn:hover,
    .report-card .nav-form .btn:hover {
        background: #1e4e8c;
        border-color: #1e4e8c;
    }

    .report-quick-panel.panel {
        margin-top: 8px;
        border: 1px solid #d9e2ec;
        border-radius: 10px;
        box-shadow: 0 1px 2px rgba(16, 42, 67, 0.04);
        overflow: hidden;
    }

    .report-quick-panel > .card-header {
        background: linear-gradient(180deg, #f7fbff 0%, #eef5fc 100%);
        border-color: #d9e2ec;
        color: #243b53;
        font-family: "Source Sans 3", "Segoe UI", Arial, sans-serif;
        font-weight: 700;
        font-size: 14px;
        letter-spacing: -0.01em;
    }

    .report-quick-panel h4 {
        margin: 0 0 10px;
        color: #334e68;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .report-quick-panel ul li {
        margin-bottom: 8px;
    }

    .report-quick-panel a,
    .report-quick-panel .btn-link {
        padding: 0;
        color: #243b53;
        font-weight: 600;
    }

    .report-quick-panel a:hover,
    .report-quick-panel .btn-link:hover {
        color: #2b6cb0;
        text-decoration: underline;
    }

    .report-mobile-menu {
        margin-bottom: 20px;
    }

    .report-mobile-menu .btn {
        border-radius: 8px;
        font-weight: 600;
    }

    @@media (max-width: 767px) {
        .report-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="report-index">
    <div class="report-index-header">
        <h2 class="admin-page-title">@ViewBag.Title</h2>
        <p>@AdminResource.ReportLeadText</p>
    </div>

    <!-- Mobile navigation -->
    <div class="d-sm-none report-mobile-menu">
        <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle" type="button" id="mobileReportMenu" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                @AdminResource.SelectReport
            </button>
            <ul class="dropdown-menu" aria-labelledby="mobileReportMenu">
                @foreach (var category in reportCategories)
                {
                    <li class="dropdown-header">@category.Key</li>
                    foreach (var action in category.Value)
                    {
                        if (!allActions.Contains(action))
                        {
                            continue;
                        }
                        var title = reportMeta.ContainsKey(action) ? reportMeta[action].Item1 : action;
                        <li>
                            @if (postActions.Contains(action))
                            {
                                using (Html.BeginForm(action, "Report", new { area = "Admin" }, FormMethod.Post, new { @class = "nav-form" }))
                                {
                                    <button type="submit" class="btn btn-link">@title</button>
                                }
                            }
                            else
                            {
                                @Html.ActionLink(title, action, "Report", new { area = "Admin" }, null)
                            }
                        </li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                }
            </ul>
        </div>
    </div>

    <!-- Desktop categorized cards -->
    <div class="d-none d-sm-block">
        @foreach (var category in reportCategories)
        {
            var icon = categoryIcons.ContainsKey(category.Key) ? categoryIcons[category.Key] : "fa-solid fa-rectangle-list";
            <div class="report-category">
                <h3 class="report-category-title">
                    <i class="@icon" aria-hidden="true"></i>
                    <span>@category.Key</span>
                </h3>
                <div class="report-grid">
                    @foreach (var action in category.Value)
                    {
                        if (!allActions.Contains(action))
                        {
                            continue;
                        }
                        var title = reportMeta.ContainsKey(action) ? reportMeta[action].Item1 : action;
                        var description = reportMeta.ContainsKey(action) ? reportMeta[action].Item2 : "";
                        <div class="report-card">
                            @if (postActions.Contains(action))
                            {
                                using (Html.BeginForm(action, "Report", new { area = "Admin" }, FormMethod.Post, new { @class = "nav-form" }))
                                {
                                    <h4>@title</h4>
                                    <p>@description</p>
                                    <button type="submit" class="btn btn-primary btn-sm">@AdminResource.OpenReport</button>
                                }
                            }
                            else
                            {
                                <h4>@title</h4>
                                <p>@description</p>
                                @Html.ActionLink(AdminResource.OpenReport, action, "Report", new { area = "Admin" }, new { @class = "btn btn-primary btn-sm" })
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Quick Reports -->
    <div class="card report-quick-panel">
        <div class="card-header">@AdminResource.QuickReports</div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <h4>@AdminResource.SalesByDate</h4>
                    <ul class="list-unstyled">
                        <li>
                            @Html.ActionLink(AdminResource.TodaysSales, "SalesByDateRange", "Report",
                                new
                                {
                                    area = "Admin",
                                    startDate = DateTime.Today.ToString("yyyy-MM-dd"),
                                    endDate = DateTime.Today.ToString("yyyy-MM-dd")
                                }, null)
                        </li>
                        <li>
                            @Html.ActionLink(AdminResource.YesterdaysSales, "SalesByDateRange", "Report",
                                new
                                {
                                    area = "Admin",
                                    startDate = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd"),
                                    endDate = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")
                                }, null)
                        </li>
                        <li>
                            @Html.ActionLink(AdminResource.ThisWeek, "SalesByDateRange", "Report",
                                new
                                {
                                    area = "Admin",
                                    startDate = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek).ToString("yyyy-MM-dd"),
                                    endDate = DateTime.Today.ToString("yyyy-MM-dd")
                                }, null)
                        </li>
                        <li>
                            @Html.ActionLink(AdminResource.ThisMonth, "SalesByDateRange", "Report",
                                new
                                {
                                    area = "Admin",
                                    startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"),
                                    endDate = DateTime.Today.ToString("yyyy-MM-dd")
                                }, null)
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h4>@AdminResource.Stock</h4>
                    <ul class="list-unstyled">
                        <li>@Html.ActionLink(AdminResource.LowStockProducts, "ProductInventory", "Report", new { area = "Admin", state = "Low" }, null)</li>
                        <li>@Html.ActionLink(AdminResource.OutOfStockProducts, "ProductInventory", "Report", new { area = "Admin", state = "Out" }, null)</li>
                        <li>@Html.ActionLink(AdminResource.CampaignProducts, "ProductInventory", "Report", new { area = "Admin", isCampaign = true }, null)</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h4>@AdminResource.FinanceAndPerformance</h4>
                    <ul class="list-unstyled">
                        <li>
                            @using (Html.BeginForm("FinancialReport", "Report", new { area = "Admin" }, FormMethod.Post))
                            {
                                @Html.Hidden("StartDate", new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))
                                @Html.Hidden("EndDate", DateTime.Today.ToString("yyyy-MM-dd"))
                                <button type="submit" class="btn btn-link">@AdminResource.ThisMonthsFinancialSummary</button>
                            }
                        </li>
                        <li>
                            @using (Html.BeginForm("PerformanceSystemReport", "Report", new { area = "Admin" }, FormMethod.Post))
                            {
                                @Html.Hidden("StartDate", DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd"))
                                @Html.Hidden("EndDate", DateTime.Today.ToString("yyyy-MM-dd"))
                                <button type="submit" class="btn btn-link">@AdminResource.Last30DaysPerformance</button>
                            }
                        </li>
                        <li>
                            @Html.ActionLink(AdminResource.UserAuditQuickLink, "UserAudit", "Report", new { area = "Admin" }, null)
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
