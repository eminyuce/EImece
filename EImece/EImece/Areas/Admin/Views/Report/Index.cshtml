@{
    ViewBag.Title = "Raporlar";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    // Display metadata: Title + short user-friendly description (Turkish)
    var reportMeta = new Dictionary<string, Tuple<string, string>>(StringComparer.OrdinalIgnoreCase)
    {
        { "SalesByDateRange", Tuple.Create("Tarihe Göre Satışlar", "Seçtiğiniz tarih aralığındaki sipariş ve satış özetini görüntüleyin.") },
        { "GetRegionalSalesReport", Tuple.Create("Bölgesel Satışlar", "Satışların bölgelere ve illere göre dağılımını inceleyin.") },
        { "OrderVolumeReport", Tuple.Create("Sipariş Hacmi", "Belirli bir dönemde kaç sipariş alındığını ve hacim trendini görün.") },
        { "PaymentMethod", Tuple.Create("Ödeme Yöntemleri", "Hangi ödeme yöntemlerinin ne kadar kullanıldığını karşılaştırın.") },
        { "PaymentStatus", Tuple.Create("Ödeme Durumları", "Başarılı, bekleyen ve başarısız ödemelerin dağılımını görün.") },
        { "PaymentTransactionReport", Tuple.Create("Ödeme İşlemleri", "Tarih aralığına göre ödeme işlemlerinin ayrıntılı listesini alın.") },
        { "ProductSummary", Tuple.Create("Ürün Özeti", "Ürünlerin genel durumunu, satış ve stok özetini tek bakışta görün.") },
        { "ProductStatsByDateRange", Tuple.Create("Ürün İstatistikleri", "Seçilen dönemde ürün bazında satış ve performans rakamlarını inceleyin.") },
        { "PriceAnalysis", Tuple.Create("Fiyat Analizi", "Fiyat aralıklarına ve kategorilere göre ürün dağılımını analiz edin.") },
        { "ProductInventory", Tuple.Create("Stok Durumu", "Düşük stok, tükenen ve kampanyalı ürünleri hızlıca kontrol edin.") },
        { "FraudAnalysis", Tuple.Create("Dolandırıcılık Analizi", "Şüpheli sipariş ve risk sinyallerini genel hatlarıyla görün.") },
        { "FraudRiskReport", Tuple.Create("Dolandırıcılık Riski", "Tarih aralığına göre risk skorlarını ve uyarıları inceleyin.") },
        { "PerformanceSystemReport", Tuple.Create("Sistem Performansı", "Son dönemdeki sistem ve işlem performans özetini görüntüleyin.") },
        { "CouponUsage", Tuple.Create("Kupon Kullanımı", "Kuponların ne kadar kullanıldığını ve etkisini takip edin.") },
        { "ShipmentCompany", Tuple.Create("Kargo Firmaları", "Kargo firmalarına göre gönderi dağılımını görün.") },
        { "FinancialReport", Tuple.Create("Finansal Özet", "Gelir ve finansal göstergeleri seçilen dönem için inceleyin.") }
    };

    var reportCategories = new Dictionary<string, List<string>>
    {
        { "Satış Raporları", new List<string> {
            "SalesByDateRange",
            "GetRegionalSalesReport",
            "OrderVolumeReport"
        }},
        { "Ödeme Raporları", new List<string> {
            "PaymentMethod",
            "PaymentStatus",
            "PaymentTransactionReport"
        }},
        { "Ürün Raporları", new List<string> {
            "ProductSummary",
            "ProductStatsByDateRange",
            "PriceAnalysis",
            "ProductInventory"
        }},
        { "Risk ve Analiz", new List<string> {
            "FraudAnalysis",
            "FraudRiskReport",
            "PerformanceSystemReport"
        }},
        { "Pazarlama ve Lojistik", new List<string> {
            "CouponUsage",
            "ShipmentCompany"
        }},
        { "Finansal Raporlar", new List<string> {
            "FinancialReport"
        }}
    };

    var allActions = new List<string> {
        "CouponUsage", "FraudAnalysis", "PaymentMethod", "PaymentStatus",
        "GetRegionalSalesReport", "SalesByDateRange", "ShipmentCompany",
        "PerformanceSystemReport", "FinancialReport", "FraudRiskReport",
        "OrderVolumeReport", "PaymentTransactionReport", "ProductSummary",
        "PriceAnalysis", "ProductInventory", "ProductStatsByDateRange"
    };

    // Date-bound DataSet reports: Index uses POST. GetRegionalSalesReport is GET-only.
    var postActions = new HashSet<string>(StringComparer.OrdinalIgnoreCase) {
        "PerformanceSystemReport", "FinancialReport", "FraudRiskReport",
        "OrderVolumeReport", "PaymentTransactionReport"
    };
}

<style>
    .report-index {
        margin-bottom: 24px;
    }

    .report-index-header {
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #d9e2ec;
    }

    .report-index-header h2 {
        margin-top: 0;
        margin-bottom: 6px;
        color: #102a43;
        font-weight: 600;
    }

    .report-index-header p {
        margin: 0;
        color: #627d98;
        font-size: 13px;
        max-width: 720px;
    }

    .nav-form {
        display: inline-block;
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .nav-form .btn-link {
        padding: 3px 20px;
        color: #333;
        display: block;
        text-decoration: none;
        background: none;
        border: none;
        text-align: left;
        width: 100%;
    }

    .nav-form .btn-link:hover,
    .nav-form .btn-link:focus {
        color: #262626;
        background-color: #f5f5f5;
        text-decoration: none;
    }

    .report-category {
        margin-bottom: 28px;
    }

    .report-category h3 {
        margin-top: 0;
        margin-bottom: 14px;
        padding-bottom: 8px;
        border-bottom: 1px solid #d9e2ec;
        color: #334e68;
        font-size: 18px;
        font-weight: 600;
    }

    .report-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 14px;
    }

    .report-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        background: #fff;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
        transition: box-shadow 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
        min-height: 140px;
        display: flex;
        flex-direction: column;
    }

    .report-card:hover {
        border-color: #bfdbfe;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.07);
        transform: translateY(-1px);
    }

    .report-card h4 {
        margin-top: 0;
        margin-bottom: 8px;
        color: #102a43;
        font-size: 15px;
        font-weight: 600;
    }

    .report-card p {
        flex: 1;
        margin: 0 0 14px;
        color: #627d98;
        font-size: 13px;
        line-height: 1.45;
    }

    .report-card .btn {
        align-self: flex-start;
    }

    .report-quick-panel.panel {
        margin-top: 10px;
        border-color: #d9e2ec;
        box-shadow: none;
    }

    .report-quick-panel > .panel-heading {
        background: #f0f4f8;
        border-color: #d9e2ec;
        color: #334e68;
        font-weight: 600;
    }

    .report-quick-panel h4 {
        margin-top: 0;
        margin-bottom: 10px;
        color: #334e68;
        font-size: 14px;
        font-weight: 600;
    }

    .report-quick-panel ul li {
        margin-bottom: 6px;
    }

    .report-quick-panel .btn-link {
        padding: 0;
        color: #243b53;
    }

    .report-quick-panel .btn-link:hover {
        color: #102a43;
        text-decoration: underline;
    }

    @@media (max-width: 767px) {
        .report-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="container body-content report-index">
    <div class="report-index-header">
        <h2>@ViewBag.Title</h2>
        <p>Aşağıdaki kategorilerden bir rapor seçerek satış, ödeme, stok ve risk özetlerine ulaşabilirsiniz.</p>
    </div>

    <!-- Mobile navigation -->
    <div class="visible-xs" style="margin-bottom: 20px;">
        <div class="dropdown">
            <button class="btn btn-default dropdown-toggle" type="button" id="mobileReportMenu" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                Rapor Seçin
                <span class="caret"></span>
            </button>
            <ul class="dropdown-menu" aria-labelledby="mobileReportMenu">
                @foreach (var category in reportCategories)
                {
                    <li class="dropdown-header">@category.Key</li>
                    foreach (var action in category.Value)
                    {
                        if (!allActions.Contains(action))
                        {
                            continue;
                        }
                        var title = reportMeta.ContainsKey(action) ? reportMeta[action].Item1 : action;
                        <li>
                            @if (postActions.Contains(action))
                            {
                                using (Html.BeginForm(action, "Report", new { area = "Admin" }, FormMethod.Post, new { @class = "nav-form" }))
                                {
                                    <button type="submit" class="btn btn-link">@title</button>
                                }
                            }
                            else
                            {
                                @Html.ActionLink(title, action, "Report", new { area = "Admin" }, null)
                            }
                        </li>
                    }
                    <li class="divider"></li>
                }
            </ul>
        </div>
    </div>

    <!-- Desktop categorized cards -->
    <div class="hidden-xs">
        @foreach (var category in reportCategories)
        {
            <div class="report-category">
                <h3>@category.Key</h3>
                <div class="report-grid">
                    @foreach (var action in category.Value)
                    {
                        if (!allActions.Contains(action))
                        {
                            continue;
                        }
                        var title = reportMeta.ContainsKey(action) ? reportMeta[action].Item1 : action;
                        var description = reportMeta.ContainsKey(action) ? reportMeta[action].Item2 : "";
                        <div class="report-card">
                            @if (postActions.Contains(action))
                            {
                                using (Html.BeginForm(action, "Report", new { area = "Admin" }, FormMethod.Post, new { @class = "nav-form" }))
                                {
                                    <h4>@title</h4>
                                    <p>@description</p>
                                    <button type="submit" class="btn btn-primary btn-sm">Raporu Aç</button>
                                }
                            }
                            else
                            {
                                <h4>@title</h4>
                                <p>@description</p>
                                @Html.ActionLink("Raporu Aç", action, "Report", new { area = "Admin" }, new { @class = "btn btn-primary btn-sm" })
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Quick Reports -->
    <div class="panel panel-default report-quick-panel">
        <div class="panel-heading">Hızlı Raporlar</div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-4">
                    <h4>Satış (tarih)</h4>
                    <ul class="list-unstyled">
                        <li>
                            @Html.ActionLink("Bugünün satışları", "SalesByDateRange", "Report",
                                new
                                {
                                    area = "Admin",
                                    startDate = DateTime.Today.ToString("yyyy-MM-dd"),
                                    endDate = DateTime.Today.ToString("yyyy-MM-dd")
                                }, null)
                        </li>
                        <li>
                            @Html.ActionLink("Dünün satışları", "SalesByDateRange", "Report",
                                new
                                {
                                    area = "Admin",
                                    startDate = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd"),
                                    endDate = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")
                                }, null)
                        </li>
                        <li>
                            @Html.ActionLink("Bu hafta", "SalesByDateRange", "Report",
                                new
                                {
                                    area = "Admin",
                                    startDate = DateTime.Today.AddDays(-(int)DateTime.Today.DayOfWeek).ToString("yyyy-MM-dd"),
                                    endDate = DateTime.Today.ToString("yyyy-MM-dd")
                                }, null)
                        </li>
                        <li>
                            @Html.ActionLink("Bu ay", "SalesByDateRange", "Report",
                                new
                                {
                                    area = "Admin",
                                    startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"),
                                    endDate = DateTime.Today.ToString("yyyy-MM-dd")
                                }, null)
                        </li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h4>Stok</h4>
                    <ul class="list-unstyled">
                        <li>@Html.ActionLink("Düşük stoklu ürünler", "ProductInventory", "Report", new { area = "Admin", state = "Low" }, null)</li>
                        <li>@Html.ActionLink("Tükenen ürünler", "ProductInventory", "Report", new { area = "Admin", state = "Out" }, null)</li>
                        <li>@Html.ActionLink("Kampanyalı ürünler", "ProductInventory", "Report", new { area = "Admin", isCampaign = true }, null)</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h4>Finans ve performans</h4>
                    <ul class="list-unstyled">
                        <li>
                            @using (Html.BeginForm("FinancialReport", "Report", new { area = "Admin" }, FormMethod.Post))
                            {
                                @Html.Hidden("StartDate", new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd"))
                                @Html.Hidden("EndDate", DateTime.Today.ToString("yyyy-MM-dd"))
                                <button type="submit" class="btn btn-link">Bu ayın finansal özeti</button>
                            }
                        </li>
                        <li>
                            @using (Html.BeginForm("PerformanceSystemReport", "Report", new { area = "Admin" }, FormMethod.Post))
                            {
                                @Html.Hidden("StartDate", DateTime.Today.AddDays(-30).ToString("yyyy-MM-dd"))
                                @Html.Hidden("EndDate", DateTime.Today.ToString("yyyy-MM-dd"))
                                <button type="submit" class="btn btn-link">Son 30 gün performans</button>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
