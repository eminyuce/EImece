@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using Griddly.Mvc
@using Resources

@{
    Layout = null;
    var gridName = "AppLogGrid";
    int pageSizeNumber = ViewBag.GridPageSizeNumber != null ? (int)ViewBag.GridPageSizeNumber : AdminSettings.GridPageSizeNumber;
    int rowNum = 0;
    int startIndex = 0;

    var settings = new GriddlySettings<AppLog>()
    {
        ClassName = "eg-grid eg-grid-shell",
        TableClassName = "table table-hover table-striped eg-grid-table",
        PageSize = pageSizeNumber,
        AllowedFilterModes = FilterMode.None,
        RowClass = item => item.Id % 2 == 0 ? string.Empty : "GridIsActive",
        DefaultSort = new[] { new SortField() { Field = "CreatedDate", Direction = SortDirection.Descending } }
    };

    settings.HtmlAttributes["data-gridname"] = gridName;

    settings.BeforeTemplate = @<text>
        <output class="card-header grid-record-count" style="display:block" aria-live="polite">
            <div class="grid-record-count-inner">
                <span class="grid-record-count-badge griddly-recordtotal"></span>
                <span class="grid-record-count-label">@AdminResource.GridResultRecordNumber</span>
            </div>
            <div class="eg-grid-scroll-controls" title="Tabloyu Sağa/Sola Kaydır">
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-left" title="Sola Kaydır" aria-label="Sola Kaydır">
                    <i class="fa fa-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-right" title="Sağa Kaydır" aria-label="Sağa Kaydır">
                    <i class="fa fa-chevron-right"></i>
                </button>
            </div>
        </output>
    </text>;

    settings
        .Column(caption: "", template: @<text><span class="eg-row-index">@(startIndex + (++rowNum))</span></text>, className: "eg-sticky-left eg-sticky-left-1 eg-col-index", width: "44px")
        .Column(caption: "", template: @<text><input gridkey-id="@item.Id" class="gridCheckboxes" name="checkboxGrid" type="checkbox" /></text>, className: "gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check", width: "44px")
        .Column(x => x.Id, caption: "ID", template: @<text>@CreateAppLogModal(item)</text>, className: "eg-col-name", width: "100px")
        .Column(x => x.EventLevel, caption: "Seviye", template: @<text>@EventLevelBadge(item.EventLevel)</text>, className: "eg-col-state", width: "100px")
        .Column(x => x.EventMessage, caption: "Mesaj", template: @<text><label class="visually-hidden" for="applog-msg-@item.Id">Mesaj</label><textarea id="applog-msg-@item.Id" readonly style="height: 60px; background-color: transparent; width: 380px; margin: 0; resize: vertical; border: 1px solid #d7dee8; border-radius: 4px; padding: 4px 6px;">@string.Format("{0} {1} {2}", item.EventMessage, item.ErrorSource, item.ErrorMessage)</textarea></text>, className: "eg-col-message", width: "400px")
        .Column(x => x.InnerErrorMessage, caption: "İç Hata Mesajı", template: @<text><label class="visually-hidden" for="applog-inner-@item.Id">İç Hata Mesajı</label><textarea id="applog-inner-@item.Id" readonly style="height: 60px; background-color: transparent; width: 380px; margin: 0; resize: vertical; border: 1px solid #d7dee8; border-radius: 4px; padding: 4px 6px;">@item.InnerErrorMessage</textarea></text>, className: "eg-col-inner-message", width: "400px")
        .Column(x => x.CreatedDate, caption: AdminResource.CreatedDate, template: @<text>@item.CreatedDate.ToString("dddd, dd MMMM yyyy HH:mm:ss")</text>, className: "gridDateClass", width: "200px");
}

@helper EventLevelBadge(string eventLevel)
{
    var css = "eg-state-badge";
    if (string.Equals(eventLevel, "Trace", StringComparison.OrdinalIgnoreCase)
        || string.Equals(eventLevel, "Debug", StringComparison.OrdinalIgnoreCase))
    {
        css += " is-muted";
    }
    <span class="@css">@eventLevel</span>
}

@helper CreateAppLogModal(AppLog o)
{
    <div class="eg-name-cell">
        <a data-bs-toggle="modal" class="eg-name-link" data-order-Id="@o.Id" data-bs-target="@string.Format("#myModal_{0}", o.Id)">
            <strong>@o.Id</strong>
        </a>
    </div>

    <div id="@string.Format("myModal_{0}", o.Id)" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content" style="width:980px;">
                <div class="modal-body">
                    @Html.DisplayFor(item => o)
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@AdminResource.Close</button>
                </div>
            </div>
        </div>
    </div>
}

@Html.Griddly(settings)
