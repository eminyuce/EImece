@model List<AppLog>
@using System;
@using System.Collections.Generic;
@using EImece.Domain.Helpers;
@using Griddly.Mvc;
@using EImece.Domain;
@using EImece.Domain.Entities;
@using Resources;
@using EImece.Domain.Helpers.Extensions;

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var controllerName = "AppLogs";
    List<AppLog> contents = Model;

    var currentSearch = (ViewBag.Search as string) ?? Request.QueryString["search"].ToStr();
    var currentEventLevel = (ViewBag.EventLevel as string) ?? Request.QueryString["eventLevel"].ToStr();
    var eventLevels = ViewBag.EventLevels as string[] ?? new[] { "Trace", "Debug", "Info", "Warn", "Error", "Fatal" };
    var preserveQuery = new Dictionary<string, string>();
    if (!string.IsNullOrEmpty(currentEventLevel))
    {
        preserveQuery["eventLevel"] = currentEventLevel;
    }
}

<h2 class="admin-page-title">@AdminResource.AppLogs</h2>
<hr class="adminLine" />

<div class="card" style="margin-bottom: 15px;">
    <div class="card-header"><strong>Log seviyesi filtrele / indir</strong></div>
    <div class="card-body">
        <form method="get" action="@Url.Action("Index", controllerName)" class="d-flex flex-wrap align-items-end gap-2 mb-3">
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <input type="hidden" name="search" value="@currentSearch" />
            }
            <div>
                <label for="eventLevel" class="form-label">Seviye (debug type):</label>
                <select id="eventLevel" name="eventLevel" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var level in eventLevels)
                    {
                        <option value="@level" @(string.Equals(level, currentEventLevel, StringComparison.OrdinalIgnoreCase) ? "selected=\"selected\"" : null)>@level</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">
                <span class="fa fa-filter"></span> Filtrele
            </button>
            @if (!string.IsNullOrEmpty(currentEventLevel) || !string.IsNullOrEmpty(currentSearch))
            {
                <a href="@Url.Action("Index", controllerName)" class="btn btn-secondary">Temizle</a>
            }
        </form>

        <div class="btn-toolbar" role="toolbar" style="margin-bottom: 8px;">
            <fieldset class="btn-group" style="border:0;padding:0;margin:0;min-width:0">
                <legend class="visually-hidden">İndir</legend>
                <a class="btn btn-success"
                   href="@Url.Action("Download", controllerName, new { search = currentSearch, eventLevel = currentEventLevel })">
                    <span class="fa fa-download"></span>
                    İndir (.txt)@(string.IsNullOrEmpty(currentEventLevel) ? "" : " — " + currentEventLevel)
                </a>
                <a class="btn btn-secondary"
                   href="@Url.Action("ExportExcel", controllerName, new { format = "excel", search = currentSearch, eventLevel = currentEventLevel })">
                    Excel
                </a>
                <a class="btn btn-secondary"
                   href="@Url.Action("ExportExcel", controllerName, new { format = "csv", search = currentSearch, eventLevel = currentEventLevel })">
                    CSV
                </a>
            </fieldset>
        </div>
        <p class="text-muted" style="margin: 0;">
            Gösterilen: <strong>@contents.Count</strong> kayıt
            @if (!string.IsNullOrEmpty(currentEventLevel))
            {
                <span>· seviye: <code>@currentEventLevel</code></span>
            }
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <span>· arama: <code>@currentSearch</code></span>
            }
        </p>
    </div>
</div>

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
        {"controllerName",controllerName}
        ,{"StateTypes","NONE"}
       ,{"orderingButton",false}
,{"IsNewRecordButtonEnabled",false}
       ,{"selectAll",true}
       ,{"deleteAll",true}
        ,{"SetStateOnOrOff",false},{"IsExcelButtonEnabled",false}
        ,{"PreserveQuery", preserveQuery}})
<div style="margin-bottom: 12px;">
    @Html.ActionLink("Trace Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Trace" }, new { @class = "btn btn-secondary btn-sm" })
    @Html.ActionLink("Debug Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Debug" }, new { @class = "btn btn-warning btn-sm" })
    @Html.ActionLink("Info Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Info" }, new { @class = "btn btn-info btn-sm" })
    @Html.ActionLink("Warn Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Warn" }, new { @class = "btn btn-warning btn-sm" })
    @Html.ActionLink("Error Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Error" }, new { @class = "btn btn-danger btn-sm" })
    @Html.ActionLink("Fatal Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Fatal" }, new { @class = "btn btn-danger btn-sm" })
    @Html.ActionLink("Bütün Loglari Sil", "RemoveAll", null, new { @class = "btn btn-link btn-sm" })
</div>

<div class="accordion" id="logAccordion">

    <!-- Textarea Section -->
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne"
                    aria-expanded="true" aria-controls="collapseOne">
                Log Metin Görünümü
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse show" aria-labelledby="headingOne" data-bs-parent="#logAccordion">
            <div class="accordion-body">
                <textarea id="logTextBox" rows="20" readonly style="width: 100%; height: 500px; font-family: monospace;">
@foreach (var log in Model)
{
@:@log.ToLogStr().Trim()
}
</textarea>
            </div>
        </div>
    </div>

    <!-- Grid Section -->
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingTwo">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo"
                    aria-expanded="false" aria-controls="collapseTwo">
                Log Grid Görünümü
            </button>
        </h2>
        <div id="collapseTwo" class="accordion-collapse" aria-labelledby="headingTwo" data-bs-parent="#logAccordion">
            <div class="accordion-body">
                @Html.Partial("Grid/_GridChrome")
                <div class="js-griddly-async" data-url="@Url.Action("IndexGrid", new { search = currentSearch, eventLevel = currentEventLevel })"></div>
            </div>
        </div>
    </div>
</div>
@helper EventLevelBadge(string eventLevel)
{
    var css = "eg-state-badge";
    if (string.Equals(eventLevel, "Trace", StringComparison.OrdinalIgnoreCase)
        || string.Equals(eventLevel, "Debug", StringComparison.OrdinalIgnoreCase))
    {
        css += " is-muted";
    }
    <span class="@css">@eventLevel</span>
}

@helper CreateAppLogModal(AppLog o)
{
    <div class="eg-name-cell">
        <a data-bs-toggle="modal"
           class="eg-name-link"
           data-order-Id="@o.Id"
           data-bs-target="@String.Format("#myModal_{0}", o.Id)">
            <strong>@o.Id</strong>
        </a>
    </div>

    <!-- Modal -->
    <div id="@String.Format("myModal_{0}",o.Id)" class="modal fade" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content" style="width:980px;">
                <div class="modal-body">
                    @Html.DisplayFor(item => o)
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@AdminResource.Close</button>
                </div>
            </div>
        </div>
    </div>
}
