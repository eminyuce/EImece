@model List<AppLog>
@using System;
@using System.Collections.Generic;
@using EImece.Domain.Helpers;
@using GridMvc.Html;
@using GridMvc.Sorting;
@using EImece.Domain;
@using EImece.Domain.Entities;
@using Resources;
@using EImece.Domain.Helpers.Extensions;

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = 1000;
    pageSizeNumber = pageSizeNumber == 0 ? AppConfig.GridPageSizeNumber : pageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : pageSizeNumber * (gridPage - 1);
    var controllerName = "AppLogs";
    var gridName = "AppLogGrid";
    List<AppLog> contents = Model;

    var currentSearch = (ViewBag.Search as string) ?? Request.QueryString["search"].ToStr();
    var currentEventLevel = (ViewBag.EventLevel as string) ?? Request.QueryString["eventLevel"].ToStr();
    var eventLevels = ViewBag.EventLevels as string[] ?? new[] { "Trace", "Debug", "Info", "Warn", "Error", "Fatal" };
    var preserveQuery = new Dictionary<string, string>();
    if (!string.IsNullOrEmpty(currentEventLevel))
    {
        preserveQuery["eventLevel"] = currentEventLevel;
    }
}

<h2>@AdminResource.AppLogs</h2>
<hr class="adminLine" />

<div class="panel panel-default" style="margin-bottom: 15px;">
    <div class="panel-heading"><strong>Log seviyesi filtrele / indir</strong></div>
    <div class="panel-body">
        <form method="get" action="@Url.Action("Index", controllerName)" class="form-inline" style="margin-bottom: 10px;">
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <input type="hidden" name="search" value="@currentSearch" />
            }
            <div class="form-group" style="margin-right: 10px;">
                <label for="eventLevel" style="margin-right: 6px;">Seviye (debug type):</label>
                <select id="eventLevel" name="eventLevel" class="form-control">
                    <option value="">Tümü</option>
                    @foreach (var level in eventLevels)
                    {
                        <option value="@level" @(string.Equals(level, currentEventLevel, StringComparison.OrdinalIgnoreCase) ? "selected=\"selected\"" : null)>@level</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">
                <span class="glyphicon glyphicon-filter"></span> Filtrele
            </button>
            @if (!string.IsNullOrEmpty(currentEventLevel) || !string.IsNullOrEmpty(currentSearch))
            {
                <a href="@Url.Action("Index", controllerName)" class="btn btn-default">Temizle</a>
            }
        </form>

        <div class="btn-toolbar" role="toolbar" style="margin-bottom: 8px;">
            <fieldset class="btn-group" style="border:0;padding:0;margin:0;min-width:0">
                <legend class="sr-only">İndir</legend>
                <a class="btn btn-success"
                   href="@Url.Action("Download", controllerName, new { search = currentSearch, eventLevel = currentEventLevel })">
                    <span class="glyphicon glyphicon-download-alt"></span>
                    İndir (.txt)@(string.IsNullOrEmpty(currentEventLevel) ? "" : " — " + currentEventLevel)
                </a>
                <a class="btn btn-default"
                   href="@Url.Action("ExportExcel", controllerName, new { format = "excel", search = currentSearch, eventLevel = currentEventLevel })">
                    Excel
                </a>
                <a class="btn btn-default"
                   href="@Url.Action("ExportExcel", controllerName, new { format = "csv", search = currentSearch, eventLevel = currentEventLevel })">
                    CSV
                </a>
            </fieldset>
        </div>
        <p class="text-muted" style="margin: 0;">
            Gösterilen: <strong>@contents.Count</strong> kayıt
            @if (!string.IsNullOrEmpty(currentEventLevel))
            {
                <span>· seviye: <code>@currentEventLevel</code></span>
            }
            @if (!string.IsNullOrEmpty(currentSearch))
            {
                <span>· arama: <code>@currentSearch</code></span>
            }
        </p>
    </div>
</div>

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
        {"controllerName",controllerName}
        ,{"StateTypes","NONE"}
       ,{"orderingButton",false}
,{"IsNewRecordButtonEnabled",false}
       ,{"selectAll",true}
       ,{"deleteAll",true}
        ,{"SetStateOnOrOff",false},{"IsExcelButtonEnabled",false}
        ,{"PreserveQuery", preserveQuery}})
<div style="margin-bottom: 12px;">
    @Html.ActionLink("Trace Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Trace" }, new { @class = "btn btn-default btn-sm" })
    @Html.ActionLink("Debug Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Debug" }, new { @class = "btn btn-warning btn-sm" })
    @Html.ActionLink("Info Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Info" }, new { @class = "btn btn-info btn-sm" })
    @Html.ActionLink("Warn Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Warn" }, new { @class = "btn btn-warning btn-sm" })
    @Html.ActionLink("Error Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Error" }, new { @class = "btn btn-danger btn-sm" })
    @Html.ActionLink("Fatal Seviye Loglari Sil", "RemoveAll", new { eventLevel = "Fatal" }, new { @class = "btn btn-danger btn-sm" })
    @Html.ActionLink("Bütün Loglari Sil", "RemoveAll", null, new { @class = "btn btn-link btn-sm" })
</div>

<div class="accordion" id="logAccordion">

    <!-- Textarea Section -->
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingOne">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne"
                    aria-expanded="true" aria-controls="collapseOne">
                Log Metin Görünümü
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse show" aria-labelledby="headingOne" data-bs-parent="#logAccordion">
            <div class="accordion-body">
                <textarea id="logTextBox" rows="20" readonly style="width: 100%; height: 500px; font-family: monospace;">
@foreach (var log in Model)
{
@:@log.ToLogStr().Trim()
}
</textarea>
            </div>
        </div>
    </div>

    <!-- Grid Section -->
    <div class="accordion-item">
        <h2 class="accordion-header" id="headingTwo">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo"
                    aria-expanded="false" aria-controls="collapseTwo">
                Log Grid Görünümü
            </button>
        </h2>
        <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#logAccordion">
            <div class="accordion-body">
                @Html.Partial("Grid/_GridChrome")

                <div class="panel panel-primary eg-grid-shell">
                @Html.Grid(contents).Named(gridName).Columns(columns =>
                  {
                      columns.Add()
                          .Encoded(false)
                          .Sanitized(false)
                          .Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
                          .RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

                      columns.Add()
                          .Encoded(false)
                          .Sanitized(false)
                          .Css("gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check")
                          .RenderValueAs(d => Html.Partial("pGridCheckbox", new ViewDataDictionary(ViewData){
                            {"ItemId",d.Id}}));

                      columns.Add(c => c.Id)
                          .Filterable(true)
                          .Encoded(false)
                          .Sanitized(false)
                          .Css("eg-col-name")
                          .RenderValueAs(d => CreateAppLogModal(d));

                      columns.Add(c => c.EventLevel)
                          .Titled("Seviye")
                          .Filterable(true)
                          .Encoded(false)
                          .Sanitized(false)
                          .Css("eg-col-state")
                          .RenderValueAs(o => EventLevelBadge(o.EventLevel));

                      columns.Add(o => o.EventMessage)
                          .Titled("Mesaj")
                          .Encoded(false)
                          .Sanitized(false)
                          .SetWidth(10)
                          .RenderValueAs(o => String.Format("<label class='sr-only' for='applog-msg-{0}'>Mesaj</label><textarea id='applog-msg-{0}' readonly style='height: 146px; background-color: transparent; width: 399px; margin: 0px;'>{1}</textarea>", o.Id, String.Format("{0} {1} {2}", o.EventMessage, o.ErrorSource, o.ErrorMessage)));

                      columns.Add(o => o.InnerErrorMessage)
                          .Titled("İç Hata Mesajı")
                          .Encoded(false)
                          .Sanitized(false)
                          .SetWidth(10)
                          .RenderValueAs(o => String.Format("<label class='sr-only' for='applog-inner-{0}'>İç Hata Mesajı</label><textarea id='applog-inner-{0}' readonly style='height: 146px; background-color: transparent; width: 399px; margin: 0px;'>{1}</textarea>", o.Id, o.InnerErrorMessage));

                      columns.Add(o => o.CreatedDate)
                          .Titled(AdminResource.CreatedDate)
                          .Sortable(true)
                          .Css("gridDateClass")
                          .RenderValueAs(o => o.CreatedDate.ToString("dddd, dd MMMM yyyy HH:mm:ss"))
                          .SortInitialDirection(GridSortDirection.Descending);

                  }).SetRowCssClasses(item => item.Id % 2 == 0 ? string.Empty : "GridIsActive").WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
}

@helper EventLevelBadge(string eventLevel)
{
    var css = "eg-state-badge";
    if (string.Equals(eventLevel, "Trace", StringComparison.OrdinalIgnoreCase)
        || string.Equals(eventLevel, "Debug", StringComparison.OrdinalIgnoreCase))
    {
        css += " is-muted";
    }
    <span class="@css">@eventLevel</span>
}

@helper CreateAppLogModal(AppLog o)
{
    <div class="eg-name-cell">
        <a data-toggle="modal"
           class="eg-name-link"
           data-order-Id="@o.Id"
           data-target="@String.Format("#myModal_{0}", o.Id)">
            <strong>@o.Id</strong>
        </a>
    </div>

    <!-- Modal -->
    <div id="@String.Format("myModal_{0}",o.Id)" class="modal fade" role="dialog">
        <div class="modal-dialog">

            <!-- Modal content-->
            <div class="modal-content" style="width:980px;">
                <div class="modal-body">
                    @Html.DisplayFor(item => o)
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">@AdminResource.Close</button>
                </div>
            </div>
        </div>
    </div>
}
