@model EImece.Areas.Admin.Models.CacheAdminViewModel
@using EImece.Areas.Admin.Models
@using EImece.Domain.Caching
@using EImece.Domain.Helpers
@using Resources
@using System.Web
@{
    ViewBag.Title = AdminResource.CacheAdministration;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var metrics = Model.Metrics ?? new CacheMetricsSnapshot();
    var overview = Model.Overview ?? CacheDiagnostics.BuildOverview();
    var combined = overview.Combined ?? new CacheLayerSnapshot();
    var search = Model.Search ?? "";
    var category = Model.Category ?? "all";
    var status = Model.Status ?? "all";
    var na = CacheDiagnostics.NotAvailable;
    var cannot = AdminResource.CachePerformanceNotMeasured;

    string combinedClass, combinedIcon, combinedTitle;
    if (!combined.IsEnabled)
    {
        combinedClass = "cache-health-noteffective";
        combinedIcon = "🔴";
        combinedTitle = AdminResource.CacheStatusNotEffective;
    }
    else if (combined.TotalReads < CacheHealth.MinReadsForHitRate)
    {
        combinedClass = "cache-health-limited";
        combinedIcon = "🟡";
        combinedTitle = AdminResource.CacheStatusLimited;
    }
    else if (combined.Effectiveness == CacheEffectivenessLevel.Effective)
    {
        combinedClass = "cache-health-effective";
        combinedIcon = "🟢";
        combinedTitle = AdminResource.CacheStatusEffective;
    }
    else if (combined.Effectiveness == CacheEffectivenessLevel.Limited)
    {
        combinedClass = "cache-health-limited";
        combinedIcon = "🟡";
        combinedTitle = AdminResource.CacheStatusLimited;
    }
    else
    {
        combinedClass = "cache-health-noteffective";
        combinedIcon = "🔴";
        combinedTitle = AdminResource.CacheStatusNotEffective;
    }

    var savedDisplay = CacheHealth.FormatSaved(combined.SavedMs) ?? cannot;
    var improvementDisplay = CacheHealth.FormatImprovement(combined.ImprovementPercent) ?? cannot;
    var pageProfiles = overview.PageCacheProfiles != null && overview.PageCacheProfiles.Length > 0
        ? string.Join(", ", overview.PageCacheProfiles)
        : "Cache1Hour";
}

@Html.AdminBreadcrumb(AdminResource.CacheAdministration)
<div class="cache-admin-page">
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="admin-page-title mb-1"><i class="fa-solid fa-gauge-high text-primary me-2"></i>@AdminResource.CacheAdministration</h2>
        <p class="text-muted mb-0 small">@AdminResource.CacheAdminPageLead</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("SystemSettings", "AdminSettings", new { area = "admin" })#tab-tools" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i> @AdminResource.SystemToolsAndMaintenance
        </a>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("ExportExcel", "Cache", new { area = "admin", format = "excel", search, category, status })" title="@AdminResource.CacheExportHint">
            <i class="fa-solid fa-file-excel me-1"></i> @AdminResource.Excel
        </a>
        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("ExportExcel", "Cache", new { area = "admin", format = "csv", search, category, status })" title="@AdminResource.CacheExportHint">
            <i class="fa-solid fa-file-csv me-1"></i> @AdminResource.Csv
        </a>
        <button type="button" id="btnRefreshDiagnostics" class="btn btn-outline-primary btn-sm">
            <i class="fa-solid fa-arrows-rotate me-1"></i> @AdminResource.Refresh
        </button>
    </div>
</div>
<hr class="adminLine" />

@if (!Model.IsCacheActive)
{
    <div class="alert alert-warning d-flex align-items-start gap-2 py-2 mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation fa-lg mt-1 text-warning"></i>
        <div class="small">@AdminResource.CacheIsDisabled</div>
    </div>
}

<div class="card shadow-sm mb-4 setting-section-card cache-overview-card @combinedClass" id="cacheOverviewCard">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0 fw-bold">@AdminResource.CacheOverview</h5>
            <small class="text-muted">@AdminResource.CacheOverviewLead</small>
        </div>
        <small class="text-muted" id="cacheLastRefreshed">
            @AdminResource.LastRefreshed: <span id="cacheLastRefreshedValue">@Model.GeneratedAt.ToString("yyyy-MM-dd HH:mm:ss")</span>
        </small>
    </div>
    <div class="card-body">
        <div class="cache-status-banner mb-3" id="ovStatusBanner">
            <span class="h5 mb-0" id="ovStatus"><span id="ovStatusIcon">@combinedIcon</span> @AdminResource.CacheStatusLabel: <span id="ovStatusTitle">@combinedTitle</span></span>
        </div>
        <div class="row g-3">
            <div class="col-6 col-md-3 col-xl">
                <div class="card shadow-sm border-0 h-100 bg-light">
                    <div class="card-body p-3">
                        <div class="text-muted small text-uppercase fw-bold">
                            @AdminResource.CacheHitRate
                            <i class="fa-solid fa-circle-question cache-help" title="@AdminResource.CacheHitRateHelp"></i>
                        </div>
                        <div class="h3 fw-bold mb-0 text-info" id="ovHitRate">@combined.HitRatioPercent.ToString("N1")%</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl">
                <div class="card shadow-sm border-0 h-100 bg-light">
                    <div class="card-body p-3">
                        <div class="text-muted small text-uppercase fw-bold">@AdminResource.CacheHits</div>
                        <div class="h3 fw-bold mb-0 text-success" id="ovHits">@combined.Hits.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl">
                <div class="card shadow-sm border-0 h-100 bg-light">
                    <div class="card-body p-3">
                        <div class="text-muted small text-uppercase fw-bold">
                            @AdminResource.CacheMisses
                            <i class="fa-solid fa-circle-question cache-help" title="@AdminResource.CacheMissHelp"></i>
                        </div>
                        <div class="h3 fw-bold mb-0 text-warning" id="ovMisses">@combined.Misses.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3 col-xl">
                <div class="card shadow-sm border-0 h-100 bg-light">
                    <div class="card-body p-3">
                        <div class="text-muted small text-uppercase fw-bold">@AdminResource.CacheActiveEntries</div>
                        <div class="h3 fw-bold mb-0" id="ovEntries">@combined.ActiveEntries.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card shadow-sm border-0 h-100 bg-light">
                    <div class="card-body p-3">
                        <div class="text-muted small text-uppercase fw-bold">@AdminResource.CacheRequestsServed</div>
                        <div class="h4 fw-bold mb-0" id="ovServed">@combined.Hits.ToString("N0")</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card shadow-sm border-0 h-100 bg-light">
                    <div class="card-body p-3">
                        <div class="text-muted small text-uppercase fw-bold">@AdminResource.CacheTimeSaved</div>
                        <div class="h4 fw-bold mb-0" id="ovSaved">@savedDisplay</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card shadow-sm border-0 h-100 bg-light">
                    <div class="card-body p-3">
                        <div class="text-muted small text-uppercase fw-bold">
                            @AdminResource.CachePerformanceImprovement
                            <i class="fa-solid fa-circle-question cache-help" title="@AdminResource.CacheImprovementHelp"></i>
                        </div>
                        <div class="h4 fw-bold mb-0" id="ovImprovement">@improvementDisplay</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.Partial("~/Areas/Admin/Views/Cache/_CacheLayerCard.cshtml", new CacheLayerCardModel
{
    Title = AdminResource.CachePageResponseTitle,
    Lead = AdminResource.CachePageResponseLead,
    TechnicalName = "CustomOutputCache",
    ProfileLabel = pageProfiles,
    Prefix = "page",
    ShowDatabaseAvoided = false,
    Layer = overview.Page
})

@Html.Partial("~/Areas/Admin/Views/Cache/_CacheLayerCard.cshtml", new CacheLayerCardModel
{
    Title = AdminResource.CacheApplicationDataTitle,
    Lead = AdminResource.CacheApplicationDataLead,
    TechnicalName = "MemoryCache",
    ProfileLabel = null,
    Prefix = "data",
    ShowDatabaseAvoided = true,
    Layer = overview.Data
})

<!-- Cache Operations -->
<div class="card shadow-sm mb-4 setting-section-card">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-broom text-danger me-2"></i>@AdminResource.CacheOperations</h5>
        <small class="text-muted">@AdminResource.CacheManagementLead</small>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6 col-xl-3">
                @using (Html.BeginForm("InvalidateCache", "Cache", new { area = "admin" }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="target" value="products" />
                    <button type="submit" class="btn btn-outline-primary w-100 h-100 text-start py-3">
                        <span class="d-block fw-bold"><i class="fa-solid fa-box me-1"></i> @AdminResource.ProductPriceCache</span>
                        <span class="small text-muted">@AdminResource.ProductPriceCacheDesc</span>
                    </button>
                }
            </div>
            <div class="col-md-6 col-xl-3">
                @using (Html.BeginForm("InvalidateCache", "Cache", new { area = "admin" }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="target" value="categories" />
                    <button type="submit" class="btn btn-outline-primary w-100 h-100 text-start py-3">
                        <span class="d-block fw-bold"><i class="fa-solid fa-sitemap me-1"></i> @AdminResource.CategoryCache</span>
                        <span class="small text-muted">@AdminResource.CategoryCacheDesc</span>
                    </button>
                }
            </div>
            <div class="col-md-6 col-xl-3">
                @using (Html.BeginForm("InvalidateCache", "Cache", new { area = "admin" }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="target" value="settings" />
                    <button type="submit" class="btn btn-outline-primary w-100 h-100 text-start py-3">
                        <span class="d-block fw-bold"><i class="fa-solid fa-sliders me-1"></i> @AdminResource.SettingCache</span>
                        <span class="small text-muted">@AdminResource.SettingCacheDesc</span>
                    </button>
                }
            </div>
            <div class="col-md-6 col-xl-3">
                @using (Html.BeginForm("InvalidateCache", "Cache", new { area = "admin" }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="target" value="content" />
                    <button type="submit" class="btn btn-outline-primary w-100 h-100 text-start py-3">
                        <span class="d-block fw-bold"><i class="fa-regular fa-file-lines me-1"></i> @AdminResource.ContentCache</span>
                        <span class="small text-muted">@AdminResource.ContentCacheDesc</span>
                    </button>
                }
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            @using (Html.BeginForm("InvalidateCache", "Cache", new { area = "admin" }, FormMethod.Post, new { @class = "d-inline" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="target" value="all" />
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-bomb me-1"></i> @AdminResource.ClearAllStorefrontCache
                </button>
            }
            <a href="@Url.Action("ClearCache", "Cache", new { area = "admin" })" class="btn btn-outline-danger">
                <i class="fa-solid fa-arrows-rotate me-1"></i> @AdminResource.PurgeAllCacheBtn
            </a>
            <span class="text-muted small">@AdminResource.ClearAllStorefrontCacheHint</span>
        </div>
    </div>
</div>

<!-- Cache Entries -->
<div class="card shadow-sm mb-4 setting-section-card">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h5 class="mb-0 fw-bold"><i class="fa-solid fa-key text-primary me-2"></i>@AdminResource.CacheEntries</h5>
            <small class="text-muted">@AdminResource.CacheEntriesLead</small>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-secondary btn-sm" href="@Url.Action("ExportExcel", "Cache", new { area = "admin", format = "excel", search, category, status })" title="@AdminResource.CacheExportHint">
                <i class="fa-solid fa-file-excel me-1"></i> @AdminResource.Excel
            </a>
            <a class="btn btn-secondary btn-sm" href="@Url.Action("ExportExcel", "Cache", new { area = "admin", format = "csv", search, category, status })" title="@AdminResource.CacheExportHint">
                <i class="fa-solid fa-file-csv me-1"></i> @AdminResource.Csv
            </a>
        </div>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("Index", "Cache", FormMethod.Get, new { @class = "row g-2 align-items-end mb-3", id = "cacheFilterForm" }))
        {
            <div class="col-md-5">
                <label class="form-label small mb-1" for="cacheSearch">@AdminResource.Search</label>
                <input type="text" class="form-control" id="cacheSearch" name="search" value="@search" placeholder="@AdminResource.SearchCacheKeys" autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="cacheCategory">@AdminResource.CacheCategory</label>
                <select class="form-select" id="cacheCategory" name="category">
                    <option value="all" @(string.Equals(category, "all", StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@AdminResource.CacheFilterAllCategories</option>
                    @foreach (var cat in Model.Categories ?? Array.Empty<string>())
                    {
                        <option value="@cat" @(string.Equals(category, cat, StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1" for="cacheStatus">@AdminResource.CacheStatus</label>
                <select class="form-select" id="cacheStatus" name="status">
                    <option value="all" @(string.Equals(status, "all", StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@AdminResource.CacheFilterAllStatuses</option>
                    <option value="Active" @(string.Equals(status, "Active", StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@AdminResource.CacheStatusActive</option>
                    <option value="Expired" @(string.Equals(status, "Expired", StringComparison.OrdinalIgnoreCase) ? "selected" : null)>@AdminResource.CacheStatusExpired</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> @AdminResource.Search
                </button>
            </div>
        }

        @Html.Partial("Grid/_GridChrome")
        <div class="js-griddly-async" data-url="@Url.Action("IndexGrid", "Cache", new { area = "admin", search, category, status })"></div>
        <p class="small text-muted mt-2 mb-0">@AdminResource.CacheValuesNotExposed</p>
    </div>
</div>

<div class="modal fade" id="cacheEntryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@AdminResource.CacheEntryDetails</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-0 small" id="cacheEntryDetailsList"></dl>
            </div>
        </div>
    </div>
</div>

<script>
    (function ($) {
        var diagnosticsUrl = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Url.Action("Diagnostics", "Cache", new { area = "admin" })))';
        var entryUrl = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Url.Action("Entry", "Cache", new { area = "admin" })))';
        var cannot = '@Html.Raw(HttpUtility.JavaScriptStringEncode(cannot))';
        var labels = {
            name: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheName))',
            key: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheEntryTechnicalKey))',
            kind: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheType))',
            category: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheCategory))',
            status: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheStatus))',
            type: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheType))',
            created: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheCreated))',
            expires: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheExpires))',
            ttl: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheRemainingTtl))',
            hits: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheHits))',
            misses: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheMisses))',
            hitRate: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheHitRate))',
            avgCached: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheAvgCachedTime))',
            avgUncached: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheAvgUncachedTime))',
            improvement: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheImprovement))',
            lastAccess: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheLastAccess))',
            size: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheSize))',
            na: '@Html.Raw(HttpUtility.JavaScriptStringEncode(na))',
            effective: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheStatusEffective))',
            limited: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheStatusLimited))',
            notEffective: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheStatusNotEffective))',
            effectiveBody: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheHealthEffectiveBody))',
            limitedBody: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheHealthLimitedBody))',
            notEffectiveBody: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheHealthNotEffectiveBody))',
            waitingBody: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheHealthWaitingBody))',
            pageKind: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheKindPageResponse))',
            dataKind: '@Html.Raw(HttpUtility.JavaScriptStringEncode(AdminResource.CacheKindApplicationData))'
        };

        function fmt(n) {
            return Number(n || 0).toLocaleString();
        }

        function healthUi(effectiveness, totalReads, enabled) {
            if (enabled === false) {
                return { cls: 'cache-health-noteffective', icon: '🔴', title: labels.notEffective, body: labels.notEffectiveBody };
            }
            if ((totalReads || 0) < 8) {
                return { cls: 'cache-health-limited', icon: '🟡', title: labels.limited, body: labels.waitingBody };
            }
            if (effectiveness === 'Effective') {
                return { cls: 'cache-health-effective', icon: '🟢', title: labels.effective, body: labels.effectiveBody };
            }
            if (effectiveness === 'Limited') {
                return { cls: 'cache-health-limited', icon: '🟡', title: labels.limited, body: labels.limitedBody };
            }
            return { cls: 'cache-health-noteffective', icon: '🔴', title: labels.notEffective, body: labels.notEffectiveBody };
        }

        function applyLayer(prefix, layer, enabled) {
            if (!layer) { return; }
            var h = healthUi(layer.effectiveness, layer.totalReads, enabled !== false);
            var $card = $('#' + prefix + 'Card');
            $card.removeClass('cache-health-effective cache-health-limited cache-health-noteffective').addClass(h.cls);
            $('#' + prefix + 'HealthIcon').text(h.icon);
            $('#' + prefix + 'HealthTitle').text(h.title);
            $('#' + prefix + 'HealthBody').text(h.body);
            $('#' + prefix + 'Hits').text(fmt(layer.hits));
            $('#' + prefix + 'Misses').text(fmt(layer.misses));
            $('#' + prefix + 'HitRate').text(Number(layer.hitRatio || 0).toFixed(1) + '%');
            if ($('#' + prefix + 'DbAvoided').length) {
                $('#' + prefix + 'DbAvoided').text(layer.dbAvoided != null ? fmt(layer.dbAvoided) : cannot);
            }
            $('#' + prefix + 'AvgCached').text(layer.avgCached || cannot);
            $('#' + prefix + 'AvgUncached').text(layer.avgUncached || cannot);
            $('#' + prefix + 'Improvement').text(layer.improvement || cannot);
            $('#' + prefix + 'ImprovementTop').text(layer.improvement || cannot);
            $('#' + prefix + 'CachedBar').css('width', (layer.cachedBarPercent || 0) + '%');
            if (layer.hasTiming) {
                $('#' + prefix + 'NoTiming').addClass('d-none');
            }
        }

        function currentQuery() {
            return {
                search: $('#cacheSearch').val() || '',
                category: $('#cacheCategory').val() || 'all',
                status: $('#cacheStatus').val() || 'all'
            };
        }

        function refreshGrid() {
            var $grid = $('.js-griddly-async [data-role=griddly]');
            if ($grid.length && $.fn.griddly) {
                $grid.griddly('refresh');
            }
        }

        function refreshDiagnostics() {
            var $btn = $('#btnRefreshDiagnostics');
            $btn.prop('disabled', true);
            $.getJSON(diagnosticsUrl, currentQuery())
                .done(function (data) {
                    if (!data || !data.success) { return; }
                    var ov = (data.overview || {}).combined || {};
                    var h = healthUi(ov.effectiveness, ov.totalReads, data.isCacheActive || ov.totalReads > 0);
                    $('#cacheOverviewCard').removeClass('cache-health-effective cache-health-limited cache-health-noteffective').addClass(h.cls);
                    $('#ovStatusIcon').text(h.icon);
                    $('#ovStatusTitle').text(h.title);
                    $('#ovHitRate').text(Number(ov.hitRatio || 0).toFixed(1) + '%');
                    $('#ovHits').text(fmt(ov.hits));
                    $('#ovMisses').text(fmt(ov.misses));
                    $('#ovEntries').text(fmt(ov.activeEntries));
                    $('#ovServed').text(fmt(ov.hits));
                    $('#ovSaved').text(ov.saved || cannot);
                    $('#ovImprovement').text(ov.improvement || cannot);
                    applyLayer('page', (data.overview || {}).page, true);
                    applyLayer('data', (data.overview || {}).data, data.isCacheActive);
                    $('#cacheLastRefreshedValue').text(data.generatedAt || '');
                    refreshGrid();
                })
                .always(function () {
                    $btn.prop('disabled', false);
                });
        }

        $('#btnRefreshDiagnostics').on('click', function () {
            refreshDiagnostics();
        });

        $(document).on('click', '.cache-entry-detail', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var key = $(this).attr('data-key');
            if (!key) { return; }
            $.getJSON(entryUrl, { key: key })
                .done(function (data) {
                    if (!data) { return; }
                    var kind = data.cacheKind === 'page' ? labels.pageKind : labels.dataKind;
                    var rows = [
                        [labels.name, data.displayName || data.key],
                        [labels.key, data.key],
                        [labels.kind, kind],
                        [labels.category, data.category],
                        [labels.status, data.status],
                        [labels.created, data.created],
                        [labels.expires, data.expires],
                        [labels.ttl, data.ttl],
                        [labels.hits, data.hitCount],
                        [labels.misses, data.misses != null ? data.misses : data.missCount],
                        [labels.hitRate, (Number(data.hitRatio || 0)).toFixed(1) + '%'],
                        [labels.avgCached, data.avgCachedMs != null ? Number(data.avgCachedMs).toFixed(1) + ' ms' : cannot],
                        [labels.avgUncached, data.avgUncachedMs != null ? Number(data.avgUncachedMs).toFixed(1) + ' ms' : cannot],
                        [labels.improvement, data.improvementPercent != null ? Number(data.improvementPercent).toFixed(1) + '%' : cannot],
                        [labels.lastAccess, data.lastAccess],
                        [labels.size, data.size]
                    ];
                    var $dl = $('#cacheEntryDetailsList').empty();
                    rows.forEach(function (pair) {
                        $dl.append($('<dt class="col-sm-3"></dt>').text(pair[0]));
                        $dl.append($('<dd class="col-sm-9 text-break"></dd>').text(pair[1] == null ? labels.na : String(pair[1])));
                    });
                    var modalEl = document.getElementById('cacheEntryModal');
                    if (window.bootstrap && bootstrap.Modal) {
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    } else {
                        $(modalEl).modal('show');
                    }
                });
        });
    })(jQuery);
</script>
