@using EImece.Domain
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using Griddly.Mvc
@using Resources

@{
    Layout = null;
    var gridName = "productsGrid";
    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int rowNum = 0;
    int startIndex = 0;


    var settings = new GriddlySettings<Product>()
    {
        ClassName = "eg-grid eg-grid-shell eg-move-products-grid",
        TableClassName = "table table-hover table-striped eg-grid-table",
        PageSize = pageSizeNumber,
        AllowedFilterModes = FilterMode.None,
        RowClass = item => item.IsActive ? string.Empty : "GridIsActive",
        DefaultSort = new[] { new SortField() { Field = "UpdatedDate", Direction = SortDirection.Descending } }
    };

    settings.HtmlAttributes["data-gridname"] = gridName;

    settings.BeforeTemplate = @<text>
        <output class="card-header grid-record-count" style="display:block" aria-live="polite">
            <div class="grid-record-count-inner">
                <span class="grid-record-count-badge griddly-recordtotal"></span>
                <span class="grid-record-count-label">@AdminResource.GridResultRecordNumber</span>
            </div>
            <div class="eg-grid-scroll-controls" title="Tabloyu Sağa/Sola Kaydır">
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-left" title="Sola Kaydır" aria-label="Sola Kaydır">
                    <i class="fa fa-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-right" title="Sağa Kaydır" aria-label="Sağa Kaydır">
                    <i class="fa fa-chevron-right"></i>
                </button>
            </div>
        </output>
    </text>;

    settings
        .Column(caption: "", template: @<text><span class="eg-row-index">@(startIndex + (++rowNum))</span></text>, className: "eg-col-index eg-sticky-left eg-sticky-left-1", width: "44px")
        .Column(caption: "", template: @<text><label class="eg-check-hit"><input gridkey-id="@item.Id" class="gridCheckboxes" name="checkboxGrid" type="checkbox" /></label></text>, className: "gridButtons eg-col-check eg-sticky-left eg-sticky-left-2", width: "44px")
        .Column(caption: AdminResource.Images, template: @<text>@Html.Partial("Grid/_GridImageCell", item, new ViewDataDictionary(ViewData) { { "ShowImageState", false } })</text>, className: "eg-col-image", width: "56px")
        .Column(x => x.Name, caption: AdminResource.Name, template: @<text>@Html.Partial("Grid/_GridNameCell", item)</text>, className: "eg-col-name")
        .Column(x => x.IsActive, caption: AdminResource.Status, template: @<text>@Html.Partial("Grid/_GridStatusGroup", item)</text>, className: "smallGridColumn eg-col-status", width: "175px")
        .Column(x => x.UpdatedDate, caption: AdminResource.UpdatedDate, template: @<text><span class="eg-date-cell"><i class="fa fa-calendar-o text-muted" aria-hidden="true"></i> @(item.UpdatedDate.ToString("dd.MM.yyyy"))</span></text>, className: "gridDateClass eg-col-date", width: "110px");
}

@Html.Griddly(settings)

