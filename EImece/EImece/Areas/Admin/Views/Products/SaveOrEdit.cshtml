            new SelectListItem { Text = Resource.Discontinued, Value = ProductState.Discontinued.ToString() },
            new SelectListItem { Text = Resource.BackorderAvailable, Value = ProductState.Backorder.ToString() },
            new SelectListItem { Text = Resource.ComingSoon, Value = ProductState.ComingSoon.ToString() },
            new SelectListItem { Text = Resource.LimitedStockAvailable, Value = ProductState.LimitedStock.ToString() },
            new SelectListItem { Text = Resource.ReservedForCustomers, Value = ProductState.Reserved.ToString() },
