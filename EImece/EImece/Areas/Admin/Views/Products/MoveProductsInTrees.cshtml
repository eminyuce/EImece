@model List<Product>
@using EImece.Domain.Helpers;
@using Griddly.Mvc;
@using EImece.Domain;
@using Resources;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Models.FrontModels;

@{
    ViewBag.Title = AdminResource.MoveProductsInTrees;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ProductCategory selectedCategory = (ProductCategory)ViewBag.SelectedCategory;

    List<ProductCategoryTreeModel> ProductCategoryTreeLeft = ViewBag.ProductCategoryTreeLeft;
    List<ProductCategoryTreeModel> ProductCategoryTreeRight = ViewBag.ProductCategoryTreeRight;
}
<h2>@AdminResource.MoveProductsInTrees</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "moveProductsHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada ürünleri bir kategoriden başka bir kategoriye <strong>toplu taşırsınız</strong>.</li>
    <li><strong>1.</strong> Soldaki ağaçtan <strong>kaynak kategoriyi</strong> seçin → ortada o kategorinin ürünleri listelenir.</li>
    <li><strong>2.</strong> Taşınacak ürünleri ortadaki listeden <strong>işaretleyin</strong> (checkbox).</li>
    <li><strong>3.</strong> Sağdaki ağaçtan <strong>hedef kategoriyi</strong> tıklayın → seçili ürünler o kategoriye taşınır.</li>
    <li>Kaynak seçimini temizlemek için seçili kategori kutusundaki <strong>Seçimi Temizle</strong> butonunu kullanın.</li>
</ul>
<p style="margin-top: 12px; margin-bottom: 0;"><strong>Örnek:</strong> Solda “Tişörtler” seç → 3 ürünü işaretle → sağda “Kampanya Ürünleri”ne tıkla → ürünler taşınır.</p>
@Html.Partial("_AdminHelpAccordionEnd")

<div class="row eg-move-products-container">
    <div class="col-md-3">
        <div class="eg-move-tree-wrapper">
            @Html.Partial("_ProductCategoryTree", ProductCategoryTreeLeft, new ViewDataDictionary(ViewData){
                            {"UrlPattern","/admin/products/MoveProductsInTrees/"},
                            {"SelectedCategoryId", selectedCategory != null ? selectedCategory.Id : 0},
                            {"TreeTitle", "1. Kaynak Kategori"},
                            {"ShowAllLink", false},
                            {"IsExcelButtonEnabled", true}})
            <span id="treeClickContainer"></span>
        </div>
    </div>
    <div class="col-md-6">
        @if (selectedCategory != null)
        {
            <div class="eg-move-selected-card">
                <div class="eg-move-selected-content">
                    <span class="eg-move-selected-icon"><i class="fa-solid fa-folder-open"></i></span>
                    <div class="eg-move-selected-text">
                        <span class="eg-move-selected-label">@AdminResource.SelectedCategory</span>
                        <strong class="eg-move-selected-title">@selectedCategory.Name</strong>
                    </div>
                </div>
                <a href="@Url.Action("MoveProductsInTrees", "Products", new { id = 0 })" class="btn btn-sm btn-outline-danger eg-move-clear-btn" title="Kategori seçimini temizle">
                    <i class="fa-solid fa-xmark"></i> Seçimi Temizle
                </a>
                <input type="hidden" id="selectedCategory" value="@selectedCategory.Id" />
            </div>

            if (!String.IsNullOrEmpty(ViewBag.MoveProductsMessage))
            {
                <div class="alert alert-success eg-move-success-alert d-flex align-items-center justify-content-between" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check fa-lg eg-move-success-icon" aria-hidden="true"></i>
                        <span>@ViewBag.MoveProductsMessage</span>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info eg-move-guide-alert d-flex align-items-center gap-3">
                <i class="fa-solid fa-circle-info fa-2x text-primary" aria-hidden="true"></i>
                <div>
                    <h6 class="mb-1 fw-bold text-dark">Kaynak Kategori Seçilmedi</h6>
                    <p class="mb-0 text-muted small">Ürünlerini listelemek ve taşımak için soldaki <strong>1. Kaynak Kategori</strong> ağacından bir kategoriye tıklayın.</p>
                </div>
            </div>

            if (!String.IsNullOrEmpty(ViewBag.MoveProductsMessage))
            {
                <div class="alert alert-success eg-move-success-alert d-flex align-items-center justify-content-between" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check fa-lg eg-move-success-icon" aria-hidden="true"></i>
                        <span>@ViewBag.MoveProductsMessage</span>
                    </div>
                </div>
            }
        }

        <div class="eg-move-toolbar">
            <div class="d-flex align-items-center flex-wrap gap-2">
                <a href="@Url.Action("Index", "Products")" class="btn btn-sm btn-outline-secondary eg-move-back-btn" id="btnBackToProducts">
                    <i class="fa-solid fa-arrow-left"></i> Ürün Listesine Dön
                </a>
                <button type="button" id="btnSelectAll" class="btn btn-sm btn-outline-primary">
                    <i class="fa-regular fa-square-check"></i> allü Seç
                </button>
                <button type="button" id="btnDeselectAll" class="btn btn-sm btn-outline-secondary">
                    <i class="fa-regular fa-square"></i> Seçimi Kaldır
                </button>
            </div>
            <div id="selectedCountBadgeContainer" style="display:none;">
                <span class="badge bg-primary text-white eg-move-selected-counter">
                    <i class="fa-solid fa-circle-check"></i> <span id="selectedProductCount">0</span> ürün seçildi
                </span>
            </div>
        </div>

        <div class="eg-move-search-card">
            <div class="eg-move-search-inner">
                <i class="fa-solid fa-magnifying-glass eg-move-search-icon" aria-hidden="true"></i>
                <input type="text" id="egMoveSearchInput" class="form-control form-control-sm eg-move-search-field" placeholder="Ürün adı, ürün kodu veya ID ile ara..." value="@ViewBag.Search" autocomplete="off" />
                <button type="button" id="egBtnClearSearch" class="btn btn-sm eg-move-search-clear" title="Aramayı temizle" style="@(string.IsNullOrEmpty(ViewBag.Search as string) ? "display:none;" : "")">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>

        <div class="js-griddly-async" data-url="@Url.Action("MoveProductsInTreesGrid", new { id = selectedCategory != null ? selectedCategory.Id : 0, search = ViewBag.Search })"></div>
    </div>
    <div class="col-md-3">
        <div class="eg-move-tree-wrapper">
            @Html.Partial("_ProductCategoryTree", ProductCategoryTreeRight, new ViewDataDictionary(ViewData){
                            {"UrlPattern",""},
                            {"TreeTitle", "2. Hedef Kategori"},
                            {"ShowPickHint", true},
                            {"IsExcelButtonEnabled", true}})
        </div>
    </div>
</div>

@section Scripts{
    <script>
        function updateSelectedCount() {
            var count = $("input[name=checkboxGrid]:checked").length;
            var badgeContainer = $("#selectedCountBadgeContainer");
            var badgeCount = $("#selectedProductCount");
            if (count > 0) {
                badgeCount.text(count);
                badgeContainer.show();
            } else {
                badgeContainer.hide();
            }
        }

        function filterGridRows() {
            var query = ($("#egMoveSearchInput").val() || "").toLowerCase().trim();
            $("#egBtnClearSearch").toggle(query.length > 0);
            var $rows = $(".eg-move-products-grid tbody tr:not(#egNoSearchResultRow)");
            var matches = 0;

            $rows.each(function () {
                var $row = $(this);
                if ($row.find(".griddly-empty").length) {
                    return;
                }
                var text = $row.text().toLowerCase();
                if (!query || text.indexOf(query) >= 0) {
                    $row.show();
                    matches++;
                } else {
                    $row.hide();
                }
            });

            var $noMatchRow = $("#egNoSearchResultRow");
            if ($rows.length > 0 && matches === 0 && query.length > 0) {
                if (!$noMatchRow.length) {
                    var safeQuery = $("<div>").text(query).html();
                    $(".eg-move-products-grid tbody").append('<tr id="egNoSearchResultRow"><td colspan="5" class="text-center text-muted py-4"><i class="fa-solid fa-magnifying-glass fa-2x mb-2 d-block text-secondary"></i>"<strong>' + safeQuery + '</strong>" ile eşleşen ürün bulunamadı.</td></tr>');
                } else {
                    var safeQuery = $("<div>").text(query).html();
                    $noMatchRow.html('<td colspan="5" class="text-center text-muted py-4"><i class="fa-solid fa-magnifying-glass fa-2x mb-2 d-block text-secondary"></i>"<strong>' + safeQuery + '</strong>" ile eşleşen ürün bulunamadı.</td>').show();
                }
            } else {
                if ($noMatchRow.length) {
                    $noMatchRow.hide();
                }
            }
        }

        function productTreeClick(e, id, name) {
            if (e && e.preventDefault) {
                e.preventDefault();
            }
            var productIdList = [];
            $("input[name=checkboxGrid]").each(function () {
                var m = $(this).is(':checked');
                if (m) {
                    productIdList.push($(this).attr("gridkey-id"));
                }
            });

            if (productIdList.length === 0) {
                alert("Lütfen önce ortadaki listeden taşımak istediğiniz ürünleri işaretleyin (checkbox).");
                return;
            }

            var selectedCat = $("#selectedCategory").val();
            if (!selectedCat || selectedCat === "0") {
                alert("Lütfen önce soldaki ağaçtan kaynak kategoriyi seçin.");
                return;
            }

            if (String(selectedCat) === String(id)) {
                alert("Hedef kategori ile kaynak kategori aynı olamaz. Lütfen farklı bir hedef kategori seçin.");
                return;
            }

            if (confirm(productIdList.length + " adet seçili ürün '" + name + "' kategorisine taşınacak. Onaylıyor musunuz?")) {
                var link = '/admin/products/MoveProducts/' + id + "?productIdList=" + productIdList.join(',') + "&oldCategoryId=" + selectedCat;
                window.location = link;
            }
        }

        $(document).ready(function () {
            $(document).on("click", "#btnSelectAll", function (e) {
                e.preventDefault();
                // Check visible products
                $(".eg-move-products-grid tbody tr:visible input[name=checkboxGrid]").prop("checked", true).trigger("change");
                updateSelectedCount();
            });

            $(document).on("click", "#btnDeselectAll", function (e) {
                e.preventDefault();
                $("input[name=checkboxGrid]").prop("checked", false).trigger("change");
                updateSelectedCount();
            });

            $(document).on("change", "input[name=checkboxGrid]", function () {
                updateSelectedCount();
            });

            $(document).on("input keyup", "#egMoveSearchInput", function () {
                filterGridRows();
            });

            $(document).on("click", "#egBtnClearSearch", function () {
                $("#egMoveSearchInput").val("");
                filterGridRows();
                $("#egMoveSearchInput").focus();
            });

            $(document).ajaxComplete(function () {
                updateSelectedCount();
                filterGridRows();
            });

            updateSelectedCount();
            filterGridRows();
        });
    </script>
}