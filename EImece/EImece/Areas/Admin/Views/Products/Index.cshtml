@model List<Product>
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain.Entities;
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Models.AdminModels;
@using EImece.Domain;
@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers.HtmlHelpers;
@using Resources;
@using EImece.Domain.Models.FrontModels;
@using System.Globalization;
@{
    ViewBag.Title = "Products";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : AppConfig.GridPageSizeNumber * (gridPage - 1);

    var controllerName = "Products";
    var gridName = "productGrid";
    var contents = Model;
    ProductCategory selectedCategory = (ProductCategory)ViewBag.SelectedCategory;
    var products = Model;
    var baseList = contents.DownCasting<Product>();
    List<Brand> brands = (ViewBag.Brands != null ? (List<Brand>)ViewBag.Brands : new List<Brand>())
        .OrderBy(b => b.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToList();
    List<ProductState> productStates = ViewBag.ProductStates != null
        ? (List<ProductState>)ViewBag.ProductStates
        : Enum.GetValues(typeof(ProductState)).Cast<ProductState>().ToList();
    var gridImagesText = AdminResource.GridImagesText;
    var gridEditText = AdminResource.GridEditText;
    var gridDeleteText = AdminResource.GridDeleteText;
    var gridDetailText = AdminResource.GridDetailText;

    Setting isProductPriceEnable = ViewBag.IsProductPriceEnable != null ? (Setting)ViewBag.IsProductPriceEnable : null;
    bool priceEnabled = isProductPriceEnable == null || isProductPriceEnable.SettingValue.ToBool(true);
    int selectedBrandId = ViewBag.SelectedBrandId != null ? (int)ViewBag.SelectedBrandId : -1;
    var selectedBrandEntity = selectedBrandId > 0 ? brands.FirstOrDefault(b => b.Id == selectedBrandId) : null;
    string selectedBrandName = selectedBrandEntity != null ? selectedBrandEntity.Name : "";
    int categoryIdForFilter = selectedCategory == null ? 0 : selectedCategory.Id;
    string selectedState = ViewBag.SelectedState != null ? System.Convert.ToString(ViewBag.SelectedState) : "";
    bool filterIsActive = ViewBag.FilterIsActive != null && System.Convert.ToBoolean(ViewBag.FilterIsActive);
    bool filterMainPage = ViewBag.FilterMainPage != null && System.Convert.ToBoolean(ViewBag.FilterMainPage);
    bool filterIsCampaign = ViewBag.FilterIsCampaign != null && System.Convert.ToBoolean(ViewBag.FilterIsCampaign);
    decimal? minPrice = ViewBag.MinPrice != null ? System.Convert.ToDecimal(ViewBag.MinPrice, CultureInfo.InvariantCulture) : (decimal?)null;
    decimal? maxPrice = ViewBag.MaxPrice != null ? System.Convert.ToDecimal(ViewBag.MaxPrice, CultureInfo.InvariantCulture) : (decimal?)null;
    string search = Request.QueryString["search"].ToStr();
    ProductAdminListFilter productFilter = ViewBag.ProductFilter != null
        ? (ProductAdminListFilter)ViewBag.ProductFilter
        : new ProductAdminListFilter();

    var treeQueryParts = new List<string>();
    if (selectedBrandId > 0)
    {
        treeQueryParts.Add("brandId=" + selectedBrandId);
    }
    if (!string.IsNullOrEmpty(search))
    {
        treeQueryParts.Add("search=" + Uri.EscapeDataString(search));
    }
    var filterQuery = productFilter.ToQueryString();
    if (!string.IsNullOrEmpty(filterQuery))
    {
        treeQueryParts.Add(filterQuery);
    }
    string treeUrlQuery = string.Join("&", treeQueryParts);

    bool hasAdvancedFilter = selectedBrandId > 0
        || !string.IsNullOrEmpty(selectedState)
        || filterIsActive
        || filterMainPage
        || filterIsCampaign
        || (priceEnabled && (minPrice.HasValue || maxPrice.HasValue));

    var activeFilterChips = new List<Tuple<string, string>>();
    if (selectedBrandId > 0)
    {
        var selectedBrand = brands.FirstOrDefault(b => b.Id == selectedBrandId);
        activeFilterChips.Add(Tuple.Create(AdminResource.Brands, selectedBrand != null ? selectedBrand.Name : selectedBrandId.ToString()));
    }
    if (!string.IsNullOrEmpty(selectedState))
    {
        activeFilterChips.Add(Tuple.Create(AdminResource.ProductState, selectedState));
    }
    if (filterIsActive) { activeFilterChips.Add(Tuple.Create(AdminResource.IsActive, (string)null)); }
    if (filterMainPage) { activeFilterChips.Add(Tuple.Create(AdminResource.MainPage, (string)null)); }
    if (filterIsCampaign) { activeFilterChips.Add(Tuple.Create(AdminResource.IsCampaign, (string)null)); }
    if (priceEnabled && (minPrice.HasValue || maxPrice.HasValue))
    {
        var minLabel = minPrice.HasValue ? minPrice.Value.ToString("0.##", CultureInfo.InvariantCulture) : "…";
        var maxLabel = maxPrice.HasValue ? maxPrice.Value.ToString("0.##", CultureInfo.InvariantCulture) : "…";
        activeFilterChips.Add(Tuple.Create(AdminResource.Price, minLabel + " – " + maxLabel));
    }

    string clearFiltersUrl = Url.Action("Index", "Products", new { id = categoryIdForFilter, search = search });
    List<ProductCategoryTreeModel> ProductCategoryTree = ViewBag.ProductCategoryTree;

    string quickChipIsActiveUrl = Url.Action("Index", "Products", new
    {
        id = categoryIdForFilter,
        brandId = selectedBrandId > 0 ? (int?)selectedBrandId : null,
        search = string.IsNullOrEmpty(search) ? null : search,
        state = string.IsNullOrEmpty(selectedState) ? null : selectedState,
        isActive = filterIsActive ? null : (bool?)true,
        mainPage = filterMainPage ? (bool?)true : null,
        isCampaign = filterIsCampaign ? (bool?)true : null,
        minPrice = priceEnabled ? minPrice : null,
        maxPrice = priceEnabled ? maxPrice : null
    });
    string quickChipMainPageUrl = Url.Action("Index", "Products", new
    {
        id = categoryIdForFilter,
        brandId = selectedBrandId > 0 ? (int?)selectedBrandId : null,
        search = string.IsNullOrEmpty(search) ? null : search,
        state = string.IsNullOrEmpty(selectedState) ? null : selectedState,
        isActive = filterIsActive ? (bool?)true : null,
        mainPage = filterMainPage ? null : (bool?)true,
        isCampaign = filterIsCampaign ? (bool?)true : null,
        minPrice = priceEnabled ? minPrice : null,
        maxPrice = priceEnabled ? maxPrice : null
    });
    string quickChipCampaignUrl = Url.Action("Index", "Products", new
    {
        id = categoryIdForFilter,
        brandId = selectedBrandId > 0 ? (int?)selectedBrandId : null,
        search = string.IsNullOrEmpty(search) ? null : search,
        state = string.IsNullOrEmpty(selectedState) ? null : selectedState,
        isActive = filterIsActive ? (bool?)true : null,
        mainPage = filterMainPage ? (bool?)true : null,
        isCampaign = filterIsCampaign ? null : (bool?)true,
        minPrice = priceEnabled ? minPrice : null,
        maxPrice = priceEnabled ? maxPrice : null
    });
}
<h2>@AdminResource.ProductPageTitle</h2>
<hr class="adminLine" />

<div class="row eg-products-layout">
    <div class="col-md-3 eg-products-tree-col">
        @Html.Partial("_ProductCategoryTree", ProductCategoryTree, new ViewDataDictionary(ViewData){
                            {"UrlPattern","/admin/products/index/"}
                          ,{"UrlQuery", treeUrlQuery}
                          ,{"SelectedCategoryId", selectedCategory != null ? selectedCategory.Id : 0}
                          ,{"ShowAllLink", true}
                          ,{"IsExcelButtonEnabled",true}})

        <span id="treeClickContainer"></span>
    </div>
    <div class="col-md-9 eg-products-main-col">

        @if (selectedCategory != null)
        {
            <div class="eg-selected-category">
                <span class="eg-selected-category-label">@AdminResource.SelectedCategory</span>
                <strong class="eg-selected-category-name">@selectedCategory.Name</strong>
                <a class="eg-selected-category-clear"
                   href="@Url.Action("Index", "Products", new {
                    id = 0,
                    brandId = selectedBrandId,
                    search = search,
                    state = selectedState,
                    isActive = filterIsActive ? (bool?)true : null,
                    mainPage = filterMainPage ? (bool?)true : null,
                    isCampaign = filterIsCampaign ? (bool?)true : null,
                    minPrice = priceEnabled ? minPrice : null,
                    maxPrice = priceEnabled ? maxPrice : null
                })"
                   title="Kategori filtresini temizle"
                   aria-label="Kategori filtresini temizle">
                    <i class="glyphicon glyphicon-remove" aria-hidden="true"></i>
                </a>
            </div>
        }

        <div class="panel panel-default product-admin-filters @(hasAdvancedFilter ? "is-open" : "is-collapsed")" id="productAdminFilters">
            <button type="button" class="panel-heading product-admin-filters-heading"
                 data-toggle="collapse" data-target="#productAdminFiltersBody"
                 aria-expanded="@(hasAdvancedFilter ? "true" : "false")" aria-controls="productAdminFiltersBody">
                <div class="product-admin-filters-heading-main">
                    <span class="product-admin-filters-title">
                        <i class="glyphicon glyphicon-filter" aria-hidden="true"></i>
                        Filtreler
                    </span>
                    @if (activeFilterChips.Count > 0)
                    {
                        <span class="badge product-admin-filters-count">@activeFilterChips.Count</span>
                    }
                    else
                    {
                        <span class="product-admin-filters-hint">Marka, durum, fiyat…</span>
                    }
                </div>
                <span class="product-admin-filters-chevron glyphicon @(hasAdvancedFilter ? "glyphicon-chevron-up" : "glyphicon-chevron-down")" aria-hidden="true"></span>
            </button>

            @if (activeFilterChips.Count > 0)
            {
                <div class="product-admin-filters-summary">
                    @foreach (var chip in activeFilterChips)
                    {
                        string chipText = chip.Item1;
                        if (!string.IsNullOrEmpty(chip.Item2))
                        {
                            if (string.Equals(chip.Item1, AdminResource.ProductState, StringComparison.Ordinal))
                            {
                                ProductState chipState;
                                chipText = chip.Item1 + ": " + (Enum.TryParse(chip.Item2, true, out chipState)
                                    ? GetProductStateResourceText(chipState)
                                    : chip.Item2);
                            }
                            else
                            {
                                chipText = chip.Item1 + ": " + chip.Item2;
                            }
                        }
                        <span class="label label-info product-admin-filter-chip">@chipText</span>
                    }
                    <a class="product-admin-filters-clear-link" href="@clearFiltersUrl" title="@AdminResource.Clear">
                        <i class="glyphicon glyphicon-remove" aria-hidden="true"></i> @AdminResource.Clear
                    </a>
                </div>
            }

            @{
                var sortedProductStates = productStates
                    .Select(st => new { Value = st.ToString(), Label = GetProductStateResourceText(st) })
                    .OrderBy(x => x.Label, StringComparer.CurrentCultureIgnoreCase)
                    .ToList();
                string selectedStateLabel = "";
                if (!string.IsNullOrEmpty(selectedState))
                {
                    ProductState selectedStateEnum;
                    selectedStateLabel = Enum.TryParse(selectedState, true, out selectedStateEnum)
                        ? GetProductStateResourceText(selectedStateEnum)
                        : selectedState;
                }
            }
            <div id="productAdminFiltersBody" class="panel-collapse collapse @(hasAdvancedFilter ? "in" : "")">
                <div class="panel-body">
                    @using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "product-admin-filter-form", id = "productAdminFilterForm" }))
                    {
                        <input type="hidden" name="id" value="@categoryIdForFilter" />
                        if (!string.IsNullOrEmpty(search))
                        {
                            <input type="hidden" name="search" value="@search" />
                        }

                        <div class="row">
                            <div class="col-sm-@(priceEnabled ? "3" : "6")">
                                <div class="form-group">
                                    <label for="brandSearch">@AdminResource.Brands</label>
                                    <div class="product-admin-combo">
                                        <input type="text"
                                               class="form-control input-sm"
                                               id="brandSearch"
                                               list="brandDatalist"
                                               value="@selectedBrandName"
                                               placeholder="@Resource.All"
                                               autocomplete="off" />
                                        <input type="hidden" name="brandId" id="brandId" value="@(selectedBrandId > 0 ? selectedBrandId.ToString() : "-1")" />
                                        <datalist id="brandDatalist">
                                            <option value="@Resource.All" data-value="-1"></option>
                                            @foreach (var b in brands)
                                            {
                                                <option value="@b.Name" data-value="@b.Id"></option>
                                            }
                                        </datalist>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-@(priceEnabled ? "3" : "6")">
                                <div class="form-group">
                                    <label for="stateSearch">@AdminResource.ProductState</label>
                                    <div class="product-admin-combo">
                                        <input type="text"
                                               class="form-control input-sm"
                                               id="stateSearch"
                                               list="stateDatalist"
                                               value="@selectedStateLabel"
                                               placeholder="@Resource.All"
                                               autocomplete="off" />
                                        <input type="hidden" name="state" id="state" value="@selectedState" />
                                        <datalist id="stateDatalist">
                                            <option value="@Resource.All" data-value=""></option>
                                            @foreach (var st in sortedProductStates)
                                            {
                                                <option value="@st.Label" data-value="@st.Value"></option>
                                            }
                                        </datalist>
                                    </div>
                                </div>
                            </div>
                            @if (priceEnabled)
                            {
                                <div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="minPrice">@AdminResource.Price</label>
                                        <div class="product-admin-price-range">
                                            <input type="number" step="0.01" min="0" class="form-control input-sm" id="minPrice" name="minPrice"
                                                   placeholder="Min"
                                                   value="@(minPrice.HasValue ? minPrice.Value.ToString(CultureInfo.InvariantCulture) : "")" />
                                            <span class="product-admin-price-sep">–</span>
                                            <label class="sr-only" for="maxPrice">Max</label>
                                            <input type="number" step="0.01" min="0" class="form-control input-sm" id="maxPrice" name="maxPrice"
                                                   placeholder="Max"
                                                   value="@(maxPrice.HasValue ? maxPrice.Value.ToString(CultureInfo.InvariantCulture) : "")" />
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="product-admin-filter-flags">
                            <span class="product-admin-filter-flags-label">Özellikler</span>
                            <div class="product-admin-filter-toggles">
                                <label class="product-admin-toggle @(filterIsActive ? "is-on" : "")">
                                    <input type="checkbox" name="isActive" value="true" @(filterIsActive ? "checked=\"checked\"" : null) />
                                    <span>@AdminResource.IsActive</span>
                                </label>
                                <label class="product-admin-toggle @(filterMainPage ? "is-on" : "")">
                                    <input type="checkbox" name="mainPage" value="true" @(filterMainPage ? "checked=\"checked\"" : null) />
                                    <span>@AdminResource.MainPage</span>
                                </label>
                                <label class="product-admin-toggle @(filterIsCampaign ? "is-on" : "")">
                                    <input type="checkbox" name="isCampaign" value="true" @(filterIsCampaign ? "checked=\"checked\"" : null) />
                                    <span>@AdminResource.IsCampaign</span>
                                </label>
                            </div>
                        </div>

                        <div class="product-admin-filter-actions">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="glyphicon glyphicon-ok" aria-hidden="true"></i> Filtrele
                            </button>
                            <a class="btn btn-default btn-sm" href="@clearFiltersUrl">
                                <i class="glyphicon glyphicon-remove" aria-hidden="true"></i> @AdminResource.Clear
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        @{
            var preserveQuery = new Dictionary<string, string>();
            if (selectedBrandId > 0)
            {
                preserveQuery["brandId"] = selectedBrandId.ToString();
            }
            if (!string.IsNullOrEmpty(selectedState))
            {
                preserveQuery["state"] = selectedState;
            }
            if (filterIsActive)
            {
                preserveQuery["isActive"] = "true";
            }
            if (filterMainPage)
            {
                preserveQuery["mainPage"] = "true";
            }
            if (filterIsCampaign)
            {
                preserveQuery["isCampaign"] = "true";
            }
            if (priceEnabled && minPrice.HasValue)
            {
                preserveQuery["minPrice"] = minPrice.Value.ToString(CultureInfo.InvariantCulture);
            }
            if (priceEnabled && maxPrice.HasValue)
            {
                preserveQuery["maxPrice"] = maxPrice.Value.ToString(CultureInfo.InvariantCulture);
            }
        }

        <div class="eg-quick-filters" aria-label="Hızlı filtreler">
            <a class="eg-quick-chip @(filterIsActive ? "is-active" : "")" href="@quickChipIsActiveUrl">
                @AdminResource.IsActive
            </a>
            <a class="eg-quick-chip @(filterMainPage ? "is-active" : "")" href="@quickChipMainPageUrl">
                @AdminResource.MainPage
            </a>
            <a class="eg-quick-chip @(filterIsCampaign ? "is-active" : "")" href="@quickChipCampaignUrl">
                @AdminResource.IsCampaign
            </a>
            @if (hasAdvancedFilter || !string.IsNullOrEmpty(search))
            {
                <a class="eg-quick-chip" href="@clearFiltersUrl">@AdminResource.Clear</a>
            }
        </div>

        @Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
                            {"controllerName",controllerName}
            ,{"StateTypes","State,ImageState,MainPage,IsCampaign"}
           ,{"orderingButton",true}
           ,{"selectAll",true}
           ,{"deleteAll",true}
            ,{"ProductState",true}
            ,{"SetStateOnOrOff",true}
            ,{"IsExcelButtonEnabled",true}
            ,{"IdValueExists",true}
            ,{"PreserveQuery",preserveQuery}})

        <div class="eg-products-toolbar-gap">
            <a class="eg-admin-move-link eg-products-move-link" href="@Url.Action("MoveProductsInTrees")">
                <i class="glyphicon glyphicon-transfer" aria-hidden="true"></i>
                <span>@AdminResource.MoveProductsInTrees</span>
            </a>
        </div>

        @Html.Partial("Grid/_GridChrome")

        <div class="panel panel-primary eg-grid-shell">

            @Html.Partial("pGridDropDown", baseList)

            @Html.Grid(contents).Named(gridName).Columns(columns =>
       {
           columns.Add()
    .Encoded(false)
    .Sanitized(false)
    .Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
    .RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

           columns.Add(o => o.Id, true);

           columns.Add()
                          .Encoded(false)
                          .Sanitized(false)
                           .Css("gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check")
                          .RenderValueAs(d => Html.Partial("pGridCheckbox", new ViewDataDictionary(ViewData){
            {"ItemId",d.Id}}));

           columns.Add()
              .Titled(AdminResource.Images)
              .Encoded(false)
              .Sanitized(false)
              .Css("eg-col-image")
              .RenderValueAs(o => Html.Partial("Grid/_GridImageCell", o));

           columns.Add(c => c.Name)
              .Titled(AdminResource.Name)
              .Filterable(true)
               .Encoded(false)
                .Sanitized(false)
                .Css("eg-col-name")
          .RenderValueAs(d => Html.Partial("Grid/_GridNameCell", d));

           columns.Add(c => c.ProductCategory)
           .Titled(AdminResource.ProductCategory)
           .Encoded(false)
           .Filterable(true)
           .RenderValueAs(o => o.ProductCategory != null ? o.ProductCategory.Name : "");

           columns.Add(c => c.BrandId)
           .Titled(AdminResource.Brands)
           .Encoded(false)
           .Filterable(true)
           .RenderValueAs(o => (o.BrandId.HasValue && o.Brand != null) ? o.Brand.Name : "");


           if (isProductPriceEnable == null || isProductPriceEnable.SettingValue.ToBool(true))
           {
               columns.Add(c => c.Price).
               Titled(AdminResource.Price).
               Sanitized(false).
               Sortable(true).
               Encoded(false).
               Css("eg-col-price").
               RenderValueAs(o => Html.Partial("Grid/_GridPriceCell", o));

           }

           columns.Add(o => o.State)
            .Titled(AdminResource.ProductState)
            .Sortable(true)
            .Css("smallGridColumn eg-col-state")
            .SortInitialDirection(GridSortDirection.Descending).Encoded(false).
            Sanitized(false)
            .RenderValueAs(o => {
                var stateText = GetProductStateResourceText(o.StateEnum);
                return String.Format("<div class='eg-state-badge' Product-State-Id='{0}' name='ProductState' title='{1}'>{1}</div>", o.Id, HttpUtility.HtmlAttributeEncode(stateText));
            });

           columns.Add(o => o.Position).Titled(AdminResource.Position)
     .Encoded(false).
     Sanitized(false).
     Css("smallGridColumn").
     RenderValueAs(o => String.Format("<input   gridkey-id='{0}' value='{1}'   class='GridOrderingTextbox input-xs' name='gridOrdering' type='type'>", o.Id, o.Position));

           columns.Add(o => o.IsActive)
           .Titled(AdminResource.IsActive)
           .Sortable(true)
           .Css("smallGridColumn eg-col-status")
           .SortInitialDirection(GridSortDirection.Descending).Encoded(false).
           Sanitized(false)
           .RenderValueAs(o => Html.Partial("Grid/_GridStatusGroup", o));

           columns.Add()
           .Titled("İşlemler")
           .Encoded(false)
           .Sanitized(false)
           .Css("eg-sticky-right eg-col-actions")
           .RenderValueAs(d => Html.Partial("Grid/_GridActionsMenu", d, new ViewDataDictionary(ViewData){
               {"controllerName", controllerName}
           }));

       }).SetRowCssClasses(item => item.IsActive ? string.Empty : "GridIsActive").WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
        </div>
    </div>
</div>

@section Scripts{
    <script>
        $(document).ready(function () {
            var $panel = $('#productAdminFilters');
            var $body = $('#productAdminFiltersBody');
            var $chevron = $panel.find('.product-admin-filters-chevron');
            var $heading = $panel.find('.product-admin-filters-heading');

            $body.on('show.bs.collapse', function () {
                $panel.removeClass('is-collapsed').addClass('is-open');
                $chevron.removeClass('glyphicon-chevron-down').addClass('glyphicon-chevron-up');
                $heading.attr('aria-expanded', 'true');
            }).on('hide.bs.collapse', function () {
                $panel.removeClass('is-open').addClass('is-collapsed');
                $chevron.removeClass('glyphicon-chevron-up').addClass('glyphicon-chevron-down');
                $heading.attr('aria-expanded', 'false');
            });

            $panel.on('change', '.product-admin-toggle input[type=checkbox]', function () {
                $(this).closest('.product-admin-toggle').toggleClass('is-on', this.checked);
            });

            // HTML5 <datalist> is searchable/editable; map display text -> hidden values for submit.
            function normalizeLabel(value) {
                return (value || '').replace(/\s+/g, ' ').trim().toLocaleLowerCase('tr-TR');
            }

            function syncCombo($input, $hidden, datalistId, emptyValue) {
                var typed = normalizeLabel($input.val());
                var $options = $('#' + datalistId + ' option');
                if (!typed) {
                    $hidden.val(emptyValue);
                    return;
                }

                var match = null;
                $options.each(function () {
                    var label = normalizeLabel($(this).attr('value'));
                    if (label === typed) {
                        match = $(this).attr('data-value');
                        return false;
                    }
                });

                if (match !== null && typeof match !== 'undefined') {
                    $hidden.val(match);
                } else {
                    // Unknown free text should not filter by accident.
                    $hidden.val(emptyValue);
                }
            }

            var $brandSearch = $('#brandSearch');
            var $brandId = $('#brandId');
            var $stateSearch = $('#stateSearch');
            var $state = $('#state');
            var $form = $('#productAdminFilterForm');

            function syncBrand() { syncCombo($brandSearch, $brandId, 'brandDatalist', '-1'); }
            function syncState() { syncCombo($stateSearch, $state, 'stateDatalist', ''); }
            function syncCombos() {
                syncBrand();
                syncState();
            }

            $brandSearch.on('input change blur', syncBrand);
            $stateSearch.on('input change blur', syncState);
            $form.on('submit', syncCombos);
            $form.find('button[type="submit"]').on('click', syncCombos);
        });
    </script>
}


@functions {

    private string GetProductStateResourceText(ProductState state)
    {
        switch (state)
        {
            case ProductState.NONE:
                return Resource.NONE;
            case ProductState.ProductInStock:
                return Resource.ProductInStock;
            case ProductState.ProductOutOfStock:
                return Resource.ProductOutOfStock;
            case ProductState.PreOrder:
                return Resource.PreOrderAvailable;
            case ProductState.Discontinued:
                return Resource.Discontinued;
            case ProductState.Backorder:
                return Resource.BackorderAvailable;
            case ProductState.ComingSoon:
                return Resource.ComingSoon;
            case ProductState.LimitedStock:
                return Resource.LimitedStockAvailable;
            case ProductState.Reserved:
                return Resource.ReservedForCustomers;
            case ProductState.AwaitingRestock:
                return Resource.AwaitingRestock;
            case ProductState.NotForSale:
                return Resource.NotForSale;
            default:
                throw new ArgumentOutOfRangeException("Unknown ProductState value:"+ state);
        }
    }
}
