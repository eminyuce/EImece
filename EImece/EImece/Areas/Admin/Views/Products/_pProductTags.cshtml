@model EImece.Domain.Models.AdminModels.ProductAdminModel
@using EImece.Domain.Entities
@using System.Linq
@{
    var tagCategories = Model.TagCategories ?? new List<TagCategory>();
    var selectedTags = Model.Product != null && Model.Product.ProductTags != null
        ? Model.Product.ProductTags.Select(t => t.TagId).ToList()
        : new List<int>();
    TempData["selectedTags"] = selectedTags;
}
@Html.Partial("~/Areas/Admin/Views/Shared/pSelectedTags.cshtml", tagCategories.ToList())
