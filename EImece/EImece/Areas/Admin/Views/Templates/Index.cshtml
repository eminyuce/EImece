@model List<EImece.Domain.Entities.Template>
@using Griddly.Mvc
@using EImece.Domain.Helpers
@using Resources

@{
    ViewBag.Title = AdminResource.Templates;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var controllerName = "Templates";
}

@Html.AdminBreadcrumb(AdminResource.Templates)
<h2 class="admin-page-title">@AdminResource.Templates</h2>
<hr class="adminLine" />

<div class="admin-workflow-callout">
    <strong>Şablonlar</strong> ürün ek özellik formlarını tanımlar (XML).
    Yeni kayıt açıp <em>Rastgele örnek şablon oluştur</em> ile başlayabilirsiniz.
    Dropdown için önce <a href="@Url.Action("Index", "Lists")">Değer listeleri</a> tanımlayın.
</div>

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
    {"controllerName",controllerName},
    {"StateTypes","State"},
    {"orderingButton",true},
    {"selectAll",true},
    {"deleteAll",true},
    {"SetStateOnOrOff",true},
    {"IsExcelButtonEnabled",true}
})

@Html.Partial("Grid/_GridChrome")

<div class="js-griddly-async" data-url="@Url.Action("IndexGrid", new { search = Request.QueryString["search"] })"></div>
