@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Models.Enums
@using Griddly.Mvc
@using Resources

@{
    Layout = null;
    var gridName = "OrdersGrid";
    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int rowNum = 0;
    int startIndex = 0;

    var controllerName = "Orders";

    var settings = new GriddlySettings<Order>()
    {
        ClassName = "eg-grid eg-grid-shell eg-orders-grid",
        TableClassName = "table table-hover table-striped eg-grid-table",
        PageSize = pageSizeNumber,
        AllowedFilterModes = FilterMode.None,
        DefaultSort = new[] { new SortField() { Field = "CreatedDate", Direction = SortDirection.Descending } }
    };

    settings.HtmlAttributes["data-gridname"] = gridName;

    settings.BeforeTemplate = @<text>
        <output class="card-header grid-record-count" style="display:block" aria-live="polite">
            <div class="grid-record-count-inner">
                <span class="grid-record-count-badge griddly-recordtotal"></span>
                <span class="grid-record-count-label">@AdminResource.GridResultRecordNumber</span>
            </div>
            <div class="eg-grid-scroll-controls" title="Tabloyu Sağa/Sola Kaydır">
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-left" title="Sola Kaydır" aria-label="Sola Kaydır">
                    <i class="fa fa-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-right" title="Sağa Kaydır" aria-label="Sağa Kaydır">
                    <i class="fa fa-chevron-right"></i>
                </button>
            </div>
        </output>
    </text>;

    settings
        .Column(caption: "", template: @<text><span class="eg-row-index">@(startIndex + (++rowNum))</span></text>, className: "eg-sticky-left eg-sticky-left-1 eg-col-index", width: "44px")
        .Column(caption: "", template: @<text><input gridkey-id="@item.Id" class="gridCheckboxes" name="checkboxGrid" type="checkbox" /></text>, className: "gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check", width: "44px")
        .Column(x => x.OrderNumber, caption: AdminResource.OrderNumber, template: @<text>@Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) { { "Name", item.OrderNumber }, { "DetailUrl", Url.Action("Details", controllerName, new { id = item.Id }) }, { "StrongName", true } })</text>, className: "eg-col-name", width: "240px")
        .Column(x => x.OrderStatus, caption: AdminResource.OrderStatus, template: @<text>@OrderStatusBadge(item.OrderStatus)</text>, className: "eg-col-state eg-col-order-status", width: "200px")
        .Column(x => x.CreatedDate, caption: AdminResource.CreatedDate, template: @<text>@(item.CreatedDate.ToShortDateString())</text>, className: "gridDateClass eg-col-secondary", width: "120px")
        .Column(x => x.PaidPrice, caption: "Ödenen Tutar", template: @<text>@(item.PaidPrice + " " + item.Currency)</text>, className: "eg-col-order-amount", width: "140px")
        .Column(x => x.PaymentStatus, caption: AdminResource.PaymentStatus, template: @<text>@PaymentBadge(item.PaymentStatus)</text>, className: "eg-col-secondary eg-col-payment", width: "130px")
        .Column(x => x.ShipmentCompanyName, caption: AdminResource.CargoCompany, template: @<text>@EmptyDash(item.ShipmentCompanyName)</text>, className: "eg-col-secondary", width: "140px")
        .Column(x => x.ShipmentTrackingNumber, caption: AdminResource.ShipmentTrackingNumber, template: @<text>@EmptyDash(item.ShipmentTrackingNumber)</text>, className: "eg-col-secondary", width: "150px")
        .Column(x => x.AdminOrderNote, caption: AdminResource.AdminOrderNote, template: @<text>@EmptyDash(item.AdminOrderNote)</text>, className: "eg-col-secondary", width: "180px")
        .Column(x => x.DeliveryDate, caption: "Teslimat Tarihi", template: @<text>@(item.DeliveryDate.ToShortDateString())</text>, className: "gridDateClass eg-col-secondary", width: "130px")
        .Column(x => x.CargoPrice, caption: AdminResource.CargoPrice, template: @<text>@(item.CargoPrice.ToString() + " " + item.Currency)</text>, className: "eg-col-secondary", width: "120px")
        .Column(x => x.CardType, caption: "Ödeme Yöntemi", template: @<text>@EmptyDash(item.CardType)</text>, className: "eg-col-secondary", width: "130px")
        .Column(caption: "İşlemler", template: @<text>@Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) { { "ItemId", item.Id }, { "ItemName", item.OrderNumber }, { "controllerName", controllerName }, { "ShowMedia", false }, { "ShowEdit", false }, { "ShowDelete", true }, { "DetailUrl", Url.Action("Details", controllerName, new { id = item.Id }) }, { "DetailText", AdminResource.GridDetailText } })</text>, className: "eg-sticky-right eg-col-actions", width: "132px");
}

@helper OrderStatusBadge(int orderStatusValue)
{
    var status = (EImeceOrderStatus)orderStatusValue;
    var text = status.ToDescription();
    <span class="eg-state-badge eg-order-status-badge" title="@text">@text</span>
}

@helper EmptyDash(string value)
{
    if (string.IsNullOrWhiteSpace(value))
    {
        <span class="eg-cell-empty">—</span>
    }
    else
    {
        @value
    }
}

@helper PaymentBadge(string status)
{
    var raw = (status ?? "").Trim();
    if (string.IsNullOrEmpty(raw))
    {
        <span class="eg-cell-empty">—</span>
    }
    else
    {
        var css = "eg-state-badge is-muted";
        if (string.Equals(raw, "SUCCESS", StringComparison.OrdinalIgnoreCase) || string.Equals(raw, "PAID", StringComparison.OrdinalIgnoreCase))
        {
            css = "eg-state-badge";
        }
        else if (string.Equals(raw, "FAILED", StringComparison.OrdinalIgnoreCase) || string.Equals(raw, "ERROR", StringComparison.OrdinalIgnoreCase))
        {
            css = "eg-state-badge is-danger";
        }
        <span class="@css" title="@raw">@raw</span>
    }
}

@Html.Griddly(settings)
