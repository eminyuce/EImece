@model List<EImece.Domain.Entities.Order>
@using Griddly.Mvc
@using EImece.Domain.Helpers
@using Resources

@{
    ViewBag.Title = AdminResource.Orders;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var controllerName = "Orders";
}

@Html.AdminBreadcrumb(AdminResource.Orders)
<h2 class="admin-page-title">@AdminResource.Orders</h2>
<hr class="adminLine" />

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
    {"controllerName", controllerName},
    {"orderingButton", false},
    {"StateTypes", "N/A"},
    {"IsNewRecordButtonEnabled", false},
    {"selectAll", true},
    {"deleteAll", true},
    {"SetStateOnOrOff", false},
    {"IsExcelButtonEnabled", false},
    {"IsSearchFormEnabled", true}
})

@Html.Partial("Grid/_GridChrome")

<div class="js-griddly-async" data-url="@Url.Action("IndexGrid", new { search = Request.QueryString["search"] })"></div>
