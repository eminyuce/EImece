@using EImece.Models;
@using GridMvc.Html;
@using GridMvc.Sorting;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using EImece.Domain.Entities;
@using Resources;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Models.Enums;

@model List<Order>

@{
    var orders = Model;

    ViewBag.Title = AdminResource.Orders;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = Request.QueryString["GridPageSize"].ToInt();
    pageSizeNumber = pageSizeNumber == 0 ? AppConfig.GridPageSizeNumber : pageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : pageSizeNumber * (gridPage - 1);
    var controllerName = "Orders";
    var gridName = "OrdersGrid";
    var contents = Model;
}

<h2>@AdminResource.Orders</h2>
<hr class="adminLine" />

<div class="panel panel-info">
    <div class="row">
        <span class="col-md-12">
            @Html.Partial("pSearchForm")
        </span>
    </div>
</div>

@Html.Partial("Grid/_GridChrome")

<div class="panel panel-primary eg-grid-shell">
    @Html.Grid(contents).Named(gridName).Columns(columns =>
{
    columns.Add()
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
        .RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

    columns.Add(c => c.OrderNumber)
        .Titled(AdminResource.OrderNumber)
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-sticky-left eg-sticky-left-2 eg-col-name")
        .RenderValueAs(d => Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) {
            { "Name", d.OrderNumber },
            { "DetailUrl", Url.Action("Details", controllerName, new { id = d.Id }) },
            { "StrongName", true }
        }));

    columns.Add(o => o.OrderStatus)
        .Titled(AdminResource.OrderStatus)
        .Sortable(true)
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-col-state")
        .RenderValueAs(o => OrderStatusBadge(o.OrderStatus));

    columns.Add(o => o.CreatedDate)
        .Titled(AdminResource.CreatedDate)
        .Sortable(true)
        .Css("gridDateClass")
        .RenderValueAs(o => o.CreatedDate != null ? o.CreatedDate.ToShortDateString() : "-")
        .SortInitialDirection(GridSortDirection.Descending);

    columns.Add(o => o.PaidPrice)
        .Titled("Ödenen Tutar")
        .Sortable(true)
        .RenderValueAs(o => o.PaidPrice + " " + o.Currency);

    columns.Add(o => o.PaymentStatus)
        .Titled(AdminResource.PaymentStatus)
        .Sortable(true);

    columns.Add(o => o.ShipmentCompanyName)
        .Titled(AdminResource.CargoCompany)
        .Sortable(true);

    columns.Add(o => o.ShipmentTrackingNumber)
        .Titled(AdminResource.ShipmentTrackingNumber)
        .Sortable(true);

    columns.Add(o => o.AdminOrderNote)
        .Titled(AdminResource.AdminOrderNote)
        .Sortable(true);

    columns.Add(o => o.DeliveryDate)
        .Titled("Teslimat Tarihi")
        .Sortable(true)
        .Css("gridDateClass")
        .RenderValueAs(o => o.DeliveryDate != null ? o.DeliveryDate.ToShortDateString() : "-");

    columns.Add(o => o.CargoPrice)
        .Titled(AdminResource.CargoPrice)
        .Sortable(true)
        .RenderValueAs(o => o.CargoPrice.ToString() + " " + o.Currency);

    columns.Add(o => o.CardType)
        .Titled("Ödeme Yöntemi")
        .Sortable(true);

}).WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
</div>

@helper OrderStatusBadge(int orderStatusValue)
{
    var status = (EImeceOrderStatus)orderStatusValue;
    <span class="eg-state-badge">@status.ToDescription()</span>
}
