@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Models.Enums
@using Griddly.Mvc
@using Resources

@{
    Layout = null;
    var gridName = "OrderGrid";
    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int rowNum = 0;
    int startIndex = 0;

    var controllerName = "Orders";

    var settings = new GriddlySettings<Order>()
    {
        ClassName = "eg-grid eg-grid-shell eg-orders-grid",
        TableClassName = "table table-hover table-striped eg-grid-table",
        PageSize = pageSizeNumber,
        AllowedFilterModes = FilterMode.None,
        RowClass = item => item.IsActive ? string.Empty : "GridIsActive",
        DefaultSort = new[] { new SortField() { Field = "CreatedDate", Direction = SortDirection.Descending } }
    };

    settings.HtmlAttributes["data-gridname"] = gridName;

    settings.BeforeTemplate = @<text>
        <output class="card-header grid-record-count" style="display:block" aria-live="polite">
            <div class="grid-record-count-inner">
                <span class="grid-record-count-badge griddly-recordtotal"></span>
                <span class="grid-record-count-label">@AdminResource.GridResultRecordNumber</span>
            </div>
            <div class="eg-grid-scroll-controls" title="Tabloyu Sağa/Sola Kaydır">
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-left" title="Sola Kaydır" aria-label="Sola Kaydır">
                    <i class="fa fa-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-right" title="Sağa Kaydır" aria-label="Sağa Kaydır">
                    <i class="fa fa-chevron-right"></i>
                </button>
            </div>
        </output>
    </text>;

    settings
        .Column(caption: "", template: @<text><span class="eg-row-index">@(startIndex + (++rowNum))</span></text>, className: "eg-sticky-left eg-sticky-left-1 eg-col-index", width: "44px")
        .Column(caption: "", template: @<text><input gridkey-id="@item.Id" class="gridCheckboxes" name="checkboxGrid" type="checkbox" /></text>, className: "gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check", width: "44px")
        .Column(x => x.OrderNumber, caption: AdminResource.OrderNumber, template: @<text>@Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) { { "Name", item.OrderNumber }, { "DetailUrl", Url.Action("Details", controllerName, new { id = item.Id }) }, { "StrongName", true } })</text>, className: "eg-col-name", width: "200px")
        .Column(x => x.OrderStatus, caption: AdminResource.OrderStatus, template: @<text>@OrderStatusBadge(item.OrderStatus)</text>, className: "eg-col-state eg-col-order-status", width: "180px")
        .Column(x => x.AdminOrderNote, caption: AdminResource.AdminOrderNote, template: @<text>@WriteAdminOrderNote(item)</text>, className: "eg-col-note", width: "320px")
        .Column(x => x.PaymentId, caption: AdminResource.PaymentIyzicoNumber, template: @<text>@EmptyDash(item.PaymentId)</text>, className: "smallGridColumn", width: "140px")
        .Column(x => x.Price, caption: AdminResource.Price, template: @<text><span class="text-primary">@item.PaidPriceDecimal.CurrencySign()</span></text>, className: "smallGridColumn", width: "120px")
        .Column(x => x.OrderComments, caption: AdminResource.OrderComments, template: @<text>@EmptyDash(item.OrderComments)</text>, className: "eg-col-comment", width: "220px")
        .Column(x => x.CreatedDate, caption: AdminResource.OrderDatePurchased, template: @<text>@(item.CreatedDate.ToString("dd MMMM ddd yyyy, HH:mm"))</text>, className: "gridDateClass", width: "160px")
        .Column(caption: "İşlemler", template: @<text>@Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) { { "ItemId", item.Id }, { "ItemName", item.OrderNumber }, { "controllerName", controllerName }, { "ShowMedia", false }, { "ShowEdit", false }, { "ShowDelete", false }, { "DetailUrl", Url.Action("Details", controllerName, new { id = item.Id }) }, { "DetailText", AdminResource.OrderDetails } })</text>, className: "eg-sticky-right eg-col-actions", width: "132px");
}

@helper OrderStatusBadge(int orderStatusValue)
{
    var status = (EImeceOrderStatus)orderStatusValue;
    var text = status.ToDescription();
    <span class="eg-state-badge eg-order-status-badge" title="@text">@text</span>
}

@helper EmptyDash(string value)
{
    if (string.IsNullOrWhiteSpace(value))
    {
        <span class="eg-cell-empty">—</span>
    }
    else
    {
        <span class="eg-cell-clip" title="@value">@value</span>
    }
}

@helper WriteAdminOrderNote(Order order)
{
    var os = (EImeceOrderStatus)order.OrderStatus;
    var orderStatusSelectList = EImece.Domain.Helpers.EnumHelper.ToSelectList(os);

    <div class="d-grid gap-1">
        <input type="button" data-save-admin-order-note="@order.Id" value="@AdminResource.SaveButtonText" class="btn btn-success w-100 btn-sm" />
        <span class="text-danger small" data-changed-order-result="@order.Id"></span>
        @Html.DropDownList("orderStatusSelectList",
            new SelectList(orderStatusSelectList, "Value", "Text", os.ToString()),
            new { @class = "form-select form-select-sm", @data_change_order_status = order.Id })
        <textarea class="form-control form-control-sm" placeholder="@Resource.AdminOrderNote" rows="2" data-textarea-admin-order-note="@order.Id">@order.AdminOrderNote</textarea>
        <input class="form-control form-control-sm" type="text" placeholder="@Resource.ShipmentCompanyName" data-order-shipment-company-name="@order.Id" value="@order.ShipmentCompanyName" />
        <input class="form-control form-control-sm" type="text" placeholder="@Resource.ShipmentTrackingNumber" data-order-shipment-tracking-number="@order.Id" value="@order.ShipmentTrackingNumber" />
    </div>
}

@Html.Griddly(settings)