@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Models.Enums
@using Griddly.Mvc
@using Resources

@{
    Layout = null;
    var gridName = "OrderGrid";
    int pageSizeNumber = ViewBag.GridPageSizeNumber != null ? (int)ViewBag.GridPageSizeNumber : AdminSettings.GridPageSizeNumber;
    int rowNum = 0;
    int startIndex = 0;

    var settings = new GriddlySettings<Order>()
    {
        ClassName = "eg-grid eg-grid-shell eg-orders-grid eg-customer-orders-grid",
        TableClassName = "table table-hover table-striped eg-grid-table",
        PageSize = pageSizeNumber,
        AllowedFilterModes = FilterMode.None,
        RowClass = item => item.IsActive ? string.Empty : "GridIsActive",
        DefaultSort = new[] { new SortField() { Field = "UpdatedDate", Direction = SortDirection.Descending } }
    };

    settings.HtmlAttributes["data-gridname"] = gridName;

    settings.BeforeTemplate = @<text>
        <output class="card-header grid-record-count" style="display:block" aria-live="polite">
            <div class="grid-record-count-inner">
                <span class="grid-record-count-badge griddly-recordtotal"></span>
                <span class="grid-record-count-label">@AdminResource.GridResultRecordNumber</span>
            </div>
            <div class="eg-grid-scroll-controls" title="Tabloyu Sağa/Sola Kaydır">
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-left" title="Sola Kaydır" aria-label="Sola Kaydır">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-right" title="Sağa Kaydır" aria-label="Sağa Kaydır">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </output>
    </text>;

    settings
        .Column(caption: "", template: @<text><span class="eg-row-index">@(startIndex + (++rowNum))</span></text>, className: "eg-sticky-left eg-sticky-left-1 eg-col-index", width: "44px")
        .Column(caption: "", template: @<text><input gridkey-id="@item.Id" class="gridCheckboxes" name="checkboxGrid" type="checkbox" /></text>, className: "gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check", width: "44px")
        .Column(x => x.OrderNumber, caption: AdminResource.Order, template: @<text>@OrderNumberCell(item)</text>, className: "eg-col-name", width: "168px")
        .Column(x => x.OrderStatus, caption: AdminResource.Status, template: @<text>@StatusCell(item)</text>, className: "eg-col-state eg-col-order-status", width: "158px")
        .Column(x => x.AdminOrderNote, caption: AdminResource.Note, template: @<text>@NoteCell(item)</text>, className: "eg-col-note", width: "140px")
        .Column(x => x.PaymentId, caption: AdminResource.Payment, template: @<text>@PaymentCell(item)</text>, className: "eg-col-payment", width: "128px")
        .Column(x => x.Price, caption: AdminResource.Amount, template: @<text><span class="eg-co-amount">@item.PaidPriceDecimal.CurrencySign()</span></text>, className: "eg-col-order-amount", width: "96px")
        .Column(x => x.ShipmentCompanyName, caption: AdminResource.Shipment, template: @<text>@CargoCell(item)</text>, className: "eg-col-cargo", width: "140px")
        .Column(x => x.UpdatedDate, caption: AdminResource.UpdatedDate, template: @<text>@(item.UpdatedDate.ToShortDateString())</text>, className: "gridDateClass", width: "120px")
        .Column(caption: AdminResource.Actions, template: @<text>@ActionsCell(item)</text>, className: "eg-sticky-right eg-col-actions", width: "118px");
}

@helper OrderNumberCell(Order order)
{
    var detailUrl = Url.Action("Details", "Orders", new { id = order.Id });
    <div class="eg-name-cell">
        <a class="eg-name-link" href="@detailUrl">
            <strong>@order.OrderNumber</strong>
        </a>
        <div class="eg-name-sub">@order.CreatedDate.ToString("dd MMM yyyy, HH:mm")</div>
        @if (!string.IsNullOrWhiteSpace(order.OrderComments))
        {
            <div class="eg-co-customer-comment text-muted" title="@order.OrderComments">@AdminResource.Customer: @order.OrderComments</div>
        }
    </div>
}

@helper StatusCell(Order order)
{
    var os = (EImeceOrderStatus)order.OrderStatus;
    string label;
    switch (os)
    {
        case EImeceOrderStatus.NewlyOrder: label = "Yeni sipariş"; break;
        case EImeceOrderStatus.PaymentPending: label = "Ödeme bekleniyor"; break;
        case EImeceOrderStatus.InProgress: label = "Hazırlanmakta"; break;
        case EImeceOrderStatus.Shipped: label = "Kargoda"; break;
        case EImeceOrderStatus.Delivered: label = "Teslim edildi"; break;
        case EImeceOrderStatus.Cancelled: label = "İptal"; break;
        case EImeceOrderStatus.Returned: label = "İade"; break;
        case EImeceOrderStatus.Refunded: label = "İade tamamlandı"; break;
        default: label = os.ToDescription(); break;
    }
    var statusItems = new[] {
        new SelectListItem { Value = "NewlyOrder", Text = "Yeni sipariş" },
        new SelectListItem { Value = "PaymentPending", Text = "Ödeme bekleniyor" },
        new SelectListItem { Value = "InProgress", Text = "Hazırlanmakta" },
        new SelectListItem { Value = "Shipped", Text = "Kargoda" },
        new SelectListItem { Value = "Delivered", Text = "Teslim edildi" },
        new SelectListItem { Value = "Cancelled", Text = "İptal" },
        new SelectListItem { Value = "Returned", Text = "İade" },
        new SelectListItem { Value = "Refunded", Text = "İade tamamlandı" }
    };
    <div class="eg-co-status-cell">
        <span class="eg-state-badge eg-order-status-badge eg-order-status-@os" data-eg-status-badge="@order.Id" title="@os.ToDescription()">@label</span>
        @Html.DropDownList("orderStatusSelectList",
            new SelectList(statusItems, "Value", "Text", os.ToString()),
            new { @class = "form-select form-select-sm eg-co-status-select", @data_change_order_status = order.Id, title = "Durumu değiştir" })
        <span class="visually-hidden" data-changed-order-result="@order.Id"></span>
    </div>
}

@helper NoteCell(Order order)
{
    var raw = order.AdminOrderNote ?? "";
    var preview = raw.Replace("\r", " ").Replace("\n", " ").Trim();
    var hasNote = !string.IsNullOrWhiteSpace(preview);
    <div class="eg-co-note-cell">
        @if (hasNote)
        {
            <span class="eg-co-note-preview" title="@raw">@preview</span>
        }
        else
        {
            <span class="eg-co-note-empty">Not yok</span>
        }
        <button type="button"
                class="btn btn-link btn-sm eg-co-note-edit"
                data-eg-open-order-note="1"
                data-order-id="@order.Id"
                data-order-number="@order.OrderNumber"
                data-note="@raw"
                data-company="@(order.ShipmentCompanyName ?? "")"
                data-tracking="@(order.ShipmentTrackingNumber ?? "")"
                title="@AdminResource.Administrator notunu düzenle">
            <i class="fa-solid fa-pencil" aria-hidden="true"></i>
            <span>Düzenle</span>
        </button>
    </div>
}

@helper PaymentCell(Order order)
{
    <div class="eg-co-pay-cell">
        @PaymentBadge(order.PaymentStatus)
        @if (!string.IsNullOrWhiteSpace(order.PaymentId))
        {
            <div class="eg-co-pay-id" title="@order.PaymentId">@order.PaymentId</div>
        }
    </div>
}

@helper CargoCell(Order order)
{
    var company = (order.ShipmentCompanyName ?? "").Trim();
    var tracking = (order.ShipmentTrackingNumber ?? "").Trim();
    var hasCargo = !string.IsNullOrWhiteSpace(company) || !string.IsNullOrWhiteSpace(tracking);
    <div class="eg-co-cargo-cell">
        @if (hasCargo)
        {
            <span class="eg-co-cargo-line" title="@(company + (string.IsNullOrWhiteSpace(tracking) ? "" : " · " + tracking))">
                @if (!string.IsNullOrWhiteSpace(company) && !string.IsNullOrWhiteSpace(tracking))
                {
                    @company <span class="eg-co-cargo-sep">·</span> @tracking
                }
                else if (!string.IsNullOrWhiteSpace(company))
                {
                    @company
                }
                else
                {
                    @tracking
                }
            </span>
        }
        else
        {
            <span class="eg-co-cargo-empty">Kargo yok</span>
        }
        <button type="button"
                class="btn btn-link btn-sm eg-co-cargo-edit"
                data-eg-open-order-note="1"
                data-eg-focus="cargo"
                data-order-id="@order.Id"
                data-order-number="@order.OrderNumber"
                data-note="@(order.AdminOrderNote ?? "")"
                data-company="@company"
                data-tracking="@tracking"
                title="Kargoyu düzenle">
            Kargo
        </button>
    </div>
}

@helper ActionsCell(Order order)
{
    var detailUrl = Url.Action("Details", "Orders", new { id = order.Id });
    <div class="eg-actions btn-group">
        <button type="button"
                class="btn btn-secondary btn-sm dropdown-toggle eg-actions-toggle"
                data-bs-toggle="dropdown"
                data-bs-display="static"
                aria-haspopup="true"
                aria-expanded="false">
            <i class="fa-solid fa-gear" aria-hidden="true"></i>
            <span>İşlemler</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end eg-actions-menu">
            <li>
                <a class="dropdown-item" href="@detailUrl">
                    <i class="fa-solid fa-circle-info"></i> Detay
                </a>
            </li>
            <li>
                <button type="button"
                        class="dropdown-item"
                        data-eg-open-order-note="1"
                        data-order-id="@order.Id"
                        data-order-number="@order.OrderNumber"
                        data-note="@(order.AdminOrderNote ?? "")"
                        data-company="@(order.ShipmentCompanyName ?? "")"
                        data-tracking="@(order.ShipmentTrackingNumber ?? "")">
                    <i class="fa-solid fa-pencil"></i> Not
                </button>
            </li>
        </ul>
    </div>
}

@helper PaymentBadge(string status)
{
    var raw = (status ?? "").Trim();
    if (string.IsNullOrEmpty(raw))
    {
        <span class="eg-cell-empty">—</span>
    }
    else
    {
        var css = "eg-state-badge is-muted";
        var text = raw;
        if (string.Equals(raw, "SUCCESS", StringComparison.OrdinalIgnoreCase) || string.Equals(raw, "PAID", StringComparison.OrdinalIgnoreCase))
        {
            css = "eg-state-badge eg-pay-badge-success";
            text = "Başarılı";
        }
        else if (string.Equals(raw, "FAILURE", StringComparison.OrdinalIgnoreCase) || string.Equals(raw, "FAILED", StringComparison.OrdinalIgnoreCase) || string.Equals(raw, "ERROR", StringComparison.OrdinalIgnoreCase))
        {
            css = "eg-state-badge is-danger eg-pay-badge-failed";
            text = "Başarısız";
        }
        else if (string.Equals(raw, "INIT_THREEDS", StringComparison.OrdinalIgnoreCase) || string.Equals(raw, "CALLBACK_THREEDS", StringComparison.OrdinalIgnoreCase))
        {
            css = "eg-state-badge eg-pay-badge-pending";
            text = "Beklemede";
        }
        else if (string.Equals(raw, "BKM_POS_SELECTED", StringComparison.OrdinalIgnoreCase))
        {
            css = "eg-state-badge is-muted";
            text = "BKM POS seçildi";
        }
        else if (string.Equals(raw, "CALLBACK_PECCO", StringComparison.OrdinalIgnoreCase))
        {
            css = "eg-state-badge is-muted";
            text = "Pecco dönüşü";
        }
        <span class="@css" title="@text">@text</span>
    }
}


@Html.Griddly(settings)
