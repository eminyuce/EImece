@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Models.Enums
@using Griddly.Mvc
@using Resources

@{
    Layout = null;
    var gridName = "OrderGrid";
    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int rowNum = 0;
    int startIndex = 0;

    var controllerName = "Home";

    var settings = new GriddlySettings<Order>()
    {
        ClassName = "eg-grid eg-grid-shell",
        TableClassName = "table table-hover table-striped eg-grid-table",
        PageSize = pageSizeNumber,
        AllowedFilterModes = FilterMode.None,
        RowClass = item => item.IsActive ? string.Empty : "GridIsActive",
        DefaultSort = new[] { new SortField() { Field = "CreatedDate", Direction = SortDirection.Descending } }
    };

    settings.HtmlAttributes["data-gridname"] = gridName;

    settings.BeforeTemplate = @<text>
        <output class="card-header grid-record-count" style="display:block" aria-live="polite">
            <div class="grid-record-count-inner">
                <span class="grid-record-count-badge griddly-recordtotal"></span>
                <span class="grid-record-count-label">@AdminResource.GridResultRecordNumber</span>
            </div>
            <div class="eg-grid-scroll-controls" title="Tabloyu Sağa/Sola Kaydır">
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-left" title="Sola Kaydır" aria-label="Sola Kaydır">
                    <i class="fa fa-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-right" title="Sağa Kaydır" aria-label="Sağa Kaydır">
                    <i class="fa fa-chevron-right"></i>
                </button>
            </div>
        </output>
    </text>;

    settings
        .Column(caption: "", template: @<text><span class="eg-row-index">@(startIndex + (++rowNum))</span></text>, className: "eg-sticky-left eg-sticky-left-1 eg-col-index", width: "44px")
        .Column(caption: "", template: @<text><input gridkey-id="@item.Id" class="gridCheckboxes" name="checkboxGrid" type="checkbox" /></text>, className: "gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check", width: "44px")
        .Column(x => x.OrderNumber, caption: AdminResource.OrderNumber, template: @<text>@CustomerOrderDetail(item, controllerName)</text>, className: "eg-col-name", width: "200px")
        .Column(x => x.AdminOrderNote, caption: AdminResource.AdminOrderNote, template: @<text>@WriteAdminOrderNote(item)</text>, className: "eg-col-note", width: "320px")
        .Column(x => x.PaymentId, caption: AdminResource.PaymentIyzicoNumber, template: @<text><b>@item.PaymentId</b></text>, className: "smallGridColumn", width: "140px")
        .Column(x => x.Price, caption: AdminResource.Price, template: @<text><span class="text-primary">@item.PaidPriceDecimal.CurrencySign()</span></text>, className: "smallGridColumn", width: "120px")
        .Column(x => x.OrderComments, caption: AdminResource.OrderComments, template: @<text><textarea readonly style="height: 80px; background-color: transparent; width: 220px; margin: 0; resize: none;">@item.OrderComments</textarea></text>, className: "eg-col-comment", width: "240px")
        .Column(x => x.CreatedDate, caption: AdminResource.OrderDatePurchased, template: @<text>@(item.CreatedDate != null ? item.CreatedDate.ToString("dd MMMM ddd yyyy, HH:mm") : "")</text>, className: "gridDateClass", width: "160px");
}

@helper CustomerOrderDetail(Order o, String controllerName)
{
    <b>@o.OrderNumber </b>
    <br />
    <a data-bs-toggle="modal" class="btn btn-outline @createOrderStatusBtn(o) btn-sm" data-order-Id="@o.Id" style="font-size:0.8em;" data-bs-target="@String.Format("#myModal_{0}",o.Id)">
        @AdminResource.OrderDetails
    </a>

    <div id="@String.Format("myModal_{0}",o.Id)" class="modal fade" role="dialog">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal">&times;</button>
                    <h4 class="order-details__title"> @AdminResource.OrderNumber - @o.OrderNumber - @createOrderStatus(o)</h4>
                </div>
                <div class="modal-body">
                    @Html.Partial("pOrderDetail", o)
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger w-100" data-bs-dismiss="modal">@AdminResource.Close</button>
                </div>
            </div>
        </div>
    </div>
}

@helper createOrderStatus(Order o)
{
    var os = (EImeceOrderStatus)o.OrderStatus;
    var orderStatusText = EImece.Domain.Helpers.EnumHelper.GetEnumDescription(os);
    switch (os)
    {
        case EImeceOrderStatus.NewlyOrder:
            <span class="text-primary">@orderStatusText</span>
            break;
        case EImeceOrderStatus.PaymentPending:
            <span class="text-secondary">@orderStatusText</span>
            break;
        case EImeceOrderStatus.InProgress:
            <span class="text-info">@orderStatusText</span>
            break;
        case EImeceOrderStatus.Shipped:
            <span class="text-dark">@orderStatusText</span>
            break;
        case EImeceOrderStatus.Delivered:
            <span class="text-success">@orderStatusText</span>
            break;
        case EImeceOrderStatus.Cancelled:
            <span class="text-danger">@orderStatusText</span>
            break;
        case EImeceOrderStatus.Returned:
            <span class="text-warning">@orderStatusText</span>
            break;
        case EImeceOrderStatus.Refunded:
            <span class="text-muted">@orderStatusText</span>
            break;
        default:
            <span class="text-secondary">@orderStatusText (Bilinmeyen Durum)</span>
            break;
    }
}

@functions{
    public string createOrderStatusBtn(Order o)
    {
        var os = (EImeceOrderStatus)o.OrderStatus;
        switch (os)
        {
            case EImeceOrderStatus.NewlyOrder:
                return "btn-primary";
            case EImeceOrderStatus.PaymentPending:
                return "btn-secondary";
            case EImeceOrderStatus.InProgress:
                return "btn-info";
            case EImeceOrderStatus.Shipped:
                return "btn-primary";
            case EImeceOrderStatus.Delivered:
                return "btn-success";
            case EImeceOrderStatus.Cancelled:
                return "btn-danger";
            case EImeceOrderStatus.Returned:
                return "btn-warning";
            case EImeceOrderStatus.Refunded:
                return "btn-danger";
            default:
                return "btn-secondary";
        }
    }
}

@helper WriteAdminOrderNote(Order order)
{
    var os = (EImeceOrderStatus)order.OrderStatus;
    var orderStatusSelectList = EImece.Domain.Helpers.EnumHelper.ToSelectList(os);

    <div class="row">
        <div class="col-md-12">
            <input type="button" data-save-admin-order-note="@order.Id" value="@AdminResource.SaveButtonText" class="btn btn-success w-100 btn-sm" style="margin-bottom: 4px;" />
        </div>
        <div class="col-md-12">
            <span class="text-danger" data-changed-order-result="@order.Id"></span>
        </div>
        <div class="col-md-12" style="margin-bottom: 4px;">
            @Html.DropDownList("orderStatusSelectList",
                new SelectList(orderStatusSelectList, "Value", "Text", os.ToString()),
                new { @class = "form-control form-control-sm", @data_change_order_status = order.Id })
        </div>
        <div class="col-md-12" style="margin-bottom: 4px;">
            <textarea class="form-control form-control-sm" placeholder="@Resource.AdminOrderNote" rows="2" data-textarea-admin-order-note="@order.Id">@order.AdminOrderNote</textarea>
        </div>
        <div class="col-md-12" style="margin-bottom: 4px;">
            <input class="form-control form-control-sm" type="text" placeholder="@Resource.ShipmentCompanyName" data-order-shipment-company-name="@order.Id" value="@order.ShipmentCompanyName" />
        </div>
        <div class="col-md-12">
            <input class="form-control form-control-sm" type="text" placeholder="@Resource.ShipmentTrackingNumber" data-order-shipment-tracking-number="@order.Id" value="@order.ShipmentTrackingNumber" />
        </div>
    </div>
}

@Html.Griddly(settings)
