@model List<Order>
@using EImece.Domain.Entities
@using Griddly.Mvc
@using Resources

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    Customer customer = ViewBag.Customer;
}

<h2>@customer.FullName @AdminResource.OrdersBelongCustomer</h2>
<hr class="adminLine" />
@Html.DisplayFor(r => customer, "CustomerOrderDetail")
<hr class="adminLine" />
@Html.Partial("pAdminSearchForm", new ViewDataDictionary(ViewData){
    {"IdValueExists",true}
})
<br />
<br />

@Html.Griddly("CustomerOrdersGrid", new { id = customer.UserId, search = Request.QueryString["search"] })