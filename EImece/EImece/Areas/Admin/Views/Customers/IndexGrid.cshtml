@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using EImece.Domain.Models.Enums
@using Griddly.Mvc
@using Resources

@{
    Layout = null;
    var gridName = "CustomersGrid";
    int pageSizeNumber = ViewBag.GridPageSizeNumber != null ? (int)ViewBag.GridPageSizeNumber : AdminSettings.GridPageSizeNumber;
    int rowNum = 0;
    int startIndex = 0;

    var controllerName = "customers";

    var settings = new GriddlySettings<Customer>()
    {
        ClassName = "eg-grid eg-grid-shell",
        TableClassName = "table table-hover table-striped eg-grid-table",
        PageSize = pageSizeNumber,
        AllowedFilterModes = FilterMode.None,
        DefaultSort = new[] { new SortField() { Field = "UpdatedDate", Direction = SortDirection.Descending } }
    };

    settings.HtmlAttributes["data-gridname"] = gridName;

    settings.BeforeTemplate = @<text>
        <output class="card-header grid-record-count" style="display:block" aria-live="polite">
            <div class="grid-record-count-inner">
                <span class="grid-record-count-badge griddly-recordtotal"></span>
                <span class="grid-record-count-label">@AdminResource.GridResultRecordNumber</span>
            </div>
            <div class="eg-grid-scroll-controls" title="Tabloyu Sağa/Sola Kaydır">
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-left" title="Sola Kaydır" aria-label="Sola Kaydır">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm eg-scroll-nav-btn eg-scroll-nav-right" title="Sağa Kaydır" aria-label="Sağa Kaydır">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </output>
    </text>;

    settings
        .Column(caption: "", template: @<text><span class="eg-row-index">@(startIndex + (++rowNum))</span></text>, className: "eg-sticky-left eg-sticky-left-1 eg-col-index", width: "44px")
        .Column(caption: "", template: @<text><input gridkey-id="@item.UserId" class="gridCheckboxes" name="checkboxGrid" type="checkbox" /></text>, className: "gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check", width: "44px")
        .Column(x => x.Name, caption: AdminResource.Name, template: @<text>@Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) { { "Name", string.Format("{0} {1}", item.Name, item.Surname) }, { "ItemId", item.UserId.ToString() } })</text>, className: "eg-col-name", width: "320px")
        .Column(x => x.Orders.Count, caption: AdminResource.TotalOrderNumber, template: @<text>@(item.Orders != null ? item.Orders.Count.ToString() : "0")</text>, className: "smallGridColumn", width: "120px")
        .Column(x => x.GsmNumber, caption: AdminResource.PhoneNumber, template: @<text>@item.GsmNumber</text>, className: "eg-col-phone", width: "140px")
        .Column(x => x.Email, caption: AdminResource.Email, template: @<text>@item.Email</text>, className: "eg-col-email", width: "200px")
        .Column(x => x.Gender, caption: AdminResource.Gender, template: @<text>@GetGenderText(item.Gender)</text>, className: "smallGridColumn", width: "100px")
        .Column(x => x.RegistrationAddress, caption: AdminResource.CustomerRegistrationAddress, template: @<text><span class="eg-cell-clip" title="@item.RegistrationAddress">@(string.IsNullOrWhiteSpace(item.RegistrationAddress) ? "—" : item.RegistrationAddress)</span></text>, className: "eg-col-address", width: "280px")
        .Column(x => x.CreatedDate, caption: AdminResource.CustomerRegistrationDate, template: @<text>@(item.CreatedDate.ToShortDateString())</text>, className: "gridDateClass", width: "130px")
        .Column(x => x.UpdatedDate, caption: AdminResource.UpdatedDate, template: @<text>@(item.UpdatedDate.ToShortDateString())</text>, className: "gridDateClass", width: "130px")
        .Column(caption: AdminResource.Actions, template: @<text>@Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) { { "ItemId", item.UserId }, { "ItemName", string.Format("{0} {1}", item.Name, item.Surname) }, { "controllerName", controllerName }, { "ShowMedia", false }, { "ShowEdit", false }, { "ShowDelete", true }, { "OrdersUrl", Url.Action("CustomerOrders", controllerName, new { id = item.UserId }) }, { "OrdersText", AdminResource.CustomerComingOrders } })</text>, className: "eg-sticky-right eg-col-actions", width: "132px");
}

@helper GetGenderText(int gender)
{
    var genderEnum = (GenderType)gender;
    if (GenderType.Man == genderEnum)
    {
        <span>@AdminResource.ManGender</span>
    }
    else if (GenderType.Woman == genderEnum)
    {
        <span>@AdminResource.WomanGender</span>
    }
    else
    {
        <span class="eg-cell-empty">—</span>
    }
}

@Html.Griddly(settings)
