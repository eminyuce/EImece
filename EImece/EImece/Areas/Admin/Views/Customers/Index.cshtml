@using EImece.Models;
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using EImece.Domain.Entities;
@using Resources;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Models.Enums;
@model List<Customer>
@{
    var users = Model;

    ViewBag.Title = "customers";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = Request.QueryString["GridPageSize"].ToInt();
    pageSizeNumber = pageSizeNumber == 0 ? AppConfig.GridPageSizeNumber : pageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : pageSizeNumber * (gridPage - 1);
    var controllerName = "customers";
    var gridName = "CustomersGrid";
    var contents = Model;
}
<h2>@AdminResource.Customers</h2>
<hr class="adminLine" />

<div class="panel panel-info">
    <div class="row">
        <span class="col-md-12">
            @Html.Partial("pSearchForm")
        </span>
    </div>
</div>

@Html.Partial("Grid/_GridChrome")

<div class="panel panel-primary eg-grid-shell">
    @Html.Grid(contents).Named(gridName).Columns(columns =>
{
    columns.Add()
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
        .RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

    columns.Add(o => o.Name)
        .Encoded(false)
        .Titled(AdminResource.Name)
        .Css("eg-col-name")
        .RenderValueAs(o => Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) {
            { "Name", String.Format("{0} {1}", o.Name, o.Surname) },
            { "ItemId", o.UserId.ToString() }
        }));

    columns.Add(c => c.Orders.Count)
        .Titled(AdminResource.TotalOrderNumber)
        .Filterable(true);

    columns.Add(c => c.GsmNumber).Titled(AdminResource.PhoneNumber);
    columns.Add(c => c.Email).Titled(AdminResource.Email);

    columns.Add(c => c.Gender)
        .Encoded(false)
        .Sanitized(false)
        .RenderValueAs(c => GetGenderText(c.Gender))
        .Titled(AdminResource.Gender)
        .Filterable(true);

    columns.Add(o => o.RegistrationAddress)
        .Titled(AdminResource.CustomerRegistrationAddress)
        .Encoded(false)
        .Sanitized(false)
        .RenderValueAs(o => String.Format("<textarea readonly style='height: 40px; background-color: transparent; width: 300px; margin: 0px;'>{0}</textarea>", o.RegistrationAddress));

    columns.Add(o => o.CreatedDate)
        .Titled(AdminResource.CustomerRegistrationDate)
        .Sortable(true)
        .Css("gridDateClass")
        .RenderValueAs(o => o.CreatedDate != null ? String.Format("{0}", o.CreatedDate.ToShortDateString()) : null)
        .SortInitialDirection(GridSortDirection.Descending);

    columns.Add()
        .Titled("İşlemler")
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-sticky-right eg-col-actions")
        .RenderValueAs(d => Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
            { "ItemId", d.UserId },
            { "ItemName", String.Format("{0} {1}", d.Name, d.Surname) },
            { "controllerName", controllerName },
            { "ShowMedia", false },
            { "ShowEdit", false },
            { "ShowDelete", true },
            { "OrdersUrl", Url.Action("CustomerOrders", controllerName, new { id = d.UserId }) },
            { "OrdersText", AdminResource.CustomerComingOrders }
        }));

}).WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
</div>

@helper GetGenderText(int gender)
{
    var genderEnum = (GenderType)gender;
    if (GenderType.Man == genderEnum)
    {
        <b>@AdminResource.ManGender</b>
    }
    else if (GenderType.Woman == genderEnum)
    {
        <b>@AdminResource.WomanGender</b>
    }
}
