@using Resources
@model List<String>
@{
    ViewBag.Title = "Veri Ice Aktar";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var pathName = (String)ViewBag.PathName;
}

<h2 class="admin-page-title">Veri İçe Aktar</h2>
<hr class="adminLine" />

<div class="card admin-edit-form admin-import-page">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Excel dosyaları</strong>
        <a class="btn btn-primary btn-sm" href="@Url.Action("ExcelUpload")">
            <i class="fa-solid fa-upload"></i> Excel Yükle
        </a>
    </div>
    <div class="card-body">
        @if (Model == null || !Model.Any())
        {
            <p class="text-muted mb-0">Henüz yüklenmiş bir Excel dosyası yok.</p>
        }
        else
        {
            <div class="list-group">
            @foreach (var m in Model)
            {
                var name = m.Replace(pathName, "");
                <a class="list-group-item list-group-item-action" href="@Url.Action("DisplayTable", new { id = name })">@name</a>
            }
            </div>
        }
    </div>
</div>
