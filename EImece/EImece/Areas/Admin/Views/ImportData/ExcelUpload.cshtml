@using Resources
@{
    ViewBag.Title = "Excel Yukle";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2 class="admin-page-title">Excel Yükle</h2>
<hr class="adminLine" />

<div class="card admin-edit-form">
    <div class="card-body">
        @using (Html.BeginForm("ExcelUploadImport", "ImportData", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label" for="excelFile">Excel dosyası</label>
                <input id="excelFile" type="file" name="excelFile" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Yükle</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Listeye Dön</a>
        }
    </div>
</div>
