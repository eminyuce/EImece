@model System.Data.DataTable
@using System.Data;
@{
    ViewBag.Title = "Excel Tablosu";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var pathName=(String) ViewBag.PathName;
}

@{
    List<SelectListItem> listItems = new List<SelectListItem>();
    listItems.Add(new SelectListItem
    {
        Text = "ProductCategories",
        Value = "ProductCategories"
    });
    listItems.Add(new SelectListItem
    {
        Text = "Products",
        Value = "Products",
        Selected = true
    });
    listItems.Add(new SelectListItem
    {
        Text = "Menus",
        Value = "Menus"
    });
}
@using (Html.BeginForm("DisplayExcel","ImportData"))
{
@Html.AntiForgeryToken()
<input type="hidden" name="pathName" value="@pathName" />
@Html.DropDownList("selectedTable", listItems, "-- Tablolar --", new { @class = "form-select mb-3" })

<div class="mt-3">
    <input type="submit" value="Kaydet" class="btn btn-primary" />
</div>
}

@Html.DisplayFor(r => Model)