@model EImece.Domain.Entities.ShoppingCart
@using EImece.Domain.Helpers
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Models.FrontModels
@using Newtonsoft.Json
@using Newtonsoft.Json.Linq
@using Resources
@using System.Linq

@{
    ViewBag.Title = "Sepet Detayı";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    ShoppingCartSession session = null;
    JToken rawToken = null;
    var itemCount = 0;
    var quantity = 0;
    decimal? total = null;
    var customerName = "";
    var customerEmail = "";
    var prettyJson = Model.ShoppingCartJson.ToStr();

    try
    {
        if (!string.IsNullOrWhiteSpace(Model.ShoppingCartJson))
        {
            rawToken = JToken.Parse(Model.ShoppingCartJson);
            prettyJson = rawToken.ToString(Formatting.Indented);

            var sessionItems = rawToken["ShoppingCartItems"] as JArray;
            var seedItems = rawToken["Items"] as JArray;
            if (sessionItems != null && sessionItems.Count > 0)
            {
                itemCount = sessionItems.Count;
                quantity = sessionItems.Sum(i => i.Value<int?>("Quantity") ?? 0);
                session = rawToken.ToObject<ShoppingCartSession>();
                if (session != null)
                {
                    total = session.TotalPrice;
                    if (session.Customer != null)
                    {
                        customerName = string.Format("{0} {1}", session.Customer.Name.ToStr(), session.Customer.Surname.ToStr()).Trim();
                        customerEmail = session.Customer.Email.ToStr();
                    }
                }
            }
            else if (seedItems != null && seedItems.Count > 0)
            {
                itemCount = seedItems.Count;
                quantity = seedItems.Sum(i => i.Value<int?>("Quantity") ?? 0);
            }
            else
            {
                var emailToken = rawToken.SelectToken("Customer.Email");
                if (emailToken != null)
                {
                    customerEmail = emailToken.ToString();
                }
            }
        }
    }
    catch
    {
        // keep raw json text
    }
}

<style>
    .eg-cart-detail {
        max-width: 980px;
    }
    .eg-cart-detail-card {
        background: #fff;
        border: 1px solid #d9e2ec;
        border-radius: 10px;
        box-shadow: 0 1px 2px rgba(16, 42, 67, 0.04);
        margin-bottom: 16px;
        overflow: hidden;
    }
    .eg-cart-detail-card .card-header,
    .eg-cart-detail-head {
        background: linear-gradient(180deg, #f7fbff 0%, #eef5fc 100%);
        border-bottom: 1px solid #d9e2ec;
        padding: 12px 16px;
        font-weight: 700;
        color: #243b53;
    }
    .eg-cart-detail-body {
        padding: 16px;
    }
    .eg-cart-meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 12px 16px;
        margin: 0;
    }
    .eg-cart-meta-grid > dl {
        margin: 0;
    }
    .eg-cart-meta-grid dt {
        margin: 0 0 2px;
        color: #829ab1;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .eg-cart-meta-grid dd {
        margin: 0 0 8px;
        color: #102a43;
        font-weight: 600;
        word-break: break-all;
    }
    .eg-cart-json {
        width: 100%;
        min-height: 280px;
        font-family: Consolas, Menlo, Monaco, monospace;
        font-size: 12px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #f8fafc;
        padding: 12px;
    }
    .eg-cart-detail-actions {
        margin-top: 8px;
    }
</style>

<div class="eg-cart-detail">
    <h2 class="admin-page-title">Sepet Detayı</h2>
    <hr class="adminLine" />

    <div class="eg-cart-detail-card">
        <div class="eg-cart-detail-head">Özet</div>
        <div class="eg-cart-detail-body">
            <div class="eg-cart-meta-grid">
                <dl>
                    <dt>@Html.DisplayNameFor(model => model.Id)</dt>
                    <dd>@Model.Id</dd>
                </dl>
                <dl>
                    <dt>@Html.DisplayNameFor(model => model.Name)</dt>
                    <dd>@Model.Name</dd>
                </dl>
                <dl>
                    <dt>Sipariş GUID</dt>
                    <dd><code class="eg-mono-chip" title="@Model.OrderGuid">@Model.OrderGuid</code></dd>
                </dl>
                <dl>
                    <dt>Kullanıcı</dt>
                    <dd><code class="eg-mono-chip" title="@Model.UserId">@Model.UserId</code></dd>
                </dl>
                <dl>
                    <dt>@AdminResource.Customer</dt>
                    <dd>@(string.IsNullOrWhiteSpace(customerName) ? "—" : customerName)</dd>
                </dl>
                <dl>
                    <dt>E-posta</dt>
                    <dd>@(string.IsNullOrWhiteSpace(customerEmail) ? "—" : customerEmail)</dd>
                </dl>
                <dl>
                    <dt>Ürün kalemi</dt>
                    <dd>
                        @if (itemCount > 0)
                        {
                            <text>@itemCount kalem@(quantity > 0 && quantity != itemCount ? string.Format(" ({0} adet)", quantity) : "")</text>
                        }
                        else
                        {
                            <span class="eg-muted">—</span>
                        }
                    </dd>
                </dl>
                <dl>
                    <dt>Tutar</dt>
                    <dd>
                        @if (total.HasValue)
                        {
                            @total.Value.CurrencySign()
                        }
                        else
                        {
                            <span class="eg-muted">—</span>
                        }
                    </dd>
                </dl>
                <dl>
                    <dt>Durum</dt>
                    <dd>
                        @if (Model.IsActive)
                        {
                            <span class="eg-status-pill is-on">Aktif</span>
                        }
                        else
                        {
                            <span class="eg-status-pill is-off">Pasif</span>
                        }
                    </dd>
                </dl>
                <dl>
                    <dt>@Html.DisplayNameFor(model => model.CreatedDate)</dt>
                    <dd>@Model.CreatedDate.ToString("g")</dd>
                </dl>
                <dl>
                    <dt>@Html.DisplayNameFor(model => model.UpdatedDate)</dt>
                    <dd>@Model.UpdatedDate.ToString("g")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="eg-cart-detail-card">
        <div class="eg-cart-detail-head">Sepet JSON</div>
        <div class="eg-cart-detail-body">
            <textarea id="cart-json-preview" class="eg-cart-json" readonly rows="18" aria-label="Sepet JSON">@prettyJson</textarea>
        </div>
    </div>

    <div class="eg-cart-detail-actions">
        @Html.ActionLink(AdminResource.BackToList, "Index", null, new { @class = "btn btn-secondary" })
    </div>
</div>
