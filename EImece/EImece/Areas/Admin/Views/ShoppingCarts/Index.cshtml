@model List<ShoppingCart>
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain;
@using EImece.Domain.Entities;
@using EImece.Domain.Helpers;
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Models.FrontModels;
@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@using Resources;
@using System.Linq;

@{
    ViewBag.Title = AdminResource.ShoppingCarts;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : AppConfig.GridPageSizeNumber * (gridPage - 1);

    var controllerName = "shoppingcarts";
    var gridName = "ShoppingCartGrid";
    var contents = Model;
    var showTotals = contents != null && contents.Any(c => SummarizeCart(c).Total.HasValue);
}

<h2 class="admin-page-title">@AdminResource.ShoppingCarts</h2>
<hr class="adminLine" />

<div class="eg-shoppingcarts-ops">
@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
    {"controllerName", controllerName},
    {"orderingButton", false},
    {"StateTypes", "N/A"},
    {"IsNewRecordButtonEnabled", false},
    {"selectAll", true},
    {"deleteAll", true},
    {"SetStateOnOrOff", false},
    {"IsExcelButtonEnabled", true},
    {"IsSearchFormEnabled", true}
})
</div>

@Html.Partial("Grid/_GridChrome")

<div class="panel panel-primary eg-grid-shell eg-shoppingcarts-grid">
    @Html.Grid(contents).Named(gridName).Columns(columns =>
{
    columns.Add()
        .Titled("#")
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
        .RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

    columns.Add(o => o.Id, true);

    columns.Add()
        .Titled("")
        .Encoded(false)
        .Sanitized(false)
        .Css("gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check")
        .RenderValueAs(d => Html.Partial("pGridCheckbox", new ViewDataDictionary(ViewData){
            {"ItemId", d.Id}
        }));

    columns.Add(o => o.Name)
        .Titled(AdminResource.Name)
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-col-name")
        .RenderValueAs(d => CartNameCell(d));

    columns.Add(o => o.OrderGuid)
        .Titled("Sipariş GUID")
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-col-guid")
        .RenderValueAs(d => MonoChip(d.OrderGuid));

    columns.Add(o => o.UserId)
        .Titled("Kullanıcı")
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-col-userid")
        .RenderValueAs(d => MonoChip(d.UserId, 18));

    columns.Add()
        .Titled("Ürün")
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-col-cart-items")
        .RenderValueAs(d => CartItemsCell(d));

    if (showTotals)
    {
        columns.Add()
            .Titled("Tutar")
            .Encoded(false)
            .Sanitized(false)
            .Css("eg-col-cart-total")
            .RenderValueAs(d => CartTotalCell(d));
    }

    columns.Add(o => o.IsActive)
        .Titled("Durum")
        .Sortable(true)
        .Css("eg-col-status")
        .Encoded(false)
        .Sanitized(false)
        .RenderValueAs(o => StatusPill(o.IsActive));

    columns.Add(o => o.UpdatedDate)
        .Titled(AdminResource.UpdatedDate)
        .Sortable(true)
        .Css("gridDateClass eg-col-datetime")
        .SortInitialDirection(GridSortDirection.Descending)
        .Encoded(false)
        .Sanitized(false)
        .RenderValueAs(o => DateTimeCell(o.UpdatedDate));

    columns.Add()
        .Titled("İşlemler")
        .Encoded(false)
        .Sanitized(false)
        .Css("eg-sticky-right eg-col-actions")
        .RenderValueAs(d => Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
            { "ItemId", d.Id },
            { "ItemName", d.Name },
            { "controllerName", controllerName },
            { "ShowMedia", false },
            { "ShowEdit", false },
            { "ShowDelete", true },
            { "DetailUrl", Url.Action("Detail", controllerName, new { id = d.Id }) },
            { "DetailText", AdminResource.GridDetailText }
        }));

}).WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
</div>

@section scripts {
<script>
(function ($) {
    $(function () {
        var $grid = $('.eg-shoppingcarts-grid .eg-grid');
        if (!$grid.length) {
            return;
        }
        $grid.addClass('is-compact');
        var $toggle = $('.eg-grid-chrome [data-eg-density-toggle]');
        $toggle.find('[data-eg-density="compact"]').addClass('is-active').attr('aria-pressed', 'true');
        $toggle.find('[data-eg-density="comfortable"]').removeClass('is-active').attr('aria-pressed', 'false');
    });
})(window.jQuery);
</script>
}

@helper MonoChip(string value, int maxLen = 13)
{
    if (string.IsNullOrWhiteSpace(value))
    {
        <span class="eg-muted">—</span>
    }
    else
    {
        var display = value.Length > maxLen ? value.Substring(0, Math.Max(8, maxLen - 1)) + "…" : value;
        <code class="eg-mono-chip" title="@value">@display</code>
    }
}

@helper StatusPill(bool isActive)
{
    if (isActive)
    {
        <span class="eg-status-pill is-on">Aktif</span>
    }
    else
    {
        <span class="eg-status-pill is-off">Pasif</span>
    }
}

@helper DateTimeCell(DateTime value)
{
    <div class="eg-datetime-cell">
        <span class="eg-datetime-date">@value.ToString("dd.MM.yyyy")</span>
        <span class="eg-datetime-time">@value.ToString("HH:mm")</span>
    </div>
}

@helper CartNameCell(ShoppingCart cart)
{
    var summary = SummarizeCart(cart);
    <div class="eg-name-cell">
        <div class="eg-name-main">
            @(string.IsNullOrWhiteSpace(cart.Name) ? "—" : cart.Name)
            <span class="eg-name-id">#@cart.Id</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(summary.Email))
        {
            <div class="eg-name-meta" title="@summary.Email">@summary.Email</div>
        }
    </div>
}

@helper CartItemsCell(ShoppingCart cart)
{
    var summary = SummarizeCart(cart);
    if (summary.ItemCount <= 0)
    {
        <span class="eg-muted">—</span>
    }
    else
    {
        <div class="eg-cart-items-cell">
            <span class="eg-count-badge">@summary.ItemCount</span>
            <span class="eg-cart-items-label">kalem</span>
            @if (summary.Quantity > 0 && summary.Quantity != summary.ItemCount)
            {
                <span class="eg-cart-items-qty">(@summary.Quantity adet)</span>
            }
        </div>
    }
}

@helper CartTotalCell(ShoppingCart cart)
{
    var summary = SummarizeCart(cart);
    if (!summary.Total.HasValue)
    {
        <span class="eg-muted" title="Tutar bu sepet JSON biçiminde hesaplanamadı">—</span>
    }
    else
    {
        <div class="eg-price-cell">
            <div class="eg-price-current">@summary.Total.Value.CurrencySign()</div>
        </div>
    }
}

@functions {
    private class CartSummary
    {
        public int ItemCount { get; set; }
        public int Quantity { get; set; }
        public decimal? Total { get; set; }
        public string Email { get; set; }
    }

    private static CartSummary SummarizeCart(ShoppingCart cart)
    {
        var summary = new CartSummary();
        if (cart == null || string.IsNullOrWhiteSpace(cart.ShoppingCartJson))
        {
            return summary;
        }

        try
        {
            var token = JToken.Parse(cart.ShoppingCartJson);

            // Full session carts
            var items = token["ShoppingCartItems"] as JArray;
            if (items != null && items.Count > 0)
            {
                summary.ItemCount = items.Count;
                summary.Quantity = items.Sum(i => i.Value<int?>("Quantity") ?? 0);
                try
                {
                    var session = token.ToObject<ShoppingCartSession>();
                    if (session != null)
                    {
                        summary.Total = session.TotalPrice;
                        if (session.Customer != null)
                        {
                            summary.Email = session.Customer.Email.ToStr();
                        }
                    }
                }
                catch
                {
                    // keep counts only
                }
                return summary;
            }

            // Seed / lightweight carts: {"Items":[{"ProductId":1,"Quantity":2}]}
            var seedItems = token["Items"] as JArray;
            if (seedItems != null && seedItems.Count > 0)
            {
                summary.ItemCount = seedItems.Count;
                summary.Quantity = seedItems.Sum(i => i.Value<int?>("Quantity") ?? 0);
                summary.Total = null; // no unit prices in this payload
                return summary;
            }

            // Customer email may still exist on empty carts
            var email = token.SelectToken("Customer.Email");
            if (email != null)
            {
                summary.Email = email.ToString();
            }
        }
        catch
        {
            // ignore malformed json
        }

        return summary;
    }
}
