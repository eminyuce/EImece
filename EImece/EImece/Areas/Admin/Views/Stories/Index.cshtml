@model List<EImece.Domain.Entities.Story>
@using Griddly.Mvc
@using Resources

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var controllerName = "Stories";
}

<h2>@AdminResource.Stories</h2>
<hr class="adminLine" />

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
    {"controllerName",controllerName},
    {"StateTypes","State,ImageState,MainPage"},
    {"orderingButton",true},
    {"selectAll",true},
    {"deleteAll",true},
    {"SetStateOnOrOff",true},
    {"IsExcelButtonEnabled",true}
})

@Html.Griddly("IndexGrid", new { id = ViewContext.RouteData.Values["id"], search = Request.QueryString["search"] })
