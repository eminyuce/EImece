@model List<EImece.Domain.Entities.Story>
@using Griddly.Mvc
@using EImece.Domain.Helpers
@using Resources

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var controllerName = "Stories";
}

@Html.AdminBreadcrumb(AdminResource.Stories)
<h2 class="admin-page-title">@AdminResource.Stories</h2>
<hr class="adminLine" />

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
    {"controllerName",controllerName},
    {"StateTypes","State,ImageState,MainPage"},
    {"orderingButton",true},
    {"selectAll",true},
    {"deleteAll",true},
    {"SetStateOnOrOff",true},
    {"IsExcelButtonEnabled",true}
})

@Html.Partial("Grid/_GridChrome")

<div class="js-griddly-async" data-url="@Url.Action("IndexGrid", new { id = ViewContext.RouteData.Values["id"], search = Request.QueryString["search"] })"></div>
