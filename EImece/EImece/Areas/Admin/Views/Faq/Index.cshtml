@model List<EImece.Domain.Entities.Faq>
@using Griddly.Mvc
@using Resources

@{
    ViewBag.Title = AdminResource.Faq;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var controllerName = "Faq";
}

<h2>@AdminResource.Faq</h2>
<hr class="adminLine" />

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
    {"controllerName",controllerName},
    {"StateTypes","State"},
    {"orderingButton",true},
    {"selectAll",true},
    {"deleteAll",true},
    {"SetStateOnOrOff",true},
    {"IsExcelButtonEnabled",true}
})

<div class="js-griddly-async" data-url="@Url.Action("IndexGrid", new { search = Request.QueryString["search"] })"></div>
