@model List<Faq>
@using EImece.Domain.Helpers;
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain;
@using EImece.Domain.Entities;
@using Resources;
@using EImece.Domain.Helpers.Extensions;

@{
    ViewBag.Title = AdminResource.Faq;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : AppConfig.GridPageSizeNumber * (gridPage - 1);

    var controllerName = "Faq";
    var gridName = "FaqGrid";
    var contents = Model;
    var baseList = contents.DownCasting<Faq>();
}

<h2>@AdminResource.Faq</h2>
<hr class="adminLine" />

@Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
        {"controllerName",controllerName}
                 ,{"StateTypes","State"}
       ,{"orderingButton",true}
       ,{"selectAll",true}
       ,{"deleteAll",true}
        ,{"SetStateOnOrOff",true},{"IsExcelButtonEnabled",true}})

@Html.Partial("Grid/_GridChrome")

<div class="panel panel-primary eg-grid-shell">
    @Html.Partial("pGridDropDown", baseList)
    @Html.Grid(contents).Named(gridName).Columns(columns =>
{
columns.Add()
.Encoded(false)
.Sanitized(false)
.Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
.RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

columns.Add(o => o.Id, true);

columns.Add()
.Encoded(false)
.Sanitized(false)
.Css("gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check")
.RenderValueAs(d => Html.Partial("pGridCheckbox", new ViewDataDictionary(ViewData){
            {"ItemId",d.Id}}));

columns.Add(c => c.Question)
.Titled(AdminResource.Question)
.Filterable(true)
.Encoded(false)
.Sanitized(false)
.Css("eg-col-name")
.RenderValueAs(d => Html.Partial("Grid/_GridNameCell", null, new ViewDataDictionary(ViewData) {
    { "Name", d.Question },
    { "ItemId", d.Id.ToString() }
}));

columns.Add(o => o.Answer)
.Titled(AdminResource.Answer)
.Encoded(false)
.Sanitized(false)
.RenderValueAs(o => String.Format("<textarea id='gridTa_{0}' readonly  style='height: 100px; background-color: transparent; width: 589px; margin: 0px;' aria-label='İçerik'>{1}</textarea>", o.Id, GeneralHelper.StripHtml(o.Answer).ToStr(1000)));

columns.Add(o => o.Position).Titled(AdminResource.Position)
.Encoded(false)
.Sanitized(false)
.Css("smallGridColumn")
.RenderValueAs(o => String.Format("<input   id='gridOrdering_{0}' gridkey-id='{0}' value='{1}'   class='GridOrderingTextbox input-xs' name='gridOrdering' type='text' aria-label='Sıra'>", o.Id, o.Position));

columns.Add(o => o.IsActive)
.Titled(AdminResource.IsActive)
.Sortable(true)
.Css("smallGridColumn eg-col-status")
.SortInitialDirection(GridSortDirection.Descending).Encoded(false)
.Sanitized(false)
.RenderValueAs(o => Html.Partial("Grid/_GridStatusToggles", null, new ViewDataDictionary(ViewData) {
    { "ItemId", o.Id },
    { "IsActive", o.IsActive },
    { "ShowState", true },
    { "ShowMainPage", false },
    { "ShowImageState", false }
}));

columns.Add(o => o.UpdatedDate)
.Titled(AdminResource.UpdatedDate)
.Sortable(true)
.Css("gridDateClass")
.RenderValueAs(o => String.Format("{0}", o.UpdatedDate.ToShortDateString()))
.SortInitialDirection(GridSortDirection.Descending);

columns.Add()
.Titled("İşlemler")
.Encoded(false)
.Sanitized(false)
.Css("eg-sticky-right eg-col-actions")
.RenderValueAs(d => Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
    { "ItemId", d.Id },
    { "ItemName", d.Question },
    { "controllerName", controllerName },
    { "ShowMedia", false },
    { "ShowEdit", true },
    { "ShowDelete", true }
}));

}).SetRowCssClasses(item => item.IsActive ? string.Empty : "GridIsActive").WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
</div>
