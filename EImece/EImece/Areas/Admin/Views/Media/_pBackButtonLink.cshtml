@model EImece.Domain.Models.AdminModels.MediaAdminIndexModel
@using EImece.Domain.Helpers;
@using EImece.Domain.Entities;
@using Resources;

@{
    var controllerName = "";
    var baseContent = Model.BaseContent;
    string itemTypeName = "";
    if (baseContent is Product)
    {
        controllerName = "Products";
        itemTypeName = AdminResource.Product;
    }
    else if (baseContent is Story)
    {
        controllerName = "Stories";
        itemTypeName = AdminResource.Story;
    }
    else if (baseContent is Menu)
    {
        controllerName = "Menus";
        itemTypeName = AdminResource.Menu;
    }
    else if (baseContent is StoryCategory)
    {
        controllerName = "StoryCategories";
        itemTypeName = AdminResource.StoryCategory;
    }
    else if (baseContent is ProductCategory)
    {
        controllerName = "ProductCategories";
        itemTypeName = AdminResource.ProductCategory;
    }
    else if (baseContent is MainPageImage)
    {
        controllerName = "MainPageImages";
        itemTypeName = AdminResource.MainPageImages;
    }

    var editorUrl = !string.IsNullOrEmpty(controllerName) && baseContent != null && baseContent.Id > 0
        ? Url.Action("SaveOrEdit", controllerName, new { id = baseContent.Id })
        : "";
    var listUrl = !string.IsNullOrEmpty(controllerName)
        ? Url.Action("Index", controllerName)
        : Url.Action("Index", "Dashboard");
}
<div class="admin-media-heading">
    <div class="admin-media-heading__title">
        <h1>@AdminResource.FileUploadingPage</h1>
        <div class="admin-media-heading__meta">
            @if (baseContent != null)
            {
                <strong>@Html.DisplayFor(model => baseContent.Name)</strong>
            }
            @if (!string.IsNullOrEmpty(itemTypeName))
            {
                <span class="admin-media-heading__type">@itemTypeName</span>
            }
        </div>
    </div>
    <div class="admin-edit-toolbar-actions admin-media-toolbar-actions">
        @if (!string.IsNullOrEmpty(editorUrl))
        {
            <a href="@editorUrl" class="btn btn-sm admin-edit-back-to-editor-btn" title="@AdminResource.BackToEditor">
                <span class="admin-edit-back-to-list-icon" aria-hidden="true">←</span>
                <span>@AdminResource.BackToEditor</span>
            </a>
        }
        <a href="@listUrl" class="btn btn-sm admin-edit-back-to-list-btn" title="@AdminResource.BackToList">
            <span>@AdminResource.BackToList</span>
        </a>
    </div>
</div>
