@using EImece.Domain.Entities;
@using EImece.Domain.Models.AdminModels;
@using EImece.Domain.Helpers;
@using Griddly.Mvc;
@using EImece.Domain;
@using EImece.Domain.Helpers.Extensions;
@using Resources;
@model MediaAdminIndexModel

@{
    ViewBag.Title = AdminResource.FileUploadingPage;
    var baseContent = Model.BaseContent;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var controllerName = "Media";
    var title = AdminResource.Medias;

    var filesHelper = DependencyResolver.Current.GetService<FilesHelper>();
    filesHelper.InitFilesMediaFolder();

}
<div class="admin-media-page">
    @Html.Partial("_pBackButtonLink", Model)

    @Html.HiddenFor(r => Model.Id)
    @Html.HiddenFor(r => Model.ImageType)
    @Html.HiddenFor(r => Model.MediaMod)
    @Html.HiddenFor(r => Model.Lang)

    <p class="admin-media-design-hint">@AdminResource.WarningForDesign</p>

    <!-- FilePond Styles -->
    @Styles.Render("~/Content/filepondcss")

    <!-- FilePond Scripts -->
    @Scripts.Render("~/bundles/filepond")

    <script>
        $(function () {
            // Register FilePond plugins
            if (window.FilePond) {
                if (window.FilePondPluginImagePreview) {
                    FilePond.registerPlugin(FilePondPluginImagePreview);
                }
                if (window.FilePondPluginFileValidateType) {
                    FilePond.registerPlugin(FilePondPluginFileValidateType);
                }
                if (window.FilePondPluginFileValidateSize) {
                    FilePond.registerPlugin(FilePondPluginFileValidateSize);
                }
                if (window.FilePondPluginImageExifOrientation) {
                    FilePond.registerPlugin(FilePondPluginImageExifOrientation);
                }
                if (window.FilePondPluginImageValidateSize) {
                    FilePond.registerPlugin(FilePondPluginImageValidateSize);
                }
            }

            var hasUploadedFiles = false;
            var uploadedBatchCount = 0;
            var uploadUrl = '@Url.Action("Upload", "Media")';
            var $input = $('.filepond-media-input');
            var $uploadHeader = $('.admin-media-upload-header');
            var $countText = $('.admin-media-count-text');
            var $sizeText = $('.admin-media-total-size-text');
            var $btnClearAll = $('.btn-clear-all-pond');
            var $successCard = $('.admin-media-upload-success-card');
            var $uploadedCountNumber = $('.uploaded-count-number');
            var $btnGoToGrid = $('.btn-go-to-grid');
            var $btnUploadMore = $('.btn-upload-more');

            // Initialize Advanced Overall Progress Tracker
            var progressTracker = window.FilePondOverallProgressTracker ? new FilePondOverallProgressTracker({
                container: '.filepond-overall-progress-card'
            }) : null;

            function formatBytes(bytes) {
                if (!bytes || bytes === 0) return '0 B';
                var k = 1024;
                var sizes = ['B', 'KB', 'MB', 'GB'];
                var i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
            }

            function updateHeaderSummary() {
                var pond = $input.filepond ? $input.filepond('getPond') : null;
                if (!pond) return;

                var files = pond.getFiles();
                if (files.length === 0) {
                    $uploadHeader.slideUp(150);
                    return;
                }

                var totalBytes = 0;
                var completeCount = 0;

                files.forEach(function (f) {
                    totalBytes += f.fileSize || (f.file ? f.file.size : 0);
                    if (f.status === 5 /* COMPLETE */) completeCount++;
                });

                $countText.text(files.length + ' Fotoğraf (' + completeCount + '/' + files.length + ' Yüklendi)');
                $sizeText.text('Toplam: ' + formatBytes(totalBytes));
                $uploadHeader.slideDown(150);
            }

            // Initialize FilePond via official jQuery adapter
            $input.filepond({
                instantUpload: true,
                allowMultiple: true,
                allowReorder: true,
                allowPaste: true,
                maxFiles: 50,
                maxParallelUploads: 4,
                acceptedFileTypes: ['image/jpeg', 'image/png', 'image/gif', 'image/webp', 'image/bmp'],
                maxFileSize: '20MB',
                imagePreviewHeight: 180,
                credits: false,
                // Modern, friendly Turkish microcopy
                labelIdle: '<div class="filepond-hero-label">' +
                           '<div class="filepond-hero-icon"><i class="fa fa-cloud-upload"></i></div>' +
                           '<div class="filepond-hero-title">Fotoğrafları buraya sürükleyip bırakın</div>' +
                           '<div class="filepond-hero-subtitle">veya <span class="filepond--label-action">Dosyalara Göz Atın</span></div>' +
                           '<div class="filepond-hero-badges">' +
                           '<span class="badge-pill">📸 JPG, PNG, WEBP, GIF, BMP</span>' +
                           '<span class="badge-pill">⚡ Maks. 20 MB</span>' +
                           '<span class="badge-pill">✨ Çoklu Seçim & Sıralama</span>' +
                           '</div>' +
                           '</div>',
                labelFileProcessing: '@AdminResource.Processing...',
                labelFileProcessingComplete: 'Yüklendi ✓',
                labelFileProcessingAborted: 'İptal Edildi',
                labelFileProcessingError: 'Yükleme Hatası',
                labelTapToCancel: 'İptal',
                labelTapToRetry: 'Yeniden Dene',
                labelTapToUndo: 'Geri Al',
                labelButtonRemoveItem: 'Kaldır',
                labelButtonAbortItemLoad: 'Durdur',
                labelButtonRetryItemLoad: 'Yeniden Dene',
                labelButtonAbortItemProcessing: 'İptal Et',
                labelButtonUndoItemProcessing: 'Geri Al',
                labelButtonRetryItemProcessing: 'Yeniden Dene',
                labelButtonProcessItem: 'Yükle',
                labelFileTypeNotAllowed: 'Desteklenmeyen dosya türü',
                fileValidateTypeLabelExpectedTypes: 'Desteklenen formatlar: JPG, PNG, GIF, WebP, BMP',
                labelMaxFileSizeExceeded: 'Dosya boyutu çok büyük',
                labelMaxFileSize: 'Maksimum dosya boyutu: {filesize}',
                labelMaxTotalFileSizeExceeded: 'Toplam dosya boyutu aşıldı',
                server: {
                    process: {
                        url: uploadUrl,
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() || ''
                        },
                        ondata: function (formData) {
                            formData.append('contentId', $("#Id").val());
                            formData.append('imageType', $("#ImageType").val());
                            formData.append('mod', $("#MediaMod").val());
                            formData.append('imageHeight', $("#ImageHeight").val() || '0');
                            formData.append('imageWidth', $("#ImageWidth").val() || '0');
                            formData.append('selectedTags', '');
                            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').first().val() || '');
                            return formData;
                        },
                        onload: function (response) {
                            try {
                                var res = typeof response === 'string' ? JSON.parse(response) : response;
                                if (res && res.files && res.files.length > 0) {
                                    hasUploadedFiles = true;
                                    uploadedBatchCount += res.files.length;
                                    return res.files[0].name || response;
                                }
                            } catch (e) {
                                hasUploadedFiles = true;
                                uploadedBatchCount++;
                            }
                            return response;
                        },
                        onerror: function (response) {
                            console.error('FilePond upload error:', response);
                            return response;
                        }
                    }
                },
                onaddfile: function (error, file) {
                    $successCard.slideUp(150);
                    if (progressTracker && file) progressTracker.addFile(file);
                    updateHeaderSummary();
                },
                onremovefile: function (error, file) {
                    if (progressTracker && file) progressTracker.removeFile(file.id);
                    updateHeaderSummary();
                },
                onprocessfilestart: function (file) {
                    if (progressTracker) progressTracker.startProcessing();
                },
                onprocessfileprogress: function (file, progress) {
                    if (progressTracker && file) progressTracker.updateProgress(file, progress);
                },
                onprocessfile: function (error, file) {
                    if (progressTracker && file) progressTracker.setFileComplete(file, error);
                    updateHeaderSummary();
                },
                onprocessfileabort: function (file) {
                    if (progressTracker && file) progressTracker.setFileComplete(file, true);
                    updateHeaderSummary();
                },
                onprocessfileerror: function (file, error) {
                    if (progressTracker && file) progressTracker.setFileComplete(file, error);
                    updateHeaderSummary();
                },
                onprocessfiles: function () {
                    updateHeaderSummary();
                    if (hasUploadedFiles) {
                        $uploadedCountNumber.text(uploadedBatchCount || 1);
                        $successCard.slideDown(200);
                    }
                }
            });

            // Action: "Yüklenen Resimleri Tabloda Göster"
            $btnGoToGrid.on('click', function () {
                sessionStorage.setItem('adminMediaActiveTab', '#tab2default');
                window.location.href = window.location.pathname + window.location.search + '#tab2default';
                window.location.reload(true);
            });

            // Action: "Yeni Resimler Yükle"
            $btnUploadMore.on('click', function () {
                var pond = $input.filepond ? $input.filepond('getPond') : null;
                if (pond) {
                    pond.removeFiles();
                }
                if (progressTracker) {
                    progressTracker.reset();
                }
                hasUploadedFiles = false;
                uploadedBatchCount = 0;
                $successCard.slideUp(150);
                updateHeaderSummary();
            });

            // Handle "Tümünü Temizle"
            $btnClearAll.on('click', function () {
                var pond = $input.filepond ? $input.filepond('getPond') : null;
                if (pond) {
                    pond.removeFiles();
                }
                if (progressTracker) {
                    progressTracker.reset();
                }
                updateHeaderSummary();
            });

            // If user directly clicks "Yüklenen Resimler" tab after an upload, refresh grid
            document.querySelectorAll('.admin-media-tabs a[href="#tab2default"]').forEach(function (el) {
                el.addEventListener('shown.bs.tab', function () {
                    if (hasUploadedFiles) {
                        hasUploadedFiles = false;
                        sessionStorage.setItem('adminMediaActiveTab', '#tab2default');
                        window.location.href = window.location.pathname + window.location.search + '#tab2default';
                        window.location.reload(true);
                    }
                });
            });

            // Restore active tab after reload if specified in sessionStorage or URL hash
            var savedTab = sessionStorage.getItem('adminMediaActiveTab') || window.location.hash;
            var tabTrigger = savedTab ? document.querySelector('.admin-media-tabs a[href="' + savedTab + '"]') : null;
            if (tabTrigger && window.bootstrap && bootstrap.Tab) {
                bootstrap.Tab.getOrCreateInstance(tabTrigger).show();
                sessionStorage.removeItem('adminMediaActiveTab');
            }
        });
    </script>

    <div class="card with-nav-tabs card admin-media-tabs">
    <div class="card-header">
        <ul class="nav nav-tabs">
            <li class="nav-item"><a class="nav-link active" href="#tab1default" data-bs-toggle="tab">@AdminResource.FileUploadingSection</a></li>
            <li class="nav-item"><a class="nav-link" href="#tab2default" data-bs-toggle="tab">@AdminResource.UploadedFilesSection</a></li>
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab1default">
                @if (baseContent != null)
                {
                    @Html.Partial("pSliderResizing", baseContent)
                }
                @Html.Partial("_Files")
            </div>
            <div class="tab-pane fade" id="tab2default">

                @Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
            {"controllerName",controllerName}
            ,{"StateTypes","State"}
            ,{"IsNewRecordButtonEnabled",false}
            ,{"IsSearchFormEnabled",false}
            ,{"orderingButton",true}
            ,{"selectAll",true}
            ,{"deleteAll",true}
            ,{"ProductState",false}
            ,{"SetStateOnOrOff",true}})

                <div class="media-clean-actions" style="margin-bottom: 12px; display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 8px;">
                    <button type="button" class="btn btn-info btn-sm btn-refresh-grid" onclick="sessionStorage.setItem('adminMediaActiveTab', '#tab2default'); window.location.href = window.location.pathname + window.location.search + '#tab2default'; window.location.reload(true);" title="Veritabanındaki resimleri ve tabloyu yenile">
                        <i class="fa fa-refresh"></i> Veritabanından Yenile
                    </button>
                    <form method="post" action="@Url.Action("DeleteMissingFiles", "Media")" onsubmit="return confirm('@AdminResource.DeleteMissingFilesConfirmMessage');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="contentId" value="@Model.Id" />
                        <input type="hidden" name="mod" value="@Model.MediaMod" />
                        <input type="hidden" name="imageType" value="@Model.ImageType" />
                        <button type="submit" class="btn btn-danger btn-sm" id="btnDeleteMissingFiles" title="@AdminResource.DeleteMissingFilesTooltip">
                            <i class="fa fa-trash"></i> @AdminResource.DeleteMissingFilesButtonText
                        </button>
                    </form>
                </div>

                @Html.Partial("Grid/_GridChrome")
                <div class="js-griddly-async" data-url="@Url.Action("IndexGrid", new { contentId = Model.Id, mod = Model.MediaMod.ToString(), imageType = Model.ImageType.ToString() })"></div>
            </div>
        </div>
    </div>
</div>
