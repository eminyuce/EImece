@using EImece.Domain.Entities;
@using EImece.Domain.Models.AdminModels;
@using EImece.Domain.Helpers;
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain;
@using EImece.Domain.Helpers.Extensions;
@using Resources;
@model MediaAdminIndexModel

@{
    ViewBag.Title = AdminResource.FileUploadingPage;
    var baseContent = Model.BaseContent;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : AppConfig.GridPageSizeNumber * (gridPage - 1);  

    var controllerName = "Media";
    var title = AdminResource.Medias;
    var gridName = "MediaGrid";
    var contents = Model.FileStorages;
    var baseList = contents.DownCasting<FileStorage>();

    var gridImagesText = AdminResource.GridImagesText;
    var gridEditText = AdminResource.GridEditText;
    var gridDeleteText = AdminResource.GridDeleteText;
    var gridDetailText = AdminResource.GridDetailText;

    var filesHelper = DependencyResolver.Current.GetService<FilesHelper>();
    filesHelper.InitFilesMediaFolder();

}
<div class="admin-media-page">
    @Html.Partial("_pBackButtonLink", Model)

    @Html.HiddenFor(r => Model.Id)
    @Html.HiddenFor(r => Model.ImageType)
    @Html.HiddenFor(r => Model.MediaMod)
    @Html.HiddenFor(r => Model.Lang)

    <p class="admin-media-design-hint">@AdminResource.WarningForDesign</p>

    <!-- FilePond Styles -->
    @Styles.Render("~/Content/filepondcss")

    <!-- FilePond Scripts -->
    @Scripts.Render("~/bundles/filepond")

    <script>
        $(function () {
            // Register FilePond plugins
            if (window.FilePond) {
                if (window.FilePondPluginImagePreview) {
                    FilePond.registerPlugin(FilePondPluginImagePreview);
                }
                if (window.FilePondPluginFileValidateType) {
                    FilePond.registerPlugin(FilePondPluginFileValidateType);
                }
                if (window.FilePondPluginFileValidateSize) {
                    FilePond.registerPlugin(FilePondPluginFileValidateSize);
                }
                if (window.FilePondPluginImageExifOrientation) {
                    FilePond.registerPlugin(FilePondPluginImageExifOrientation);
                }
                if (window.FilePondPluginImageValidateSize) {
                    FilePond.registerPlugin(FilePondPluginImageValidateSize);
                }
            }

            var hasUploadedFiles = false;
            var isUploading = false;
            var uploadStartTime = null;
            var uploadUrl = '@Url.Action("Upload", "Media")';
            var $input = $('.filepond-media-input');
            var $btnBrowse = $('.filepond-btn-browse');
            var $btnStart = $('.filepond-btn-start');
            var $btnCancel = $('.filepond-btn-cancel');
            var $btnDelete = $('.filepond-btn-delete');
            var $toggleAll = $('.filepond-toggle-all');
            var $progressWrapper = $('.filepond-global-progress-wrapper');
            var $progressBar = $('.filepond-global-progress-bar');
            var $progressText = $('.filepond-progress-extended');

            // Format bytes helper
            function formatBytes(bytes) {
                if (!bytes || bytes === 0) return '0.00 MB';
                return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
            }

            // Format seconds to hh:mm:ss
            function formatTime(seconds) {
                if (!seconds || isNaN(seconds) || seconds < 0 || !isFinite(seconds)) return '00:00:00';
                var s = Math.floor(seconds);
                var hrs = Math.floor(s / 3600);
                var mins = Math.floor((s % 3600) / 60);
                var secs = s % 60;
                return (hrs < 10 ? '0' : '') + hrs + ':' + (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
            }

            // Update toolbar button states based on queued files
            function updateToolbarState() {
                var pond = $input.filepond ? $input.filepond('getPond') : null;
                if (!pond) return;

                var files = pond.getFiles();
                var idleFiles = files.filter(function (f) { return f.status === 2; /* FileStatus.IDLE */ });
                var processingFiles = files.filter(function (f) { return f.status === 3 || f.status === 4; /* PROCESSING/PROCESSING_QUEUED */ });

                if (processingFiles.length > 0) {
                    isUploading = true;
                    $btnStart.prop('disabled', true);
                    $btnCancel.prop('disabled', false);
                    $btnDelete.prop('disabled', true);
                    $progressWrapper.show();
                } else if (idleFiles.length > 0) {
                    isUploading = false;
                    $btnStart.prop('disabled', false);
                    $btnCancel.prop('disabled', true);
                    $btnDelete.prop('disabled', false);
                } else {
                    isUploading = false;
                    $btnStart.prop('disabled', true);
                    $btnCancel.prop('disabled', true);
                    $btnDelete.prop('disabled', files.length === 0);
                    if (files.length === 0) {
                        $progressWrapper.hide();
                        $toggleAll.prop('checked', false);
                    }
                }
            }

            // Update overall transfer metrics
            function updateGlobalProgress() {
                var pond = $input.filepond ? $input.filepond('getPond') : null;
                if (!pond) return;

                var files = pond.getFiles();
                if (files.length === 0) {
                    $progressWrapper.hide();
                    return;
                }

                var totalBytes = 0;
                var loadedBytes = 0;

                files.forEach(function (f) {
                    var size = f.fileSize || (f.file ? f.file.size : 0);
                    totalBytes += size;
                    if (f.status === 5 /* COMPLETE */) {
                        loadedBytes += size;
                    } else if (f.status === 3 /* PROCESSING */) {
                        loadedBytes += (size * (f.transferProgress || 0));
                    }
                });

                var percent = totalBytes > 0 ? (loadedBytes / totalBytes) * 100 : 0;
                $progressBar.css('width', percent.toFixed(1) + '%');

                var elapsedSeconds = uploadStartTime ? (Date.now() - uploadStartTime) / 1000 : 0;
                var speedMbits = (elapsedSeconds > 0 && loadedBytes > 0)
                    ? ((loadedBytes * 8) / (elapsedSeconds * 1000 * 1000)).toFixed(2)
                    : '0.00';

                var remainingBytes = Math.max(0, totalBytes - loadedBytes);
                var bytesPerSec = elapsedSeconds > 0 ? loadedBytes / elapsedSeconds : 0;
                var remainingSecs = bytesPerSec > 0 ? remainingBytes / bytesPerSec : 0;

                $progressText.text(
                    speedMbits + ' Mbit/s | ' +
                    formatTime(remainingSecs) + ' | ' +
                    percent.toFixed(2) + ' % | ' +
                    formatBytes(loadedBytes) + ' / ' + formatBytes(totalBytes)
                );
            }

            // Initialize FilePond via official jQuery adapter
            $input.filepond({
                instantUpload: false,
                allowMultiple: true,
                allowReorder: true,
                maxFiles: 50,
                maxParallelUploads: 4,
                acceptedFileTypes: ['image/jpeg', 'image/png', 'image/gif', 'image/webp', 'image/bmp'],
                maxFileSize: '20MB',
                imagePreviewHeight: 100,
                credits: false,
                // Turkish localization strings matching blueimp experience
                labelIdle: '<i class="glyphicon glyphicon-cloud-upload" style="font-size: 26px; display: block; margin-bottom: 6px; color: #3b82f6;"></i><span class="filepond--label-action" style="font-weight: 600;">Resimleri Seçin</span> veya bu alana sürükleyip bırakın',
                labelFileProcessing: '@AdminResource.Processing',
                labelFileProcessingComplete: 'Yükleme Tamamlandı',
                labelFileProcessingAborted: '@AdminResource.CancelUpload',
                labelFileProcessingError: '@AdminResource.UploadError',
                labelTapToCancel: 'İptal etmek için dokunun',
                labelTapToRetry: 'Yeniden denemek için dokunun',
                labelTapToUndo: 'Geri almak için dokunun',
                labelButtonRemoveItem: '@AdminResource.Delete',
                labelButtonAbortItemLoad: 'Durdur',
                labelButtonRetryItemLoad: 'Yeniden Dene',
                labelButtonAbortItemProcessing: '@AdminResource.CancelUpload',
                labelButtonUndoItemProcessing: 'Geri Al',
                labelButtonRetryItemProcessing: 'Yeniden Dene',
                labelButtonProcessItem: '@AdminResource.StartUpload',
                labelFileTypeNotAllowed: '@AdminResource.FileUploadAcceptFileTypes',
                fileValidateTypeLabelExpectedTypes: 'Desteklenen formatlar: JPG, PNG, GIF, WebP, BMP',
                labelMaxFileSizeExceeded: '@AdminResource.FileUploadMaxFileSize',
                labelMaxFileSize: 'Maksimum dosya boyutu: {filesize}',
                labelMaxTotalFileSizeExceeded: 'Toplam dosya boyutu aşıldı',
                server: {
                    process: {
                        url: uploadUrl,
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').first().val() || ''
                        },
                        ondata: function (formData) {
                            formData.append('contentId', $("#Id").val());
                            formData.append('imageType', $("#ImageType").val());
                            formData.append('mod', $("#MediaMod").val());
                            formData.append('imageHeight', $("#ImageHeight").val() || '0');
                            formData.append('imageWidth', $("#ImageWidth").val() || '0');
                            formData.append('selectedTags', '');
                            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').first().val() || '');
                            return formData;
                        },
                        onload: function (response) {
                            try {
                                var res = typeof response === 'string' ? JSON.parse(response) : response;
                                if (res && res.files && res.files.length > 0) {
                                    hasUploadedFiles = true;
                                    return res.files[0].name || response;
                                }
                            } catch (e) {
                                hasUploadedFiles = true;
                            }
                            return response;
                        },
                        onerror: function (response) {
                            console.error('FilePond upload error:', response);
                            return response;
                        }
                    }
                },
                onaddfile: function () {
                    updateToolbarState();
                    updateGlobalProgress();
                },
                onremovefile: function () {
                    updateToolbarState();
                    updateGlobalProgress();
                },
                onprocessfilestart: function () {
                    if (!uploadStartTime) {
                        uploadStartTime = Date.now();
                    }
                    $progressWrapper.show();
                    updateToolbarState();
                },
                onprocessfileprogress: function (file, progress) {
                    file.transferProgress = progress;
                    updateGlobalProgress();
                },
                onprocessfile: function (error, file) {
                    if (!error) {
                        file.transferProgress = 1.0;
                    }
                    updateToolbarState();
                    updateGlobalProgress();
                },
                onprocessfiles: function () {
                    uploadStartTime = null;
                    updateToolbarState();
                    updateGlobalProgress();

                    if (hasUploadedFiles) {
                        hasUploadedFiles = false;
                        sessionStorage.setItem('adminMediaActiveTab', '#tab2default');
                        setTimeout(function () {
                            window.location.href = window.location.pathname + window.location.search + '#tab2default';
                            window.location.reload(true);
                        }, 500);
                    }
                }
            });

            // Wire Toolbar Button: Resimler ekle...
            $btnBrowse.on('click', function (e) {
                e.preventDefault();
                $input.filepond('browse');
            });

            // Wire Toolbar Button: Yüklemeye Başla
            $btnStart.on('click', function (e) {
                e.preventDefault();
                uploadStartTime = Date.now();
                $progressWrapper.show();
                $progressBar.css('width', '0%');
                $input.filepond('processFiles');
                updateToolbarState();
            });

            // Wire Toolbar Button: Yüklemeyi İptal Et
            $btnCancel.on('click', function (e) {
                e.preventDefault();
                var pond = $input.filepond('getPond');
                if (pond) {
                    var files = pond.getFiles();
                    files.forEach(function (f) {
                        if (f.status === 3 || f.status === 4) {
                            pond.abortProcessing(f.id);
                        }
                    });
                }
                uploadStartTime = null;
                updateToolbarState();
                updateGlobalProgress();
            });

            // Wire Toolbar Button: Sil / Temizle
            $btnDelete.on('click', function (e) {
                e.preventDefault();
                var pond = $input.filepond('getPond');
                if (!pond) return;

                var files = pond.getFiles();
                if (files.length === 0) return;

                if (confirm('Yükleme listesindeki resimleri temizlemek istiyor musunuz?')) {
                    pond.removeFiles();
                    $progressBar.css('width', '0%');
                    $progressWrapper.hide();
                    updateToolbarState();
                }
            });

            // Wire Toolbar Toggle: Hepsi seç
            $toggleAll.on('change', function () {
                var checked = $(this).is(':checked');
                // Visual feedback or selection toggle
                $('.filepond--item').toggleClass('is-selected', checked);
            });

            // Restore active tab after reload if specified in sessionStorage or URL hash
            var savedTab = sessionStorage.getItem('adminMediaActiveTab') || window.location.hash;
            if (savedTab && $('.admin-media-tabs a[href="' + savedTab + '"]').length) {
                $('.admin-media-tabs a[href="' + savedTab + '"]').tab('show');
                sessionStorage.removeItem('adminMediaActiveTab');
            }
        });
    </script>

    <div class="panel with-nav-tabs panel-default admin-media-tabs">
    <div class="panel-heading">
        <ul class="nav nav-tabs">
            <li class="active"><a href="#tab1default" data-toggle="tab">@AdminResource.FileUploadingSection</a></li>
            <li><a href="#tab2default" data-toggle="tab">@AdminResource.UploadedFilesSection</a></li>
        </ul>
    </div>
    <div class="panel-body">
        <div class="tab-content">
            <div class="tab-pane fade in active" id="tab1default">
                @Html.Partial("pSliderResizing", baseContent)
                @Html.Partial("_Files")
            </div>
            <div class="tab-pane fade" id="tab2default">

                @Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
            {"controllerName",controllerName}
           ,{"StateTypes","State"}
           ,{"IsNewRecordButtonEnabled",false}
           ,{"IsSearchFormEnabled",false}
           ,{"orderingButton",true}
           ,{"selectAll",true}
           ,{"deleteAll",true}
           ,{"ProductState",false}
           ,{"SetStateOnOrOff",true}})

                <div class="media-clean-actions" style="margin-bottom: 12px; display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 8px;">
                    <form method="post" action="@Url.Action("DeleteMissingFiles", "Media")" onsubmit="return confirm('@AdminResource.DeleteMissingFilesConfirmMessage');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="contentId" value="@Model.Id" />
                        <input type="hidden" name="mod" value="@Model.MediaMod" />
                        <input type="hidden" name="imageType" value="@Model.ImageType" />
                        <button type="submit" class="btn btn-danger btn-sm" id="btnDeleteMissingFiles" title="@AdminResource.DeleteMissingFilesTooltip">
                            <i class="glyphicon glyphicon-trash"></i> @AdminResource.DeleteMissingFilesButtonText
                        </button>
                    </form>
                </div>

                @Html.Partial("Grid/_GridChrome")

                <div class="panel panel-primary eg-grid-shell">
                   
                    @Html.Partial("pGridDropDown", baseList)
                    @Html.Grid(contents).Named(gridName).Columns(columns =>
               {

                   columns.Add()
          .Encoded(false)
                       .Sanitized(false)
           .Css("eg-sticky-left eg-sticky-left-1 eg-col-index")
           .RenderValueAs(_ => string.Format("<span class='eg-row-index'>{0}</span>", ++rowIndex));

                   columns.Add()
                       .Encoded(false)
                       .Sanitized(false)
                       .Css("gridButtons eg-sticky-left eg-sticky-left-2 eg-col-check")
                       .RenderValueAs(d => Html.Partial("pGridCheckbox",
                                          new ViewDataDictionary(ViewData){
            // DeleteMediaGridItem / FileStorageService.DeleteBaseEntity expects:
            // fileStorageId-contentId-mod-imageType
            {"ItemId", String.Format("{0}-{1}-{2}-{3}", d.Id, Model.Id, Model.MediaMod, Model.ImageType)}}));

                   columns.Add(o => o.Id, true);

                   columns.Add()
                     .Encoded(false)
                     .Sanitized(false)
                     .RenderValueAs(d => ImageLinkColumn(d, filesHelper));

                   columns.Add(o => o.Position).Titled(AdminResource.Position)
                     .Encoded(false).
                          Sanitized(false).
                          Css("smallGridColumn").
                          RenderValueAs(o => String.Format("<input   gridkey-id='{0}' value='{1}'   class='GridOrderingTextbox input-xs' name='gridOrdering' type='type'>", o.Id, o.Position));

                   columns.Add(o => o.IsActive)
                              .Titled(AdminResource.IsActive)
                          .Sortable(true)
                          .Css("smallGridColumn eg-col-status")
                          .SortInitialDirection(GridSortDirection.Descending).Encoded(false).
                           Sanitized(false)
                          .RenderValueAs(o => Html.Partial("Grid/_GridStatusToggles", null, new ViewDataDictionary(ViewData) {
                              { "ItemId", o.Id },
                              { "IsActive", o.IsActive },
                              { "ShowState", true },
                              { "ShowMainPage", false },
                              { "ShowImageState", false }
                          }));

                   columns.Add(o => o.UpdatedDate)
                              .Titled(AdminResource.UpdatedDate)
                          .Sortable(true)
                          .Css("gridDateClass")
                          .RenderValueAs(o => o.UpdatedDate != null ? String.Format("{0}", o.UpdatedDate.ToShortDateString()) : null)
                          .SortInitialDirection(GridSortDirection.Descending);

                   columns.Add()
                       .Titled("İşlemler")
                       .Encoded(false)
                       .Sanitized(false)
                       .Css("eg-sticky-right eg-col-actions")
                       .RenderValueAs(d => Html.Partial("Grid/_GridActionsMenu", null, new ViewDataDictionary(ViewData) {
                           { "ItemId", d.Id },
                           { "ItemName", d.Name },
                           { "controllerName", controllerName },
                           { "ShowMedia", false },
                           { "ShowEdit", false },
                           { "ShowDelete", true },
                           { "gridDeleteText", AdminResource.Remove }
                       }));

               }).SetRowCssClasses(item => item.IsActive ? string.Empty : "GridIsActive").WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
                </div>
            </div>
        </div>
    </div>
</div>

@helper ImageLinkColumn(FileStorage fileStorage, FilesHelper fileHelper)
{
    bool fileExists = fileHelper != null && fileHelper.NormalFileExists(fileStorage.FileName);
    var imageSizes = fileHelper.GetThumbnailImageSize(fileStorage);
    var fullImageUrl = String.Format("../..{1}{0}", fileStorage.FileName, Constants.UrlBase);
    var thumbImageUrl = String.Format("../..{1}thumbs/thb{0}", fileStorage.FileName, Constants.UrlBase);
    var downloadUrl = String.Format("/media/images/{0}", fileStorage.FileName);
<div class="media-file-preview">
    <div class="media-file-preview-thumb">
        @if (fileExists)
        {
            <a href="@downloadUrl" title="@fileStorage.FileName" download="@fileStorage.FileName" data-gallery="">
                <img src="@fileStorage.GetAdminCroppedImageUrl(150,0)" alt="@fileStorage.FileName" />
            </a>
        }
        else
        {
            <div class="alert alert-danger" style="padding:6px;margin-bottom:4px;font-size:11px;line-height:1.2;text-align:center;">
                <i class="glyphicon glyphicon-exclamation-sign"></i><br />
                <strong>@AdminResource.FileNotFound</strong><br />
                <span style="font-size:10px;">@AdminResource.MissingFileNotFoundOnDisk</span>
            </div>
        }
        <div class="media-file-preview-name">@fileStorage.FileName</div>
    </div>
    <div class="media-file-preview-meta">
        @if (fileExists)
        {
            <div>
                @String.Format(AdminResource.OriginalWidthHeightFormat, imageSizes.OriginalWidth, imageSizes.OriginalHeight)
                <a href="@fullImageUrl" target="_blank">@AdminResource.FullImage</a>
            </div>
            <div>
                @String.Format(AdminResource.ThumbsWidthHeightFormat, imageSizes.Width, imageSizes.Height)
                <a href="@thumbImageUrl" target="_blank">@AdminResource.ThumbsImage</a>
            </div>
        }
        else
        {
            <div>
                <span class="label label-danger" title="@AdminResource.MissingFileTooltip">
                    <i class="glyphicon glyphicon-remove"></i> @AdminResource.MissingFile
                </span>
            </div>
        }
    </div>
</div>
}
