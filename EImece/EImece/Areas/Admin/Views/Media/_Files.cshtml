@using Resources;

<div class="admin-media-modern-uploader">
    <!-- Real-Time Overall Upload Progress Card -->
    <div class="filepond-overall-progress-card" style="display: none;" aria-live="polite">
        <div class="fpop-header">
            <div class="fpop-title-wrap">
                <span class="fpop-status-icon"><i class="fa-solid fa-cloud-arrow-up"></i></span>
                <span class="fpop-status-title">Fotoğraflar yükleniyor</span>
            </div>
            <div class="fpop-percentage">0%</div>
        </div>

        <div class="fpop-count-row">
            <span class="fpop-file-count-text">0 / 0 fotoğraf yüklendi</span>
        </div>

        <div class="fpop-bar-track">
            <div class="fpop-bar-fill" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" style="width: 0%;"></div>
        </div>

        <div class="fpop-metrics-row">
            <span class="fpop-metric fpop-speed-text">-- Mbit/s</span>
            <span class="fpop-separator">·</span>
            <span class="fpop-metric fpop-bytes-text">0 MB / 0 MB</span>
            <span class="fpop-separator">·</span>
            <span class="fpop-metric fpop-eta-text">Hesaplanıyor...</span>
        </div>
    </div>

    <!-- Post-Upload Success Card with Direct Navigation / Refresh Actions -->
    <div class="admin-media-upload-success-card" style="display: none;">
        <div class="success-message-wrap">
            <div class="success-icon">
                <i class="fa-solid fa-check"></i>
            </div>
            <div>
                <h4 class="success-title">Fotoğraflar Başarıyla Yüklendi!</h4>
                <p class="success-desc"><strong class="uploaded-count-number">0</strong> fotoğraf sunucuya yüklendi ve veritabanına kaydedildi.</p>
            </div>
        </div>
        <div class="success-actions">
            <button type="button" class="btn btn-go-to-grid" title="Yüklenen resimleri tabloda görüntüle">
                <i class="fa-solid fa-table-list"></i> Yüklenen Resimleri Tabloda Göster
            </button>
            <button type="button" class="btn btn-upload-more" title="Daha fazla resim ekle">
                <i class="fa-solid fa-plus"></i> Yeni Resimler Yükle
            </button>
        </div>
    </div>

    <!-- Header Bar with Quick Status & Actions -->
    <div class="admin-media-upload-header" style="display: none;">
        <div class="admin-media-upload-status">
            <span class="badge text-bg-info admin-media-files-count-badge">
                <i class="fa-regular fa-image"></i> <span class="admin-media-count-text">0 Resim Seçildi</span>
            </span>
            <span class="admin-media-total-size-text text-muted" style="font-size: 12px; margin-left: 8px;"></span>
        </div>
        <div class="admin-media-upload-actions">
            <button type="button" class="btn btn-secondary btn-sm btn-clear-all-pond" title="Listeyi Temizle">
                <i class="fa-solid fa-trash"></i> allü Temizle
            </button>
        </div>
    </div>

    <!-- FilePond Input -->
    <div class="admin-media-filepond-wrapper">
        <input type="file" 
               class="filepond-media-input" 
               name="files" 
               multiple 
               data-allow-reorder="true"
               data-max-file-size="20MB"
               data-max-files="50" />
    </div>
</div>

