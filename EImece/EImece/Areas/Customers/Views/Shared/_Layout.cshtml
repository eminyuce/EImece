@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@using System.Threading;
@using Microsoft.AspNet.Identity;
@{
    var userName = User.Identity.GetUserName();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    @{
        var countryCode = Thread.CurrentThread.CurrentUICulture.ToString();
    }
    <link rel="mask-icon" color="#111" href="~/Content/safari-pinned-tab.svg">
    <meta name="msapplication-TileColor" content="#111">
    <meta name="theme-color" content="#ffffff">
    @Styles.Render("~/Content/siteBootstrapCss")
    @Styles.Render("~/Content/themes/base/css")
    <link rel="stylesheet" href="~/Content/admin-vendor/fontawesome/css/all.min.css?v=7.3.1">
</head>

<body class="fullscreen-container">
    <input type="hidden" name="lang" value="@countryCode" />
    <div class="navbar bg-dark py-2 px-0">
        <div class="container px-3">
            <ul class="list-inline mb-0 d-none d-lg-inline-block">
                <li class="list-inline-item opacity-75 me-2">
                    @Html.Action("WebSiteAddressInfo", "Home", new { isMobilePage = false })
                </li>
            </ul>
            <div class="dropdown d-inline-block d-lg-none">
                <a class="dropdown-toggle text-light opacity-75 py-1" href="#" data-bs-toggle="dropdown">@Resource.UsefulLinks</a>
                <div class="dropdown-menu">
                    @Html.Action("WebSiteAddressInfo", "Home", new { isMobilePage = true })
                </div>
            </div>
        </div>
    </div>

    @RenderBody()
    @Scripts.Render("~/bundles/siteJquery")
    @Scripts.Render("~/bundles/siteJqueryMigrate")
    @Scripts.Render("~/bundles/siteBootstrap")
    @Scripts.Render("~/bundles/eimeceScripts")
    @RenderSection("scripts", required: false)
</body>
</html>
