@model EImece.Models.ChangePasswordViewModel
@using Resources;
@using EImece.Domain.Models.DTOs.Storefront;
@{
    ViewBag.Title = Resource.ChangePassword;
}

<div class="container customer-page pt-lg-3 pb-5 mb-sm-3">
    @Html.Partial("_CustomerSummaryDetails", (CustomerSummaryDto)ViewBag.CustomerSummary)

    @using (Html.BeginForm("ChangePassword", "Home", new { area = "customers" }, FormMethod.Post, new { @class = "customer-panel customer-panel--narrow mx-auto", role = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger customer-alert" })

        <section class="customer-panel__section customer-panel__section--last">
            <header class="customer-panel__section-head">
                <h2 class="customer-panel__section-title">
                    <i class="fas fa-lock mr-2 text-primary" aria-hidden="true"></i>
                    @Resource.ChangePassword
                </h2>
                <p class="customer-panel__section-lead">Hesabınızı güvende tutmak için güçlü bir şifre seçin.</p>
            </header>

            <div class="customer-panel__stack">
                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.OldPassword, new { @class = "col-form-label" })
                    @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control", autocomplete = "current-password", placeholder = Resource.CurrentPassword })
                    @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger" })
                </div>
                <div class="form-group mb-3">
                    @Html.LabelFor(m => m.NewPassword, new { @class = "col-form-label" })
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", autocomplete = "new-password", placeholder = Resource.NewPassword })
                    <p class="customer-password-hint mb-0">
                        <i class="fas fa-info-circle mr-1" aria-hidden="true"></i>
                        @Resource.PasswordInfoMessage
                    </p>
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
                </div>
                <div class="form-group mb-4">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "col-form-label" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password", placeholder = Resource.ConfirmNewPassword })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                </div>
                <div class="customer-profile-actions customer-profile-actions--end">
                    <button type="submit" class="btn customer-btn-primary customer-profile-actions__submit">
                        <i class="fas fa-key mr-2" aria-hidden="true"></i>
                        <span>@Resource.ChangePassword</span>
                    </button>
                </div>
            </div>
        </section>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}