@using EImece.Domain.Entities;
@using EImece.Domain.Helpers;
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Helpers.Extensions;
@using Resources;
@using EImece.Domain.Models.FrontModels;
@model ContactUsFormViewModel

@{
    var SendButtonText = Resource.SendButtonText;
}

@using (Html.BeginForm("SendSellerMessage", "Home", new { area = "customers" }, FormMethod.Post, new { @class = "customer-contact-form" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ContactFormType)
    @Html.HiddenFor(model => model.ItemId)
    @Html.HiddenFor(model => model.ItemType)

    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <div class="customer-panel__grid">
        <div class="form-group">
            <label class="col-form-label font-weight-semibold" for="ReasonsBase">
                <i class="fas fa-tag mr-1 text-primary" aria-hidden="true"></i>
                @Resource.SelectReasonsLabel
            </label>
            @Html.DropDownListFor(model => model.Reasons,
                     GetReasonsSelectList(),
                     Resource.SelectReason,
                     new { @class = "form-control", id = "ReasonsBase" })
            @Html.ValidationMessageFor(model => model.Reasons, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="col-form-label font-weight-semibold" for="OrderNumberBase">
                <i class="fas fa-receipt mr-1 text-primary" aria-hidden="true"></i>
                @Resource.OrderNumber
            </label>
            @Html.EditorFor(model => model.OrderNumber, new { htmlAttributes = new { @class = "form-control", placeholder = "Örn: 10425 (Varsa)", @id = "OrderNumberBase" } })
            @Html.ValidationMessageFor(model => model.OrderNumber, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="col-form-label font-weight-semibold" for="ContactNameBase">
                <i class="fas fa-user mr-1 text-primary" aria-hidden="true"></i>
                @Resource.ContactUsName
            </label>
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", placeholder = Resource.ContactUsName, @id = "ContactNameBase" } })
            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="col-form-label font-weight-semibold" for="ContactEmailBase">
                <i class="fas fa-envelope mr-1 text-primary" aria-hidden="true"></i>
                @Resource.ContactUsEmail
            </label>
            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", placeholder = Resource.ContactUsEmail, @id = "ContactEmailBase" } })
            @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="col-form-label font-weight-semibold" for="ContactPhoneBase">
                <i class="fas fa-phone mr-1 text-primary" aria-hidden="true"></i>
                @Resource.ContactUsPhone
            </label>
            @Html.EditorFor(model => model.Phone, new { htmlAttributes = new { @class = "form-control", placeholder = "+90 5XX XXX XX XX", @id = "ContactPhoneBase" } })
            @Html.ValidationMessageFor(model => model.Phone, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group mt-3 mb-4">
        <label class="col-form-label font-weight-semibold" for="ContactMessageBase">
            <i class="fas fa-comment mr-1 text-primary" aria-hidden="true"></i>
            @Resource.ContactUsMessage
        </label>
        @Html.TextAreaFor(model => model.Message, new { @rows = "5", @class = "form-control", placeholder = "Mesajınızı buraya yazınız...", @id = "ContactMessageBase" })
        @Html.ValidationMessageFor(model => model.Message, "", new { @class = "text-danger" })
    </div>

    <div class="customer-profile-actions customer-profile-actions--end">
        <button type="submit" class="btn customer-btn-primary customer-profile-actions__submit">
            <i class="fas fa-paper-plane mr-2" aria-hidden="true"></i>
            <span>@SendButtonText</span>
        </button>
    </div>
}

@functions {
    private List<SelectListItem> GetReasonsSelectList()
    {
        var reasons = new List<SelectListItem>();
        reasons.Add(new SelectListItem()
        {
            Text = Resource.ManagingMyAccount,
            Value = Resource.ManagingMyAccount
        });
        reasons.Add(new SelectListItem()
        {
            Text = Resource.DeliveryInformation,
            Value = Resource.DeliveryInformation
        });
        reasons.Add(new SelectListItem()
        {
            Text = Resource.GetInformationAboutYourOrder,
            Value = Resource.GetInformationAboutYourOrder
        });
        reasons.Add(new SelectListItem()
        {
            Text = Resource.ReturnPolicy,
            Value = Resource.ReturnPolicy
        });
        reasons.Add(new SelectListItem()
        {
            Text = Resource.MessageAboutSizeorColorPreference,
            Value = Resource.MessageAboutSizeorColorPreference
        });
        reasons.Add(new SelectListItem()
        {
            Text = Resource.IfProductAvailable,
            Value = Resource.IfProductAvailable
        });
        reasons.Add(new SelectListItem()
        {
            Text = Resource.OthersMessage,
            Value = Resource.OthersMessage
        });
        return reasons;
    }
}