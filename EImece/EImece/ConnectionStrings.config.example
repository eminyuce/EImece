<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to ConnectionStrings.config (gitignored). For local IIS, put it one
  folder above the site so publish cannot delete it:

    C:\inetpub\wwwroot\ConnectionStrings.config
    C:\inetpub\wwwroot\Eimece\          (published site)

  Do not use configSource=".." — ASP.NET forbids paths outside the application folder.
  ConnectionStringProvider reads the parent file at startup.

  Never commit ConnectionStrings.config with real credentials.
  See docs/SECURE_CONNECTION_STRINGS.md.
-->
<connectionStrings>
  <add name="EImeceDbConnection"
       connectionString="Data Source=YOUR_SERVER;Initial Catalog=YOUR_DATABASE;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;"
       providerName="System.Data.SqlClient" />
</connectionStrings>
