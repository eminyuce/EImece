<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=301880

  -->
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <!--
    SECURITY: Never commit real SQL passwords. Prefer EIMECE_DB_CONNECTION_STRING (env var),
    or a gitignored ConnectionStrings.config via configSource (see ConnectionStrings.config.example
    and docs/SECURE_CONNECTION_STRINGS.md). Placeholder values below fail closed at startup
    until replaced by env/local config.
  -->
  <connectionStrings>
    <remove name="LocalSqlServer" />
    <remove name="LocalMySqlServer" />
    <add name="EImeceDbConnection" connectionString="Data Source=YOUR_SERVER;Initial Catalog=YOUR_DATABASE;Integrated Security=True;Encrypt=True;TrustServerCertificate=False;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <!--
    =============================================================================
    appSettings — change values below to configure the site. Most keys are read
    via AppConfig / SeoSettings. After editing Web.config, IIS recycles the app.
    Prefer environment variables for secrets in production (never commit them).
    =============================================================================
  -->
  <appSettings>

    <!-- ========== Site identity & URLs ========== -->
    <!-- Public host used in absolute URLs (canonical, og:image, sitemap, emails). Example: www.example.com or localhost:81 -->
    <add key="domain" value="localhost:81" />
    <!-- true = generate https:// links (HttpProtocol). false = http://. Match your IIS binding / reverse proxy. -->
    <add key="UseSSL" value="false" />
    <!-- Reserved for image URL protocol; image helpers currently follow UseSSL. Keep in sync with UseSSL. -->
    <add key="UseSSLImages" value="false" />
    <!-- UI skin folder under Views/Designs. Examples: Crizal, Modern -->
    <add key="ActiveDesign" value="Crizal" />
    <!-- Site lifecycle: "live" = production mode (robots/sitemap allow indexing paths). Other values (e.g. "dev") = not live.
         Web.Release.config sets live for published builds. Keep "dev" in source for local work. -->
    <add key="SiteStatus" value="dev" />
    <!-- true = show under-construction page / noindex behavior. false = normal site. -->
    <add key="IsSiteUnderConstruction" value="false" />
    <!-- false = block search engines (X-Robots-Tag + meta robots + robots.txt Disallow). true = allow indexing when site is live. -->
    <add key="AllowSearchEngineIndexing" value="false" />

    <!-- ========== Language ========== -->
    <!-- Default language id used by the app (matches language table / enum). 1 = Turkish in typical setups. -->
    <add key="MainLanguage" value="1" />
    <!-- Enabled cultures, comma-separated. Example: tr-TR or tr-TR,en-US -->
    <add key="Application_Languages" value="tr-TR" />

    <!-- ========== Caching ========== -->
    <!-- Master switch for application output/data caching. false = always hit DB / skip cache. -->
    <add key="IsCacheActive" value="true" />
    <!-- Cache TTL in seconds (used by OutputCache profiles / AppConfig helpers). -->
    <add key="CacheTinySeconds" value="1" />
    <add key="CacheShortSeconds" value="10" />
    <add key="CacheMediumSeconds" value="300" />
    <add key="CacheLongSeconds" value="1800" />
    <add key="CacheVeryLongSeconds" value="180000" />
    <!-- Rows per page in admin grids / list UIs. -->
    <add key="GridPageSizeNumber" value="100" />
    <!-- Product detail: ShortDescription preview length in characters. Longer text shows a Continue... button. -->
    <add key="ProductShortDescriptionPreviewLength" value="180" />

    <!-- ========== Admin panel & security ========== -->
    <!-- TEMPORARY local debug only: true = skip AdminLogin and auto-auth as Admin. MUST be false in production.
         Ignored (hard false) when SiteStatus=live; AppConfig logs a Warning once if this is true while live. -->
    <add key="BypassAdminAuth" value="false" />
    <!-- true = AdminLogin and /admin available. false = login disabled; /admin redirects home. -->
    <add key="AdminLoginEnabled" value="true" />
    <!-- true = admin/editor must enable Authenticator 2FA before using admin (skipped when compilation debug=true or BypassAdminAuth). -->
    <add key="RequireAdminAuthenticator" value="true" />
    <!-- Comma-separated emails allowed to skip forced Authenticator 2FA (local/debug helper accounts). -->
    <add key="TwoFactorBypassUsers" value="" />
    <!-- true = show full exception details in the browser. Local/dev only; Web.Release.config forces false. -->
    <add key="ExposeDetailedErrors" value="true" />
    <!-- true = show "edit this" links on the public site for logged-in editors. -->
    <add key="IsEditLinkEnable" value="false" />
    <!-- Admin media preview thumbnail size as % of original (typo in key name kept for compatibility). -->
    <add key="AdminImageHeightPercantage" value="50" />
    <add key="AdminImageWidthPercantage" value="50" />

    <!-- ========== Images ========== -->
    <!-- false = use /images/wXhY resize proxy (recommended for correct display sizes). true = link directly under /media. -->
    <add key="IsImageFullSrcUnderMediaFolder" value="false" />
    <!-- Upload-time resize/compress (FilesHelper.SaveImageByte). Never upscales. Lower quality/max size = less disk. -->
    <!-- Full stored image max box (px). 0 = no cap on that axis. Default 1920 is enough for product zoom. -->
    <add key="ImageUploadMaxWidth" value="1920" />
    <add key="ImageUploadMaxHeight" value="1920" />
    <!-- JPEG quality 40–95. 75 = smaller files; 82 = default; 85–90 = more detail. -->
    <add key="ImageUploadJpegQuality" value="82" />
    <!-- Prebuilt thumbs under media/images/thumbs/. Extra cap on top of admin ImageWidth/Height. -->
    <add key="ImageUploadThumbMaxWidth" value="800" />
    <add key="ImageUploadThumbMaxHeight" value="800" />
    <add key="ImageUploadThumbJpegQuality" value="75" />
    <!-- true = store primary file as .webp when smaller (updates FileName + MimeType). Default false keeps JPEG/PNG consumers working. -->
    <add key="ImageUploadPreferWebP" value="false" />
    <add key="ImageUploadWebPQuality" value="82" />
    <!-- true = also write a .webp sidecar next to JPEG/PNG (uses more disk). Resize proxy already serves WebP on the fly. -->
    <add key="ImageUploadSaveWebPSidecar" value="false" />
    <!-- true = keep original bytes when re-encode is not smaller and size was not reduced. BMP/TIFF always convert. -->
    <add key="ImageUploadKeepOriginalIfSmaller" value="true" />

    <!-- ========== Email ========== -->
    <!-- true = send mail via SMTP. false = skip sending (useful on local/dev). -->
    <add key="IsSmtpClientEnabled" value="true" />

    <!-- ========== Payments ========== -->
    <!-- Active payment Strategy key. KEEP "Iyzico" in production — it is the live Checkout Form provider.
         Future providers can be added as new IPaymentStrategy implementations without changing PaymentController. -->
    <add key="PaymentProvider" value="Iyzico" />
    <!-- Iyzico API base URL. Sandbox: https://sandbox-api.iyzipay.com — Production: https://api.iyzipay.com -->
    <add key="IyzicoBaseUrl" value="https://sandbox-api.iyzipay.com" />
    <!-- Iyzico credentials. Prefer secrets/env in production; do not commit real keys. -->
    <add key="IyzicoApiKey" value="" />
    <add key="IyzicoSecretKey" value="" />
    <!-- Allowed installment counts shown at checkout, comma-separated. -->
    <add key="IyzicoEnabledInstallments" value="1,2,4,6,9" />
    <!-- Fallback buyer TCKN/identity used in payment flows when user identity is missing (sandbox/dev). -->
    <add key="BuyerIdentityNumber" value="10000000000" />

    <!--
      REQUIRED for payment callback encryption (orderGuid / userId).
      Prefer environment variable EIMECE_ENCRYPTION_KEY over storing the secret here.
      Generate: openssl rand -base64 32
      PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
      Do NOT commit production keys. App fails closed if unset. Changing the key invalidates in-flight callback URLs.
    -->
    <add key="encrypt-password" value="" />

    <!-- ========== Captcha ========== -->
    <!-- Captcha mode: Legacy (arithmetic image) | Recaptcha (Google v2) | None -->
    <add key="CaptchaProvider" value="Legacy" />
    <!-- Legacy override: if CaptchaProvider is omitted, RecaptchaEnabled=true selects Google reCAPTCHA. -->
    <add key="RecaptchaEnabled" value="false" />
    <!-- Leave empty for Legacy. For Recaptcha, keys from https://www.google.com/recaptcha/admin -->
    <add key="RecaptchaSiteKey" value="" />
    <add key="RecaptchaSecretKey" value="" />
    <add key="RecaptchaSiteVerifyUrl" value="" />

    <!-- ========== External login providers (OAuth) ========== -->
    <!-- Leave empty to disable that provider. Register apps in each vendor console and paste ClientId/Secret. -->
    <add key="MicrosoftAccount_ClientId" value="" />
    <add key="MicrosoftAccount_ClientSecret" value="" />
    <add key="TwitterAccount_ConsumerKey" value="" />
    <add key="TwitterAccount_ConsumerSecret" value="" />
    <add key="FacebookAccount_AppId" value="" />
    <add key="FacebookAccount_AppSecret" value="" />
    <add key="GoogleAccount_ClientId" value="" />
    <add key="GoogleAccount_ClientSecret" value="" />

    <!-- ========== Background jobs ========== -->
    <!-- true = Quartz scheduler runs scheduled jobs. false = no background jobs (typical for local). -->
    <add key="Quartz_Scheduler_IsEnabled" value="False" />

    <!-- ========== Content / misc ========== -->
    <!-- Menu/category id for "Müşteri İlişkileri" children (Turkish). -1 = unset / use code default. -->
    <add key="MusteriIliskileriChildrenIdTurkce" value="-1" />
    <!-- Legacy test setting; safe to ignore unless you know a feature reads it. -->
    <add key="TestKey" value="100" />

    <!-- ========== ASP.NET MVC framework (usually leave as-is) ========== -->
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <!-- true = jQuery unobtrusive client validation on forms. -->
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />

    <!-- ========== Database & HTTP resilience ========== -->
    <!-- EF/SQL command timeout in seconds (long imports/reports may need higher values). -->
    <add key="DatabaseCommandTimeoutSeconds" value="120" />
    <!-- Outbound HttpClient timeout / Polly retry / circuit-breaker for external API calls. -->
    <add key="HttpClientTimeoutSeconds" value="30" />
    <add key="HttpClientRetryCount" value="3" />
    <add key="HttpClientCircuitBreakerFailures" value="5" />
    <add key="HttpClientCircuitBreakerDurationSeconds" value="30" />
    <!-- ========== Observability (logging, metrics, tracing) ========== -->
    <!-- true = log completed MVC requests (NLog → AppLogs DB when file logging is off). -->
    <add key="EnableRequestLogging" value="true" />
    <!-- true = collect application metrics (OpenTelemetry / in-process counters). -->
    <add key="EnableMetrics" value="true" />
    <!-- true = enable distributed tracing Activities. Exporters stay idle until OtlpEndpoint / Azure Monitor is set. -->
    <add key="EnableTracing" value="true" />
    <!-- OTLP collector URL (e.g. http://localhost:4317). Empty = no OTLP export. Prefer env OTEL_EXPORTER_OTLP_ENDPOINT in deploy. -->
    <add key="OtlpEndpoint" value="" />
    <!-- Trace sampling ratio 0.0–1.0 (1.0 = sample everything; lower in high-traffic production). -->
    <add key="SamplingRatio" value="1.0" />
    <!-- true = export telemetry to Azure Monitor / Application Insights via OpenTelemetry. -->
    <add key="EnableAzureMonitorExporter" value="false" />
    <!-- Service name reported in traces/metrics. -->
    <add key="OtelServiceName" value="EImece" />
    <!-- Deployment environment label (e.g. Development, Staging, Production). Empty = unset. -->
    <add key="OtelDeploymentEnvironment" value="" />
    <!-- true = log Entity Framework SQL (NLog EntityFramework.Sql → database). Can be noisy; often false in production. -->
    <add key="EnableEfSqlLogging" value="true" />
    <!-- true = light EF Activities/metrics without dumping full SQL text. -->
    <add key="EnableEfTelemetry" value="true" />
    <!-- Application Insights connection string. Prefer env APPLICATIONINSIGHTS_CONNECTION_STRING. Never commit secrets. -->
    <add key="APPLICATIONINSIGHTS_CONNECTION_STRING" value="" />

  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8.1" />
      </system.Web>
  -->
  <system.web>
    <trust level="Full" />
    <globalization culture="tr-TR" uiCulture="tr-TR" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <customErrors mode="Off" />
    <!-- Use Off / ExposeDetailedErrors=true for local stack traces. Production: RemoteOnly + ExposeDetailedErrors=false. -->
    <compilation targetFramework="4.8.1" debug="true">
      <assemblies>
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8.1" maxUrlLength="2024" maxRequestLength="51200" enableVersionHeader="false" executionTimeout="600" />
    <httpModules>
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" />
      <add name="CorrelationIdHttpModule" type="EImece.Infrastructure.CorrelationIdHttpModule, EImece" />
      <add name="SecurityHeadersHttpModule" type="EImece.Infrastructure.SecurityHeadersHttpModule, EImece" />
    </httpModules>
    <pages>
      <namespaces>
        <add namespace="GridMvc" />
      </namespaces>
    </pages>
    <caching>
      <outputCache omitVaryStar="true" />
      <outputCacheSettings>
        <outputCacheProfiles>
          <!-- Cache the 400 Bad Request route for a day. -->
          <add name="BadRequest" duration="86400" location="Any" varyByParam="none" />
          <!-- Cache the 403 Forbidden route for a day. -->
          <add name="Forbidden" duration="86400" location="Any" varyByParam="none" />
          <!-- Cache the 405 Method Not Allowed route for a day. -->
          <add name="MethodNotAllowed" duration="86400" location="Any" varyByParam="none" />
          <!-- Cache the 404 Not Found route for a day. -->
          <add name="NotFound" duration="86400" location="Any" varyByParam="none" />
          <!-- Cache the 401 Unauthorized route for a day. -->
          <add name="Unauthorized" duration="86400" location="Any" varyByParam="none" />
          <!-- Cache the 500 Internal Server Error route for a day. -->
          <add name="InternalServerError" duration="86400" location="Any" varyByParam="none" />
          <add name="ShortCache" duration="60" varyByParam="*" />
          <add name="ShortCacheUserDependency" duration="60" varyByParam="*" varyByCustom="User" />
          <add name="Cache20Minutes" duration="1200" varyByParam="*" location="Any" varyByCustom="User" />
          <add name="Cache10Minutes" duration="600" varyByParam="*" location="Any" varyByCustom="User" />
          <add name="Cache1Hour" duration="3600" varyByParam="*" location="Any" />
          <!-- "3600"  -->
          <add name="Cache10Days" duration="864000" varyByParam="*" location="Any" />
          <!-- 864000-->
          <add name="Cache30Days" duration="2592000" varyByParam="*" location="Any" />
          <add name="ImageProxyCaching" duration="6000" varyByParam="*" location="Client" />
        </outputCacheProfiles>
      </outputCacheSettings>
    </caching>
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true">
      <remove name="BundleModule" />
      <add name="BundleModule" type="System.Web.Optimization.BundleModule" />
      <remove name="FormsAuthentication" />
      <remove name="ApplicationInsightsWebTracking" />
      <add name="ApplicationInsightsWebTracking" type="Microsoft.ApplicationInsights.Web.ApplicationInsightsHttpModule, Microsoft.AI.Web" preCondition="managedHandler" />
      <add name="CorrelationIdHttpModule" type="EImece.Infrastructure.CorrelationIdHttpModule, EImece" preCondition="managedHandler" />
      <add name="SecurityHeadersHttpModule" type="EImece.Infrastructure.SecurityHeadersHttpModule, EImece" preCondition="managedHandler" />
    </modules>
    <staticContent>
      <clientCache cacheControlCustom="public" cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
    </staticContent>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <httpProtocol>
      <customHeaders>
        <clear />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0" />
