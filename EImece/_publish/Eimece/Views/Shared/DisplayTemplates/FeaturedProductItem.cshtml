@model EImece.Domain.Entities.Product
@using EImece.Domain.Helpers.Extensions;
@using EImece.Domain.Helpers;
@using EImece.Domain;
@using Resources;
@{
    var productFiles = Model.ProductFiles;
    var product = Model;
    var categoryName = product.ProductCategory.Name;
    var isUserAuthenticated = User.Identity.IsAuthenticated && AppConfig.IsEditLinkEnable;
    int Width = ViewData["Width"].ToInt(0);
    int Height = ViewData["Height"].ToInt(0);
    var mainImageImgSrcUrl = product.GetCroppedImageUrl(product.MainImageId, Width, Height);
    var srcset = product.MainImageId.HasValue
        ? product.GetResponsiveImageSrcSet(product.MainImageId.Value, Width, Height)
        : string.Empty;
    var productLink = product.DetailPageAbsoluteUrl;
    var shortDesc = GeneralHelper.GetDescriptionWithBody(product.ShortDescription,100);
    var productPriceEnabled = ViewBag.IsProductPriceEnable == null || (bool)ViewBag.IsProductPriceEnable;
}

<!-- Product-->
<div class="col-lg-3 col-sm-4 col-6 border border-collapse">
    <div class="product-card">
        <div class="product-thumb">
            <a class="product-thumb-link" href="@productLink" aria-label="@product.Name">
                <img src="@mainImageImgSrcUrl"
                     srcset="@srcset"
                     sizes="(max-width: 575px) 45vw, (max-width: 991px) 33vw, 278px"
                     width="@(Width > 0 ? Width : 278)"
                     height="@(Height > 0 ? Height : 278)"
                     alt="@product.Name"
                     loading="lazy"
                     decoding="async" />
            </a>
        </div>
        <div class="product-card-body">
            <div class="d-flex flex-wrap justify-content-between pb-1">
                <a class="product-meta" href="@product.ProductCategory.DetailPageUrl">@product.ProductCategory.Name</a>
                @if (product.Rating > 0)
                {
                    <div class="star-rating" aria-label="@product.Rating stars">
                        @for (int i = 0; i < product.Rating; i++)
                        {
                            <i class="sr-star active" data-feather="star" aria-hidden="true"></i>
                        }
                    </div>
                }
            </div>
            <h3 class="product-card-title"><a href="@productLink">@product.Name</a></h3>
            @if (productPriceEnabled && @product.PriceWithDiscount > 0)
            {
                <span class="text-primary">@product.PriceWithDiscount.CurrencySign()</span>
            }
        </div>
        <div class="product-card-body body-hidden pt-2">
            @if (productPriceEnabled && product.IsBuyableState)
            {
                <button class="btn btn-primary btn-sm btn-block" data-add-product-cart="@Model.ModifiedId" type="button"
                        data-toggle="toast" data-target="#cart-toast">
                    @Resource.AddToCart
                </button>
            }
            @if (!string.IsNullOrEmpty(shortDesc))
            {
                <ul class="font-size-sm opacity-80 pl-4 pt-2 mb-2">
                    <li>@shortDesc</li>
                </ul>
            }
        </div>
    </div>
</div>
