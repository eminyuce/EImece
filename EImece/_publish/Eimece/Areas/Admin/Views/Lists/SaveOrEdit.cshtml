@model EImece.Domain.Entities.List
@using EImece.Domain.Models.Enums;
@using EImece.Domain.Helpers.Extensions;
@using Resources;

@{
    var saveButtonText = AdminResource.SaveButtonText;
    ViewBag.Title = AdminResource.ProductSpecTemplateItemList;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var itemText = Model.GetListItemText();
}

<h2>@AdminResource.ProductSpecTemplateItemList</h2>
<hr class="adminLine" />

@{ ViewData["HelpId"] = "listsHelp"; }
@Html.Partial("_AdminHelpAccordionStart")
<ul style="margin-top: 0;">
    <li>Bu sayfada ürün özelliklerinde kullanılan <strong>açılır menü seçeneklerini</strong> oluşturur veya düzenlersiniz (renk, beden vb.).</li>
    <li><strong>İsim</strong>: Listenin adı. Ürün şablonundaki <code>values="..."</code> değeriyle <strong>birebir aynı</strong> olmalıdır (ör. İsim = <code>Renkler</code> → şablonda <code>values="Renkler"</code>).</li>
    <li><strong>Yayında mı</strong>: İşaretliyse liste kullanılabilir.</li>
    <li><strong>Şablon değer listesi</strong>: Ürün şablonlarında açılır menü kaynağı olarak kullanmak için işaretleyin.</li>
    <li><strong>Hizmet listesi</strong>: Bu liste bir hizmet türü içinse işaretleyin; ürün özellikleri için genelde boş bırakın.</li>
    <li><strong>Sırası</strong>: Listelerin görünme sırası; küçük sayı önce gelir.</li>
    <li><strong>Liste öğeleri</strong>: Her satıra bir seçenek yazın. İsterseniz <code>Görünen metin, değer</code> biçiminde virgülle ayırın. Sadece metin yazarsanız ikisi de aynı olur.</li>
</ul>

<p style="margin-top: 12px; margin-bottom: 6px;"><strong>Örnek 1 — Renkler listesi</strong> (İsim: <code>Renkler</code>, Şablon değer listesi işaretli):</p>
<pre style="background:#f9f9f9; border:1px solid #cce5ff; padding:10px; margin-bottom:12px; white-space:pre-wrap;">Kırmızı, kirmizi
Mavi, mavi
Siyah, siyah
Beyaz, beyaz
Yeşil, yesil</pre>

<p style="margin-bottom: 6px;"><strong>Örnek 2 — Bedenler listesi</strong> (İsim: <code>Bedenler</code>, Şablon değer listesi işaretli):</p>
<pre style="background:#f9f9f9; border:1px solid #cce5ff; padding:10px; margin-bottom:0; white-space:pre-wrap;">XS
S
M
L
XL
XXL</pre>
<p style="margin-top: 8px; margin-bottom: 0; font-size: 12px;">
    Şablonda kullanım: <code>&lt;dropdown name="Renk" values="Renkler" /&gt;</code> veya <code>&lt;dropdown name="Beden" values="Bedenler" /&gt;</code>
</p>
@Html.Partial("_AdminHelpAccordionEnd")

@using (Html.BeginForm())
{
@Html.AntiForgeryToken()

<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "alert alert-success" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.CreatedDate)
    @Html.HiddenFor(model => model.UpdatedDate)

    <div class="form-group">
        @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", placeholder = "Örn: Renkler" } })
            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.IsActive, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <div class="checkbox">
                <label>
                    @Html.EditorFor(model => model.IsActive)
                    Liste aktif olsun
                </label>
                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.IsService, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <div class="checkbox">
                <label>
                    @Html.EditorFor(model => model.IsService)
                    Bu bir hizmet listesidir
                </label>
                @Html.ValidationMessageFor(model => model.IsService, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.IsValues, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <div class="checkbox">
                <label>
                    @Html.EditorFor(model => model.IsValues)
                    Ürün şablonunda açılır menü olarak kullan
                </label>
                @Html.ValidationMessageFor(model => model.IsValues, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Position, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Position, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Position, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <label class="control-label col-md-2" for="itemText">Liste öğeleri</label>
        <div class="col-md-10">
            <span class="help-block" style="margin-top:0;">Her satıra bir öğe yazın. İsterseniz görünen metin ile değeri virgülle ayırın: <code>Kırmızı, kirmizi</code></span>
            @Html.TextAreaFor(m => itemText, new { cols = 50, rows = 10, @class = "form-control", id = "itemText", placeholder = "Kırmızı, kirmizi&#10;Mavi, mavi&#10;Siyah, siyah" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="@saveButtonText" class="btn btn-success btn-block" />
        </div>
    </div>

    @if (Model.ListItems != null && Model.ListItems.Any())
    {
        <div class="form-group">
            <label class="control-label col-md-2">Kayıtlı öğeler</label>
            <div class="col-md-10">
                <ul class="list-unstyled" style="margin-bottom:0;">
                    @foreach (var item in Model.ListItems.OrderBy(i => i.Position))
                    {
                        <li>Metin: <strong>@(item.Name)</strong>, Değer: <strong>@(item.Value)</strong>, Sıra: @(item.Position)</li>
                    }
                </ul>
            </div>
        </div>
    }
</div>
}

<div class="form-horizontal">
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            @Html.ActionLink("Liste sayfasına dön", "Index", null, new { @class = "btn btn-default btn-block" })
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
