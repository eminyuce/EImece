@model EImece.Domain.Models.AdminModels.DataSetReportViewModel
@using System.Collections.Generic
@using System.Data
@using EImece.Domain.Helpers
@{
    ViewBag.Title = "Fiyat Analizi";
    ViewBag.ReportDescription = "Ürün fiyat dağılımını minimum/maksimum fiyat ve kategori filtreleriyle gösterir.";
    ViewBag.ReportKey = "PriceAnalysis";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    bool hasData = false;
    DataTable firstTable = null;
    if (Model != null && Model.ReportData != null)
    {
        foreach (DataTable table in Model.ReportData.Tables)
        {
            if (table != null && table.Rows.Count > 0)
            {
                hasData = true;
                if (firstTable == null)
                {
                    firstTable = table;
                }
            }
        }
        if (firstTable == null && Model.ReportData.Tables.Count > 0)
        {
            firstTable = Model.ReportData.Tables[0];
        }
    }

    ViewBag.HasData = hasData;
    ViewBag.EmptyMessage = "Seçilen fiyat aralığı veya kategori için veri bulunamadı. Filtreleri değiştirerek tekrar deneyin.";

    var exportFilters = new Dictionary<string, object>();
    if (Model != null)
    {
        if (Model.MinPrice.HasValue)
        {
            exportFilters["minPrice"] = Model.MinPrice.Value;
        }
        if (Model.MaxPrice.HasValue)
        {
            exportFilters["maxPrice"] = Model.MaxPrice.Value;
        }
        if (Model.ProductCategoryId.HasValue)
        {
            exportFilters["productCategoryId"] = Model.ProductCategoryId.Value;
        }
    }
    ViewBag.ExportFilters = exportFilters;
}

@Html.Partial("_ReportHeader")
@Html.Partial("_ReportExportButtons")

<div class="panel panel-default report-filter-panel">
    <div class="panel-heading">Filtreler</div>
    <div class="panel-body">
        @using (Html.BeginForm("PriceAnalysis", "Report", FormMethod.Post, new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ReportActionName)

            <div class="report-filter-row">
                <div class="report-filter-field">
                    <div class="form-group">
                        @Html.LabelFor(m => m.MinPrice, "Minimum Fiyat")
                        @Html.TextBoxFor(m => m.MinPrice, new { @class = "form-control", type = "number", step = "0.01" })
                        @Html.ValidationMessageFor(m => m.MinPrice, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="report-filter-field">
                    <div class="form-group">
                        @Html.LabelFor(m => m.MaxPrice, "Maksimum Fiyat")
                        @Html.TextBoxFor(m => m.MaxPrice, new { @class = "form-control", type = "number", step = "0.01" })
                        @Html.ValidationMessageFor(m => m.MaxPrice, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="report-filter-field">
                    <div class="form-group">
                        @Html.LabelFor(m => m.ProductCategoryId, "Kategori Id")
                        @Html.TextBoxFor(m => m.ProductCategoryId, new { @class = "form-control", type = "number" })
                        @Html.ValidationMessageFor(m => m.ProductCategoryId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="report-filter-field report-filter-actions">
                    <div class="form-group">
                        <label>&nbsp;</label>
                        <div>
                            <button type="submit" class="btn btn-primary">Raporu Getir</button>
                        </div>
                    </div>
                </div>
            </div>

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        }
    </div>
</div>

@if (hasData && firstTable != null)
{
    @Html.Partial("_ReportKpis", firstTable)
    ViewBag.ReportTableTitle = "Sonuçlar";
    @Html.Partial("_ReportDataTable", firstTable)
}
else
{
    @Html.Partial("_ReportEmptyState")
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
