@model System.Data.DataTable
@{
    ViewBag.Title = "Dolandırıcılık Analizi";
    ViewBag.ReportDescription = "Şüpheli veya fraud işaretli siparişleri listeler.";
    ViewBag.ReportKey = "FraudAnalysis";
    ViewBag.HasData = Model != null && Model.Rows.Count > 0;
    ViewBag.EmptyMessage = "Bu rapor için henüz veri bulunamadı.";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

@Html.Partial("_ReportHeader")
@Html.Partial("_ReportExportButtons")

@if (ViewBag.HasData)
{
    @Html.Partial("_ReportKpis", Model)
    @Html.Partial("_ReportDataTable", Model)
}
else
{
    @Html.Partial("_ReportEmptyState")
}
