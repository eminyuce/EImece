@{
    var helpId = (ViewData["HelpId"] as string) ?? "adminHelp";
    var helpTitle = (ViewData["HelpTitle"] as string) ?? "Nasıl kullanılır?";
    var accordionId = helpId + "Accordion";
    var collapseId = helpId + "Collapse";
}
<div class="panel-group" id="@accordionId" style="margin-bottom: 15px;">
    <div class="panel panel-info">
        <div class="panel-heading">
            <h4 class="panel-title">
                <a data-toggle="collapse" data-parent="#@accordionId" href="#@collapseId" class="collapsed" aria-expanded="false">
                    <span class="glyphicon glyphicon-question-sign"></span>
                    @helpTitle <small>(açmak / kapatmak için tıklayın)</small>
                </a>
            </h4>
        </div>
        <div id="@collapseId" class="panel-collapse collapse">
            <div class="panel-body">
