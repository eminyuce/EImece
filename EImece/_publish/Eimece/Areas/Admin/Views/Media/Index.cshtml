@using EImece.Domain.Entities;
@using EImece.Domain.Models.AdminModels;
@using EImece.Domain.Helpers;
@using GridMvc.Html
@using GridMvc.Sorting
@using EImece.Domain;
@using EImece.Domain.Helpers.Extensions;
@using Resources;
@model MediaAdminIndexModel

@{
    ViewBag.Title = AdminResource.FileUploadingPage;
    var baseContent = Model.BaseContent;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    int pageSizeNumber = AppConfig.GridPageSizeNumber;
    int gridPage = Request.QueryString["grid-page"].ToInt();
    var rowIndex = gridPage == 0 ? 0 : AppConfig.GridPageSizeNumber * (gridPage - 1);  

    var controllerName = "Media";
    var title = AdminResource.Medias;
    var gridName = "MediaGrid";
    var contents = Model.FileStorages;
    var baseList = contents.DownCasting<FileStorage>();

    var gridImagesText = AdminResource.GridImagesText;
    var gridEditText = AdminResource.GridEditText;
    var gridDeleteText = AdminResource.GridDeleteText;
    var gridDetailText = AdminResource.GridDetailText;

    var filesHelper = DependencyResolver.Current.GetService<FilesHelper>();
    filesHelper.InitFilesMediaFolder();

}
<style>
    .myslider {
        width: 3em;
        height: 1.6em;
        top: 50%;
        margin-top: -.8em;
        text-align: center;
        line-height: 1.6em;
    }
</style>

<div class="form-horizontal">

    @Html.Partial("_pBackButtonLink", Model)
</div>

@Html.HiddenFor(r => Model.Id)
@Html.HiddenFor(r => Model.ImageType)
@Html.HiddenFor(r => Model.MediaMod)
@Html.HiddenFor(r => Model.Lang)
<!-- Warning Alert -->
<div class="alert alert-info">
    <strong>@AdminResource.WarningForDesign</strong>
</div>
<!-- blueimp File Upload & Gallery styles -->
@Styles.Render("~/Content/jQuery-File-Upload")

<script>
    var $form = null;

    $('#fileupload').addClass('fileupload-processing');
    $(function () {

        $form = $('#fileupload').fileupload({
            dataType: 'json',
            messages: {
                maxNumberOfFiles: '@AdminResource.FileUploadMaxNumberOfFiles',
                acceptFileTypes: '@AdminResource.FileUploadAcceptFileTypes',
                maxFileSize: '@AdminResource.FileUploadMaxFileSize',
                minFileSize: '@AdminResource.FileUploadMinFileSize'
            }
        });
        $('#fileupload').bind('fileuploadsubmit', function (e, data) {

            console.log($("#sliderHeight").slider("option", "value") + "  " + $("#sliderWidth").slider("option", "value"));
            data.formData = {
                contentId: $("#Id").val(),
                imageType: $("#ImageType").val(),
                mod: $("#MediaMod").val(),
                imageHeight: $("#sliderHeight").slider("option", "value"),
                imageWidth: $("#sliderWidth").slider("option", "value"),
                selectedTags: GetSelectedTag()
            }
        });

        $("#target").click(function () {
            console.log(GetSelectedTag());
        });
        function GetSelectedTag() {
            var arr = [];
            $('[data-image-tag]').each(function () {
                var m = $(this).is(':checked');
                if (m) {
                    arr.push($(this).val());
                }
            });

            return arr;
        }
        CreateTags();
        function CreateTags() {
            var postData = JSON.stringify({ "language": $("#Lang").val() });
            console.log(postData);
            ajaxMethodCall(postData, "/admin/Ajax/GetTags", function (data) {
                $("#imageTagsHtml").html(data);
            });
        }

    });
</script>

<div class="panel with-nav-tabs panel-default">
    <div class="panel-heading">
        <ul class="nav nav-tabs">
            <li class="active"><a href="#tab1default" data-toggle="tab">@AdminResource.FileUploadingSection</a></li>
            <li><a href="#tab2default" data-toggle="tab">@AdminResource.UploadedFilesSection</a></li>
        </ul>
    </div>
    <div class="panel-body">
        <div class="tab-content">
            <div class="tab-pane fade in active" id="tab1default">
                <table style="width: 100%;">
                    <tr>
                        <td style="width: 20%; vertical-align: top;">
                            <h5><strong>@AdminResource.Tags</strong></h5>
                            <div id="imageTagsHtml">
                                <!-- Tag checkboxes will load here -->
                            </div>
                        </td>
                        <td style="width: 80%; vertical-align: top;">
                            <div>
                                @Html.Partial("pSliderResizing", baseContent)
                            </div>
                            @Html.Partial("_Files")
                        </td>
                    </tr>
                </table>
            </div>
            <div class="tab-pane fade" id="tab2default">

                @Html.Partial("pGridOperations", new ViewDataDictionary(ViewData){
            {"controllerName",controllerName}
           ,{"StateTypes","State"}
           ,{"IsNewRecordButtonEnabled",false}
           ,{"IsSearchFormEnabled",false}
           ,{"orderingButton",true}
           ,{"selectAll",true}
           ,{"deleteAll",true}
           ,{"ProductState",false}
            ,{"SetStateOnOrOff",true}})

                <div class="panel panel-primary">
                   
                    @Html.Partial("pGridDropDown", baseList)
                    @Html.Grid(contents).Named(gridName).Columns(columns =>
               {

                   columns.Add() 
          .Encoded(false)
                       .Sanitized(false)
           .RenderValueAs(_ => string.Format("<span class='badge badge-primary badge-pill' style='font-size: 1.5em; padding: 0.5rem 1rem;'>{0}</span>", ++rowIndex));

                   columns.Add().Encoded(false).
                           Sanitized(false)
                                          .RenderValueAs(d => Html.Partial("pGridCheckbox",
                                          new ViewDataDictionary(ViewData){
            // DeleteMediaGridItem / FileStorageService.DeleteBaseEntity expects:
            // fileStorageId-contentId-mod-imageType
            {"ItemId", String.Format("{0}-{1}-{2}-{3}", d.Id, Model.Id, Model.MediaMod, Model.ImageType)}}));

                   columns.Add(o => o.Id, true);

                   columns.Add()
                       .Encoded(false)
                       .Sanitized(false)
                     .RenderValueAs(d => GridToolsColumn(d, controllerName));

                   columns.Add()
                     .Encoded(false)
                     .Sanitized(false)
                     .RenderValueAs(d => ImageLinkColumn(d, filesHelper));

                   columns.Add(o => o.Position).Titled(AdminResource.Position)
                     .Encoded(false).
                          Sanitized(false).
                          SetWidth(10).
                          RenderValueAs(o => String.Format("<input   gridkey-id='{0}' value='{1}'   class='GridOrderingTextbox input-xs' name='gridOrdering' type='type'>", o.Id, o.Position));

                   columns.Add(o => o.IsActive)
                              .Titled(AdminResource.IsActive)
                          .Sortable(true)
                          .SortInitialDirection(GridSortDirection.Descending).Encoded(false).
                           Sanitized(false)
                          .RenderValueAs(o => String.Format("<span  gridkey-id='{0}' grid-data-value='{2}' {1}   name='spanState'> </span>",
                                                            o.Id, (o.IsActive ? Constants.OkStyle : Constants.CancelStyle), o.IsActive));

                   columns.Add(o => o.UpdatedDate)
                              .Titled(AdminResource.UpdatedDate)
                          .Sortable(true)
                          .Css("gridDateClass")
                          .RenderValueAs(o => o.UpdatedDate != null ? String.Format("{0}", o.UpdatedDate.ToShortDateString()) : null)
                          .SortInitialDirection(GridSortDirection.Descending);

               }).SetRowCssClasses(item => item.IsActive ? string.Empty : "GridIsActive").WithPaging(pageSizeNumber).Sortable().Filterable().WithMultipleFilters().Selectable(false)
                </div>
            </div>
        </div>
    </div>
</div>

@Scripts.Render("~/bundles/jQuery-File-Upload")

@helper ImageLinkColumn(FileStorage fileStorage, FilesHelper fileHelper)
{
    var imageSizes = fileHelper.GetThumbnailImageSize(fileStorage);
    var fullImageUrl = String.Format("../..{1}{0}", fileStorage.FileName, Constants.UrlBase);
    var thumbImageUrl = String.Format("../..{1}thumbs/thb{0}", fileStorage.FileName, Constants.UrlBase);
    var downloadUrl = String.Format("/media/images/{0}", fileStorage.FileName);
<div class="media-file-preview">
    <div class="media-file-preview-thumb">
        <a href="@downloadUrl" title="@fileStorage.FileName" download="@fileStorage.FileName" data-gallery="">
            <img src="@fileStorage.GetAdminCroppedImageUrl(150,0)" alt="@fileStorage.FileName" />
        </a>
        <div class="media-file-preview-name">@fileStorage.FileName</div>
    </div>
    <div class="media-file-preview-meta">
        <div>
            @String.Format(AdminResource.OriginalWidthHeightFormat, imageSizes.OriginalWidth, imageSizes.OriginalHeight)
            <a href="@fullImageUrl" target="_blank">@AdminResource.FullImage</a>
        </div>
        <div>
            @String.Format(AdminResource.ThumbsWidthHeightFormat, imageSizes.Width, imageSizes.Height)
            <a href="@thumbImageUrl" target="_blank">@AdminResource.ThumbsImage</a>
        </div>
    </div>
</div>
}

@helper GridToolsColumn(FileStorage d, String controllerName)
{

<div class="gridToolBox">
    @if (UserRoleHelper.IsDeletedEnableRoles())
        {
    <span>
        @Html.Partial("pDeleteModal", new ViewDataDictionary(ViewData) {
         { "ItemId", d.Id },
         {"controllerName",controllerName},
        {"gridDeleteText", AdminResource.Remove},
         { "ItemDescription", d.Name } })
    </span>
        }
</div>
}