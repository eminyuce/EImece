@using System.Globalization
@using System.Web
@using EImece.Domain
@using EImece.Domain.Entities
@using EImece.Domain.Helpers
@using EImece.Domain.Helpers.Extensions
@using EImece.Domain.Models.Enums
@using Resources

@model Order

@{
    ViewBag.Title = AdminResource.OrderDetails + " - #" + (Model != null ? Model.OrderNumber : "");
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    var tr = CultureInfo.GetCultureInfo("tr-TR");
    var orderStatus = (EImeceOrderStatus)Model.OrderStatus;
    var orderStatusList = EImece.Domain.Helpers.EnumHelper.ToSelectList(orderStatus);
    var paymentOk = string.Equals(Model.PaymentStatus, "SUCCESS", StringComparison.OrdinalIgnoreCase);
    var productCount = Model.OrderProducts != null ? Model.OrderProducts.Count : 0;
    var subtotal = Model.Price.ToDecimal() - Model.CargoPrice;
    var couponDiscount = Model.CouponDiscount.ToDecimal();
}

@helper OrderStatusLabel(EImeceOrderStatus status)
{
    string css = "label-default";
    switch (status)
    {
        case EImeceOrderStatus.NewlyOrder:
        case EImeceOrderStatus.PaymentPending:
            css = "label-warning";
            break;
        case EImeceOrderStatus.InProgress:
            css = "label-info";
            break;
        case EImeceOrderStatus.Shipped:
            css = "label-primary";
            break;
        case EImeceOrderStatus.Delivered:
            css = "label-success";
            break;
        case EImeceOrderStatus.Cancelled:
        case EImeceOrderStatus.Returned:
        case EImeceOrderStatus.Refunded:
            css = "label-danger";
            break;
    }
    <span class="label @css order-status-badge">@status.ToDescription()</span>
}

@helper PaymentStatusLabel(string paymentStatus)
{
    var ok = string.Equals(paymentStatus, "SUCCESS", StringComparison.OrdinalIgnoreCase);
    var css = ok ? "label-success" : "label-danger";
    string text = paymentStatus;
    if (string.Equals(paymentStatus, "SUCCESS", StringComparison.OrdinalIgnoreCase))
    {
        text = "Ödeme başarılı";
    }
    else if (string.Equals(paymentStatus, "FAILURE", StringComparison.OrdinalIgnoreCase))
    {
        text = "Ödeme başarısız";
    }
    else if (string.IsNullOrWhiteSpace(paymentStatus))
    {
        text = "Ödeme durumu yok";
        css = "label-default";
    }
    <span class="label @css order-status-badge">@text</span>
}

<div class="order-details-page">
    <div class="clearfix order-details-header">
        <div class="pull-right">
            <a href="@Url.Action("Index", "Orders", new { area = "Admin" })" class="btn btn-default btn-sm">
                <i class="fa fa-arrow-left"></i> Siparişlere Dön
            </a>
        </div>
        <h2>
            Sipariş Detayı
            <small class="text-muted">#@Model.OrderNumber</small>
        </h2>
        <p class="order-details-lead">
            Müşteri, ürün, ödeme ve kargo bilgilerini buradan inceleyebilir; durum, not ve kargo bilgisini güncelleyebilirsiniz.
        </p>
        <div class="order-details-badges">
            @OrderStatusLabel(orderStatus)
            @PaymentStatusLabel(Model.PaymentStatus)
        </div>
    </div>

    <div class="row order-kpi-row">
        <div class="col-sm-3">
            <div class="order-kpi">
                <div class="order-kpi-label">Sipariş tarihi</div>
                <div class="order-kpi-value">@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm", tr)</div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="order-kpi">
                <div class="order-kpi-label">Ödenen tutar</div>
                <div class="order-kpi-value">@Model.PaidPriceDecimal.CurrencySign()</div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="order-kpi">
                <div class="order-kpi-label">Ödeme / kart</div>
                <div class="order-kpi-value">
                    @(string.IsNullOrWhiteSpace(Model.CardAssociation) ? "-" : Model.CardAssociation)
                    @if (!string.IsNullOrWhiteSpace(Model.LastFourDigits))
                    {
                        <small class="text-muted">•••• @Model.LastFourDigits</small>
                    }
                </div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="order-kpi">
                <div class="order-kpi-label">Kargo</div>
                <div class="order-kpi-value">
                    @(string.IsNullOrWhiteSpace(Model.ShipmentCompanyName) ? "Henüz atanmadı" : Model.ShipmentCompanyName)
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-default">
                <div class="panel-heading"><strong>Müşteri ve adres bilgileri</strong></div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <h5 class="order-section-title">Müşteri</h5>
                            @if (Model.Customer != null)
                            {
                                <dl class="dl-horizontal order-dl">
                                    <dt>Ad Soyad</dt>
                                    <dd>@(Model.Customer.FullName ?? "-")</dd>
                                    <dt>E-posta</dt>
                                    <dd>
                                        @if (!string.IsNullOrWhiteSpace(Model.Customer.Email))
                                        {
                                            <a href="mailto:@Model.Customer.Email">@Model.Customer.Email</a>
                                        }
                                        else
                                        {
                                            <text>-</text>
                                        }
                                    </dd>
                                    <dt>Telefon</dt>
                                    <dd>@(Model.Customer.GsmNumber ?? "-")</dd>
                                    @if (!string.IsNullOrWhiteSpace(Model.Customer.IdentityNumber))
                                    {
                                        <dt>TC Kimlik No</dt>
                                        <dd>@Model.Customer.IdentityNumber</dd>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.Customer.Company))
                                    {
                                        <dt>Firma</dt>
                                        <dd>@Model.Customer.Company</dd>
                                    }
                                </dl>
                            }
                            else
                            {
                                <p class="text-muted">Müşteri kaydı bulunamadı.</p>
                            }
                        </div>
                        <div class="col-sm-6">
                            <h5 class="order-section-title">Teslimat adresi</h5>
                            @if (Model.ShippingAddress != null)
                            {
                                <address class="order-address">
                                    @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.Name))
                                    {
                                        <strong>@Model.ShippingAddress.Name</strong><br />
                                    }
                                    @Model.ShippingAddress.Description<br />
                                    @Model.ShippingAddress.City
                                    @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.Country))
                                    {
                                        <text>/ @Model.ShippingAddress.Country</text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress.ZipCode))
                                    {
                                        <text> @Model.ShippingAddress.ZipCode</text>
                                    }
                                </address>
                            }
                            else
                            {
                                <p class="text-muted">Teslimat adresi yok.</p>
                            }

                            <h5 class="order-section-title">Fatura adresi</h5>
                            @if (Model.BillingAddress != null && Model.ShippingAddress != null && Model.BillingAddress.EqualsAddress(Model.ShippingAddress))
                            {
                                <p class="text-muted">Teslimat adresi ile aynı.</p>
                            }
                            else if (Model.BillingAddress != null)
                            {
                                <address class="order-address">
                                    @if (!string.IsNullOrWhiteSpace(Model.BillingAddress.Name))
                                    {
                                        <strong>@Model.BillingAddress.Name</strong><br />
                                    }
                                    @Model.BillingAddress.Description<br />
                                    @Model.BillingAddress.City
                                    @if (!string.IsNullOrWhiteSpace(Model.BillingAddress.Country))
                                    {
                                        <text>/ @Model.BillingAddress.Country</text>
                                    }
                                </address>
                            }
                            else
                            {
                                <p class="text-muted">Fatura adresi yok.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>Sipariş ürünleri</strong>
                    <span class="badge">@productCount</span>
                </div>
                <div class="panel-body" style="padding:0;">
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover mb-0 order-products-table">
                            <thead>
                                <tr>
                                    <th>Ürün</th>
                                    <th class="text-center" style="width:80px;">Adet</th>
                                    <th class="text-right" style="width:110px;">Birim fiyat</th>
                                    <th class="text-right" style="width:110px;">Toplam</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.OrderProducts != null && Model.OrderProducts.Any())
                                {
                                    foreach (var product in Model.OrderProducts)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@product.ProductName</strong>
                                                @if (!string.IsNullOrWhiteSpace(product.ProductCode))
                                                {
                                                    <br /><small class="text-muted">Kod: @product.ProductCode</small>
                                                }
                                            </td>
                                            <td class="text-center">@product.Quantity</td>
                                            <td class="text-right">@product.ProductSalePrice.CurrencySign()</td>
                                            <td class="text-right"><strong>@product.TotalPrice.CurrencySign()</strong></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">Bu siparişte ürün kaydı yok.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-right">Ara toplam</td>
                                    <td class="text-right">@subtotal.CurrencySign()</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-right">Kargo</td>
                                    <td class="text-right">@Model.CargoPrice.CurrencySign()</td>
                                </tr>
                                @if (!string.IsNullOrWhiteSpace(Model.Coupon))
                                {
                                    <tr>
                                        <td colspan="3" class="text-right">Kupon (@Model.Coupon)</td>
                                        <td class="text-right text-danger">-@couponDiscount.CurrencySign()</td>
                                    </tr>
                                }
                                <tr class="order-total-row">
                                    <td colspan="3" class="text-right"><strong>Ödenen toplam</strong></td>
                                    <td class="text-right"><strong>@Model.PaidPriceDecimal.CurrencySign()</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>Ödeme ve kart bilgileri</strong>
                    <a class="btn btn-link btn-xs pull-right" role="button" data-toggle="collapse" href="#paymentTechDetails">Teknik detayları göster</a>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <dl class="dl-horizontal order-dl">
                                <dt>Ödeme durumu</dt>
                                <dd>@PaymentStatusLabel(Model.PaymentStatus)</dd>
                                <dt>Kart tipi</dt>
                                <dd>@(Model.CardType ?? "-")</dd>
                                <dt>Kart markası</dt>
                                <dd>@(Model.CardAssociation ?? "-")</dd>
                                <dt>Kart ailesi</dt>
                                <dd>@(Model.CardFamily ?? "-")</dd>
                                <dt>Son 4 hane</dt>
                                <dd>@(Model.LastFourDigits ?? "-")</dd>
                                @if (!string.IsNullOrWhiteSpace(Model.Installment) && Model.Installment != "1")
                                {
                                    <dt>Taksit</dt>
                                    <dd>@Model.InstallmentDescription</dd>
                                }
                            </dl>
                        </div>
                        <div class="col-sm-6">
                            <dl class="dl-horizontal order-dl">
                                <dt>Ödeme no</dt>
                                <dd><code>@(Model.PaymentId ?? "-")</code></dd>
                                <dt>Para birimi</dt>
                                <dd>@(Model.Currency ?? "-")</dd>
                                @if (!string.IsNullOrWhiteSpace(Model.ErrorCode) || !string.IsNullOrWhiteSpace(Model.ErrorMessage))
                                {
                                    <dt>Hata</dt>
                                    <dd class="text-danger">
                                        @Model.ErrorCode
                                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                                        {
                                            <br />@Model.ErrorMessage
                                        }
                                    </dd>
                                }
                            </dl>
                        </div>
                    </div>

                    <div id="paymentTechDetails" class="collapse">
                        <hr />
                        <p class="text-muted"><small>Bu alan teknik destek ve ödeme sağlayıcı kontrolleri içindir.</small></p>
                        <div class="row">
                            <div class="col-sm-6">
                                <dl class="dl-horizontal order-dl">
                                    <dt>Conversation</dt>
                                    <dd><code>@(Model.ConversationId ?? "-")</code></dd>
                                    <dt>Sepet ID</dt>
                                    <dd><code>@(Model.BasketId ?? "-")</code></dd>
                                    <dt>Token</dt>
                                    <dd><code>@(Model.Token ?? "-")</code></dd>
                                    <dt>BIN</dt>
                                    <dd>@(Model.BinNumber ?? "-")</dd>
                                </dl>
                            </div>
                            <div class="col-sm-6">
                                <dl class="dl-horizontal order-dl">
                                    <dt>Komisyon (işyeri)</dt>
                                    <dd>@(Model.MerchantCommissionRateAmount.ToDecimal().CurrencySign())</dd>
                                    <dt>Iyzico komisyon</dt>
                                    <dd>@(Model.IyziCommissionRateAmount.ToDecimal().CurrencySign())</dd>
                                    <dt>Iyzico ücret</dt>
                                    <dd>@(Model.IyziCommissionFee.ToDecimal().CurrencySign())</dd>
                                    <dt>Auth / Host</dt>
                                    <dd>@(Model.AuthCode ?? "-") / @(Model.HostReference ?? "-")</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-primary">
                <div class="panel-heading"><strong>Siparişi yönet</strong></div>
                <div class="panel-body">
                    <div class="form-group">
                        <label for="orderStatusSelect">Sipariş durumu</label>
                        @Html.DropDownList("orderStatusSelectList",
                            new SelectList(orderStatusList, "Value", "Text", orderStatus.ToString()),
                            new { @class = "form-control", id = "orderStatusSelect", @data_change_order_status = Model.Id })
                        <span class="help-block">Durum değişince otomatik kaydedilir.</span>
                    </div>

                    <div class="form-group">
                        <label for="adminOrderNote">Yönetici notu</label>
                        <textarea id="adminOrderNote" class="form-control" rows="3"
                                  placeholder="Sadece admin panelinde görünür..."
                                  data-textarea-admin-order-note="@Model.Id">@Model.AdminOrderNote</textarea>
                    </div>

                    <div class="form-group">
                        <label for="shipmentCompany">Kargo firması</label>
                        <input id="shipmentCompany" class="form-control" type="text"
                               placeholder="Örn. Yurtiçi Kargo"
                               data-order-shipment-company-name="@Model.Id"
                               value="@Model.ShipmentCompanyName" />
                    </div>

                    <div class="form-group">
                        <label for="shipmentTracking">Takip numarası</label>
                        <div class="input-group">
                            <input id="shipmentTracking" class="form-control" type="text"
                                   placeholder="Kargo takip no"
                                   data-order-shipment-tracking-number="@Model.Id"
                                   value="@Model.ShipmentTrackingNumber" />
                            @if (!string.IsNullOrWhiteSpace(Model.ShipmentTrackingNumber))
                            {
                                <span class="input-group-btn">
                                    <a class="btn btn-default"
                                       href="@string.Format("{0}/{1}", Constants.ShipmentTrackingCompanyLink, HttpUtility.UrlEncode(Model.ShipmentTrackingNumber.ToStr()))"
                                       target="_blank" title="Takibi aç">
                                        <i class="fa fa-external-link"></i>
                                    </a>
                                </span>
                            }
                        </div>
                    </div>

                    <button type="button" class="btn btn-success btn-block" data-save-admin-order-note="@Model.Id">
                        <i class="fa fa-save"></i> Not ve kargoyu kaydet
                    </button>
                    <p class="text-success" style="margin-top:8px;" data-changed-order-result="@Model.Id"></p>
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading"><strong>Müşteri notu</strong></div>
                <div class="panel-body">
                    @if (!string.IsNullOrWhiteSpace(Model.OrderComments))
                    {
                        <p style="white-space:pre-wrap; margin:0;">@Model.OrderComments</p>
                    }
                    else
                    {
                        <p class="text-muted" style="margin:0;">Müşteri sipariş notu bırakmamış.</p>
                    }
                </div>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading"><strong>Özet</strong></div>
                <div class="panel-body">
                    <dl class="dl-horizontal order-dl">
                        <dt>Sipariş no</dt>
                        <dd>@Model.OrderNumber</dd>
                        <dt>Oluşturma</dt>
                        <dd>@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm", tr)</dd>
                        <dt>Ürün tutarı</dt>
                        <dd>@subtotal.CurrencySign()</dd>
                        <dt>Kargo</dt>
                        <dd>@Model.CargoPrice.CurrencySign()</dd>
                        <dt>Ödenen</dt>
                        <dd><strong>@Model.PaidPriceDecimal.CurrencySign()</strong></dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .order-details-page { margin-bottom: 24px; }
        .order-details-header { margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #d9e2ec; }
        .order-details-header h2 { margin-top: 0; margin-bottom: 6px; color: #102a43; font-weight: 600; }
        .order-details-lead { color: #627d98; font-size: 13px; max-width: 720px; margin: 0 0 10px; }
        .order-details-badges .label { margin-right: 6px; font-size: 12px; padding: 5px 10px; }
        .order-kpi-row { margin-bottom: 16px; }
        .order-kpi {
            background: #fff; border: 1px solid #d9e2ec; border-left: 3px solid #62b0e8;
            border-radius: 3px; padding: 12px 14px; min-height: 74px; margin-bottom: 12px;
        }
        .order-kpi-label { color: #627d98; font-size: 11px; font-weight: 600; text-transform: uppercase; margin-bottom: 4px; }
        .order-kpi-value { color: #102a43; font-size: 16px; font-weight: 700; word-break: break-word; }
        .order-section-title { margin-top: 0; margin-bottom: 10px; color: #334e68; font-weight: 600; font-size: 14px; }
        .order-address { margin-bottom: 16px; line-height: 1.45; }
        .order-dl { margin-bottom: 0; }
        .order-dl dt { width: 110px; color: #627d98; font-weight: 600; font-size: 12px; }
        .order-dl dd { margin-left: 120px; margin-bottom: 6px; }
        .order-products-table { margin-bottom: 0; }
        .order-total-row td { background: #f0f4f8; }
        .order-status-badge { display: inline-block; }
        .panel > .panel-heading { background: #f0f4f8; color: #334e68; }
        .panel-primary > .panel-heading { background: #334e68; color: #fff; border-color: #334e68; }
    </style>
}
