<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      netstandard2.0 is consumable by legacy net481 projects and the ASP.NET Core 8 host.
      This project is localization-only (resx); the unused EntityFramework packages.config reference was removed.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Resources</RootNamespace>
    <AssemblyName>Resources</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Keep existing AssemblyInfo.cs for stable assembly identity -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep checked-in *.Designer.cs; do not let SDK regenerate duplicate designers into obj/. -->
    <EmbeddedResource Update="Resource.resx">
      <Generator></Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
      <CustomToolNamespace>Resources</CustomToolNamespace>
      <LogicalName>Resources.Resource.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="AdminResource.resx">
      <Generator></Generator>
      <LastGenOutput>AdminResource.Designer.cs</LastGenOutput>
      <CustomToolNamespace>Resources</CustomToolNamespace>
      <LogicalName>Resources.AdminResource.resources</LogicalName>
    </EmbeddedResource>
    <Compile Update="Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
    <Compile Update="AdminResource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AdminResource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Remove="packages.config" />
    <None Remove="App.config" />
  </ItemGroup>
</Project>
