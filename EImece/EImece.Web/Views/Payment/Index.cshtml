@model EImece.Domain.Core.Cart.CartState
@using Resources
@{
    ViewData["Title"] = "Sepet";
    var notice = TempData["CartNotice"] as string;
}
<div class="container px-3 py-4">
    <h1 class="h3 mb-3">Sepet</h1>
    @if (!string.IsNullOrWhiteSpace(notice))
    {
        <div class="alert alert-info">@notice</div>
    }
    @if (Model.Lines.Count == 0)
    {
        <div class="eimece-shell-card">
            <p>Sepetiniz boş.</p>
            <a class="btn btn-outline-primary" asp-controller="Products" asp-action="SearchProducts">@Resource.Products</a>
        </div>
    }
    else
    {
        <div class="table-responsive eimece-shell-card">
            <table class="table table-sm mb-0 align-middle">
                <thead>
                    <tr><th>Ürün</th><th>Adet</th><th>Birim</th><th>Toplam</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.Name <span class="text-muted small">@line.ProductCode</span></td>
                        <td>
                            <form method="post" asp-action="UpdateQuantity" class="d-flex gap-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@line.ProductId" />
                                <input type="number" name="quantity" value="@line.Quantity" min="1" max="1000" class="form-control form-control-sm" style="width:5rem;" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">OK</button>
                            </form>
                        </td>
                        <td>@line.UnitPrice.ToString("N2") ₺</td>
                        <td>@line.LineTotal.ToString("N2") ₺</td>
                        <td>
                            <form method="post" asp-action="RemoveCart">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@line.ProductId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    @if (Model.DiscountAmount > 0)
                    {
                        <tr><td colspan="3">Ara toplam</td><td colspan="2">@Model.Subtotal.ToString("N2") ₺</td></tr>
                        <tr><td colspan="3">İndirim (@Model.CouponCode)</td><td colspan="2">-@Model.DiscountAmount.ToString("N2") ₺</td></tr>
                    }
                    <tr><th colspan="3">Toplam</th><th colspan="2">@Model.Total.ToString("N2") ₺</th></tr>
                </tfoot>
            </table>
        </div>
        <form method="post" asp-action="ApplyCoupon" class="row g-2 mt-3">
            @Html.AntiForgeryToken()
            <div class="col-auto">
                <input type="text" name="couponCode" value="@Model.CouponCode" class="form-control" placeholder="Kupon kodu" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Kupon uygula</button>
            </div>
        </form>
        <div class="mt-3 d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-action="Checkout">Checkout</a>
            <a class="btn btn-outline-primary" asp-action="CheckoutBillingDetails">Fatura bilgileri</a>
            <form method="post" asp-action="Clear">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">Temizle</button>
            </form>
        </div>
    }
</div>
