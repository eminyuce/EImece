@{
    ViewData["Title"] = ViewData["Title"] ?? "EImece Core Host";
}

<div class="text-center py-4">
    <h1 class="display-5">EImece</h1>
    <p class="lead">ASP.NET Core 8 host (parallel to legacy MVC 5)</p>
    <p><strong>@ViewData["Phase"]</strong></p>
    <p class="text-muted mb-1">Domain: @ViewData["Domain"] · SiteStatus: @ViewData["SiteStatus"]</p>
    <p class="text-muted mb-1">@ViewData["Orm"] · @ViewData["SampleResource"]</p>
    <p>
        <a class="btn btn-primary" href="/health">Health check</a>
    </p>
    <p class="small text-muted mt-4">
        Legacy EF6 domain remains at <code>EImece.Domain</code>. Core data layer: <code>EImece.Domain.Core</code>.
    </p>
</div>
