@{
    ViewData["Title"] = ViewData["Title"] ?? "EImece Core Host";
}

<div class="text-center py-4">
    <h1 class="display-5">EImece</h1>
    <p class="lead">ASP.NET Core 8 host (parallel to legacy MVC 5)</p>
    <p><strong>@ViewData["Phase"]</strong></p>
    <p class="text-muted mb-1">Domain: @ViewData["Domain"] · SiteStatus: @ViewData["SiteStatus"]</p>
    <p class="text-muted mb-1">@ViewData["Orm"] · @ViewData["SampleResource"]</p>
    <p class="text-muted mb-1">@ViewData["AppLayer"]</p>
    <p class="mt-3">
        <a class="btn btn-primary" href="/health">Health</a>
        <a class="btn btn-outline-secondary" href="/p/demo-category/1">Product route</a>
        <a class="btn btn-outline-secondary" href="/c/pc/1">Category route</a>
        <a class="btn btn-outline-secondary" href="/sitemap.xml">Sitemap</a>
        <a class="btn btn-outline-secondary" href="/robots.txt">Robots</a>
        <a class="btn btn-outline-secondary" href="/Admin/Dashboard">Admin</a>
    </p>
</div>
