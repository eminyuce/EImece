@using Resources
@{
    ViewData["Title"] = "EImece";
    ViewData["Description"] = "Open-source e-commerce storefront on ASP.NET Core 8";
}

<section class="eimece-hero">
    <div class="container px-3 py-5">
        <p class="text-uppercase small opacity-75 mb-2">@ViewData["Phase"]</p>
        <h1 class="brand">EImece</h1>
        <p class="lead mb-4">Modern ASP.NET Core storefront shell using the legacy mstore theme assets.</p>
        <div class="d-flex flex-wrap" style="gap: .75rem;">
            <a class="btn btn-primary btn-lg" asp-controller="Products" asp-action="SearchProducts">@Resource.Products</a>
            <a class="btn btn-outline-light btn-lg" href="/c/pc/1">@Resource.ProductCategories</a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Payment" asp-action="Index">Cart</a>
        </div>
    </div>
</section>

<section class="container px-3 py-5">
    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="eimece-shell-card h-100">
                <h3 class="h5">@Resource.Products</h3>
                <p class="text-muted mb-3">SEO routes under <code>/p/...</code> with Detail shell views.</p>
                <a asp-controller="Products" asp-action="SearchProducts">@Resource.Search →</a>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="eimece-shell-card h-100">
                <h3 class="h5">@Resource.Stories</h3>
                <p class="text-muted mb-3">Content routes under <code>/s/...</code> ready for Phase 7+ pages.</p>
                <a asp-controller="Stories" asp-action="Categories">Browse →</a>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="eimece-shell-card h-100">
                <h3 class="h5">Admin</h3>
                <p class="text-muted mb-3">Admin chrome uses <code>adminShell.css</code> + sidebar layout.</p>
                <a asp-controller="Account" asp-action="AdminLogin">Admin login →</a>
            </div>
        </div>
    </div>
</section>
