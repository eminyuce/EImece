@{
    ViewData["Title"] = ViewData["Title"] ?? "EImece";
}

<div class="py-4">
    <h1 class="h3">@ViewData["Title"]</h1>
    <p class="text-muted">@ViewData["Message"]</p>
    @if (ViewData["RouteValues"] is not null)
    {
        <pre class="small bg-light p-3">@ViewData["RouteValues"]</pre>
    }
    <p class="small text-muted mb-0">Phase 6 application-layer shell — presentation polish in Phase 7.</p>
    <p class="mt-3">
        <a class="btn btn-sm btn-outline-primary" href="/">Home</a>
        <a class="btn btn-sm btn-outline-secondary" href="/health">Health</a>
    </p>
</div>
