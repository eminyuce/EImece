@{
    ViewData["Title"] = ViewData["Title"] ?? "EImece";
}

<div class="container px-3 py-4">
    <div class="eimece-shell-card">
        <h1 class="h3">@ViewData["Title"]</h1>
        <p class="text-muted mb-2">@ViewData["Message"]</p>
        @if (ViewData["RouteValues"] is not null)
        {
            <pre class="small bg-light p-3 mb-0">@ViewData["RouteValues"]</pre>
        }
    </div>
</div>
