@using Resources
<form class="flex-grow-1 mx-sm-3 my-2 my-sm-0" method="get" asp-controller="Products" asp-action="SearchProducts">
    <div class="input-group input-group-sm">
        <input class="form-control" type="search" name="q" placeholder="@Resource.SearchProductTextBoxPlaceHolder" aria-label="@Resource.Search" />
        <div class="input-group-append">
            <button class="btn btn-primary" type="submit">@Resource.SearchProductButtonText</button>
        </div>
    </div>
</form>
