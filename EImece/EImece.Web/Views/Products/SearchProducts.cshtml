@using Resources
@{
    ViewData["Title"] = Resource.SearchResults;
    var q = ViewData["Query"] as string;
}

<div class="container px-3 py-4">
    <h1 class="h3 mb-3">@Resource.SearchResults</h1>
    <partial name="_SearchProductForm" />
    <div class="eimece-shell-card mt-3">
        <p class="mb-1">Query: <strong>@(string.IsNullOrWhiteSpace(q) ? "(empty)" : q)</strong></p>
        <p class="text-muted mb-0">Search results UI migrates with Domain.Core product services. Route <code>/p/arama</code> is live.</p>
    </div>
</div>
