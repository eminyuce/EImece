@model EImece.Web.Models.InfoPageViewModel
@{
    ViewData["Title"] = Model.Name;
}
<div class="container px-3 py-4">
    <article class="eimece-shell-card p-4">
        <h1 class="h2 mb-3">@Model.Name</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="info-body">@Html.Raw(Model.Description)</div>
        }
    </article>
</div>
