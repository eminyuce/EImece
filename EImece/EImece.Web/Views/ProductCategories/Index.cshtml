@model EImece.Web.Models.CategoryShellViewModel
@using Resources
@{
    ViewData["Title"] = Model.Name;
}

<div class="container px-3 py-4">
    <h1 class="h3 mb-2">@Model.Name</h1>
    <p class="text-muted">@Resource.ProductCategories · /c/pc/@Model.Id</p>
    <div class="eimece-shell-card">
        <p class="mb-2">@(Model.Summary ?? "Category shell — product grid arrives with service/view migration.")</p>
        @if (!string.IsNullOrEmpty(Model.Notice))
        {
            <p class="small text-muted mb-0">@Model.Notice</p>
        }
    </div>
</div>
