@model EImece.Web.Models.ImportDataIndexViewModel
@{
    ViewData["Title"] = "Veri İçe Aktarma";
}
<h1 class="h4 mb-3">Veri İçe Aktarma</h1>
<p class="text-muted small">App_Data: @Model.AppDataPath</p>

<div class="eimece-shell-card mb-4">
    <h2 class="h6">Excel Yükle</h2>
    <form method="post" asp-action="ExcelUpload" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <input type="file" name="excelFile" class="form-control" accept=".xlsx,.xls" required />
        </div>
        <button type="submit" class="btn btn-primary">Yükle ve Önizle</button>
    </form>
</div>

@if (Model.AppDataFiles.Count > 0)
{
    <h2 class="h6">App_Data dosyaları</h2>
    <ul>
        @foreach (var file in Model.AppDataFiles)
        {
            <li>
                @file —
                <a asp-action="DisplayTable" asp-route-id="@file">Önizle</a>
            </li>
        }
    </ul>
}
