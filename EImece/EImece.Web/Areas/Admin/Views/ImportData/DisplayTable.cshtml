@model EImece.Web.Models.ImportPreviewViewModel
@{
    ViewData["Title"] = "Excel Önizleme";
}
<h1 class="h4 mb-3">Excel Önizleme — @Model.FileName</h1>
<p><a asp-action="Index">← Geri</a></p>

@if (Model.Preview is null || Model.Preview.Rows.Count == 0)
{
    <p class="text-muted">Sayfa boş veya okunamadı.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    @foreach (System.Data.DataColumn col in Model.Preview.Columns)
                    {
                        <th>@col.ColumnName</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (System.Data.DataRow row in Model.Preview.Rows)
                {
                    <tr>
                        @foreach (var item in row.ItemArray)
                        {
                            <td>@item</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">İlk @Model.Preview.Rows.Count satır gösteriliyor (maks. 500).</p>
}
