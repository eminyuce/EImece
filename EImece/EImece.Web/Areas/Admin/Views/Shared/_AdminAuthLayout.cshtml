<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin Login") · EImece Admin</title>
    <link rel="stylesheet" href="~/Content/bootstrap.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/adminSite.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/eimece-core.css" asp-append-version="true" />
</head>
<body class="admin-app" style="display:flex;align-items:center;justify-content:center;">
    <main style="width:100%;max-width:480px;padding:1.5rem;">
        @RenderBody()
    </main>
    <script src="~/Scripts/jquery-3.5.1.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
