@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EImece Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="p-4">
    <nav class="mb-3">
        <a href="/Admin/Home">Home</a> |
        <a href="/Admin/Dashboard">Dashboard</a> |
        <a href="/Admin/Products">Products</a> |
        <a href="/Admin/Orders">Orders</a>
    </nav>
    <h1 class="h3">@ViewData["Title"]</h1>
    <p>@ViewData["Message"]</p>
    <p class="small text-muted">Admin user: @ViewData["AdminUser"]</p>
    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
    </form>
</body>
</html>
