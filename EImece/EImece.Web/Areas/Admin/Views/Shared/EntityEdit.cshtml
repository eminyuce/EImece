@model EImece.Web.Models.AdminEditViewModel
@{
    ViewData["Title"] = Model.Title;
    var profile = Model.EditProfile ?? "default";
}
<div class="eimece-shell-card" style="max-width:720px;">
    <h1 class="h4">@Model.Title</h1>
    <form method="post" asp-area="Admin" asp-controller="@Model.ControllerName" asp-action="SaveOrEdit">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ControllerName" />
        <input type="hidden" asp-for="Title" />
        <input type="hidden" asp-for="EditProfile" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label">@(profile == "faq" ? "Soru" : profile == "setting" ? "Ad" : "Ad")</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        @if (profile == "product")
        {
            <div class="mb-3">
                <label asp-for="ProductCode" class="form-label">Ürün Kodu</label>
                <input asp-for="ProductCode" class="form-control" />
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Price" class="form-label">Fiyat</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Discount" class="form-label">İndirim</label>
                    <input asp-for="Discount" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ProductCategoryId" class="form-label">Kategori</label>
                    <select asp-for="ProductCategoryId" asp-items="Model.ProductCategories" class="form-select"></select>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="BrandId" class="form-label">Marka</label>
                <select asp-for="BrandId" asp-items="Model.Brands" class="form-select"></select>
            </div>
            <div class="mb-3">
                <label asp-for="ShortDescription" class="form-label">Kısa Açıklama</label>
                <textarea asp-for="ShortDescription" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="5" data-ckeditor-field></textarea>
            </div>
            @if (Model.Id > 0)
            {
                <div class="mb-3 border rounded p-2">
                    <label class="form-label">Toplu fiyat güncelle (bu ürün)</label>
                    <div class="d-flex gap-2 align-items-center">
                        <input class="form-control form-control-sm" style="width:6rem" type="number" step="0.1"
                               data-product-item-percentage="Product-@Model.Id" value="0" />
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-product-item-type="Product" data-product-item-id="@Model.Id"
                                onclick="fiyatlariGuncelleGeneric(event)">Uygula %</button>
                    </div>
                    <div class="small mt-1" data-product-item-result="Product-@Model.Id"></div>
                </div>
                @if (Model.MainImageId.HasValue && Model.MainImageId > 0)
                {
                    <div class="mb-3" data-main-image-delete-id="@Model.MainImageId">
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                onclick="deleteBaseContentMainImage(@Model.Id, @Model.MainImageId, 'Product', 'Ana resmi silmek istediğinize emin misiniz?')">
                            Ana resmi sil
                        </button>
                    </div>
                }
                <div class="mb-3">
                    <a class="btn btn-sm btn-outline-secondary" asp-area="Admin" asp-controller="Products" asp-action="Media" asp-route-id="@Model.Id">Medya yönet</a>
                </div>
            }
            <div class="mb-3 form-check">
                <input asp-for="MainPage" class="form-check-input" />
                <label asp-for="MainPage" class="form-check-label">Ana Sayfa</label>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="IsCampaign" class="form-check-input" />
                <label asp-for="IsCampaign" class="form-check-label">Kampanya</label>
            </div>
        }
        @if (profile == "brand" || profile == "story")
        {
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" rows="4" data-ckeditor-field></textarea>
            </div>
            @if (profile == "brand" && Model.Id > 0)
            {
                <div class="mb-3 border rounded p-2">
                    <label class="form-label">Marka ürün fiyatlarını güncelle (%)</label>
                    <div class="d-flex gap-2 align-items-center">
                        <input class="form-control form-control-sm" style="width:6rem" type="number" step="0.1"
                               data-product-item-percentage="Brand-@Model.Id" value="0" />
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-product-item-type="Brand" data-product-item-id="@Model.Id"
                                onclick="fiyatlariGuncelleGeneric(event)">Uygula %</button>
                    </div>
                    <div class="small mt-1" data-product-item-result="Brand-@Model.Id"></div>
                </div>
            }
            <div class="mb-3 form-check">
                <input asp-for="MainPage" class="form-check-input" />
                <label asp-for="MainPage" class="form-check-label">Ana Sayfa</label>
            </div>
        }
        @if (profile == "productcategory" && Model.Id > 0)
        {
            <div class="mb-3 border rounded p-2">
                <label class="form-label">Kategori ürün fiyatlarını güncelle (%)</label>
                <div class="d-flex gap-2 align-items-center">
                    <input class="form-control form-control-sm" style="width:6rem" type="number" step="0.1"
                           data-product-item-percentage="ProductCategory-@Model.Id" value="0" />
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            data-product-item-type="ProductCategory" data-product-item-id="@Model.Id"
                            onclick="fiyatlariGuncelleGeneric(event)">Uygula %</button>
                </div>
                <div class="small mt-1" data-product-item-result="ProductCategory-@Model.Id"></div>
            </div>
        }
        @if (profile == "story")
        {
            <div class="mb-3">
                <label asp-for="ShortDescription" class="form-label">Kısa Açıklama</label>
                <textarea asp-for="ShortDescription" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="StoryCategoryId" class="form-label">Hikaye Kategorisi</label>
                <select asp-for="StoryCategoryId" asp-items="Model.StoryCategories" class="form-select"></select>
            </div>
        }
        @if (profile == "coupon")
        {
            <div class="mb-3">
                <label asp-for="Code" class="form-label">Kupon Kodu</label>
                <input asp-for="Code" class="form-control" />
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="DiscountPercentage" class="form-label">İndirim %</label>
                    <input asp-for="DiscountPercentage" class="form-control" type="number" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="CouponDiscountAmount" class="form-label">Sabit İndirim</label>
                    <input asp-for="CouponDiscountAmount" class="form-control" type="number" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartDate" class="form-label">Başlangıç</label>
                    <input asp-for="StartDate" class="form-control" type="date" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EndDate" class="form-label">Bitiş</label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                </div>
            </div>
        }
        @if (profile == "menu")
        {
            <div class="mb-3">
                <label asp-for="Link" class="form-label">Link</label>
                <input asp-for="Link" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="MenuLink" class="form-label">Menü Link</label>
                <input asp-for="MenuLink" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="ParentId" class="form-label">Üst Menü Id</label>
                <input asp-for="ParentId" class="form-control" type="number" />
            </div>
            <div class="mb-3 form-check">
                <input asp-for="MainPage" class="form-check-input" />
                <label asp-for="MainPage" class="form-check-label">Ana Sayfa</label>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="LinkIsActive" class="form-check-input" />
                <label asp-for="LinkIsActive" class="form-check-label">Link Aktif</label>
            </div>
        }
        @if (profile == "faq")
        {
            <div class="mb-3">
                <label asp-for="Answer" class="form-label">Cevap</label>
                <textarea asp-for="Answer" class="form-control" rows="4"></textarea>
            </div>
        }
        @if (profile == "tag")
        {
            <div class="mb-3">
                <label asp-for="TagCategoryId" class="form-label">Etiket Kategorisi</label>
                <select asp-for="TagCategoryId" asp-items="Model.TagCategories" class="form-select"></select>
            </div>
            @if (Model.Id > 0)
            {
                <div class="mb-3 border rounded p-2">
                    <label class="form-label">Etiket ürün fiyatlarını güncelle (%)</label>
                    <div class="d-flex gap-2 align-items-center">
                        <input class="form-control form-control-sm" style="width:6rem" type="number" step="0.1"
                               data-product-item-percentage="Tag-@Model.Id" value="0" />
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-product-item-type="Tag" data-product-item-id="@Model.Id"
                                onclick="fiyatlariGuncelleGeneric(event)">Uygula %</button>
                    </div>
                    <div class="small mt-1" data-product-item-result="Tag-@Model.Id"></div>
                </div>
            }
        }
        @if (profile == "template")
        {
            <div class="mb-3">
                <label asp-for="TemplateXml" class="form-label">Şablon XML</label>
                <textarea asp-for="TemplateXml" class="form-control" rows="8"></textarea>
            </div>
        }
        @if (profile == "setting")
        {
            <div class="mb-3">
                <label asp-for="SettingKey" class="form-label">Anahtar</label>
                <input asp-for="SettingKey" class="form-control" readonly="@(Model.Id > 0)" />
            </div>
            <div class="mb-3">
                <label asp-for="SettingValue" class="form-label">Değer</label>
                <textarea asp-for="SettingValue" class="form-control" rows="3"></textarea>
            </div>
        }
        <div class="mb-3 form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Aktif</label>
        </div>
        <div class="mb-3">
            <label asp-for="Position" class="form-label">Pozisyon</label>
            <input asp-for="Position" class="form-control" type="number" />
        </div>
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a class="btn btn-link" asp-area="Admin" asp-controller="@Model.ControllerName" asp-action="Index">İptal</a>
    </form>
    @if (Model.Id > 0)
    {
        <form method="post" asp-area="Admin" asp-controller="@Model.ControllerName" asp-action="DeleteConfirmed" class="mt-3"
              onsubmit="return confirm('Silmek istediğinize emin misiniz?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-outline-danger">Sil</button>
        </form>
    }
</div>
