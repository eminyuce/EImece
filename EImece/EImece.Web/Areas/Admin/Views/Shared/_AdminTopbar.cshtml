<div class="admin-topbar">
    <div>
        <strong>@(ViewData["Title"] ?? "Admin")</strong>
        <span class="text-muted small ml-2">Phase 7</span>
    </div>
    <div class="d-flex align-items-center">
        <span class="text-muted small mr-3">@User.Identity?.Name</span>
        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
        </form>
    </div>
</div>
