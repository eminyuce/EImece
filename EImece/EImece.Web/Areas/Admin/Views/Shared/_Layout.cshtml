@using Resources
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin") · EImece Admin</title>
    <link rel="stylesheet" href="~/Content/bootstrap.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/adminSite.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/adminShell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/adminReports.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/eimece-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin-app">
    <div class="admin-shell">
        <partial name="~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml" />
        <div class="admin-main">
            <partial name="~/Areas/Admin/Views/Shared/_AdminTopbar.cshtml" />
            <main class="admin-content">
                @if (TempData["Status"] is string status)
                {
                    <div class="alert alert-success">@status</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger">@error</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/Scripts/jquery-3.5.1.min.js" asp-append-version="true"></script>
    <script src="~/Scripts/bootstrap.js" asp-append-version="true"></script>
    <script src="~/Scripts/adminEimece.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
