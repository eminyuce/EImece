@using Resources
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin") · EImece Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/eimece-core.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-datagrid.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/adminShell.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script src="//cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
</head>
<body class="admin-app">
    <script>
        (function () {
            try {
                if (window.matchMedia && window.matchMedia("(min-width: 992px)").matches
                    && window.localStorage.getItem("eimece.admin.sidebarCollapsed") === "1") {
                    document.body.classList.add("sidebar-collapsed");
                }
            } catch (e) { }
        })();
    </script>
    <input type="hidden" id="CheckboxesDataTableDoesNotSelected" value="Lütfen en az bir satır seçin." />
    <div class="admin-shell">
        <partial name="~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml" />
        <div id="adminSidebarOverlay" class="admin-sidebar-overlay" aria-hidden="true"></div>
        <div class="admin-main">
            <partial name="~/Areas/Admin/Views/Shared/_AdminTopbar.cshtml" />
            <main class="admin-content">
                @if (TempData["Status"] is string status)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @status
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/admin-bs5-shim.js" asp-append-version="true"></script>
    <script src="~/js/admin-datagrid.js" asp-append-version="true"></script>
    <script src="~/Scripts/adminEimece.js" asp-append-version="true"></script>
    <script>
        // Override glyphicon-based state UI from adminEimece.js for Bootstrap 5 icons.
        window.changeStateSuccess = function (data) {
            if (!data || !data.values) return;
            data.values.forEach(function (entry) {
                var $span = $('span[name=span' + data.checkbox + ']').filter('[gridkey-id="' + entry.Id + '"]');
                if (entry.IsActive) { $span.attr('class', 'text-success').text('✓'); }
                else { $span.attr('class', 'text-danger').text('✗'); }
            });
        };
        // Legacy deleteItemsSuccess expects a raw array; accept wrapped responses too.
        window.deleteItemsSuccess = function (data) {
            var values = Array.isArray(data) ? data : (data && data.values ? data.values : []);
            values.forEach(function (entry) {
                $('[gridkey-id="' + entry + '"]').closest('tr').remove();
            });
            if (typeof refresh === 'function') refresh(500);
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
