@{
    ViewData["Title"] = "Dosya Yükle";
}
<div class="eimece-shell-card" style="max-width:520px;">
    <h1 class="h4">Dosya Yükle</h1>
    <p class="text-muted">Dosyalar <code>wwwroot/media/images</code> altına kaydedilir.</p>
    <form method="post" enctype="multipart/form-data" asp-action="Upload">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <input type="file" name="file" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary">Yükle</button>
    </form>
</div>
