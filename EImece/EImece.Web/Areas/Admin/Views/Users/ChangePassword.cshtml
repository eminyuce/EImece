@model EImece.Web.Models.AdminChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
}
<h1 class="h4 mb-3">Şifre — @Model.Email</h1>
<form method="post" asp-action="ChangePassword" class="eimece-shell-card" style="max-width:520px;">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <input asp-for="NewPassword" class="form-control" />
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Şifreyi Güncelle</button>
    <a class="btn btn-link" asp-action="Edit" asp-route-id="@Model.UserId">İptal</a>
</form>
