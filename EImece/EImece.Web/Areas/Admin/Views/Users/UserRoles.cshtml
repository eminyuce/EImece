@model EImece.Web.Models.AdminUserRolesViewModel
@{
    ViewData["Title"] = "Kullanıcı Rolleri";
}
<h1 class="h4 mb-3">Roller — @Model.Email</h1>
<form method="post" asp-action="UserRoles" class="eimece-shell-card" style="max-width:520px;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="UserId" value="@Model.UserId" />
    <div class="mb-3 form-check">
        <input class="form-check-input" type="checkbox" name="IsAdmin" value="true" id="roleAdmin" @(Model.IsAdmin ? "checked" : null) />
        <label class="form-check-label" for="roleAdmin">Admin</label>
    </div>
    <div class="mb-3 form-check">
        <input class="form-check-input" type="checkbox" name="IsCustomer" value="true" id="roleCustomer" @(Model.IsCustomer ? "checked" : null) />
        <label class="form-check-label" for="roleCustomer">Customer</label>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a class="btn btn-link" asp-action="Edit" asp-route-id="@Model.UserId">İptal</a>
</form>
