{
  "name": "eimece-crizal-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright validation for the Crizal Razor theme against IIS http://localhost:81",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:e2e": "playwright test --project=chromium tests/e2e",
    "test:happy": "playwright test --project=chromium tests/e2e/shopping-happy-path.spec.ts",
    "test:failures": "playwright test --project=chromium tests/e2e/payment-failures.spec.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
